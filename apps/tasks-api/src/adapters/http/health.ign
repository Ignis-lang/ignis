//! GET /health: the one endpoint that needs no token.

import Web from "std::web";
import TaskRepository from "@domain::repository";
import Api from "@adapters::http::api";

export function health<R: TaskRepository & Send & Sync>(
  api: &Api<R>,
  request: &mut Web::Request,
  response: &mut Web::Response,
): Result<void, Web::Error> {
  response.text("ok");
  return Result::OK(());
}
