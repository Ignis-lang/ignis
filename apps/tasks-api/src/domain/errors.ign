//! Domain failures the application layer reports. The HTTP adapter is the
//! only layer that turns them into status codes; nothing here knows that
//! HTTP exists.

export enum TaskError {
  /// No task with the requested id.
  NOT_FOUND,
  /// The request was well formed but violates a domain invariant.
  VALIDATION(String),
  /// The requester is not the task's owner.
  FORBIDDEN,
  /// The request itself carries a malformed value (path or query).
  BAD_REQUEST(String),
}

export function validationError(message: str): TaskError {
  return TaskError::VALIDATION(String::create(message));
}

export function badRequestError(message: str): TaskError {
  return TaskError::BAD_REQUEST(String::create(message));
}
