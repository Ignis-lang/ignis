//! Composition root: the only file that names the concrete repository.
//! Every other layer works against the TaskRepository trait.

import Web from "std::web";
import TasksApi from "@app";
import MemoryTaskRepository from "@infra::memory_repository";

function main(): i32 {
  let app: TasksApi<MemoryTaskRepository> = TasksApi::new<MemoryTaskRepository>(
    MemoryTaskRepository::new(),
    String::create("secret"),
  );

  return Web::listen<TasksApi<MemoryTaskRepository>>("127.0.0.1:8080", (@move app)).isOk() ? 0 : 1;
}
