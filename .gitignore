/target
build/
nohup.out
.direnv
# Ignore the contents rather than the directory, so the tracked build config can
# be re-included below. Excluding `.cargo` itself would make that impossible:
# git cannot re-include a file whose parent directory is excluded.
.cargo/*
!.cargo/config.toml
.rustup
*.o
*.a
*.so
*.ll
example/*.c
.snap.new
out.c
a.out
build
!ignis/build/
!ignis/build/**
!test_cases/selfhost/build/
!test_cases/selfhost/build/**
out
.tldr
.claude
vgcore*
*.log
.opencode/
thoughts/
.atl
std/runtime/tests/test_smoke
.agent/
selfhost_emit.c
