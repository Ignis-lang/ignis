import String from "std::string";
import Vector from "std::vector";

import Punctuation, Token, TokenKind, TokenStream from "@compiler::syntax";

@implements(Eq)
export enum CommentPlacement {
  LEADING,
  TRAILING,
  DETACHED,

  public equals(&self, other: &CommentPlacement): boolean {
    return match (self) {
      CommentPlacement::LEADING -> *other == CommentPlacement::LEADING,
      CommentPlacement::TRAILING -> *other == CommentPlacement::TRAILING,
      CommentPlacement::DETACHED -> *other == CommentPlacement::DETACHED,
    };
  }
}

export record CommentTrivia {
  public raw: String;
  public placement: CommentPlacement;
}

export record CommentBlock {
  public lines: Vector<String>;
  public placement: CommentPlacement;

  public flatten(&self): Vector<CommentTrivia> {
    let mut result: Vector<CommentTrivia> = Vector::new<CommentTrivia>();
    let mut index: u64 = 0;

    while (index < self.lines.length()) {
      let Option::SOME(line) = self.lines.get(index) else {
        index += 1;
        continue;
      };

      result.push(CommentTrivia {
        raw: line.clone(),
        placement: self.placement,
      });
      index += 1;
    }

    return result;
  }
}

export function isCommentTrivia(token: &Token): boolean {
  let kind: TokenKind = token.kindValue();
  return kind == TokenKind::LINE_COMMENT || kind == TokenKind::BLOCK_COMMENT || kind == TokenKind::OUTER_DOC_COMMENT || kind == TokenKind::INNER_DOC_COMMENT;
}

/// A source file's newline byte offsets, sorted ascending, built once with a
/// single linear scan so `lineAt` can answer a byte-index-to-line-number
/// query with a binary search instead of rescanning from byte 0.
///
/// `classifyCommentPlacement` used to take the raw `&String` and rescan every
/// comment's neighborhood from the start of the file on every call
/// (`lineNumber`'s own `while (cursor < clampedIndex)` loop). A file's comment
/// count and file length both grow together, so that made classification
/// quadratic in file size: `commentShape` in `safety.ign` calls it once per
/// comment token while looping every token, and `ModelBuilder::parseRegion`
/// calls it once per comment block. On `ignis/analyzer/typecheck_tests.ign`
/// (15.6k lines, 1336 comments) this alone accounted for most of the ~38s the
/// formatter spent on that single file (see corpus_tests.ign profiling in
/// issue #220). Building one `LineIndex` per source and threading it through
/// keeps every call O(log n).
export record LineIndex {
  newlineOffsets: Vector<u64>;

  public static build(source: &String): LineIndex {
    let mut offsets: Vector<u64> = Vector::new<u64>();
    let length: u64 = source.length();
    let mut cursor: u64 = 0;

    while (cursor < length) {
      if (let Option::SOME(byte) = source.byteAt(cursor) && byte == '\n' as u8) {
        offsets.push(cursor);
      }

      cursor += 1;
    }

    return LineIndex { newlineOffsets: offsets };
  }

  /// Number of newline bytes strictly before `byteIndex` — a zero-based line
  /// number, matching the byte-scan this replaces.
  public lineAt(&self, byteIndex: u64): u64 {
    let mut low: u64 = 0;
    let mut high: u64 = self.newlineOffsets.length();

    while (low < high) {
      let mid: u64 = low + (high - low) / 2;
      let Option::SOME(offset) = self.newlineOffsets.get(mid) else {
        @panic("LineIndex::lineAt: binary search index out of bounds (low <= mid < high <= newlineOffsets.length() invariant violated)");
      };

      if (*offset < byteIndex) {
        low = mid + 1;
      } else {
        high = mid;
      }
    }

    return low;
  }
}

/// Classifies where a comment token sits relative to its neighbors: trailing
/// the previous token on the same line, leading the next item, or detached by
/// a blank line from what follows.
export function classifyCommentPlacement(
  lineIndex: &LineIndex,
  tokens: &TokenStream,
  commentIndex: u64,
  startIndex: u64,
  endIndex: u64,
): CommentPlacement {
  let Option::SOME(comment) = tokens.get(commentIndex) else {
    @panic("classifyCommentPlacement: comment index out of range");
  };

  let commentLine: u64 = lineIndex.lineAt(comment.spanStart());

  let mut previous: Option<&Token> = Option::NONE;
  let mut previousIndex: u64 = commentIndex;

  while (previousIndex > startIndex) {
    previousIndex -= 1;

    let Option::SOME(candidate) = tokens.get(previousIndex) else {
      continue;
    };

    if (!isCommentTrivia(candidate)) {
      previous = Option::SOME(candidate);
      break;
    }
  }

  if (let Option::SOME(previousToken) = previous) {
    let previousLine: u64 = lineIndex.lineAt(previousToken.spanEnd());
    let isLeftBrace: boolean = previousToken.kindValue() == TokenKind::PUNCTUATION && previousToken.punctuationValue() == Punctuation::LEFT_BRACE;

    if (previousLine == commentLine && !isLeftBrace) {
      return CommentPlacement::TRAILING;
    }
  }

  let mut next: Option<&Token> = Option::NONE;
  let mut nextIndex: u64 = commentIndex + 1;

  while (nextIndex < endIndex) {
    let Option::SOME(candidate) = tokens.get(nextIndex) else {
      nextIndex += 1;
      continue;
    };

    if (!isCommentTrivia(candidate)) {
      next = Option::SOME(candidate);
      break;
    }

    nextIndex += 1;
  }

  if (let Option::SOME(nextToken) = next) {
    let nextLine: u64 = lineIndex.lineAt(nextToken.spanStart());

    if (commentLine + 1 >= nextLine) {
      return CommentPlacement::LEADING;
    }

    return CommentPlacement::DETACHED;
  }

  return CommentPlacement::DETACHED;
}
