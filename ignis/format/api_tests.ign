import String from "std::string";
import Test from "std::test";

import Format from "./api";
import FormatterConfig from "./config";

function formatOrFail(source: str): String {
  let sourceText: String = String::create(source);
  let config: FormatterConfig = FormatterConfig::default();

  let Result::OK(output) = Format::formatSource(&sourceText, &config) else {
    Test::fail();
    return String::new();
  };

  return output;
}

@test
function apiFormatsASimpleFunctionEndToEnd(): void {
  Test::assertEq<str>(
    formatOrFail("function main(): void { return; }\n").toStr(),
    "function main(): void {\n  return;\n}\n"
  );
}

@test
function apiIsIdempotentOnASecondPass(): void {
  let first: String = formatOrFail("/// A point in 2D space\nrecord Point {\n    x: i32;\n    y: i32;\n}\n");
  let second: String = formatOrFail(first.toStr());
  Test::assertEq<str>(first.toStr(), second.toStr());
}

@test
function apiTrimsTrailingWhitespaceFromACommentLine(): void {
  Test::assertEq<str>(
    formatOrFail("//! \n\nfunction main(): void { return; }\n").toStr(),
    "//!\n\nfunction main(): void {\n  return;\n}\n"
  );
}

@test
function apiPreservesMutabilityOnAComplexLetElsePattern(): void {
  let formatted: String = formatOrFail(
    "function main(): void { let mut Option::SOME(active) = bag.getMut(index) else { @panic(\"missing\"); }; return; }\n"
  );

  let needle: String = String::create("let mut Option::SOME(active)");

  if (!formatted.contains(&needle)) {
    Test::fail();
  }
}

@test
function apiReportsWhetherASourceNeedsFormatting(): void {
  let config: FormatterConfig = FormatterConfig::default();
  let clean: String = String::create("function main(): void {\n  return;\n}\n");
  let dirty: String = String::create("function main(): void { return; }\n");

  let Result::OK(cleanVerdict) = Format::sourceNeedsFormatting(&clean, &config) else {
    Test::fail();
    return;
  };

  let Result::OK(dirtyVerdict) = Format::sourceNeedsFormatting(&dirty, &config) else {
    Test::fail();
    return;
  };

  Test::assertEq<boolean>(cleanVerdict, false);
  Test::assertEq<boolean>(dirtyVerdict, true);
}

@test
function apiHonoursAConfiguredIndentWidth(): void {
  let sourceText: String = String::create("function main(): void { return; }\n");
  let mut config: FormatterConfig = FormatterConfig::default();
  config.indentWidth = 4;

  let Result::OK(output) = Format::formatSource(&sourceText, &config) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(output.toStr(), "function main(): void {\n    return;\n}\n");
}

@test
function apiHonoursAConfiguredLineWidth(): void {
  let sourceText: String = String::create("import FirstBinding, SecondBinding, ThirdBinding from \"std::somewhere\";\n");
  let mut config: FormatterConfig = FormatterConfig::default();
  config.lineWidth = 40;

  let Result::OK(output) = Format::formatSource(&sourceText, &config) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    output.toStr(),
    "import\n  FirstBinding,\n  SecondBinding,\n  ThirdBinding,\nfrom \"std::somewhere\";\n"
  );
}

@test
function apiHonoursUseTabs(): void {
  let sourceText: String = String::create("function main(): void { return; }\n");
  let mut config: FormatterConfig = FormatterConfig::default();
  config.useTabs = true;

  let Result::OK(output) = Format::formatSource(&sourceText, &config) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(output.toStr(), "function main(): void {\n\treturn;\n}\n");
}

@test
function apiRendersAUnifiedDiff(): void {
  let path: String = String::create("main.ign");
  let oldText: String = String::create("function main(): void { return; }\n");
  let newText: String = String::create("function main(): void {\n  return;\n}\n");

  let diff: String = Format::unifiedDiff(&path, &oldText, &newText);

  Test::assertEq<str>(
    diff.toStr(),
    "--- main.ign\n+++ main.ign\n@@ -1,3 +1,3 @@\n-function main(): void { return; }\n+function main(): void {\n+  return;\n+}\n"
  );
}

@test
function apiRendersAnEmptyDiffForIdenticalText(): void {
  let path: String = String::create("main.ign");
  let text: String = String::create("function main(): void {\n  return;\n}\n");

  Test::assertEq<str>(
    Format::unifiedDiff(&path, &text, &text).toStr(),
    "--- main.ign\n+++ main.ign\n"
  );
}

@test
function apiParsesAnNdjsonRequest(): void {
  let line: String = String::create("{\"path\":\"a.ign\",\"text\":\"function main(): void { return; }\\n\"}");

  let Result::OK(request) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(request.path.toStr(), "a.ign");
  Test::assertEq<str>(request.text.toStr(), "function main(): void { return; }\n");
}

@test
function apiRejectsAnNdjsonRequestMissingItsText(): void {
  let line: String = String::create("{\"path\":\"a.ign\"}");

  let Result::ERROR(_) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };
}

/// Matches the host's `serde_json` wording exactly: a string that runs off
/// the end of the line reports EOF at the line's full length.
@test
function apiReportsTheHostsWordingForATruncatedNdjsonLine(): void {
  let line: String = String::create("{\"path\":\"a.ign\",\"tex");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: EOF while parsing a string at line 1 column 20"
  );
}

/// Matches the host's `serde_json` wording exactly: a bare JSON string is
/// valid JSON but not the expected `StdinRecord` object.
@test
function apiReportsTheHostsWordingForANonObjectNdjsonLine(): void {
  let line: String = String::create("\"just a string\"");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: string \"just a string\", expected struct StdinRecord at line 1 column 15"
  );
}

/// Matches the host's `serde_json` wording exactly: `path` is declared before
/// `text`, so a missing `path` is reported even when `text` is present.
@test
function apiReportsTheHostsWordingForAnNdjsonLineMissingPath(): void {
  let line: String = String::create("{\"text\":\"function main(): i32 {\\n  return 1;\\n}\\n\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: missing field `path` at line 1 column 51"
  );
}

/// Matches the host's `serde_json` wording exactly: an unclosed object
/// reports EOF at the line's full length, distinct from an unclosed string.
@test
function apiReportsTheHostsWordingForATruncatedNdjsonObject(): void {
  let line: String = String::create("{\"path\":\"a.ign\",\"text\":\"hi\"");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: EOF while parsing an object at line 1 column 27"
  );
}

/// A key nested inside another object's value never reaches the top-level
/// `path`/`text` fields, unlike the quote scanner this parser replaced.
@test
function apiIgnoresANestedObjectKeyInsteadOfLeakingIt(): void {
  let line: String = String::create("{\"meta\":{\"path\":\"evil.ign\"},\"path\":\"good.ign\",\"text\":\"x\"}");

  let Result::OK(request) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(request.path.toStr(), "good.ign");
  Test::assertEq<str>(request.text.toStr(), "x");
}

/// Matches the host's `serde_json` wording exactly: a field with the wrong
/// JSON type reports `invalid type: ..., expected a string`, not a missing
/// field, at the position right after that field's own value.
@test
function apiReportsTheHostsWordingForAWrongTypedField(): void {
  let line: String = String::create("{\"path\":\"a\",\"text\":1}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: integer `1`, expected a string at line 1 column 20"
  );
}

/// Matches the host's `serde_json` wording exactly for a `null` top level.
@test
function apiReportsTheHostsWordingForANullNdjsonLine(): void {
  let line: String = String::create("null");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: null, expected struct StdinRecord at line 1 column 4"
  );
}

/// Matches the host's `serde_json` wording exactly for a bare-number top
/// level.
@test
function apiReportsTheHostsWordingForANumberNdjsonLine(): void {
  let line: String = String::create("123");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: integer `123`, expected struct StdinRecord at line 1 column 3"
  );
}

/// Matches the host's `serde_json` wording exactly: a `serde`-derived struct
/// can deserialize a wrong-length sequence, so an empty array is `invalid
/// length`, not `invalid type`.
@test
function apiReportsTheHostsWordingForAnEmptyArrayNdjsonLine(): void {
  let line: String = String::create("[]");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid length 0, expected struct StdinRecord with 2 elements at line 1 column 2"
  );
}

/// A `serde`-derived struct also accepts a positional 2-element sequence, so
/// `["a","b"]` succeeds with `path: "a"`, `text: "b"` rather than reporting
/// `invalid length`. Confirmed against the host binary.
@test
function apiAcceptsATwoElementArrayPositionally(): void {
  let line: String = String::create("[\"a\",\"b\"]");

  let Result::OK(request) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(request.path.toStr(), "a");
  Test::assertEq<str>(request.text.toStr(), "b");
}

/// Matches the host's `serde_json` wording exactly: a valid JSON value that
/// deserializes cleanly reports `invalid type` for the value it actually
/// parsed, not `trailing characters` for what follows it — the type mismatch
/// fails before the rest of the line is even inspected.
@test
function apiReportsTheHostsWordingForATrailingNdjsonLine(): void {
  let line: String = String::create("\"a\" x");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: string \"a\", expected struct StdinRecord at line 1 column 3"
  );
}

@test
function apiRendersAnNdjsonResponseWithTheFormattedText(): void {
  let line: String = String::create("{\"path\":\"a.ign\",\"text\":\"function main(): void { return; }\\n\"}");
  let config: FormatterConfig = FormatterConfig::default();

  let Result::OK(request) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  let response: Format::StdinResponse = Format::processStdinRequest(&request, &config, false);

  Test::assertEq<str>(
    Format::renderStdinResponse(&response).toStr(),
    "{\"path\":\"a.ign\",\"formatted\":\"function main(): void {\\n  return;\\n}\\n\",\"changed\":true}"
  );
}

@test
function apiRendersAnNdjsonResponseWithADiffInDiffMode(): void {
  let line: String = String::create("{\"path\":\"a.ign\",\"text\":\"function main(): void { return; }\\n\"}");
  let config: FormatterConfig = FormatterConfig::default();

  let Result::OK(request) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  let response: Format::StdinResponse = Format::processStdinRequest(&request, &config, true);

  Test::assertEq<boolean>(response.hasFormatted, false);
  Test::assertEq<boolean>(response.hasDiff, true);
  Test::assertEq<boolean>(response.changed, true);
}

@test
function apiReportsAFormatterErrorOnAnNdjsonResponse(): void {
  let line: String = String::create("{\"path\":\"a.ign\",\"text\":\"function main(: void { }\\n\"}");
  let config: FormatterConfig = FormatterConfig::default();

  let Result::OK(request) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  let response: Format::StdinResponse = Format::processStdinRequest(&request, &config, false);
  Test::assertEq<boolean>(response.hasError, true);
}

/// F11: a surrogate pair decodes to one scalar, not two replacement
/// characters.
@test
function apiDecodesASurrogatePairToOneScalar(): void {
  let line: String = String::create("{\"path\":\"\\ud83d\\ude00\",\"text\":\"function main(): i32 {\\n  return 1;\\n}\\n\"}");

  let Result::OK(request) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(request.path.toStr(), "😀");
}

/// F11: a lone high surrogate with nothing after it. Matches the host's
/// exact wording.
@test
function apiReportsTheHostsWordingForALoneHighSurrogate(): void {
  let line: String = String::create("{\"path\":\"\\ud83d\",\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: unexpected end of hex escape at line 1 column 16"
  );
}

/// F11: a high surrogate followed by a non-low-surrogate escape.
@test
function apiReportsTheHostsWordingForAnUnpairedHighSurrogate(): void {
  let line: String = String::create("{\"path\":\"\\ud83d\\u0041\",\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: lone leading surrogate in hex escape at line 1 column 21"
  );
}

/// F11: a lone low surrogate with no preceding high surrogate.
@test
function apiReportsTheHostsWordingForALoneLowSurrogate(): void {
  let line: String = String::create("{\"path\":\"\\ude00\",\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: lone leading surrogate in hex escape at line 1 column 15"
  );
}

/// F12: a `path` set to 50000 nested arrays fails immediately with
/// `invalid type: sequence`, at any depth, instead of recursing at all.
@test
function apiRejectsADeeplyNestedArrayInPathWithoutRecursing(): void {
  let mut line: String = String::create("{\"path\":");
  let mut index: u64 = 0;

  while (index < 50000) {
    line.pushByte('[' as u8);
    index += 1;
  }

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: sequence, expected a string at line 1 column 8"
  );
}

/// F12: an unknown field's value is skipped iteratively, so 200000 levels of
/// nesting in it does not overflow the stack (matching the host's
/// `IgnoredAny`, which also has no recursion limit for a skipped field).
@test
function apiSkipsADeeplyNestedIgnoredFieldWithoutRecursing(): void {
  let mut line: String = String::create("{\"other\":");
  let mut index: u64 = 0;

  while (index < 200000) {
    line.pushByte('[' as u8);
    index += 1;
  }

  index = 0;

  while (index < 200000) {
    line.pushByte(']' as u8);
    index += 1;
  }

  line.pushStr(",\"path\":\"a.ign\",\"text\":\"function main(): i32 {\\n  return 1;\\n}\\n\"}");

  let Result::OK(request) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(request.path.toStr(), "a.ign");
}

/// F13: an unrecognized escape sequence.
@test
function apiReportsTheHostsWordingForAnInvalidEscape(): void {
  let line: String = String::create("{\"path\":\"a\\qb\",\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: invalid escape at line 1 column 12");
}

/// F13: a raw control byte inside a JSON string.
@test
function apiReportsTheHostsWordingForARawControlCharacter(): void {
  let mut line: String = String::create("{\"path\":\"a");
  line.pushByte(1);
  line.pushStr("b\",\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: control character (\\u0000-\\u001F) found while parsing a string at line 1 column 11"
  );
}

/// F13: `01` is a malformed JSON number (a leading zero cannot be followed
/// by another digit).
@test
function apiReportsTheHostsWordingForANumberWithALeadingZero(): void {
  let line: String = String::create("{\"path\":\"a\",\"text\":01}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: invalid number at line 1 column 21");
}

/// F13: `1e` is a malformed JSON number (an exponent marker needs at least
/// one digit after it).
@test
function apiReportsTheHostsWordingForANumberWithAnEmptyExponent(): void {
  let line: String = String::create("{\"path\":\"a\",\"text\":1e}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: invalid number at line 1 column 22");
}

/// F13: a bare `-` is a malformed JSON number (a digit must follow the
/// minus sign).
@test
function apiReportsTheHostsWordingForABareMinusSign(): void {
  let line: String = String::create("{\"path\":\"a\",\"text\":-}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: invalid number at line 1 column 21");
}

/// F14: a repeated `path` key is rejected the moment its own string finishes
/// parsing, before its value (here, a perfectly valid string) is even
/// looked at.
@test
function apiReportsTheHostsWordingForADuplicateField(): void {
  let line: String = String::create("{\"path\":\"a\",\"path\":\"b\",\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: duplicate field `path` at line 1 column 18");
}

/// F14: the doc comment on the old scanner claimed "later occurrence
/// overwrites"; a duplicate is actually rejected regardless of which
/// occurrence, or its value's type, comes first.
@test
function apiReportsADuplicateFieldEvenWhenTheSecondValueIsWrongTyped(): void {
  let line: String = String::create("{\"path\":\"b\",\"path\":1,\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: duplicate field `path` at line 1 column 18");
}

/// F15: a container-valued field reports the position right before its
/// opening bracket, not after it (unlike every scalar, which is reported
/// after being fully read).
@test
function apiReportsTheHostsColumnForAnObjectValuedField(): void {
  let line: String = String::create("{\"path\":{\"x\":1},\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: map, expected a string at line 1 column 8"
  );
}

/// F16: `serde_json` always classifies `-0` as `-0.0`, a float, to keep the
/// sign bit no 64-bit integer type can represent.
@test
function apiDescribesNegativeZeroAsAFloat(): void {
  let line: String = String::create("{\"path\":-0,\"text\":\"\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: floating point `-0.0`, expected a string at line 1 column 10"
  );
}

/// F17: Rust's `{:?}` string escaping in a description uses `\u{8}` for a
/// backspace, not JSON's `\b`.
@test
function apiDescribesABackspaceWithRustDebugEscaping(): void {
  let line: String = String::create("\"a\\bb\"");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: string \"a\\u{8}b\", expected struct StdinRecord at line 1 column 6"
  );
}

/// F17: DEL (0x7F) also becomes `\u{7f}`.
@test
function apiDescribesADelByteWithRustDebugEscaping(): void {
  let mut line: String = String::create("\"a");
  line.pushByte(127);
  line.pushStr("b\"");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    message.toStr(),
    "failed to parse NDJSON record: invalid type: string \"a\\u{7f}b\", expected struct StdinRecord at line 1 column 5"
  );
}

/// F19: a trailing comma before `}` has its own wording, not the generic
/// `expected value`.
@test
function apiReportsTheHostsWordingForATrailingComma(): void {
  let line: String = String::create("{\"path\":\"a\",\"text\":\"b\",}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: trailing comma at line 1 column 24");
}

/// F19: a missing comma between two entries.
@test
function apiReportsTheHostsWordingForAMissingComma(): void {
  let line: String = String::create("{\"path\":\"a\" \"text\":\"b\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: expected `,` or `}` at line 1 column 13");
}

/// F19: a missing colon after a key.
@test
function apiReportsTheHostsWordingForAMissingColon(): void {
  let line: String = String::create("{\"path\" \"a\",\"text\":\"b\"}");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: expected `:` at line 1 column 9");
}

/// F19: a top-level (positional) array with a trailing comma after its
/// second element also needs the dedicated wording, not the generic
/// `expected value` the array element scanner would otherwise fall into.
@test
function apiReportsTheHostsWordingForATrailingCommaAfterTheSecondArrayElement(): void {
  let line: String = String::create("[\"a\",\"b\",]");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: trailing comma at line 1 column 10");
}

/// F19: the same wording applies to a trailing comma right after the first
/// (and only, at that point) array element.
@test
function apiReportsTheHostsWordingForATrailingCommaAfterTheFirstArrayElement(): void {
  let line: String = String::create("[\"a\",]");

  let Result::ERROR(message) = Format::parseStdinRequest(&line) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(message.toStr(), "failed to parse NDJSON record: trailing comma at line 1 column 6");
}
