/// `__parse_verdicts__` holds gate G6's committed baselines, plain text with no
/// `.ign` file to format, so it is known here without a corpus `@test`.
function knownTestCasesSubdirs(): Vector<String> {
  let mut names: Vector<String> = Vector::new<String>();
  names.push(String::create("__parse_verdicts__"));
  names.push(String::create("analyzer"));
  names.push(String::create("e2e"));
  names.push(String::create("parser"));
  names.push(String::create("selfhost"));
  Sort::stableLexicalStrings(&mut names);
  return names;
}

function knownE2eSubdirs(): Vector<String> {
  let mut names: Vector<String> = Vector::new<String>();
  names.push(String::create("err"));
  names.push(String::create("ok"));
  Sort::stableLexicalStrings(&mut names);
  return names;
}

/// Fails with a readable diff when `actual` (the directories really on disk)
/// is not exactly `known` (the directories this file has a unit test for).
function assertSubdirCoverage(label: str, known: &Vector<String>, actual: &Vector<String>): void {
  let mut mismatched: boolean = false;

  if (known.length() != actual.length()) {
    mismatched = true;
  }

  let mut index: u64 = 0;
  let shorter: u64 = known.length() < actual.length() ? known.length() : actual.length();

  while (index < shorter) {
    let Option::SOME(knownName) = known.get(index) else {
      index += 1;
      continue;
    };
    let Option::SOME(actualName) = actual.get(index) else {
      index += 1;
      continue;
    };

    if (!knownName.equals(actualName)) {
      mismatched = true;
    }

    index += 1;
  }

  if (!mismatched) {
    return;
  }

  let mut message: String = String::create("formatter corpus coverage (");
  message.pushStr(label);
  message.pushStr("): known subdirectories do not match the tree.\n  known:  ");
  let knownDescription: String = Fs::walkDescribe(known);
  message.push(&knownDescription);
  message.pushStr("\n  actual: ");
  let actualDescription: String = Fs::walkDescribe(actual);
  message.push(&actualDescription);
  message.pushStr(
    "\n  Add a @test for the new/removed directory in corpus_tests.ign and update the matching known*Subdirs() list.",
  );

  Io::eprintln(message);
  Test::fail();
}

@test
function corpusDirectoryCoverageMatchesTree(): void {
  let ignisKnown: Vector<String> = knownIgnisSubdirs();
  let ignisActual: Vector<String> = subdirectoryNames("ignis");
  assertSubdirCoverage("ignis", &ignisKnown, &ignisActual);

  let stdKnown: Vector<String> = knownStdSubdirs();
  let stdActual: Vector<String> = subdirectoryNames("std");
  assertSubdirCoverage("std", &stdKnown, &stdActual);

  let testCasesKnown: Vector<String> = knownTestCasesSubdirs();
  let testCasesActual: Vector<String> = subdirectoryNames("test_cases");
  assertSubdirCoverage("test_cases", &testCasesKnown, &testCasesActual);

  let e2eKnown: Vector<String> = knownE2eSubdirs();
  let e2eActual: Vector<String> = subdirectoryNames("test_cases/e2e");
  assertSubdirCoverage("test_cases/e2e", &e2eKnown, &e2eActual);
}

/// Guards `test_cases/e2e/ok`'s shard scheme against silent growth: if the
/// directory grows enough that a shard's file count creeps toward what used
/// to time the whole corpus test out, this fails loudly instead of the
/// growth quietly re-creating issue #220 one shard at a time.
@test
function corpusE2eOkShardSizeStaysReasonable(): void {
  let shardCount: u64 = e2eOkShardCount();
  let allFiles: Vector<String> = collectIgnFiles("test_cases/e2e/ok");
  let total: u64 = allFiles.length();
  let chunkSize: u64 = (total + shardCount - 1) / shardCount;

  // Comfortably above today's ~90 files/shard, comfortably below a size that
  // would risk the per-test timeout again.
  let ceiling: u64 = 250;

  if (chunkSize > ceiling) {
    let totalText: String = total.toString();
    let chunkSizeText: String = chunkSize.toString();
    let ceilingText: String = ceiling.toString();

    let mut message: String = String::create("formatter corpus: test_cases/e2e/ok has grown to ");
    message.push(&totalText);
    message.pushStr(" files (");
    message.push(&chunkSizeText);
    message.pushStr(" per shard, ceiling ");
    message.push(&ceilingText);
    message.pushStr(
      "). Increase e2eOkShardCount() and add the matching corpusTestCasesE2eOkShardN test in corpus_tests.ign.",
    );
    Io::eprintln(message);
    Test::fail();
  }
}

/// Guards `ignis/analyzer`'s line-balanced shard scheme against silent
/// growth. Unlike `test_cases/e2e/ok`'s uniformly tiny fixtures, a handful
/// of `ignis/analyzer`'s files are 3k-15k lines each — file COUNT is a
/// meaningless proxy for a shard's cost there, so this asserts the heaviest
/// shard's total LINE count instead, failing loudly before growth quietly
/// re-creates issue #220 one shard at a time.
@test
function corpusIgnisAnalyzerShardSizeStaysReasonable(): void {
  let shardCount: u64 = ignisAnalyzerShardCount();
  let packed: LineBalancedShards = packFilesByLineCount("ignis/analyzer", shardCount);

  let mut worstShard: u64 = 0;
  let mut worstTotal: u64 = 0;
  let mut shardIndex: u64 = 0;

  while (shardIndex < shardCount) {
    let Option::SOME(total) = packed.totals.get(shardIndex) else {
      shardIndex += 1;
      continue;
    };

    if (*total > worstTotal) {
      worstTotal = *total;
      worstShard = shardIndex;
    }

    shardIndex += 1;
  }

  // Comfortably above today's heaviest shard (set by the single biggest
  // file, ~15-16k lines), comfortably below a size that would risk the
  // per-test timeout again.
  let ceiling: u64 = 35000;

  if (worstTotal > ceiling) {
    let worstShardText: String = worstShard.toString();
    let worstTotalText: String = worstTotal.toString();
    let ceilingText: String = ceiling.toString();

    let mut message: String = String::create("formatter corpus: ignis/analyzer shard ");
    message.push(&worstShardText);
    message.pushStr(" has grown to ");
    message.push(&worstTotalText);
    message.pushStr(" lines (ceiling ");
    message.push(&ceilingText);
    message.pushStr(
      "). Increase ignisAnalyzerShardCount() and add the matching corpusIgnisAnalyzerShardN test in corpus_tests.ign.",
    );
    Io::eprintln(message);
    Test::fail();
  }
}
