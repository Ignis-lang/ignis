import Fs from "std::fs";
import Io from "std::io";
import Sort from "std::sort";
import String from "std::string";
import Test from "std::test";
import Vector from "std::vector";

import Format from "./api";
import FormatterConfig from "./config";

/// `String::lines()` appends a spurious trailing empty entry when the text ends
/// with '\n', unlike Rust's `str::lines()` (repro
/// "string-lines-trailing-newline").
function corpusLines(text: &String): Vector<String> {
  let mut lines: Vector<String> = text.lines();

  if (text.length() > 0 && lines.length() > 0) {
    let Option::SOME(lastByte) = text.byteAt(text.length() - 1) else {
      return lines;
    };

    if (lastByte == '\n' as u8) {
      lines.pop();
    }
  }

  return lines;
}

function isIgnFile(path: &String): boolean {
  if (path.length() < 4) {
    return false;
  }

  let suffix: String = path.substringBytes(path.length() - 4, path.length());
  return suffix.equals(".ign");
}

/// Recursively collects every `.ign` file under `rootPath`.
function collectIgnFiles(rootPath: str): Vector<String> {
  let mut files: Vector<String> = Vector::new<String>();

  if (!Fs::exists(rootPath)) {
    return files;
  }

  let Result::OK(walked) = Fs::walk(rootPath) else {
    return files;
  };

  let mut index: u64 = 0;

  while (index < walked.length()) {
    let Option::SOME(path) = walked.get(index) else {
      index += 1;
      continue;
    };

    if (isIgnFile(path)) {
      files.push(path.clone());
    }

    index += 1;
  }

  return files;
}

/// Lists the `.ign` files directly inside `rootPath`, not descending into
/// subdirectories. Used for the handful of loose files sitting next to a
/// root's subdirectories (e.g. `ignis/main.ign`), so a new loose file is
/// picked up automatically without touching this file.
function directChildIgnFiles(rootPath: str): Vector<String> {
  let mut files: Vector<String> = Vector::new<String>();

  let dirResult: Result<Fs::ReadDir, Io::IoError> = Fs::ReadDir::open(rootPath);
  let Result::OK(dirValue) = dirResult else {
    return files;
  };
  let mut dir: Fs::ReadDir = dirValue;

  while (true) {
    let Result::OK(entryOpt) = dir.next() else {
      break;
    };

    let Option::SOME(entry) = entryOpt else {
      break;
    };

    if (!entry.isFile()) {
      continue;
    }

    let mut path: String = entry.path.toString();

    if (isIgnFile(&path)) {
      files.push(path);
    } else {
      path.drop();
    }
  }

  return files;
}

/// Lists the immediate subdirectory names of `rootPath` (not full paths),
/// sorted lexically for a deterministic, diffable comparison.
function subdirectoryNames(rootPath: str): Vector<String> {
  let mut names: Vector<String> = Vector::new<String>();

  let dirResult: Result<Fs::ReadDir, Io::IoError> = Fs::ReadDir::open(rootPath);
  let Result::OK(dirValue) = dirResult else {
    return names;
  };
  let mut dir: Fs::ReadDir = dirValue;

  while (true) {
    let Result::OK(entryOpt) = dir.next() else {
      break;
    };

    let Option::SOME(entry) = entryOpt else {
      break;
    };

    if (entry.isDir() && !Fs::isDotEntry(entry.name.clone())) {
      names.push(entry.name.clone());
    }
  }

  Sort::stableLexicalStrings(&mut names);
  return names;
}

function firstDifferingLine(left: &String, right: &String): u64 {
  let leftLines: Vector<String> = corpusLines(left);
  let rightLines: Vector<String> = corpusLines(right);
  let mut index: u64 = 0;

  while (index < leftLines.length() && index < rightLines.length()) {
    let Option::SOME(leftLine) = leftLines.get(index) else {
      return index + 1;
    };

    let Option::SOME(rightLine) = rightLines.get(index) else {
      return index + 1;
    };

    if (!leftLine.equals(rightLine)) {
      return index + 1;
    }

    index += 1;
  }

  if (leftLines.length() != rightLines.length()) {
    return index + 1;
  }

  return 0;
}

function reportDifference(
  report: &mut String,
  path: &String,
  source: &String,
  formatted: &String
): void {
  let mut reportRef: &mut String = report;
  let lineNumber: u64 = firstDifferingLine(source, formatted);
  let lineText: String = lineNumber.toString();

  let mut message: String = String::create("formatter corpus difference: ");
  message.push(path);
  message.pushStr(" at line ");
  message.push(&lineText);
  message.pushStr("\n  input:  ");

  let sourceLines: Vector<String> = corpusLines(source);
  let formattedLines: Vector<String> = corpusLines(formatted);

  if (lineNumber > 0) {
    if (let Option::SOME(sourceLine) = sourceLines.get(lineNumber - 1)) {
      message.push(sourceLine);
    }

    message.pushStr("\n  output: ");

    if (let Option::SOME(formattedLine) = formattedLines.get(lineNumber - 1)) {
      message.push(formattedLine);
    }
  }

  reportRef.push(&message);
  reportRef.pushChar('\n');
}

function reportError(report: &mut String, path: &String, detail: &String): void {
  let mut reportRef: &mut String = report;
  let mut message: String = String::create("formatter corpus error: ");
  message.push(path);
  message.pushStr(": ");
  message.push(detail);
  reportRef.push(&message);
  reportRef.pushChar('\n');
}

/// Formats every file in `files`, returning how many failed.
///
/// `requireFixedPoint` asks for byte equality with the input; otherwise the
/// file only has to format without an error (`Format::formatSource` already
/// rejects an unstable second pass on its own).
function runCorpusFiles(
  files: &Vector<String>,
  requireFixedPoint: boolean,
  report: &mut String
): u64 {
  let mut reportRef: &mut String = report;
  let config: FormatterConfig = FormatterConfig::default();
  let mut failures: u64 = 0;
  let mut fileIndex: u64 = 0;

  while (fileIndex < files.length()) {
    let Option::SOME(path) = files.get(fileIndex) else {
      fileIndex += 1;
      continue;
    };

    let Result::OK(source) = Fs::readToString(path.toStr()) else {
      let detail: String = String::create("could not read file");
      reportError(reportRef, path, &detail);
      failures += 1;
      fileIndex += 1;
      continue;
    };

    let Result::OK(formatted) = Format::formatSource(&source, &config) else {
      let Result::ERROR(error) = Format::formatSource(&source, &config) else {
        fileIndex += 1;
        continue;
      };

      let detail: String = error.describe();
      reportError(reportRef, path, &detail);

      if (requireFixedPoint) {
        failures += 1;
      }

      fileIndex += 1;
      continue;
    };

    if (requireFixedPoint && !formatted.equals(&source)) {
      reportDifference(reportRef, path, &source, &formatted);
      failures += 1;
    }

    fileIndex += 1;
  }

  return failures;
}

/// Writes a per-test failure report (namespaced by `label` so parallel test
/// processes never race on the same output file) and fails the test when
/// `failures > 0`.
function finishCorpusReport(label: str, report: &String, failures: u64): void {
  if (report.length() > 0) {
    let mut path: String = String::create("build/format-corpus-");
    path.pushStr(label);
    path.pushStr(".txt");

    if (let Result::ERROR(_) = Fs::writeString(path.toStr(), report)) {
      let mut writeFailure: String = String::create("formatter corpus: could not write ");
      writeFailure.push(&path);
      Io::eprintln(writeFailure);
    }

    Io::eprintln(report.clone());
  }

  if (failures > 0) {
    let count: String = failures.toString();
    let mut message: String = String::create("formatter corpus (");
    message.pushStr(label);
    message.pushStr("): ");
    message.push(&count);
    message.pushStr(" file(s) differ from their host-formatted input");
    Io::eprintln(message);
    Test::fail();
  }
}

/// Formats every `.ign` file recursively under `root`, requiring byte-for-byte
/// equality with the (already host-formatted) input.
function runFixedPointDir(label: str, root: str): void {
  let files: Vector<String> = collectIgnFiles(root);
  let mut report: String = String::new();
  let failures: u64 = runCorpusFiles(&files, true, &mut report);
  finishCorpusReport(label, &report, failures);
}

/// Formats every `.ign` file recursively under `root`, only checking for a
/// clean, stable pass: `test_cases/` and `example/` hold fixtures the host
/// formatter itself rewrites or rejects (deliberately malformed parser
/// inputs, unformatted analyzer cases), so byte equality is not asserted.
function runToleratedDir(label: str, root: str): void {
  let files: Vector<String> = collectIgnFiles(root);
  let mut report: String = String::new();

  // `requireFixedPoint: false` never counts a failure (see runCorpusFiles),
  // so the findings this reports are never asserted — only recorded.
  let _findings: u64 = runCorpusFiles(&files, false, &mut report);
  finishCorpusReport(label, &report, 0);
}

/// The number of shards `test_cases/e2e/ok` is split into. Its file count is
/// by far the largest of any single directory in the corpus (into the
/// hundreds), so it is chunked by sorted index range rather than getting one
/// `@test` per directory like everything else.
///
/// `corpusE2eOkShardSizeStaysReasonable` asserts each shard stays under a
/// generous file-count ceiling; bump `E2E_OK_SHARD_COUNT` if that ever trips.
function e2eOkShardCount(): u64 {
  return 8;
}

/// Byte-range shard `shardIndex` (0-based) of `shardCount` over the sorted
/// file list at `root`. Contiguous, non-overlapping, gap-free by
/// construction: shard `i` covers `[i * ceil(total / shardCount), (i + 1) *
/// ceil(total / shardCount))`, clamped to `total`, so the union of every
/// shard from 0 to `shardCount - 1` is always the full file list, regardless
/// of how many files exist.
function shardOfSortedFiles(root: str, shardIndex: u64, shardCount: u64): Vector<String> {
  let mut all: Vector<String> = collectIgnFiles(root);
  Sort::stableLexicalStrings(&mut all);

  let total: u64 = all.length();
  let chunkSize: u64 = (total + shardCount - 1) / shardCount;
  let mut start: u64 = shardIndex * chunkSize;
  let mut end: u64 = start + chunkSize;

  if (start > total) {
    start = total;
  }

  if (end > total) {
    end = total;
  }

  let mut shard: Vector<String> = Vector::new<String>();
  let mut index: u64 = start;

  while (index < end) {
    let Option::SOME(path) = all.get(index) else {
      index += 1;
      continue;
    };

    shard.push(path.clone());
    index += 1;
  }

  return shard;
}

function runToleratedShard(label: str, root: str, shardIndex: u64, shardCount: u64): void {
  let files: Vector<String> = shardOfSortedFiles(root, shardIndex, shardCount);
  let mut report: String = String::new();

  // `requireFixedPoint: false` never counts a failure (see runCorpusFiles),
  // so the findings this reports are never asserted — only recorded.
  let _findings: u64 = runCorpusFiles(&files, false, &mut report);
  finishCorpusReport(label, &report, 0);
}

/// Counts a file's lines by reading it. Only used by the line-balanced
/// sharding/guard helpers below, never on the fixed-point hot path.
function lineCountOf(path: &String): u64 {
  let Result::OK(source) = Fs::readToString(path.toStr()) else {
    return 0;
  };

  return source.lines().length();
}

/// Output of `packFilesByLineCount`: `files` is the (lexically sorted) file
/// list, `assignment[i]` is the shard index `files[i]` was packed into, and
/// `totals[shardIndex]` is that shard's summed line count.
record LineBalancedShards {
  public files: Vector<String>;
  public assignment: Vector<u64>;
  public totals: Vector<u64>;
}

/// Greedily packs every `.ign` file recursively under `root` into
/// `shardCount` groups by line count, heaviest file first, each file going
/// to the shard with the smallest running total so far (ties go to the
/// lowest shard index). Unlike an index-range split, this balances total
/// cost per shard rather than file count — needed for a directory like
/// `ignis/analyzer` where a handful of files are 3k-15k lines and the rest
/// are a fraction of that. Deterministic and computed fresh from the tree
/// every run (files are sorted lexically first, so ties in line count break
/// the same way every time), so a new or resized file is picked up
/// automatically without touching this file.
function packFilesByLineCount(root: str, shardCount: u64): LineBalancedShards {
  let mut files: Vector<String> = collectIgnFiles(root);
  Sort::stableLexicalStrings(&mut files);

  let fileCount: u64 = files.length();

  let mut lineCounts: Vector<u64> = Vector::new<u64>();
  let mut countIndex: u64 = 0;

  while (countIndex < fileCount) {
    let Option::SOME(path) = files.get(countIndex) else {
      countIndex += 1;
      continue;
    };

    lineCounts.push(lineCountOf(path));
    countIndex += 1;
  }

  // Selection sort of file indices by descending line count (small N, so
  // O(n^2) is fine, and it avoids a closure capturing `lineCounts`).
  let mut order: Vector<u64> = Vector::new<u64>();
  let mut orderInit: u64 = 0;

  while (orderInit < fileCount) {
    order.push(orderInit);
    orderInit += 1;
  }

  let mut outer: u64 = 0;

  while (outer < order.length()) {
    let mut largestPos: u64 = outer;
    let mut largestLines: u64 = 0;

    if (let Option::SOME(outerFileIndex) = order.get(outer)) {
      if (let Option::SOME(lines) = lineCounts.get(*outerFileIndex)) {
        largestLines = *lines;
      }
    }

    let mut inner: u64 = outer + 1;

    while (inner < order.length()) {
      let mut candidateLines: u64 = 0;

      if (let Option::SOME(innerFileIndex) = order.get(inner)) {
        if (let Option::SOME(lines) = lineCounts.get(*innerFileIndex)) {
          candidateLines = *lines;
        }
      }

      if (candidateLines > largestLines) {
        largestLines = candidateLines;
        largestPos = inner;
      }

      inner += 1;
    }

    if (largestPos != outer) {
      let Option::SOME(outerValueRef) = order.get(outer) else {
        outer += 1;
        continue;
      };
      let Option::SOME(largestValueRef) = order.get(largestPos) else {
        outer += 1;
        continue;
      };
      let outerValue: u64 = *outerValueRef;
      let largestValue: u64 = *largestValueRef;

      order.set(outer, largestValue);
      order.set(largestPos, outerValue);
    }

    outer += 1;
  }

  // Greedy bin packing: heaviest file first, into the currently-lightest
  // shard.
  let mut totals: Vector<u64> = Vector::new<u64>();
  let mut totalsInit: u64 = 0;

  while (totalsInit < shardCount) {
    totals.push(0);
    totalsInit += 1;
  }

  let mut assignment: Vector<u64> = Vector::new<u64>();
  let mut assignInit: u64 = 0;

  while (assignInit < fileCount) {
    assignment.push(0);
    assignInit += 1;
  }

  let mut orderPos: u64 = 0;

  while (orderPos < order.length()) {
    let Option::SOME(fileIndexRef) = order.get(orderPos) else {
      orderPos += 1;
      continue;
    };
    let fileIndex: u64 = *fileIndexRef;

    let mut bestShard: u64 = 0;
    let mut bestTotal: u64 = 0;

    if (let Option::SOME(firstTotal) = totals.get(0)) {
      bestTotal = *firstTotal;
    }

    let mut shardScan: u64 = 1;

    while (shardScan < shardCount) {
      let Option::SOME(candidateTotal) = totals.get(shardScan) else {
        shardScan += 1;
        continue;
      };

      if (*candidateTotal < bestTotal) {
        bestTotal = *candidateTotal;
        bestShard = shardScan;
      }

      shardScan += 1;
    }

    assignment.set(fileIndex, bestShard);

    let mut fileLines: u64 = 0;

    if (let Option::SOME(lines) = lineCounts.get(fileIndex)) {
      fileLines = *lines;
    }

    totals.set(bestShard, bestTotal + fileLines);
    orderPos += 1;
  }

  return LineBalancedShards { files: files, assignment: assignment, totals: totals };
}

/// The file list `packFilesByLineCount` assigned to shard `shardIndex`.
function shardOfFilesByLineCount(root: str, shardIndex: u64, shardCount: u64): Vector<String> {
  let packed: LineBalancedShards = packFilesByLineCount(root, shardCount);
  let mut shard: Vector<String> = Vector::new<String>();
  let mut index: u64 = 0;

  while (index < packed.files.length()) {
    let Option::SOME(assignedShard) = packed.assignment.get(index) else {
      index += 1;
      continue;
    };

    if (*assignedShard == shardIndex) {
      let Option::SOME(path) = packed.files.get(index) else {
        index += 1;
        continue;
      };

      shard.push(path.clone());
    }

    index += 1;
  }

  return shard;
}

/// The number of shards `ignis/analyzer` is packed into. Its files vary
/// wildly in size (several are 3k-15k lines each, most are a fraction of
/// that), so an index-range split like `test_cases/e2e/ok`'s would leave
/// some shards far heavier than others; `packFilesByLineCount` bin-packs by
/// line count instead, balancing total cost per shard rather than file
/// count.
///
/// `corpusIgnisAnalyzerShardSizeStaysReasonable` asserts the heaviest
/// shard's line total stays under a ceiling; bump this and add the matching
/// `corpusIgnisAnalyzerShardN` test if that ever trips.
function ignisAnalyzerShardCount(): u64 {
  return 6;
}

/// Formats one line-balanced shard of `root`, requiring byte-for-byte
/// equality with the (already host-formatted) input.
function runFixedPointLineShard(label: str, root: str, shardIndex: u64, shardCount: u64): void {
  let files: Vector<String> = shardOfFilesByLineCount(root, shardIndex, shardCount);
  let mut report: String = String::new();
  let failures: u64 = runCorpusFiles(&files, true, &mut report);
  finishCorpusReport(label, &report, failures);
}

// ---------------------------------------------------------------------------
// ignis/ — one @test per top-level subdirectory, plus one for the loose files
// directly inside `ignis/`. `ignis/analyzer` is line-balanced-sharded like
// `test_cases/e2e/ok` (see `ignisAnalyzerShardCount`); every other
// subdirectory is small and even enough for one @test. All are fixed points
// of the host formatter.
// ---------------------------------------------------------------------------

@test
function corpusIgnisRootFiles(): void {
  let files: Vector<String> = directChildIgnFiles("ignis");
  let mut report: String = String::new();
  let failures: u64 = runCorpusFiles(&files, true, &mut report);
  finishCorpusReport("ignis-root", &report, failures);
}

@test
function corpusIgnisAnalyzerShard0(): void {
  runFixedPointLineShard("ignis-analyzer-0", "ignis/analyzer", 0, ignisAnalyzerShardCount());
}

