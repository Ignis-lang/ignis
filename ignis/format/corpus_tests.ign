// ---------------------------------------------------------------------------
// Coverage sanity check — guards against a new top-level directory or a
// large `test_cases/e2e/ok` growth spurt silently escaping every unit test
// above.
// ---------------------------------------------------------------------------

function knownIgnisSubdirs(): Vector<String> {
  let mut names: Vector<String> = Vector::new<String>();
  names.push(String::create("analyzer"));
  names.push(String::create("ast"));
  names.push(String::create("build"));
  names.push(String::create("codegen"));
  names.push(String::create("config"));
  names.push(String::create("diagnostics"));
  names.push(String::create("doc"));
  names.push(String::create("format"));
  names.push(String::create("hir"));
  names.push(String::create("ids"));
  names.push(String::create("indexing"));
  names.push(String::create("interning"));
  names.push(String::create("lexer"));
  names.push(String::create("lir"));
  names.push(String::create("lsp"));
  names.push(String::create("parser"));
  names.push(String::create("symbols"));
  names.push(String::create("syntax"));
  Sort::stableLexicalStrings(&mut names);
  return names;
}

