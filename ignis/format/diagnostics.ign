import Path from "std::path";

import Diagnostic, DiagnosticBag, Severity, SourceMap, SourceSpan from "@compiler::diagnostics";

function formatConfigSpan(sourceMap: &mut SourceMap, path: &Path::PathBuf): SourceSpan {
  return SourceSpan::new(sourceMap.register(path.asStr()), 0, 0);
}

function singleDiagnostic(diagnostic: Diagnostic): DiagnosticBag {
  let mut bag: DiagnosticBag = DiagnosticBag::init();
  bag.push(diagnostic);
  return bag;
}

export namespace FormatConfigDiagnosticCode {
  const IO: str = "F1001";
  const PARSE: str = "F1002";
  const UNKNOWN_KEY: str = "F1003";
  const INVALID_VALUE: str = "F1004";
}

export namespace FormatConfigDiagnostics {
  function io(sourceMap: &mut SourceMap, path: &Path::PathBuf, message: &String): DiagnosticBag {
    let pathText: String = path.toString();

    let mut text: String = String::create("failed to read formatter config '");
    text.push(&pathText);
    text.pushStr("': ");
    text.push(message);

    return singleDiagnostic(Diagnostic::new(
      Severity::ERROR,
      FormatConfigDiagnosticCode::IO,
      text.toStr(),
      formatConfigSpan(sourceMap, path),
    ));
  }

  function parse(sourceMap: &mut SourceMap, path: &Path::PathBuf, message: &String): DiagnosticBag {
    let pathText: String = path.toString();

    let mut text: String = String::create("failed to parse formatter config '");
    text.push(&pathText);
    text.pushStr("': ");
    text.push(message);

    return singleDiagnostic(Diagnostic::new(
      Severity::ERROR,
      FormatConfigDiagnosticCode::PARSE,
      text.toStr(),
      formatConfigSpan(sourceMap, path),
    ));
  }

  function unknownKey(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    key: &String
  ): DiagnosticBag {
    let pathText: String = path.toString();

    let mut text: String = String::create("formatter config '");
    text.push(&pathText);
    text.pushStr("' contains unsupported key '");
    text.push(key);
    text.pushStr("'");

    return singleDiagnostic(Diagnostic::new(
      Severity::ERROR,
      FormatConfigDiagnosticCode::UNKNOWN_KEY,
      text.toStr(),
      formatConfigSpan(sourceMap, path),
    ));
  }

  function invalidValue(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    key: str,
    message: &String
  ): DiagnosticBag {
    let pathText: String = path.toString();

    let mut text: String = String::create("formatter config '");
    text.push(&pathText);
    text.pushStr("' has invalid '");
    text.pushStr(key);
    text.pushStr("': ");
    text.push(message);

    return singleDiagnostic(Diagnostic::new(
      Severity::ERROR,
      FormatConfigDiagnosticCode::INVALID_VALUE,
      text.toStr(),
      formatConfigSpan(sourceMap, path),
    ));
  }
}
