import Fs from "std::fs";
import Json, JsonObjectEntry, JsonValue, JsonValueKind from "std::json";
import Path from "std::path";
import String from "std::string";
import Vector from "std::vector";

import FormatterConfig from "./config";
import FormatError from "./error";
import _ from "./layout_items";
import _ from "./model";
import _ from "./printer";
import _ from "./safety";

/// `String::lines()` appends a spurious trailing empty entry when the text ends
/// with '\n', unlike Rust's `str::lines()` (repro
/// "string-lines-trailing-newline").
function apiLines(text: &String): Vector<String> {
  let mut lines: Vector<String> = text.lines();

  if (text.length() > 0 && lines.length() > 0) {
    let Option::SOME(lastByte) = text.byteAt(text.length() - 1) else {
      return lines;
    };

    if (lastByte == '\n' as u8) {
      lines.pop();
    }
  }

  return lines;
}

function maxU64(left: u64, right: u64): u64 {
  if (left > right) {
    return left;
  }

  return right;
}

function minU64(left: u64, right: u64): u64 {
  if (left < right) {
    return left;
  }

  return right;
}

function saturatingSub(value: u64, amount: u64): u64 {
  if (value < amount) {
    return 0;
  }

  return value - amount;
}

export namespace Format {
  /// What a single formatting run was asked to do. `check` keeps the file on
  /// disk untouched, which is what both `--check` and `--emit diff` need.
  record FormatOptions {
    public check: boolean;
    public config: FormatterConfig;

    public static withConfig(config: &FormatterConfig): Format::FormatOptions {
      return Format::FormatOptions {
        check: false,
        config: FormatterConfig {
          indentWidth: config.indentWidth,
          lineWidth: config.lineWidth,
          useTabs: config.useTabs,
          sortImports: config.sortImports,
        },
      };
    }
  }

  record FormatOutcome {
    public changed: boolean;
    public formatted: String;
  }

  /// Formats `source` and refuses the result unless it is safe: same tokens,
  /// same comment ownership, same directives, and stable under a second pass.
  function formatSource(source: &String, config: &FormatterConfig): Result<String, FormatError> {
    let formatted: String = Format::formatSourceUnchecked(source, config)!;

    Format::validateFormattedOutput(source, &formatted, config.sortImports)!;

    let reformatted: String = Format::formatSourceUnchecked(&formatted, config)!;

    if (!reformatted.equals(&formatted)) {
      return Result::ERROR(FormatError::safety("formatted output is not idempotent on a second formatter pass"));
    }

    return Result::OK(formatted);
  }

  /// The layout pipeline on its own: model, layout, print. Skips the safety
  /// checks, which is what the idempotence check itself needs.
  function formatSourceUnchecked(
    source: &String,
    config: &FormatterConfig
  ): Result<String, FormatError> {
    let file: Format::FormatFile = Format::FormatFile::fromSource(source)!;
    let laidOut: Format::FormatFile = Format::layoutFile(&file, config)!;
    return Format::printFile(&laidOut, config);
  }

  /// True when formatting would rewrite `source`, which is the `--check`
  /// verdict for one file.
  function sourceNeedsFormatting(
    source: &String,
    config: &FormatterConfig
  ): Result<boolean, FormatError> {
    let formatted: String = Format::formatSource(source, config)!;
    return Result::OK(!formatted.equals(source));
  }

  /// Formats the file at `path`, rewriting it unless the run is read-only.
  function formatFile(
    path: &Path::PathBuf,
    options: &Format::FormatOptions
  ): Result<Format::FormatOutcome, FormatError> {
    let Result::OK(source) = Fs::readToString(path) else {
      return Result::ERROR(FormatError::io("could not read file"));
    };

    let formatted: String = Format::formatSource(&source, &options.config)!;
    let changed: boolean = !formatted.equals(&source);

    if (changed && !options.check) {
      let Result::OK(_) = Fs::writeString(path, &formatted) else {
        return Result::ERROR(FormatError::io("could not write file"));
      };
    }

    return Result::OK(Format::FormatOutcome { changed: changed, formatted: formatted });
  }

  /// Renders a unified diff between two texts, with three lines of context
  /// around each run of changed lines. Line-aligned rather than
  /// longest-common-subsequence based, matching the host CLI.
  function unifiedDiff(path: &String, oldText: &String, newText: &String): String {
    let oldLines: Vector<String> = apiLines(oldText);
    let newLines: Vector<String> = apiLines(newText);

    let mut output: String = String::create("--- ");
    output.push(path);
    output.pushStr("\n+++ ");
    output.push(path);
    output.pushChar('\n');

    let maxLines: u64 = maxU64(oldLines.length(), newLines.length());

    let mut changeStarts: Vector<u64> = Vector::new<u64>();
    let mut changeEnds: Vector<u64> = Vector::new<u64>();

    let mut inChange: boolean = false;
    let mut changeStart: u64 = 0;
    let mut index: u64 = 0;

    while (index < maxLines) {
      let mut linesAreEqual: boolean = false;

      if (index < oldLines.length() && index < newLines.length()) {
        if (let Option::SOME(oldLine) = oldLines.get(index)) {
          if (let Option::SOME(newLine) = newLines.get(index)) {
            linesAreEqual = oldLine.equals(newLine);
          }
        }
      }

      if (linesAreEqual) {
        if (inChange) {
          changeStarts.push(changeStart);
          changeEnds.push(index);
          inChange = false;
        }
      } else {
        if (!inChange) {
          changeStart = index;
          inChange = true;
        }
      }

      index += 1;
    }

    if (inChange) {
      changeStarts.push(changeStart);
      changeEnds.push(maxLines);
    }

    let mut hunkIndex: u64 = 0;

    while (hunkIndex < changeStarts.length()) {
      let Option::SOME(start) = changeStarts.get(hunkIndex) else {
        hunkIndex += 1;
        continue;
      };

      let Option::SOME(end) = changeEnds.get(hunkIndex) else {
        hunkIndex += 1;
        continue;
      };

      let contextBefore: u64 = saturatingSub(*start, 3);
      let contextAfter: u64 = minU64(*end + 3, maxLines);
      let hunkLength: u64 = contextAfter - contextBefore;

      let headerStartValue: u64 = contextBefore + 1;
      let headerStart: String = headerStartValue.toString();
      let headerLength: String = hunkLength.toString();

      output.pushStr("@@ -");
      output.push(&headerStart);
      output.pushStr(",");
      output.push(&headerLength);
      output.pushStr(" +");
      output.push(&headerStart);
      output.pushStr(",");
      output.push(&headerLength);
      output.pushStr(" @@\n");

      let mut lineIndex: u64 = contextBefore;

      while (lineIndex < contextAfter) {
        let oldLine: Option<&String> = oldLines.get(lineIndex);
        let newLine: Option<&String> = newLines.get(lineIndex);

        if (lineIndex >= *start && lineIndex < *end) {
          if (let Option::SOME(line) = oldLine) {
            output.pushStr("-");
            output.push(line);
            output.pushChar('\n');
          }

          if (let Option::SOME(line) = newLine) {
            output.pushStr("+");
            output.push(line);
            output.pushChar('\n');
          }
        } else {
          if (let Option::SOME(line) = oldLine) {
            output.pushStr(" ");
            output.push(line);
            output.pushChar('\n');
          } else if (let Option::SOME(line) = newLine) {
            output.pushStr(" ");
            output.push(line);
            output.pushChar('\n');
          }
        }

        lineIndex += 1;
      }

      hunkIndex += 1;
    }

    return output;
  }

  /// One `{"path": ..., "text": ...}` record of the `--stdin-json` protocol.
  record StdinRequest {
    public path: String;
    public text: String;
  }

  /// One response line of the `--stdin-json` protocol. `formatted` is omitted
  /// in diff mode, `diff` outside it, and `error` whenever the run succeeded.
  record StdinResponse {
    public path: String;
    public hasFormatted: boolean;
    public formatted: String;
    public changed: boolean;
    public hasDiff: boolean;
    public diff: String;
    public hasError: boolean;
    public error: String;
  }

  /// Wraps a bare message with the prefix every NDJSON parse failure carries.
  function ndjsonParseError(message: &String): String {
    let mut result: String = String::create("failed to parse NDJSON record: ");
    result.push(message);
    return result;
  }

  function ndjsonInvalidType(kindDescription: &String, endOffset: u64): String {
    let column: String = endOffset.toString();

    let mut message: String = String::create("invalid type: ");
    message.push(kindDescription);
    message.pushStr(", expected struct StdinRecord at line 1 column ");
    message.push(&column);
    return Format::ndjsonParseError(&message);
  }

  function ndjsonInvalidFieldType(kindDescription: &String, endOffset: u64): String {
    let column: String = endOffset.toString();

    let mut message: String = String::create("invalid type: ");
    message.push(kindDescription);
    message.pushStr(", expected a string at line 1 column ");
    message.push(&column);
    return Format::ndjsonParseError(&message);
  }

  function ndjsonInvalidLength(itemCount: u64, endOffset: u64): String {
    let countText: String = itemCount.toString();
    let column: String = endOffset.toString();

    let mut message: String = String::create("invalid length ");
    message.push(&countText);
    message.pushStr(", expected struct StdinRecord with 2 elements at line 1 column ");
    message.push(&column);
    return Format::ndjsonParseError(&message);
  }

  /// `serde` reports the first missing field in the struct's declared order,
  /// which is `path` then `text`, at the position where the whole value
  /// finished parsing.
  function ndjsonMissingField(name: str, endOffset: u64): String {
    let column: String = endOffset.toString();

    let mut message: String = String::create("missing field `");
    message.pushStr(name);
    message.pushStr("` at line 1 column ");
    message.push(&column);
    return Format::ndjsonParseError(&message);
  }

  function ndjsonTrailingCharacters(column: u64): String {
    let columnText: String = column.toString();

    let mut message: String = String::create("trailing characters at line 1 column ");
    message.push(&columnText);
    return Format::ndjsonParseError(&message);
  }

  function describeBool(value: boolean): String {
    if (value) {
      return String::create("boolean `true`");
    }

    return String::create("boolean `false`");
  }

  /// `serde_json` reports a JSON number as `integer` unless its text carries
  /// a fractional or exponent part, in which case it is `floating point`.
  function describeNumber(text: &String): String {
    let mut isFloat: boolean = false;
    let mut index: u64 = 0;

    while (index < text.length()) {
      let Option::SOME(byte) = text.byteAt(index) else {
        break;
      };

      if (byte == '.' as u8 || byte == 'e' as u8 || byte == 'E' as u8) {
        isFloat = true;
        break;
      }

      index += 1;
    }

    let mut message: String = String::new();

    if (isFloat) {
      message.pushStr("floating point `");
    } else {
      message.pushStr("integer `");
    }

    message.push(text);
    message.pushStr("`");
    return message;
  }

  function describeString(text: &String): String {
    let mut quoted: String = String::new();
    Format::escapeJsonString(text, &mut quoted);

    let mut message: String = String::create("string ");
    message.push(&quoted);
    return message;
  }

  /// Describes a JSON value the way `serde`'s `Unexpected` enum's `Display`
  /// impl does, for every `invalid type: <this>, ...` message `serde_json`
  /// reports: `null` bare, `` boolean `true` ``, `` integer `123` `` or
  /// `` floating point `1.5` ``, and `string "text"` with the same escaping
  /// `Format::escapeJsonString` already produces for output. `ARRAY`/`OBJECT`
  /// never reach this: `parseStdinRequest` gives arrays their own
  /// `invalid length` message, and a top-level object is the success path.
  function describeJsonValueKind(kind: &JsonValueKind): String {
    return match (kind) {
      JsonValueKind::NULL -> String::create("null"),
      JsonValueKind::BOOL(value) -> Format::describeBool(value),
      JsonValueKind::NUMBER(text) -> Format::describeNumber(&text),
      JsonValueKind::STRING(text) -> Format::describeString(&text),
      JsonValueKind::ARRAY(_) -> String::create("sequence"),
      JsonValueKind::OBJECT(_) -> String::create("map"),
    };
  }

  /// `None` when `value` is not a JSON string, for the field-level
  /// `invalid type: ..., expected a string` check.
  function jsonStringField(value: &JsonValue): Option<String> {
    return match (&value.kind) {
      JsonValueKind::STRING(text) -> Option::SOME(text.clone()),
      _ -> Option::NONE,
    };
  }

  function skipAsciiWhitespaceFrom(line: &String, start: u64): u64 {
    let mut cursor: u64 = start;

    while (cursor < line.length()) {
      let Option::SOME(byte) = line.byteAt(cursor) else {
        break;
      };

      if (byte != ' ' as u8 && byte != '\t' as u8 && byte != '\n' as u8 && byte != '\r' as u8) {
        break;
      }

      cursor += 1;
    }

    return cursor;
  }

  /// Maps a parsed top-level JSON object onto the two fields the protocol
  /// defines, matching a `serde`-derived struct's field visitor: fields are
  /// read in JSON order, a wrong-typed occurrence errors immediately (even if
  /// a correctly-typed occurrence of the same key follows), and a later
  /// correctly-typed occurrence of the same key silently overwrites an
  /// earlier one. Any other key (including one nested inside another object,
  /// like `"meta":{"path":"evil.ign"}`) is ignored, the same way an unknown
  /// field is for a struct without `deny_unknown_fields`.
  function stdinRequestFromObject(
    line: &String,
    objectValue: &JsonValue,
    entries: &Vector<JsonObjectEntry>
  ): Result<Format::StdinRequest, String> {
    let mut path: Option<String> = Option::NONE;
    let mut text: Option<String> = Option::NONE;
    let mut index: u64 = 0;

    while (index < entries.length()) {
      let Option::SOME(entry) = entries.get(index) else {
        index += 1;
        continue;
      };

      let isPathKey: boolean = entry.key.equals("path");
      let isTextKey: boolean = entry.key.equals("text");

      if (isPathKey || isTextKey) {
        let Option::SOME(stringValue) = Format::jsonStringField(&entry.value) else {
          let description: String = Format::describeJsonValueKind(&entry.value.kind);
          return Result::ERROR(Format::ndjsonInvalidFieldType(&description, entry.value.endOffset));
        };

        if (isPathKey) {
          path = Option::SOME(stringValue);
        } else {
          text = Option::SOME(stringValue);
        }
      }

      index += 1;
    }

    let Option::SOME(pathValue) = path else {
      return Result::ERROR(Format::ndjsonMissingField("path", objectValue.endOffset));
    };

    let Option::SOME(textValue) = text else {
      return Result::ERROR(Format::ndjsonMissingField("text", objectValue.endOffset));
    };

    let afterObject: u64 = Format::skipAsciiWhitespaceFrom(line, objectValue.endOffset);
    let lineLength: u64 = line.length();

    if (afterObject != lineLength) {
      return Result::ERROR(Format::ndjsonTrailingCharacters(afterObject + 1));
    }

    return Result::OK(Format::StdinRequest { path: pathValue, text: textValue });
  }

  /// Maps a parsed top-level JSON array onto the two fields the protocol
  /// defines. A derived `serde` struct accepts a sequence positionally (index
  /// 0 is the first declared field, `path`; index 1 is `text`) as well as a
  /// map, so a 2-element array is not an `invalid length` error the way any
  /// other length is: confirmed against the host with `["a","b"]`, which
  /// succeeds with `path: "a"`, `text: "b"`.
  function stdinRequestFromArray(
    line: &String,
    arrayValue: &JsonValue,
    items: &Vector<JsonValue>
  ): Result<Format::StdinRequest, String> {
    let itemCount: u64 = items.length();

    if (itemCount != 2) {
      return Result::ERROR(Format::ndjsonInvalidLength(itemCount, arrayValue.endOffset));
    }

    let Option::SOME(pathItem) = items.get(0) else {
      return Result::ERROR(Format::ndjsonInvalidLength(itemCount, arrayValue.endOffset));
    };

    let Option::SOME(textItem) = items.get(1) else {
      return Result::ERROR(Format::ndjsonInvalidLength(itemCount, arrayValue.endOffset));
    };

    let Option::SOME(pathValue) = Format::jsonStringField(pathItem) else {
      return Result::ERROR(Format::ndjsonInvalidFieldTypeResult(&pathItem.kind, pathItem.endOffset));
    };

    let Option::SOME(textValue) = Format::jsonStringField(textItem) else {
      return Result::ERROR(Format::ndjsonInvalidFieldTypeResult(&textItem.kind, textItem.endOffset));
    };

    let afterArray: u64 = Format::skipAsciiWhitespaceFrom(line, arrayValue.endOffset);
    let lineLength: u64 = line.length();

    if (afterArray != lineLength) {
      return Result::ERROR(Format::ndjsonTrailingCharacters(afterArray + 1));
    }

    return Result::OK(Format::StdinRequest { path: pathValue, text: textValue });
  }

  function ndjsonInvalidFieldTypeResult(kind: &JsonValueKind, endOffset: u64): String {
    let description: String = Format::describeJsonValueKind(kind);
    return Format::ndjsonInvalidFieldType(&description, endOffset);
  }

  /// Reads one NDJSON request line through a real JSON parse tree
  /// (`Json::parse`) rather than a quote scanner, so a nested object cannot
  /// leak a key into the top-level result and a malformed line is rejected
  /// the way `serde_json::from_str::<StdinRecord>` rejects it.
  ///
  /// Every message mirrors the host's exact `serde_json` wording, checked
  /// against the host binary for each shape below. The column `serde_json`
  /// reports is the byte offset (1-based) immediately after whichever token
  /// it was inspecting when it gave up:
  ///
  /// - A parse failure inside `Json::parse` (unterminated string, unterminated
  ///   object) already carries `serde`'s "EOF while parsing ..." wording, at
  ///   the full line length: nothing is left to read.
  /// - A wrong-typed top-level scalar (`null`, a number, a bare string) or a
  ///   wrong-typed field value (`"text":1`) is `invalid type: ...`, at the
  ///   position right after that value's own token — deserializing into a
  ///   `String` or a `StdinRecord` fails on sight, before the rest of the
  ///   line is even looked at.
  /// - A top-level array is `invalid length K, ..., expected ... with 2
  ///   elements`, at the position right after the array's closing `]`:
  ///   `serde`'s struct visitor also accepts a 2-element sequence, so an
  ///   array is only rejected once its length is known.
  /// - `missing field` and `trailing characters` are only reachable once the
  ///   object as a whole parsed and every present field had the right type;
  ///   their column is the position right after the object's closing `}` (for
  ///   `missing field`) or right after the first non-whitespace byte that
  ///   follows it (for `trailing characters`).
  function parseStdinRequest(line: &String): Result<Format::StdinRequest, String> {
    let value: JsonValue = match (Json::parse(line)) {
      Result::OK(parsed) -> parsed,
      Result::ERROR(message) -> {
        return Result::ERROR(Format::ndjsonParseError(&message));
      },
    };

    return match (&value.kind) {
      JsonValueKind::OBJECT(entries) -> Format::stdinRequestFromObject(line, &value, &entries),
      JsonValueKind::ARRAY(items) -> Format::stdinRequestFromArray(line, &value, &items),
      _ -> Result::ERROR(Format::ndjsonInvalidTypeResult(&value.kind, value.endOffset)),
    };
  }

  /// `match` arm blocks that `let`-bind a name and then `return` it in the
  /// same block fail to resolve that name (repro
  /// "match-arm-let-return-scoping", also worked around in
  /// `ignis/config/project.ign`'s `readToml`), so the arms above stay single
  /// expressions and the `let`s move into these plain functions instead.
  function ndjsonInvalidTypeResult(kind: &JsonValueKind, endOffset: u64): String {
    let description: String = Format::describeJsonValueKind(kind);
    return Format::ndjsonInvalidType(&description, endOffset);
  }

  function escapeJsonString(value: &String, output: &mut String): void {
    let mut outputRef: &mut String = output;
    outputRef.pushChar('"');

    let mut index: u64 = 0;

    while (index < value.length()) {
      let Option::SOME(byte) = value.byteAt(index) else {
        break;
      };

      if (byte == '"' as u8) {
        outputRef.pushStr("\\\"");
      } else if (byte == '\\' as u8) {
        outputRef.pushStr("\\\\");
      } else if (byte == '\n' as u8) {
        outputRef.pushStr("\\n");
      } else if (byte == '\r' as u8) {
        outputRef.pushStr("\\r");
      } else if (byte == '\t' as u8) {
        outputRef.pushStr("\\t");
      } else if (byte == 8) {
        outputRef.pushStr("\\b");
      } else if (byte == 12) {
        outputRef.pushStr("\\f");
      } else if (byte < 32) {
        outputRef.pushStr("\\u00");
        outputRef.pushByte(Format::hexDigitByte(byte / 16));
        outputRef.pushByte(Format::hexDigitByte(byte % 16));
      } else {
        outputRef.pushByte(byte);
      }

      index += 1;
    }

    outputRef.pushChar('"');
  }

  function hexDigitByte(value: u8): u8 {
    if (value < 10) {
      return ('0' as u8) + value;
    }

    return ('a' as u8) + (value - 10);
  }

  /// Serializes one NDJSON response line, omitting the fields the host omits
  /// when they carry no value.
  function renderStdinResponse(response: &Format::StdinResponse): String {
    let mut output: String = String::create("{");

    output.pushStr("\"path\":");
    Format::escapeJsonString(&response.path, &mut output);

    if (response.hasFormatted) {
      output.pushStr(",\"formatted\":");
      Format::escapeJsonString(&response.formatted, &mut output);
    }

    output.pushStr(",\"changed\":");

    if (response.changed) {
      output.pushStr("true");
    } else {
      output.pushStr("false");
    }

    if (response.hasDiff) {
      output.pushStr(",\"diff\":");
      Format::escapeJsonString(&response.diff, &mut output);
    }

    if (response.hasError) {
      output.pushStr(",\"error\":");
      Format::escapeJsonString(&response.error, &mut output);
    }

    output.pushStr("}");
    return output;
  }

  /// Formats one NDJSON request into the response the protocol expects. In
  /// diff mode the formatted text is replaced by a unified diff.
  function processStdinRequest(
    request: &Format::StdinRequest,
    config: &FormatterConfig,
    emitDiff: boolean
  ): Format::StdinResponse {
    let Result::OK(formatted) = Format::formatSource(&request.text, config) else {
      let Result::ERROR(error) = Format::formatSource(&request.text, config) else {
        return Format::StdinResponse {
          path: request.path.clone(),
          hasFormatted: false,
          formatted: String::new(),
          changed: false,
          hasDiff: false,
          diff: String::new(),
          hasError: true,
          error: String::create("formatter failed"),
        };
      };

      return Format::StdinResponse {
        path: request.path.clone(),
        hasFormatted: false,
        formatted: String::new(),
        changed: false,
        hasDiff: false,
        diff: String::new(),
        hasError: true,
        error: error.describe(),
      };
    };

    let changed: boolean = !formatted.equals(&request.text);

    let mut diff: String = String::new();
    let mut hasDiff: boolean = false;

    if (emitDiff && changed) {
      diff = Format::unifiedDiff(&request.path, &request.text, &formatted);
      hasDiff = true;
    }

    return Format::StdinResponse {
      path: request.path.clone(),
      hasFormatted: !emitDiff,
      formatted: formatted,
      changed: changed,
      hasDiff: hasDiff,
      diff: diff,
      hasError: false,
      error: String::new(),
    };
  }
}
