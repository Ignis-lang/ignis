/// `String::lines()` appends a spurious trailing empty entry when the text ends
/// with '\n', unlike Rust's `str::lines()` (repro
/// "string-lines-trailing-newline").
function apiLines(text: &String): Vector<String> {
  let mut lines: Vector<String> = text.lines();

  if (text.length() > 0 && lines.length() > 0) {
    let Option::SOME(lastByte) = text.byteAt(text.length() - 1) else {
      return lines;
    };

    if (lastByte == '\n' as u8) {
      lines.pop();
    }
  }

  return lines;
}

function maxU64(left: u64, right: u64): u64 {
  if (left > right) {
    return left;
  }

  return right;
}

function minU64(left: u64, right: u64): u64 {
  if (left < right) {
    return left;
  }

  return right;
}

function saturatingSub(value: u64, amount: u64): u64 {
  if (value < amount) {
    return 0;
  }

  return value - amount;
}

/// `libc`'s `snprintf`, bound here (rather than in `std::libc`) only for
/// `describeNumber`'s shortest-round-trip search below: it needs
/// precision-controlled scientific notation (`%.Ne`) that `f64::toString()`
/// (a fixed `%g`) cannot produce.
extern __format_snprintf {
  function snprintf(
    buf: CType::CStr,
    size: CType::SizeT,
    fmt: CType::CConstStr,
    value: CType::CDouble
  ): CType::CInt;
}

/// Formats `value` with `snprintf("%.{precision}e", value)`, returning the
/// raw C string (e.g. `"1.230000e+02"`).
function formatScientific(value: f64, precision: u64): String {
  let mut format: String = String::create("%.");
  let precisionText: String = precision.toString();
  format.push(&precisionText);
  format.pushStr("e");

  let capacity: u64 = 64;
  let buffer: *mut u8 = Memory::allocateVector<u8>(capacity);
  __format_snprintf::snprintf(buffer, capacity, format.toStr() as CType::CConstStr, value as CType::CDouble);

  let result: String = String::create(buffer as str);
  Memory::free(buffer);
  return result;
}

/// The shortest `%e` text (across `snprintf("%.Ne", value)` for `N` from 0
/// up) that round-trips back to `value` bit-for-bit through `atof`. Falls
/// back to 16 fraction digits (17 significant digits, always enough for any
/// finite `f64`) if nothing shorter round-trips.
function shortestScientificText(value: f64): String {
  let mut precision: u64 = 0;

  while (precision <= 16) {
    let candidate: String = formatScientific(value, precision);
    let candidateStr: str = candidate.toStr();
    let roundTrip: CType::CDouble = LibC::Conversion::atof(candidateStr as CType::CConstStr);

    if (roundTrip == value) {
      return candidate;
    }

    precision += 1;
  }

  return formatScientific(value, 16);
}

/// One `%e`-formatted scientific value split into Rust `Display`-shaped
/// pieces: an optional leading `-`, exactly one leading digit, the
/// (possibly empty) fraction digits after it, and the base-10 exponent of
/// that leading digit.
record ScientificParts {
  public negative: boolean;
  public leadingDigit: u8;
  public fractionDigits: String;
  public exponent: i64;
}

function parseScientificText(raw: &String): ScientificParts {
  let mut index: u64 = 0;
  let mut negative: boolean = false;

  if (let Option::SOME(first) = raw.byteAt(0) && first == '-' as u8) {
    negative = true;
    index = 1;
  }

  let Option::SOME(leadingDigit) = raw.byteAt(index) else {
    return ScientificParts {
      negative: negative,
      leadingDigit: '0' as u8,
      fractionDigits: String::new(),
      exponent: 0,
    };
  };

  index += 1;

  let mut fractionDigits: String = String::new();

  if (let Option::SOME(dot) = raw.byteAt(index) && dot == '.' as u8) {
    index += 1;

    while (let Option::SOME(digit) = raw.byteAt(index) && digit != 'e' as u8) {
      fractionDigits.pushByte(digit);
      index += 1;
    }
  }

  // `index` now sits on `e`.
  index += 1;

  let mut exponentNegative: boolean = false;

  if (let Option::SOME(sign) = raw.byteAt(index)) {
    if (sign == '-' as u8) {
      exponentNegative = true;
      index += 1;
    } else if (sign == '+' as u8) {
      index += 1;
    }
  }

  let mut exponentValue: i64 = 0;

  while (let Option::SOME(digit) = raw.byteAt(index) && digit >= '0' as u8 && digit <= '9' as u8) {
    exponentValue = exponentValue * 10 + (digit - ('0' as u8)) as i64;
    index += 1;
  }

  if (exponentNegative) {
    exponentValue = -exponentValue;
  }

  return ScientificParts {
    negative: negative,
    leadingDigit: leadingDigit,
    fractionDigits: fractionDigits,
    exponent: exponentValue,
  };
}

/// Rust's `Display for f64` layout, built from the shortest round-tripping
/// `%e` text: fixed notation (always with a decimal point, e.g. `100.0`)
/// for a base-10 exponent from -5 to 15 inclusive, scientific notation
/// (`D.DDDe±EE`, `+`/`-` always shown, no leading zeros) outside that range.
/// The exact threshold and every rule here (the fixed range, the exponent
/// sign always being present, the lack of leading zeros) were all verified
/// directly against the host across 20+ values, including subnormals,
/// magnitudes past 1e300, and negative zero.
function rustFloatDisplay(value: f64): String {
  let raw: String = shortestScientificText(value);
  let parts: ScientificParts = parseScientificText(&raw);

  let mut result: String = String::new();

  if (parts.negative) {
    result.pushChar('-');
  }

  let useScientific: boolean = parts.exponent < -5 || parts.exponent > 15;

  if (useScientific) {
    result.pushByte(parts.leadingDigit);

    if (parts.fractionDigits.length() > 0) {
      result.pushChar('.');
      result.push(&parts.fractionDigits);
    }

    result.pushChar('e');
    result.pushChar(parts.exponent < 0 ? '-' : '+');

    let exponentMagnitude: i64 = parts.exponent < 0 ? -parts.exponent : parts.exponent;
    let exponentMagnitudeAsU64: u64 = exponentMagnitude as u64;
    let exponentText: String = exponentMagnitudeAsU64.toString();
    result.push(&exponentText);

    return result;
  }

  if (parts.exponent >= 0) {
    result.pushByte(parts.leadingDigit);

    let exponentAsIndex: u64 = parts.exponent as u64;
    let mut digitIndex: u64 = 0;

    while (digitIndex < exponentAsIndex) {
      let Option::SOME(digit) = parts.fractionDigits.byteAt(digitIndex) else {
        result.pushChar('0');
        digitIndex += 1;
        continue;
      };

      result.pushByte(digit);
      digitIndex += 1;
    }

    result.pushChar('.');

    if (digitIndex < parts.fractionDigits.length()) {
      let remaining: String = parts.fractionDigits.substringBytes(digitIndex, parts.fractionDigits.length());
      result.push(&remaining);
    } else {
      result.pushChar('0');
    }

    return result;
  }

  // `parts.exponent` is negative here (and >= -5, since `useScientific`
  // already handled anything past that): the value is `0.` followed by
  // `-exponent - 1` zeros, the leading digit, then the fraction digits.
  result.pushStr("0.");

  let leadingZeroCount: u64 = (-parts.exponent - 1) as u64;
  let mut zeroIndex: u64 = 0;

  while (zeroIndex < leadingZeroCount) {
    result.pushChar('0');
    zeroIndex += 1;
  }

  result.pushByte(parts.leadingDigit);
  result.push(&parts.fractionDigits);

  return result;
}

export namespace Format {
  /// What a single formatting run was asked to do. `check` keeps the file on
  /// disk untouched, which is what both `--check` and `--emit diff` need.
  record FormatOptions {
    public check: boolean;
    public config: FormatterConfig;

    public static withConfig(config: &FormatterConfig): Format::FormatOptions {
      return Format::FormatOptions {
        check: false,
        config: FormatterConfig {
          indentWidth: config.indentWidth,
          lineWidth: config.lineWidth,
          useTabs: config.useTabs,
          sortImports: config.sortImports,
        },
      };
    }
  }

  record FormatOutcome {
    public changed: boolean;
    public formatted: String;
  }

  /// Formats `source` and refuses the result unless it is safe: same tokens,
  /// same comment ownership, same directives, and stable under a second pass.
  function formatSource(source: &String, config: &FormatterConfig): Result<String, FormatError> {
    let formatted: String = Format::formatSourceUnchecked(source, config)!;

    Format::validateFormattedOutput(source, &formatted, config.sortImports)!;

    let reformatted: String = Format::formatSourceUnchecked(&formatted, config)!;

    if (!reformatted.equals(&formatted)) {
      return Result::ERROR(FormatError::safety("formatted output is not idempotent on a second formatter pass"));
    }

    return Result::OK(formatted);
  }

  /// The layout pipeline on its own: model, layout, print. Skips the safety
  /// checks, which is what the idempotence check itself needs.
  function formatSourceUnchecked(
    source: &String,
    config: &FormatterConfig
  ): Result<String, FormatError> {
    let file: Format::FormatFile = Format::FormatFile::fromSource(source)!;
    let laidOut: Format::FormatFile = Format::layoutFile(&file, config)!;
    return Format::printFile(&laidOut, config);
  }

  /// True when formatting would rewrite `source`, which is the `--check`
  /// verdict for one file.
  function sourceNeedsFormatting(
    source: &String,
    config: &FormatterConfig
  ): Result<boolean, FormatError> {
    let formatted: String = Format::formatSource(source, config)!;
    return Result::OK(!formatted.equals(source));
  }

  /// Formats the file at `path`, rewriting it unless the run is read-only.
  /// Rust's `std::io::Error` `Display`: the `strerror` text, then the raw
  /// errno in parentheses. Matches the host's `format_file`, which reports
  /// `error.to_string()` directly rather than a fixed message.
  function ioErrorDisplay(error: &Io::IoError): String {
    let mut message: String = String::create(error.errorMessage());
    let rawCode: i32 = error.rawCode();
    let rawCodeText: String = rawCode.toString();
    message.pushStr(" (os error ");
    message.push(&rawCodeText);
    message.pushStr(")");
    return message;
  }

  function formatFile(
    path: &Path::PathBuf,
    options: &Format::FormatOptions
  ): Result<Format::FormatOutcome, FormatError> {
    let source: String = match (Fs::readToString(path)) {
      Result::OK(value) -> value,
      Result::ERROR(readError) -> {
        let message: String = Format::ioErrorDisplay(&readError);
        return Result::ERROR(FormatError::io(message.toStr()));
      },
    };

    let formatted: String = Format::formatSource(&source, &options.config)!;
    let changed: boolean = !formatted.equals(&source);

    if (changed && !options.check) {
      match (Fs::writeString(path, &formatted)) {
        Result::OK(_) -> {},
        Result::ERROR(writeError) -> {
          let message: String = Format::ioErrorDisplay(&writeError);
          return Result::ERROR(FormatError::io(message.toStr()));
        },
      };
    }

    return Result::OK(Format::FormatOutcome { changed: changed, formatted: formatted });
  }

  /// Renders a unified diff between two texts, with three lines of context
  /// around each run of changed lines. Line-aligned rather than
  /// longest-common-subsequence based, matching the host CLI.
  function unifiedDiff(path: &String, oldText: &String, newText: &String): String {
    let oldLines: Vector<String> = apiLines(oldText);
    let newLines: Vector<String> = apiLines(newText);

    let mut output: String = String::create("--- ");
    output.push(path);
    output.pushStr("\n+++ ");
    output.push(path);
    output.pushChar('\n');

    let maxLines: u64 = maxU64(oldLines.length(), newLines.length());

    let mut changeStarts: Vector<u64> = Vector::new<u64>();
    let mut changeEnds: Vector<u64> = Vector::new<u64>();

    let mut inChange: boolean = false;
    let mut changeStart: u64 = 0;
    let mut index: u64 = 0;

    while (index < maxLines) {
      let mut linesAreEqual: boolean = false;

      if (index < oldLines.length() && index < newLines.length()) {
        if (let Option::SOME(oldLine) = oldLines.get(index)) {
          if (let Option::SOME(newLine) = newLines.get(index)) {
            linesAreEqual = oldLine.equals(newLine);
          }
        }
      }

      if (linesAreEqual) {
        if (inChange) {
          changeStarts.push(changeStart);
          changeEnds.push(index);
          inChange = false;
        }
      } else {
        if (!inChange) {
          changeStart = index;
          inChange = true;
        }
      }

      index += 1;
    }

    if (inChange) {
      changeStarts.push(changeStart);
      changeEnds.push(maxLines);
    }

    let mut hunkIndex: u64 = 0;

    while (hunkIndex < changeStarts.length()) {
      let Option::SOME(start) = changeStarts.get(hunkIndex) else {
        hunkIndex += 1;
        continue;
      };

      let Option::SOME(end) = changeEnds.get(hunkIndex) else {
        hunkIndex += 1;
        continue;
      };

      let contextBefore: u64 = saturatingSub(*start, 3);
      let contextAfter: u64 = minU64(*end + 3, maxLines);
      let hunkLength: u64 = contextAfter - contextBefore;

      let headerStartValue: u64 = contextBefore + 1;
      let headerStart: String = headerStartValue.toString();
      let headerLength: String = hunkLength.toString();

      output.pushStr("@@ -");
      output.push(&headerStart);
      output.pushStr(",");
      output.push(&headerLength);
      output.pushStr(" +");
      output.push(&headerStart);
      output.pushStr(",");
      output.push(&headerLength);
      output.pushStr(" @@\n");

      let mut lineIndex: u64 = contextBefore;

      while (lineIndex < contextAfter) {
        let oldLine: Option<&String> = oldLines.get(lineIndex);
        let newLine: Option<&String> = newLines.get(lineIndex);

        if (lineIndex >= *start && lineIndex < *end) {
          if (let Option::SOME(line) = oldLine) {
            output.pushStr("-");
            output.push(line);
            output.pushChar('\n');
          }

          if (let Option::SOME(line) = newLine) {
            output.pushStr("+");
            output.push(line);
            output.pushChar('\n');
          }
        } else {
          if (let Option::SOME(line) = oldLine) {
            output.pushStr(" ");
            output.push(line);
            output.pushChar('\n');
          } else if (let Option::SOME(line) = newLine) {
            output.pushStr(" ");
            output.push(line);
            output.pushChar('\n');
          }
        }

        lineIndex += 1;
      }

      hunkIndex += 1;
    }

    return output;
  }

  /// One `{"path": ..., "text": ...}` record of the `--stdin-json` protocol.
  record StdinRequest {
    public path: String;
    public text: String;
  }

  /// One response line of the `--stdin-json` protocol. `formatted` is omitted
  /// in diff mode, `diff` outside it, and `error` whenever the run succeeded.
  record StdinResponse {
    public path: String;
    public hasFormatted: boolean;
    public formatted: String;
    public changed: boolean;
    public hasDiff: boolean;
    public diff: String;
    public hasError: boolean;
    public error: String;
  }

  /// Wraps a bare message with the prefix every NDJSON parse failure carries.
  function ndjsonParseError(message: &String): String {
    let mut result: String = String::create("failed to parse NDJSON record: ");
    result.push(message);
    return result;
  }

  /// Same as `ndjsonParseError`, taking its message by value: every call
  /// site below builds the message as a temporary (a fresh `String` or the
  /// direct result of a `jsonXxxMessage` call), which cannot be borrowed.
  function ndjsonParseErrorOwned(message: String): String {
    return Format::ndjsonParseError(&message);
  }

  function ndjsonInvalidType(kindDescription: &String, column: u64): String {
    let columnText: String = column.toString();

    let mut message: String = String::create("invalid type: ");
    message.push(kindDescription);
    message.pushStr(", expected struct StdinRecord at line 1 column ");
    message.push(&columnText);
    return Format::ndjsonParseError(&message);
  }

  function ndjsonInvalidFieldType(kindDescription: &String, column: u64): String {
    let columnText: String = column.toString();

    let mut message: String = String::create("invalid type: ");
    message.push(kindDescription);
    message.pushStr(", expected a string at line 1 column ");
    message.push(&columnText);
    return Format::ndjsonParseError(&message);
  }

  function ndjsonInvalidLength(itemCount: u64, column: u64): String {
    let countText: String = itemCount.toString();
    let columnText: String = column.toString();

    let mut message: String = String::create("invalid length ");
    message.push(&countText);
    message.pushStr(", expected struct StdinRecord with 2 elements at line 1 column ");
    message.push(&columnText);
    return Format::ndjsonParseError(&message);
  }

  /// `serde` reports the first missing field in the struct's declared order,
  /// which is `path` then `text`, at the position where the whole object
  /// finished parsing.
  function ndjsonMissingField(name: str, column: u64): String {
    let columnText: String = column.toString();

    let mut message: String = String::create("missing field `");
    message.pushStr(name);
    message.pushStr("` at line 1 column ");
    message.push(&columnText);
    return Format::ndjsonParseError(&message);
  }

  /// `serde` detects a repeated field the moment the second occurrence's key
  /// finishes parsing, before it even looks at that occurrence's value: a
  /// second `"path"` with a valid string value reports the same column as one
  /// with an invalid one.
  function ndjsonDuplicateField(name: str, column: u64): String {
    let columnText: String = column.toString();

    let mut message: String = String::create("duplicate field `");
    message.pushStr(name);
    message.pushStr("` at line 1 column ");
    message.push(&columnText);
    return Format::ndjsonParseError(&message);
  }

  function ndjsonTrailingCharacters(column: u64): String {
    let columnText: String = column.toString();

    let mut message: String = String::create("trailing characters at line 1 column ");
    message.push(&columnText);
    return Format::ndjsonParseError(&message);
  }

  function describeBool(value: boolean): String {
    if (value) {
      return String::create("boolean `true`");
    }

    return String::create("boolean `false`");
  }

  /// `text` is at most 20 ASCII digits (`u64::MAX` is 20 digits), so a plain
  /// length-then-lexical comparison against `limit`'s digits is exact: JSON
  /// integers never carry a leading zero (the number grammar in
  /// `std::json::scanNumber` already rejects one), so two digit strings of
  /// the same length compare the same way their numeric values do.
  function digitsFitLimit(digits: &String, limit: str): boolean {
    let limitText: String = String::create(limit);

    if (digits.length() < limitText.length()) {
      return true;
    }

    if (digits.length() > limitText.length()) {
      return false;
    }

    return digits.compare(&limitText) <= 0;
  }

  /// `serde_json` classifies a JSON number the way its own value model does:
  /// an integer that fits `u64` or `i64` keeps that classification and its
  /// exact source text; anything else (a fraction, an exponent, an integer
  /// too big for either 64-bit type, or the literal `-0`, which `serde_json`
  /// always treats as `-0.0` to keep the sign bit no 64-bit integer type can
  /// represent) is `f64`, described with Rust's `{}` `Display` for `f64`
  /// (reproduced here by `rustFloatDisplay`, built on `snprintf`'s
  /// shortest-round-tripping `%e` output rather than `f64::toString()`'s
  /// fixed-precision `%g`).
  function describeNumber(text: &String): String {
    if (text.equals("-0")) {
      return String::create("floating point `-0.0`");
    }

    let mut hasFraction: boolean = false;
    let mut index: u64 = 0;

    while (index < text.length()) {
      let Option::SOME(byte) = text.byteAt(index) else {
        break;
      };

      if (byte == '.' as u8 || byte == 'e' as u8 || byte == 'E' as u8) {
        hasFraction = true;
        break;
      }

      index += 1;
    }

    let mut isInteger: boolean = false;

    if (!hasFraction) {
      let Option::SOME(firstByte) = text.byteAt(0) else {
        return String::create("integer `0`");
      };

      if (firstByte == '-' as u8) {
        let digits: String = text.substringBytes(1, text.length());
        isInteger = Format::digitsFitLimit(&digits, "9223372036854775808");
      } else {
        isInteger = Format::digitsFitLimit(text, "18446744073709551615");
      }
    }

    if (isInteger) {
      let mut message: String = String::create("integer `");
      message.push(text);
      message.pushStr("`");
      return message;
    }

    let rawText: str = text.toStr();
    let parsed: CType::CDouble = LibC::Conversion::atof(rawText as CType::CConstStr);
    let valueText: String = rustFloatDisplay(parsed);

    let mut message: String = String::create("floating point `");
    message.push(&valueText);
    message.pushStr("`");
    return message;
  }

  /// Rust's `{:?}` (`Debug`) escaping for `str`, which is what `serde`'s
  /// `Unexpected::Str` uses: `"` and `\` are backslash-escaped, `\n`/`\r`/`\t`
  /// keep their short escapes, and every other control byte (including `\b`,
  /// `\f`, and DEL) becomes `\u{<hex>}` with no leading zeros — unlike this
  /// module's own `escapeJsonString`, which is JSON escaping (`\b`, `\f`,
  /// `\u00XX`) for the `--stdin-json` protocol's own output, not a
  /// description of a value.
  function describeString(text: &String): String {
    let mut quoted: String = String::new();
    quoted.pushChar('"');

    let mut index: u64 = 0;

    while (index < text.length()) {
      let mut endByte: u64 = index;
      let Option::SOME(character) = text.charAt(index, &mut endByte) else {
        break;
      };

      let codepoint: u32 = character as u32;

      if (character == '"') {
        quoted.pushStr("\\\"");
      } else if (character == '\\') {
        quoted.pushStr("\\\\");
      } else if (character == '\n') {
        quoted.pushStr("\\n");
      } else if (character == '\r') {
        quoted.pushStr("\\r");
      } else if (character == '\t') {
        quoted.pushStr("\\t");
      } else if (codepoint == 0) {
        quoted.pushStr("\\0");
      } else if (codepoint < 32 || codepoint == 127 || Format::isNonPrintableAboveAscii(codepoint)) {
        let hexDigits: String = Format::hexNoLeadingZeros(codepoint);
        quoted.pushStr("\\u{");
        quoted.push(&hexDigits);
        quoted.pushStr("}");
      } else {
        quoted.pushChar(character);
      }

      index = endByte;
    }

    quoted.pushChar('"');

    let mut message: String = String::create("string ");
    message.push(&quoted);
    return message;
  }

  function hexNoLeadingZeros(value: u32): String {
    if (value == 0) {
      return String::create("0");
    }

    let mut digits: Vector<u8> = Vector::new<u8>();
    let mut remaining: u32 = value;

    while (remaining > 0) {
      let digit: u8 = (remaining % 16) as u8;
      digits.push(Format::hexDigitByte(digit));
      remaining = remaining / 16;
    }

    let mut result: String = String::new();
    let mut index: i64 = digits.length() as i64 - 1;

    while (index >= 0) {
      let Option::SOME(digitByte) = digits.get(index as u64) else {
        break;
      };

      result.pushByte(*digitByte);
      index -= 1;
    }

    return result;
  }

  /// A narrow approximation of Rust's `char::escape_debug` "is this scalar
  /// printable" rule for non-ASCII scalars: it does not implement the full
  /// Unicode `Grapheme_Extend`/`Cc`/`Cf`/`Cs`/`Co`/`Cn` classification Rust
  /// uses, only the specific ranges verified against the host (C1 controls,
  /// the general combining-diacritical block, and the soft hyphen). A
  /// non-printable scalar outside these ranges is not escaped here even
  /// though Rust's `{:?}` would escape it.
  function isNonPrintableAboveAscii(codepoint: u32): boolean {
    if (codepoint >= 0x80 && codepoint <= 0x9F) {
      return true;
    }

    if (codepoint == 0xAD) {
      return true;
    }

    if (codepoint >= 0x300 && codepoint <= 0x36F) {
      return true;
    }

    return false;
  }

  /// A JSON scalar (string, number, `true`/`false`/`null`) fully consumed at
  /// `valueStart`, together with its `serde`-`Unexpected`-shaped description.
  /// A container (`{`/`[`) never reaches this: a caller checks for one with
  /// `Json::classifyContainerStart` first, since `serde` classifies a
  /// container by peeking its opening bracket without consuming it (a
  /// different column convention than every scalar here, which is fully read
  /// before it is described).
  record ShallowScalarRead {
    public isString: boolean;
    public value: String;
    public description: String;
    public endOffset: u64;
  }

  function readShallowScalar(
    line: &String,
    valueStart: u64
  ): Result<Format::ShallowScalarRead, String> {
    let Option::SOME(byte) = line.byteAt(valueStart) else {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "a value")));
    };

    if (byte == '"' as u8) {
      let read: JsonStringRead = match (readString(line, valueStart)) {
        Result::OK(value) -> value,
        Result::ERROR(message) -> {
          return Result::ERROR(Format::ndjsonParseError(&message));
        },
      };

      let description: String = Format::describeString(&read.value);

      // `.clone()`, not a move: `read` is a bound local that still drops
      // normally at scope exit, so moving `value` out of it double-frees the
      // string's backing storage on this compiler (repro
      // "field-move-double-free").
      return Result::OK(Format::ShallowScalarRead {
        isString: true,
        value: read.value.clone(),
        description: description,
        endOffset: read.nextIndex,
      });
    }

    if (byte == 't' as u8) {
      let endOffset: u64 = match (matchKeywordOrIdentError(line, valueStart, "true")) {
        Result::OK(value) -> value,
        Result::ERROR(message) -> {
          return Result::ERROR(Format::ndjsonParseError(&message));
        },
      };

      return Result::OK(Format::ShallowScalarRead {
        isString: false,
        value: String::new(),
        description: Format::describeBool(true),
        endOffset: endOffset,
      });
    }

    if (byte == 'f' as u8) {
      let endOffset: u64 = match (matchKeywordOrIdentError(line, valueStart, "false")) {
        Result::OK(value) -> value,
        Result::ERROR(message) -> {
          return Result::ERROR(Format::ndjsonParseError(&message));
        },
      };

      return Result::OK(Format::ShallowScalarRead {
        isString: false,
        value: String::new(),
        description: Format::describeBool(false),
        endOffset: endOffset,
      });
    }

    if (byte == 'n' as u8) {
      let endOffset: u64 = match (matchKeywordOrIdentError(line, valueStart, "null")) {
        Result::OK(value) -> value,
        Result::ERROR(message) -> {
          return Result::ERROR(Format::ndjsonParseError(&message));
        },
      };

      return Result::OK(Format::ShallowScalarRead {
        isString: false,
        value: String::new(),
        description: String::create("null"),
        endOffset: endOffset,
      });
    }

    let isNumberStart: boolean = byte == '-' as u8 || (byte >= '0' as u8 && byte <= '9' as u8);

    if (isNumberStart) {
      let numberRead: JsonNumberRead = match (scanNumber(line, valueStart)) {
        Result::OK(value) -> value,
        Result::ERROR(message) -> {
          return Result::ERROR(Format::ndjsonParseError(&message));
        },
      };

      return Result::OK(Format::ShallowScalarRead {
        isString: false,
        value: String::new(),
        description: Format::describeNumber(&numberRead.text),
        endOffset: numberRead.endOffset,
      });
    }

    return Result::ERROR(Format::ndjsonParseErrorOwned(jsonExpectedValueMessage(valueStart)));
  }

  function containerKindName(kind: JsonContainerKind): String {
    return match (kind) {
      JsonContainerKind::OBJECT -> String::create("map"),
      JsonContainerKind::ARRAY -> String::create("sequence"),
    };
  }

  record FieldValueRead {
    public value: String;
    public endOffset: u64;
  }

  /// Reads one `path`/`text` value: a `serde`-derived struct's field
  /// deserializer inspects a field's value shallowly, so a container is
  /// rejected the moment its opening bracket is seen, never building the
  /// tree inside it (this is what keeps a `path` set to 50000 nested arrays
  /// from recursing at all, let alone overflowing the stack, and what makes
  /// `{"path":[1,2],...}` fail with `invalid type: sequence`, not `invalid
  /// length`, at any depth).
  function readObjectFieldValue(
    line: &String,
    valueStart: u64
  ): Result<Format::FieldValueRead, String> {
    if (let Option::SOME(container) = classifyContainerStart(line, valueStart)) {
      let kindName: String = Format::containerKindName(container);
      return Result::ERROR(Format::ndjsonInvalidFieldType(&kindName, valueStart));
    }

    let scalar: Format::ShallowScalarRead = Format::readShallowScalar(line, valueStart)!;

    if (scalar.isString) {
      return Result::OK(Format::FieldValueRead { value: scalar.value, endOffset: scalar.endOffset });
    }

    return Result::ERROR(Format::ndjsonInvalidFieldType(&scalar.description, scalar.endOffset));
  }

  function skipAsciiWhitespaceFrom(line: &String, start: u64): u64 {
    let mut cursor: u64 = start;

    while (cursor < line.length()) {
      let Option::SOME(byte) = line.byteAt(cursor) else {
        break;
      };

      if (byte != ' ' as u8 && byte != '\t' as u8 && byte != '\n' as u8 && byte != '\r' as u8) {
        break;
      }

      cursor += 1;
    }

    return cursor;
  }

  /// Maps a parsed top-level JSON object onto the two fields the protocol
  /// defines, matching a `serde`-derived struct's field visitor: fields are
  /// read in JSON order, a repeated key is a `duplicate field` error the
  /// moment its own string finishes parsing (before its value is even looked
  /// at), a wrong-typed occurrence errors immediately, and an unknown key
  /// (including one nested inside another object, like
  /// `"meta":{"path":"evil.ign"}`) is skipped without being parsed into a
  /// tree — the same way an unknown field is ignored for a struct without
  /// `deny_unknown_fields`, and with the same no-recursion-limit iterative
  /// skip `serde_json`'s `IgnoredAny` uses (`Json::skipValue`), confirmed
  /// against the host up to 200000 levels of nesting in an ignored field.
  function stdinRequestFromObjectScan(
    line: &String,
    openBraceIndex: u64
  ): Result<Format::StdinRequest, String> {
    let mut cursor: u64 = Format::skipAsciiWhitespaceFrom(line, openBraceIndex + 1);
    let mut path: Option<String> = Option::NONE;
    let mut text: Option<String> = Option::NONE;

    let Option::SOME(firstByte) = line.byteAt(cursor) else {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "an object")));
    };

    if (firstByte != '}' as u8) {
      while (true) {
        cursor = Format::skipAsciiWhitespaceFrom(line, cursor);

        let Option::SOME(keyByte) = line.byteAt(cursor) else {
          return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "an object")));
        };

        if (keyByte != '"' as u8) {
          return Result::ERROR(Format::ndjsonParseErrorOwned(jsonKeyMustBeStringMessage(cursor)));
        }

        let key: JsonStringRead = match (readString(line, cursor)) {
          Result::OK(value) -> value,
          Result::ERROR(message) -> {
            return Result::ERROR(Format::ndjsonParseError(&message));
          },
        };

        // `.clone()` for the same reason `readShallowScalar` clones its own
        // string read: `key` is a bound local (repro
        // "field-move-double-free").
        let keyText: String = key.value.clone();
        let keyEndOffset: u64 = key.nextIndex;
        cursor = Format::skipAsciiWhitespaceFrom(line, keyEndOffset);

        let Option::SOME(colon) = line.byteAt(cursor) else {
          return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "an object")));
        };

        if (colon != ':' as u8) {
          return Result::ERROR(Format::ndjsonParseErrorOwned(jsonExpectedColonMessage(cursor)));
        }

        cursor = Format::skipAsciiWhitespaceFrom(line, cursor + 1);

        let isPathKey: boolean = keyText.equals("path");
        let isTextKey: boolean = keyText.equals("text");

        if (isPathKey || isTextKey) {
          let alreadySeen: boolean = isPathKey ? path.isSome() : text.isSome();

          if (alreadySeen) {
            let fieldName: str = isPathKey ? "path" : "text";
            return Result::ERROR(Format::ndjsonDuplicateField(fieldName, keyEndOffset));
          }

          let fieldRead: Format::FieldValueRead = Format::readObjectFieldValue(line, cursor)!;

          if (isPathKey) {
            path = Option::SOME(fieldRead.value);
          } else {
            text = Option::SOME(fieldRead.value);
          }

          cursor = fieldRead.endOffset;
        } else {
          cursor = match (skipValue(line, cursor)) {
            Result::OK(value) -> value,
            Result::ERROR(message) -> {
              return Result::ERROR(Format::ndjsonParseError(&message));
            },
          };
        }

        cursor = Format::skipAsciiWhitespaceFrom(line, cursor);

        let Option::SOME(next) = line.byteAt(cursor) else {
          return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "an object")));
        };

        if (next == ',' as u8) {
          cursor = Format::skipAsciiWhitespaceFrom(line, cursor + 1);

          // Past the comma, `serde` reads the next key through the same
          // generic value dispatch a colon's value uses (there is no
          // dedicated "read a map key" token check), so running off the end
          // of the source here is `EOF while parsing a value`, not `an
          // object`, unlike every other EOF check in this scan.
          let Option::SOME(afterComma) = line.byteAt(cursor) else {
            return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "a value")));
          };

          if (afterComma == '}' as u8) {
            return Result::ERROR(Format::ndjsonParseErrorOwned(jsonTrailingCommaMessage(cursor)));
          }

          continue;
        }

        if (next == '}' as u8) {
          cursor += 1;
          break;
        }

        return Result::ERROR(Format::ndjsonParseErrorOwned(jsonExpectedCommaOrBraceMessage(cursor)));
      }
    } else {
      cursor += 1;
    }

    let Option::SOME(pathValue) = path else {
      return Result::ERROR(Format::ndjsonMissingField("path", cursor));
    };

    let Option::SOME(textValue) = text else {
      return Result::ERROR(Format::ndjsonMissingField("text", cursor));
    };

    let afterObject: u64 = Format::skipAsciiWhitespaceFrom(line, cursor);
    let lineLength: u64 = line.length();

    if (afterObject != lineLength) {
      return Result::ERROR(Format::ndjsonTrailingCharacters(afterObject + 1));
    }

    return Result::OK(Format::StdinRequest { path: pathValue, text: textValue });
  }

  /// Maps a parsed top-level JSON array onto the two fields the protocol
  /// defines. A derived `serde` struct accepts a sequence positionally (index
  /// 0 is the first declared field, `path`; index 1 is `text`) as well as a
  /// map, so a 2-element array is not an `invalid length` error the way any
  /// other length is: confirmed against the host with `["a","b"]`, which
  /// succeeds with `path: "a"`, `text: "b"`. Element type mismatches are
  /// inferred to use the same `expected a string` wording object fields do;
  /// this has not been checked against the host for an array element
  /// specifically.
  function stdinRequestFromArrayScan(
    line: &String,
    openBracketIndex: u64
  ): Result<Format::StdinRequest, String> {
    let mut cursor: u64 = Format::skipAsciiWhitespaceFrom(line, openBracketIndex + 1);

    let Option::SOME(firstByte) = line.byteAt(cursor) else {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "a list")));
    };

    if (firstByte == ']' as u8) {
      return Result::ERROR(Format::ndjsonInvalidLength(0, cursor + 1));
    }

    let firstElement: Format::FieldValueRead = Format::readObjectFieldValue(line, cursor)!;
    cursor = Format::skipAsciiWhitespaceFrom(line, firstElement.endOffset);

    let Option::SOME(afterFirst) = line.byteAt(cursor) else {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "a list")));
    };

    if (afterFirst == ']' as u8) {
      return Result::ERROR(Format::ndjsonInvalidLength(1, cursor + 1));
    }

    if (afterFirst != ',' as u8) {
      return Result::ERROR(Format::ndjsonParseErrorOwned(Format::ndjsonExpectedCommaOrBracketAt(cursor)));
    }

    cursor = Format::skipAsciiWhitespaceFrom(line, cursor + 1);

    let Option::SOME(afterFirstComma) = line.byteAt(cursor) else {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "a list")));
    };

    if (afterFirstComma == ']' as u8) {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonTrailingCommaMessage(cursor)));
    }

    let secondElement: Format::FieldValueRead = Format::readObjectFieldValue(line, cursor)!;
    cursor = Format::skipAsciiWhitespaceFrom(line, secondElement.endOffset);

    let Option::SOME(afterSecond) = line.byteAt(cursor) else {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "a list")));
    };

    if (afterSecond == ']' as u8) {
      let afterArray: u64 = Format::skipAsciiWhitespaceFrom(line, cursor + 1);
      let lineLength: u64 = line.length();

      if (afterArray != lineLength) {
        return Result::ERROR(Format::ndjsonTrailingCharacters(afterArray + 1));
      }

      return Result::OK(Format::StdinRequest { path: firstElement.value, text: secondElement.value });
    }

    // The struct backing a positional record only ever reads 2 elements: a
    // 3rd is never requested, so `serde`'s `SeqAccess` never validates
    // anything past the 2nd element, including whether a comma introduces
    // it. Once the top-level value is "done" (2 elements read), any
    // non-whitespace byte here other than `]` is unconsumed input, reported
    // by the same generic "trailing characters" check regardless of what it
    // is, except for one special case: a comma immediately followed (after
    // whitespace) by `]`, which is `serde`'s own "trailing comma" wording.
    if (afterSecond != ',' as u8) {
      return Result::ERROR(Format::ndjsonTrailingCharacters(cursor + 1));
    }

    // Running off the end of the source with nothing but whitespace after
    // the comma reports at the comma's own position instead of wherever the
    // whitespace skip lands.
    let commaIndex: u64 = cursor;
    let afterCommaSkip: u64 = Format::skipAsciiWhitespaceFrom(line, cursor + 1);

    let Option::SOME(afterComma) = line.byteAt(afterCommaSkip) else {
      return Result::ERROR(Format::ndjsonTrailingCharacters(commaIndex + 1));
    };

    if (afterComma == ']' as u8) {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonTrailingCommaMessage(afterCommaSkip)));
    }

    return Result::ERROR(Format::ndjsonTrailingCharacters(afterCommaSkip + 1));
  }

  function ndjsonExpectedCommaOrBracketAt(index: u64): String {
    let columnValue: u64 = index + 1;
    let column: String = columnValue.toString();

    let mut message: String = String::create("expected `,` or `]` at line 1 column ");
    message.push(&column);
    return message;
  }

  /// Reads one NDJSON request line, matching `serde_json::from_str::<StdinRecord>`'s
  /// exact wording and, just as importantly, its exact *ordering*: a field's
  /// value is inspected shallowly rather than parsed into a tree first (see
  /// `readObjectFieldValue`'s doc comment), so this never builds a
  /// `std::json` `JsonValue` tree for its own top-level scan, unlike this
  /// module's other JSON handling.
  function parseStdinRequest(line: &String): Result<Format::StdinRequest, String> {
    let Option::SOME(firstByte) = line.byteAt(0) else {
      return Result::ERROR(Format::ndjsonParseErrorOwned(jsonEofMessage(line, "a value")));
    };

    if (firstByte == '{' as u8) {
      return Format::stdinRequestFromObjectScan(line, 0);
    }

    if (firstByte == '[' as u8) {
      return Format::stdinRequestFromArrayScan(line, 0);
    }

    let scalar: Format::ShallowScalarRead = Format::readShallowScalar(line, 0)!;
    return Result::ERROR(Format::ndjsonInvalidType(&scalar.description, scalar.endOffset));
  }

  function escapeJsonString(value: &String, output: &mut String): void {
    let mut outputRef: &mut String = output;
    outputRef.pushChar('"');

    let mut index: u64 = 0;

    while (index < value.length()) {
      let Option::SOME(byte) = value.byteAt(index) else {
        break;
      };

      if (byte == '"' as u8) {
        outputRef.pushStr("\\\"");
      } else if (byte == '\\' as u8) {
        outputRef.pushStr("\\\\");
      } else if (byte == '\n' as u8) {
        outputRef.pushStr("\\n");
      } else if (byte == '\r' as u8) {
        outputRef.pushStr("\\r");
      } else if (byte == '\t' as u8) {
        outputRef.pushStr("\\t");
      } else if (byte == 8) {
        outputRef.pushStr("\\b");
      } else if (byte == 12) {
        outputRef.pushStr("\\f");
      } else if (byte < 32) {
        outputRef.pushStr("\\u00");
        outputRef.pushByte(Format::hexDigitByte(byte / 16));
        outputRef.pushByte(Format::hexDigitByte(byte % 16));
      } else {
        outputRef.pushByte(byte);
      }

      index += 1;
    }

    outputRef.pushChar('"');
  }

  function hexDigitByte(value: u8): u8 {
    if (value < 10) {
      return ('0' as u8) + value;
    }

    return ('a' as u8) + (value - 10);
  }

  /// Serializes one NDJSON response line, omitting the fields the host omits
  /// when they carry no value.
  function renderStdinResponse(response: &Format::StdinResponse): String {
    let mut output: String = String::create("{");

    output.pushStr("\"path\":");
    Format::escapeJsonString(&response.path, &mut output);

    if (response.hasFormatted) {
      output.pushStr(",\"formatted\":");
      Format::escapeJsonString(&response.formatted, &mut output);
    }

    output.pushStr(",\"changed\":");

    if (response.changed) {
      output.pushStr("true");
    } else {
      output.pushStr("false");
    }

    if (response.hasDiff) {
      output.pushStr(",\"diff\":");
      Format::escapeJsonString(&response.diff, &mut output);
    }

    if (response.hasError) {
      output.pushStr(",\"error\":");
      Format::escapeJsonString(&response.error, &mut output);
    }

    output.pushStr("}");
    return output;
  }

  /// Formats one NDJSON request into the response the protocol expects. In
  /// diff mode the formatted text is replaced by a unified diff.
  function processStdinRequest(
    request: &Format::StdinRequest,
    config: &FormatterConfig,
    emitDiff: boolean
  ): Format::StdinResponse {
    let formatted: String = match (Format::formatSource(&request.text, config)) {
      Result::OK(value) -> value,
      Result::ERROR(error) -> {
        return Format::StdinResponse {
          path: request.path.clone(),
          hasFormatted: false,
          formatted: String::new(),
          changed: false,
          hasDiff: false,
          diff: String::new(),
          hasError: true,
          error: error.describe(),
        };
      },
    };

    let changed: boolean = !formatted.equals(&request.text);

    let mut diff: String = String::new();
    let mut hasDiff: boolean = false;

    if (emitDiff && changed) {
      diff = Format::unifiedDiff(&request.path, &request.text, &formatted);
      hasDiff = true;
    }

    return Format::StdinResponse {
      path: request.path.clone(),
      hasFormatted: !emitDiff,
      formatted: formatted,
      changed: changed,
      hasDiff: hasDiff,
      diff: diff,
      hasError: false,
      error: String::new(),
    };
  }
}
