import String from "std::string";
import Vector from "std::vector";

import Ast from "@compiler::ast";
import SourceSpan from "@compiler::diagnostics";

import _ from "./layout_types";

function containsNewlineByteExpr(text: &String): boolean {
  let mut index: u64 = 0;

  while (index < text.length()) {
    let Option::SOME(byte) = text.byteAt(index) else {
      break;
    };

    if (byte == '\n' as u8) {
      return true;
    }

    index += 1;
  }

  return false;
}

function sliceExprSpan(source: &String, span: &SourceSpan): String {
  let mut start: u64 = span.start;
  let mut end: u64 = span.end;

  if (start > source.length()) {
    start = source.length();
  }

  if (end > source.length()) {
    end = source.length();
  }

  if (start > end) {
    return String::new();
  }

  return source.substringBytes(start, end);
}

/// True when the byte range `[start, end)` of `source` contains a comma.
/// Used to detect an original single-line call's trailing comma before its
/// closing paren, mirroring the host's own text-based check for the same
/// thing (it does not derive this from the AST either).
function rangeContainsComma(source: &String, start: u64, end: u64): boolean {
  let mut clampedStart: u64 = start;
  let mut clampedEnd: u64 = end;

  if (clampedStart > source.length()) {
    clampedStart = source.length();
  }

  if (clampedEnd > source.length()) {
    clampedEnd = source.length();
  }

  if (clampedStart >= clampedEnd) {
    return false;
  }

  let mut cursor: u64 = clampedStart;

  while (cursor < clampedEnd) {
    let Option::SOME(byte) = source.byteAt(cursor) else {
      break;
    };

    if (byte == ',' as u8) {
      return true;
    }

    cursor += 1;
  }

  return false;
}

export namespace Format {
  function binaryPrecedence(operator: Ast::Expression::BinaryOperator): u8 {
    if (operator == Ast::Expression::BinaryOperator::Or) {
      return 2;
    }

    if (operator == Ast::Expression::BinaryOperator::And) {
      return 3;
    }

    if (operator == Ast::Expression::BinaryOperator::Equal || operator == Ast::Expression::BinaryOperator::NotEqual) {
      return 4;
    }

    if (operator == Ast::Expression::BinaryOperator::LessThan || operator == Ast::Expression::BinaryOperator::LessThanOrEqual || operator == Ast::Expression::BinaryOperator::GreaterThan || operator == Ast::Expression::BinaryOperator::GreaterThanOrEqual) {
      return 5;
    }

    if (operator == Ast::Expression::BinaryOperator::BitOr) {
      return 6;
    }

    if (operator == Ast::Expression::BinaryOperator::BitXor) {
      return 7;
    }

    if (operator == Ast::Expression::BinaryOperator::BitAnd) {
      return 8;
    }

    if (operator == Ast::Expression::BinaryOperator::ShiftLeft || operator == Ast::Expression::BinaryOperator::ShiftRight) {
      return 9;
    }

    if (operator == Ast::Expression::BinaryOperator::Add || operator == Ast::Expression::BinaryOperator::Subtract) {
      return 10;
    }

    return 11;
  }

  function binaryOperatorText(operator: Ast::Expression::BinaryOperator): str {
    if (operator == Ast::Expression::BinaryOperator::Add) {
      return "+";
    }

    if (operator == Ast::Expression::BinaryOperator::And) {
      return "&&";
    }

    if (operator == Ast::Expression::BinaryOperator::BitAnd) {
      return "&";
    }

    if (operator == Ast::Expression::BinaryOperator::BitOr) {
      return "|";
    }

    if (operator == Ast::Expression::BinaryOperator::BitXor) {
      return "^";
    }

    if (operator == Ast::Expression::BinaryOperator::Divide) {
      return "/";
    }

    if (operator == Ast::Expression::BinaryOperator::Equal) {
      return "==";
    }

    if (operator == Ast::Expression::BinaryOperator::GreaterThan) {
      return ">";
    }

    if (operator == Ast::Expression::BinaryOperator::GreaterThanOrEqual) {
      return ">=";
    }

    if (operator == Ast::Expression::BinaryOperator::LessThan) {
      return "<";
    }

    if (operator == Ast::Expression::BinaryOperator::LessThanOrEqual) {
      return "<=";
    }

    if (operator == Ast::Expression::BinaryOperator::Modulo) {
      return "%";
    }

    if (operator == Ast::Expression::BinaryOperator::Multiply) {
      return "*";
    }

    if (operator == Ast::Expression::BinaryOperator::NotEqual) {
      return "!=";
    }

    if (operator == Ast::Expression::BinaryOperator::Or) {
      return "||";
    }

    if (operator == Ast::Expression::BinaryOperator::ShiftLeft) {
      return "<<";
    }

    if (operator == Ast::Expression::BinaryOperator::ShiftRight) {
      return ">>";
    }

    return "-";
  }

  function assignmentOperatorText(operator: Ast::Expression::AssignmentOperator): str {
    if (operator == Ast::Expression::AssignmentOperator::Assign) {
      return "=";
    }

    if (operator == Ast::Expression::AssignmentOperator::AddAssign) {
      return "+=";
    }

    if (operator == Ast::Expression::AssignmentOperator::SubtractAssign) {
      return "-=";
    }

    if (operator == Ast::Expression::AssignmentOperator::MultiplyAssign) {
      return "*=";
    }

    if (operator == Ast::Expression::AssignmentOperator::DivideAssign) {
      return "/=";
    }

    if (operator == Ast::Expression::AssignmentOperator::ModuloAssign) {
      return "%=";
    }

    if (operator == Ast::Expression::AssignmentOperator::ShiftLeftAssign) {
      return "<<=";
    }

    if (operator == Ast::Expression::AssignmentOperator::ShiftRightAssign) {
      return ">>=";
    }

    if (operator == Ast::Expression::AssignmentOperator::BitAndAssign) {
      return "&=";
    }

    if (operator == Ast::Expression::AssignmentOperator::BitOrAssign) {
      return "|=";
    }

    if (operator == Ast::Expression::AssignmentOperator::BitXorAssign) {
      return "^=";
    }

    if (operator == Ast::Expression::AssignmentOperator::AndAssign) {
      return "&&=";
    }

    return "||=";
  }

  function unaryOperatorText(operator: Ast::Expression::UnaryOperator): str {
    if (operator == Ast::Expression::UnaryOperator::Not) {
      return "!";
    }

    if (operator == Ast::Expression::UnaryOperator::Negate) {
      return "-";
    }

    if (operator == Ast::Expression::UnaryOperator::Increment) {
      return "++";
    }

    if (operator == Ast::Expression::UnaryOperator::Decrement) {
      return "--";
    }

    return "~";
  }

  /// Precedence host assigns each expression kind for parenthesization
  /// decisions. Kinds this file does not render with a dedicated case (and
  /// instead falls back to a verbatim span slice for) use `u8` max, matching
  /// the host's own fallback for kinds it does not special-case either
  /// (`_ => u8::MAX`).
  function expressionPrecedence(node: &Ast::Expression::Node): u8 {
    if (let Ast::Expression::Node::Assignment(_) = node) {
      return 1;
    }

    if (let Ast::Expression::Node::Ternary(_) = node) {
      return 1;
    }

    if (let Ast::Expression::Node::Binary(binaryExpr) = node) {
      return Format::binaryPrecedence(binaryExpr.operator);
    }

    if (let Ast::Expression::Node::Grouped(_) = node) {
      return 255;
    }

    if (let Ast::Expression::Node::Call(_) = node) {
      return 12;
    }

    if (let Ast::Expression::Node::MemberAccess(_) = node) {
      return 12;
    }

    if (let Ast::Expression::Node::VectorAccess(_) = node) {
      return 12;
    }

    if (let Ast::Expression::Node::Cast(_) = node) {
      return 10;
    }

    if (let Ast::Expression::Node::Unary(_) = node) {
      return 11;
    }

    if (let Ast::Expression::Node::Reference(_) = node) {
      return 11;
    }

    if (let Ast::Expression::Node::Dereference(_) = node) {
      return 11;
    }

    if (let Ast::Expression::Node::PostfixIncrement(_) = node) {
      return 12;
    }

    if (let Ast::Expression::Node::PostfixDecrement(_) = node) {
      return 12;
    }

    if (let Ast::Expression::Node::Try(_) = node) {
      return 12;
    }

    if (let Ast::Expression::Node::Lambda(_) = node) {
      return 0;
    }

    if (let Ast::Expression::Node::Match(_) = node) {
      return 0;
    }

    return 255;
  }

  function formatBinaryChild(
    module: &Ast::Module,
    expressionId: Ast::ExpressionId,
    parentPrecedence: u8,
    isRightChild: boolean,
    source: &String
  ): String {
    let Option::SOME(node) = module.expressions.get(expressionId) else {
      return String::new();
    };

    let childPrecedence: u8 = Format::expressionPrecedence(node);
    let formatted: String = Format::formatExpressionNode(module, expressionId, parentPrecedence, source);

    let mut isBinary: boolean = false;

    if (let Ast::Expression::Node::Binary(_) = node) {
      isBinary = true;
    }

    if (childPrecedence < parentPrecedence || (isRightChild && childPrecedence == parentPrecedence && isBinary)) {
      let mut wrapped: String = String::create("(");
      wrapped.push(&formatted);
      wrapped.pushStr(")");
      return wrapped;
    }

    return formatted;
  }

  function joinFormattedExpressions(
    module: &Ast::Module,
    ids: &Vector<Ast::ExpressionId>,
    source: &String
  ): String {
    let mut result: String = String::new();
    let mut index: u64 = 0;

    while (index < ids.length()) {
      let Option::SOME(expressionId) = ids.get(index) else {
        index += 1;
        continue;
      };

      if (index > 0) {
        result.pushStr(", ");
      }

      let formatted: String = Format::formatExpressionNode(module, *expressionId, 0, source);
      result.push(&formatted);
      index += 1;
    }

    return result;
  }

  function formatExpressionNode(
    module: &Ast::Module,
    expressionId: Ast::ExpressionId,
    parentPrecedence: u8,
    source: &String
  ): String {
    let Option::SOME(node) = module.expressions.get(expressionId) else {
      return String::new();
    };

    return Format::formatExpression(module, node, parentPrecedence, source);
  }

  /// Renders an `Ast::Expression::Node`. Kinds without a dedicated case here
  /// (`Match`, `Lambda`, `RecordInit` when it spans one line, `LetCondition`,
  /// `Pipe`/`PipePlaceholder`, `CaptureOverride`, `BuiltinCall`, `Block`,
  /// `If`-expression, `VectorLiteral`) fall back to a verbatim slice of that
  /// expression's own span, the same graceful-degradation strategy the host
  /// itself uses for multiline calls/record-inits/matches (`is_multiline_source`).
  function formatExpression(
    module: &Ast::Module,
    node: &Ast::Expression::Node,
    parentPrecedence: u8,
    source: &String
  ): String {
    if (let Ast::Expression::Node::Variable(variable) = node) {
      return sliceExprSpan(source, &variable.span).trimAsciiWhitespace();
    }

    if (let Ast::Expression::Node::Path(path) = node) {
      return sliceExprSpan(source, &path.span).trimAsciiWhitespace();
    }

    if (let Ast::Expression::Node::Literal(literal) = node) {
      return sliceExprSpan(source, &literal.span).trimAsciiWhitespace();
    }

    if (let Ast::Expression::Node::Unit(_) = node) {
      return String::create("()");
    }

    if (let Ast::Expression::Node::Grouped(grouped) = node) {
      let inner: String = Format::formatExpressionNode(module, grouped.expression, 0, source);
      let mut result: String = String::create("(");
      result.push(&inner);
      result.pushStr(")");
      return result;
    }

    if (let Ast::Expression::Node::Tuple(tuple) = node) {
      let inner: String = Format::joinFormattedExpressions(module, &tuple.elements, source);
      let mut result: String = String::create("(");
      result.push(&inner);
      result.pushStr(")");
      return result;
    }

    if (let Ast::Expression::Node::Unary(unary) = node) {
      let operand: String = Format::formatExpressionNode(module, unary.operand, 9, source);
      let mut result: String = String::create(Format::unaryOperatorText(unary.operator));
      result.push(&operand);
      return result;
    }

    if (let Ast::Expression::Node::Binary(binaryExpr) = node) {
      let precedence: u8 = Format::binaryPrecedence(binaryExpr.operator);
      let left: String = Format::formatBinaryChild(module, binaryExpr.left, precedence, false, source);
      let right: String = Format::formatBinaryChild(module, binaryExpr.right, precedence, true, source);

      let mut formatted: String = left;
      formatted.pushChar(' ');
      formatted.pushStr(Format::binaryOperatorText(binaryExpr.operator));
      formatted.pushChar(' ');
      formatted.push(&right);

      if (precedence < parentPrecedence) {
        let mut wrapped: String = String::create("(");
        wrapped.push(&formatted);
        wrapped.pushStr(")");
        return wrapped;
      }

      return formatted;
    }

    if (let Ast::Expression::Node::Assignment(assignment) = node) {
      let target: String = Format::formatExpressionNode(module, assignment.target, 1, source);
      let value: String = Format::formatExpressionNode(module, assignment.value, 1, source);

      let mut formatted: String = target;
      formatted.pushChar(' ');
      formatted.pushStr(Format::assignmentOperatorText(assignment.operator));
      formatted.pushChar(' ');
      formatted.push(&value);

      if (parentPrecedence > 1) {
        let mut wrapped: String = String::create("(");
        wrapped.push(&formatted);
        wrapped.pushStr(")");
        return wrapped;
      }

      return formatted;
    }

    if (let Ast::Expression::Node::Ternary(ternary) = node) {
      let condition: String = Format::formatExpressionNode(module, ternary.condition, 0, source);
      let thenText: String = Format::formatExpressionNode(module, ternary.thenBranch, 0, source);
      let elseText: String = Format::formatExpressionNode(module, ternary.elseBranch, 0, source);

      let mut formatted: String = condition;
      formatted.pushStr(" ? ");
      formatted.push(&thenText);
      formatted.pushStr(" : ");
      formatted.push(&elseText);

      if (parentPrecedence > 1) {
        let mut wrapped: String = String::create("(");
        wrapped.push(&formatted);
        wrapped.pushStr(")");
        return wrapped;
      }

      return formatted;
    }

    if (let Ast::Expression::Node::Call(call) = node) {
      let sourceText: String = sliceExprSpan(source, &call.span).trimAsciiWhitespace();

      if (containsNewlineByteExpr(&sourceText)) {
        return sourceText;
      }

      let mut formatted: String = Format::formatExpressionNode(module, call.callee, 10, source);

      if (call.typeArguments.length() > 0) {
        let typeArgs: String = Format::joinFormattedTypes(module, &call.typeArguments, source);
        formatted.pushStr("<");
        formatted.push(&typeArgs);
        formatted.pushStr(">");
      }

      let argumentsText: String = Format::joinFormattedExpressions(module, &call.arguments, source);

      let mut trailing: str = "";

      if (call.arguments.length() > 0) {
        let Option::SOME(lastArgumentId) = call.arguments.get(call.arguments.length() - 1) else {
          return formatted;
        };

        let Option::SOME(lastArgumentNode) = module.expressions.get(*lastArgumentId) else {
          return formatted;
        };

        let lastArgumentSpan: SourceSpan = Ast::Serializer::expressionSpan(lastArgumentNode);

        if (rangeContainsComma(source, lastArgumentSpan.end, call.span.end)) {
          trailing = ",";
        }
      }

      formatted.pushStr("(");
      formatted.push(&argumentsText);
      formatted.pushStr(trailing);
      formatted.pushStr(")");

      return formatted;
    }

    if (let Ast::Expression::Node::Cast(cast) = node) {
      let inner: String = Format::formatExpressionNode(module, cast.expression, 11, source);
      let targetTypeText: String = Format::formatType(module, cast.targetType, source);

      let mut formatted: String = inner;
      formatted.pushStr(" as ");
      formatted.push(&targetTypeText);

      if (parentPrecedence > 10) {
        let mut wrapped: String = String::create("(");
        wrapped.push(&formatted);
        wrapped.pushStr(")");
        return wrapped;
      }

      return formatted;
    }

    if (let Ast::Expression::Node::Reference(reference) = node) {
      let inner: String = Format::formatExpressionNode(module, reference.target, 11, source);
      let mut result: String = String::new();

      if (reference.mutable) {
        result.pushStr("&mut ");
      } else {
        result.pushStr("&");
      }

      result.push(&inner);
      return result;
    }

    if (let Ast::Expression::Node::Dereference(dereference) = node) {
      let inner: String = Format::formatExpressionNode(module, dereference.operand, 11, source);
      let mut result: String = String::create("*");
      result.push(&inner);
      return result;
    }

    if (let Ast::Expression::Node::MemberAccess(access) = node) {
      let objectText: String = Format::formatExpressionNode(module, access.object, 10, source);
      let mut result: String = objectText;

      if (access.operator == Ast::Expression::AccessOperator::DoubleColon) {
        result.pushStr("::");
      } else {
        result.pushStr(".");
      }

      result.push(&access.member);
      return result;
    }

    if (let Ast::Expression::Node::VectorAccess(access) = node) {
      let vectorText: String = Format::formatExpressionNode(module, access.vector, 12, source);
      let indexText: String = Format::formatExpressionNode(module, access.index, 0, source);

      let mut result: String = vectorText;
      result.pushStr("[");
      result.push(&indexText);
      result.pushStr("]");
      return result;
    }

    if (let Ast::Expression::Node::PostfixIncrement(postfix) = node) {
      let operandText: String = Format::formatExpressionNode(module, postfix.operand, 12, source);
      let mut result: String = operandText;
      result.pushStr("++");
      return result;
    }

    if (let Ast::Expression::Node::PostfixDecrement(postfix) = node) {
      let operandText: String = Format::formatExpressionNode(module, postfix.operand, 12, source);
      let mut result: String = operandText;
      result.pushStr("--");
      return result;
    }

    if (let Ast::Expression::Node::Try(tryExpr) = node) {
      let innerText: String = Format::formatExpressionNode(module, tryExpr.expression, 12, source);
      let mut result: String = innerText;
      result.pushStr("!");
      return result;
    }

    if (let Ast::Expression::Node::Vector(vectorLiteral) = node) {
      let sourceText: String = sliceExprSpan(source, &vectorLiteral.span).trimAsciiWhitespace();

      if (containsNewlineByteExpr(&sourceText)) {
        return sourceText;
      }

      let inner: String = Format::joinFormattedExpressions(module, &vectorLiteral.elements, source);
      let mut result: String = String::create("[");
      result.push(&inner);
      result.pushStr("]");
      return result;
    }

    let span: SourceSpan = Ast::Serializer::expressionSpan(node);
    return sliceExprSpan(source, &span).trimAsciiWhitespace();
  }
}
