import Vector from "std::vector";

import Id from "@compiler::ids";
import Analyzer from "@compiler::analyzer";
import Borrowck from "@compiler::analyzer::borrowck";
import Hir from "@compiler::hir";
import Lir from "@compiler::lir";

/// LIR -> C emission for the Ignis selfhost compiler.
///
/// Port of `crates/ignis_codegen_c`, following the same measured loop the
/// earlier stages used: every construct the emitter cannot express yet bumps
/// `unsupported` and leaves a comment in the output, so one full-corpus run
/// says exactly how much is left.
///
/// One deliberate divergence from the oracle: symbol names. The host derives a
/// C name from the owning namespace chain plus an overload suffix, machinery
/// the selfhost definition store does not carry. The selfhost emits the whole
/// program from its own LIR, std included, so its names only have to be unique
/// within that one translation unit. Every non-extern definition therefore
/// gets its written name plus its definition id, which is unique by
/// construction. An extern function keeps its written name, because that one
/// has to match the symbol the C side already defines.
export namespace CodegenC {
  /// The emitted translation unit plus what the run measured.
  record EmitOutput {
    public source: String;
    /// LIR instructions and terminators the emitter does not handle yet.
    public unsupported: u64;
    /// Function bodies written out, extern declarations excluded.
    public functions: u64;
  }

  /// The environment struct one closure thunk reads its captures out of.
  record ClosureEnv {
    /// Raw definition id of the thunk this environment belongs to.
    public thunk: u32;
    /// Raw type id of each capture, in the order `MakeClosure` writes them.
    public captureTypes: Vector<u32>;
  }

  /// What the closure prepass found, so `formatCType` can tell a closure value
  /// from a raw C function pointer.
  ///
  /// A `Type::Function` reaches the emitter for two different things: an Ignis
  /// closure, which is a struct of call pointer, drop pointer and environment,
  /// and a bare C function pointer an extern declaration takes. Only the raw
  /// ids listed in `signatures` are the former.
  record ClosureTables {
    public signatures: Vector<u32>;
    public envs: Vector<CodegenC::ClosureEnv>;

    public static empty(): ClosureTables {
      return ClosureTables {
        signatures: Vector::new<u32>(),
        envs: Vector::new<CodegenC::ClosureEnv>(),
      };
    }
  }

  /// Whether `text` can appear in a C identifier.
  function isIdentifierByte(byte: u8): boolean {
    if (byte >= 48 && byte <= 57) {
      return true;
    }

    if (byte >= 65 && byte <= 90) {
      return true;
    }

    if (byte >= 97 && byte <= 122) {
      return true;
    }

    return byte == 95;
  }

  /// `text` with every byte C cannot spell replaced by an underscore.
  function sanitize(text: str): String {
    let source: String = String::create(text);
    let mut result: String = String::create("");
    let mut index: u64 = 0;

    while (index < source.length()) {
      let Option::SOME(byte) = source.byteAt(index) else {
        index += 1;
        continue;
      };

      if (CodegenC::isIdentifierByte(byte)) {
        result.pushByte(byte);
      } else {
        result.pushStr("_");
      }

      index += 1;
    }

    return result;
  }

  function definitionName(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): String {
    let Option::SOME(definition) = defStore.get(defId) else {
      return String::create("__unknown");
    };

    let nameSymbol: Analyzer::SymbolId = definition.name();

    let Option::SOME(text) = symbols.resolve(nameSymbol) else {
      return String::create("__unnamed");
    };

    return CodegenC::sanitize(text);
  }

  /// The C symbol for a definition. Extern functions and constants keep the
  /// name the C side already defines; everything else is suffixed with its
  /// definition id.
  function mangledName(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): String {
    let mut isExtern: boolean = false;
    let mut externName: Option<String> = Option::NONE;

    if (let Option::SOME(definition) = defStore.get(defId)) {
      match (definition) {
        Analyzer::Definition::Function(functionDef) -> {
          isExtern = functionDef.isExtern;

          if (let Option::SOME(name) = &functionDef.externName) {
            externName = Option::SOME(name.clone());
          }
        },
        Analyzer::Definition::Variable(variableDef) -> {
          isExtern = variableDef.isExtern;
        },
        _ -> {},
      };
    }

    if (let Option::SOME(name) = externName) {
      return name;
    }

    let base: String = CodegenC::definitionName(defStore, symbols, defId);

    if (isExtern) {
      return base;
    }

    return `${base.toStr()}_${defId.raw()}`;
  }

  function structName(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): String {
    let base: String = CodegenC::definitionName(defStore, symbols, defId);

    return `${base.toStr()}_${defId.raw()}`;
  }

  /// The C spelling of a type.
  ///
  /// Post-monomorphization no `Param` or `Instance` survives, so both answer
  /// `void*` rather than panicking: an emitter that crashes on a bad input
  /// says less than one that emits something the C compiler will reject at a
  /// named line.
  function formatCType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    closures: &CodegenC::ClosureTables,
    typeId: Analyzer::TypeId,
  ): String {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return String::create("void*");
    };

    let mut pointee: Analyzer::TypeId = typeId;
    let mut nominal: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);

    // 0 answers directly, 1 is a pointer to `pointee`, 2 is a struct name.
    let mut shape: u64 = 0;
    let mut direct: String = String::create("void*");

    match (typeNode) {
      Analyzer::Type::I8 -> {
        direct = String::create("i8");
      },
      Analyzer::Type::I16 -> {
        direct = String::create("i16");
      },
      Analyzer::Type::I32 -> {
        direct = String::create("i32");
      },
      Analyzer::Type::I64 -> {
        direct = String::create("i64");
      },
      Analyzer::Type::U8 -> {
        direct = String::create("u8");
      },
      Analyzer::Type::U16 -> {
        direct = String::create("u16");
      },
      Analyzer::Type::U32 -> {
        direct = String::create("u32");
      },
      Analyzer::Type::U64 -> {
        direct = String::create("u64");
      },
      Analyzer::Type::F32 -> {
        direct = String::create("f32");
      },
      Analyzer::Type::F64 -> {
        direct = String::create("f64");
      },
      Analyzer::Type::BOOLEAN -> {
        direct = String::create("boolean");
      },
      Analyzer::Type::CHAR -> {
        direct = String::create("ignis_char_t");
      },
      Analyzer::Type::STR -> {
        direct = String::create("const char*");
      },
      Analyzer::Type::VOID -> {
        direct = String::create("void");
      },
      // A diverging expression still has to occupy a slot in C.
      Analyzer::Type::NEVER -> {
        direct = String::create("void");
      },
      Analyzer::Type::ATOM -> {
        direct = String::create("ignis_atom_t");
      },
      Analyzer::Type::Pointer(pointerType) -> {
        shape = 1;
        pointee = pointerType.pointee;
      },
      Analyzer::Type::Reference(referenceType) -> {
        shape = 1;
        pointee = referenceType.referent;
      },
      // A fixed array decays to a pointer at every use the emitter has.
      Analyzer::Type::FixedArray(element, _) -> {
        shape = 1;
        pointee = element;
      },
      Analyzer::Type::Record(recordDef) -> {
        shape = 2;
        nominal = recordDef;
      },
      Analyzer::Type::Enum(enumDef) -> {
        shape = 2;
        nominal = enumDef;
      },
      // A function type the prepass recognised as a closure is a struct; every
      // other one is a bare C function pointer an extern declaration takes.
      Analyzer::Type::Function(_) -> {
        if (CodegenC::hasRaw(&closures.signatures, typeId.raw())) {
          shape = 3;
        }
      },
      Analyzer::Type::Slice(_) -> {
        shape = 4;
      },
      _ -> {},
    };

    if (shape == 3) {
      let name: String = CodegenC::closureStructName(typeId);

      return `struct ${name.toStr()}`;
    }

    if (shape == 4) {
      let name: String = CodegenC::sliceStructName(typeId);

      return `struct ${name.toStr()}`;
    }

    if (shape == 1) {
      let inner: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, pointee);

      return `${inner.toStr()}*`;
    }

    if (shape == 2) {
      let name: String = CodegenC::structName(defStore, symbols, nominal);

      return `struct ${name.toStr()}`;
    }

    return direct;
  }

  function binaryOperator(op: &Hir::BinaryOperation): str {
    return match (op) {
      Hir::BinaryOperation::Add -> "+",
      Hir::BinaryOperation::Sub -> "-",
      Hir::BinaryOperation::Mul -> "*",
      Hir::BinaryOperation::Div -> "/",
      Hir::BinaryOperation::Mod -> "%",
      Hir::BinaryOperation::And -> "&&",
      Hir::BinaryOperation::Or -> "||",
      Hir::BinaryOperation::Equal -> "==",
      Hir::BinaryOperation::NotEqual -> "!=",
      Hir::BinaryOperation::LessThan -> "<",
      Hir::BinaryOperation::LessEqual -> "<=",
      Hir::BinaryOperation::GreaterThan -> ">",
      Hir::BinaryOperation::GreaterEqual -> ">=",
      Hir::BinaryOperation::BitAnd -> "&",
      Hir::BinaryOperation::BitOr -> "|",
      Hir::BinaryOperation::BitXor -> "^",
      Hir::BinaryOperation::BitShiftLeft -> "<<",
      Hir::BinaryOperation::BitShiftRight -> ">>",
      // `**` has no C operator; the caller reports it unsupported.
      Hir::BinaryOperation::Pow -> "",
    };
  }

  function unaryOperator(op: &Hir::UnaryOperation): str {
    return match (op) {
      Hir::UnaryOperation::Not -> "!",
      Hir::UnaryOperation::Neg -> "-",
      Hir::UnaryOperation::BitNot -> "~",
    };
  }

  /// A C string literal body with the bytes C cannot carry raw escaped.
  ///
  /// Bytes outside printable ASCII become one hex escape each, so a non-ASCII
  /// character is written as its UTF-8 bytes. A C hex escape consumes every hex
  /// digit that follows it, so a printable byte in that position is written as a
  /// fixed-width octal escape instead.
  function escapeStringLiteral(value: &String): String {
    let mut result: String = String::create("");
    let mut index: u64 = 0;
    let mut afterHexEscape: boolean = false;

    while (index < value.length()) {
      let Option::SOME(byte) = value.byteAt(index) else {
        index += 1;
        continue;
      };

      let mut nextAfterHexEscape: boolean = false;

      if (byte == 34) {
        result.pushStr("\\\"");
      } else if (byte == 92) {
        result.pushStr("\\\\");
      } else if (byte == 10) {
        result.pushStr("\\n");
      } else if (byte == 13) {
        result.pushStr("\\r");
      } else if (byte == 9) {
        result.pushStr("\\t");
      } else if (byte == 0) {
        result.pushStr("\\000");
      } else if (byte >= 32 && byte <= 126) {
        if (afterHexEscape && CodegenC::isHexDigitByte(byte)) {
          result.pushStr(CodegenC::octalEscape(byte).toStr());
        } else {
          result.pushByte(byte);
        }
      } else {
        result.pushStr(CodegenC::hexEscape(byte).toStr());

        nextAfterHexEscape = true;
      }

      afterHexEscape = nextAfterHexEscape;
      index += 1;
    }

    return result;
  }

  /// The `\xNN` C escape for one byte, with lowercase hex digits.
  function hexEscape(byte: u8): String {
    let mut escape: String = String::create("\\x");

    escape.pushByte(CodegenC::hexDigitByte(byte / 16));
    escape.pushByte(CodegenC::hexDigitByte(byte % 16));

    return escape;
  }

  /// The three-digit `\NNN` C octal escape for one byte.
  function octalEscape(byte: u8): String {
    let mut escape: String = String::create("\\");

    escape.pushByte(48 + (byte / 64));
    escape.pushByte(48 + ((byte / 8) % 8));
    escape.pushByte(48 + (byte % 8));

    return escape;
  }

  /// The lowercase ASCII hex digit for a value in the inclusive range `0..15`.
  function hexDigitByte(value: u8): u8 {
    if (value < 10) {
      return 48 + value;
    }

    return 87 + value;
  }

  /// Returns whether an ASCII byte is a hex digit that a C hex escape would absorb.
  function isHexDigitByte(byte: u8): boolean {
    let isDigit: boolean = byte >= 48 && byte <= 57;
    let isUpper: boolean = byte >= 65 && byte <= 70;
    let isLower: boolean = byte >= 97 && byte <= 102;

    return isDigit || isUpper || isLower;
  }

  function formatConst(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    closures: &CodegenC::ClosureTables,
    value: &Lir::ConstValue,
  ): String {
    match (value) {
      Lir::ConstValue::Int(number, _) -> {
        return `${number}`;
      },
      Lir::ConstValue::UInt(number, _) -> {
        return `${number}U`;
      },
      Lir::ConstValue::Float(number, _) -> {
        return `${number}`;
      },
      Lir::ConstValue::Bool(flag, _) -> {
        if (flag) {
          return String::create("true");
        }

        return String::create("false");
      },
      Lir::ConstValue::Char(scalar, _) -> {
        return `${scalar}U`;
      },
      Lir::ConstValue::Str(text, _) -> {
        let escaped: String = CodegenC::escapeStringLiteral(&text);

        return `"${escaped.toStr()}"`;
      },
      Lir::ConstValue::Atom(scalar, _) -> {
        return `${scalar}U`;
      },
      Lir::ConstValue::Null(_) -> {
        return String::create("NULL");
      },
      // An undefined value still needs a well-typed zero in C.
      Lir::ConstValue::Undef(ty) -> {
        let typeText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, ty);

        return `(${typeText.toStr()}){0}`;
      },
    };

    @panic("unreachable: formatConst match did not return");
  }

  function formatOperand(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    closures: &CodegenC::ClosureTables,
    operand: &Lir::Operand,
  ): String {
    match (operand) {
      Lir::Operand::Temp(temp) -> {
        return `t${temp.raw()}`;
      },
      Lir::Operand::Local(local) -> {
        return `l${local.raw()}`;
      },
      Lir::Operand::Const(value) -> {
        return CodegenC::formatConst(defStore, typeStore, symbols, closures, &value);
      },
      Lir::Operand::FuncRef(defId) -> {
        return CodegenC::mangledName(defStore, symbols, defId);
      },
      Lir::Operand::GlobalRef(defId) -> {
        return CodegenC::mangledName(defStore, symbols, defId);
      },
    };

    @panic("unreachable: formatOperand match did not return");
  }

  /// `<return> <name>(<params>)`, shared by the prototype and the definition.
  function functionSignature(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    closures: &CodegenC::ClosureTables,
    function_: &Lir::FunctionLir,
  ): String {
    let returnText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, function_.returnType);
    let name: String = CodegenC::mangledName(defStore, symbols, function_.defId);

    let mut signature: String = `${returnText.toStr()} ${name.toStr()}(`;

    if (function_.params.length() == 0) {
      signature.pushStr("void");
    }

    let mut index: u64 = 0;

    while (index < function_.params.length()) {
      let Option::SOME(paramDefId) = function_.params.get(index) else {
        index += 1;
        continue;
      };

      let mut paramType: Analyzer::TypeId = function_.returnType;

      if (let Option::SOME(definition) = defStore.get(*paramDefId)) {
        if (let Analyzer::Definition::Variable(variableDef) = definition) {
          paramType = variableDef.declaredType;
        }
      }

      if (index > 0) {
        signature.pushStr(", ");
      }

      let paramText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, paramType);

      // Parameters arrive as the implicit temps `t0..tn-1`, the same shape the
      // LIR prologue stores into local slots.
      let declaration: String = `${paramText.toStr()} t${index}`;
      signature.pushStr(declaration.toStr());

      index += 1;
    }

    signature.pushStr(")");

    return signature;
  }

  function isExternFunction(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(defId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Function(functionDef) -> functionDef.isExtern,
      _ -> false,
    };
  }

  /// Whether the emitted unit gives `defId` internal linkage.
  ///
  /// The host writes `static` on every function that is neither public, a
  /// method, a `@test` function nor extern (`emit_function_signature` in
  /// `crates/ignis_codegen_c/src/emit.rs`), because it emits one translation
  /// unit per module: a symbol another unit calls has to survive linking. The
  /// selfhost emits the whole program, std included, as a single unit, so the
  /// public and method exceptions have no cross-unit caller left to serve, and
  /// the C entry wrapper reaches the entry point from inside the same unit.
  /// Two cases still need external linkage, and both are the host's own: an
  /// extern function, which the C side defines, and a `@test` function, which
  /// the separate harness unit declares and calls by symbol.
  ///
  /// Internal linkage is also what lets gcc inline: under `-fPIC` an
  /// externally-visible function may be interposed at load time, so a small
  /// hot accessor stays an out-of-line call for as long as it is not `static`.
  function hasInternalLinkage(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
    externalSymbols: &Vector<u32>,
  ): boolean {
    if (CodegenC::isExternFunction(defStore, defId)) {
      return false;
    }

    return !CodegenC::hasRaw(externalSymbols, defId.raw());
  }

  /// Whether the nominal behind `defId` carries `@implements(Drop)`, which is
  /// what makes its `__ignis_drop_state` byte meaningful.
  function hasDropTrait(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(defId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Record(recordDef) -> recordDef.implementsDrop,
      Analyzer::Definition::Enum(enumDef) -> enumDef.implementsDrop,
      _ -> false,
    };
  }

  /// The user-written `drop` method of a nominal, if it declares one.
  ///
  /// A monomorphized record or enum keeps an empty method list: mono
  /// specializes methods as standalone definitions that point back at the
  /// instantiation. For those the list lookup finds nothing and the store is
  /// scanned for the method the instantiation owns.
  function findDropMethod(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): Option<Analyzer::DefinitionId> {
    if (let Option::SOME(methodId) = CodegenC::findNamedInstanceMethod(defStore, symbols, defId, "drop")) {
      return Option::SOME(methodId);
    }

    if (!CodegenC::hasDropTrait(defStore, defId)) {
      return Option::NONE;
    }

    if (!CodegenC::hasNoInstanceMethods(defStore, defId)) {
      return Option::NONE;
    }

    return CodegenC::findOwnedDropMethod(defStore, symbols, defId);
  }

  /// Whether the nominal behind `defId` lists no instance method, which is
  /// what a monomorphized shell looks like.
  function hasNoInstanceMethods(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(defId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Record(recordDef) -> recordDef.instanceMethods.length() == 0,
      Analyzer::Definition::Enum(enumDef) -> enumDef.instanceMethods.length() == 0,
      _ -> false,
    };
  }

  /// Scans every definition for the `drop` method `defId` owns.
  ///
  /// Monomorphization names a specialized method after the method it came
  /// from followed by the owner's type arguments, so `drop__i32` is the
  /// destructor of one `Vector` instantiation.
  function findOwnedDropMethod(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): Option<Analyzer::DefinitionId> {
    let owned: Vector<Analyzer::DefinitionId> = defStore.methodsOwnedBy(defId);
    let mut rawId: u64 = 0;

    while (rawId < owned.length()) {
      let Option::SOME(candidate) = owned.get(rawId) else {
        rawId += 1;
        continue;
      };

      let candidateId: Analyzer::DefinitionId = *candidate;
      let mut nameSym: Option<Analyzer::SymbolId> = Option::NONE;

      if (let Option::SOME(Analyzer::Definition::Method(methodDef)) = defStore.get(candidateId)) {
        nameSym = Option::SOME(methodDef.name);
      }

      if (let Option::SOME(methodName) = nameSym) {
        if (let Option::SOME(text) = symbols.resolve(methodName)) {
          let name: String = String::create(text);

          if (name.equals("drop") || name.startsWith("drop__")) {
            return Option::SOME(candidateId);
          }
        }
      }

      rawId += 1;
    }

    return Option::NONE;
  }

  /// The instance method of a nominal written with the given name.
  function findNamedInstanceMethod(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
    methodName: str,
  ): Option<Analyzer::DefinitionId> {
    let mut methods: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(defId)) {
      match (definition) {
        Analyzer::Definition::Record(recordDef) -> {
          methods = CodegenC::copyDefIds(&recordDef.instanceMethods);
        },
        Analyzer::Definition::Enum(enumDef) -> {
          methods = CodegenC::copyDefIds(&enumDef.instanceMethods);
        },
        _ -> {},
      };
    }

    let mut methodIndex: u64 = 0;

    while (methodIndex < methods.length()) {
      let Option::SOME(methodId) = methods.get(methodIndex) else {
        methodIndex += 1;
        continue;
      };

      let Option::SOME(method) = defStore.get(*methodId) else {
        methodIndex += 1;
        continue;
      };

      if (let Option::SOME(text) = symbols.resolve(method.name())) {
        if (String::create(text).equals(methodName)) {
          return Option::SOME(*methodId);
        }
      }

      methodIndex += 1;
    }

    return Option::NONE;
  }

  /// The drop calls one value needs: its own `drop` method when it declares
  /// one, otherwise the drops of every droppable field or variant payload.
  ///
  /// A `@implements(Drop)` nominal is guarded by its `__ignis_drop_state` byte
  /// so a value dropped twice runs its destructor once.
  function emitFieldDrops(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    closures: &CodegenC::ClosureTables,
    expression: &String,
    typeId: Analyzer::TypeId,
  ): void {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return;
    };

    let mut nominal: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);
    let mut isRecord: boolean = false;
    let mut isEnum: boolean = false;

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        nominal = defId;
        isRecord = true;
      },
      Analyzer::Type::Enum(defId) -> {
        nominal = defId;
        isEnum = true;
      },
      _ -> {},
    };

    if (!isRecord && !isEnum) {
      return;
    }

    let guarded: boolean = CodegenC::hasDropTrait(defStore, nominal);

    if (let Option::SOME(methodId) = CodegenC::findDropMethod(defStore, symbols, nominal)) {
      let name: String = CodegenC::mangledName(defStore, symbols, methodId);

      let mut block: String = String::create("");

      if (guarded) {
        let open: String = `    if (!(${expression.toStr()}).__ignis_drop_state) {\n  `;
        block.pushStr(open.toStr());
      }

      let call: String = `    ${name.toStr()}(&${expression.toStr()});\n`;
      block.pushStr(call.toStr());

      if (guarded) {
        let mark: String = `      (${expression.toStr()}).__ignis_drop_state = 1;\n    }\n`;
        block.pushStr(mark.toStr());
      }

      let mut outputRef: &mut String = output;
      outputRef.pushStr(block.toStr());

      return;
    }

    if (isEnum) {
      CodegenC::emitEnumVariantDrops(defStore, typeStore, symbols, output, closures, expression, nominal);
      return;
    }

    let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(nominal)) {
      if (let Analyzer::Definition::Record(recordDef) = definition) {
        fields = CodegenC::copyDefIds(&recordDef.fields);
      }
    }

    let mut fieldIndex: u64 = 0;

    while (fieldIndex < fields.length()) {
      let Option::SOME(fieldId) = fields.get(fieldIndex) else {
        fieldIndex += 1;
        continue;
      };

      let Option::SOME(fieldDefinition) = defStore.get(*fieldId) else {
        fieldIndex += 1;
        continue;
      };

      let Analyzer::Definition::Field(fieldDef) = fieldDefinition else {
        fieldIndex += 1;
        continue;
      };

      let fieldType: Analyzer::TypeId = fieldDef.fieldType;
      let index: u32 = fieldDef.index;

      if (Borrowck::needsDropType(defStore, typeStore, fieldType)) {
        let access: String = `${expression.toStr()}.field_${index}`;
        CodegenC::emitFieldDrops(defStore, typeStore, symbols, output, closures, &access, fieldType);
      }

      fieldIndex += 1;
    }
  }

  /// Drop the payload of whichever variant is live, dispatching on the tag.
  function emitEnumVariantDrops(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    closures: &CodegenC::ClosureTables,
    expression: &String,
    defId: Analyzer::DefinitionId,
  ): void {
    let mut variants: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(defId)) {
      if (let Analyzer::Definition::Enum(enumDef) = definition) {
        variants = CodegenC::copyDefIds(&enumDef.variants);
      }
    }

    let mut body: String = String::create("");
    let mut variantIndex: u64 = 0;

    while (variantIndex < variants.length()) {
      let Option::SOME(variantId) = variants.get(variantIndex) else {
        variantIndex += 1;
        continue;
      };

      let Option::SOME(variantDefinition) = defStore.get(*variantId) else {
        variantIndex += 1;
        continue;
      };

      let Analyzer::Definition::Variant(variantDef) = variantDefinition else {
        variantIndex += 1;
        continue;
      };

      let tag: u32 = variantDef.tagValue;
      let payload: Vector<Analyzer::TypeId> = CodegenC::copyTypeIds(&variantDef.payload);

      let mut arm: String = String::create("");
      let mut payloadIndex: u64 = 0;

      while (payloadIndex < payload.length()) {
        let Option::SOME(payloadType) = payload.get(payloadIndex) else {
          payloadIndex += 1;
          continue;
        };

        if (Borrowck::needsDropType(defStore, typeStore, *payloadType)) {
          let access: String = `${expression.toStr()}.payload.variant_${tag}.field_${payloadIndex}`;
          CodegenC::emitFieldDrops(defStore, typeStore, symbols, &mut arm, closures, &access, *payloadType);
        }

        payloadIndex += 1;
      }

      if (arm.length() > 0) {
        let label: String = `      case ${tag}:\n`;
        body.pushStr(label.toStr());
        body.pushStr(arm.toStr());
        body.pushStr("        break;\n");
      }

      variantIndex += 1;
    }

    if (body.length() == 0) {
      return;
    }

    let open: String = `    switch ((${expression.toStr()}).tag) {\n`;

    let mut outputRef: &mut String = output;
    outputRef.pushStr(open.toStr());
    outputRef.pushStr(body.toStr());
    outputRef.pushStr("    }\n");
  }

  /// Mark a moved-from value as already dropped, so the drop scheduled at the
  /// end of its scope becomes a no-op.
  /// A freshly built record or enum value that carries a drop flag starts
  /// live: its slot may hold the flag of a value dropped earlier. Mirrors
  /// the oracle's reset after `InitRecord` and `InitEnumVariant`.
  function emitInitializedDropState(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    output: &mut String,
    destination: &String,
    typeId: Analyzer::TypeId,
  ): void {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return;
    };

    let mut nominalOpt: Option<Analyzer::DefinitionId> = Option::NONE;

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        nominalOpt = Option::SOME(defId);
      },
      Analyzer::Type::Enum(defId) -> {
        nominalOpt = Option::SOME(defId);
      },
      _ -> {},
    };

    let Option::SOME(nominal) = nominalOpt else {
      return;
    };

    if (!CodegenC::hasDropTrait(defStore, nominal)) {
      return;
    }

    let line: String = `    (${destination.toStr()})->__ignis_drop_state = 0;\n`;

    let mut outputRef: &mut String = output;
    outputRef.pushStr(line.toStr());
  }

  function emitUninitializedDropState(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    output: &mut String,
    expression: &String,
    typeId: Analyzer::TypeId,
  ): void {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return;
    };

    let mut nominal: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);
    let mut isRecord: boolean = false;
    let mut isEnum: boolean = false;

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        nominal = defId;
        isRecord = true;
      },
      Analyzer::Type::Enum(defId) -> {
        nominal = defId;
        isEnum = true;
      },
      _ -> {},
    };

    if (!isRecord && !isEnum) {
      return;
    }

    if (CodegenC::hasDropTrait(defStore, nominal)) {
      let line: String = `    (${expression.toStr()}).__ignis_drop_state = 1;\n`;
      let mut outputRef: &mut String = output;
      outputRef.pushStr(line.toStr());

      return;
    }

    if (isEnum) {
      return;
    }

    let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(nominal)) {
      if (let Analyzer::Definition::Record(recordDef) = definition) {
        fields = CodegenC::copyDefIds(&recordDef.fields);
      }
    }

    let mut fieldIndex: u64 = 0;

    while (fieldIndex < fields.length()) {
      let Option::SOME(fieldId) = fields.get(fieldIndex) else {
        fieldIndex += 1;
        continue;
      };

      let Option::SOME(fieldDefinition) = defStore.get(*fieldId) else {
        fieldIndex += 1;
        continue;
      };

      let Analyzer::Definition::Field(fieldDef) = fieldDefinition else {
        fieldIndex += 1;
        continue;
      };

      let fieldType: Analyzer::TypeId = fieldDef.fieldType;
      let index: u32 = fieldDef.index;

      if (Borrowck::needsDropType(defStore, typeStore, fieldType)) {
        let access: String = `${expression.toStr()}.field_${index}`;
        CodegenC::emitUninitializedDropState(defStore, typeStore, output, &access, fieldType);
      }

      fieldIndex += 1;
    }
  }

  /// A builtin operand arrives as a pointer to the value, so reading it needs
  /// a cast and a dereference.
  function builtinRefDeref(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    closures: &CodegenC::ClosureTables,
    expression: &String,
    typeId: Analyzer::TypeId,
  ): String {
    let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, typeId);
    return `*(${target.toStr()}*)(${expression.toStr()})`;
  }

  /// The `std::hash::Hasher` record, which owns every `write*` method the hash
  /// builtin dispatches to.
  function findHasherDef(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
  ): Option<Analyzer::DefinitionId> {
    let mut index: u64 = 0;

    while (index < defStore.length()) {
      let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);

      let Option::SOME(definition) = defStore.get(defId) else {
        index += 1;
        continue;
      };

      if (let Analyzer::Definition::Record(recordDef) = definition) {
        if (let Option::SOME(text) = symbols.resolve(recordDef.name)) {
          if (String::create(text).equals("Hasher")) {
            return Option::SOME(defId);
          }
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// The `Hasher::write*` method for a primitive type, named by the same
  /// mapping the host uses.
  function hasherWriteMethod(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): str {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return "";
    };

    return match (typeNode) {
      Analyzer::Type::BOOLEAN -> "writeBoolean",
      Analyzer::Type::CHAR -> "writeChar",
      Analyzer::Type::I8 -> "writeI8",
      Analyzer::Type::I16 -> "writeI16",
      Analyzer::Type::I32 -> "writeI32",
      Analyzer::Type::I64 -> "writeI64",
      Analyzer::Type::U8 -> "writeByte",
      Analyzer::Type::U16 -> "writeU16",
      Analyzer::Type::U32 -> "writeU32",
      Analyzer::Type::U64 -> "writeU64",
      Analyzer::Type::STR -> "writeStr",
      _ -> "",
    };
  }

  /// Whether `@eq` on this type compares with C `==`.
  function isPrimitiveEqType(
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return false;
    };

    return match (typeNode) {
      Analyzer::Type::BOOLEAN -> true,
      Analyzer::Type::CHAR -> true,
      Analyzer::Type::I8 -> true,
      Analyzer::Type::I16 -> true,
      Analyzer::Type::I32 -> true,
      Analyzer::Type::I64 -> true,
      Analyzer::Type::U8 -> true,
      Analyzer::Type::U16 -> true,
      Analyzer::Type::U32 -> true,
      Analyzer::Type::U64 -> true,
      _ -> false,
    };
  }

  /// The struct one closure signature is represented by. The type store is
  /// deduplicated, so the raw type id identifies the signature uniquely within
  /// this one translation unit.
  function closureStructName(typeId: Analyzer::TypeId): String {
    return `__ignis_closure_t${typeId.raw()}`;
  }

  /// The environment struct a thunk reads its captures out of.
  function closureEnvName(thunk: Analyzer::DefinitionId): String {
    return `__ignis_closure_env_${thunk.raw()}`;
  }

  /// The environment struct name of the function being emitted, when that
  /// function is a thunk the closure prepass registered an environment for.
  function currentEnvName(
    closures: &CodegenC::ClosureTables,
    defId: Analyzer::DefinitionId,
  ): Option<String> {
    let mut index: u64 = 0;

    while (index < closures.envs.length()) {
      if (let Option::SOME(env) = closures.envs.get(index)) {
        if (env.thunk == defId.raw()) {
          return Option::SOME(CodegenC::closureEnvName(defId));
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// Whether an operand is the `*u8` environment pointer a thunk receives.
  /// Reading a field out of it needs the environment struct type back, which
  /// the pointer itself does not carry.
  function operandIsEnvironmentPointer(
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): boolean {
    let Option::SOME(typeId) = CodegenC::operandType(function_, operand) else {
      return false;
    };

    let mut pointee: Option<Analyzer::TypeId> = Option::NONE;

    if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
      if (let Analyzer::Type::Pointer(pointerType) = typeNode) {
        pointee = Option::SOME(pointerType.pointee);
      }
    }

    let Option::SOME(pointeeType) = pointee else {
      return false;
    };

    let Option::SOME(pointeeNode) = typeStore.get(pointeeType) else {
      return false;
    };

    return match (pointeeNode) {
      Analyzer::Type::U8 -> true,
      _ -> false,
    };
  }

  /// The type an operand evaluates to, as far as the emitter can tell. A
  /// function or global reference has no type here; the caller only asks for
  /// closure captures, which are never either.
  function operandType(
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): Option<Analyzer::TypeId> {
    match (operand) {
      Lir::Operand::Temp(temp) -> {
        if (let Option::SOME(data) = function_.temps.get(temp.raw() as u64)) {
          return Option::SOME(data.ty);
        }
      },
      Lir::Operand::Local(local) -> {
        if (let Option::SOME(data) = function_.locals.get(local.raw() as u64)) {
          return Option::SOME(data.ty);
        }
      },
      Lir::Operand::Const(value) -> {
        return Option::SOME(Lir::constValueType(&value));
      },
      _ -> {},
    };

    return Option::NONE;
  }

  /// How an indexed base reaches its elements: a slice value carries them in
  /// its `data` member, a pointer or reference to one reaches that member
  /// through an arrow, and anything else indexes directly.
  enum SliceBaseShape {
    Value,
    Indirect,
    NotASlice,
  }

  function sliceBaseShape(
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): CodegenC::SliceBaseShape {
    let Option::SOME(typeId) = CodegenC::operandType(function_, operand) else {
      return CodegenC::SliceBaseShape::NotASlice;
    };

    let mut innerType: Option<Analyzer::TypeId> = Option::NONE;

    if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
      match (typeNode) {
        Analyzer::Type::Slice(_) -> {
          return CodegenC::SliceBaseShape::Value;
        },
        Analyzer::Type::Pointer(pointer) -> {
          innerType = Option::SOME(pointer.pointee);
        },
        Analyzer::Type::Reference(reference) -> {
          innerType = Option::SOME(reference.referent);
        },
        _ -> {},
      };
    }

    let Option::SOME(inner) = innerType else {
      return CodegenC::SliceBaseShape::NotASlice;
    };

    if (let Option::SOME(innerNode) = typeStore.get(inner)) {
      if (let Analyzer::Type::Slice(_) = innerNode) {
        return CodegenC::SliceBaseShape::Indirect;
      }
    }

    return CodegenC::SliceBaseShape::NotASlice;
  }

  function isEqualityOperation(op: &Hir::BinaryOperation): boolean {
    return match (op) {
      Hir::BinaryOperation::Equal | Hir::BinaryOperation::NotEqual -> true,
      _ -> false,
    };
  }

  /// Whether an operand is an enum none of whose variants carries a payload.
  function isUnitEnumOperand(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): boolean {
    let Option::SOME(typeId) = CodegenC::operandType(function_, operand) else {
      return false;
    };

    let mut enumDefId: Option<Analyzer::DefinitionId> = Option::NONE;

    if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
      if (let Analyzer::Type::Enum(defId) = typeNode) {
        enumDefId = Option::SOME(defId);
      }
    }

    let Option::SOME(defId) = enumDefId else {
      return false;
    };

    let mut variants: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(defId)) {
      if (let Analyzer::Definition::Enum(enumDef) = definition) {
        variants = CodegenC::copyDefIds(&enumDef.variants);
      }
    }

    let mut variantIndex: u64 = 0;

    while (variantIndex < variants.length()) {
      let Option::SOME(variantId) = variants.get(variantIndex) else {
        variantIndex += 1;
        continue;
      };

      if (let Option::SOME(variantDefinition) = defStore.get(*variantId)) {
        if (let Analyzer::Definition::Variant(variantDef) = variantDefinition) {
          if (variantDef.payload.length() > 0) {
            return false;
          }
        }
      }

      variantIndex += 1;
    }

    return true;
  }

  /// The C name of the drop-glue helper for a type. The type store is
  /// deduplicated, so the raw type id already identifies the type uniquely
  /// within one translation unit.
  function dropGlueName(typeId: Analyzer::TypeId): String {
    return `ignis_drop_glue_t${typeId.raw()}`;
  }

  /// The C expression for the largest value a numeric type holds. A
  /// non-numeric type cannot reach `@maxOf`, so the fallback only keeps the
  /// emitter total.
  function typeMaxValue(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): str {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return "0";
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> "INT8_MAX",
      Analyzer::Type::I16 -> "INT16_MAX",
      Analyzer::Type::I32 -> "INT32_MAX",
      Analyzer::Type::I64 -> "INT64_MAX",
      Analyzer::Type::U8 -> "UINT8_MAX",
      Analyzer::Type::U16 -> "UINT16_MAX",
      Analyzer::Type::U32 -> "UINT32_MAX",
      Analyzer::Type::U64 -> "UINT64_MAX",
      Analyzer::Type::F32 -> "FLT_MAX",
      Analyzer::Type::F64 -> "DBL_MAX",
      _ -> "0",
    };
  }

  /// The C expression for the smallest value a numeric type holds.
  function typeMinValue(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): str {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return "0";
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> "INT8_MIN",
      Analyzer::Type::I16 -> "INT16_MIN",
      Analyzer::Type::I32 -> "INT32_MIN",
      Analyzer::Type::I64 -> "INT64_MIN",
      Analyzer::Type::U8 -> "((u8)0)",
      Analyzer::Type::U16 -> "((u16)0)",
      Analyzer::Type::U32 -> "((u32)0)",
      Analyzer::Type::U64 -> "((u64)0)",
      Analyzer::Type::F32 -> "(-FLT_MAX)",
      Analyzer::Type::F64 -> "(-DBL_MAX)",
      _ -> "0",
    };
  }

  /// The variant name of an instruction, so the unsupported counter says what
  /// is still missing instead of only how much.
  function instructionName(instruction: &Lir::Instr): str {
    return match (instruction) {
      Lir::Instr::Load(_) -> "Load",
      Lir::Instr::Store(_) -> "Store",
      Lir::Instr::LoadPtr(_) -> "LoadPtr",
      Lir::Instr::StorePtr(_) -> "StorePtr",
      Lir::Instr::BuiltinLoad(_) -> "BuiltinLoad",
      Lir::Instr::BuiltinStore(_) -> "BuiltinStore",
      Lir::Instr::BuiltinHash(_) -> "BuiltinHash",
      Lir::Instr::BuiltinEq(_) -> "BuiltinEq",
      Lir::Instr::Copy(_) -> "Copy",
      Lir::Instr::BinOp(_) -> "BinOp",
      Lir::Instr::UnaryOp(_) -> "UnaryOp",
      Lir::Instr::Call(_) -> "Call",
      Lir::Instr::Cast(_) -> "Cast",
      Lir::Instr::BitCast(_) -> "BitCast",
      Lir::Instr::AddrOfLocal(_) -> "AddrOfLocal",
      Lir::Instr::GetElementPtr(_) -> "GetElementPtr",
      Lir::Instr::MakeSlice(_) -> "MakeSlice",
      Lir::Instr::InitVector(_) -> "InitVector",
      Lir::Instr::Nop -> "Nop",
      Lir::Instr::RuntimeCall(_) -> "RuntimeCall",
      Lir::Instr::TypeIdOf(_) -> "TypeIdOf",
      Lir::Instr::SizeOf(_) -> "SizeOf",
      Lir::Instr::AlignOf(_) -> "AlignOf",
      Lir::Instr::MaxOf(_) -> "MaxOf",
      Lir::Instr::MinOf(_) -> "MinOf",
      Lir::Instr::Trap(_) -> "Trap",
      Lir::Instr::PanicMessage(_) -> "PanicMessage",
      Lir::Instr::Drop(_) -> "Drop",
      Lir::Instr::GetFieldPtr(_) -> "GetFieldPtr",
      Lir::Instr::InitRecord(_) -> "InitRecord",
      Lir::Instr::InitEnumVariant(_) -> "InitEnumVariant",
      Lir::Instr::EnumGetTag(_) -> "EnumGetTag",
      Lir::Instr::EnumGetPayloadField(_) -> "EnumGetPayloadField",
      Lir::Instr::DropInPlace(_) -> "DropInPlace",
      Lir::Instr::MarkMoved(_) -> "MarkMoved",
      Lir::Instr::DropGlue(_) -> "DropGlue",
      Lir::Instr::MakeClosure(_) -> "MakeClosure",
      Lir::Instr::CallClosure(_) -> "CallClosure",
      Lir::Instr::DropClosure(_) -> "DropClosure",
    };
  }

  /// One instruction. Anything the emitter cannot express yet leaves a comment
  /// naming it and bumps the counter, so a corpus run measures what is left.
  function emitInstruction(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    unsupported: &mut u64,
    closures: &CodegenC::ClosureTables,
    function_: &Lir::FunctionLir,
    instruction: &Lir::Instr,
  ): void {
    match (instruction) {
      Lir::Instr::Load(node) -> {
        let line: String = `    t${node.dest.raw()} = l${node.source.raw()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::Store(node) -> {
        let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.value);
        let mut line: String = `    l${node.dest.raw()} = ${value.toStr()};\n`;

        if (let Option::SOME(data) = function_.locals.get(node.dest.raw() as u64)) {
          if (let Option::SOME(array) = CodegenC::fixedArrayShape(typeStore, data.ty)) {
            let elementText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, array.element);
            line = `    memcpy(l${node.dest.raw()}, ${value.toStr()}, ${array.size} * sizeof(${elementText.toStr()}));\n`;
          }
        }

        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::LoadPtr(node) -> {
        let pointer: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.ptr);
        let line: String = `    t${node.dest.raw()} = *${pointer.toStr()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::StorePtr(node) -> {
        let pointer: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.ptr);
        let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.value);
        let line: String = `    *${pointer.toStr()} = ${value.toStr()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::Copy(node) -> {
        let source: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.source);
        let line: String = `    t${node.dest.raw()} = ${source.toStr()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::BinOp(node) -> {
        let operator: str = CodegenC::binaryOperator(&node.op);

        if (String::create(operator).length() == 0) {
          let mut powRef: &mut u64 = unsupported;
          powRef += 1;

          let mut outputRef: &mut String = output;
          outputRef.pushStr("    // unsupported: BinOp Pow\n");
        } else {
          let left: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.left);
          let right: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.right);
          // Equality on a payload-free enum compares tags: the C struct has
          // no `==` of its own.
          let mut tagSuffix: str = "";

          if (CodegenC::isEqualityOperation(&node.op) && CodegenC::isUnitEnumOperand(defStore, typeStore, function_, &node.left)) {
            tagSuffix = ".tag";
          }

          let line: String = `    t${node.dest.raw()} = ${left.toStr()}${tagSuffix} ${operator} ${right.toStr()}${tagSuffix};\n`;
          let mut outputRef: &mut String = output;
          outputRef.pushStr(line.toStr());
        }
      },
      Lir::Instr::UnaryOp(node) -> {
        let operator: str = CodegenC::unaryOperator(&node.op);
        let operand: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.operand);
        let line: String = `    t${node.dest.raw()} = ${operator}${operand.toStr()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::Cast(node) -> {
        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.targetType);
        let source: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.source);
        let line: String = `    t${node.dest.raw()} = (${target.toStr()})${source.toStr()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::AddrOfLocal(node) -> {
        let mut line: String = `    t${node.dest.raw()} = &l${node.local.raw()};\n`;

        // An array local's name already decays to the pointer.
        if (let Option::SOME(data) = function_.locals.get(node.local.raw() as u64)) {
          if (CodegenC::fixedArrayShape(typeStore, data.ty).isSome()) {
            line = `    t${node.dest.raw()} = l${node.local.raw()};\n`;
          }
        }

        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::GetFieldPtr(node) -> {
        let base: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.base);
        let mut line: String = `    t${node.dest.raw()} = &((${base.toStr()})->field_${node.fieldIndex});\n`;

        if (CodegenC::operandIsEnvironmentPointer(typeStore, function_, &node.base)) {
          if (let Option::SOME(envName) = CodegenC::currentEnvName(closures, function_.defId)) {
            line = `    t${node.dest.raw()} = &(((struct ${envName.toStr()}*)${base.toStr()})->field_${node.fieldIndex});\n`;
          }
        }

        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::GetElementPtr(node) -> {
        let base: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.base);
        let index: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.index);

        // A slice is a struct, so the element lives behind its `data` member
        // rather than at the struct itself. An array or pointer base indexes
        // directly.
        let sliceBase: CodegenC::SliceBaseShape = CodegenC::sliceBaseShape(typeStore, function_, &node.base);

        let line: String = match (sliceBase) {
          CodegenC::SliceBaseShape::Value -> `    t${node.dest.raw()} = &((${base.toStr()}).data[${index.toStr()}]);\n`,
          CodegenC::SliceBaseShape::Indirect -> `    t${node.dest.raw()} = &((${base.toStr()})->data[${index.toStr()}]);\n`,
          CodegenC::SliceBaseShape::NotASlice -> `    t${node.dest.raw()} = &(${base.toStr()}[${index.toStr()}]);\n`,
        };

        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::EnumGetTag(node) -> {
        let source: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.source);
        let line: String = `    t${node.dest.raw()} = (${source.toStr()}).tag;\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::EnumGetPayloadField(node) -> {
        let source: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.source);
        let line: String = `    t${node.dest.raw()} = (${source.toStr()}).payload.variant_${node.variantTag}.field_${node.fieldIndex};\n`;

        if (!CodegenC::tempIsVoid(typeStore, function_, node.dest)) {
          let mut outputRef: &mut String = output;
          outputRef.pushStr(line.toStr());
        }
      },
      Lir::Instr::InitEnumVariant(node) -> {
        let destination: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.destPtr);
        // A variant fills only its own payload; the rest of the union stays
        // whatever the slot held before, so the whole value is cleared first.
        let clear: String = `    __builtin_memset((void*)${destination.toStr()}, 0, sizeof(*${destination.toStr()}));\n`;
        let header: String = `    (${destination.toStr()})->tag = ${node.variantTag}U;\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(clear.toStr());
        outputRef.pushStr(header.toStr());

        let mut payloadIndex: u64 = 0;
        let mut fieldIndex: u64 = 0;

        while (payloadIndex < node.payload.length()) {
          if (let Option::SOME(payloadOperand) = node.payload.get(payloadIndex)) {
            if (!CodegenC::operandIsVoid(typeStore, function_, payloadOperand)) {
              let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, payloadOperand);
              let line: String = `    (${destination.toStr()})->payload.variant_${node.variantTag}.field_${fieldIndex} = ${value.toStr()};\n`;
              let mut payloadRef: &mut String = output;
              payloadRef.pushStr(line.toStr());
              fieldIndex += 1;
            }
          }

          payloadIndex += 1;
        }

        CodegenC::emitInitializedDropState(defStore, typeStore, output, &destination, node.enumType);
      },
      Lir::Instr::InitRecord(node) -> {
        let destination: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.destPtr);
        let mut fieldIndex: u64 = 0;

        while (fieldIndex < node.fields.length()) {
          if (let Option::SOME(field) = node.fields.get(fieldIndex)) {
            let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &field.value);
            let line: String = `    (${destination.toStr()})->field_${field.fieldIndex} = ${value.toStr()};\n`;
            let mut fieldRef: &mut String = output;
            fieldRef.pushStr(line.toStr());
          }

          fieldIndex += 1;
        }

        CodegenC::emitInitializedDropState(defStore, typeStore, output, &destination, node.recordType);
      },
      Lir::Instr::Call(node) -> {
        let callee: String = CodegenC::mangledName(defStore, symbols, node.callee);
        let calleeIsExtern: boolean = CodegenC::isExternFunction(defStore, node.callee);

        let mut call: String = String::create("    ");

        if (let Option::SOME(dest) = node.dest) {
          if (!CodegenC::tempIsVoid(typeStore, function_, dest)) {
            let assignment: String = `t${dest.raw()} = `;
            call.pushStr(assignment.toStr());
          }
        }

        call.pushStr(callee.toStr());
        call.pushStr("(");

        let mut argIndex: u64 = 0;

        while (argIndex < node.args.length()) {
          if (let Option::SOME(argument) = node.args.get(argIndex)) {
            if (argIndex > 0) {
              call.pushStr(", ");
            }

            let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, argument);

            // A runtime function spells its parameters with the header's own C
            // tags, which are structurally identical to the emitter's record
            // structs but named differently. Passing through `void*` is what
            // the host does for the same reason.
            if (calleeIsExtern && CodegenC::operandIsIndirect(typeStore, function_, argument)) {
              call.pushStr("(void*)");
            }

            call.pushStr(value.toStr());
          }

          argIndex += 1;
        }

        call.pushStr(");\n");

        let mut outputRef: &mut String = output;
        outputRef.pushStr(call.toStr());
      },
      Lir::Instr::PanicMessage(node) -> {
        let escaped: String = CodegenC::escapeStringLiteral(&node.message);
        let line: String = `    fprintf(stderr, "panic: %s\\n", "${escaped.toStr()}");\n    exit(101);\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::Trap(_) -> {
        let mut outputRef: &mut String = output;
        outputRef.pushStr("    __builtin_trap();\n");
      },
      Lir::Instr::Nop -> {
        let mut outputRef: &mut String = output;
        outputRef.pushStr("    /* nop */\n");
      },
      Lir::Instr::BuiltinLoad(node) -> {
        let pointer: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.ptr);
        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.ty);
        let line: String = `    t${node.dest.raw()} = *(${target.toStr()}*)(${pointer.toStr()});\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::BuiltinStore(node) -> {
        let pointer: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.ptr);
        let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.value);
        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.ty);
        let line: String = `    *(${target.toStr()}*)(${pointer.toStr()}) = ${value.toStr()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::BitCast(node) -> {
        // The Rust emitter also guards the copy with a `_Static_assert` on the
        // two sizes. That needs the source operand's type, which this emitter
        // cannot resolve yet, so the copy is sized by the destination alone.
        let source: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.source);
        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.targetType);
        let line: String = `    memcpy(&t${node.dest.raw()}, &${source.toStr()}, sizeof(${target.toStr()}));\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::MakeSlice(node) -> {
        let data: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.data);
        let length: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.len);

        let mut sliceType: String = String::create("void*");

        if (let Option::SOME(temp) = function_.temps.get(node.dest.raw() as u64)) {
          sliceType = CodegenC::formatCType(defStore, typeStore, symbols, closures, temp.ty);
        }

        let mut line: String = `    t${node.dest.raw()} = (${sliceType.toStr()})`;
        line.pushStr("{ .data = ");
        line.pushStr(data.toStr());
        line.pushStr(", .len = ");
        line.pushStr(length.toStr());
        line.pushStr(" };\n");

        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::InitVector(node) -> {
        let destination: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.destPtr);
        let mut elementIndex: u64 = 0;

        while (elementIndex < node.elements.length()) {
          if (let Option::SOME(element) = node.elements.get(elementIndex)) {
            let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, element);
            let line: String = `    ${destination.toStr()}[${elementIndex}] = ${value.toStr()};\n`;
            let mut elementRef: &mut String = output;
            elementRef.pushStr(line.toStr());
          }

          elementIndex += 1;
        }
      },
      Lir::Instr::RuntimeCall(node) -> {
        let mut call: String = String::create("    ");
        call.pushStr(node.name.toStr());
        call.pushStr("(");

        let mut argIndex: u64 = 0;

        while (argIndex < node.args.length()) {
          if (let Option::SOME(argument) = node.args.get(argIndex)) {
            if (argIndex > 0) {
              call.pushStr(", ");
            }

            let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, argument);
            call.pushStr(value.toStr());
          }

          argIndex += 1;
        }

        call.pushStr(");\n");

        let mut outputRef: &mut String = output;
        outputRef.pushStr(call.toStr());
      },
      Lir::Instr::SizeOf(node) -> {
        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.ty);
        let line: String = `    t${node.dest.raw()} = sizeof(${target.toStr()});\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::AlignOf(node) -> {
        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.ty);
        let line: String = `    t${node.dest.raw()} = _Alignof(${target.toStr()});\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::MaxOf(node) -> {
        let bound: str = CodegenC::typeMaxValue(typeStore, node.ty);
        let line: String = `    t${node.dest.raw()} = ${bound};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::MakeClosure(node) -> {
        let envName: String = CodegenC::closureEnvName(node.thunk);
        let closureType: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.closureType);
        let thunkName: String = CodegenC::mangledName(defStore, symbols, node.thunk);

        let mut envPointer: String = String::create("");

        if (node.heapAllocate) {
          let allocation: String = `    struct ${envName.toStr()}* __envp_t${node.dest.raw()} = (struct ${envName.toStr()}*)malloc(sizeof(struct ${envName.toStr()}));\n`;

          let mut allocationRef: &mut String = output;
          allocationRef.pushStr(allocation.toStr());

          envPointer = `(u8*)__envp_t${node.dest.raw()}`;
        } else {
          let declaration: String = `    struct ${envName.toStr()} __env_t${node.dest.raw()};\n`;

          let mut declarationRef: &mut String = output;
          declarationRef.pushStr(declaration.toStr());

          envPointer = `(u8*)&__env_t${node.dest.raw()}`;
        }

        let mut captureIndex: u64 = 0;

        while (captureIndex < node.captures.length()) {
          if (let Option::SOME(capture) = node.captures.get(captureIndex)) {
            let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, capture);

            let mut line: String = String::create("");

            if (node.heapAllocate) {
              line = `    __envp_t${node.dest.raw()}->field_${captureIndex} = ${value.toStr()};\n`;
            } else {
              line = `    __env_t${node.dest.raw()}.field_${captureIndex} = ${value.toStr()};\n`;
            }

            let mut captureRef: &mut String = output;
            captureRef.pushStr(line.toStr());
          }

          captureIndex += 1;
        }

        // The thunk is declared with the callee's own parameter types, so the
        // cast to the struct's `call` slot has to spell the erased shape.
        let mut callParams: String = String::create("u8*");
        let mut returnText: String = String::create("void");

        if (let Option::SOME(typeNode) = typeStore.get(node.closureType)) {
          if (let Analyzer::Type::Function(functionType) = typeNode) {
            returnText = CodegenC::formatCType(defStore, typeStore, symbols, closures, functionType.returnType);

            let params: Vector<Analyzer::TypeId> = CodegenC::copyTypeIds(&functionType.params);
            let mut paramIndex: u64 = 0;

            while (paramIndex < params.length()) {
              if (let Option::SOME(paramType) = params.get(paramIndex)) {
                let text: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, *paramType);
                callParams.pushStr(", ");
                callParams.pushStr(text.toStr());
              }

              paramIndex += 1;
            }
          }
        }

        let mut dropExpression: String = String::create("NULL");

        if (let Option::SOME(dropId) = node.dropFn) {
          let dropName: String = CodegenC::mangledName(defStore, symbols, dropId);
          dropExpression = `(void(*)(u8*))${dropName.toStr()}`;
        }

        let mut value: String = `    t${node.dest.raw()} = (${closureType.toStr()})`;
        value.pushStr("{ (");
        value.pushStr(returnText.toStr());
        value.pushStr("(*)(");
        value.pushStr(callParams.toStr());
        value.pushStr("))");
        value.pushStr(thunkName.toStr());
        value.pushStr(", ");
        value.pushStr(dropExpression.toStr());
        value.pushStr(", ");
        value.pushStr(envPointer.toStr());
        value.pushStr(" };\n");

        let mut valueRef: &mut String = output;
        valueRef.pushStr(value.toStr());
      },
      Lir::Instr::CallClosure(node) -> {
        let closure: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.closure);

        let mut call: String = String::create("    ");

        if (let Option::SOME(dest) = node.dest) {
          if (!CodegenC::tempIsVoid(typeStore, function_, dest)) {
            let assignment: String = `t${dest.raw()} = `;
            call.pushStr(assignment.toStr());
          }
        }

        let head: String = `${closure.toStr()}.call(${closure.toStr()}.env`;
        call.pushStr(head.toStr());

        let mut argIndex: u64 = 0;

        while (argIndex < node.args.length()) {
          if (let Option::SOME(argument) = node.args.get(argIndex)) {
            let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, argument);
            call.pushStr(", ");
            call.pushStr(value.toStr());
          }

          argIndex += 1;
        }

        call.pushStr(");\n");

        let mut outputRef: &mut String = output;
        outputRef.pushStr(call.toStr());
      },
      Lir::Instr::DropClosure(node) -> {
        let closure: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.closure);

        let guard: String = `    if (${closure.toStr()}.drop_fn) ${closure.toStr()}.drop_fn(${closure.toStr()}.env);\n`;

        let mut guardRef: &mut String = output;
        guardRef.pushStr(guard.toStr());

        if (node.heapAllocated) {
          let release: String = `    if (${closure.toStr()}.env) free(${closure.toStr()}.env);\n`;

          let mut releaseRef: &mut String = output;
          releaseRef.pushStr(release.toStr());
        }
      },
      Lir::Instr::BuiltinEq(node) -> {
        let left: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.left);
        let right: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.right);

        let mut line: String = String::create("");

        match (&node.kind) {
          Lir::BuiltinEqKind::Primitive -> {
            if (CodegenC::isPrimitiveEqType(typeStore, node.ty)) {
              let leftValue: String = CodegenC::builtinRefDeref(defStore, typeStore, symbols, closures, &left, node.ty);
              let rightValue: String = CodegenC::builtinRefDeref(defStore, typeStore, symbols, closures, &right, node.ty);
              line = `    t${node.dest.raw()} = ${leftValue.toStr()} == ${rightValue.toStr()};\n`;
            }
          },
          Lir::BuiltinEqKind::Str -> {
            let leftValue: String = CodegenC::builtinRefDeref(defStore, typeStore, symbols, closures, &left, node.ty);
            let rightValue: String = CodegenC::builtinRefDeref(defStore, typeStore, symbols, closures, &right, node.ty);
            line = `    t${node.dest.raw()} = strcmp(${leftValue.toStr()}, ${rightValue.toStr()}) == 0;\n`;
          },
          Lir::BuiltinEqKind::Method(methodId) -> {
            let name: String = CodegenC::mangledName(defStore, symbols, methodId);
            line = `    t${node.dest.raw()} = ${name.toStr()}(${left.toStr()}, ${right.toStr()});\n`;
          },
        };

        if (line.length() == 0) {
          let mut countRef: &mut u64 = unsupported;
          countRef += 1;

          let mut skipRef: &mut String = output;
          skipRef.pushStr("    // unsupported instruction: BuiltinEq\n");

          return;
        }

        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::BuiltinHash(node) -> {
        let value: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.value);
        let hasher: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.hasher);

        let writeMethod: str = CodegenC::hasherWriteMethod(typeStore, node.ty);

        if (String::create(writeMethod).length() > 0) {
          let mut hasherDef: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);
          let mut found: boolean = false;

          if (let Option::SOME(defId) = CodegenC::findHasherDef(defStore, symbols)) {
            hasherDef = defId;
            found = true;
          }

          if (found) {
            if (let Option::SOME(methodId) = CodegenC::findNamedInstanceMethod(defStore, symbols, hasherDef, writeMethod)) {
              let name: String = CodegenC::mangledName(defStore, symbols, methodId);
              let argument: String = CodegenC::builtinRefDeref(defStore, typeStore, symbols, closures, &value, node.ty);
              let line: String = `    ${name.toStr()}(${hasher.toStr()}, ${argument.toStr()});\n`;

              let mut outputRef: &mut String = output;
              outputRef.pushStr(line.toStr());

              return;
            }
          }
        } else {
          let mut nominal: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);
          let mut isNominal: boolean = false;

          if (let Option::SOME(typeNode) = typeStore.get(node.ty)) {
            match (typeNode) {
              Analyzer::Type::Record(defId) -> {
                nominal = defId;
                isNominal = true;
              },
              Analyzer::Type::Enum(defId) -> {
                nominal = defId;
                isNominal = true;
              },
              _ -> {},
            };
          }

          if (isNominal) {
            if (let Option::SOME(methodId) = CodegenC::findNamedInstanceMethod(defStore, symbols, nominal, "hash")) {
              let name: String = CodegenC::mangledName(defStore, symbols, methodId);
              let line: String = `    ${name.toStr()}(${value.toStr()}, ${hasher.toStr()});\n`;

              let mut outputRef: &mut String = output;
              outputRef.pushStr(line.toStr());

              return;
            }
          }
        }

        let mut countRef: &mut u64 = unsupported;
        countRef += 1;

        let mut skipRef: &mut String = output;
        skipRef.pushStr("    // unsupported instruction: BuiltinHash\n");
      },
      Lir::Instr::Drop(node) -> {
        let Option::SOME(local) = function_.locals.get(node.local.raw() as u64) else {
          return;
        };

        if (local.borrowedAlias) {
          let line: String = `    /* drop l${node.local.raw()}: borrowed alias */\n`;
          let mut aliasRef: &mut String = output;
          aliasRef.pushStr(line.toStr());

          return;
        }

        let localType: Analyzer::TypeId = local.ty;
        let access: String = `l${node.local.raw()}`;

        CodegenC::emitFieldDrops(defStore, typeStore, symbols, output, closures, &access, localType);
      },
      Lir::Instr::DropInPlace(node) -> {
        let pointer: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.ptr);

        if (!Borrowck::needsDropType(defStore, typeStore, node.ty)) {
          let line: String = `    (void)${pointer.toStr()}; /* drop_in_place: no-op */\n`;
          let mut skipRef: &mut String = output;
          skipRef.pushStr(line.toStr());

          return;
        }

        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.ty);
        let open: String = `    { ${target.toStr()}* __dip = (${target.toStr()}*)${pointer.toStr()}; (void)__dip;\n`;

        let mut openRef: &mut String = output;
        openRef.pushStr(open.toStr());

        let access: String = String::create("(*__dip)");
        CodegenC::emitFieldDrops(defStore, typeStore, symbols, output, closures, &access, node.ty);

        let mut closeRef: &mut String = output;
        closeRef.pushStr("    }\n");
      },
      Lir::Instr::MarkMoved(node) -> {
        let pointer: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &node.ptr);

        if (!Borrowck::needsDropType(defStore, typeStore, node.ty)) {
          let line: String = `    (void)${pointer.toStr()}; /* mark_moved: no-op */\n`;
          let mut skipRef: &mut String = output;
          skipRef.pushStr(line.toStr());

          return;
        }

        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, node.ty);
        let open: String = `    { ${target.toStr()}* __moved = (${target.toStr()}*)${pointer.toStr()}; (void)__moved;\n`;

        let mut openRef: &mut String = output;
        openRef.pushStr(open.toStr());

        let access: String = String::create("(*__moved)");
        CodegenC::emitUninitializedDropState(defStore, typeStore, output, &access, node.ty);

        let mut closeRef: &mut String = output;
        closeRef.pushStr("    }\n");
      },
      Lir::Instr::DropGlue(node) -> {
        // The runtime takes glue through an opaque `void*` and casts it back to
        // `IgnisDropFn` itself.
        let glue: String = CodegenC::dropGlueName(node.ty);
        let line: String = `    t${node.dest.raw()} = (void*)${glue.toStr()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Instr::MinOf(node) -> {
        let bound: str = CodegenC::typeMinValue(typeStore, node.ty);
        let line: String = `    t${node.dest.raw()} = ${bound};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      _ -> {
        let mut countRef: &mut u64 = unsupported;
        countRef += 1;

        let name: str = CodegenC::instructionName(instruction);
        let line: String = `    // unsupported instruction: ${name}\n`;

        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
    };
  }

  function emitTerminator(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    function_: &Lir::FunctionLir,
    closures: &CodegenC::ClosureTables,
    terminator: &Lir::Terminator,
  ): void {
    match (terminator) {
      Lir::Terminator::Goto(target) -> {
        let mut label: String = String::create("block");

        if (let Option::SOME(block) = function_.blocks.get(target.raw() as u64)) {
          label = String::create(block.label.toStr());
        }

        let line: String = `    goto ${label.toStr()}_${target.raw()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Terminator::Branch(branch) -> {
        let condition: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &branch.condition);

        let mut thenLabel: String = String::create("block");
        let mut elseLabel: String = String::create("block");

        if (let Option::SOME(block) = function_.blocks.get(branch.thenBlock.raw() as u64)) {
          thenLabel = String::create(block.label.toStr());
        }

        if (let Option::SOME(block) = function_.blocks.get(branch.elseBlock.raw() as u64)) {
          elseLabel = String::create(block.label.toStr());
        }

        let line: String = `    if (${condition.toStr()}) goto ${thenLabel.toStr()}_${branch.thenBlock.raw()}; else goto ${elseLabel.toStr()}_${branch.elseBlock.raw()};\n`;
        let mut outputRef: &mut String = output;
        outputRef.pushStr(line.toStr());
      },
      Lir::Terminator::Return(value) -> {
        let mut outputRef: &mut String = output;

        if (let Option::SOME(operand) = value) {
          let text: String = CodegenC::formatOperand(defStore, typeStore, symbols, closures, &operand);
          let line: String = `    return ${text.toStr()};\n`;
          outputRef.pushStr(line.toStr());
        } else {
          outputRef.pushStr("    return;\n");
        }
      },
      // A block the verifier proved unreachable still needs an exit in C.
      Lir::Terminator::Unreachable -> {
        let mut outputRef: &mut String = output;
        outputRef.pushStr("    __builtin_unreachable();\n");
      },
    };
  }

  /// The record and enum definitions the program needs, in an order C accepts:
  /// a struct holding another by value has to come after it.
  ///
  /// Definition order is not that order. Monomorphization reserves a
  /// container's id before concretizing its fields, so a specialization used
  /// by value always lands on a higher id than the type holding it.
  function orderedTypeDefs(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
  ): Vector<Analyzer::DefinitionId> {
    let mut ordered: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut emitted: Vector<u32> = Vector::new<u32>();
    let mut visiting: Vector<u32> = Vector::new<u32>();

    let mut rawId: u64 = 0;

    while (rawId < defStore.length()) {
      let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(rawId as u32);

      CodegenC::visitTypeDef(defStore, typeStore, &mut ordered, &mut emitted, &mut visiting, defId);

      rawId += 1;
    }

    return ordered;
  }

  /// One struct definition. A record lays its fields out in order; an enum is
  /// a tag plus a union of the variants that carry a payload. Both grow a drop
  /// state byte when the type owns resources, matching the layout the runtime
  /// and the drop paths expect.
  function emitTypeDefinition(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    closures: &CodegenC::ClosureTables,
    defId: Analyzer::DefinitionId,
  ): void {
    let name: String = CodegenC::structName(defStore, symbols, defId);

    let mut isRecord: boolean = false;
    let mut isEnum: boolean = false;
    let mut implementsDrop: boolean = false;
    let mut layoutAttributes: String = String::new();
    let mut members: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(defId)) {
      match (definition) {
        Analyzer::Definition::Record(recordDef) -> {
          isRecord = true;
          implementsDrop = recordDef.implementsDrop;
          layoutAttributes = CodegenC::recordLayoutAttributes(recordDef.packed, recordDef.alignment);
          members = CodegenC::copyDefIds(&recordDef.fields);
        },
        Analyzer::Definition::Enum(enumDef) -> {
          isEnum = true;
          implementsDrop = enumDef.implementsDrop;
          members = CodegenC::copyDefIds(&enumDef.variants);
        },
        _ -> {},
      };
    }

    let mut outputRef: &mut String = output;

    if (isRecord) {
      outputRef.pushStr("struct ");
      outputRef.pushStr(name.toStr());
      outputRef.pushStr(" {\n");

      let mut wroteField: boolean = false;
      let mut index: u64 = 0;

      while (index < members.length()) {
        let Option::SOME(fieldDefId) = members.get(index) else {
          index += 1;
          continue;
        };

        if (let Option::SOME(fieldDefinition) = defStore.get(*fieldDefId)) {
          if (let Analyzer::Definition::Field(fieldDef) = fieldDefinition) {
            let fieldType: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, fieldDef.fieldType);
            let fieldAttributes: String = CodegenC::fieldLayoutAttributes(fieldDef.alignment);
            let line: String = `    ${fieldType.toStr()} field_${fieldDef.index}${fieldAttributes.toStr()};\n`;

            let mut fieldRef: &mut String = output;
            fieldRef.pushStr(line.toStr());
            wroteField = true;
          }
        }

        index += 1;
      }

      let mut tailRef: &mut String = output;

      if (implementsDrop) {
        tailRef.pushStr("    uint8_t __ignis_drop_state;\n");
        wroteField = true;
      }

      // C rejects an empty struct.
      if (!wroteField) {
        tailRef.pushStr("    char _empty;\n");
      }

      tailRef.pushStr("}");
      tailRef.pushStr(layoutAttributes.toStr());
      tailRef.pushStr(";\n");
      return;
    }

    if (!isEnum) {
      return;
    }

    outputRef.pushStr("struct ");
    outputRef.pushStr(name.toStr());
    outputRef.pushStr(" {\n    u32 tag;\n");

    let mut hasPayload: boolean = false;
    let mut probeIndex: u64 = 0;

    while (probeIndex < members.length()) {
      if (let Option::SOME(variantDefId) = members.get(probeIndex)) {
        if (let Option::SOME(variantDefinition) = defStore.get(*variantDefId)) {
          if (let Analyzer::Definition::Variant(variantDef) = variantDefinition) {
            if (CodegenC::countNonVoid(typeStore, &variantDef.payload) > 0) {
              hasPayload = true;
            }
          }
        }
      }

      probeIndex += 1;
    }

    if (hasPayload) {
      let mut unionRef: &mut String = output;
      unionRef.pushStr("    union {\n");

      let mut variantIndex: u64 = 0;

      while (variantIndex < members.length()) {
        let Option::SOME(variantDefId) = members.get(variantIndex) else {
          variantIndex += 1;
          continue;
        };

        let mut payloadTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
        let mut tagValue: u32 = 0;

        if (let Option::SOME(variantDefinition) = defStore.get(*variantDefId)) {
          if (let Analyzer::Definition::Variant(variantDef) = variantDefinition) {
            tagValue = variantDef.tagValue;

            let mut payloadIndex: u64 = 0;

            // A `void` payload (`Result<void, E>`'s OK) has no C field, as in
            // the host; the remaining fields are numbered without it.
            while (payloadIndex < variantDef.payload.length()) {
              if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
                if (!CodegenC::isVoidType(typeStore, *payloadType)) {
                  payloadTypes.push(*payloadType);
                }
              }

              payloadIndex += 1;
            }
          }
        }

        if (payloadTypes.length() == 0) {
          variantIndex += 1;
          continue;
        }

        let mut structRef: &mut String = output;
        structRef.pushStr("        struct {\n");

        let mut fieldIndex: u64 = 0;

        while (fieldIndex < payloadTypes.length()) {
          if (let Option::SOME(payloadType) = payloadTypes.get(fieldIndex)) {
            let payloadText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, *payloadType);
            let line: String = `            ${payloadText.toStr()} field_${fieldIndex};\n`;

            let mut lineRef: &mut String = output;
            lineRef.pushStr(line.toStr());
          }

          fieldIndex += 1;
        }

        let closing: String = `        } variant_${tagValue};\n`;
        let mut closeRef: &mut String = output;
        closeRef.pushStr(closing.toStr());

        variantIndex += 1;
      }

      let mut endUnionRef: &mut String = output;
      endUnionRef.pushStr("    } payload;\n");
    }

    let mut enumTailRef: &mut String = output;

    if (implementsDrop) {
      enumTailRef.pushStr("    uint8_t __ignis_drop_state;\n");
    }

    enumTailRef.pushStr("};\n");
  }

  /// The `__attribute__` suffix a record's `@packed` / `@aligned(N)` ask the C
  /// struct to carry, in the order the host writes them.
  function recordLayoutAttributes(packed: boolean, alignment: Option<u64>): String {
    let mut text: String = String::new();
    let mut textRef: &mut String = &mut text;

    if (packed) {
      textRef.pushStr(" __attribute__((packed))");
    }

    if (let Option::SOME(value) = alignment) {
      let suffix: String = ` __attribute__((aligned(${value})))`;
      textRef.pushStr(suffix.toStr());
    }

    return text;
  }

  /// The `__attribute__` suffix a field's `@aligned(N)` asks its C member to
  /// carry.
  function fieldLayoutAttributes(alignment: Option<u64>): String {
    let mut text: String = String::new();

    if (let Option::SOME(value) = alignment) {
      let mut textRef: &mut String = &mut text;
      let suffix: String = ` __attribute__((aligned(${value})))`;
      textRef.pushStr(suffix.toStr());
    }

    return text;
  }

  /// Local slots this function drops through an `Instr::Drop`.
  function dropScheduledLocals(function_: &Lir::FunctionLir): Vector<u32> {
    let mut scheduled: Vector<u32> = Vector::new<u32>();
    let mut blockIndex: u64 = 0;

    while (blockIndex < function_.blocks.length()) {
      let Option::SOME(block) = function_.blocks.get(blockIndex) else {
        blockIndex += 1;
        continue;
      };

      let mut instrIndex: u64 = 0;

      while (instrIndex < block.instructions.length()) {
        if (let Option::SOME(instr) = block.instructions.get(instrIndex)) {
          if (let Lir::Instr::Drop(node) = instr) {
            scheduled.push(node.local.raw());
          }
        }

        instrIndex += 1;
      }

      blockIndex += 1;
    }

    return scheduled;
  }

  function containsLocalRaw(locals: &Vector<u32>, raw: u32): boolean {
    let mut index: u64 = 0;

    while (index < locals.length()) {
      if (let Option::SOME(entry) = locals.get(index)) {
        if (*entry == raw) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// Zero every droppable local and mark it dropped before the first block
  /// runs, so a drop that reaches a slot no store initialized is a no-op
  /// instead of a free of stack garbage. Mirrors the oracle's
  /// `emit_locals` prologue.
  function emitUninitializedLocals(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    output: &mut String,
    function_: &Lir::FunctionLir,
  ): void {
    let scheduled: Vector<u32> = CodegenC::dropScheduledLocals(function_);
    let mut localIndex: u64 = 0;

    while (localIndex < function_.locals.length()) {
      let Option::SOME(local) = function_.locals.get(localIndex) else {
        localIndex += 1;
        continue;
      };

      if (local.borrowedAlias || CodegenC::isVoidType(typeStore, local.ty) || CodegenC::fixedArrayShape(typeStore, local.ty).isSome()) {
        localIndex += 1;
        continue;
      }

      let droppable: boolean = CodegenC::containsLocalRaw(&scheduled, localIndex as u32) || Borrowck::needsDropType(defStore, typeStore, local.ty);

      if (!droppable) {
        localIndex += 1;
        continue;
      }

      let access: String = `l${localIndex}`;
      let clear: String = `    __builtin_memset((void*)&${access.toStr()}, 0, sizeof(${access.toStr()}));\n`;

      let mut clearRef: &mut String = output;
      clearRef.pushStr(clear.toStr());

      CodegenC::emitUninitializedDropState(defStore, typeStore, output, &access, local.ty);
      localIndex += 1;
    }
  }

  function emitFunction(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    unsupported: &mut u64,
    closures: &CodegenC::ClosureTables,
    externalSymbols: &Vector<u32>,
    function_: &Lir::FunctionLir,
  ): void {
    let signature: String = CodegenC::functionSignature(defStore, typeStore, symbols, closures, function_);

    let mut headerRef: &mut String = output;

    if (CodegenC::hasInternalLinkage(defStore, function_.defId, externalSymbols)) {
      headerRef.pushStr("static ");
    }

    headerRef.pushStr(signature.toStr());
    headerRef.pushStr(" {\n");

    let mut localIndex: u64 = 0;

    while (localIndex < function_.locals.length()) {
      if (let Option::SOME(local) = function_.locals.get(localIndex)) {
        // A slot holding the result of a void call has no declaration to make.
        // A fixed array is the one local declared with its element type and
        // size, since its uses read it as a decayed pointer.
        if (let Option::SOME(array) = CodegenC::fixedArrayShape(typeStore, local.ty)) {
          let elementText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, array.element);
          let line: String = `    ${elementText.toStr()} l${localIndex}[${array.size}];\n`;

          let mut localRef: &mut String = output;
          localRef.pushStr(line.toStr());
        } else if (!CodegenC::isVoidType(typeStore, local.ty)) {
          let typeText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, local.ty);
          let line: String = `    ${typeText.toStr()} l${localIndex};\n`;

          let mut localRef: &mut String = output;
          localRef.pushStr(line.toStr());
        }
      }

      localIndex += 1;
    }

    CodegenC::emitUninitializedLocals(defStore, typeStore, output, function_);

    // Parameters already occupy `t0..tn-1` as the signature declares them.
    let mut tempIndex: u64 = function_.params.length();

    while (tempIndex < function_.temps.length()) {
      if (let Option::SOME(temp) = function_.temps.get(tempIndex)) {
        if (!CodegenC::isVoidType(typeStore, temp.ty)) {
          let typeText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, temp.ty);
          let line: String = `    ${typeText.toStr()} t${tempIndex};\n`;

          let mut tempRef: &mut String = output;
          tempRef.pushStr(line.toStr());
        }
      }

      tempIndex += 1;
    }

    let mut blockIndex: u64 = 0;

    while (blockIndex < function_.blocks.length()) {
      let Option::SOME(block) = function_.blocks.get(blockIndex) else {
        blockIndex += 1;
        continue;
      };

      let label: String = `\n${block.label.toStr()}_${blockIndex}:;\n`;
      let mut labelRef: &mut String = output;
      labelRef.pushStr(label.toStr());

      let mut instructionIndex: u64 = 0;

      while (instructionIndex < block.instructions.length()) {
        if (let Option::SOME(instruction) = block.instructions.get(instructionIndex)) {
          CodegenC::emitInstruction(defStore, typeStore, symbols, output, unsupported, closures, function_, instruction);
        }

        instructionIndex += 1;
      }

      CodegenC::emitTerminator(defStore, typeStore, symbols, output, function_, closures, &block.terminator);

      blockIndex += 1;
    }

    let mut closeRef: &mut String = output;
    closeRef.pushStr("}\n\n");
  }

  /// Find every closure in the program: which `Type::Function` signatures are
  /// real closures, and which thunk needs an environment struct.
  ///
  /// A function type that only ever reaches an extern declaration or a
  /// `DropGlue` destination is a bare C function pointer, so it stays out of
  /// `signatures` and keeps rendering as `void*`.
  function collectClosureTables(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    program: &Lir::LirProgram,
  ): CodegenC::ClosureTables {
    let mut tables: CodegenC::ClosureTables = CodegenC::ClosureTables::empty();
    let mut rawFunctionPointers: Vector<u32> = Vector::new<u32>();
    let mut seenThunks: Vector<u32> = Vector::new<u32>();

    let mut scanIndex: u64 = 0;

    while (scanIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(scanIndex) else {
        scanIndex += 1;
        continue;
      };

      if (function_.isExtern) {
        let mut paramIndex: u64 = 0;

        while (paramIndex < function_.params.length()) {
          if (let Option::SOME(paramId) = function_.params.get(paramIndex)) {
            if (let Option::SOME(paramDefinition) = defStore.get(*paramId)) {
              if (let Analyzer::Definition::Variable(variableDef) = paramDefinition) {
                let declared: Analyzer::TypeId = variableDef.declaredType;

                if (CodegenC::isFunctionType(typeStore, declared)) {
                  if (!CodegenC::containsRaw(&mut rawFunctionPointers, declared.raw())) {
                    rawFunctionPointers.push(declared.raw());
                  }
                }
              }
            }
          }

          paramIndex += 1;
        }
      }

      let mut blockIndex: u64 = 0;

      while (blockIndex < function_.blocks.length()) {
        let Option::SOME(block) = function_.blocks.get(blockIndex) else {
          blockIndex += 1;
          continue;
        };

        let mut instructionIndex: u64 = 0;

        while (instructionIndex < block.instructions.length()) {
          if (let Option::SOME(instruction) = block.instructions.get(instructionIndex)) {
            if (let Lir::Instr::DropGlue(node) = instruction) {
              if (let Option::SOME(data) = function_.temps.get(node.dest.raw() as u64)) {
                if (!CodegenC::containsRaw(&mut rawFunctionPointers, data.ty.raw())) {
                  rawFunctionPointers.push(data.ty.raw());
                }
              }
            }
          }

          instructionIndex += 1;
        }

        blockIndex += 1;
      }

      scanIndex += 1;
    }

    let mut functionIndex: u64 = 0;

    while (functionIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(functionIndex) else {
        functionIndex += 1;
        continue;
      };

      let mut blockIndex: u64 = 0;

      while (blockIndex < function_.blocks.length()) {
        let Option::SOME(block) = function_.blocks.get(blockIndex) else {
          blockIndex += 1;
          continue;
        };

        let mut instructionIndex: u64 = 0;

        while (instructionIndex < block.instructions.length()) {
          if (let Option::SOME(instruction) = block.instructions.get(instructionIndex)) {
            if (let Lir::Instr::MakeClosure(node) = instruction) {
              if (!CodegenC::containsRaw(&mut seenThunks, node.thunk.raw())) {
                seenThunks.push(node.thunk.raw());

                let mut captureTypes: Vector<u32> = Vector::new<u32>();
                let mut captureIndex: u64 = 0;

                while (captureIndex < node.captures.length()) {
                  if (let Option::SOME(capture) = node.captures.get(captureIndex)) {
                    if (let Option::SOME(captureType) = CodegenC::operandType(function_, capture)) {
                      captureTypes.push(captureType.raw());
                    } else {
                      captureTypes.push(0);
                    }
                  }

                  captureIndex += 1;
                }

                tables.envs.push(CodegenC::ClosureEnv {
                  thunk: node.thunk.raw(),
                  captureTypes: captureTypes,
                });
              }

              if (!CodegenC::containsRaw(&mut tables.signatures, node.closureType.raw())) {
                tables.signatures.push(node.closureType.raw());
              }
            }
          }

          instructionIndex += 1;
        }

        blockIndex += 1;
      }

      // A function that only receives a closure has no `MakeClosure` of its
      // own, but its signature and its locals still need the struct.
      if (!function_.isExtern) {
        let mut paramIndex: u64 = 0;

        while (paramIndex < function_.params.length()) {
          if (let Option::SOME(paramId) = function_.params.get(paramIndex)) {
            if (let Option::SOME(paramDefinition) = defStore.get(*paramId)) {
              if (let Analyzer::Definition::Variable(variableDef) = paramDefinition) {
                let declared: Analyzer::TypeId = variableDef.declaredType;

                if (CodegenC::isFunctionType(typeStore, declared)) {
                  if (!CodegenC::containsRaw(&mut rawFunctionPointers, declared.raw())) {
                    if (!CodegenC::containsRaw(&mut tables.signatures, declared.raw())) {
                      tables.signatures.push(declared.raw());
                    }
                  }
                }
              }
            }
          }

          paramIndex += 1;
        }
      }

      let mut localIndex: u64 = 0;

      while (localIndex < function_.locals.length()) {
        if (let Option::SOME(local) = function_.locals.get(localIndex)) {
          if (CodegenC::isFunctionType(typeStore, local.ty)) {
            if (!CodegenC::containsRaw(&mut rawFunctionPointers, local.ty.raw())) {
              if (!CodegenC::containsRaw(&mut tables.signatures, local.ty.raw())) {
                tables.signatures.push(local.ty.raw());
              }
            }
          }
        }

        localIndex += 1;
      }

      functionIndex += 1;
    }

    return tables;
  }

  function tempIsVoid(
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    temp: Lir::TempId,
  ): boolean {
    let Option::SOME(data) = function_.temps.get(temp.raw() as u64) else {
      return false;
    };

    return CodegenC::isVoidType(typeStore, data.ty);
  }

  /// Whether an operand is a pointer or a reference, and so can cross an
  /// extern boundary through `void*`.
  function operandIsIndirect(
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): boolean {
    let Option::SOME(typeId) = CodegenC::operandType(function_, operand) else {
      return false;
    };

    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return false;
    };

    return match (typeNode) {
      Analyzer::Type::Pointer(_) -> true,
      Analyzer::Type::Reference(_) -> true,
      _ -> false,
    };
  }

  function countNonVoid(
    typeStore: &mut Analyzer::TypeStore,
    types: &Vector<Analyzer::TypeId>
  ): u64 {
    let mut count: u64 = 0;
    let mut index: u64 = 0;

    while (index < types.length()) {
      if (let Option::SOME(typeId) = types.get(index)) {
        if (!CodegenC::isVoidType(typeStore, *typeId)) {
          count += 1;
        }
      }

      index += 1;
    }

    return count;
  }

  function operandIsVoid(
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): boolean {
    let Option::SOME(typeId) = CodegenC::operandType(function_, operand) else {
      return false;
    };

    return CodegenC::isVoidType(typeStore, typeId);
  }

  record FixedArrayShape {
    public element: Analyzer::TypeId;
    public size: u64;
  }

  function fixedArrayShape(
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId
  ): Option<CodegenC::FixedArrayShape> {
    if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
      if (let Analyzer::Type::FixedArray(element, size) = typeNode) {
        return Option::SOME(CodegenC::FixedArrayShape { element: element, size: size });
      }
    }

    return Option::NONE;
  }

  function isVoidType(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): boolean {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return false;
    };

    return match (typeNode) {
      Analyzer::Type::VOID -> true,
      _ -> false,
    };
  }

  function isFunctionType(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): boolean {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return false;
    };

    return match (typeNode) {
      Analyzer::Type::Function(_) -> true,
      _ -> false,
    };
  }

  /// One environment struct per thunk, then one closure struct per signature.
  /// A closure value is the call pointer, an optional drop pointer, and the
  /// environment the two of them share.
  /// The type store is deduplicated, so the raw type id identifies a slice
  /// type uniquely within one translation unit.
  function sliceStructName(typeId: Analyzer::TypeId): String {
    return `__ignis_slice_t${typeId.raw()}`;
  }

  /// One `{ data, len }` struct per concrete slice type in the store, as the
  /// host emits. Slices over a type parameter belong to generic templates
  /// monomorphization already replaced and get no struct.
  function emitSliceTypes(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    closures: &CodegenC::ClosureTables,
  ): void {
    let mut emittedAny: boolean = false;
    let mut rawId: u32 = 0;
    let typeCount: u64 = typeStore.length();

    while ((rawId as u64) < typeCount) {
      let typeId: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(rawId);
      let mut element: Option<Analyzer::TypeId> = Option::NONE;

      if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
        if (let Analyzer::Type::Slice(elementType) = typeNode) {
          element = Option::SOME(elementType);
        }
      }

      let Option::SOME(elementType) = element else {
        rawId += 1;
        continue;
      };

      if (typeStore.containsTypeParam(elementType)) {
        rawId += 1;
        continue;
      }

      if (!emittedAny) {
        let mut headerRef: &mut String = output;
        headerRef.pushStr("\n// Slice types\n");
        emittedAny = true;
      }

      let name: String = CodegenC::sliceStructName(typeId);
      let elementText: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, elementType);
      let definition: String = `struct ${name.toStr()} {\n    ${elementText.toStr()}* data;\n    u64 len;\n};\n`;

      let mut outputRef: &mut String = output;
      outputRef.pushStr(definition.toStr());

      rawId += 1;
    }
  }

  function emitClosureTypes(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    closures: &CodegenC::ClosureTables,
  ): void {
    if (closures.envs.length() == 0 && closures.signatures.length() == 0) {
      return;
    }

    let mut headerRef: &mut String = output;
    headerRef.pushStr("\n// Closure types\n");

    let mut envIndex: u64 = 0;

    while (envIndex < closures.envs.length()) {
      let Option::SOME(env) = closures.envs.get(envIndex) else {
        envIndex += 1;
        continue;
      };

      let thunk: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(env.thunk);
      let name: String = CodegenC::closureEnvName(thunk);

      let open: String = `struct ${name.toStr()} {\n`;

      let mut openRef: &mut String = output;
      openRef.pushStr(open.toStr());

      if (env.captureTypes.length() == 0) {
        // C rejects an empty struct, and an empty environment is what a closure
        // capturing nothing has.
        let mut emptyRef: &mut String = output;
        emptyRef.pushStr("    char _empty;\n");
      } else {
        let mut captureIndex: u64 = 0;

        while (captureIndex < env.captureTypes.length()) {
          if (let Option::SOME(raw) = env.captureTypes.get(captureIndex)) {
            let captureType: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
            let text: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, captureType);
            let line: String = `    ${text.toStr()} field_${captureIndex};\n`;

            let mut fieldRef: &mut String = output;
            fieldRef.pushStr(line.toStr());
          }

          captureIndex += 1;
        }
      }

      let mut closeRef: &mut String = output;
      closeRef.pushStr("};\n");

      envIndex += 1;
    }

    let mut signatureIndex: u64 = 0;

    while (signatureIndex < closures.signatures.length()) {
      let Option::SOME(raw) = closures.signatures.get(signatureIndex) else {
        signatureIndex += 1;
        continue;
      };

      let signatureType: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
      let name: String = CodegenC::closureStructName(signatureType);

      let mut callParams: String = String::create("u8*");
      let mut returnText: String = String::create("void");

      if (let Option::SOME(typeNode) = typeStore.get(signatureType)) {
        if (let Analyzer::Type::Function(functionType) = typeNode) {
          returnText = CodegenC::formatCType(defStore, typeStore, symbols, closures, functionType.returnType);

          let params: Vector<Analyzer::TypeId> = CodegenC::copyTypeIds(&functionType.params);
          let mut paramIndex: u64 = 0;

          while (paramIndex < params.length()) {
            if (let Option::SOME(paramType) = params.get(paramIndex)) {
              let text: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, *paramType);
              callParams.pushStr(", ");
              callParams.pushStr(text.toStr());
            }

            paramIndex += 1;
          }
        }
      }

      let body: String = `struct ${name.toStr()} {\n    ${returnText.toStr()} (*call)(${callParams.toStr()});\n    void (*drop_fn)(u8*);\n    u8* env;\n};\n`;

      let mut bodyRef: &mut String = output;
      bodyRef.pushStr(body.toStr());

      signatureIndex += 1;
    }
  }

  /// A declaration for every function the C side defines.
  ///
  function emitStdHeaders(output: &mut String): void {
    let mut outputRef: &mut String = output;
    outputRef.pushStr("#include <stdlib.h>\n");
    outputRef.pushStr("#include <string.h>\n");
    outputRef.pushStr("#include <stdio.h>\n");
    outputRef.pushStr("#include <errno.h>\n");
    outputRef.pushStr("#include <ctype.h>\n");
    outputRef.pushStr("#include <time.h>\n");
    outputRef.pushStr("#include <signal.h>\n");
    outputRef.pushStr("#include <unistd.h>\n");
    outputRef.pushStr("#include <sys/mman.h>\n");
    outputRef.pushStr("#include <sys/wait.h>\n");
    outputRef.pushStr("#include <sys/stat.h>\n");
    outputRef.pushStr("#include <dirent.h>\n");
    outputRef.pushStr("#include <fcntl.h>\n");
    outputRef.pushStr("#include <math.h>\n\n");
  }

  /// One `static void <name>(u8*)` helper per type a `DropGlue` instruction
  /// names. The runtime calls these through a function pointer, so they have to
  /// exist before the first function body that takes their address.
  function emitDropGlueHelpers(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    closures: &CodegenC::ClosureTables,
    program: &Lir::LirProgram,
  ): void {
    let mut glueTypes: Vector<u32> = Vector::new<u32>();
    let mut functionIndex: u64 = 0;

    while (functionIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(functionIndex) else {
        functionIndex += 1;
        continue;
      };

      let mut blockIndex: u64 = 0;

      while (blockIndex < function_.blocks.length()) {
        let Option::SOME(block) = function_.blocks.get(blockIndex) else {
          blockIndex += 1;
          continue;
        };

        let mut instructionIndex: u64 = 0;

        while (instructionIndex < block.instructions.length()) {
          if (let Option::SOME(instruction) = block.instructions.get(instructionIndex)) {
            if (let Lir::Instr::DropGlue(node) = instruction) {
              if (!CodegenC::containsRaw(&mut glueTypes, node.ty.raw())) {
                glueTypes.push(node.ty.raw());
              }
            }
          }

          instructionIndex += 1;
        }

        blockIndex += 1;
      }

      functionIndex += 1;
    }

    if (glueTypes.length() == 0) {
      return;
    }

    let mut headerRef: &mut String = output;
    headerRef.pushStr("\n// Drop glue\n");

    let mut glueIndex: u64 = 0;

    while (glueIndex < glueTypes.length()) {
      let Option::SOME(raw) = glueTypes.get(glueIndex) else {
        glueIndex += 1;
        continue;
      };

      let typeId: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
      let name: String = CodegenC::dropGlueName(typeId);

      let open: String = `static void ${name.toStr()}(u8* payload) {\n`;

      let mut openRef: &mut String = output;
      openRef.pushStr(open.toStr());

      if (Borrowck::needsDropType(defStore, typeStore, typeId)) {
        let target: String = CodegenC::formatCType(defStore, typeStore, symbols, closures, typeId);
        let bind: String = `    ${target.toStr()}* value = (${target.toStr()}*)payload;\n`;

        let mut bindRef: &mut String = output;
        bindRef.pushStr(bind.toStr());

        let access: String = String::create("(*value)");
        CodegenC::emitFieldDrops(defStore, typeStore, symbols, output, closures, &access, typeId);
      } else {
        let mut voidRef: &mut String = output;
        voidRef.pushStr("    (void)payload;\n");
      }

      let mut closeRef: &mut String = output;
      closeRef.pushStr("}\n\n");

      glueIndex += 1;
    }
  }

  /// The whole translation unit: the runtime header, one forward declaration
  /// and one definition per nominal type, a prototype per function, then the
  /// bodies.
  ///
  /// `externalSymbols` holds the raw definition ids another translation unit
  /// references by name, which today is the `@test` functions the harness unit
  /// dispatches to. Everything else the unit defines stays `static`.
  function emitProgram(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    program: &Lir::LirProgram,
    externalSymbols: &Vector<u32>,
  ): CodegenC::EmitOutput {
    let mut source: String = String::create("");
    let mut unsupported: u64 = 0;
    let mut functions: u64 = 0;

    source.pushStr("#include \"ignis_rt.h\"\n");

    // The host includes the headers each linked std module names in
    // `std/manifest.toml`; this is that list for `libc` and `math`, which every
    // program pulls through the prelude. An extern function is then declared
    // by its header, never by the emitter, since a second declaration with the
    // emitter's spelling of the parameter types conflicts with the header's.
    CodegenC::emitStdHeaders(&mut source);

    let tables: CodegenC::ClosureTables = CodegenC::collectClosureTables(defStore, typeStore, program);
    let closures: &CodegenC::ClosureTables = &tables;

    let typeDefs: Vector<Analyzer::DefinitionId> = CodegenC::orderedTypeDefs(defStore, typeStore);

    source.pushStr("// Type forward declarations\n");

    let mut forwardIndex: u64 = 0;

    while (forwardIndex < typeDefs.length()) {
      if (let Option::SOME(defId) = typeDefs.get(forwardIndex)) {
        let name: String = CodegenC::structName(defStore, symbols, *defId);
        let line: String = `struct ${name.toStr()};\n`;
        source.pushStr(line.toStr());
      }

      forwardIndex += 1;
    }

    source.pushStr("\n// Type definitions\n");

    let mut definitionIndex: u64 = 0;

    while (definitionIndex < typeDefs.length()) {
      if (let Option::SOME(defId) = typeDefs.get(definitionIndex)) {
        CodegenC::emitTypeDefinition(defStore, typeStore, symbols, &mut source, closures, *defId);
      }

      definitionIndex += 1;
    }

    CodegenC::emitSliceTypes(defStore, typeStore, symbols, &mut source, closures);

    CodegenC::emitClosureTypes(defStore, typeStore, symbols, &mut source, closures);

    CodegenC::emitDropGlueHelpers(defStore, typeStore, symbols, &mut source, closures, program);

    source.pushStr("\n// Function prototypes\n");

    let mut prototypeIndex: u64 = 0;

    while (prototypeIndex < program.functions.length()) {
      if (let Option::SOME(function_) = program.functions.functionAt(prototypeIndex)) {
        let signature: String = CodegenC::functionSignature(defStore, typeStore, symbols, closures, function_);

        // C treats `extern` on a declaration as a no-op, but it records which
        // side owns the definition. A declaration and its definition have to
        // agree on the storage class, so the prototype repeats the `static`
        // the body carries.
        if (CodegenC::isExternFunction(defStore, function_.defId)) {
          source.pushStr("extern ");
        } else if (CodegenC::hasInternalLinkage(defStore, function_.defId, externalSymbols)) {
          source.pushStr("static ");
        }

        let line: String = `${signature.toStr()};\n`;
        source.pushStr(line.toStr());
      }

      prototypeIndex += 1;
    }

    source.pushStr("\n// Function definitions\n");

    let mut bodyIndex: u64 = 0;

    while (bodyIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(bodyIndex) else {
        bodyIndex += 1;
        continue;
      };

      // An extern function is defined on the C side; a prototype is all it gets.
      if (CodegenC::isExternFunction(defStore, function_.defId)) {
        bodyIndex += 1;
        continue;
      }

      CodegenC::emitFunction(
        defStore,
        typeStore,
        symbols,
        &mut source,
        &mut unsupported,
        closures,
        externalSymbols,
        function_,
      );
      functions += 1;

      bodyIndex += 1;
    }

    CodegenC::emitEntryWrapper(defStore, typeStore, symbols, &mut source, program);

    return CodegenC::EmitOutput {
      source: source,
      unsupported: unsupported,
      functions: functions,
    };
  }

  /// The C `main` around the program's entry point, as the host writes it:
  /// the runtime is initialised with the process arguments, then the user's
  /// `main` runs with no arguments or with `(argc, argv)`, and an `i32`
  /// result becomes the exit code while a `void` one exits 0. A `Result`
  /// entry point is outside what this emitter covers and returns 1.
  function emitEntryWrapper(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &mut String,
    program: &Lir::LirProgram,
  ): void {
    let Option::SOME(entryDef) = program.entryPoint else {
      return;
    };
    let Option::SOME(entry) = program.functions.get(entryDef) else {
      return;
    };

    let name: String = CodegenC::mangledName(defStore, symbols, entryDef);
    let mut call: String = `${name.toStr()}()`;

    if (entry.params.length() == 2) {
      call = `${name.toStr()}((i32)argc, (const char**)argv)`;
    }

    let mut body: String = String::create("");

    if (CodegenC::isVoidType(typeStore, entry.returnType)) {
      body = `    ${call.toStr()};\n    return 0;\n`;
    } else if (CodegenC::isI32Type(typeStore, entry.returnType)) {
      body = `    return ${call.toStr()};\n`;
    } else {
      body = `    (void)${call.toStr()};\n    return 1;\n`;
    }

    let wrapper: String = `\nint main(int argc, char** argv) {\n    ignis_runtime_init((i32)argc, argv);\n${body.toStr()}}\n`;

    let mut outputRef: &mut String = output;
    outputRef.pushStr(wrapper.toStr());
  }

  function isI32Type(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): boolean {
    if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
      if (let Analyzer::Type::I32 = typeNode) {
        return true;
      }
    }

    return false;
  }

  /// `containsRaw` over a shared reference. Ignis has no `&mut T` to `&T`
  /// reborrow, so the two callers cannot share one signature.
  function hasRaw(values: &Vector<u32>, target: u32): boolean {
    let mut index: u64 = 0;

    while (index < values.length()) {
      if (let Option::SOME(existing) = values.get(index)) {
        if (*existing == target) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function containsRaw(values: &mut Vector<u32>, target: u32): boolean {
    let mut index: u64 = 0;

    while (index < values.length()) {
      if (let Option::SOME(existing) = values.get(index)) {
        if (*existing == target) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// The definition a type needs complete before a struct can hold it by
  /// value. A pointer needs only a forward declaration, so it answers `NONE`.
  function byValueDependency(
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::Record(recordDef) -> Option::SOME(recordDef),
      Analyzer::Type::Enum(enumDef) -> Option::SOME(enumDef),
      _ -> Option::NONE,
    };
  }

  function visitTypeDef(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ordered: &mut Vector<Analyzer::DefinitionId>,
    emitted: &mut Vector<u32>,
    visiting: &mut Vector<u32>,
    defId: Analyzer::DefinitionId,
  ): void {
    if (CodegenC::containsRaw(emitted, defId.raw())) {
      return;
    }

    // A cycle can only be spelled through a pointer, which needs no ordering.
    if (CodegenC::containsRaw(visiting, defId.raw())) {
      return;
    }

    let mut isTypeDef: boolean = false;

    if (let Option::SOME(definition) = defStore.get(defId)) {
      match (definition) {
        Analyzer::Definition::Record(recordDef) -> {
          isTypeDef = recordDef.typeParams.length() == 0;
        },
        Analyzer::Definition::Enum(enumDef) -> {
          isTypeDef = enumDef.typeParams.length() == 0;
        },
        _ -> {},
      };
    }

    if (!isTypeDef) {
      return;
    }

    let mut visitingRef: &mut Vector<u32> = visiting;
    visitingRef.push(defId.raw());

    let componentTypeIds: Vector<Analyzer::TypeId> = CodegenC::componentTypesOf(defStore, defId);
    let mut componentIndex: u64 = 0;

    while (componentIndex < componentTypeIds.length()) {
      if (let Option::SOME(componentType) = componentTypeIds.get(componentIndex)) {
        if (let Option::SOME(dependency) = CodegenC::byValueDependency(typeStore, *componentType)) {
          CodegenC::visitTypeDef(defStore, typeStore, ordered, emitted, visiting, dependency);
        }
      }

      componentIndex += 1;
    }

    let mut popRef: &mut Vector<u32> = visiting;
    let _ = popRef.pop();

    let mut emittedRef: &mut Vector<u32> = emitted;
    emittedRef.push(defId.raw());

    let mut orderedRef: &mut Vector<Analyzer::DefinitionId> = ordered;
    orderedRef.push(defId);
  }

  /// Every type a record or enum holds: field types for one, variant payload
  /// types for the other.
  function componentTypesOf(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
  ): Vector<Analyzer::TypeId> {
    let mut components: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    let mut fieldDefs: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut variantDefs: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(defId)) {
      match (definition) {
        Analyzer::Definition::Record(recordDef) -> {
          fieldDefs = CodegenC::copyDefIds(&recordDef.fields);
        },
        Analyzer::Definition::Enum(enumDef) -> {
          variantDefs = CodegenC::copyDefIds(&enumDef.variants);
        },
        _ -> {},
      };
    }

    let mut fieldIndex: u64 = 0;

    while (fieldIndex < fieldDefs.length()) {
      if (let Option::SOME(fieldDefId) = fieldDefs.get(fieldIndex)) {
        if (let Option::SOME(fieldDefinition) = defStore.get(*fieldDefId)) {
          if (let Analyzer::Definition::Field(fieldDef) = fieldDefinition) {
            components.push(fieldDef.fieldType);
          }
        }
      }

      fieldIndex += 1;
    }

    let mut variantIndex: u64 = 0;

    while (variantIndex < variantDefs.length()) {
      if (let Option::SOME(variantDefId) = variantDefs.get(variantIndex)) {
        if (let Option::SOME(variantDefinition) = defStore.get(*variantDefId)) {
          if (let Analyzer::Definition::Variant(variantDef) = variantDefinition) {
            let mut payloadIndex: u64 = 0;

            while (payloadIndex < variantDef.payload.length()) {
              if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
                components.push(*payloadType);
              }

              payloadIndex += 1;
            }
          }
        }
      }

      variantIndex += 1;
    }

    return components;
  }

  function copyTypeIds(source: &Vector<Analyzer::TypeId>): Vector<Analyzer::TypeId> {
    let mut result: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(typeId) = source.get(index)) {
        result.push(*typeId);
      }

      index += 1;
    }

    return result;
  }

  function copyDefIds(source: &Vector<Analyzer::DefinitionId>): Vector<Analyzer::DefinitionId> {
    let mut result: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(defId) = source.get(index)) {
        result.push(*defId);
      }

      index += 1;
    }

    return result;
  }
}
