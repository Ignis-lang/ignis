import Env from "std::env";
import Path from "std::path";
import Test from "std::test";
import Vector from "std::vector";

import DiagnosticBag, Severity, SourceFile from "@compiler::diagnostics";
import Id from "@compiler::ids";
import Analyzer from "@compiler::analyzer";
import BuildModuleKind, DiscoveryResult, Resolver from "@compiler::build";
import Hir from "@compiler::hir";
import ParseOutput, Parser from "@compiler::parser";
import Borrowck from "@compiler::analyzer::borrowck";
import Capture from "@compiler::analyzer::capture";
import RuntimeHandlers from "@compiler::analyzer::runtime_handlers";
import Lowering from "@compiler::analyzer::lowering";
import Mono from "@compiler::analyzer::mono";
import LirLowering from "@compiler::lir::lowering";
import CodegenC from "./mod";
import CodegenReserved from "./reserved";

function codegenCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

function codegenContains(haystack: &String, needle: str): boolean {
  let target: String = String::create(needle);

  return haystack.contains(&target);
}

/// One emitted translation unit plus the stores that produced it, so a test
/// can name a definition the emitter mangled rather than guess its id.
record CodegenEmission {
  public source: String;
  public defStore: Analyzer::DefinitionStore;
  public symbols: Analyzer::SymbolTable;
}

/// Raw definition ids of every function whose written name `names` lists.
function codegenFunctionDefIds(
  defStore: &mut Analyzer::DefinitionStore,
  symbols: &mut Analyzer::SymbolTable,
  names: &Vector<String>,
): Vector<u32> {
  let mut ids: Vector<u32> = Vector::new<u32>();
  let mut rawId: u64 = 0;

  while (rawId < defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(rawId as u32);
    let mut nameSym: Option<Analyzer::SymbolId> = Option::NONE;

    if (let Option::SOME(Analyzer::Definition::Function(functionDef)) = defStore.get(defId)) {
      nameSym = Option::SOME(functionDef.name);
    }

    if (let Option::SOME(functionName) = nameSym) {
      if (let Option::SOME(text) = symbols.resolve(functionName)) {
        let written: String = String::create(text);
        let mut nameIndex: u64 = 0;

        while (nameIndex < names.length()) {
          if (let Option::SOME(candidate) = names.get(nameIndex)) {
            if (written.equals(candidate)) {
              ids.push(defId.raw());
              break;
            }
          }

          nameIndex += 1;
        }
      }
    }

    rawId += 1;
  }

  return ids;
}

/// Runs `source` through the whole pipeline the driver uses and returns the
/// C it emitted. Parse, analyzer and ownership errors are rejected: emitted C
/// from a program the rest of the pipeline refuses says nothing.
function codegenEmit(source: str): CodegenEmission {
  let externalNames: Vector<String> = Vector::new<String>();

  return codegenEmitExposing(source, &externalNames);
}

/// `codegenEmit`, with the functions `externalNames` names kept externally
/// visible the way the test harness unit needs its `@test` functions.
function codegenEmitExposing(source: str, externalNames: &Vector<String>): CodegenEmission {
  return codegenEmitWith(source, externalNames, false);
}

/// `codegenEmit` for a `std = false` build, which emits a freestanding unit.
function codegenEmitFreestanding(source: str): CodegenEmission {
  let externalNames: Vector<String> = Vector::new<String>();

  return codegenEmitWith(source, &externalNames, true);
}

/// The pipeline behind `codegenEmit` and its variants, with the emitter told
/// whether the unit is freestanding and handed the runtime handlers the
/// source declares.
function codegenEmitWith(
  source: str,
  externalNames: &Vector<String>,
  freestanding: boolean,
): CodegenEmission {
  let file: SourceFile = SourceFile::create("codegen_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(codegenCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(codegenCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(codegenCountErrors(&output.diagnostics), 0);

  let mut handlers: RuntimeHandlers::HandlerSet = RuntimeHandlers::HandlerSet::empty();
  let mut handlerDiagnostics: DiagnosticBag = DiagnosticBag::init();
  RuntimeHandlers::collectModule(
    &defStore,
    &typeStore,
    &parsed.module,
    &output.pass2,
    freestanding,
    &mut handlers,
    &mut handlerDiagnostics,
  );
  RuntimeHandlers::checkAllocatorPair(&handlers, &mut handlerDiagnostics);

  Test::assertEq<u64>(codegenCountErrors(&handlerDiagnostics), 0);

  let mut hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let captureDiagnostics: DiagnosticBag = Capture::populateClosureCaptures(&mut defStore, &mut typeStore, &mut symbols, &mut hir);

  Test::assertEq<u64>(codegenCountErrors(&captureDiagnostics), 0);

  let handlerIds: Vector<u32> = handlers.definitionIds();
  let monoResult: Mono::MonoOutput = Mono::runWithRoots(&mut defStore, &mut typeStore, &mut symbols, &hir, false, &handlerIds);

  let checked: Borrowck::BorrowckOutput = Borrowck::checkModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &monoResult.hir,
  );

  Test::assertEq<u64>(codegenCountErrors(&checked.diagnostics), 0);

  // The driver hands LIR lowering the values const-eval folded; a `static mut`
  // field's global is seeded from them, so the harness has to hand over the
  // same map rather than an empty one.
  let constValues: &Analyzer::ConstEval::ConstValueMap = &output.constValues.values;

  let lowered: LirLowering::LowerModuleResult = LirLowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &monoResult.hir,
    &checked.dropSchedules,
    constValues,
  );

  let mut externalSymbols: Vector<u32> = codegenFunctionDefIds(&mut defStore, &mut symbols, externalNames);
  let mut handlerIndex: u64 = 0;

  while (handlerIndex < handlerIds.length()) {
    if (let Option::SOME(handlerId) = handlerIds.get(handlerIndex)) {
      externalSymbols.push(*handlerId);
    }

    handlerIndex += 1;
  }

  let moduleInfos: Vector<Analyzer::Imports::ModuleInfo> = Vector::new<Analyzer::Imports::ModuleInfo>();
  let mut hooks: CodegenC::RuntimeHooks = CodegenC::RuntimeHooks::hosted();
  hooks.freestanding = freestanding;
  hooks.sources.push(SourceFile::create("codegen_tests.ign", source));

  if (let Option::SOME(handler) = &handlers.panicHandler) {
    hooks.panicHandler = Option::SOME(handler.defId);
  }

  if (let Option::SOME(handler) = &handlers.allocHandler) {
    hooks.allocHandler = Option::SOME(handler.defId);
  }

  if (let Option::SOME(handler) = &handlers.freeHandler) {
    hooks.freeHandler = Option::SOME(handler.defId);
  }

  let emitted: CodegenC::EmitOutput = CodegenC::emitProgram(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &lowered.program,
    &externalSymbols,
    &moduleInfos,
    &mut hooks,
  );

  Test::assertEq<u64>(hooks.unhandledPanics.length(), 0);

  return CodegenEmission {
    source: emitted.source,
    defStore: defStore,
    symbols: symbols,
  };
}

/// The C name of the first method whose written name starts with `prefix`.
function codegenMangledMethodStartingWith(
  emission: &mut CodegenEmission,
  prefix: str,
): Option<String> {
  let mut rawId: u64 = 0;

  while (rawId < emission.defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(rawId as u32);
    let mut nameSym: Option<Analyzer::SymbolId> = Option::NONE;

    if (let Option::SOME(Analyzer::Definition::Method(methodDef)) = emission.defStore.get(defId)) {
      nameSym = Option::SOME(methodDef.name);
    }

    if (let Option::SOME(methodName) = nameSym) {
      if (let Option::SOME(text) = emission.symbols.resolve(methodName)) {
        if (String::create(text).startsWith(prefix)) {
          return Option::SOME(
            CodegenC::mangledName(&mut emission.defStore, &mut emission.symbols, defId),
          );
        }
      }
    }

    rawId += 1;
  }

  return Option::NONE;
}

/// Raw definition ids of every variable whose written name `names` lists.
/// Static fields are bound as variables, so this is how a test names one.
function codegenVariableDefIds(
  defStore: &mut Analyzer::DefinitionStore,
  symbols: &mut Analyzer::SymbolTable,
  names: &Vector<String>,
): Vector<u32> {
  let mut ids: Vector<u32> = Vector::new<u32>();
  let mut rawId: u64 = 0;

  while (rawId < defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(rawId as u32);
    let mut nameSym: Option<Analyzer::SymbolId> = Option::NONE;

    if (let Option::SOME(Analyzer::Definition::Variable(variableDef)) = defStore.get(defId)) {
      nameSym = Option::SOME(variableDef.name);
    }

    if (let Option::SOME(variableName) = nameSym) {
      if (let Option::SOME(text) = symbols.resolve(variableName)) {
        let written: String = String::create(text);
        let mut nameIndex: u64 = 0;

        while (nameIndex < names.length()) {
          if (let Option::SOME(candidate) = names.get(nameIndex)) {
            if (written.equals(candidate)) {
              ids.push(defId.raw());
              break;
            }
          }

          nameIndex += 1;
        }
      }
    }

    rawId += 1;
  }

  return ids;
}

/// A `static mut` field is the one declaration with storage of its own that no
/// function owns: it becomes a writable C global seeded with its initializer,
/// its writes go through the global's address, and its reads stop folding. A
/// `static` field without `mut` keeps folding into its uses and gets no
/// storage at all.
@test
function codegenEmitsStaticMutFieldsAsWritableGlobals(): void {
  let mut emission: CodegenEmission = codegenEmit(
    "record Counter {\n  static mut TOTAL: i32 = 0;\n  static SEED: i32 = 7;\n}\n\nfunction bump(): void {\n  Counter::TOTAL += 1;\n}\n\nfunction main(): i32 {\n  bump();\n\n  return Counter::TOTAL + Counter::SEED;\n}\n",
  );

  let mut fieldNames: Vector<String> = Vector::new<String>();
  fieldNames.push(String::create("TOTAL"));

  let fieldIds: Vector<u32> = codegenVariableDefIds(&mut emission.defStore, &mut emission.symbols, &fieldNames);

  let Option::SOME(totalRaw) = fieldIds.get(0) else {
    @panic("the emitted program declares no static field named 'TOTAL'");
  };

  let totalId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*totalRaw);
  let totalName: String = CodegenC::mangledName(&mut emission.defStore, &mut emission.symbols, totalId);

  let global: String = `static i32 ${totalName.toStr()} = 0;`;
  let address: String = `= &${totalName.toStr()};`;

  Test::assert(emission.source.contains(&global));
  Test::assert(emission.source.contains(&address));

  // `SEED` has no `mut`, so it folds into its use and never becomes storage.
  let mut seedNames: Vector<String> = Vector::new<String>();
  seedNames.push(String::create("SEED"));

  let seedIds: Vector<u32> = codegenVariableDefIds(&mut emission.defStore, &mut emission.symbols, &seedNames);

  let Option::SOME(seedRaw) = seedIds.get(0) else {
    @panic("the emitted program declares no static field named 'SEED'");
  };

  let seedId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*seedRaw);
  let seedName: String = CodegenC::mangledName(&mut emission.defStore, &mut emission.symbols, seedId);

  Test::assert(!emission.source.contains(&seedName));
}

/// A generic nominal that declares `@implements(Drop)` reaches the emitter as
/// a monomorphized shell whose method list is empty, so the destructor of one
/// instantiation is only found by the definition that owns it.
@test
function codegenDropsAMonomorphizedNominal(): void {
  let mut emission: CodegenEmission = codegenEmit(
    "@implements(Drop)\nrecord Box<T> {\n  public value: T;\n\n  public static create(value: T): Box<T> {\n    return Box { value: value };\n  }\n\n  public drop(&mut self): void {\n    return;\n  }\n}\n\nfunction main(): i32 {\n  let b: Box<i32> = Box::create<i32>(7);\n\n  return b.value;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "void Box__i32__drop_"));

  let Option::SOME(dropName) = codegenMangledMethodStartingWith(&mut emission, "Box__i32__drop") else {
    @panic("monomorphization produced no specialized drop method");
  };

  let expectedCall: String = `${dropName.toStr()}(&`;

  Test::assert(emission.source.contains(&expectedCall));
}

/// The C spelling of the record `name` declares, as the emitter mangles it.
function codegenMangledStructName(emission: &mut CodegenEmission, name: str): Option<String> {
  let target: String = String::create(name);
  let mut rawId: u64 = 0;

  while (rawId < emission.defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(rawId as u32);
    let mut nameSym: Option<Analyzer::SymbolId> = Option::NONE;

    if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = emission.defStore.get(defId)) {
      nameSym = Option::SOME(recordDef.name);
    }

    if (let Option::SOME(recordName) = nameSym) {
      if (let Option::SOME(text) = emission.symbols.resolve(recordName)) {
        let written: String = String::create(text);

        if (written.equals(&target)) {
          return Option::SOME(
            CodegenC::structName(&mut emission.defStore, &mut emission.symbols, defId),
          );
        }
      }
    }

    rawId += 1;
  }

  return Option::NONE;
}

/// A consuming receiver reaches C as an ordinary by-value parameter, while a
/// borrowing receiver stays a pointer to the owner struct.
@test
function codegenEmitsConsumingReceiverByValue(): void {
  let mut emission: CodegenEmission = codegenEmit(
    "@implements(Drop)\nrecord Payload {\n  public value: i32;\n\n  public drop(&mut self): void {\n    return;\n  }\n}\n\nrecord Holder {\n  public payload: Payload;\n\n  public intoPayload(self): Payload {\n    return self.payload;\n  }\n\n  public peek(&self): i32 {\n    return self.payload.value;\n  }\n}\n\nfunction main(): i32 {\n  let holder: Holder = Holder { payload: Payload { value: 7 } };\n  let seen: i32 = holder.peek();\n  let taken: Payload = holder.intoPayload();\n  return seen + taken.value;\n}\n",
  );

  let Option::SOME(holderStruct) = codegenMangledStructName(&mut emission, "Holder") else {
    @panic("the emitted program declares no 'Holder' record");
  };
  let Option::SOME(consumingName) = codegenMangledMethodStartingWith(&mut emission, "intoPayload") else {
    @panic("the emitted program declares no 'intoPayload' method");
  };
  let Option::SOME(borrowingName) = codegenMangledMethodStartingWith(&mut emission, "peek") else {
    @panic("the emitted program declares no 'peek' method");
  };

  let consumingReceiver: String = `${consumingName.toStr()}(struct ${holderStruct.toStr()} `;
  let borrowingReceiver: String = `${borrowingName.toStr()}(struct ${holderStruct.toStr()}* `;

  Test::assert(emission.source.contains(&consumingReceiver));
  Test::assert(emission.source.contains(&borrowingReceiver));

  let consumingByPointer: String = `${consumingName.toStr()}(struct ${holderStruct.toStr()}* `;

  Test::assert(!emission.source.contains(&consumingByPointer));
}

/// The emitted unit owns every definition it holds, so a function nothing
/// outside it names gets internal linkage on both its prototype and its
/// definition. The two exceptions keep external linkage: the C entry wrapper,
/// which the process starts at, and an extern function the C side defines.
@test
function codegenGivesLocalFunctionsInternalLinkage(): void {
  let mut emission: CodegenEmission = codegenEmit(
    "extern __codegen_link {\n  function ignisTestExternProbe(value: i32): i32;\n}\n\nfunction helper(value: i32): i32 {\n  return value + 1;\n}\n\nfunction main(): i32 {\n  return helper(ignisTestExternProbe(1));\n}\n",
  );

  let mut helperNames: Vector<String> = Vector::new<String>();
  helperNames.push(String::create("helper"));

  let helperIds: Vector<u32> = codegenFunctionDefIds(&mut emission.defStore, &mut emission.symbols, &helperNames);

  let Option::SOME(helperRaw) = helperIds.get(0) else {
    @panic("the emitted program declares no function named 'helper'");
  };

  let helperId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*helperRaw);
  let helperName: String = CodegenC::mangledName(&mut emission.defStore, &mut emission.symbols, helperId);

  let prototype: String = `static i32 ${helperName.toStr()}(i32 t0);`;
  let definition: String = `static i32 ${helperName.toStr()}(i32 t0) {`;

  Test::assert(emission.source.contains(&prototype));
  Test::assert(emission.source.contains(&definition));

  Test::assert(codegenContains(&emission.source, "\nint main(int argc, char** argv) {"));
  Test::assert(!codegenContains(&emission.source, "static int main("));

  // An extern function has no body, so it never reaches the LIR program and
  // the unit only ever calls it. The rule still has to refuse it internal
  // linkage: the C side owns that symbol.
  let mut externNames: Vector<String> = Vector::new<String>();
  externNames.push(String::create("ignisTestExternProbe"));

  let externIds: Vector<u32> = codegenFunctionDefIds(&mut emission.defStore, &mut emission.symbols, &externNames);

  let Option::SOME(externRaw) = externIds.get(0) else {
    @panic("the analyzed program declares no extern function named 'ignisTestExternProbe'");
  };

  let externId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*externRaw);
  let noExternalSymbols: Vector<u32> = Vector::new<u32>();

  Test::assert(!CodegenC::hasInternalLinkage(&mut emission.defStore, externId, &noExternalSymbols));
  Test::assert(!codegenContains(&emission.source, "static i32 ignisTestExternProbe"));
}

/// `@externName` on a definition exports it: the unit emits the written C
/// symbol, unmangled, with external linkage, so another unit -- Ignis or C --
/// can name it. The single-unit rule that makes everything else `static` does
/// not apply to it.
@test
function codegenExportsDefinitionsUnderTheirWrittenSymbol(): void {
  let mut emission: CodegenEmission = codegenEmit(
    "@externName(\"ignis_test_exported\")\nfunction exported(value: i32): i32 {\n  return value + 1;\n}\n\nfunction main(): i32 {\n  return exported(1);\n}\n",
  );

  let mut exportedNames: Vector<String> = Vector::new<String>();
  exportedNames.push(String::create("exported"));

  let exportedIds: Vector<u32> = codegenFunctionDefIds(&mut emission.defStore, &mut emission.symbols, &exportedNames);

  let Option::SOME(exportedRaw) = exportedIds.get(0) else {
    @panic("the emitted program declares no function named 'exported'");
  };

  let exportedId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*exportedRaw);
  let noExternalSymbols: Vector<u32> = Vector::new<u32>();

  Test::assert(CodegenC::isExportedSymbol(&mut emission.defStore, exportedId));
  Test::assert(!CodegenC::hasInternalLinkage(&mut emission.defStore, exportedId, &noExternalSymbols));

  let mangled: String = CodegenC::mangledName(&mut emission.defStore, &mut emission.symbols, exportedId);

  Test::assert(mangled.equals("ignis_test_exported"));
  Test::assert(codegenContains(&emission.source, "i32 ignis_test_exported(i32 t0);"));
  Test::assert(codegenContains(&emission.source, "i32 ignis_test_exported(i32 t0) {"));
  Test::assert(!codegenContains(&emission.source, "static i32 ignis_test_exported"));
}

/// A `@test` function is called from the harness translation unit, which
/// declares it `extern void`, so the program unit has to leave its symbol
/// externally visible.
@test
function codegenKeepsHarnessSymbolsExternallyVisible(): void {
  let mut externalNames: Vector<String> = Vector::new<String>();
  externalNames.push(String::create("harnessed"));

  let emission: CodegenEmission = codegenEmitExposing(
    "function harnessed(): void {\n  return;\n}\n\nfunction main(): i32 {\n  harnessed();\n\n  return 0;\n}\n",
    &externalNames,
  );

  Test::assert(codegenContains(&emission.source, "void harnessed_"));
  Test::assert(!codegenContains(&emission.source, "static void harnessed_"));
}

/// A method call on a receiver that carries `@implements(Drop)` reads its drop
/// state byte first, so calling into a value that was already dropped panics
/// instead of reading freed memory.
@test
function codegenGuardsMethodCallsOnDroppedReceivers(): void {
  let emission: CodegenEmission = codegenEmit(
    "@implements(Drop)\nrecord Payload {\n  public value: i32;\n\n  public drop(&mut self): void {\n    return;\n  }\n\n  public peek(&self): i32 {\n    return 7;\n  }\n}\n\nfunction main(): i32 {\n  let payload: Payload = Payload { value: 1 };\n\n  return payload.peek();\n}\n",
  );

  Test::assert(
    codegenContains(
      &emission.source,
      "__ignis_drop_state) { fprintf(stderr, \"panic: use of dropped value\\n\"); exit(101); }",
    ),
  );
}

/// Reaching a field through a base whose nominal carries `@implements(Drop)`
/// is guarded the same way, which is what catches a read of a field moved out
/// of its owner.
@test
function codegenGuardsFieldAccessThroughDroppedValues(): void {
  let emission: CodegenEmission = codegenEmit(
    "@implements(Drop)\nrecord Payload {\n  public value: i32;\n\n  public drop(&mut self): void {\n    return;\n  }\n}\n\nfunction readValue(payload: &Payload): i32 {\n  return payload.value;\n}\n\nfunction main(): i32 {\n  let payload: Payload = Payload { value: 1 };\n\n  return readValue(&payload);\n}\n",
  );

  Test::assert(
    codegenContains(
      &emission.source,
      ")->__ignis_drop_state) { fprintf(stderr, \"panic: use of dropped value\\n\"); exit(101); }",
    ),
  );
}

/// A nominal without `@implements(Drop)` owns no drop state byte, so nothing
/// about it is guarded.
@test
function codegenLeavesNonDroppableAccessUnguarded(): void {
  let emission: CodegenEmission = codegenEmit(
    "record Payload {\n  public value: i32;\n}\n\nfunction readValue(payload: &Payload): i32 {\n  return payload.value;\n}\n\nfunction main(): i32 {\n  let payload: Payload = Payload { value: 1 };\n\n  return readValue(&payload);\n}\n",
  );

  Test::assert(!codegenContains(&emission.source, "panic: use of dropped value"));
}

/// `@readVolatile` and `@writeVolatile` reach C through a `volatile` pointer so
/// the C compiler keeps every access, while `@read` and `@write` stay plain.
@test
function codegenEmitsVolatileBuiltinAccessesThroughVolatilePointers(): void {
  let emission: CodegenEmission = codegenEmit(
    "function main(): i32 {\n  let mut value: i32 = 41;\n  let pointer: *mut i32 = (&mut value) as *mut i32;\n\n  @writeVolatile<i32>(pointer, 42);\n  @write<i32>(pointer, @read<i32>(pointer));\n\n  return @readVolatile<i32>(pointer);\n}\n",
  );

  Test::assert(codegenContains(&emission.source, " = *(volatile i32*)("));
  Test::assert(codegenContains(&emission.source, "    *(volatile i32*)("));
  Test::assert(codegenContains(&emission.source, " = *(i32*)("));
  Test::assert(codegenContains(&emission.source, "    *(i32*)("));
}

/// A signed minimum reaches C as one constant, not as the negation of a
/// magnitude that already wrapped: `--2147483648` does not compile and the
/// `i64` magnitude wraps to zero.
@test
function codegenEmitsSignedMinimumsAsSingleConstants(): void {
  let emission: CodegenEmission = codegenEmit(
    "function main(): i32 {\n  let a: i32 = -2147483648 as i32;\n  let b: i64 = -9223372036854775808 as i64;\n  let c: i64 = -9223372036854775808;\n\n  return a + (b - c) as i32;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "(i32)-2147483648;"));
  Test::assert(codegenContains(&emission.source, "(i64)INT64_MIN;"));
  Test::assert(codegenContains(&emission.source, "= INT64_MIN;"));
  Test::assert(!codegenContains(&emission.source, "--2147483648"));
  Test::assert(!codegenContains(&emission.source, "-0U"));
}

/// A hex or binary literal with nothing expected of it keeps its narrow
/// default type but reaches C with its full value, as the reference emits it,
/// so a cast to a wider type keeps the high bits.
@test
function codegenKeepsFullValueOfWideRadixLiteral(): void {
  let emission: CodegenEmission = codegenEmit(
    "function main(): i32 {\n  let a: u64 = 0x100000000 as u64;\n  let b: u64 = 0b100000000000000000000000000000000 as u64;\n\n  return (a >> 32) as i32 + (b >> 32) as i32;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "4294967296U"));
}

/// A record with no fields is an empty GNU C struct, sized zero like the
/// reference lays it out, not one padded with a dummy byte.
@test
function codegenEmitsRecordWithoutFieldsAsEmptyStruct(): void {
  let emission: CodegenEmission = codegenEmit(
    "record Empty {}\n\nfunction main(): i32 {\n  let _value: Empty = Empty {};\n\n  return @sizeOf<Empty>() as i32;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "sizeof(struct Empty_"));
  Test::assert(codegenContains(&emission.source, " {\n};\n"));
  Test::assert(!codegenContains(&emission.source, "char _empty;"));
}

/// An extern record defines the struct the C side names: the written record
/// name without a definition suffix, and the written field names in
/// declaration order, reached by name wherever a field is.
@test
function codegenEmitsExternRecordsUnderTheirCNames(): void {
  let emission: CodegenEmission = codegenEmit(
    "extern Device {\n  record Port {\n    public control: u8;\n    public status: u32;\n  }\n}\n\nfunction main(): i32 {\n  let mut port: Device::Port = Device::Port { control: 1, status: 2 };\n  let pointer: *mut Device::Port = &mut port as *mut Device::Port;\n\n  (*pointer).status = 5;\n\n  return port.status as i32 + port.control as i32;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "struct Port {\n    u8 control;\n    u32 status;\n};\n"));
  Test::assert(codegenContains(&emission.source, ")->control = "));
  Test::assert(codegenContains(&emission.source, ")->status);"));
  Test::assert(!codegenContains(&emission.source, "struct Port_"));
  Test::assert(!codegenContains(&emission.source, "field_"));
}

/// A `@cLayout` record keeps its mangled struct name but spells its fields
/// as written, in declaration order.
@test
function codegenEmitsCLayoutRecordFieldsByName(): void {
  let mut emission: CodegenEmission = codegenEmit(
    "@cLayout\nrecord Counter {\n  public value: i32;\n  public step: i32;\n\n  public total(&self): i32 {\n    return self.value + self.step;\n  }\n}\n\nfunction main(): i32 {\n  let counter: Counter = Counter { value: 2, step: 5 };\n\n  return counter.total();\n}\n",
  );

  let Option::SOME(name) = codegenMangledStructName(&mut emission, "Counter") else {
    @panic("expected the Counter record to be emitted");
  };

  let definition: String = `struct ${name.toStr()} {\n    i32 value;\n    i32 step;\n};\n`;

  Test::assert(codegenContains(&name, "Counter_"));
  Test::assert(emission.source.contains(&definition));
  Test::assert(!codegenContains(&emission.source, "field_"));
}

/// A function-typed extern parameter takes a typed C function pointer: the
/// signature gets one `ignis_fn_<id>` typedef, and a named function is passed
/// as itself, cast to it, with no forwarding closure in between.
@test
function codegenPassesNamedFunctionsToExternsAsTypedFunctionPointers(): void {
  let emission: CodegenEmission = codegenEmit(
    "extern LibC {\n  function qsort(base: *mut u8, count: u64, size: u64, compare: (*u8, *u8) -> i32): void;\n}\n\nfunction compareAscending(left: *u8, right: *u8): i32 {\n  return *(left as *i32) - *(right as *i32);\n}\n\nfunction main(): i32 {\n  let mut values: i32[2] = [2, 1];\n\n  LibC::qsort((&mut values[0]) as *mut u8, 2, 4, compareAscending);\n\n  return values[0];\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "typedef i32 (*ignis_fn_"));
  Test::assert(codegenContains(&emission.source, ")(u8*, u8*);\n"));
  Test::assert(codegenContains(&emission.source, " = (ignis_fn_"));
  Test::assert(codegenContains(&emission.source, ")compareAscending_"));
  Test::assert(!codegenContains(&emission.source, "__closure_thunk"));
}

/// A lambda without captures reaches a C function pointer through a `_raw`
/// wrapper that calls its thunk with a null environment.
@test
function codegenPassesNonCapturingLambdasToExternsThroughRawWrappers(): void {
  let emission: CodegenEmission = codegenEmit(
    "extern LibC {\n  function qsort(base: *mut u8, count: u64, size: u64, compare: (*u8, *u8) -> i32): void;\n}\n\nfunction main(): i32 {\n  let mut values: i32[2] = [2, 1];\n\n  LibC::qsort((&mut values[0]) as *mut u8, 2, 4, (left: *u8, right: *u8): i32 -> *(left as *i32) - *(right as *i32));\n\n  return values[0];\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "typedef i32 (*ignis_fn_"));
  Test::assert(codegenContains(&emission.source, "_raw(u8* a0, u8* a1) {\n"));
  Test::assert(codegenContains(&emission.source, "(NULL, a0, a1);\n"));
  Test::assert(codegenContains(&emission.source, "_raw;\n"));
}

/// One signature used both as an extern function pointer and as a local
/// closure keeps both representations: the closure struct for the closure and
/// the typedef for the pointer, rather than one of them for every use.
@test
function codegenKeepsClosureAndFunctionPointerOfOneSignatureApart(): void {
  let emission: CodegenEmission = codegenEmit(
    "extern Native {\n  function apply(callback: (i32) -> i32, value: i32): i32;\n}\n\nfunction twice(value: i32): i32 {\n  return value * 2;\n}\n\nfunction main(): i32 {\n  let offset: i32 = 3;\n  let shift: (i32) -> i32 = (value: i32): i32 -> value + offset;\n\n  return Native::apply(twice, shift(1));\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "typedef i32 (*ignis_fn_"));
  Test::assert(codegenContains(&emission.source, ")(i32);\n"));
  Test::assert(codegenContains(&emission.source, "struct __ignis_closure_t"));
  Test::assert(codegenContains(&emission.source, ".call("));
  Test::assert(codegenContains(&emission.source, ")twice_"));
}

/// Drop glue is a plain C function: passed to an extern it is cast to the
/// signature's typedef, and held as a function value it is called through the
/// C function pointer trampoline.
@test
function codegenTypesDropGlueAsACFunctionPointer(): void {
  let emission: CodegenEmission = codegenEmit(
    "extern Runtime {\n  function registerDrop(glue: (*mut u8) -> void): void;\n}\n\nfunction main(): i32 {\n  Runtime::registerDrop(@dropGlue<i32>());\n\n  let glue: (*mut u8) -> void = @dropGlue<i32>();\n  let mut value: i32 = 1;\n\n  glue((&mut value) as *mut u8);\n\n  return value;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "typedef void (*ignis_fn_"));
  Test::assert(codegenContains(&emission.source, ")ignis_drop_glue_t"));
  Test::assert(codegenContains(&emission.source, "registerDrop((void*)t"));
  Test::assert(codegenContains(&emission.source, "{ ignis_raw_tramp_"));
  Test::assert(!codegenContains(&emission.source, "(void*)ignis_drop_glue_t"));
}

/// A function-typed field of a C-layout record is a typed C function pointer:
/// the struct member is spelled by the signature's typedef, and a named
/// function stored into it is cast to that typedef with no closure around it.
@test
function codegenStoresCLayoutFunctionFieldsAsTypedFunctionPointers(): void {
  let emission: CodegenEmission = codegenEmit(
    "extern Native {\n  record Handler {\n    public apply: (i32) -> i32;\n    public bias: i32;\n  }\n}\n\nfunction twice(value: i32): i32 {\n  return value * 2;\n}\n\nfunction main(): i32 {\n  let mut handler: Native::Handler = Native::Handler { apply: twice, bias: 1 };\n\n  handler.apply = twice;\n\n  return handler.bias;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "typedef i32 (*ignis_fn_"));
  Test::assert(codegenContains(&emission.source, "struct Handler {\n    ignis_fn_"));
  Test::assert(codegenContains(&emission.source, " apply;\n    i32 bias;\n};\n"));
  Test::assert(codegenContains(&emission.source, ")twice_"));
  Test::assert(!codegenContains(&emission.source, "struct __ignis_closure_t"));
}

/// Reading a function-typed field of a C-layout record yields a closure that
/// calls the stored pointer through the signature's trampoline; a lambda
/// without captures is stored through its `_raw` wrapper.
@test
function codegenReadsCLayoutFunctionFieldsThroughTheTrampoline(): void {
  let emission: CodegenEmission = codegenEmit(
    "@cLayout\nrecord Table {\n  public apply: (i32) -> i32;\n}\n\nfunction main(): i32 {\n  let table: Table = Table { apply: (value: i32): i32 -> value + 1 };\n  let apply: (i32) -> i32 = table.apply;\n\n  return apply(41);\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "_raw(i32 a0) {\n"));
  Test::assert(codegenContains(&emission.source, "->apply);\n"));
  Test::assert(codegenContains(&emission.source, "{ ignis_raw_tramp_"));
  Test::assert(codegenContains(&emission.source, "static i32 ignis_raw_tramp_"));
}

/// A record without a C layout keeps its index-named fields.
@test
function codegenKeepsIndexNamedFieldsOnPlainRecords(): void {
  let emission: CodegenEmission = codegenEmit(
    "record Plain {\n  public value: i32;\n  public step: i32;\n}\n\nfunction main(): i32 {\n  let plain: Plain = Plain { value: 2, step: 5 };\n\n  return plain.value + plain.step;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, " {\n    i32 field_0;\n    i32 field_1;\n};\n"));
  Test::assert(!codegenContains(&emission.source, " value;"));
}

/// The reserved-name table is the contract both compilers share, so it is
/// asserted directly rather than through an emission: a divergence here is a
/// bootstrap fixed-point failure, not a wrong-looking function body.
@test
function codegenReservesCIdentifiers(): void {
  let mut reserved: Vector<String> = Vector::new<String>();
  reserved.push(String::create("int"));
  reserved.push(String::create("default"));
  reserved.push(String::create("stderr"));
  reserved.push(String::create("errno"));
  reserved.push(String::create("exit"));
  reserved.push(String::create("free"));
  reserved.push(String::create("main"));
  reserved.push(String::create("NULL"));
  reserved.push(String::create("size_t"));
  reserved.push(String::create("boolean"));
  reserved.push(String::create("l0"));
  reserved.push(String::create("t7"));
  reserved.push(String::create("__dip"));
  reserved.push(String::create("__ignis_drop_state"));
  reserved.push(String::create("ignis_runtime_init"));

  let mut index: u64 = 0;

  while (index < reserved.length()) {
    let Option::SOME(name) = reserved.get(index) else {
      @panic("the reserved-name table lost an entry");
    };

    Test::assert(CodegenReserved::isReservedCName(name));

    index += 1;
  }
}

/// A name the emitted unit does not already mean is emitted as written, and the
/// suffix is what a reserved one gains. `stderr__ign` is itself unreserved, so
/// the rule cannot compound. The emitter's own mangled thunk and glue names are
/// unreserved too: matching their prefix would rename the emitter's own symbols.
@test
function codegenLeavesOrdinaryCIdentifiersAlone(): void {
  let mut ordinary: Vector<String> = Vector::new<String>();
  ordinary.push(String::create("value"));
  ordinary.push(String::create("length"));
  ordinary.push(String::create("show_i32_i32"));
  ordinary.push(String::create("Holder"));
  ordinary.push(String::create("stderr__ign"));
  ordinary.push(String::create("local0"));
  ordinary.push(String::create("t1a"));
  ordinary.push(String::create("__closure_thunk_0_34538"));
  ordinary.push(String::create("ignis_drop_glue_t9"));

  let mut index: u64 = 0;

  while (index < ordinary.length()) {
    let Option::SOME(name) = ordinary.get(index) else {
      @panic("the ordinary-name table lost an entry");
    };

    Test::assert(!CodegenReserved::isReservedCName(name));

    index += 1;
  }

  let mangled: String = CodegenReserved::mangleReservedCName(String::create("stderr"));
  Test::assert(mangled.equals("stderr__ign"));

  let untouched: String = CodegenReserved::mangleReservedCName(String::create("value"));
  Test::assert(untouched.equals("value"));
}

/// A C-layout field keeps its written name, so only the C keywords are off
/// limits: a prelude or libc name such as `size_t` or `stderr` is reserved
/// for an emitter-owned name but is a valid struct member.
@test
function codegenRecognizesOnlyCKeywordsAsCKeywords(): void {
  let registerKeyword: String = String::create("register");
  let intKeyword: String = String::create("int");
  let boolKeyword: String = String::create("_Bool");
  let sizeType: String = String::create("size_t");
  let stream: String = String::create("stderr");
  let temporary: String = String::create("t7");
  let status: String = String::create("status");

  Test::assert(CodegenReserved::isCKeyword(&registerKeyword));
  Test::assert(CodegenReserved::isCKeyword(&intKeyword));
  Test::assert(CodegenReserved::isCKeyword(&boolKeyword));
  Test::assert(!CodegenReserved::isCKeyword(&sizeType));
  Test::assert(!CodegenReserved::isCKeyword(&stream));
  Test::assert(!CodegenReserved::isCKeyword(&temporary));
  Test::assert(!CodegenReserved::isCKeyword(&status));
}

/// A definition carrying the tracer's fixed `@externName`, in a module of the
/// given kind.
function pushAllocTraceCandidate(
  defStore: &mut Analyzer::DefinitionStore,
  symbols: &mut Analyzer::SymbolTable,
  name: str,
  moduleIndex: u64,
): Analyzer::DefinitionId {
  let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
  let mut defsRef: &mut Analyzer::DefinitionStore = defStore;

  let defId: Analyzer::DefinitionId = defsRef.push(Analyzer::Definition::Function(Analyzer::FunctionDef {
      name: symbolsRef.intern(name),
      visibility: Analyzer::Visibility::PUBLIC,
      typeParams: Vector::new<Analyzer::DefinitionId>(),
      params: Vector::new<Analyzer::DefinitionId>(),
      returnType: Id::fromRaw<Analyzer::TypeTag>(0),
      isDeprecated: false,
      deprecatedMessage: Option::NONE,
      extensionTarget: Option::NONE,
      extensionMutable: false,
      isExtern: false,
      externName: Option::SOME(String::create("ignis_alloc_trace_report")),
    }));

  let mut moduleRef: &mut Analyzer::DefinitionStore = defStore;
  moduleRef.setDefModule(defId, moduleIndex);

  return defId;
}

function allocTraceModuleInfos(): Vector<Analyzer::Imports::ModuleInfo> {
  let mut infos: Vector<Analyzer::Imports::ModuleInfo> = Vector::new<Analyzer::Imports::ModuleInfo>();

  infos.push(Analyzer::Imports::ModuleInfo {
      index: 0,
      pathText: String::create("src/main.ign"),
      kind: Analyzer::Imports::ModuleKind::PROJECT,
    });

  infos.push(Analyzer::Imports::ModuleInfo {
      index: 1,
      pathText: String::create("std/memory/alloc_trace.ign"),
      kind: Analyzer::Imports::ModuleKind::STD,
    });

  return infos;
}

@test
function codegenRejectsAUserDefinitionOfTheAllocTraceSymbol(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let infos: Vector<Analyzer::Imports::ModuleInfo> = allocTraceModuleInfos();

  let decoy: Analyzer::DefinitionId = pushAllocTraceCandidate(
    &mut defStore,
    &mut symbols,
    "decoyReport",
    0,
  );

  let impostor: Analyzer::DefinitionId = pushAllocTraceCandidate(
    &mut defStore,
    &mut symbols,
    "ignisAllocTraceReport",
    0,
  );

  Test::assert(!CodegenC::isAllocTraceReport(&mut defStore, &mut symbols, &infos, decoy));
  Test::assert(!CodegenC::isAllocTraceReport(&mut defStore, &mut symbols, &infos, impostor));
  Test::assert(!CodegenC::allocTraceEnabled(&mut defStore, &mut symbols, &infos));
}

@test
function codegenAcceptsTheStdDefinitionOfTheAllocTraceSymbol(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let infos: Vector<Analyzer::Imports::ModuleInfo> = allocTraceModuleInfos();

  let hook: Analyzer::DefinitionId = pushAllocTraceCandidate(
    &mut defStore,
    &mut symbols,
    "ignisAllocTraceReport",
    1,
  );

  Test::assert(CodegenC::isAllocTraceReport(&mut defStore, &mut symbols, &infos, hook));
  Test::assert(CodegenC::allocTraceEnabled(&mut defStore, &mut symbols, &infos));
}

function codegenFixturePath(relativePath: str): Path::PathBuf {
  match (Env::currentDir()) {
    Result::OK(root) -> {
      return root.join(relativePath).normalize();
    },
    Result::ERROR(_) -> {
      Test::fail();
      return Path::PathBuf::new();
    },
  };

  return Path::PathBuf::new();
}

/// Builds the `ModuleInfo` vector the way `ignis/main.ign`'s
/// `compileDiscovered` does: one entry per `discovery.order` position, in
/// that same order, so a position here is the `moduleIndex`
/// `Analyzer::DefinitionStore::setDefModule` records for a definition in the
/// corresponding module — not the raw `BuildGraph` node index.
function codegenModuleInfosFromDiscovery(
  discovery: &DiscoveryResult
): Vector<Analyzer::Imports::ModuleInfo> {
  let mut infos: Vector<Analyzer::Imports::ModuleInfo> = Vector::new<Analyzer::Imports::ModuleInfo>();
  let mut orderIndex: u64 = 0;

  while (orderIndex < discovery.order.length()) {
    let Option::SOME(nodeIndex) = discovery.order.get(orderIndex) else {
      break;
    };
    let Option::SOME(node) = discovery.graph.nodes.get(*nodeIndex) else {
      orderIndex += 1;
      continue;
    };

    let kind: Analyzer::Imports::ModuleKind = match (node.kind) {
      BuildModuleKind::PROJECT -> Analyzer::Imports::ModuleKind::PROJECT,
      BuildModuleKind::STD -> Analyzer::Imports::ModuleKind::STD,
    };

    infos.push(Analyzer::Imports::ModuleInfo {
      index: *nodeIndex,
      pathText: node.path.toString(),
      kind: kind,
    });

    orderIndex += 1;
  }

  return infos;
}

/// The position in `infos` (i.e. the `moduleIndex` a definition in that
/// module would carry) whose path ends with `relativePath`.
function codegenModuleInfoPositionForRelativePath(
  infos: &Vector<Analyzer::Imports::ModuleInfo>,
  relativePath: str,
): Option<u64> {
  let suffix: String = String::create("/").concat(relativePath);
  let mut position: u64 = 0;

  while (position < infos.length()) {
    let Option::SOME(info) = infos.get(position) else {
      break;
    };

    if (info.pathText.endsWith(suffix.toStr())) {
      return Option::SOME(position);
    }

    position += 1;
  }

  return Option::NONE;
}

/// End-to-end: real discovery, not a hand-built `ModuleInfo` vector, has to
/// be what decides `isAllocTraceReport`. The fixture's
/// `std/tracer/mod.ign` reaches `std/tracer/report.ign` with a relative
/// import, the same shape `std/memory/allocator.ign` reaches
/// `alloc_trace.ign` with — issue #237's bug had that exact path hardcoded
/// `PROJECT`, which `codegenAcceptsTheStdDefinitionOfTheAllocTraceSymbol`
/// above could not have caught because it hand-sets `kind: STD` regardless
/// of what discovery would have produced.
@test
function codegenAllocTraceReportIsDecidedByRealDiscoveryNotAHandBuiltModuleInfo(): void {
  let fixtureRoot: Path::PathBuf = codegenFixturePath("test_cases/selfhost/codegen/alloc_trace_relative_std");
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&fixtureRoot)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let infos: Vector<Analyzer::Imports::ModuleInfo> = codegenModuleInfosFromDiscovery(&discovery);

  let Option::SOME(stdModuleIndex) = codegenModuleInfoPositionForRelativePath(&infos, "std/tracer/report.ign") else {
    Test::fail();
    return;
  };
  let Option::SOME(projectModuleIndex) = codegenModuleInfoPositionForRelativePath(&infos, "src/main.ign") else {
    Test::fail();
    return;
  };

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let hook: Analyzer::DefinitionId = pushAllocTraceCandidate(
    &mut defStore,
    &mut symbols,
    "ignisAllocTraceReport",
    stdModuleIndex,
  );

  let decoy: Analyzer::DefinitionId = pushAllocTraceCandidate(
    &mut defStore,
    &mut symbols,
    "ignisAllocTraceReport",
    projectModuleIndex,
  );

  Test::assert(CodegenC::isAllocTraceReport(&mut defStore, &mut symbols, &infos, hook));
  Test::assert(!CodegenC::isAllocTraceReport(&mut defStore, &mut symbols, &infos, decoy));
}

/// The program every freestanding emission test compiles: an entry point plus
/// an exported function that writes through a volatile pointer.
const CODEGEN_FREESTANDING_SOURCE: str = "@externName(\"freestanding_poke\")\nfunction poke(address: u64, value: u32): void {\n  let target: *mut u32 = @pointerFromInteger<*mut u32>(address);\n  @writeVolatile<u32>(target, value);\n}\n\nfunction main(): i32 {\n  poke(4096, 7);\n\n  return 0;\n}\n";

/// A `std = false` unit compiles under `-ffreestanding`: it keeps the type
/// prelude and its freestanding headers, and drops `ignis_rt.h`, every hosted
/// libc or POSIX header and the C `main` wrapper.
@test
function codegenFreestandingUnitOmitsTheHostedRuntime(): void {
  let emission: CodegenEmission = codegenEmitFreestanding(CODEGEN_FREESTANDING_SOURCE);

  Test::assert(codegenContains(&emission.source, "#include <stdint.h>"));
  Test::assert(codegenContains(&emission.source, "#include <stddef.h>"));
  Test::assert(codegenContains(&emission.source, "#include <stdbool.h>"));
  Test::assert(codegenContains(&emission.source, "freestanding_poke("));
  Test::assert(!codegenContains(&emission.source, "ignis_rt.h"));
  Test::assert(!codegenContains(&emission.source, "#include <stdio.h>"));
  Test::assert(!codegenContains(&emission.source, "#include <stdlib.h>"));
  Test::assert(!codegenContains(&emission.source, "#include <unistd.h>"));
  Test::assert(!codegenContains(&emission.source, "int main("));
  Test::assert(!codegenContains(&emission.source, "ignis_runtime_init"));
}

/// The program the extern prototype tests compile: two referenced extern
/// functions, one of them renamed and taking a function pointer, and one
/// extern function nothing calls.
const CODEGEN_EXTERN_PROTOTYPE_SOURCE: str = "extern Platform {\n  @externName(\"platform_register_handler\")\n  function registerHandler(handler: (u32) -> u32): void;\n\n  function platform_raise(vector: u32): u32;\n\n  function platform_unused(value: u32): u32;\n}\n\nfunction onInterrupt(vector: u32): u32 {\n  return vector + 1;\n}\n\nfunction main(): i32 {\n  Platform::registerHandler(onInterrupt);\n\n  return Platform::platform_raise(3) as i32;\n}\n";

/// A freestanding unit has no headers to declare extern functions, so it
/// declares each one it calls itself: under its C symbol, with a function
/// pointer parameter spelled by the signature's typedef.
@test
function codegenFreestandingUnitDeclaresTheExternFunctionsItCalls(): void {
  let emission: CodegenEmission = codegenEmitFreestanding(CODEGEN_EXTERN_PROTOTYPE_SOURCE);

  Test::assert(codegenContains(&emission.source, "extern void platform_register_handler(ignis_fn_"));
  Test::assert(codegenContains(&emission.source, "extern u32 platform_raise(u32);\n"));
  Test::assert(!codegenContains(&emission.source, "platform_unused"));
  Test::assert(!codegenContains(&emission.source, "registerHandler("));
  Test::assert(codegenContains(&emission.source, "platform_register_handler(t"));
}

/// A hosted unit leaves extern functions to the headers it includes, whose
/// spelling of a parameter type would conflict with a second declaration.
@test
function codegenHostedUnitLeavesExternFunctionsToHeaders(): void {
  let emission: CodegenEmission = codegenEmit(CODEGEN_EXTERN_PROTOTYPE_SOURCE);

  Test::assert(codegenContains(&emission.source, "platform_raise(3U)"));
  Test::assert(!codegenContains(&emission.source, "extern u32 platform_raise("));
  Test::assert(!codegenContains(&emission.source, "extern void platform_register_handler("));
}

/// A hosted unit keeps the runtime header, the hosted headers and the C
/// `main` wrapper.
@test
function codegenHostedUnitKeepsTheRuntimeAFreestandingUnitDrops(): void {
  let emission: CodegenEmission = codegenEmit(CODEGEN_FREESTANDING_SOURCE);

  Test::assert(codegenContains(&emission.source, "#include <stdint.h>"));
  Test::assert(codegenContains(&emission.source, "#include \"ignis_rt.h\""));
  Test::assert(codegenContains(&emission.source, "#include <stdio.h>"));
  Test::assert(codegenContains(&emission.source, "#include <stdlib.h>"));
  Test::assert(codegenContains(&emission.source, "int main(int argc, char** argv)"));
}

/// A freestanding `@panic` reports through the `@panicHandler` function with
/// the panic's file and line, and never reaches `fprintf` or `exit`.
@test
function codegenFreestandingRuntimeHandlerReceivesPanics(): void {
  let emission: CodegenEmission = codegenEmitFreestanding(
    "@panicHandler\n@externName(\"kernel_panic\")\nfunction onPanic(message: str, file: str, line: u32): void {\n  return;\n}\n\nfunction main(): i32 {\n  let value: i32 = @panic(\"boom\");\n\n  return value;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "    kernel_panic(\"boom\", \"codegen_tests.ign\", 8); __builtin_unreachable();\n"));
  Test::assert(!codegenContains(&emission.source, "fprintf"));
  Test::assert(!codegenContains(&emission.source, "exit("));
}

/// A freestanding drop state guard reports a use of a dropped value through
/// the `@panicHandler` function as well.
@test
function codegenFreestandingRuntimeHandlerReceivesDropGuards(): void {
  let emission: CodegenEmission = codegenEmitFreestanding(
    "@panicHandler\n@externName(\"kernel_panic\")\nfunction onPanic(message: str, file: str, line: u32): void {\n  return;\n}\n\n@implements(Drop)\nrecord Payload {\n  public value: i32;\n\n  public drop(&mut self): void {\n    return;\n  }\n\n  public peek(&self): i32 {\n    return 7;\n  }\n}\n\nfunction main(): i32 {\n  let payload: Payload = Payload { value: 1 };\n\n  return payload.peek();\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "__ignis_drop_state) { kernel_panic(\"use of dropped value\", \"codegen_tests.ign\", "));
  Test::assert(!codegenContains(&emission.source, "fprintf"));
  Test::assert(!codegenContains(&emission.source, "exit("));
}

/// A freestanding escaping closure takes its heap environment from the
/// `@allocHandler` function and returns it to the `@freeHandler` function.
@test
function codegenFreestandingRuntimeHandlersAllocateEscapingEnvironments(): void {
  let emission: CodegenEmission = codegenEmitFreestanding(
    "@allocHandler\n@externName(\"kernel_alloc\")\nfunction allocate(size: u64, align: u64): *mut u8 {\n  return @pointerFromInteger<*mut u8>(size + align);\n}\n\n@freeHandler\n@externName(\"kernel_release\")\nfunction release(pointer: *mut u8): void {\n  return;\n}\n\nfunction makeAdder(base: i32): (i32) -> i32 {\n  return (value: i32): i32 -> value + base;\n}\n\nfunction main(): i32 {\n  let add = makeAdder(40);\n\n  return add(2);\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "kernel_alloc(sizeof(struct "));
  Test::assert(codegenContains(&emission.source, "kernel_release((u8*)"));
  Test::assert(!codegenContains(&emission.source, "malloc("));
  Test::assert(!codegenContains(&emission.source, "free("));
}

/// A hosted `@panic` keeps reporting through `fprintf` and `exit`.
@test
function codegenHostedPanicWithoutRuntimeHandlerKeepsLibc(): void {
  let emission: CodegenEmission = codegenEmit(
    "function main(): i32 {\n  let value: i32 = @panic(\"boom\");\n\n  return value;\n}\n",
  );

  Test::assert(codegenContains(&emission.source, "    fprintf(stderr, \"panic: %s\\n\", \"boom\");\n    exit(101);\n"));
}

/// The file a panic at `filePath` reports in a build rooted at
/// `/work/kernel` with a user std at `/opt/kstd`.
function codegenPanicFile(filePath: str): String {
  let projectRoot: String = String::create("/work/kernel");
  let stdRoot: String = String::create("/opt/kstd");

  return CodegenC::panicFilePath(&projectRoot, &stdRoot, filePath);
}

/// A panic in a project source names its file relative to the project root.
@test
function codegenPanicFileIsRelativeToTheProjectRoot(): void {
  let file: String = codegenPanicFile("/work/kernel/src/kernel/console.ign");

  Test::assert(file.equals("src/kernel/console.ign"));
}

/// A panic in a std source names its file under `std/`, relative to the std
/// root.
@test
function codegenPanicFileIsRelativeToTheStdRoot(): void {
  let file: String = codegenPanicFile("/opt/kstd/core/mod.ign");

  Test::assert(file.equals("std/core/mod.ign"));
}

/// A panic in a file outside both roots, including one whose directory only
/// shares a prefix with a root, keeps only the file name.
@test
function codegenPanicFileOutsideBothRootsKeepsTheFileName(): void {
  let outside: String = codegenPanicFile("/home/builder/vendor/glue.ign");
  let sibling: String = codegenPanicFile("/work/kernel-old/src/main.ign");

  Test::assert(outside.equals("glue.ign"));
  Test::assert(sibling.equals("main.ign"));
}

/// A panic with no known site keeps an empty file.
@test
function codegenPanicFileWithoutASiteStaysEmpty(): void {
  let file: String = codegenPanicFile("");

  Test::assertEq<u64>(file.length(), 0);
}
