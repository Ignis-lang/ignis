import Test from "std::test";
import Fs from "std::fs";
import Io from "std::io";
import Path from "std::path";
import Process from "std::process";
import QbeTool from "@compiler::build::qbe";
import Vector from "std::vector";

import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import ParseOutput, Parser from "@compiler::parser";
import SourceFile, SourceSpan, DiagnosticBag, Severity from "@compiler::diagnostics";
import Borrowck from "@compiler::analyzer::borrowck";
import Capture from "@compiler::analyzer::capture";
import Lowering from "@compiler::analyzer::lowering";
import Mono from "@compiler::analyzer::mono";
import LirLowering from "@compiler::lir::lowering";
import CodegenQbe from "./mod";

function qbeCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      Io::eprintln(diagnostic.messageText());
      count += 1;
    }

    index += 1;
  }

  return count;
}

function qbeContains(haystack: &String, needle: str): boolean {
  let target: String = String::create(needle);

  return haystack.contains(&target);
}

/// One emitted QBE IL unit plus the stores that produced it.
record QbeEmission {
  public source: String;
  public error: Option<String>;
  public errorSpan: Option<SourceSpan>;
  public functions: u64;
  public defStore: Analyzer::DefinitionStore;
  public symbols: Analyzer::SymbolTable;
}

/// Runs `source` through the whole pipeline the driver uses and returns the
/// QBE IL it emitted. Parse, analyzer and ownership errors are rejected, so an
/// emitted unit only ever describes a program the rest of the pipeline accepts.
function qbeEmit(source: str): QbeEmission {
  return qbeEmitWithHarnessRoot(source, "");
}

function qbeEmitWithHarnessRoot(source: str, rootName: str): QbeEmission {
  let file: SourceFile = SourceFile::create("qbe_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(qbeCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(qbeCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(qbeCountErrors(&output.diagnostics), 0);

  let mut hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let captureDiagnostics: DiagnosticBag = Capture::populateClosureCaptures(&mut defStore, &mut typeStore, &mut symbols, &mut hir);

  Test::assertEq<u64>(qbeCountErrors(&captureDiagnostics), 0);

  let noHandlers: Vector<u32> = Vector::new<u32>();
  let monoResult: Mono::MonoOutput = Mono::runWithRoots(&mut defStore, &mut typeStore, &mut symbols, &hir, false, &noHandlers);

  let checked: Borrowck::BorrowckOutput = Borrowck::checkModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &monoResult.hir,
  );

  Test::assertEq<u64>(qbeCountErrors(&checked.diagnostics), 0);

  let constValues: &Analyzer::ConstEval::ConstValueMap = &output.constValues.values;

  let lowered: LirLowering::LowerModuleResult = LirLowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &monoResult.hir,
    &checked.dropSchedules,
    constValues,
  );

  let mut externalSymbols: Vector<u32> = Vector::new<u32>();
  let mut functionIndex: u64 = 0;
  while (functionIndex < lowered.program.functions.length()) {
    if (let Option::SOME(function_) = lowered.program.functions.functionAt(functionIndex)) {
      if (let Option::SOME(Analyzer::Definition::Function(definition)) = defStore.get(function_.defId)) {
        if (let Option::SOME(name) = symbols.resolve(definition.name)) {
          let text: String = String::create(name);
          if (text.equals(rootName)) {
            externalSymbols.push(function_.defId.raw());
          }
        }
      }
    }
    functionIndex += 1;
  }
  let noForeignDefinitions: Vector<u32> = Vector::new<u32>();
  let emitted: CodegenQbe::EmitOutput = CodegenQbe::emitProgram(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &lowered.program,
    &externalSymbols,
    &noForeignDefinitions,
  );

  return QbeEmission {
    source: emitted.source,
    error: emitted.error,
    errorSpan: emitted.errorSpan,
    functions: emitted.functions,
    defStore: defStore,
    symbols: symbols,
  };
}

function qbeRunExpected(source: str, expectedCode: i32): void {
  qbeRunExpectedLinked(source, expectedCode, "", "", "");
}

function qbeRunExpectedLinked(
  source: str,
  expectedCode: i32,
  nativeSource: str,
  foreignRoot: str,
  expectedStderr: str
): void {
  let emission: QbeEmission = qbeEmitWithHarnessRoot(source, foreignRoot);
  if (let Option::SOME(error) = &emission.error) {
    Io::eprintln(error.toStr());
    Test::fail();
    return;
  }
  let work: String = `build/qbe-construct-${Process::id()}`;
  let directory: Path::PathBuf = Path::PathBuf::create(work.toStr());
  Test::assert(Fs::createDirAll(&directory).isOk());
  let il: Path::PathBuf = directory.join("unit.ssa");
  let assembly: Path::PathBuf = directory.join("unit.s");
  let object: Path::PathBuf = directory.join("unit.o");
  let executable: Path::PathBuf = directory.join("program");
  Test::assert(Fs::writeString(&il, &emission.source).isOk());
  let lowered: Result<boolean, DiagnosticBag> = QbeTool::lowerToAssembly("qbe", &il, &assembly);
  if (let Result::ERROR(bag) = lowered) {
    if (let Option::SOME(diagnostic) = bag.get(0)) {
      Io::eprintln(diagnostic.messageText());
    }
    Io::eprintln(emission.source.toStr());
    Test::fail();
    return;
  }
  let flags: Vector<String> = Vector::new<String>();
  Test::assert(QbeTool::assembleObject("cc", &assembly, &object, &flags, &flags).isOk());
  let mut link: Process::Command = Process::command("cc");
  link.arg(object.asStr());
  let nativeText: String = String::create(nativeSource);
  if (nativeText.length() > 0) {
    let native: Path::PathBuf = directory.join("native.c");
    let text: String = String::create(nativeSource);
    Test::assert(Fs::writeString(&native, &text).isOk());
    link.arg(native.asStr());
  }
  link.arg("-o");
  link.arg(executable.asStr());
  let Result::OK(linked) = link.output() else {
    Test::fail();
    return;
  };
  if (!linked.status().success) {
    Io::eprintln(linked.stderr().toStr());
    Test::fail();
    return;
  }
  let command: Process::Command = Process::command(executable.asStr());
  let Result::OK(output) = command.output() else {
    Test::fail();
    return;
  };
  Test::assertEq<i32>(output.status().code, expectedCode);
  Test::assertEq<str>(output.stdout().toStr(), "");
  Test::assertEq<str>(output.stderr().toStr(), expectedStderr);
}

@test
function qbeEmitsIntegerLocalsAndArithmetic(): void {
  qbeRunExpected("function addOne(value: i32): i32 { let doubled: i32 = value + value; return doubled + 1; } function main(): i32 { return addOne(20); }", 41);
}

@test
function qbeEmitsBooleanIntegerCasts(): void {
  qbeRunExpected("function widen(flag: boolean): u64 { return flag as u64; } function main(): i32 { if (widen(true) != 1 || widen(false) != 0) { return 1; } return 0; }", 0);
}

@test
function qbeEmitsSignedNarrowArithmetic(): void {
  qbeRunExpected("function main(): i32 { let a: i8 = 100; let b: i8 = 100; let c: i8 = a + b; return c == -56 ? 0 : 1; }", 0);
}

@test
function qbeMasksShiftCountsByDeclaredWidth(): void {
  qbeRunExpected("function main(): i32 { let narrow: u8 = 1; if ((narrow << 9) != 2) { return 1; } let middle: u16 = 1; if ((middle << 17) != 2) { return 2; } let wide: u64 = 1; let count: u64 = 64; if ((wide << count) != 1) { return 3; } return 0; }", 0);
}

@test
function qbeEmitsUnsignedIntegerBounds(): void {
  qbeRunExpected("function main(): i32 { return @minOf<u8>() as i32; }", 0);
  qbeRunExpected("function main(): i32 { if (@minOf<u16>() != 0) { return 1; } return 0; }", 0);
  qbeRunExpected("function main(): i32 { if (@minOf<u32>() != 0) { return 1; } return 0; }", 0);
  qbeRunExpected("function main(): i32 { if (@minOf<u64>() != 0) { return 1; } return 0; }", 0);
  qbeRunExpected("function main(): i32 { if (@maxOf<u8>() != 255 || @maxOf<u16>() != 65535 || @maxOf<u32>() != 4294967295 || @maxOf<u64>() != 18446744073709551615) { return 1; } return 0; }", 0);
}

@test
function qbeEmitsUnsignedNarrowArithmetic(): void {
  qbeRunExpected("function main(): i32 { let a: u8 = 200; let b: u8 = 100; let c: u8 = a + b; let d: u32 = c as u32; let e: u64 = d as u64; return e == 44 ? 0 : 1; }", 0);
}

@test
function qbeEmitsSixtyFourBitArithmetic(): void {
  qbeRunExpected("function main(): i32 { let a: i64 = 10000000000; let b: i64 = a * 3; let c: u64 = 18446744073709551615; return b == 30000000000 && c > 0 ? 0 : 1; }", 0);
}

@test
function qbeEmitsComparisonsBranchesAndLoops(): void {
  qbeRunExpected("function classify(value: i32): i32 { if (value < 10) { return 1; } return 0; } function sumTo(limit: i32): i32 { let mut total: i32 = 0; let mut i: i32 = 0; while (i < limit) { total = total + i; i = i + 1; } return total; } function main(): i32 { return classify(5) + sumTo(4); }", 7);
}

@test
function qbeSkipsExternalLibraryDefinitions(): void {
  let emission: QbeEmission = qbeEmit("@externName(\"prebuilt\") function prebuilt(value: f64): f64 { return value; } function main(): i32 { return 3; }");
  Test::assert(emission.error.isNone());
  Test::assert(!qbeContains(&emission.source, "$prebuilt"));
  Test::assertEq<u64>(emission.functions, 1);
}

@test
function qbeEmitsCalls(): void {
  qbeRunExpected("extern LibC { function abs(value: i32): i32; } function twice(value: i32): i32 { return value * 2; } function main(): i32 { return twice(abs(-5)); }", 10);
}

@test
function qbeFailsClosedOnUnsupportedRecordLayouts(): void {
  let empty: QbeEmission = qbeEmit("record Empty {} function main(): i32 { let value: Empty = Empty {}; return 0; }");
  Test::assert(empty.error.isSome());
  Test::assert(empty.source.length() == 0);
  let aligned: QbeEmission = qbeEmit("@aligned(32) record Wide { public x: i32; } function main(): i32 { let value: Wide = Wide { x: 42 }; return value.x; }");
  Test::assert(aligned.error.isSome());
  Test::assert(aligned.source.length() == 0);
}

@test
function qbeReportsAnUnsupportedInstructionAtItsFunction(): void {
  let source: str = "function main(): i32 { return (half(4.0) as i32) - 2; }\nfunction half(value: f64): f64 { return value / 2.0; }";
  let emission: QbeEmission = qbeEmit(source);
  Test::assert(emission.error.isSome());
  let Option::SOME(span) = emission.errorSpan else {
    Test::fail();
    return;
  };
  let bodyStart: u64 = 87;
  Test::assertEq<u64>(span.start, bodyStart);
}

@test
function qbeEmitsUnreachableTerminator(): void {
  qbeRunExpected("function main(): i32 { let flag: boolean = false; if (flag) { @unreachable(); } return 42; }", 42);
}

@test
function qbeEmitsVariadicExternCalls(): void {
  let source: str = "extern Native { @externName(\"dprintf\") function printValue(descriptor: i32, format: str, value: i32): i32; } function main(): i32 { Native::printValue(2, \"number: %d\\n\", 42); return 0; }";
  let emission: QbeEmission = qbeEmit(source);
  Test::assert(emission.error.isNone());
  Test::assert(qbeContains(&emission.source, ", ...)"));
  qbeRunExpectedLinked(source, 0, "", "", "number: 42\n");
}

@test
function qbeStopsAfterDivergingInitializers(): void {
  qbeRunExpectedLinked("function main(): i32 { let value: u64 = @panic(\"init\"); return value as i32; }", 101, "", "", "panic: init\n");
  qbeRunExpectedLinked("function stop(): never { @panic(\"stop\"); } function main(): i32 { let value: i32 = stop(); return value; }", 101, "", "", "panic: stop\n");
}

@test
function qbeEmitsPanicExitAndStderr(): void {
  qbeRunExpectedLinked("function main(): i32 { @panic(\"bail\"); }", 101, "", "", "panic: bail\n");
}

@test
function qbeEmitsPackedRecordLayout(): void {
  qbeRunExpected("@packed @aligned(8) record PackedAligned { a: i32; b: i8; c: i16; } function main(): i32 { return (@sizeOf<PackedAligned>() * 10 + @alignOf<PackedAligned>()) as i32; }", 88);
  qbeRunExpected("@packed record Compact { a: i32; b: i8; } function main(): i32 { return (@sizeOf<Compact>() * 10 + @alignOf<Compact>()) as i32; }", 51);
}

@test
function qbeEmitsRecordsAsAggregates(): void {
  qbeRunExpected("record Point { public x: i32; public y: i32; } function main(): i32 { let p: Point = Point { x: 7, y: 8 }; let q: Point = p; return q.x + q.y; }", 15);
}

@test
function qbeNativeRecordAbiMatchesC(): void {
  let source: str = "record Plain { public x: i32; public y: i32; } @packed record Packed { public x: u8; public y: i32; } record Byte { public x: u8; } @externName(\"qbeAddPlain\") function qbeAddPlain(value: Plain): i32 { return value.x + value.y; } extern Native { function nativeMake(value: i32): Plain; function nativeSum(value: Plain): i32; function nativePacked(value: Packed): i32; function nativeByte(value: Byte): i32; function nativeExercise(): i32; } function main(): i32 { return nativeSum(nativeMake(3)) + nativePacked(Packed { x: 2, y: 30 }) + nativeByte(Byte { x: 1 }) + nativeExercise(); }";
  let native: str = "#include <stdint.h>\ntypedef struct { int32_t x, y; } Plain;\ntypedef struct __attribute__((packed)) { uint8_t x; int32_t y; } Packed;\ntypedef struct { uint8_t x; } Byte;\nextern int32_t qbeAddPlain(Plain);\nPlain nativeMake(int32_t value) { return (Plain){value, value + 1}; }\nint32_t nativeSum(Plain value) { return value.x + value.y; }\nint32_t nativePacked(Packed value) { return value.x + value.y; }\nint32_t nativeByte(Byte value) { return value.x; }\nint32_t nativeExercise(void) { return qbeAddPlain((Plain){1, 1}); }\n";
  qbeRunExpectedLinked(source, 42, native, "qbeAddPlain", "");
}

@test
function qbeEmitsNativeRecordArgumentsAndReturns(): void {
  let source: str = "record Point { public x: i32; public y: i32; } function makePoint(value: i32): Point { return Point { x: value, y: value + 1 }; } function sum(point: Point): i32 { return point.x + point.y; } function main(): i32 { return sum(makePoint(3)); }";
  let emission: QbeEmission = qbeEmit(source);
  Test::assert(emission.error.isNone());
  Test::assert(qbeContains(&emission.source, "type :"));
  Test::assert(qbeContains(&emission.source, "function :"));
  Test::assert(!qbeContains(&emission.source, "l %ret"));
  qbeRunExpected(source, 7);
}

@test
function qbePreservesGlobalAlignment(): void {
  let source: str = "record Slots { static mut PRIOR: u8 = 1; @aligned(32) static mut VALUE: i32 = 0; } function main(): i32 { let pointer: *i32 = &Slots::VALUE as *i32; return (@integerFromPointer(pointer) % 32) as i32; }";
  let emission: QbeEmission = qbeEmit(source);
  Test::assert(emission.error.isNone());
  Test::assert(qbeContains(&emission.source, "align 32"));
  qbeRunExpected(source, 0);
}

@test
function qbeEmitsStringLiteralsAndGlobals(): void {
  qbeRunExpected("extern LibC { function strcmp(left: str, right: str): i32; } record Counter { static mut TOTAL: i32 = 3; } const GREETING: str = \"hey\"; function main(): i32 { let s: str = GREETING; Counter::TOTAL = Counter::TOTAL + 1; return Counter::TOTAL + strcmp(s, \"hey\"); }", 4);
}

@test
function qbeFailsClosedOnVolatileMemory(): void {
  let read: QbeEmission = qbeEmit("function main(): i32 { let value: i32 = 1; let pointer: *i32 = &value as *i32; return @readVolatile<i32>(pointer); }");
  Test::assert(read.error.isSome());
  Test::assert(read.source.length() == 0);
  let write: QbeEmission = qbeEmit("function main(): i32 { let mut value: i32 = 1; let pointer: *mut i32 = &mut value as *mut i32; @writeVolatile<i32>(pointer, 42); return 0; }");
  Test::assert(write.error.isSome());
  Test::assert(write.source.length() == 0);
}

@test
function qbeEmitsPointerOperations(): void {
  qbeRunExpected("function main(): i32 { let mut slot: i32 = 1; let pointer: *mut i32 = &mut slot as *mut i32; *pointer = 41; return *pointer; }", 41);
}

@test
function qbeEmitsFieldlessEnumsAsTags(): void {
  qbeRunExpected("enum Color { RED, GREEN } function pick(c: Color): i32 { if (c == Color::GREEN) { return 1; } return 0; } function main(): i32 { return pick(Color::RED); }", 0);
}

@test
function qbeEmitsMainWrapper(): void {
  qbeRunExpected("function main(): i32 { return 42; }", 42);
}

/// The failure names the function by its written name. A definition id in
/// the message would churn the pinned lane skip reasons whenever an upstream
/// module or the corpus shifts the ids.
@test
function qbeNamesTheFailingFunctionWithoutADefinitionId(): void {
  let emission: QbeEmission = qbeEmit("function scale(value: f64): f64 { return value; } function main(): i32 { return scale(1.5) as i32; }");
  let Option::SOME(error) = &emission.error else {
    Test::fail();
    return;
  };
  Test::assertEq<str>(error.toStr(), "not supported by the qbe target yet: Function (scale)");
  Test::assertEq<u64>(emission.source.length(), 0);
  Test::assertEq<u64>(emission.functions, 0);
}

/// Closures no longer fail closed: the emitted unit declares the closure
/// struct and the thunk, and the program runs.
@test
function qbeEmitsClosureValues(): void {
  let source: str = "function makeAdder(base: i32): (i32) -> i32 { return (x: i32): i32 -> x + base; } function main(): i32 { let addBase = makeAdder(2); return addBase(40); }";
  let emission: QbeEmission = qbeEmit(source);
  Test::assert(emission.error.isNone());
  Test::assert(qbeContains(&emission.source, "type :ignis_closure_"));
  Test::assert(qbeContains(&emission.source, "$malloc"));
  qbeRunExpected(source, 42);
}

@test
function qbeEmitsPayloadEnums(): void {
  let source: str = "enum Shape { CIRCLE(i32), SQUARE(i32) } function area(shape: Shape): i32 { return match (shape) { Shape::CIRCLE(radius) -> radius * 2, Shape::SQUARE(side) -> side + 1 }; } function main(): i32 { let circle: i32 = area(Shape::CIRCLE(20)); let square: i32 = area(Shape::SQUARE(1)); return circle + square; }";
  let emission: QbeEmission = qbeEmit(source);
  Test::assert(emission.error.isNone());
  Test::assert(qbeContains(&emission.source, "type :Shape_"));
  qbeRunExpected(source, 42);
}

@test
function qbeEmitsGenericOptionPayloadEnums(): void {
  let source: str = "enum Option<T> { NONE, SOME(T) } function maybe(value: i32): Option<i32> { if (value > 0) { return Option::SOME(value); } return Option::NONE; } function main(): i32 { let mut total: i32 = 0; if (let Option::SOME(value) = maybe(40)) { total = value; } let fromMatch: i32 = match (maybe(2)) { Option::SOME(value) -> value, Option::NONE -> 0 }; return total + fromMatch; }";
  qbeRunExpected(source, 42);
}

@test
function qbeEmitsGenericResultPayloadEnums(): void {
  let source: str = "enum Result<T, E> { OK(T), ERROR(E) } function compute(flag: boolean): Result<i64, i32> { if (flag) { return Result::OK(40); } return Result::ERROR(9); } function main(): i32 { let result: Result<i64, i32> = compute(true); let value: i32 = match (result) { Result::OK(ok) -> ok as i32, Result::ERROR(err) -> err }; return value + 2; }";
  qbeRunExpected(source, 42);
}

@test
function qbeEmitsRecordPayloadEnums(): void {
  let source: str = "record Point { public x: i32; public y: i32; } enum Geometry { POINT(Point), NONE } function sum(shape: Geometry): i32 { return match (shape) { Geometry::POINT(point) -> point.x + point.y, Geometry::NONE -> 0 }; } function main(): i32 { return sum(Geometry::POINT(Point { x: 30, y: 12 })); }";
  qbeRunExpected(source, 42);
}

/// A variant whose payload fields have different widths: the `u8` sits at the
/// start of the union and the `i64` at its 8-byte-aligned offset, so a wrong
/// offset reads the wrong bytes.
@test
function qbeEmitsWidePayloadEnumFields(): void {
  let source: str = "enum Mixed { PAIR(u8, i64), ALONE(i32) } function measure(value: Mixed): i32 { return match (value) { Mixed::PAIR(byte, word) -> (byte as i32) + (word as i32), Mixed::ALONE(single) -> single }; } function main(): i32 { return measure(Mixed::PAIR(2, 40)); }";
  qbeRunExpected(source, 42);
}

/// An enum travels by value through a parameter and a result, so QBE
/// classifies the aggregate exactly as the C struct does.
@test
function qbePassesPayloadEnumsByValue(): void {
  let source: str = "enum Boxed { VALUE(i32), EMPTY } function wrap(value: i32): Boxed { return Boxed::VALUE(value); } function unwrap(held: Boxed): i32 { return match (held) { Boxed::VALUE(value) -> value, Boxed::EMPTY -> 0 }; } function main(): i32 { return unwrap(wrap(42)); }";
  let emission: QbeEmission = qbeEmit(source);
  Test::assert(emission.error.isNone());
  Test::assert(qbeContains(&emission.source, "(:Boxed_"));
  qbeRunExpected(source, 42);
}

@test
function qbeEmitsNestedPayloadEnums(): void {
  let source: str = "enum Shape { CIRCLE(i32), EMPTY } enum Option<T> { NONE, SOME(T) } function maybe(flag: boolean): Option<Shape> { if (flag) { return Option::SOME(Shape::CIRCLE(40)); } return Option::NONE; } function main(): i32 { let option: Option<Shape> = maybe(true); let mut area: i32 = 0; if (let Option::SOME(shape) = option) { area = match (shape) { Shape::CIRCLE(radius) -> radius, Shape::EMPTY -> 0 }; } return area + 2; }";
  qbeRunExpected(source, 42);
}

@test
function qbeEmitsFixedArrayPayloadEnums(): void {
  let source: str = "enum Bucket { ITEMS(i32[4]), EMPTY } function edgeSum(bucket: Bucket): i32 { return match (bucket) { Bucket::ITEMS(values) -> values[0] + values[3], Bucket::EMPTY -> 0 }; } function main(): i32 { let values: i32[4] = @splat<i32[4]>(21); return edgeSum(Bucket::ITEMS(values)); }";
  qbeRunExpected(source, 42);
}

@test
function qbeFailsClosedOnFloats(): void {
  let emission: QbeEmission = qbeEmit("function main(): i32 { let x: f64 = 1.5; return x as i32; }");
  let Option::SOME(error) = &emission.error else {
    Test::fail();
    return;
  };
  Test::assert(qbeContains(&error, "not supported by the qbe target yet: "));
  Test::assertEq<u64>(emission.source.length(), 0);
}

@test
function qbeReviewF18CopiesAggregatePointee(): void {
  qbeRunExpected("record Point { public x: i32; public y: i32; } function main(): i32 { let mut point: Point = Point { x: 1, y: 2 }; let pointer: *Point = &point as *Point; let value: Point = *pointer; point.y = 9; return value.y; }", 2);
}

@test
function qbeReviewF28CopiesAggregateLocal(): void {
  qbeRunExpected("record Point { public x: i32; public y: i32; } function main(): i32 { let mut point: Point = Point { x: 1, y: 2 }; let value: Point = point; point.x = 9; return value.x; }", 1);
}

@test
function qbeReviewF19PreservesEscapedBytes(): void {
  qbeRunExpected("function main(): i32 { let text: str = \"\\u{1}\\u{80}\"; let bytes: *u8 = text as *u8; if (@read<u8>(bytes) != 1) { return 1; } if (@read<u8>(bytes + 1) != 194) { return 2; } if (@read<u8>(bytes + 2) != 128) { return 3; } return 0; }", 0);
}

@test
function qbeReviewF20NormalizesNativeBoolean(): void {
  qbeRunExpectedLinked("extern Native { function dirtyBool(): boolean; } function main(): i32 { return Native::dirtyBool() == true ? 0 : 1; }", 0, "#include <stdbool.h>\n__attribute__((naked)) bool dirtyBool(void) { __asm__(\"movl $0x7f000001, %eax\\n\\tret\"); }\n", "", "");
}

@test
function qbeReviewF21EmitsRecordGlobals(): void {
  qbeRunExpected("record Point { public x: i32; public y: i32; } @packed record Packed { public x: u8; public y: i32; } const ORIGIN: Point = Point { x: 7, y: 8 }; const COMPACT: Packed = Packed { x: 1, y: 9 }; function main(): i32 { let point: *Point = &ORIGIN as *Point; let packed: *Packed = &COMPACT as *Packed; return (*point).y + (*packed).y; }", 17);
}

@test
function qbeReviewF24RejectsFloatGlobal(): void {
  let emission: QbeEmission = qbeEmit("extern Native { function readScale(pointer: *f64): i32; } const SCALE: f64 = 2.5; function main(): i32 { return Native::readScale(&SCALE as *f64); }");
  let Option::SOME(error) = &emission.error else {
    Test::fail();
    return;
  };
  Test::assert(qbeContains(&error, "not supported by the qbe target yet: "));
  Test::assertEq<u64>(emission.source.length(), 0);
}

@test
function qbeReviewF22EmitsArrayValueAbi(): void {
  qbeRunExpected("function identity(values: i32[4]): i32[4] { return values; } function main(): i32 { let values: i32[4] = @splat<i32[4]>(7); let returned: i32[4] = identity(values); return returned[0] + returned[3]; }", 14);
}

/// A fixed-array parameter is passed as the address of its first element,
/// the convention the C backend uses, so a QBE caller and a C callee (or the
/// reverse) agree. Parameters are immutable, so the callee never needs a
/// copy of its own.
@test
function qbePassesFixedArrayParametersByAddress(): void {
  let emission: QbeEmission = qbeEmit("function first(values: i32[4]): i32 { return values[0] + values[3]; } function main(): i32 { let values: i32[4] = @splat<i32[4]>(7); return first(values); }");
  Test::assert(emission.error.isNone());
  Test::assert(qbeContains(&emission.source, "(l %t0)"));
  Test::assert(!qbeContains(&emission.source, "(:ignis_array_"));
  qbeRunExpected("function first(values: i32[4]): i32 { return values[0] + values[3]; } function main(): i32 { let values: i32[4] = @splat<i32[4]>(7); return first(values); }", 14);
}

@test
function qbeReviewF23RejectsFunctionSplat(): void {
  let emission: QbeEmission = qbeEmit("type Callback = (i32) -> i32; function callback(value: i32): i32 { return value + 1; } function main(): i32 { let callbacks: Callback[2] = @splat<Callback[2]>(callback); return 0; }");
  let Option::SOME(error) = &emission.error else {
    Test::fail();
    return;
  };
  Test::assert(qbeContains(&error, "not supported by the qbe target yet: "));
  Test::assertEq<u64>(emission.source.length(), 0);
}

@test
function qbeReviewF21PadsNestedRecordGlobals(): void {
  qbeRunExpected("record Inner { public word: i32; public byte: u8; } record Outer { public inner: Inner; public tail: u8; } const NESTED: Outer = Outer { inner: Inner { word: 7, byte: 2 }, tail: 9 }; function main(): i32 { let pointer: *Outer = &NESTED as *Outer; return (*pointer).tail as i32; }", 9);
}

/// A record implementing `Drop` runs its destructor once when its scope ends,
/// at the point the C backend drops it.
@test
function qbeDropsRecordAtScopeEnd(): void {
  qbeRunExpected("record Counter { static mut DROPS: i32 = 0; } @implements(Drop) record Resource { public value: i32; drop(&mut self): void { Counter::DROPS += 1; return; } } function main(): i32 { { let r: Resource = Resource { value: 7 }; if (r.value != 7) { return 1; } } return Counter::DROPS - 1; }", 0);
}

/// A record without the Drop trait drops its droppable fields, and only those.
@test
function qbeDropsRecordFields(): void {
  qbeRunExpected("record Counter { static mut DROPS: i32 = 0; } @implements(Drop) record Resource { public value: i32; drop(&mut self): void { Counter::DROPS += 1; return; } } record Holder { public resource: Resource; public tag: i32; } function main(): i32 { { let h: Holder = Holder { resource: Resource { value: 3 }, tag: 9 }; if (h.tag != 9) { return 1; } } return Counter::DROPS - 1; }", 0);
}

/// A payload enum drops the live variant's payload, dispatching on the tag.
@test
function qbeDropsPayloadEnumVariant(): void {
  qbeRunExpected("record Counter { static mut DROPS: i32 = 0; } @implements(Drop) record Resource { public value: i32; drop(&mut self): void { Counter::DROPS += 1; return; } } enum Maybe { ITEM(Resource), EMPTY } function main(): i32 { { let a: Maybe = Maybe::ITEM(Resource { value: 1 }); match (a) { Maybe::ITEM(payload) -> { if (payload.value != 1) { return 1; } }, Maybe::EMPTY -> {}, }; } if (Counter::DROPS != 1) { return 2; } { let b: Maybe = Maybe::EMPTY; } if (Counter::DROPS != 1) { return 3; } return 0; }", 0);
}

/// A fieldless enum with the Drop trait is an aggregate with a drop-state byte
/// and runs its destructor.
@test
function qbeDropsFieldlessEnum(): void {
  qbeRunExpected("record Counter { static mut DROPS: i32 = 0; } @implements(Drop) enum Flag { OFF, ON, drop(&mut self): void { Counter::DROPS += 1; return; } } function main(): i32 { { let f: Flag = Flag::ON; if (f == Flag::OFF) { return 1; } } return Counter::DROPS - 1; }", 0);
}

/// Moving a value out of a local must not drop it twice: the moved-from place
/// is marked and its later drop becomes a no-op.
@test
function qbeMoveOutDoesNotDoubleDrop(): void {
  qbeRunExpected("record Counter { static mut DROPS: i32 = 0; } @implements(Drop) record Resource { public value: i32; drop(&mut self): void { Counter::DROPS += 1; return; } } function take(resource: Resource): i32 { return resource.value; } function main(): i32 { { let r: Resource = Resource { value: 4 }; let taken: i32 = take(r); if (taken != 4) { return 1; } } return Counter::DROPS - 1; }", 0);
}

/// A `return` and a `break` leave their scope through the same drop point, so a
/// resource is freed exactly once on each path.
@test
function qbeEarlyExitDropsOnce(): void {
  qbeRunExpected("record Counter { static mut DROPS: i32 = 0; } @implements(Drop) record Resource { public value: i32; drop(&mut self): void { Counter::DROPS += 1; return; } } function early(flag: boolean): i32 { { let r: Resource = Resource { value: 1 }; if (flag) { return 10; } } return 0; } function loopBreak(): i32 { let mut i: i32 = 0; while (i < 3) { { let r: Resource = Resource { value: i }; if (i == 1) { break; } } i += 1; } return i; } function main(): i32 { let a: i32 = early(true); if (a != 10) { return 1; } if (Counter::DROPS != 1) { return 2; } let b: i32 = early(false); if (b != 0) { return 3; } if (Counter::DROPS != 2) { return 4; } let c: i32 = loopBreak(); if (c != 1) { return 5; } if (Counter::DROPS != 4) { return 6; } return 0; }", 0);
}

/// `@dropInPlace` reaches the same helper as an automatic drop, and the later
/// scope-end drop stays a no-op through the drop-state byte.
@test
function qbeDropInPlaceBuiltin(): void {
  qbeRunExpected("record Counter { static mut DROPS: i32 = 0; } @implements(Drop) record Resource { public value: i32; drop(&mut self): void { Counter::DROPS += 1; return; } } function main(): i32 { { let mut r: Resource = Resource { value: 5 }; @dropInPlace<Resource>((&mut r) as *mut Resource); } return Counter::DROPS - 1; }", 0);
}

/// A hex or binary integer literal over 32 bits keeps its full value through a
/// widening cast; the constant is copied into the `l` class, never
/// zero-extended from the 32-bit source class (which would truncate it).
@test
function qbeWidensIntegerLiteralCastToItsFullValue(): void {
  qbeRunExpected("function main(): i32 { let high: u64 = 0x100000000 as u64; let binaryValue: u64 = 0b100000000000000000000000000000000 as u64; let maximum: i64 = 0x7FFFFFFFFFFFFFFF as i64; if ((high >> 32) != 1) { return 1; } if ((binaryValue >> 32) != 1) { return 2; } if ((maximum >> 62) != 1) { return 3; } return 42; }", 42);
}

/// A closure that captures nothing is a closure value like any other: built
/// with `MakeClosure`, called through its thunk, and dropped.
@test
function qbeEmitsNonCapturingClosure(): void {
  qbeRunExpected("function main(): i32 { let double = (x: i32): i32 -> x * 2; return double(21); }", 42);
}

/// A read-only capture reaches the environment the thunk reads back. `@ref`
/// keeps a pointer to the captured place, so a later write is visible.
@test
function qbeCapturesByReference(): void {
  qbeRunExpected("function main(): i32 { let mut x: i32 = 10; let getX = (): i32 -> @ref x; x = 42; return getX(); }", 42);
}

/// A mutable capture writes through the environment pointer, so the mutation
/// is visible after the call.
@test
function qbeCapturesByMutableReference(): void {
  qbeRunExpected("function main(): i32 { let mut counter: i32 = 0; let inc = (): void -> { counter = counter + 1; }; inc(); inc(); return counter + 40; }", 42);
}

/// A by-value capture of a droppable value owns it in the environment; the
/// closure's environment drop function releases it exactly once.
@test
function qbeCapturesDroppableValueByMoveOnce(): void {
  qbeRunExpected("record Drops { static mut COUNT: i32 = 0; } @implements(Drop) record Tracked { public id: i32; drop(&mut self): void { Drops::COUNT += 1; return; } } function idOf(value: &Tracked): i32 { return value.id; } function main(): i32 { let mut observed: i32 = 0; { let held: Tracked = Tracked { id: 42 }; let read = (): i32 -> { let seen: &Tracked = &held; let _ = @move held; return idOf(seen); }; observed = read(); } if (observed != 42) { return 1; } if (Drops::COUNT != 1) { return 2; } return 0; }", 0);
}

/// An escaping closure gets a heap environment; the binding that receives it
/// calls it and releases it.
@test
function qbeEmitsEscapingClosureReturnedAndCalled(): void {
  qbeRunExpected("function makeAdder(base: i32): (i32) -> i32 { return (x: i32): i32 -> x + base; } function main(): i32 { let add = makeAdder(40); return add(2); }", 42);
}

/// A closure parameter is a closure value passed by value; the callee calls it
/// through the thunk.
@test
function qbePassesClosureAsParameter(): void {
  qbeRunExpected("function apply(f: (i32) -> i32, x: i32): i32 { return f(x); } function main(): i32 { let offset: i32 = 30; let add = (n: i32): i32 -> n + offset; return apply(add, 12); }", 42);
}

/// A closure stored in a record field is dropped with the record, running its
/// environment drop function.
@test
function qbeDropsClosureInRecordField(): void {
  qbeRunExpected("record Drops { static mut COUNT: i32 = 0; } @implements(Drop) record Tracked { public id: i32; drop(&mut self): void { Drops::COUNT += 1; return; } } record Holder { public callback: () -> i32; } function idOf(value: &Tracked): i32 { return value.id; } function main(): i32 { { let held: Tracked = Tracked { id: 42 }; let callback = (): i32 -> { let seen: &Tracked = &held; let _ = @move held; return idOf(seen); }; let holder: Holder = Holder { callback: callback }; let stored: () -> i32 = holder.callback; if (stored() != 42) { return 1; } } if (Drops::COUNT != 1) { return 2; } return 0; }", 0);
}

/// A closure stored in an enum payload is moved out by the `match` and its
/// environment is released exactly once.
@test
function qbeDropsClosureInEnumPayload(): void {
  qbeRunExpected("record Drops { static mut COUNT: i32 = 0; } @implements(Drop) record Tracked { public id: i32; drop(&mut self): void { Drops::COUNT += 1; return; } } enum Slot { FULL(() -> i32), EMPTY } function idOf(value: &Tracked): i32 { return value.id; } function main(): i32 { let mut got: i32 = 0; { let held: Tracked = Tracked { id: 42 }; let callback = (): i32 -> { let seen: &Tracked = &held; let _ = @move held; return idOf(seen); }; let slot: Slot = Slot::FULL(callback); got = match (slot) { Slot::FULL(call) -> call(), Slot::EMPTY -> 0, }; } if (got != 42) { return 1; } if (Drops::COUNT != 1) { return 2; } return 0; }", 0);
}

/// A closure takes and returns a record by value.
@test
function qbeClosureTakesAndReturnsRecord(): void {
  qbeRunExpected("record Point { public x: i32; public y: i32; } function main(): i32 { let shift = (p: Point): Point -> Point { x: p.x + 1, y: p.y + 1 }; let p: Point = shift(Point { x: 19, y: 21 }); return p.x + p.y; }", 42);
}

/// A closure takes a fixed array by address, the convention the C backend
/// uses, so both backends agree on the argument.
@test
function qbeClosureTakesFixedArray(): void {
  qbeRunExpected("function main(): i32 { let sum = (values: i32[4]): i32 -> values[0] + values[3]; let values: i32[4] = @splat<i32[4]>(21); return sum(values); }", 42);
}

/// `@noescape` keeps the environment in the caller's frame; the callee's
/// promise is what lets a by-reference capture stay on the stack.
@test
function qbeNoescapeClosureKeepsStackEnvironment(): void {
  qbeRunExpected("function applyTwice(@noescape f: (i32) -> i32, x: i32): i32 { return f(f(x)); } function main(): i32 { let base: i32 = 20; let add = (x: i32): i32 -> x + base; return applyTwice(add, 2); }", 42);
}
