import Analyzer from "@compiler::analyzer";
import Borrowck from "@compiler::analyzer::borrowck";
import Hir from "@compiler::hir";
import Lir from "@compiler::lir";

import CodegenC from "../mod";
import SymbolNames from "../../abi/symbols";
import Abi from "@compiler::abi";
import Id from "@compiler::ids";
import Diagnostic, DiagnosticCode, LabelKind, Severity, SourceSpan from "@compiler::diagnostics";

/// LIR -> QBE IL emission for the Ignis selfhost compiler.
///
/// The IL text this module writes is the input of the QBE compiler
/// (https://c9x.me/compile/doc/il.html). It is one whole program, std
/// included, the same single-unit model the C emitter uses, so symbol names
/// only have to be unique inside the unit and reuse the C emitter's naming:
/// same mangled names, same reserved-word guard, same linkage rule.
///
/// Value representation. Scalars live in QBE temporaries of class `w` (every
/// integer up to 32 bits, boolean, char, atom) or `l` (64-bit integers, str,
/// every pointer), and always hold their declared width: a producer of a
/// narrow temp normalizes the result with `extsb`/`extub`/`extsh`/`extuh`,
/// so consumers never see garbage in the unused bits. Aggregates -- records,
/// fieldless enums' storage, fixed arrays, slices -- live only in stack slots
/// and every aggregate value is the address of its storage. That one rule
/// makes `.field` and `->field` the same pointer arithmetic while preserving
/// QBE's native aggregate ABI for parameters and return values.
///
/// Aggregate ABI. QBE 1.2 has its own aggregate convention, verified against
/// the real binary: `type :name = { ... }` declares the layout,
/// `function :name $f(...)` returns an aggregate through QBE's hidden return
/// slot, `%r =:name call $f(...)` captures the result into QBE-managed caller
/// storage, and aggregate parameters are spelled `(:name %p)`. An aggregate
/// value in a temp is the address of that storage, which is the same rule
/// locals follow.
///
/// Control flow. The LIR is already basic blocks with explicit gotos, and
/// QBE lowers its input to SSA itself, so temps map one to one and there is
/// no phi work here. Addressable locals need stack slots -- QBE has no
/// addressable temporaries -- so every local gets one slot hoisted into the
/// entry block, which also gives `AddrOfLocal` its answer.
///
/// Fail closed. An instruction this emitter does not lower stops the whole
/// unit with `not supported by the qbe target yet: <instr>` and an empty
/// source, never a partial program: the driver treats an error as a build
/// failure, and a silent wrong-code path would be worse than one.
///
/// Out of scope for the first slice (each fails closed): closures and their
/// drop glue, drop glue of any kind, enums with payloads, inline asm,
/// freestanding mode, floating point, runtime type ids.
export namespace CodegenQbe {
  /// The emitted IL plus what the run measured. An error carries the exact
  /// unsupported-instruction message and leaves `source` empty.
  record EmitOutput {
    public source: String;
    public error: Option<String>;
    /// Where `error` is reported: the body of the function that holds the
    /// unsupported instruction, or none when it is outside every function.
    public errorSpan: Option<SourceSpan>;
    public functions: u64;
  }

  /// The byte size and the byte alignment of one type, the pair the layout
  /// rules answer.
  record TypeLayout {
    public size: u64;
    public alignment: u64;
  }

  /// Mutable state of one emission run.
  record Emitter {
    /// The function bodies.
    public out: String;
    /// The data section: globals, string literals, panic message strings.
    public data: String;
    /// The first unsupported instruction, if any.
    public error: Option<String>;
    /// The span `error` is reported at, once known.
    public errorSpan: Option<SourceSpan>;
    /// Interned string literals, deduplicated by content.
    public literals: Vector<String>;
    /// Counter for the emitter's own temporaries, kept apart from the LIR's
    /// `t0..tN` by the `v` prefix.
    public fresh: u64;
    /// Whether the shared panic format string was emitted.
    public hasPanicFormat: boolean;

    public static init(): CodegenQbe::Emitter {
      return CodegenQbe::Emitter {
        out: String::create(""),
        data: String::create("# Data\n"),
        error: Option::NONE,
        errorSpan: Option::NONE,
        literals: Vector::new<String>(),
        fresh: 0,
        hasPanicFormat: false,
      };
    }
  }

  /// Records the first unsupported instruction. The unit fails closed, so
  /// later emissions are skipped by the callers checking `emitter.error`.
  function failFor(emitter: &mut CodegenQbe::Emitter, instruction: &Lir::Instr): void {
    if (emitter.error.isSome()) {
      return;
    }

    let name: str = CodegenC::instructionName(instruction);

    let message: String = `not supported by the qbe target yet: ${name}`;

    emitter.error = Option::SOME(message);
  }

  /// Records a failure with an explicit instruction name, for the places
  /// where an otherwise supported instruction meets an unsupported operand
  /// type, such as a record argument crossing an extern call.
  function failNamed(emitter: &mut CodegenQbe::Emitter, name: str): void {
    if (emitter.error.isSome()) {
      return;
    }

    let message: String = `not supported by the qbe target yet: ${name}`;

    emitter.error = Option::SOME(message);
  }

  /// The longest identifier QBE 1.2 accepts, for globals (`$name`) and types
  /// (`:name`) alike. Locals are `%t<n>` and the emitter's own `v<n>`
  /// temporaries, both far below it.
  const MAX_IDENTIFIER_LENGTH: u64 = 79;

  /// Every global identifier this backend emits passes through here, so a
  /// definition and its references can never disagree. The stable symbols
  /// `SymbolNames` builds are already capped at the QBE limit, but names
  /// derived afterwards are not: the `_raw` wrapper suffix, a per-program
  /// `_<definition id>` fallback, a type's `_<id>` spelling. `SymbolNames::capped`
  /// shortens deterministically and idempotently — the first 62 characters,
  /// `_`, then sixteen hex digits of the FNV-1a hash of the whole name — so
  /// two long names that share a prefix stay distinct: the hash covers the
  /// full name, not just the kept prefix.
  function qbeIdentifier(name: String): String {
    return SymbolNames::capped(name);
  }

  /// The length-safe QBE global symbol of a definition.
  function qbeMangledName(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): String {
    return CodegenQbe::qbeIdentifier(CodegenC::mangledName(defStore, symbols, defId));
  }

  /// The length-safe name of the `_raw` wrapper around a capture-free thunk.
  function qbeRawThunkWrapperName(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    thunk: Analyzer::DefinitionId,
  ): String {
    return CodegenQbe::qbeIdentifier(CodegenC::rawThunkWrapperName(defStore, symbols, thunk));
  }

  /// The length-safe name of the raw call trampoline of one raw function type.
  function qbeRawTrampolineName(rawType: Analyzer::TypeId): String {
    return CodegenQbe::qbeIdentifier(CodegenC::rawTrampolineName(rawType));
  }

  /// The length-safe QBE aggregate type name of a record or enum, without the
  /// leading `:`. The `type` declaration and every reference to it build the
  /// same string, so they are capped the same way.
  function qbeAggregateTypeName(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): String {
    return CodegenQbe::qbeIdentifier(`${CodegenC::structName(defStore, symbols, defId).toStr()}_${defId.raw()}`);
  }

  /// `ty` with every type alias resolved away, or the input unchanged when
  /// the chain cycles.
  function resolveType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Analyzer::TypeId {
    let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, ty);

    if (resolved.cycleAlias.isSome()) {
      return ty;
    }

    return resolved.typeId;
  }

  /// The QBE class of a scalar temporary: `w` for everything up to 32 bits,
  /// `l` for 64-bit integers, str and every pointer. Aggregates, void and
  /// floats answer NONE: aggregates travel as addresses, void has no value,
  /// and floats are out of scope.
  function scalarClass(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Option<str> {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> Option::SOME("w"),
      Analyzer::Type::I16 -> Option::SOME("w"),
      Analyzer::Type::I32 -> Option::SOME("w"),
      Analyzer::Type::I64 -> Option::SOME("l"),
      Analyzer::Type::U8 -> Option::SOME("w"),
      Analyzer::Type::U16 -> Option::SOME("w"),
      Analyzer::Type::U32 -> Option::SOME("w"),
      Analyzer::Type::U64 -> Option::SOME("l"),
      Analyzer::Type::BOOLEAN -> Option::SOME("w"),
      Analyzer::Type::CHAR -> Option::SOME("w"),
      Analyzer::Type::ATOM -> Option::SOME("w"),
      Analyzer::Type::STR -> Option::SOME("l"),
      Analyzer::Type::STATIC_STR -> Option::SOME("l"),
      Analyzer::Type::Pointer(_) -> Option::SOME("l"),
      Analyzer::Type::Reference(_) -> Option::SOME("l"),
      Analyzer::Type::RawFunction(_) -> Option::SOME("l"),
      Analyzer::Type::Enum(enumDef) -> {
        if (CodegenQbe::enumIsScalar(defStore, enumDef)) {
          return Option::SOME("w");
        }

        return Option::NONE;
      },
      _ -> Option::NONE,
    };
  }

  /// Whether the enum behind `defId` is lowered as its bare `w` tag. A
  /// fieldless enum that implements `Drop` is not: its drop-state byte makes
  /// it an aggregate, the same shape the C struct has.
  function enumIsScalar(
    defStore: &mut Analyzer::DefinitionStore,
    enumDef: Analyzer::DefinitionId,
  ): boolean {
    if (!CodegenQbe::enumIsFieldless(defStore, enumDef)) {
      return false;
    }

    return !CodegenC::hasDropTrait(defStore, enumDef);
  }

  /// Whether every variant of the enum behind `defId` carries no payload.
  /// A fieldless enum is its tag, so it lowers as one `u32` scalar; any
  /// payload variant makes the whole type unsupported.
  function enumIsFieldless(
    defStore: &mut Analyzer::DefinitionStore,
    enumDef: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(enumDef) else {
      return false;
    };

    if (let Analyzer::Definition::Enum(enumDefNode) = definition) {
      let mut index: u64 = 0;

      while (index < enumDefNode.variants.length()) {
        if (let Option::SOME(variantId) = enumDefNode.variants.get(index)) {
          if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
            if (variantDef.payload.length() > 0) {
              return false;
            }
          }
        }

        index += 1;
      }

      return true;
    }

    return false;
  }

  /// Whether this emitter can store every payload of `enumDef`. A closure
  /// payload is F5c's and fails closed as `MakeClosure`; any other
  /// unsupported payload type fails through `typeLayout`. `emitter.error` is
  /// set whenever the answer is false.
  function enumPayloadsSupported(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    enumDef: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(enumDef) else {
      CodegenQbe::failNamed(emitter, "InitEnumVariant");
      return false;
    };

    let Analyzer::Definition::Enum(enumDefNode) = definition else {
      CodegenQbe::failNamed(emitter, "InitEnumVariant");
      return false;
    };

    let mut variantIndex: u64 = 0;

    while (variantIndex < enumDefNode.variants.length()) {
      if (let Option::SOME(variantId) = enumDefNode.variants.get(variantIndex)) {
        if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
          let mut payloadIndex: u64 = 0;

          while (payloadIndex < variantDef.payload.length()) {
            if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
              if (!Abi::isVoid(defStore, typeStore, *payloadType)) {
                CodegenQbe::typeLayout(emitter, defStore, typeStore, *payloadType);

                if (emitter.error.isSome()) {
                  return false;
                }
              }
            }

            payloadIndex += 1;
          }
        }
      }

      variantIndex += 1;
    }

    return true;
  }

  /// Whether `ty` is a signed integer. Division, remainder, right shifts and
  /// comparisons pick their signed or unsigned form from this.
  function isSignedInteger(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): boolean {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return false;
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> true,
      Analyzer::Type::I16 -> true,
      Analyzer::Type::I32 -> true,
      Analyzer::Type::I64 -> true,
      _ -> false,
    };
  }

  /// Whether `ty` is one of the aggregates: record, enum storage, fixed
  /// array, slice. Such a value is the address of its storage. A fieldless
  /// enum is its tag, a scalar, so it does not count.
  function isAggregateType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): boolean {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return false;
    };

    return match (typeNode) {
      Analyzer::Type::Record(_) -> true,
      Analyzer::Type::Enum(enumDef) -> !CodegenQbe::enumIsScalar(defStore, enumDef),
      Analyzer::Type::FixedArray(_, _) -> true,
      Analyzer::Type::Slice(_) -> true,
      Analyzer::Type::Function(_) -> true,
      _ -> false,
    };
  }

  /// Whether a value of `ty` needs drop glue. Closures and droppable nominals
  /// are out of scope, so a drop instruction over one fails the unit closed.
  function needsDrop(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): boolean {
    if (Borrowck::needsDropType(defStore, typeStore, ty)) {
      return true;
    }

    return Hir::typeIsFunction(typeStore, ty);
  }

  /// The nominal a type names, looked through any number of pointers and
  /// references.
  function nominalBehind(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Option<Analyzer::DefinitionId> {
    let mut current: Analyzer::TypeId = ty;

    while (true) {
      let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, current);

      let Option::SOME(typeNode) = typeStore.get(resolved) else {
        return Option::NONE;
      };

      match (typeNode) {
        Analyzer::Type::Record(defId) -> {
          return Option::SOME(defId);
        },
        Analyzer::Type::Enum(defId) -> {
          return Option::SOME(defId);
        },
        Analyzer::Type::Pointer(pointer) -> {
          current = pointer.pointee;
        },
        Analyzer::Type::Reference(reference) -> {
          current = reference.referent;
        },
        _ -> {
          return Option::NONE;
        },
      };
    }

    return Option::NONE;
  }

  /// The size in bytes of a value of `ty`, computed by the emitter's own
  /// layout. Unsupported types fail the unit closed through `emitter.error`.
  function typeSize(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): u64 {
    return CodegenQbe::typeLayout(emitter, defStore, typeStore, ty).size;
  }

  /// The alignment in bytes of a value of `ty`.
  function typeAlign(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): u64 {
    return CodegenQbe::typeLayout(emitter, defStore, typeStore, ty).alignment;
  }

  /// The `(size, alignment)` `Abi` gives `ty`, for the types this emitter
  /// lowers. Any other type fails the unit closed through `emitter.error`,
  /// named after the construct that would need it, before a layout is read.
  function typeLayout(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): CodegenQbe::TypeLayout {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return CodegenQbe::TypeLayout { size: 8, alignment: 8 };
    };

    match (typeNode) {
      Analyzer::Type::I8 -> {},
      Analyzer::Type::U8 -> {},
      Analyzer::Type::BOOLEAN -> {},
      Analyzer::Type::I16 -> {},
      Analyzer::Type::U16 -> {},
      Analyzer::Type::I32 -> {},
      Analyzer::Type::U32 -> {},
      Analyzer::Type::CHAR -> {},
      Analyzer::Type::ATOM -> {},
      Analyzer::Type::I64 -> {},
      Analyzer::Type::U64 -> {},
      Analyzer::Type::STR -> {},
      Analyzer::Type::STATIC_STR -> {},
      Analyzer::Type::Pointer(_) -> {},
      Analyzer::Type::Reference(_) -> {},
      Analyzer::Type::RawFunction(_) -> {},
      Analyzer::Type::Function(_) -> {},
      Analyzer::Type::Slice(_) -> {},
      Analyzer::Type::Enum(enumDef) -> {
        if (!CodegenQbe::enumIsScalar(defStore, enumDef)) {
          if (!CodegenQbe::enumPayloadsSupported(emitter, defStore, typeStore, enumDef)) {
            return CodegenQbe::TypeLayout { size: 0, alignment: 1 };
          }
        }
      },
      Analyzer::Type::FixedArray(element, _) -> {
        CodegenQbe::typeLayout(emitter, defStore, typeStore, element);
      },
      Analyzer::Type::Record(recordDef) -> {
        return CodegenQbe::recordLayout(emitter, defStore, typeStore, recordDef);
      },
      _ -> {
        CodegenQbe::failNamed(emitter, "SizeOf");
      },
    };

    if (emitter.error.isSome()) {
      return CodegenQbe::TypeLayout { size: 0, alignment: 1 };
    }

    let layout: CodegenQbe::TypeLayout = CodegenQbe::abiLayout(emitter, defStore, typeStore, resolved);

    // A fieldless enum that implements `Drop` is an aggregate with a
    // drop-state byte; only the bare `w` scalar is exactly four bytes.
    if (let Analyzer::Type::Enum(enumDef) = typeNode) {
      if (CodegenQbe::enumIsScalar(defStore, enumDef)) {
        if (layout.size != 4) {
          CodegenQbe::failNamed(emitter, "Drop");
          return CodegenQbe::TypeLayout { size: 0, alignment: 1 };
        }
      }
    }

    return layout;
  }

  /// `Abi::typeLayout` for a type the caller already checked this emitter
  /// lowers.
  function abiLayout(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): CodegenQbe::TypeLayout {
    return match (Abi::typeLayout(defStore, typeStore, ty)) {
      Result::OK(layout) -> CodegenQbe::TypeLayout { size: layout.size, alignment: layout.alignment },
      Result::ERROR(_) -> {
        CodegenQbe::failNamed(emitter, "SizeOf");
        return CodegenQbe::TypeLayout { size: 0, alignment: 1 };
      },
    };
  }

  /// The `(size, alignment)` `Abi` gives the record behind `recordDef`, once
  /// every field type is one this emitter lowers.
  function recordLayout(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    recordDef: Analyzer::DefinitionId,
  ): CodegenQbe::TypeLayout {
    let mut fieldTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    if (let Option::SOME(Analyzer::Definition::Record(recData)) = defStore.get(recordDef)) {
      let mut index: u64 = 0;

      while (index < recData.fields.length()) {
        if (let Option::SOME(fieldId) = recData.fields.get(index)) {
          if (let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldId)) {
            fieldTypes.push(fieldDef.fieldType);
          }
        }

        index += 1;
      }
    } else {
      return CodegenQbe::TypeLayout { size: 0, alignment: 1 };
    }

    let mut typeIndex: u64 = 0;

    while (typeIndex < fieldTypes.length()) {
      if (let Option::SOME(fieldType) = fieldTypes.get(typeIndex)) {
        let storageType: Analyzer::TypeId = Hir::recordFieldStorageType(defStore, typeStore, recordDef, *fieldType);
        CodegenQbe::typeLayout(emitter, defStore, typeStore, storageType);
      }

      if (emitter.error.isSome()) {
        return CodegenQbe::TypeLayout { size: 0, alignment: 1 };
      }

      typeIndex += 1;
    }

    return match (Abi::recordLayout(defStore, typeStore, recordDef)) {
      Result::OK(layout) -> CodegenQbe::TypeLayout { size: layout.layout.size, alignment: layout.layout.alignment },
      Result::ERROR(_) -> {
        CodegenQbe::failNamed(emitter, "SizeOf");
        return CodegenQbe::TypeLayout { size: 0, alignment: 1 };
      },
    };
  }

  /// The byte offset `Abi` gives field `fieldIndex` inside its record.
  function fieldOffset(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    recordDef: Analyzer::DefinitionId,
    fieldIndex: u64,
  ): u64 {
    CodegenQbe::recordLayout(emitter, defStore, typeStore, recordDef);

    if (emitter.error.isSome()) {
      return 0;
    }

    return match (Abi::recordFieldOffset(defStore, typeStore, recordDef, fieldIndex)) {
      Result::OK(offset) -> offset,
      Result::ERROR(_) -> {
        CodegenQbe::failNamed(emitter, "SizeOf");
        return 0;
      },
    };
  }

  /// Interns a string literal and answers its data symbol. Literals are
  /// NUL-terminated byte strings, deduplicated by content so the same text
  /// shares one symbol.
  function internString(emitter: &mut CodegenQbe::Emitter, text: &String): String {
    let mut index: u64 = 0;

    while (index < emitter.literals.length()) {
      if (let Option::SOME(existing) = emitter.literals.get(index)) {
        if (existing.equals(text)) {
          return `$str_${index}`;
        }
      }

      index += 1;
    }

    let id: u64 = emitter.literals.length();

    emitter.literals.push(text.clone());

    let symbol: String = `$str_${id}`;
    let escaped: String = CodegenQbe::stringLiteralItems(text);
    let line: String = `data $str_${id} = { ${escaped.toStr()} }\n`;

    emitter.data.pushStr(line.toStr());

    return symbol;
  }

  /// The data-section items for one string literal: runs of printable bytes
  /// stay one `b "..."` item each and every escaped byte becomes its own
  /// `b N` item, so no escape can run into the byte that follows it. The
  /// terminating NUL closes the list.
  function stringLiteralItems(text: &String): String {
    let mut items: String = String::create("");
    let mut chunk: String = String::create("");
    let mut index: u64 = 0;
    let mut hasChunk: boolean = false;

    while (index < text.length()) {
      let Option::SOME(byte) = text.byteAt(index) else {
        index += 1;
        continue;
      };

      let isPlain: boolean = byte >= 32 && byte <= 126 && byte != 34 && byte != 92;

      if (isPlain) {
        chunk.pushByte(byte);
        hasChunk = true;
      } else {
        if (hasChunk) {
          if (items.length() > 0) {
            items.pushStr(", ");
          }

          let chunkItem: String = `b "${chunk.toStr()}"`;

          items.pushStr(chunkItem.toStr());
          chunk = String::create("");
          hasChunk = false;
        }

        let item: String = CodegenQbe::escapedByteItem(byte);

        if (items.length() > 0) {
          items.pushStr(", ");
        }

        items.push(&item);
      }

      index += 1;
    }

    if (hasChunk) {
      if (items.length() > 0) {
        items.pushStr(", ");
      }

      let chunkItem: String = `b "${chunk.toStr()}"`;

      items.pushStr(chunkItem.toStr());
    }

    if (items.length() > 0) {
      items.pushStr(", ");
    }

    items.pushStr("b 0");

    return items;
  }

  /// One escaped byte as a data item: named escapes for the common controls,
  /// a hex escape for everything else. The item is returned as an owned
  /// `String`: a `str` view of a local would point at a buffer freed on return.
  function escapedByteItem(byte: u8): String {
    if (byte == 10) {
      return String::create("b \"\\n\"");
    }

    if (byte == 13) {
      return String::create("b \"\\r\"");
    }

    if (byte == 9) {
      return String::create("b \"\\t\"");
    }

    let digits: String = String::create("0123456789abcdef");
    let Option::SOME(high) = digits.byteAt((byte / 16) as u64) else {
      return String::create("b 0");
    };
    let Option::SOME(low) = digits.byteAt((byte % 16) as u64) else {
      return String::create("b 0");
    };
    let mut item: String = String::create("b \"\\x");

    item.pushByte(high);
    item.pushByte(low);
    item.pushStr("\"");

    return item;
  }

  /// The QBE immediate for a scalar constant. A str constant is the data
  /// symbol its bytes were interned under. Aggregates and floats answer NONE:
  /// their callers fail the unit closed or handle the zero case themselves.
  function constText(emitter: &mut CodegenQbe::Emitter, value: &Lir::ConstValue): Option<String> {
    return match (value) {
      Lir::ConstValue::Int(number, _) -> Option::SOME(`${number}`),
      Lir::ConstValue::UInt(number, _) -> Option::SOME(`${number}`),
      Lir::ConstValue::Bool(flag, _) -> {
        if (flag) {
          return Option::SOME(String::create("1"));
        }

        return Option::SOME(String::create("0"));
      },
      Lir::ConstValue::Char(scalar, _) -> Option::SOME(`${scalar}`),
      Lir::ConstValue::Atom(scalar, _) -> Option::SOME(`${scalar}`),
      Lir::ConstValue::Str(text, _) -> {
        let symbol: String = CodegenQbe::internString(emitter, &text);

        return Option::SOME(symbol);
      },
      Lir::ConstValue::Null(_) -> Option::SOME(String::create("0")),
      Lir::ConstValue::Undef(_) -> Option::SOME(String::create("0")),
      _ -> Option::NONE,
    };
  }

  /// Whether `operand` is a constant this emitter can spell as an immediate.
  function constTextOf(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): Option<String> {
    let Lir::Operand::Const(value) = operand else {
      return Option::NONE;
    };

    let Option::SOME(operandType) = CodegenQbe::operandType(defStore, function_, operand) else {
      return Option::NONE;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, operandType)) {
      return Option::NONE;
    }

    if (CodegenQbe::scalarClass(defStore, typeStore, operandType).isNone()) {
      return Option::NONE;
    }

    return CodegenQbe::constText(emitter, &value);
  }

  /// A fresh temporary name, `%vN`, for the emitter's own values.
  function freshTemp(emitter: &mut CodegenQbe::Emitter): String {
    let name: String = `%v${emitter.fresh}`;

    emitter.fresh += 1;

    return name;
  }

  /// Whether `defId` is a `@threadLocal` static, which QBE names as
  /// `thread $name`.
  function isThreadLocalGlobal(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId
  ): boolean {
    if (let Option::SOME(Analyzer::Definition::Variable(variable)) = defStore.get(defId)) {
      return variable.threadLocal;
    }

    return false;
  }

  /// The QBE operand for the address of the global `defId`: `$name`, or
  /// `thread $name` for a thread-local, which a bare `$name` would resolve to
  /// the initial image instead of the running thread's copy.
  function globalAddress(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): String {
    let name: String = CodegenQbe::qbeMangledName(defStore, symbols, defId);

    if (CodegenQbe::isThreadLocalGlobal(defStore, defId)) {
      return `thread $${name.toStr()}`;
    }

    return `$${name.toStr()}`;
  }

  function operandType(
    defStore: &mut Analyzer::DefinitionStore,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): Option<Analyzer::TypeId> {
    if (let Lir::Operand::GlobalRef(defId) = operand) {
      if (let Option::SOME(Analyzer::Definition::Variable(variable)) = defStore.get(defId)) {
        return Option::SOME(variable.declaredType);
      }
      if (let Option::SOME(Analyzer::Definition::Field(field)) = defStore.get(defId)) {
        return Option::SOME(field.fieldType);
      }
      return Option::NONE;
    }
    return CodegenC::operandType(function_, operand);
  }

  /// The QBE type reference of the closure struct of one signature. It holds
  /// the same three pointers the C backend's `__ignis_closure_t<id>` does, in
  /// the same order, so a closure value crosses between the backends.
  function closureTypeRef(typeId: Analyzer::TypeId): String {
    return `:ignis_closure_${typeId.raw()}`;
  }

  /// The environment struct of the closure whose thunk, or whose environment
  /// drop function, is `defId`, when the program builds one. A drop function
  /// reads the thunk's environment, so it is found through the thunk.
  function qbeEnvFor(
    envs: &Vector<CodegenC::ClosureEnv>,
    defId: Analyzer::DefinitionId,
  ): Option<&CodegenC::ClosureEnv> {
    let mut index: u64 = 0;

    while (index < envs.length()) {
      if (let Option::SOME(env) = envs.get(index)) {
        if (env.thunk == defId.raw()) {
          return Option::SOME(env);
        }

        if (let Option::SOME(dropFnRaw) = env.dropFn) {
          if (dropFnRaw == defId.raw()) {
            return Option::SOME(env);
          }
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// The byte offset of capture `fieldIndex` inside the environment struct,
  /// laid out as the C emitter's `struct { T0 field_0; ... }` is: every field
  /// aligned to its own alignment. Only the capturing backend reads the
  /// environment, so the offset has to be consistent, not ABI-mandated.
  function qbeEnvFieldOffset(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    env: &CodegenC::ClosureEnv,
    fieldIndex: u64,
  ): u64 {
    let mut cursor: u64 = 0;
    let mut index: u64 = 0;

    while (index < fieldIndex) {
      if (let Option::SOME(raw) = env.captureTypes.get(index)) {
        let ty: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
        let alignment: u64 = CodegenQbe::typeAlign(emitter, defStore, typeStore, ty);

        cursor = Abi::alignUp(cursor, alignment);
        cursor += CodegenQbe::typeSize(emitter, defStore, typeStore, ty);
      }

      index += 1;
    }

    if (let Option::SOME(raw) = env.captureTypes.get(fieldIndex)) {
      let ty: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
      let alignment: u64 = CodegenQbe::typeAlign(emitter, defStore, typeStore, ty);

      cursor = Abi::alignUp(cursor, alignment);
    }

    return cursor;
  }

  /// The size in bytes of the environment struct, padded to its alignment,
  /// or zero when the closure captures nothing.
  function qbeEnvSize(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    env: &CodegenC::ClosureEnv,
  ): u64 {
    let mut cursor: u64 = 0;
    let mut maxAlignment: u64 = 1;
    let mut index: u64 = 0;

    while (index < env.captureTypes.length()) {
      if (let Option::SOME(raw) = env.captureTypes.get(index)) {
        let ty: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
        let alignment: u64 = CodegenQbe::typeAlign(emitter, defStore, typeStore, ty);

        if (alignment > maxAlignment) {
          maxAlignment = alignment;
        }

        cursor = Abi::alignUp(cursor, alignment);
        cursor += CodegenQbe::typeSize(emitter, defStore, typeStore, ty);
      }

      index += 1;
    }

    return Abi::alignUp(cursor, maxAlignment);
  }

  /// Renders `operand` for a value position of class `cls`.
  ///
  /// A temp is its QBE temporary. A scalar local is loaded into a fresh
  /// temporary first, since locals are slots. A scalar constant is the
  /// immediate itself. An aggregate local or temp is its storage address,
  /// which is the value representation aggregates have. A str constant is
  /// its data symbol.
  function valueOperand(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): Option<String> {
    match (operand) {
      Lir::Operand::Temp(temp) -> {
        return Option::SOME(`%t${temp.raw()}`);
      },
      Lir::Operand::Local(local) -> {
        let Option::SOME(localType) = CodegenQbe::operandType(defStore, function_, operand) else {
          return Option::NONE;
        };

        if (CodegenQbe::isAggregateType(defStore, typeStore, localType)) {
          return Option::SOME(`%l${local.raw()}`);
        }

        let Option::SOME(load) = CodegenQbe::loadOp(defStore, typeStore, localType) else {
          return Option::NONE;
        };

        let Option::SOME(cls) = CodegenQbe::scalarClass(defStore, typeStore, localType) else {
          return Option::NONE;
        };

        let fresh: String = CodegenQbe::freshTemp(emitter);
        let line: String = `    ${fresh.toStr()} =${cls} ${load} %l${local.raw()}\n`;

        emitter.out.pushStr(line.toStr());

        return Option::SOME(fresh);
      },
      Lir::Operand::Const(_) -> {
        let value: Option<String> = CodegenQbe::constTextOf(emitter, defStore, typeStore, function_, operand);
        if (value.isNone()) { CodegenQbe::failNamed(emitter, "Constant"); }
        return value;
      },
      Lir::Operand::FuncRef(defId) -> {
        let name: String = CodegenQbe::qbeMangledName(defStore, symbols, defId);
        return Option::SOME(`$${name.toStr()}`);
      },
      Lir::Operand::GlobalRef(defId) -> {
        let mut address: String = CodegenQbe::globalAddress(defStore, symbols, defId);

        // A thread-local's address is computed per thread; taking it once
        // into a temporary keeps every use an ordinary `l` value.
        if (CodegenQbe::isThreadLocalGlobal(defStore, defId)) {
          let materialized: String = CodegenQbe::freshTemp(emitter);
          let copyLine: String = `    ${materialized.toStr()} =l copy ${address.toStr()}\n`;
          emitter.out.pushStr(copyLine.toStr());
          address = materialized;
        }
        let Option::SOME(ty) = CodegenQbe::operandType(defStore, function_, operand) else {
          CodegenQbe::failNamed(emitter, "GlobalRef");
          return Option::NONE;
        };
        if (CodegenQbe::isAggregateType(defStore, typeStore, ty)) {
          return Option::SOME(address);
        }
        let Option::SOME(load) = CodegenQbe::loadOp(defStore, typeStore, ty) else {
          CodegenQbe::failNamed(emitter, "GlobalRef"); return Option::NONE;
        };
        let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, ty) else {
          CodegenQbe::failNamed(emitter, "GlobalRef"); return Option::NONE;
        };
        let fresh: String = CodegenQbe::freshTemp(emitter);
        let line: String = `    ${fresh.toStr()} =${cls.toStr()} ${load.toStr()} ${address.toStr()}\n`;
        emitter.out.pushStr(line.toStr());
        return Option::SOME(fresh);
      },
    };
  }

  /// The typed load for a scalar of `ty`: narrow loads sign- or
  /// zero-extend, so a loaded narrow value is already normalized.
  function loadOp(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Option<String> {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> Option::SOME(String::create("loadsb")),
      Analyzer::Type::U8 -> Option::SOME(String::create("loadub")),
      Analyzer::Type::BOOLEAN -> Option::SOME(String::create("loadub")),
      Analyzer::Type::I16 -> Option::SOME(String::create("loadsh")),
      Analyzer::Type::U16 -> Option::SOME(String::create("loaduh")),
      Analyzer::Type::I32 -> Option::SOME(String::create("loadsw")),
      Analyzer::Type::U32 -> Option::SOME(String::create("loaduw")),
      Analyzer::Type::CHAR -> Option::SOME(String::create("loaduw")),
      Analyzer::Type::ATOM -> Option::SOME(String::create("loaduw")),
      Analyzer::Type::I64 -> Option::SOME(String::create("loadl")),
      Analyzer::Type::U64 -> Option::SOME(String::create("loadl")),
      Analyzer::Type::STR -> Option::SOME(String::create("loadl")),
      Analyzer::Type::STATIC_STR -> Option::SOME(String::create("loadl")),
      Analyzer::Type::Pointer(_) -> Option::SOME(String::create("loadl")),
      Analyzer::Type::Reference(_) -> Option::SOME(String::create("loadl")),
      Analyzer::Type::RawFunction(_) -> Option::SOME(String::create("loadl")),
      Analyzer::Type::Enum(enumDef) -> {
        if (CodegenQbe::enumIsScalar(defStore, enumDef)) {
          return Option::SOME(String::create("loaduw"));
        }

        return Option::NONE;
      },
      _ -> Option::NONE,
    };
  }

  /// The typed store for a scalar of `ty`, the store-side pair of `loadOp`.
  function storeOp(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Option<String> {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> Option::SOME(String::create("storeb")),
      Analyzer::Type::U8 -> Option::SOME(String::create("storeb")),
      Analyzer::Type::BOOLEAN -> Option::SOME(String::create("storeb")),
      Analyzer::Type::I16 -> Option::SOME(String::create("storeh")),
      Analyzer::Type::U16 -> Option::SOME(String::create("storeh")),
      Analyzer::Type::I32 -> Option::SOME(String::create("storew")),
      Analyzer::Type::U32 -> Option::SOME(String::create("storew")),
      Analyzer::Type::CHAR -> Option::SOME(String::create("storew")),
      Analyzer::Type::ATOM -> Option::SOME(String::create("storew")),
      Analyzer::Type::I64 -> Option::SOME(String::create("storel")),
      Analyzer::Type::U64 -> Option::SOME(String::create("storel")),
      Analyzer::Type::STR -> Option::SOME(String::create("storel")),
      Analyzer::Type::STATIC_STR -> Option::SOME(String::create("storel")),
      Analyzer::Type::Pointer(_) -> Option::SOME(String::create("storel")),
      Analyzer::Type::Reference(_) -> Option::SOME(String::create("storel")),
      Analyzer::Type::RawFunction(_) -> Option::SOME(String::create("storel")),
      Analyzer::Type::Enum(enumDef) -> {
        if (CodegenQbe::enumIsScalar(defStore, enumDef)) {
          return Option::SOME(String::create("storew"));
        }

        return Option::NONE;
      },
      _ -> Option::NONE,
    };
  }

  /// The QBE type reference for an aggregate, or an empty string for the
  /// scalars, which never name a type. Records use the mangled record name,
  /// slices and fixed arrays get synthetic names keyed by the type id.
  function qbeTypeRef(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    ty: Analyzer::TypeId,
  ): String {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return String::create("");
    };

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        let name: String = CodegenQbe::qbeAggregateTypeName(defStore, symbols, defId);

        return `:${name.toStr()}`;
      },
      Analyzer::Type::Enum(defId) -> {
        if (CodegenQbe::enumIsScalar(defStore, defId)) {
          return String::create("");
        }

        let name: String = CodegenQbe::qbeAggregateTypeName(defStore, symbols, defId);

        return `:${name.toStr()}`;
      },
      Analyzer::Type::Slice(_) -> {
        return `:ignis_slice_${resolved.raw()}`;
      },
      Analyzer::Type::Function(_) -> {
        return CodegenQbe::closureTypeRef(resolved);
      },
      Analyzer::Type::FixedArray(_, _) -> {
        return `:ignis_array_${resolved.raw()}`;
      },
      _ -> {
        return String::create("");
      },
    };
    return String::new();
  }

  /// The QBE value class letter for a scalar: `w` for everything up to 32
  /// bits, `l` for 64-bit values and pointers. Aggregates and floats answer
  /// NONE, and their callers fail the unit closed.
  function qbeClass(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Option<String> {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> Option::SOME(String::create("w")),
      Analyzer::Type::U8 -> Option::SOME(String::create("w")),
      Analyzer::Type::BOOLEAN -> Option::SOME(String::create("w")),
      Analyzer::Type::I16 -> Option::SOME(String::create("w")),
      Analyzer::Type::U16 -> Option::SOME(String::create("w")),
      Analyzer::Type::I32 -> Option::SOME(String::create("w")),
      Analyzer::Type::U32 -> Option::SOME(String::create("w")),
      Analyzer::Type::CHAR -> Option::SOME(String::create("w")),
      Analyzer::Type::ATOM -> Option::SOME(String::create("w")),
      Analyzer::Type::I64 -> Option::SOME(String::create("l")),
      Analyzer::Type::U64 -> Option::SOME(String::create("l")),
      Analyzer::Type::STR -> Option::SOME(String::create("l")),
      Analyzer::Type::STATIC_STR -> Option::SOME(String::create("l")),
      Analyzer::Type::Pointer(_) -> Option::SOME(String::create("l")),
      Analyzer::Type::Reference(_) -> Option::SOME(String::create("l")),
      Analyzer::Type::RawFunction(_) -> Option::SOME(String::create("l")),
      Analyzer::Type::Enum(enumDef) -> {
        if (CodegenQbe::enumIsScalar(defStore, enumDef)) {
          return Option::SOME(String::create("w"));
        }

        return Option::NONE;
      },
      _ -> Option::NONE,
    };
  }

  /// The QBE data-item letter for a scalar of `ty`, by byte width: `b` for
  /// one-byte values, `h` for two, `w` for four, `l` for eight.
  function qbeItemLetter(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Option<String> {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> Option::SOME(String::create("b")),
      Analyzer::Type::U8 -> Option::SOME(String::create("b")),
      Analyzer::Type::BOOLEAN -> Option::SOME(String::create("b")),
      Analyzer::Type::I16 -> Option::SOME(String::create("h")),
      Analyzer::Type::U16 -> Option::SOME(String::create("h")),
      Analyzer::Type::I32 -> Option::SOME(String::create("w")),
      Analyzer::Type::U32 -> Option::SOME(String::create("w")),
      Analyzer::Type::CHAR -> Option::SOME(String::create("w")),
      Analyzer::Type::ATOM -> Option::SOME(String::create("w")),
      Analyzer::Type::I64 -> Option::SOME(String::create("l")),
      Analyzer::Type::U64 -> Option::SOME(String::create("l")),
      Analyzer::Type::STR -> Option::SOME(String::create("l")),
      Analyzer::Type::STATIC_STR -> Option::SOME(String::create("l")),
      Analyzer::Type::Pointer(_) -> Option::SOME(String::create("l")),
      Analyzer::Type::Reference(_) -> Option::SOME(String::create("l")),
      Analyzer::Type::RawFunction(_) -> Option::SOME(String::create("l")),
      Analyzer::Type::Enum(enumDef) -> {
        if (CodegenQbe::enumIsScalar(defStore, enumDef)) {
          return Option::SOME(String::create("w"));
        }

        return Option::NONE;
      },
      _ -> Option::NONE,
    };
  }

  /// The sign-extension op that re-normalizes a `w`-class value of `ty`, or
  /// NONE when the width already fills the class. Consumers never see garbage
  /// in the unused bits, so every narrow producer ends with one of these.
  function qbeExtOp(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Option<String> {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::I8 -> Option::SOME(String::create("extsb")),
      Analyzer::Type::U8 -> Option::SOME(String::create("extub")),
      Analyzer::Type::BOOLEAN -> Option::SOME(String::create("extub")),
      Analyzer::Type::I16 -> Option::SOME(String::create("extsh")),
      Analyzer::Type::U16 -> Option::SOME(String::create("extuh")),
      Analyzer::Type::CHAR -> Option::NONE,
      Analyzer::Type::ATOM -> Option::NONE,
      _ -> Option::NONE,
    };
  }

  /// Emits `%dest =<w> <ext> <value>` when `ty` is a narrow integer, so the
  /// temp named `value` reads back as its declared width.
  function qbeNormalize(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
    value: &String,
  ): String {
    if (emitter.error.isSome()) {
      return value.clone();
    }

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, ty) else {
      CodegenQbe::failNamed(emitter, "Normalize");
      return value.clone();
    };

    if (!(cls.equals("w"))) {
      return value.clone();
    }

    let Option::SOME(ext) = CodegenQbe::qbeExtOp(defStore, typeStore, ty) else {
      return value.clone();
    };

    let fresh: String = CodegenQbe::freshTemp(emitter);
    let line: String = `    ${fresh.toStr()} =${cls.toStr()} ${ext.toStr()} ${value.toStr()}\n`;

    emitter.out.pushStr(line.toStr());

    return fresh;
  }

  /// The stack-slot op for one local or aggregate temp: `alloc4` up to four
  /// bytes, `alloc8` up to eight, `alloc16` beyond that and for every
  /// aggregate, which keeps 16-byte alignment for possibly-nested records.
  function qbeSlotOp(size: u64): str {
    if (size <= 4) {
      return "alloc4";
    }

    if (size <= 8) {
      return "alloc8";
    }

    return "alloc16";
  }

  /// The recursive type declarations the unit needs: every record in the
  /// selected LIR functions, plus the slice and fixed-array shapes those records
  /// reach through their fields. Each declaration is emitted once, before its
  /// first use, dependencies first.
  function qbeEmitTypeDeclarations(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    emitted: &mut Vector<u32>,
    ty: Analyzer::TypeId,
  ): void {
    if (emitter.error.isSome()) {
      return;
    }

    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);
    let raw: u32 = resolved.raw();
    let mut seen: boolean = false;
    let mut index: u64 = 0;

    while (index < emitted.length()) {
      if (let Option::SOME(existing) = emitted.get(index)) {
        if (*existing == raw) {
          seen = true;
        }
      }

      index += 1;
    }

    if (seen) {
      return;
    }

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return;
    };

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        emitted.push(raw);
        CodegenQbe::qbeEmitRecordDeclaration(emitter, defStore, typeStore, symbols, emitted, defId);
      },
      Analyzer::Type::Slice(elementType) -> {
        CodegenQbe::qbeEmitTypeDeclarations(emitter, defStore, typeStore, symbols, emitted, elementType);
        emitted.push(raw);

        let line: String = `type :ignis_slice_${raw} = { l, l }\n`;

        emitter.data.pushStr(line.toStr());
      },
      Analyzer::Type::Function(_) -> {
        emitted.push(raw);

        let line: String = `type ${CodegenQbe::closureTypeRef(resolved).toStr()} = { l, l, l }\n`;

        emitter.data.pushStr(line.toStr());
      },
      Analyzer::Type::FixedArray(elementType, count) -> {
        CodegenQbe::qbeEmitTypeDeclarations(emitter, defStore, typeStore, symbols, emitted, elementType);
        let layout: CodegenQbe::TypeLayout = CodegenQbe::typeLayout(emitter, defStore, typeStore, resolved);
        if (layout.size == 0 || layout.alignment > 16) {
          CodegenQbe::failNamed(emitter, "FixedArray");
          return;
        }
        let mut item: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, elementType);
        if (let Option::SOME(letter) = CodegenQbe::qbeItemLetter(defStore, typeStore, elementType)) {
          item = letter;
        }
        if (item.length() == 0) {
          CodegenQbe::failNamed(emitter, "FixedArray");
          return;
        }
        emitted.push(raw);
        emitter.data.pushStr(`type :ignis_array_${raw} = align ${layout.alignment} { ${item.toStr()} ${count} }\n`.toStr());
      },
      Analyzer::Type::Enum(defId) -> {
        if (CodegenQbe::enumIsScalar(defStore, defId)) {
          return;
        }

        CodegenQbe::enumPayloadsSupported(emitter, defStore, typeStore, defId);

        if (emitter.error.isSome()) {
          return;
        }

        // A union has no QBE type of its own, so the payload enum is an
        // opaque blob and its payload types only need declarations when they
        // are used by value somewhere else.
        CodegenQbe::qbeEmitEnumPayloadDeclarations(emitter, defStore, typeStore, symbols, emitted, defId);

        if (emitter.error.isSome()) {
          return;
        }

        emitted.push(raw);
        CodegenQbe::qbeEmitEnumDeclaration(emitter, defStore, typeStore, symbols, defId);
      },
      _ -> {},
    };
  }

  /// Declares the types every payload of `enumDef` reaches by value, so they
  /// precede the enum that embeds them.
  function qbeEmitEnumPayloadDeclarations(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    emitted: &mut Vector<u32>,
    defId: Analyzer::DefinitionId,
  ): void {
    let Option::SOME(definition) = defStore.get(defId) else {
      return;
    };

    let Analyzer::Definition::Enum(enumDefNode) = definition else {
      return;
    };

    let mut variantIndex: u64 = 0;

    while (variantIndex < enumDefNode.variants.length()) {
      if (let Option::SOME(variantId) = enumDefNode.variants.get(variantIndex)) {
        if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
          let mut payloadIndex: u64 = 0;

          while (payloadIndex < variantDef.payload.length()) {
            if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
              CodegenQbe::qbeEmitTypeDeclarations(emitter, defStore, typeStore, symbols, emitted, *payloadType);

              if (emitter.error.isSome()) {
                return;
              }
            }

            payloadIndex += 1;
          }
        }
      }

      variantIndex += 1;
    }
  }

  /// The `type :name = align A { w, ... }` declaration of one payload enum.
  /// The `u32` tag sits at offset 0 and the payload union follows at its
  /// ABI-aligned offset, spelled as one opaque byte blob: QBE has no union,
  /// and an integer blob keeps the aggregate in the register classes the C
  /// struct's union classifies into. Size and alignment are exactly
  /// `Abi::enumLayout`'s, so both backends agree on the storage.
  function qbeEmitEnumDeclaration(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): void {
    let layout: Abi::EnumLayout = match (Abi::enumLayout(defStore, typeStore, defId)) {
      Result::OK(value) -> value,
      Result::ERROR(_) -> {
        CodegenQbe::failNamed(emitter, "SizeOf");
        return;
      },
    };

    let name: String = CodegenQbe::qbeAggregateTypeName(defStore, symbols, defId);
    let mut items: String = String::create("w");

    if (layout.payloadOffset > 4) {
      items.pushStr(`, b ${layout.payloadOffset - 4}`.toStr());
    }

    if (layout.layout.size > layout.payloadOffset) {
      items.pushStr(`, b ${layout.layout.size - layout.payloadOffset}`.toStr());
    }

    let line: String = `type :${name.toStr()} = align ${layout.layout.alignment} { ${items.toStr()} }\n`;

    emitter.data.pushStr(line.toStr());
  }

  /// The `type :name = align A { items }` declaration of one record. Items
  /// carry explicit `b N` padding so the QBE layout matches the emitter's own
  /// field offsets byte for byte. Unaligned members force the SysV memory
  /// class, represented by a QBE opaque type; aligned packed records retain
  /// their field classes so foreign calls can still use registers.
  function qbeEmitRecordDeclaration(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    emitted: &mut Vector<u32>,
    defId: Analyzer::DefinitionId,
  ): void {
    let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(defId) else {
      return;
    };

    let layout: CodegenQbe::TypeLayout = CodegenQbe::recordLayout(emitter, defStore, typeStore, defId);

    if (emitter.error.isSome()) {
      return;
    }

    if (layout.size == 0) {
      CodegenQbe::failNamed(emitter, "ZeroSizedRecord");
      return;
    }
    if (layout.alignment > 16) {
      CodegenQbe::failNamed(emitter, "OveralignedRecord");
      return;
    }

    let name: String = CodegenQbe::qbeAggregateTypeName(defStore, symbols, defId);

    let mut unaligned: boolean = false;
    let mut fieldIndex: u64 = 0;
    while (fieldIndex < recordDef.fields.length()) {
      if (let Option::SOME(fieldId) = recordDef.fields.get(fieldIndex)) {
        if (let Option::SOME(Analyzer::Definition::Field(field)) = defStore.get(*fieldId)) {
          let ty: Analyzer::TypeId = Hir::recordFieldStorageType(defStore, typeStore, defId, field.fieldType);
          let alignment: u64 = CodegenQbe::typeAlign(emitter, defStore, typeStore, ty);
          if (CodegenQbe::fieldOffset(emitter, defStore, typeStore, defId, fieldIndex) % alignment != 0) {
            unaligned = true;
          }
        }
      }
      fieldIndex += 1;
    }
    if (unaligned) {
      let line: String = `type :${name.toStr()} = align ${layout.alignment} { ${layout.size} }\n`;

      emitter.data.pushStr(line.toStr());
      return;
    }

    let mut items: String = String::create("");
    let mut cursor: u64 = 0;
    let mut index: u64 = 0;

    while (index < recordDef.fields.length()) {
      let Option::SOME(fieldId) = recordDef.fields.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldId) else {
        index += 1;
        continue;
      };

      let storageType: Analyzer::TypeId = Hir::recordFieldStorageType(defStore, typeStore, defId, fieldDef.fieldType);
      let target: u64 = CodegenQbe::fieldOffset(emitter, defStore, typeStore, defId, fieldDef.index as u64);

      if (emitter.error.isSome()) {
        return;
      }

      if (target > cursor) {
        if (items.length() > 0) {
          items.pushStr(",");
        }
        let pad: String = ` b ${target - cursor}`;

        items.pushStr(pad.toStr());
      }

      cursor = target;

      let item: String = CodegenQbe::qbeTypeItem(emitter, defStore, typeStore, symbols, emitted, storageType);

      if (emitter.error.isSome()) {
        return;
      }

      if (items.length() > 0) {
        items.pushStr(",");
      }
      items.pushStr(" ");
      items.pushStr(item.toStr());

      cursor = cursor + CodegenQbe::typeSize(emitter, defStore, typeStore, storageType);
      index += 1;
    }

    if (emitter.error.isSome()) {
      return;
    }

    if (layout.size > cursor) {
      if (items.length() > 0) {
        items.pushStr(",");
      }
      let pad: String = ` b ${layout.size - cursor}`;

      items.pushStr(pad.toStr());
    }

    let line: String = `type :${name.toStr()} = align ${layout.alignment} {${items.toStr()} }\n`;

    emitter.data.pushStr(line.toStr());
  }

  /// One data item inside a type body: a scalar letter or an aggregate type
  /// reference, with array counts spelled the QBE way, `<item> <count>`.
  function qbeTypeItem(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    emitted: &mut Vector<u32>,
    ty: Analyzer::TypeId,
  ): String {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      CodegenQbe::failNamed(emitter, "TypeDecl");
      return String::create("b");
    };

    match (typeNode) {
      Analyzer::Type::FixedArray(elementType, count) -> {
        let element: String = CodegenQbe::qbeTypeItem(emitter, defStore, typeStore, symbols, emitted, elementType);

        return `${element.toStr()} ${count}`;
      },
      _ -> {
        CodegenQbe::qbeEmitTypeDeclarations(emitter, defStore, typeStore, symbols, emitted, resolved);

        let Option::SOME(letter) = CodegenQbe::qbeItemLetter(defStore, typeStore, resolved) else {
          let reference: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, resolved);

          if (reference.length() == 0) {
            CodegenQbe::failNamed(emitter, "TypeDecl");
            return String::create("b");
          }

          return reference;
        };

        return letter;
      },
    };
    return String::new();
  }

  /// The `data` section: one `data $symbol = align A { items }` global per
  /// module-level initializer, walking the flattened parts the LIR carries
  /// and filling the gaps between fields with zero bytes.
  function qbeEmitGlobals(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    program: &Lir::LirProgram,
    foreignDefinitions: &Vector<u32>,
  ): void {
    let mut index: u64 = 0;

    while (index < program.globalInits.length()) {
      let Option::SOME(init) = program.globalInits.get(index) else {
        index += 1;
        continue;
      };

      if (CodegenC::hasRaw(foreignDefinitions, init.defId.raw())) {
        index += 1;
        continue;
      }

      CodegenQbe::qbeEmitOneGlobal(emitter, defStore, typeStore, symbols, init);
      index += 1;
    }
  }

  function qbeEmitOneGlobal(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    init: &Lir::GlobalInit,
  ): void {
    let Option::SOME(definition) = defStore.get(init.defId) else {
      return;
    };

    let mut variableTypeOpt: Option<Analyzer::TypeId> = Option::NONE;
    let mut declaredAlignment: u64 = 1;
    let mut linkage: str = "";

    if (let Analyzer::Definition::Variable(variableDef) = definition) {
      variableTypeOpt = Option::SOME(variableDef.declaredType);
      declaredAlignment = Abi::raisedAlignment(1, variableDef.alignment);

      if (variableDef.threadLocal) {
        linkage = "thread ";
      }
    }

    let Option::SOME(variableType) = variableTypeOpt else {
      return;
    };

    let name: String = CodegenQbe::qbeMangledName(defStore, symbols, init.defId);
    let layout: CodegenQbe::TypeLayout = CodegenQbe::typeLayout(emitter, defStore, typeStore, variableType);

    if (emitter.error.isSome()) {
      return;
    }

    let mut items: String = String::create("");
    let mut cursor: u64 = 0;
    let mut partIndex: u64 = 0;
    let mut starts: Vector<u64> = Vector::new<u64>();
    let mut ends: Vector<u64> = Vector::new<u64>();

    while (partIndex < init.parts.length()) {
      let Option::SOME(part) = init.parts.get(partIndex) else {
        partIndex += 1;
        continue;
      };

      match (part) {
        Lir::GlobalInitPart::Open -> {
          starts.push(cursor);
          ends.push(cursor);
        },
        Lir::GlobalInitPart::Close -> {
          if (let Option::SOME(end) = ends.pop()) {
            if (end > cursor) {
              items.pushStr(`z ${end - cursor}, `.toStr());
              cursor = end;
            }
          }
          starts.pop();
        },
        Lir::GlobalInitPart::Field(owner, fieldIndex) -> {
          let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(owner) else {
            CodegenQbe::failNamed(emitter, "GlobalInit");
            return;
          };

          let Option::SOME(fieldId) = recordDef.fields.get(fieldIndex as u64) else {
            CodegenQbe::failNamed(emitter, "GlobalInit");
            return;
          };

          let Option::SOME(Analyzer::Definition::Field(_)) = defStore.get(*fieldId) else {
            CodegenQbe::failNamed(emitter, "GlobalInit");
            return;
          };
          let mut base: u64 = 0;
          if (starts.length() > 0) {
            if (let Option::SOME(start) = starts.get(starts.length() - 1)) { base = *start; }
            let recordLayout: CodegenQbe::TypeLayout = CodegenQbe::recordLayout(emitter, defStore, typeStore, owner);
            ends.pop();
            ends.push(base + recordLayout.size);
          }
          let target: u64 = base + CodegenQbe::fieldOffset(emitter, defStore, typeStore, owner, fieldIndex as u64);
          if (target < cursor) {
            CodegenQbe::failNamed(emitter, "GlobalInit");
            return;
          }

          if (emitter.error.isSome()) {
            return;
          }

          if (target > cursor) {
            let pad: String = `z ${target - cursor}, `;

            items.pushStr(pad.toStr());
          }

          cursor = target;
        },
        Lir::GlobalInitPart::Value(value) -> {
          let Lir::Operand::Const(constValue) = value else {
            CodegenQbe::failNamed(emitter, "GlobalInit");
            return;
          };

          let Option::SOME(text) = CodegenQbe::constText(emitter, &constValue) else {
            return;
          };

          let itemType: Analyzer::TypeId = Lir::constValueType(&constValue);

          if (let Option::SOME(reference) = CodegenQbe::qbeTypeRefIfAggregate(emitter, defStore, typeStore, symbols, itemType)) {
            let item: String = `${reference.toStr()} ${text.toStr()}, `;

            items.pushStr(item.toStr());
          } else {
            let Option::SOME(letter) = CodegenQbe::qbeItemLetter(defStore, typeStore, itemType) else {
              CodegenQbe::failNamed(emitter, "GlobalInit");
              return;
            };

            let item: String = `${letter.toStr()} ${text.toStr()}, `;

            items.pushStr(item.toStr());
          }

          if (emitter.error.isSome()) {
            return;
          }

          cursor = cursor + CodegenQbe::qbeItemSize(emitter, defStore, typeStore, itemType);
        },
        Lir::GlobalInitPart::Zero(zeroType) -> {
          let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, zeroType);

          if (emitter.error.isSome()) {
            return;
          }

          let item: String = `z ${size}, `;

          items.pushStr(item.toStr());
          cursor = cursor + size;
        },
      };

      partIndex += 1;
    }

    if (layout.size > cursor) {
      let pad: String = `z ${layout.size - cursor}`;

      items.pushStr(pad.toStr());
    }

    let alignment: u64 = layout.alignment > declaredAlignment ? layout.alignment : declaredAlignment;
    let line: String = `${linkage}data $${name.toStr()} = align ${alignment} { ${items.toStr()} }\n`;

    emitter.data.pushStr(line.toStr());
  }

  /// The byte size QBE consumes for one data item of `ty`: a scalar letter's
  /// width, or the whole aggregate for a type reference.
  function qbeItemSize(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): u64 {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    if (let Option::SOME(letter) = CodegenQbe::qbeItemLetter(defStore, typeStore, resolved)) {
      return match (letter.equals("b")) {
        true -> 1,
        false -> match (letter.equals("h")) {
          true -> 2,
          false -> match (letter.equals("w")) {
            true -> 4,
            false -> 8,
          },
        },
      };
    }

    return CodegenQbe::typeSize(emitter, defStore, typeStore, resolved);
  }

  /// Whether a parameter of type `ty` is passed as the address of its storage
  /// rather than by value. A fixed array is, as the C backend passes it (the
  /// array decays to a pointer to its first element), so the two backends
  /// call each other with one convention. An aggregate value is already the
  /// address of its storage here, so the address is the value itself.
  function passesByAddress(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): boolean {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return false;
    };

    return match (typeNode) {
      Analyzer::Type::FixedArray(_, _) -> true,
      _ -> false,
    };
  }

  /// The `:name` reference for `ty` when it is an aggregate, NONE otherwise.
  function qbeTypeRefIfAggregate(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    ty: Analyzer::TypeId,
  ): Option<String> {
    let reference: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, ty);

    if (reference.length() == 0) {
      return Option::NONE;
    }

    return Option::SOME(reference);
  }

  /// Per-function emission state: stack slots the prepass reserved for
  /// aggregate temps, keyed by the temp's raw id.
  record QbeFuncCtx {
    public slotTemps: Vector<u32>;
    public slotNames: Vector<String>;
    public envTemps: Vector<u32>;
    public envNames: Vector<String>;

    public static init(): CodegenQbe::QbeFuncCtx {
      return CodegenQbe::QbeFuncCtx {
        slotTemps: Vector::new<u32>(),
        slotNames: Vector::new<String>(),
        envTemps: Vector::new<u32>(),
        envNames: Vector::new<String>(),
      };
    }

    public reserve(&mut self, tempRaw: u32, slot: String): void {
      self.slotTemps.push(tempRaw);
      self.slotNames.push(slot);
    }

    public reserveEnv(&mut self, tempRaw: u32, slot: String): void {
      self.envTemps.push(tempRaw);
      self.envNames.push(slot);
    }

    public slotFor(&self, tempRaw: u32): Option<String> {
      let mut index: u64 = 0;

      while (index < self.slotTemps.length()) {
        let mut found: boolean = false;

        if (let Option::SOME(existing) = self.slotTemps.get(index)) {
          if (*existing == tempRaw) {
            found = true;
          }
        }

        if (found) {
          if (let Option::SOME(name) = self.slotNames.get(index)) {
            return Option::SOME(name.clone());
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    public envSlotFor(&self, tempRaw: u32): Option<String> {
      let mut index: u64 = 0;

      while (index < self.envTemps.length()) {
        let mut found: boolean = false;

        if (let Option::SOME(existing) = self.envTemps.get(index)) {
          if (*existing == tempRaw) {
            found = true;
          }
        }

        if (found) {
          if (let Option::SOME(name) = self.envNames.get(index)) {
            return Option::SOME(name.clone());
          }
        }

        index += 1;
      }

      return Option::NONE;
    }
  }

  /// Reserves one stack slot per aggregate temp the function's instructions
  /// produce outside of calls: aggregate pointee loads and `MakeSlice` need
  /// independent storage. Reserve it in the entry block so loops do not grow
  /// the stack on every load. Call results with an aggregate
  /// type need no slot; QBE itself hands back caller storage for them.
  function qbeReserveSlots(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    context: &mut CodegenQbe::QbeFuncCtx,
    closures: &CodegenC::ClosureTables,
  ): void {
    let mut blockIndex: u64 = 0;

    while (blockIndex < function_.blocks.length()) {
      let Option::SOME(block) = function_.blocks.get(blockIndex) else {
        blockIndex += 1;
        continue;
      };

      let mut instrIndex: u64 = 0;

      while (instrIndex < block.instructions.length()) {
        let Option::SOME(instruction) = block.instructions.get(instrIndex) else {
          instrIndex += 1;
          continue;
        };

        let aggregateLoad: Option<Lir::TempId> = match (instruction) {
          Lir::Instr::LoadPtr(node) -> Option::SOME(node.dest),
          Lir::Instr::BuiltinLoad(node) -> Option::SOME(node.dest),
          Lir::Instr::EnumGetPayloadField(node) -> Option::SOME(node.dest),
          _ -> Option::NONE,
        };
        if (let Option::SOME(dest) = aggregateLoad) {
          let destOperand: Lir::Operand = Lir::Operand::Temp(dest);
          if (let Option::SOME(destType) = CodegenQbe::operandType(defStore, function_, &destOperand)) {
            if (CodegenQbe::isAggregateType(defStore, typeStore, destType)) {
              let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, destType);
              let slot: String = CodegenQbe::freshTemp(emitter);
              emitter.out.pushStr(`    ${slot.toStr()} =l alloc16 ${size}\n`.toStr());
              context.reserve(dest.raw(), slot);
            }
          }
        }

        // A compare-exchange passes `expected` by address, so it needs one
        // eight-byte slot for the whole function, never one per iteration.
        if (let Lir::Instr::Atomic(node) = instruction) {
          if (let Hir::AtomicOperation::COMPARE_EXCHANGE = node.operation) {
            if (let Option::SOME(dest) = node.dest) {
              let slot: String = CodegenQbe::freshTemp(emitter);
              emitter.out.pushStr(`    ${slot.toStr()} =l alloc8 8\n`.toStr());
              context.reserve(dest.raw(), slot);
            }
          }
        }

        if (let Lir::Instr::MakeSlice(node) = instruction) {
          let destOperand: Lir::Operand = Lir::Operand::Temp(node.dest);
          let Option::SOME(destType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
            instrIndex += 1;
            continue;
          };

          let reference: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, destType);

          if (reference.length() == 0) {
            instrIndex += 1;
            continue;
          }

          let slot: String = CodegenQbe::freshTemp(emitter);
          let line: String = `    ${slot.toStr()} =l alloc16 16\n`;

          emitter.out.pushStr(line.toStr());
          context.reserve(node.dest.raw(), slot);
        }

        // A function pointer read back as a closure gets the closure's slot
        // the same way.
        if (let Lir::Instr::RawToClosure(node) = instruction) {
          let closureSize: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, node.closureType);
          let closureSlot: String = CodegenQbe::freshTemp(emitter);

          emitter.out.pushStr(`    ${closureSlot.toStr()} =l alloc16 ${closureSize}\n`.toStr());
          context.reserve(node.dest.raw(), closureSlot);
        }

        if (let Lir::Instr::MakeClosure(node) = instruction) {
          let closureSize: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, node.closureType);
          let closureSlot: String = CodegenQbe::freshTemp(emitter);

          emitter.out.pushStr(`    ${closureSlot.toStr()} =l alloc16 ${closureSize}\n`.toStr());
          context.reserve(node.dest.raw(), closureSlot);

          // A non-escaping closure keeps its environment in this frame, so
          // one slot per site is reserved for the whole function, never one
          // per loop iteration. An escaping closure allocates it instead.
          if (!node.heapAllocate) {
            if (let Option::SOME(env) = CodegenQbe::qbeEnvFor(&closures.envs, node.thunk)) {
              let mut envSize: u64 = CodegenQbe::qbeEnvSize(emitter, defStore, typeStore, env);

              if (envSize == 0) {
                envSize = 1;
              }

              let envSlot: String = CodegenQbe::freshTemp(emitter);

              emitter.out.pushStr(`    ${envSlot.toStr()} =l alloc16 ${envSize}\n`.toStr());
              context.reserveEnv(node.dest.raw(), envSlot);
            }
          }
        }

        instrIndex += 1;
      }

      blockIndex += 1;
    }
  }

  /// The QBE text for a scalar return or parameter class, or the aggregate
  /// type reference with its trailing space. Void answers an empty string.
  function qbeTypeText(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    ty: Analyzer::TypeId,
  ): String {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);
    if (CodegenC::isVoidType(typeStore, resolved)) {
      return String::create("");
    }
    if (let Option::SOME(Analyzer::Type::NEVER) = typeStore.get(resolved)) {
      return String::create("");
    }

    if (let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, ty)) {
      let text: String = `${cls.toStr()} `;

      return text;
    }

    let reference: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, ty);

    if (reference.length() == 0) {
      CodegenQbe::failNamed(emitter, "Function");
      return String::create("");
    }

    let text: String = `${reference.toStr()} `;

    return text;
  }

  /// The class or type prefix of one parameter, with the `l ` spelling a
  /// by-address parameter (a fixed array) uses. The same rule
  /// `qbeFunctionHeader` and `qbeCallArg` apply.
  function qbeParameterPrefix(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    ty: Analyzer::TypeId,
  ): String {
    if (CodegenQbe::passesByAddress(defStore, typeStore, ty)) {
      return String::create("l ");
    }

    return CodegenQbe::qbeTypeText(emitter, defStore, typeStore, symbols, ty);
  }

  /// The signature line of one function: linkage, return class or type, the
  /// mangled symbol, and every parameter with its class or aggregate type.
  /// Parameters arrive as the temps `t0..tN`, so the header spells those
  /// names directly.
  function qbeFunctionHeader(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    externalSymbols: &Vector<u32>,
  ): String {
    let name: String = CodegenQbe::qbeMangledName(defStore, symbols, function_.defId);
    let mut linkage: String = String::create("function ");

    if (CodegenC::isExportedSymbol(defStore, function_.defId)) {
      linkage = String::create("export function ");
    } else {
      if (CodegenC::hasRaw(externalSymbols, function_.defId.raw())) {
        linkage = String::create("export function ");
      }
    }

    let returnText: String = CodegenQbe::qbeTypeText(emitter, defStore, typeStore, symbols, function_.returnType);

    if (emitter.error.isSome()) {
      return String::create("");
    }

    let mut header: String = `${linkage.toStr()}${returnText.toStr()}$${name.toStr()}(`;

    let mut index: u64 = 0;

    while (index < function_.params.length()) {
      let Option::SOME(paramDef) = function_.params.get(index) else {
        index += 1;
        continue;
      };

      let mut paramType: Option<Analyzer::TypeId> = Option::NONE;

      if (let Option::SOME(Analyzer::Definition::Variable(variableDef)) = defStore.get(*paramDef)) {
        paramType = Option::SOME(variableDef.declaredType);
      }

      let Option::SOME(foundType) = paramType else {
        CodegenQbe::failNamed(emitter, "Function");
        return String::create("");
      };

      if (index > 0) {
        header.pushStr(", ");
      }

      let tempName: String = `%t${index}`;

      if (CodegenQbe::passesByAddress(defStore, typeStore, foundType)) {
        let text: String = `l ${tempName.toStr()}`;

        header.pushStr(text.toStr());
      } else if (let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, foundType)) {
        let text: String = `${cls.toStr()} ${tempName.toStr()}`;

        header.pushStr(text.toStr());
      } else {
        let reference: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, foundType);

        if (reference.length() == 0) {
          CodegenQbe::failNamed(emitter, "Function");
          return String::create("");
        }

        let text: String = `${reference.toStr()} ${tempName.toStr()}`;

        header.pushStr(text.toStr());
      }

      index += 1;
    }

    if (function_.isVariadic) {
      if (function_.params.length() > 0) {
        header.pushStr(", ");
      }

      header.pushStr("...");
    }

    header.pushStr(") {\n");

    return header;
  }

  /// One `alloc` line per local slot, in declaration order, so `%l0..` match
  /// the LIR local ids. Scalars get 4- or 8-byte slots; every aggregate gets
  /// a 16-byte-aligned slot sized by the emitter's own layout.
  function qbeEmitLocalSlots(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
  ): void {
    let mut index: u64 = 0;

    while (index < function_.locals.length()) {
      let Option::SOME(local) = function_.locals.get(index) else {
        index += 1;
        continue;
      };

      let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, local.ty);

      if (emitter.error.isSome()) {
        return;
      }

      let mut slotOp: str = CodegenQbe::qbeSlotOp(size);

      if (CodegenQbe::isAggregateType(defStore, typeStore, local.ty)) {
        slotOp = "alloc16";
      }

      let line: String = `    %l${index} =l ${slotOp} ${size}\n`;

      emitter.out.pushStr(line.toStr());

      // A droppable local starts zeroed and marked dropped, so a drop that
      // reaches a slot no store initialized is a no-op instead of a free of
      // stack garbage. Mirrors the C emitter's prologue. A closure local has
      // no drop-state byte: zeroing it clears `drop_fn` and `call`.
      if (!local.borrowedAlias && !CodegenC::isVoidType(typeStore, local.ty) && CodegenC::fixedArrayShape(typeStore, local.ty).isNone()) {
        if (Hir::typeIsFunction(typeStore, local.ty)) {
          let clear: String = `    call $memset(l %l${index}, w 0, l ${size})\n`;

          emitter.out.pushStr(clear.toStr());
        } else {
          let scheduled: Vector<u32> = CodegenC::dropScheduledLocals(function_);

          if (CodegenC::containsLocalRaw(&scheduled, index as u32) || Borrowck::needsDropType(defStore, typeStore, local.ty)) {
            let clear: String = `    call $memset(l %l${index}, w 0, l ${size})\n`;

            emitter.out.pushStr(clear.toStr());

            // The helper exists only for a type `qbeAddMarkType` collected,
            // which is exactly the types that need dropping. Zeroing the slot
            // is the whole mark for a type whose only owner is a closure
            // field: clearing the closure's `drop_fn` cancels its drop.
            if (Borrowck::needsDropType(defStore, typeStore, local.ty)) {
              let name: String = CodegenQbe::qbeMarkMovedName(defStore, typeStore, local.ty);
              let mark: String = `    call $${name.toStr()}(l %l${index})\n`;

              emitter.out.pushStr(mark.toStr());
            }
          }
        }
      }

      index += 1;
    }
  }

  /// Stores one scalar into a byte address already computed: the typed store
  /// the value class asks for. Aggregates never come through here.
  function qbeStoreScalarAt(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
    value: &String,
    address: &String,
  ): void {
    let Option::SOME(store) = CodegenQbe::storeOp(defStore, typeStore, ty) else {
      CodegenQbe::failNamed(emitter, "Store");
      return;
    };

    let line: String = `    ${store.toStr()} ${value.toStr()}, ${address.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  /// Copies `size` bytes from the address of `value` into `address`: the one
  /// aggregate store, spelled as a libc `memcpy` call.
  function qbeMemcpy(
    emitter: &mut CodegenQbe::Emitter,
    address: &String,
    value: &String,
    size: u64,
  ): void {
    let line: String = `    call $memcpy(l ${address.toStr()}, l ${value.toStr()}, l ${size})\n`;

    emitter.out.pushStr(line.toStr());
  }

  /// `%to =l add %from, <offset>` for a nonzero offset, a plain copy when the
  /// field sits at zero.
  function qbeAddressOffset(
    emitter: &mut CodegenQbe::Emitter,
    origin: &String,
    offset: u64,
  ): String {
    let fresh: String = CodegenQbe::freshTemp(emitter);
    let mut line: String = String::create("");

    if (offset == 0) {
      line = `    ${fresh.toStr()} =l copy ${origin.toStr()}\n`;
    } else {
      line = `    ${fresh.toStr()} =l add ${origin.toStr()}, ${offset}\n`;
    }

    emitter.out.pushStr(line.toStr());

    return fresh;
  }

  /// Widens a scalar to `l` class for pointer arithmetic: `l` values pass
  /// through, narrow integers sign- or zero-extend by their signedness.
  function qbeWidenToLong(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
    value: &String,
  ): String {
    if (let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, ty)) {
      if (cls.equals("l")) {
        return value.clone();
      }
    }

    let mut ext: String = String::create("extsw");

    if (!CodegenQbe::isSignedInteger(defStore, typeStore, ty)) {
      ext = String::create("extuw");
    }

    let fresh: String = CodegenQbe::freshTemp(emitter);
    let line: String = `    ${fresh.toStr()} =l ${ext.toStr()} ${value.toStr()}\n`;

    emitter.out.pushStr(line.toStr());

    return fresh;
  }

  /// Emits one LIR instruction. Scalars travel through typed loads, stores
  /// and class-matched arithmetic; aggregates are addresses and move as
  /// `memcpy`; anything out of scope fails the unit closed.
  function qbeEmitInstruction(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    context: &mut CodegenQbe::QbeFuncCtx,
    instruction: &Lir::Instr,
    closures: &CodegenC::ClosureTables,
  ): void {
    match (instruction) {
      Lir::Instr::Nop -> {},
      Lir::Instr::Trap(_) -> {
        CodegenQbe::failFor(emitter, instruction);
      },
      Lir::Instr::Load(node) -> {
        CodegenQbe::qbeEmitLoad(emitter, defStore, typeStore, function_, &node);
      },
      Lir::Instr::Store(node) -> {
        CodegenQbe::qbeEmitStore(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::LoadPtr(node) -> {
        CodegenQbe::qbeEmitLoadPtr(emitter, defStore, typeStore, symbols, function_, context, &node);
      },
      Lir::Instr::StorePtr(node) -> {
        CodegenQbe::qbeEmitStorePtr(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::BuiltinLoad(node) -> {
        if (node.volatile) { CodegenQbe::failFor(emitter, instruction); return; }
        let view: Lir::InstrLoadPtr = Lir::InstrLoadPtr { dest: node.dest, ptr: Lir::copyOperand(&node.ptr) };

        CodegenQbe::qbeEmitLoadPtr(emitter, defStore, typeStore, symbols, function_, context, &view);
      },
      Lir::Instr::BuiltinStore(node) -> {
        if (node.volatile) { CodegenQbe::failFor(emitter, instruction); return; }
        let view: Lir::InstrStorePtr = Lir::InstrStorePtr { ptr: Lir::copyOperand(&node.ptr), value: Lir::copyOperand(&node.value) };

        CodegenQbe::qbeEmitStorePtr(emitter, defStore, typeStore, symbols, function_, &view);
      },
      Lir::Instr::Copy(node) -> {
        CodegenQbe::qbeEmitCopy(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::BinOp(node) -> {
        CodegenQbe::qbeEmitBinOp(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::UnaryOp(node) -> {
        CodegenQbe::qbeEmitUnaryOp(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::Atomic(node) -> {
        CodegenQbe::qbeEmitAtomic(emitter, defStore, typeStore, symbols, function_, context, &node);
      },
      Lir::Instr::Call(node) -> {
        CodegenQbe::qbeEmitCall(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::RuntimeCall(_) -> {
        CodegenQbe::failFor(emitter, instruction);
      },
      Lir::Instr::Cast(node) -> {
        CodegenQbe::qbeEmitCast(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::BitCast(node) -> {
        CodegenQbe::qbeEmitCast(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::AddrOfLocal(node) -> {
        let line: String = `    %t${node.dest.raw()} =l copy %l${node.local.raw()}\n`;

        emitter.out.pushStr(line.toStr());
      },
      Lir::Instr::AddrOfGlobal(node) -> {
        let address: String = CodegenQbe::globalAddress(defStore, symbols, node.def);
        let line: String = `    %t${node.dest.raw()} =l copy ${address.toStr()}\n`;

        emitter.out.pushStr(line.toStr());
      },
      Lir::Instr::GetElementPtr(node) -> {
        CodegenQbe::qbeEmitGetElementPtr(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::MakeSlice(node) -> {
        CodegenQbe::qbeEmitMakeSlice(emitter, defStore, typeStore, symbols, function_, context, &node);
      },
      Lir::Instr::InitZero(node) -> {
        CodegenQbe::qbeEmitInitZero(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::InitSplat(node) -> {
        CodegenQbe::qbeEmitInitSplat(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::SizeOf(node) -> {
        let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, node.ty);
        let line: String = `    %t${node.dest.raw()} =l copy ${size}\n`;

        emitter.out.pushStr(line.toStr());
      },
      Lir::Instr::AlignOf(node) -> {
        let alignment: u64 = CodegenQbe::typeAlign(emitter, defStore, typeStore, node.ty);
        let line: String = `    %t${node.dest.raw()} =l copy ${alignment}\n`;

        emitter.out.pushStr(line.toStr());
      },
      Lir::Instr::MaxOf(node) -> {
        CodegenQbe::qbeEmitMaxMin(emitter, defStore, typeStore, &node, true);
      },
      Lir::Instr::MinOf(node) -> {
        CodegenQbe::qbeEmitMaxMin(emitter, defStore, typeStore, &node, false);
      },
      Lir::Instr::PanicMessage(node) -> {
        CodegenQbe::qbeEmitPanic(emitter, &node.message);
      },
      Lir::Instr::Drop(node) -> {
        CodegenQbe::qbeEmitDrop(emitter, defStore, typeStore, function_, node.local);
      },
      Lir::Instr::DropInPlace(node) -> {
        CodegenQbe::qbeEmitDropInPlace(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::DropGlue(node) -> {
        let name: String = CodegenQbe::qbeDropGlueName(defStore, typeStore, node.ty);
        let line: String = `    %t${node.dest.raw()} =l copy $${name.toStr()}\n`;

        emitter.out.pushStr(line.toStr());
      },
      Lir::Instr::MarkMoved(node) -> {
        CodegenQbe::qbeEmitMarkMoved(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::GetFieldPtr(node) -> {
        CodegenQbe::qbeEmitGetFieldPtr(emitter, defStore, typeStore, symbols, function_, &node, closures);
      },
      Lir::Instr::InitRecord(node) -> {
        CodegenQbe::qbeEmitInitRecord(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::InitEnumVariant(node) -> {
        CodegenQbe::qbeEmitInitEnumVariant(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::EnumGetTag(node) -> {
        CodegenQbe::qbeEmitEnumGetTag(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::EnumGetPayloadField(node) -> {
        CodegenQbe::qbeEmitEnumGetPayloadField(emitter, defStore, typeStore, symbols, function_, context, &node);
      },
      Lir::Instr::EnumGetPayloadFieldPtr(node) -> {
        CodegenQbe::qbeEmitEnumGetPayloadFieldPtr(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::BuiltinEq(node) -> {
        CodegenQbe::qbeEmitBuiltinEq(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::MakeClosure(node) -> {
        CodegenQbe::qbeEmitMakeClosure(emitter, defStore, typeStore, symbols, function_, context, &node, closures);
      },
      Lir::Instr::CallClosure(node) -> {
        CodegenQbe::qbeEmitCallClosure(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::DropClosure(node) -> {
        CodegenQbe::qbeEmitDropClosure(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::FreeEnv(node) -> {
        CodegenQbe::qbeEmitFreeEnv(emitter, defStore, typeStore, symbols, function_, &node);
      },
      Lir::Instr::MakeRawFunction(node) -> {
        CodegenQbe::qbeEmitMakeRawFunction(emitter, defStore, symbols, function_, &node);
      },
      Lir::Instr::RawToClosure(node) -> {
        CodegenQbe::qbeEmitRawToClosure(emitter, defStore, typeStore, symbols, function_, context, &node);
      },
      _ -> {
        CodegenQbe::failFor(emitter, instruction);
      },
    };
  }

  function qbeEmitLoad(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrLoad,
  ): void {
    let sourceOperand: Lir::Operand = Lir::Operand::Local(node.source);
    let Option::SOME(localType) = CodegenQbe::operandType(defStore, function_, &sourceOperand) else {
      CodegenQbe::failNamed(emitter, "Load");
      return;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, localType)) {
      let line: String = `    %t${node.dest.raw()} =l copy %l${node.source.raw()}\n`;

      emitter.out.pushStr(line.toStr());
      return;
    }

    let Option::SOME(load) = CodegenQbe::loadOp(defStore, typeStore, localType) else {
      CodegenQbe::failNamed(emitter, "Load");
      return;
    };

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, localType) else {
      CodegenQbe::failNamed(emitter, "Load");
      return;
    };

    let line: String = `    %t${node.dest.raw()} =${cls.toStr()} ${load.toStr()} %l${node.source.raw()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitStore(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrStore,
  ): void {
    let destOperand: Lir::Operand = Lir::Operand::Local(node.dest);
    let Option::SOME(destType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
      CodegenQbe::failNamed(emitter, "Store");
      return;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, destType)) {
      let Option::SOME(valueAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.value) else {
        return;
      };

      let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, destType);
      let slot: String = `%l${node.dest.raw()}`;

      CodegenQbe::qbeMemcpy(emitter, &slot, &valueAddress, size);
      return;
    }

    let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.value) else {
      return;
    };

    let slot: String = `%l${node.dest.raw()}`;

    CodegenQbe::qbeStoreScalarAt(emitter, defStore, typeStore, destType, &value, &slot);
  }

  function qbeEmitLoadPtr(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    context: &mut CodegenQbe::QbeFuncCtx,
    node: &Lir::InstrLoadPtr,
  ): void {
    let destOperand: Lir::Operand = Lir::Operand::Temp(node.dest);
    let Option::SOME(destType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
      CodegenQbe::failNamed(emitter, "LoadPtr");
      return;
    };

    let Option::SOME(pointer) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.ptr) else {
      return;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, destType)) {
      let Option::SOME(slot) = context.slotFor(node.dest.raw()) else {
        CodegenQbe::failNamed(emitter, "LoadPtr");
        return;
      };
      let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, destType);
      CodegenQbe::qbeMemcpy(emitter, &slot, &pointer, size);
      let line: String = `    %t${node.dest.raw()} =l copy ${slot.toStr()}\n`;
      emitter.out.pushStr(line.toStr());
      return;
    }

    let Option::SOME(load) = CodegenQbe::loadOp(defStore, typeStore, destType) else {
      CodegenQbe::failNamed(emitter, "LoadPtr");
      return;
    };

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, destType) else {
      CodegenQbe::failNamed(emitter, "LoadPtr");
      return;
    };

    let line: String = `    %t${node.dest.raw()} =${cls.toStr()} ${load.toStr()} ${pointer.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitStorePtr(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrStorePtr,
  ): void {
    let Option::SOME(pointer) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.ptr) else {
      return;
    };

    let Option::SOME(valueType) = CodegenQbe::operandType(defStore, function_, &node.value) else {
      CodegenQbe::failNamed(emitter, "StorePtr");
      return;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, valueType)) {
      let Option::SOME(valueAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.value) else {
        return;
      };

      let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, valueType);

      CodegenQbe::qbeMemcpy(emitter, &pointer, &valueAddress, size);
      return;
    }

    let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.value) else {
      return;
    };

    CodegenQbe::qbeStoreScalarAt(emitter, defStore, typeStore, valueType, &value, &pointer);
  }

  function qbeEmitCopy(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrCopy,
  ): void {
    let destOperand: Lir::Operand = Lir::Operand::Temp(node.dest);
    let Option::SOME(destType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
      CodegenQbe::failNamed(emitter, "Copy");
      return;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, destType)) {
      let Option::SOME(sourceAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.source) else {
        return;
      };

      let line: String = `    %t${node.dest.raw()} =l copy ${sourceAddress.toStr()}\n`;

      emitter.out.pushStr(line.toStr());
      return;
    }

    let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.source) else {
      return;
    };

    let normalized: String = CodegenQbe::qbeNormalize(emitter, defStore, typeStore, destType, &value);

    if (emitter.error.isSome()) {
      return;
    }

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, destType) else {
      CodegenQbe::failNamed(emitter, "Copy");
      return;
    };

    let line: String = `    %t${node.dest.raw()} =${cls.toStr()} copy ${normalized.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  /// The QBE comparison mnemonic for one Hir binary operation over operands
  /// of `ty`: `c<cmp><class>`, signed or unsigned by the operand type.
  function qbeCompareOp(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    op: &Hir::BinaryOperation,
    ty: Analyzer::TypeId,
  ): String {
    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, ty) else {
      CodegenQbe::failNamed(emitter, "BinOp");
      return String::create("ceqw");
    };

    let signed: boolean = CodegenQbe::isSignedInteger(defStore, typeStore, ty);
    let mut stem: String = String::create("eq");

    match (op) {
      Hir::BinaryOperation::Equal -> {
        stem = String::create("eq");
      },
      Hir::BinaryOperation::NotEqual -> {
        stem = String::create("ne");
      },
      Hir::BinaryOperation::LessThan -> {
        if (signed) {
          stem = String::create("slt");
        } else {
          stem = String::create("ult");
        }
      },
      Hir::BinaryOperation::LessEqual -> {
        if (signed) {
          stem = String::create("sle");
        } else {
          stem = String::create("ule");
        }
      },
      Hir::BinaryOperation::GreaterThan -> {
        if (signed) {
          stem = String::create("sgt");
        } else {
          stem = String::create("ugt");
        }
      },
      Hir::BinaryOperation::GreaterEqual -> {
        if (signed) {
          stem = String::create("sge");
        } else {
          stem = String::create("uge");
        }
      },
      _ -> {
        CodegenQbe::failNamed(emitter, "BinOp");
      },
    };

    return `c${stem.toStr()}${cls.toStr()}`;
  }

  /// The plain arithmetic mnemonic for one Hir binary operation, with the
  /// signedness the operand type asks for on div, mod and right shifts.
  function qbeArithOp(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    op: &Hir::BinaryOperation,
    ty: Analyzer::TypeId,
  ): String {
    let signed: boolean = CodegenQbe::isSignedInteger(defStore, typeStore, ty);

    return match (op) {
      Hir::BinaryOperation::Add -> String::create("add"),
      Hir::BinaryOperation::Sub -> String::create("sub"),
      Hir::BinaryOperation::Mul -> String::create("mul"),
      Hir::BinaryOperation::Div -> {
        if (signed) {
          return String::create("div");
        }

        return String::create("udiv");
      },
      Hir::BinaryOperation::Mod -> {
        if (signed) {
          return String::create("rem");
        }

        return String::create("urem");
      },
      Hir::BinaryOperation::BitAnd -> String::create("and"),
      Hir::BinaryOperation::BitOr -> String::create("or"),
      Hir::BinaryOperation::BitXor -> String::create("xor"),
      Hir::BinaryOperation::BitShiftLeft -> String::create("shl"),
      Hir::BinaryOperation::BitShiftRight -> {
        if (signed) {
          return String::create("sar");
        }


        return String::create("shr");
      },
      Hir::BinaryOperation::And -> String::create("and"),
      Hir::BinaryOperation::Or -> String::create("or"),
      _ -> {
        CodegenQbe::failNamed(emitter, "BinOp");
        String::create("")
      },
    };
  }

  /// One `==`/`!=` on a fieldless enum as a comparison of the `u32` tags. A
  /// scalar enum's value already is the tag; an aggregate one is the address
  /// of its storage, so the tag is loaded from its first word.
  function qbeEmitUnitEnumComparison(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrBinOp,
    leftType: Analyzer::TypeId,
  ): void {
    let Option::SOME(leftValue) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.left) else {
      return;
    };

    let Option::SOME(rightValue) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.right) else {
      return;
    };

    let mut left: String = leftValue;

    if (CodegenQbe::isAggregateType(defStore, typeStore, leftType)) {
      let tag: String = CodegenQbe::freshTemp(emitter);
      emitter.out.pushStr(`    ${tag.toStr()} =w loaduw ${left.toStr()}\n`.toStr());
      left = tag;
    }

    let Option::SOME(rightType) = CodegenQbe::operandType(defStore, function_, &node.right) else {
      CodegenQbe::failNamed(emitter, "BinOp");
      return;
    };

    let mut right: String = rightValue;

    if (CodegenQbe::isAggregateType(defStore, typeStore, rightType)) {
      let tag: String = CodegenQbe::freshTemp(emitter);
      emitter.out.pushStr(`    ${tag.toStr()} =w loaduw ${right.toStr()}\n`.toStr());
      right = tag;
    }

    let mut stem: String = String::create("eq");

    if (let Hir::BinaryOperation::NotEqual = node.op) {
      stem = String::create("ne");
    }

    emitter.out.pushStr(`    %t${node.dest.raw()} =w c${stem.toStr()}w ${left.toStr()}, ${right.toStr()}\n`.toStr());
  }

  function qbeEmitBinOp(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrBinOp,
  ): void {
    let destOperand: Lir::Operand = Lir::Operand::Temp(node.dest);
    let Option::SOME(destType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
      CodegenQbe::failNamed(emitter, "BinOp");
      return;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, destType)) {
      CodegenQbe::failNamed(emitter, "BinOp");
      return;
    }

    let Option::SOME(leftType) = CodegenQbe::operandType(defStore, function_, &node.left) else {
      CodegenQbe::failNamed(emitter, "BinOp");
      return;
    };

    // Equality on a fieldless enum compares tags: an aggregate enum (one that
    // implements `Drop`) is the address of its storage, so its `u32` tag is the
    // first word. The C emitter does the same with `.tag`.
    if (CodegenC::isEqualityOperation(&node.op) && CodegenC::isUnitEnumOperand(defStore, typeStore, function_, &node.left)) {
      CodegenQbe::qbeEmitUnitEnumComparison(emitter, defStore, typeStore, symbols, function_, &node, leftType);
      return;
    }

    let Option::SOME(left) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.left) else {
      return;
    };

    let Option::SOME(right) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.right) else {
      return;
    };

    // `str` equality compares the bytes up to the terminator, as the C
    // emitter does.
    if (CodegenC::isEqualityOperation(&node.op) && CodegenC::isStrOperand(typeStore, function_, &node.left)) {
      let call: String = CodegenQbe::freshTemp(emitter);
      let mut compare: str = "ceqw";

      if (node.op == Hir::BinaryOperation::NotEqual) {
        compare = "cnew";
      }

      emitter.out.pushStr(`    ${call.toStr()} =w call $strcmp(l ${left.toStr()}, l ${right.toStr()})\n`.toStr());
      emitter.out.pushStr(`    %t${node.dest.raw()} =w ${compare} ${call.toStr()}, 0\n`.toStr());
      return;
    }

    let dest: String = `%t${node.dest.raw()}`;
    let mut isCompare: boolean = false;

    match (node.op) {
      Hir::BinaryOperation::Equal -> {
        isCompare = true;
      },
      Hir::BinaryOperation::NotEqual -> {
        isCompare = true;
      },
      Hir::BinaryOperation::LessThan -> {
        isCompare = true;
      },
      Hir::BinaryOperation::LessEqual -> {
        isCompare = true;
      },
      Hir::BinaryOperation::GreaterThan -> {
        isCompare = true;
      },
      Hir::BinaryOperation::GreaterEqual -> {
        isCompare = true;
      },
      _ -> {},
    };

    if (isCompare) {
      let compare: String = CodegenQbe::qbeCompareOp(emitter, defStore, typeStore, &node.op, leftType);
      let line: String = `    ${dest.toStr()} =w ${compare.toStr()} ${left.toStr()}, ${right.toStr()}\n`;

      emitter.out.pushStr(line.toStr());
      return;
    }

    let arith: String = CodegenQbe::qbeArithOp(emitter, defStore, typeStore, &node.op, leftType);

    if (arith.length() == 0) {
      return;
    }

    if (emitter.error.isSome()) {
      return;
    }

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, destType) else {
      CodegenQbe::failNamed(emitter, "BinOp");
      return;
    };

    let mut rightText: String = right.clone();

    match (node.op) {
      Hir::BinaryOperation::BitShiftLeft -> {
        rightText = CodegenQbe::qbeMaskShift(emitter, defStore, typeStore, destType, &right);
      },
      Hir::BinaryOperation::BitShiftRight -> {
        rightText = CodegenQbe::qbeMaskShift(emitter, defStore, typeStore, destType, &right);
      },
      _ -> {},
    };

    if (emitter.error.isSome()) {
      return;
    }

    let line: String = `    ${dest.toStr()} =${cls.toStr()} ${arith.toStr()} ${left.toStr()}, ${rightText.toStr()}\n`;

    emitter.out.pushStr(line.toStr());

    CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, destType, &dest);
  }

  /// Masks a shift count to the width of the shifted value, matching the
  /// masked-shift semantics the C backend gets from the hardware.
  function qbeMaskShift(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
    count: &String,
  ): String {
    if (CodegenQbe::qbeClass(defStore, typeStore, ty).isNone()) {
      CodegenQbe::failNamed(emitter, "BinOp");
      return count.clone();
    }

    let width: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, ty) * 8;
    if (width == 0) {
      CodegenQbe::failNamed(emitter, "BinOp");
      return count.clone();
    }
    let mask: u64 = width - 1;

    let fresh: String = CodegenQbe::freshTemp(emitter);
    let line: String = `    ${fresh.toStr()} =w and ${count.toStr()}, ${mask}\n`;

    emitter.out.pushStr(line.toStr());

    return fresh;
  }

  /// Re-normalizes a narrow result already sitting in `dest`, so consumers
  /// read the declared width and not the garbage above it.
  function qbeNormalizeInPlace(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
    dest: &String,
  ): void {
    let Option::SOME(ext) = CodegenQbe::qbeExtOp(defStore, typeStore, ty) else {
      return;
    };

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, ty) else {
      return;
    };

    let fresh: String = CodegenQbe::freshTemp(emitter);
    let extend: String = `    ${fresh.toStr()} =${cls.toStr()} ${ext.toStr()} ${dest.toStr()}\n`;
    let copyBack: String = `    ${dest.toStr()} =${cls.toStr()} copy ${fresh.toStr()}\n`;

    emitter.out.pushStr(extend.toStr());
    emitter.out.pushStr(copyBack.toStr());
  }

  function qbeEmitUnaryOp(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrUnaryOp,
  ): void {
    let destOperand: Lir::Operand = Lir::Operand::Temp(node.dest);
    let Option::SOME(destType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
      CodegenQbe::failNamed(emitter, "UnaryOp");
      return;
    };

    let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.operand) else {
      return;
    };

    let dest: String = `%t${node.dest.raw()}`;
    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, destType) else {
      CodegenQbe::failNamed(emitter, "UnaryOp");
      return;
    };

    match (node.op) {
      Hir::UnaryOperation::Not -> {
        let line: String = `    ${dest.toStr()} =w xor ${value.toStr()}, 1\n`;

        emitter.out.pushStr(line.toStr());
      },
      Hir::UnaryOperation::Neg -> {
        let line: String = `    ${dest.toStr()} =${cls.toStr()} sub 0, ${value.toStr()}\n`;

        emitter.out.pushStr(line.toStr());
        CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, destType, &dest);
      },
      Hir::UnaryOperation::BitNot -> {
        let line: String = `    ${dest.toStr()} =${cls.toStr()} xor ${value.toStr()}, -1\n`;

        emitter.out.pushStr(line.toStr());
        CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, destType, &dest);
      },
    };
  }

  /// The classed text of one call argument: `w`/`l` for scalars, the
  /// aggregate type reference for records, slices and arrays.
  function qbeCallArg(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    argument: &Lir::Operand,
  ): String {
    let Option::SOME(argumentType) = CodegenC::operandType(function_, argument) else {
      CodegenQbe::failNamed(emitter, "Call");
      return String::create("");
    };

    let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, argument) else {
      return String::create("");
    };

    if (CodegenQbe::passesByAddress(defStore, typeStore, argumentType)) {
      return `l ${value.toStr()}`;
    }

    if (let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, argumentType)) {
      return `${cls.toStr()} ${value.toStr()}`;
    }

    let reference: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, argumentType);

    if (reference.length() == 0) {
      CodegenQbe::failNamed(emitter, "Call");
      return String::create("");
    }

    return `${reference.toStr()} ${value.toStr()}`;
  }

  /// The `call` line for `name` over `args`, with the destination prefix the
  /// return class asks for.
  function qbeCallLine(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    name: &String,
    args: &Vector<String>,
    destPrefix: &String,
  ): void {
    let mut call: String = String::create("    ");

    call.pushStr(destPrefix.toStr());
    let head: String = `call $${name.toStr()}(`;

    call.pushStr(head.toStr());

    let mut index: u64 = 0;

    while (index < args.length()) {
      if (let Option::SOME(argument) = args.get(index)) {
        if (index > 0) {
          call.pushStr(", ");
        }

        call.pushStr(argument.toStr());
      }

      index += 1;
    }

    call.pushStr(")\n");

    emitter.out.pushStr(call.toStr());
  }

  function qbeEmitCall(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrCall,
  ): void {
    CodegenQbe::qbeEmitReceiverGuard(emitter, defStore, typeStore, symbols, function_, node);

    let name: String = CodegenQbe::qbeMangledName(defStore, symbols, node.callee);
    let mut args: Vector<String> = Vector::new<String>();
    let mut index: u64 = 0;

    while (index < node.args.length()) {
      if (let Option::SOME(argument) = node.args.get(index)) {
        let text: String = CodegenQbe::qbeCallArg(emitter, defStore, typeStore, symbols, function_, argument);

        if (emitter.error.isSome()) {
          return;
        }

        args.push(text);
      }

      index += 1;
    }

    // Typed extern wrappers do not retain the C prototype's variadic flag.
    // For this integer-only slice the variadic call convention also matches
    // fixed prototypes, while ensuring the SysV vector-register count is zero.
    if (args.length() > 0 && CodegenC::isExternFunction(defStore, node.callee)) {
      args.push(String::create("..."));
    }
    let noPrefix: String = String::create("");

    let Option::SOME(dest) = node.dest else {
      CodegenQbe::qbeCallLine(emitter, defStore, typeStore, symbols, &name, &args, &noPrefix);
      return;
    };

    let destOperand: Lir::Operand = Lir::Operand::Temp(dest);
    let Option::SOME(returnType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
      CodegenQbe::failNamed(emitter, "Call");
      return;
    };

    let destName: String = `%t${dest.raw()}`;

    let resolvedReturn: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, returnType);
    let mut neverReturns: boolean = false;
    if (let Option::SOME(Analyzer::Type::NEVER) = typeStore.get(resolvedReturn)) {
      neverReturns = true;
    }
    if (CodegenC::isVoidType(typeStore, returnType) || neverReturns) {
      CodegenQbe::qbeCallLine(emitter, defStore, typeStore, symbols, &name, &args, &noPrefix);
      return;
    }

    if (let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, returnType)) {
      let prefix: String = `${destName.toStr()} =${cls.toStr()} `;

      CodegenQbe::qbeCallLine(emitter, defStore, typeStore, symbols, &name, &args, &prefix);
      CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, returnType, &destName);
      return;
    }

    let reference: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, returnType);

    if (reference.length() == 0) {
      CodegenQbe::failNamed(emitter, "Call");
      return;
    }

    let prefix: String = `${destName.toStr()} =${reference.toStr()} `;

    CodegenQbe::qbeCallLine(emitter, defStore, typeStore, symbols, &name, &args, &prefix);
  }

  /// The libatomic `int` constant of a memory ordering, as `__ATOMIC_*`
  /// defines it.
  function qbeAtomicOrdering(ordering: Hir::AtomicOrdering): u32 {
    return match (ordering) {
      Hir::AtomicOrdering::RELAXED -> 0,
      Hir::AtomicOrdering::ACQUIRE -> 2,
      Hir::AtomicOrdering::RELEASE -> 3,
      Hir::AtomicOrdering::ACQ_REL -> 4,
      Hir::AtomicOrdering::SEQ_CST -> 5,
    };
  }

  /// The libatomic entry point of an operation, without its size suffix.
  function qbeAtomicFunction(operation: Hir::AtomicOperation): str {
    return match (operation) {
      Hir::AtomicOperation::LOAD -> "__atomic_load",
      Hir::AtomicOperation::STORE -> "__atomic_store",
      Hir::AtomicOperation::SWAP -> "__atomic_exchange",
      Hir::AtomicOperation::ADD -> "__atomic_fetch_add",
      Hir::AtomicOperation::SUB -> "__atomic_fetch_sub",
      Hir::AtomicOperation::AND -> "__atomic_fetch_and",
      Hir::AtomicOperation::OR -> "__atomic_fetch_or",
      Hir::AtomicOperation::XOR -> "__atomic_fetch_xor",
      Hir::AtomicOperation::COMPARE_EXCHANGE -> "__atomic_compare_exchange",
      Hir::AtomicOperation::FENCE -> "atomic_thread_fence",
    };
  }

  /// One atomic builtin as a call into libatomic, since QBE has no atomic
  /// instructions. The sized entry points (`__atomic_fetch_add_8`, ...) take
  /// the value in its C class; narrow values are already normalized, which is
  /// the extension the C ABI asks of the caller. The libatomic
  /// compare-exchange is strong and writes the observed value back through
  /// `expected`, so `expected` goes through the slot `qbeReserveSlots` set
  /// aside and the result is read back from it.
  function qbeEmitAtomic(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    context: &mut CodegenQbe::QbeFuncCtx,
    node: &Lir::InstrAtomic,
  ): void {
    let ordering: u32 = CodegenQbe::qbeAtomicOrdering(node.ordering);

    if (let Hir::AtomicOperation::FENCE = node.operation) {
      emitter.out.pushStr(`    call $atomic_thread_fence(w ${ordering})\n`.toStr());
      return;
    }

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, node.ty) else {
      CodegenQbe::failNamed(emitter, "Atomic");
      return;
    };
    let Option::SOME(letter) = CodegenQbe::qbeItemLetter(defStore, typeStore, node.ty) else {
      CodegenQbe::failNamed(emitter, "Atomic");
      return;
    };
    let size: u64 = match (letter.equals("b")) {
      true -> 1,
      false -> match (letter.equals("h")) {
        true -> 2,
        false -> match (letter.equals("w")) {
          true -> 4,
          false -> 8,
        },
      },
    };
    let name: String = `${CodegenQbe::qbeAtomicFunction(node.operation)}_${size}`;

    let Option::SOME(pointerOperand) = node.operands.get(0) else {
      CodegenQbe::failNamed(emitter, "Atomic");
      return;
    };
    let Option::SOME(pointer) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, pointerOperand) else {
      return;
    };

    let mut values: Vector<String> = Vector::new<String>();
    let mut index: u64 = 1;

    while (index < node.operands.length()) {
      if (let Option::SOME(operand) = node.operands.get(index)) {
        let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, operand) else {
          return;
        };

        values.push(value);
      }

      index += 1;
    }

    let mut args: Vector<String> = Vector::new<String>();

    args.push(`l ${pointer.toStr()}`);

    if (let Hir::AtomicOperation::COMPARE_EXCHANGE = node.operation) {
      let Option::SOME(dest) = node.dest else {
        CodegenQbe::failNamed(emitter, "Atomic");
        return;
      };
      let Option::SOME(slot) = context.slotFor(dest.raw()) else {
        CodegenQbe::failNamed(emitter, "Atomic");
        return;
      };
      let Option::SOME(expected) = values.get(0) else {
        CodegenQbe::failNamed(emitter, "Atomic");
        return;
      };
      let Option::SOME(desired) = values.get(1) else {
        CodegenQbe::failNamed(emitter, "Atomic");
        return;
      };

      CodegenQbe::qbeStoreScalarAt(emitter, defStore, typeStore, node.ty, expected, &slot);
      args.push(`l ${slot.toStr()}`);
      args.push(`${cls.toStr()} ${desired.toStr()}`);
      args.push(`w ${ordering}`);
      args.push(`w ${CodegenQbe::qbeAtomicOrdering(node.failureOrdering)}`);

      let noPrefix: String = String::create("");

      CodegenQbe::qbeCallLine(emitter, defStore, typeStore, symbols, &name, &args, &noPrefix);

      let Option::SOME(load) = CodegenQbe::loadOp(defStore, typeStore, node.ty) else {
        CodegenQbe::failNamed(emitter, "Atomic");
        return;
      };

      emitter.out.pushStr(`    %t${dest.raw()} =${cls.toStr()} ${load.toStr()} ${slot.toStr()}\n`.toStr());
      return;
    }

    if (let Option::SOME(value) = values.get(0)) {
      args.push(`${cls.toStr()} ${value.toStr()}`);
    }

    args.push(`w ${ordering}`);

    let Option::SOME(dest) = node.dest else {
      let noPrefix: String = String::create("");

      CodegenQbe::qbeCallLine(emitter, defStore, typeStore, symbols, &name, &args, &noPrefix);
      return;
    };

    let destName: String = `%t${dest.raw()}`;
    let prefix: String = `${destName.toStr()} =${cls.toStr()} `;

    CodegenQbe::qbeCallLine(emitter, defStore, typeStore, symbols, &name, &args, &prefix);
    CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, node.ty, &destName);
  }

  function qbeEmitCast(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrCast,
  ): void {
    let Option::SOME(sourceType) = CodegenQbe::operandType(defStore, function_, &node.source) else {
      CodegenQbe::failNamed(emitter, "Cast");
      return;
    };

    let sourceResolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, sourceType);
    let targetResolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, node.targetType);
    let Option::SOME(sourceNode) = typeStore.get(sourceResolved) else {
      CodegenQbe::failNamed(emitter, "Cast");
      return;
    };

    let mut sourceIsFloat: boolean = false;

    match (sourceNode) {
      Analyzer::Type::F32 -> {
        sourceIsFloat = true;
      },
      Analyzer::Type::F64 -> {
        sourceIsFloat = true;
      },
      _ -> {},
    };

    let Option::SOME(targetNode) = typeStore.get(targetResolved) else {
      CodegenQbe::failNamed(emitter, "Cast");
      return;
    };

    let mut targetIsFloat: boolean = false;

    match (targetNode) {
      Analyzer::Type::F32 -> {
        targetIsFloat = true;
      },
      Analyzer::Type::F64 -> {
        targetIsFloat = true;
      },
      _ -> {},
    };

    if (sourceIsFloat || targetIsFloat) {
      CodegenQbe::failNamed(emitter, "Cast");
      return;
    }

    let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.source) else {
      return;
    };

    let dest: String = `%t${node.dest.raw()}`;

    let mut sourceIsBool: boolean = false;

    match (sourceNode) {
      Analyzer::Type::BOOLEAN -> {
        sourceIsBool = true;
      },
      _ -> {},
    };

    let mut targetIsBool: boolean = false;

    match (targetNode) {
      Analyzer::Type::BOOLEAN -> {
        targetIsBool = true;
      },
      _ -> {},
    };

    if (targetIsBool) {
      let mut sourceCls: String = String::create("w");

      if (let Option::SOME(found) = CodegenQbe::qbeClass(defStore, typeStore, sourceResolved)) {
        sourceCls = found;
      }

      let mut compare: String = String::create("cnew");

      if (sourceCls.equals("l")) {
        compare = String::create("cnel");
      }

      let line: String = `    ${dest.toStr()} =w ${compare.toStr()} ${value.toStr()}, 0\n`;

      emitter.out.pushStr(line.toStr());
      return;
    }

    if (sourceIsBool) {
      let Option::SOME(targetCls) = CodegenQbe::qbeClass(defStore, typeStore, targetResolved) else {
        CodegenQbe::failNamed(emitter, "Cast");
        return;
      };

      let operation: str = targetCls.equals("l") ? "extuw" : "copy";
      let line: String = `    ${dest.toStr()} =${targetCls.toStr()} ${operation} ${value.toStr()}\n`;

      emitter.out.pushStr(line.toStr());
      return;
    }

    if (let Option::SOME(sourceCls) = CodegenQbe::qbeClass(defStore, typeStore, sourceResolved)) {
      if (let Option::SOME(targetCls) = CodegenQbe::qbeClass(defStore, typeStore, targetResolved)) {
        let mut line: String = String::create("");

        if (sourceCls.equals("l")) {
          line = `    ${dest.toStr()} =${targetCls.toStr()} copy ${value.toStr()}\n`;

          emitter.out.pushStr(line.toStr());
          CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, targetResolved, &dest);
          return;
        }

        if (targetCls.equals("l")) {
          // A constant already holds its full declared value, so widening it
          // must not re-read it through the 32-bit source class: a hex
          // literal over 32 bits would otherwise be truncated by `extuw`.
          if (let Lir::Operand::Const(_) = node.source) {
            let up: String = `    ${dest.toStr()} =l copy ${value.toStr()}\n`;

            emitter.out.pushStr(up.toStr());
            return;
          }

          let widened: String = CodegenQbe::qbeWidenToLong(emitter, defStore, typeStore, sourceResolved, &value);
          let up: String = `    ${dest.toStr()} =l copy ${widened.toStr()}\n`;

          emitter.out.pushStr(up.toStr());
          return;
        }

        line = `    ${dest.toStr()} =w copy ${value.toStr()}\n`;

        emitter.out.pushStr(line.toStr());
        CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, targetResolved, &dest);
        return;
      }
    }

    let line: String = `    ${dest.toStr()} =l copy ${value.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitGetElementPtr(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrGetElementPtr,
  ): void {
    let Option::SOME(baseType) = CodegenQbe::operandType(defStore, function_, &node.base) else {
      CodegenQbe::failNamed(emitter, "GetElementPtr");
      return;
    };

    let resolvedBase: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, baseType);
    let Option::SOME(baseNode) = typeStore.get(resolvedBase) else {
      CodegenQbe::failNamed(emitter, "GetElementPtr");
      return;
    };

    let Option::SOME(baseAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.base) else {
      return;
    };

    let mut dataAddress: String = baseAddress.clone();

    match (baseNode) {
      Analyzer::Type::Slice(_) -> {
        let fresh: String = CodegenQbe::freshTemp(emitter);
        let load: String = `    ${fresh.toStr()} =l loadl ${baseAddress.toStr()}\n`;

        emitter.out.pushStr(load.toStr());
        dataAddress = fresh;
      },
      _ -> {},
    };

    let Option::SOME(indexType) = CodegenQbe::operandType(defStore, function_, &node.index) else {
      CodegenQbe::failNamed(emitter, "GetElementPtr");
      return;
    };

    let Option::SOME(index) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.index) else {
      return;
    };

    let widened: String = CodegenQbe::qbeWidenToLong(emitter, defStore, typeStore, indexType, &index);
    let elementSize: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, node.elementType);

    if (emitter.error.isSome()) {
      return;
    }

    let dest: String = `%t${node.dest.raw()}`;
    let mut line: String = String::create("");

    if (elementSize == 1) {
      line = `    ${dest.toStr()} =l add ${dataAddress.toStr()}, ${widened.toStr()}\n`;
    } else {
      let scaled: String = CodegenQbe::freshTemp(emitter);
      let mul: String = `    ${scaled.toStr()} =l mul ${widened.toStr()}, ${elementSize}\n`;

      emitter.out.pushStr(mul.toStr());
      line = `    ${dest.toStr()} =l add ${dataAddress.toStr()}, ${scaled.toStr()}\n`;
    }

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitMakeSlice(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    context: &mut CodegenQbe::QbeFuncCtx,
    node: &Lir::InstrMakeSlice,
  ): void {
    let Option::SOME(slot) = context.slotFor(node.dest.raw()) else {
      CodegenQbe::failNamed(emitter, "MakeSlice");
      return;
    };

    let Option::SOME(data) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.data) else {
      return;
    };

    let Option::SOME(lenType) = CodegenQbe::operandType(defStore, function_, &node.len) else {
      CodegenQbe::failNamed(emitter, "MakeSlice");
      return;
    };

    let Option::SOME(len) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.len) else {
      return;
    };

    let lenLong: String = CodegenQbe::qbeWidenToLong(emitter, defStore, typeStore, lenType, &len);
    let dataLine: String = `    storel ${data.toStr()}, ${slot.toStr()}\n`;

    emitter.out.pushStr(dataLine.toStr());

    let tail: String = CodegenQbe::qbeAddressOffset(emitter, &slot, 8);
    let lenLine: String = `    storel ${lenLong.toStr()}, ${tail.toStr()}\n`;

    emitter.out.pushStr(lenLine.toStr());

    let line: String = `    %t${node.dest.raw()} =l copy ${slot.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitInitZero(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrInitZero,
  ): void {
    let Option::SOME(pointer) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.destPtr) else {
      return;
    };

    let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, node.ty);

    if (emitter.error.isSome()) {
      return;
    }

    let line: String = `    call $memset(l ${pointer.toStr()}, w 0, l ${size})\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitInitSplat(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrInitSplat,
  ): void {
    let Option::SOME(pointer) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.destPtr) else {
      return;
    };

    let elementSize: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, node.elementType);

    if (emitter.error.isSome()) {
      return;
    }

    if (CodegenQbe::isAggregateType(defStore, typeStore, node.elementType)) {
      CodegenQbe::failNamed(emitter, "InitSplat");
      return;
    }

    let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.value) else {
      return;
    };

    if (elementSize == 1) {
      let total: u64 = node.count;
      let line: String = `    call $memset(l ${pointer.toStr()}, w ${value.toStr()}, l ${total})\n`;

      emitter.out.pushStr(line.toStr());
      return;
    }

    let mut index: u64 = 0;

    while (index < node.count) {
      let target: String = CodegenQbe::qbeAddressOffset(emitter, &pointer, index * elementSize);

      CodegenQbe::qbeStoreScalarAt(emitter, defStore, typeStore, node.elementType, &value, &target);
      index += 1;
    }
  }

  /// `@maxOf(T)` / `@minOf(T)`: the integer bounds, spelled as immediates in
  /// the destination's class.
  function qbeEmitMaxMin(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    node: &Lir::InstrTypeQuery,
    isMax: boolean,
  ): void {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, node.ty);
    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      CodegenQbe::failNamed(emitter, "MaxOf");
      return;
    };

    let mut text: String = String::create("");

    match (typeNode) {
      Analyzer::Type::I8 -> {
        if (isMax) {
          text = String::create("127");
        } else {
          text = String::create("-128");
        }
      },
      Analyzer::Type::U8 -> {
        text = String::create(isMax ? "255" : "0");
      },
      Analyzer::Type::I16 -> {
        if (isMax) {
          text = String::create("32767");
        } else {
          text = String::create("-32768");
        }
      },
      Analyzer::Type::U16 -> {
        text = String::create(isMax ? "65535" : "0");
      },
      Analyzer::Type::I32 -> {
        if (isMax) {
          text = String::create("2147483647");
        } else {
          text = String::create("-2147483648");
        }
      },
      Analyzer::Type::U32 -> {
        text = String::create(isMax ? "4294967295" : "0");
      },
      Analyzer::Type::I64 -> {
        if (isMax) {
          text = String::create("9223372036854775807");
        } else {
          text = String::create("-9223372036854775808");
        }
      },
      Analyzer::Type::U64 -> {
        text = String::create(isMax ? "18446744073709551615" : "0");
      },
      _ -> {
        CodegenQbe::failNamed(emitter, "MaxOf");
        return;
      },
    };

    if (emitter.error.isSome()) {
      return;
    }

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, resolved) else {
      CodegenQbe::failNamed(emitter, "MaxOf");
      return;
    };

    let dest: String = `%t${node.dest.raw()}`;
    let line: String = `    ${dest.toStr()} =${cls.toStr()} copy ${text.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
    CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, resolved, &dest);
  }

  /// A panic prints its message over `dprintf(2, ...)` and exits with the
  /// runtime's panic code; no runtime symbols are needed.
  function qbeEmitPanic(emitter: &mut CodegenQbe::Emitter, message: &String): void {
    let format: String = String::create("panic: %s\n");

    if (!emitter.hasPanicFormat) {
      emitter.hasPanicFormat = true;
      CodegenQbe::internString(emitter, &format);
    }

    let formatSymbol: String = CodegenQbe::internString(emitter, &format);
    let messageSymbol: String = CodegenQbe::internString(emitter, message);

    let print: String = `    call $dprintf(w 2, l ${formatSymbol.toStr()}, ..., l ${messageSymbol.toStr()})\n`;
    let exit: String = `    call $exit(w 101)\n`;

    emitter.out.pushStr(print.toStr());

    emitter.out.pushStr(exit.toStr());
  }

  /// The internal symbol of the helper that marks a value moved-from, so a
  /// later drop of it becomes a no-op. Named after the alias-resolved type, the
  /// id its helper is defined under.
  function qbeMarkMovedName(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): String {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    return `ignis_mark_moved_t${resolved.raw()}`;
  }

  /// The internal symbol of the drop glue helper of `ty`. Named after the
  /// alias-resolved type, the id its helper is defined under.
  function qbeDropGlueName(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): String {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    return CodegenC::dropGlueName(resolved);
  }

  /// The offset of the drop-state byte of the nominal behind `nominal`, if it
  /// carries `@implements(Drop)` and so owns one.
  function qbeDropStateOffset(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    nominal: Analyzer::DefinitionId,
  ): Option<u64> {
    if (let Option::SOME(Analyzer::Definition::Record(_)) = defStore.get(nominal)) {
      return match (Abi::recordLayout(defStore, typeStore, nominal)) {
        Result::OK(layout) -> layout.dropStateOffset,
        Result::ERROR(_) -> Option::NONE,
      };
    }

    if (let Option::SOME(Analyzer::Definition::Enum(_)) = defStore.get(nominal)) {
      return match (Abi::enumLayout(defStore, typeStore, nominal)) {
        Result::OK(layout) -> layout.dropStateOffset,
        Result::ERROR(_) -> Option::NONE,
      };
    }

    return Option::NONE;
  }

  /// The byte offset `Abi` gives field `fieldIndex`, or NONE after recording
  /// the failure.
  function qbeFieldOffset(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    recordDef: Analyzer::DefinitionId,
    fieldIndex: u64,
  ): Option<u64> {
    return match (Abi::recordFieldOffset(defStore, typeStore, recordDef, fieldIndex)) {
      Result::OK(offset) -> Option::SOME(offset),
      Result::ERROR(_) -> {
        CodegenQbe::failNamed(emitter, "Drop");
        Option::NONE
      },
    };
  }

  /// The `%d<counter>` temporaries and labels inside one generated helper
  /// share these counters, so no name repeats.
  function qbeNextIndex(counter: &mut u64): u64 {
    let value: u64 = *counter;
    *counter = *counter + 1;
    return value;
  }

  /// `%d<N> =l add|copy <origin>, <offset>`, the address of a member.
  function qbeBodyOffset(
    body: &mut String,
    origin: &String,
    offset: u64,
    tempCounter: &mut u64,
  ): String {
    let temp: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;

    if (offset == 0) {
      body.pushStr(`    ${temp.toStr()} =l copy ${origin.toStr()}\n`.toStr());
    } else {
      body.pushStr(`    ${temp.toStr()} =l add ${origin.toStr()}, ${offset}\n`.toStr());
    }

    return temp;
  }

  /// The body statements that drop the value whose storage address is
  /// `address`, following the C emitter's `emitFieldDrops`: a nominal with a
  /// user `drop` method runs it once, guarded by its drop-state byte when it
  /// implements `Drop`; a record without one drops its droppable fields; an
  /// enum without one drops the live variant's payloads.
  function qbeDropBody(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    ty: Analyzer::TypeId,
    address: &String,
    body: &mut String,
    tempCounter: &mut u64,
    labelCounter: &mut u64,
  ): void {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);
    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return;
    };

    // A closure owns its environment, and its drop function knows how to
    // release it; the field glue reads the same two pointers. Mirrors the C
    // emitter's `emitFieldDrops` closure arm.
    if (let Analyzer::Type::Function(_) = typeNode) {
      let dropField: String = CodegenQbe::qbeBodyOffset(body, address, 8, tempCounter);
      let dropPointer: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;

      body.pushStr(`    ${dropPointer.toStr()} =l loadl ${dropField.toStr()}\n`.toStr());

      let envField: String = CodegenQbe::qbeBodyOffset(body, address, 16, tempCounter);
      let environment: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;

      body.pushStr(`    ${environment.toStr()} =l loadl ${envField.toStr()}\n`.toStr());

      let condition: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;
      let salt: u64 = CodegenQbe::qbeNextIndex(labelCounter);
      let liveLabel: String = `@dcl${salt}`;
      let endLabel: String = `@dce${salt}`;

      body.pushStr(`    ${condition.toStr()} =w cnel ${dropPointer.toStr()}, 0\n`.toStr());
      body.pushStr(`    jnz ${condition.toStr()}, ${liveLabel.toStr()}, ${endLabel.toStr()}\n`.toStr());
      body.pushStr(`${liveLabel.toStr()}\n`.toStr());
      body.pushStr(`    call ${dropPointer.toStr()}(l ${environment.toStr()})\n`.toStr());
      body.pushStr(`    jmp ${endLabel.toStr()}\n`.toStr());
      body.pushStr(`${endLabel.toStr()}\n`.toStr());
      return;
    }

    let mut nominalOpt: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut isEnum: boolean = false;

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        nominalOpt = Option::SOME(defId);
      },
      Analyzer::Type::Enum(defId) -> {
        nominalOpt = Option::SOME(defId);
        isEnum = true;
      },
      _ -> {},
    };

    let Option::SOME(nominal) = nominalOpt else {
      return;
    };

    let guarded: boolean = CodegenC::hasDropTrait(defStore, nominal);
    let methodOpt: Option<Analyzer::DefinitionId> = CodegenC::findDropMethod(defStore, symbols, nominal);

    if (let Option::SOME(methodId) = methodOpt) {
      let name: String = CodegenQbe::qbeMangledName(defStore, symbols, methodId);

      if (!guarded) {
        body.pushStr(`    call $${name.toStr()}(l ${address.toStr()})\n`.toStr());
        return;
      }

      let Option::SOME(offset) = CodegenQbe::qbeDropStateOffset(defStore, typeStore, nominal) else {
        CodegenQbe::failNamed(emitter, "Drop");
        return;
      };

      let statePtr: String = CodegenQbe::qbeBodyOffset(body, address, offset, tempCounter);
      let state: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;
      let cond: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;
      let salt: u64 = CodegenQbe::qbeNextIndex(labelCounter);
      let liveLabel: String = `@dgl${salt}`;
      let endLabel: String = `@dge${salt}`;

      body.pushStr(`    ${state.toStr()} =w loadub ${statePtr.toStr()}\n`.toStr());
      body.pushStr(`    ${cond.toStr()} =w ceqw ${state.toStr()}, 0\n`.toStr());
      body.pushStr(`    jnz ${cond.toStr()}, ${liveLabel.toStr()}, ${endLabel.toStr()}\n`.toStr());
      body.pushStr(`${liveLabel.toStr()}\n`.toStr());
      body.pushStr(`    call $${name.toStr()}(l ${address.toStr()})\n`.toStr());
      body.pushStr(`    storeb 1, ${statePtr.toStr()}\n`.toStr());
      body.pushStr(`    jmp ${endLabel.toStr()}\n`.toStr());
      body.pushStr(`${endLabel.toStr()}\n`.toStr());
      return;
    }

    if (isEnum) {
      CodegenQbe::qbeDropEnumPayloads(emitter, defStore, typeStore, symbols, nominal, address, body, tempCounter, labelCounter);
      return;
    }

    CodegenQbe::qbeDropRecordFields(emitter, defStore, typeStore, symbols, nominal, address, body, tempCounter, labelCounter);
  }

  function qbeDropRecordFields(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    nominal: Analyzer::DefinitionId,
    address: &String,
    body: &mut String,
    tempCounter: &mut u64,
    labelCounter: &mut u64,
  ): void {
    let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(nominal) else {
      return;
    };

    let mut index: u64 = 0;

    while (index < recordDef.fields.length()) {
      let Option::SOME(fieldId) = recordDef.fields.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldId) else {
        index += 1;
        continue;
      };

      let fieldType: Analyzer::TypeId = fieldDef.fieldType;

      // A C function pointer field owns nothing to drop.
      if (Hir::recordFieldStorageType(defStore, typeStore, nominal, fieldType).raw() != fieldType.raw()) {
        index += 1;
        continue;
      }

      if (Borrowck::needsDropType(defStore, typeStore, fieldType) || Hir::typeIsFunction(typeStore, fieldType)) {
        let Option::SOME(offset) = CodegenQbe::qbeFieldOffset(emitter, defStore, typeStore, nominal, fieldDef.index as u64) else {
          return;
        };

        let fieldAddress: String = CodegenQbe::qbeBodyOffset(body, address, offset, tempCounter);

        CodegenQbe::qbeDropBody(emitter, defStore, typeStore, symbols, fieldType, &fieldAddress, body, tempCounter, labelCounter);

        if (emitter.error.isSome()) {
          return;
        }
      }

      index += 1;
    }
  }

  /// The `switch` on the tag the C emitter's `emitEnumVariantDrops` writes,
  /// as QBE blocks. Variants with no droppable payload get no arm.
  function qbeDropEnumPayloads(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    nominal: Analyzer::DefinitionId,
    address: &String,
    body: &mut String,
    tempCounter: &mut u64,
    labelCounter: &mut u64,
  ): void {
    let Option::SOME(Analyzer::Definition::Enum(enumDef)) = defStore.get(nominal) else {
      return;
    };

    let mut hasDroppable: boolean = false;
    let mut scan: u64 = 0;

    while (scan < enumDef.variants.length()) {
      let Option::SOME(variantId) = enumDef.variants.get(scan) else {
        scan += 1;
        continue;
      };

      if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
        let mut payloadIndex: u64 = 0;

        while (payloadIndex < variantDef.payload.length()) {
          if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
            if (Borrowck::needsDropType(defStore, typeStore, *payloadType) || Hir::typeIsFunction(typeStore, *payloadType)) {
              hasDroppable = true;
            }
          }

          payloadIndex += 1;
        }
      }

      scan += 1;
    }

    if (!hasDroppable) {
      return;
    }

    let salt: u64 = CodegenQbe::qbeNextIndex(labelCounter);
    let tag: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;
    let noMatchLabel: String = `@dve${salt}`;
    let endLabel: String = `@dvend${salt}`;
    let mut checks: String = String::create("");
    let mut blocks: String = String::create("");

    checks.pushStr(`    ${tag.toStr()} =w loaduw ${address.toStr()}\n`.toStr());

    let mut ordinal: u64 = 0;
    let mut variantIndex: u64 = 0;

    while (variantIndex < enumDef.variants.length()) {
      let Option::SOME(variantId) = enumDef.variants.get(variantIndex) else {
        variantIndex += 1;
        continue;
      };

      if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
        let mut any: boolean = false;
        let mut payloadIndex: u64 = 0;

        while (payloadIndex < variantDef.payload.length()) {
          if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
            if (Borrowck::needsDropType(defStore, typeStore, *payloadType) || Hir::typeIsFunction(typeStore, *payloadType)) {
              any = true;
            }
          }

          payloadIndex += 1;
        }

        if (any) {
          let cond: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;
          let variantLabel: String = `@dvv${salt}_${ordinal}`;
          let nextLabel: String = `@dvn${salt}_${ordinal}`;

          checks.pushStr(`    ${cond.toStr()} =w ceqw ${tag.toStr()}, ${variantDef.tagValue}\n`.toStr());
          checks.pushStr(`    jnz ${cond.toStr()}, ${variantLabel.toStr()}, ${nextLabel.toStr()}\n`.toStr());
          checks.pushStr(`${nextLabel.toStr()}\n`.toStr());
          blocks.pushStr(`${variantLabel.toStr()}\n`.toStr());

          let mut field: u64 = 0;
          let mut fieldNumber: u64 = 0;

          while (field < variantDef.payload.length()) {
            if (let Option::SOME(payloadType) = variantDef.payload.get(field)) {
              if (!Abi::isVoid(defStore, typeStore, *payloadType)) {
                if (Borrowck::needsDropType(defStore, typeStore, *payloadType) || Hir::typeIsFunction(typeStore, *payloadType)) {
                  let Option::SOME(offset) = CodegenQbe::qbeEnumFieldOffset(emitter, defStore, typeStore, nominal, variantDef.tagValue, fieldNumber) else {
                    return;
                  };

                  let fieldAddress: String = CodegenQbe::qbeBodyOffset(&mut blocks, address, offset, tempCounter);

                  CodegenQbe::qbeDropBody(emitter, defStore, typeStore, symbols, *payloadType, &fieldAddress, &mut blocks, tempCounter, labelCounter);

                  if (emitter.error.isSome()) {
                    return;
                  }
                }

                fieldNumber += 1;
              }
            }

            field += 1;
          }

          blocks.pushStr(`    jmp ${endLabel.toStr()}\n`.toStr());
          ordinal += 1;
        }
      }

      variantIndex += 1;
    }

    body.pushStr(checks.toStr());
    body.pushStr(`${noMatchLabel.toStr()}\n`.toStr());
    body.pushStr(`    jmp ${endLabel.toStr()}\n`.toStr());
    body.pushStr(blocks.toStr());
    body.pushStr(`${endLabel.toStr()}\n`.toStr());
  }

  /// The offset `Abi` gives payload field `fieldIndex` of one variant.
  function qbeEnumFieldOffset(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    enumDef: Analyzer::DefinitionId,
    variantTag: u32,
    fieldIndex: u64,
  ): Option<u64> {
    return match (Abi::enumPayloadFieldOffset(defStore, typeStore, enumDef, variantTag, fieldIndex)) {
      Result::OK(offset) -> Option::SOME(offset),
      Result::ERROR(_) -> {
        CodegenQbe::failNamed(emitter, "Drop");
        Option::NONE
      },
    };
  }

  /// The statements that mark the value at `address` moved-from, mirroring the
  /// C emitter's `emitUninitializedDropState`: a nominal with the Drop trait
  /// owns a flag of its own and stops the walk, a record without one recurses
  /// into its droppable fields, and an enum without one dispatches on its tag.
  function qbeMarkBody(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
    address: &String,
    body: &mut String,
    tempCounter: &mut u64,
    labelCounter: &mut u64,
  ): void {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);
    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return;
    };

    let mut nominalOpt: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut isRecord: boolean = false;
    let mut isEnum: boolean = false;

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        nominalOpt = Option::SOME(defId);
        isRecord = true;
      },
      Analyzer::Type::Enum(defId) -> {
        nominalOpt = Option::SOME(defId);
        isEnum = true;
      },
      _ -> {},
    };

    let Option::SOME(nominal) = nominalOpt else {
      return;
    };

    if (CodegenC::hasDropTrait(defStore, nominal)) {
      let Option::SOME(offset) = CodegenQbe::qbeDropStateOffset(defStore, typeStore, nominal) else {
        CodegenQbe::failNamed(emitter, "Drop");
        return;
      };

      let statePtr: String = CodegenQbe::qbeBodyOffset(body, address, offset, tempCounter);

      body.pushStr(`    storeb 1, ${statePtr.toStr()}\n`.toStr());
      return;
    }

    if (isEnum) {
      CodegenQbe::qbeMarkEnumPayloads(emitter, defStore, typeStore, nominal, address, body, tempCounter, labelCounter);
      return;
    }

    if (isRecord) {
      CodegenQbe::qbeMarkRecordFields(emitter, defStore, typeStore, nominal, address, body, tempCounter, labelCounter);
    }
  }

  function qbeMarkRecordFields(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    nominal: Analyzer::DefinitionId,
    address: &String,
    body: &mut String,
    tempCounter: &mut u64,
    labelCounter: &mut u64,
  ): void {
    let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(nominal) else {
      return;
    };

    let mut index: u64 = 0;

    while (index < recordDef.fields.length()) {
      let Option::SOME(fieldId) = recordDef.fields.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldId) else {
        index += 1;
        continue;
      };

      let fieldType: Analyzer::TypeId = fieldDef.fieldType;

      if (Borrowck::needsDropType(defStore, typeStore, fieldType)) {
        let Option::SOME(offset) = CodegenQbe::qbeFieldOffset(emitter, defStore, typeStore, nominal, fieldDef.index as u64) else {
          return;
        };

        let fieldAddress: String = CodegenQbe::qbeBodyOffset(body, address, offset, tempCounter);

        CodegenQbe::qbeMarkBody(emitter, defStore, typeStore, fieldType, &fieldAddress, body, tempCounter, labelCounter);

        if (emitter.error.isSome()) {
          return;
        }
      }

      index += 1;
    }
  }

  function qbeMarkEnumPayloads(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    nominal: Analyzer::DefinitionId,
    address: &String,
    body: &mut String,
    tempCounter: &mut u64,
    labelCounter: &mut u64,
  ): void {
    let Option::SOME(Analyzer::Definition::Enum(enumDef)) = defStore.get(nominal) else {
      return;
    };

    let mut hasDroppable: boolean = false;
    let mut scan: u64 = 0;

    while (scan < enumDef.variants.length()) {
      let Option::SOME(variantId) = enumDef.variants.get(scan) else {
        scan += 1;
        continue;
      };

      if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
        let mut payloadIndex: u64 = 0;

        while (payloadIndex < variantDef.payload.length()) {
          if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
            if (Borrowck::needsDropType(defStore, typeStore, *payloadType)) {
              hasDroppable = true;
            }
          }

          payloadIndex += 1;
        }
      }

      scan += 1;
    }

    if (!hasDroppable) {
      return;
    }

    let salt: u64 = CodegenQbe::qbeNextIndex(labelCounter);
    let tag: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;
    let noMatchLabel: String = `@mve${salt}`;
    let endLabel: String = `@mvend${salt}`;
    let mut checks: String = String::create("");
    let mut blocks: String = String::create("");

    checks.pushStr(`    ${tag.toStr()} =w loaduw ${address.toStr()}\n`.toStr());

    let mut ordinal: u64 = 0;
    let mut variantIndex: u64 = 0;

    while (variantIndex < enumDef.variants.length()) {
      let Option::SOME(variantId) = enumDef.variants.get(variantIndex) else {
        variantIndex += 1;
        continue;
      };

      if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
        let mut any: boolean = false;
        let mut payloadIndex: u64 = 0;

        while (payloadIndex < variantDef.payload.length()) {
          if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
            if (Borrowck::needsDropType(defStore, typeStore, *payloadType)) {
              any = true;
            }
          }

          payloadIndex += 1;
        }

        if (any) {
          let cond: String = `%d${CodegenQbe::qbeNextIndex(tempCounter)}`;
          let variantLabel: String = `@mvv${salt}_${ordinal}`;
          let nextLabel: String = `@mvn${salt}_${ordinal}`;

          checks.pushStr(`    ${cond.toStr()} =w ceqw ${tag.toStr()}, ${variantDef.tagValue}\n`.toStr());
          checks.pushStr(`    jnz ${cond.toStr()}, ${variantLabel.toStr()}, ${nextLabel.toStr()}\n`.toStr());
          checks.pushStr(`${nextLabel.toStr()}\n`.toStr());
          blocks.pushStr(`${variantLabel.toStr()}\n`.toStr());

          let mut field: u64 = 0;
          let mut fieldNumber: u64 = 0;

          while (field < variantDef.payload.length()) {
            if (let Option::SOME(payloadType) = variantDef.payload.get(field)) {
              if (!Abi::isVoid(defStore, typeStore, *payloadType)) {
                if (Borrowck::needsDropType(defStore, typeStore, *payloadType)) {
                  let Option::SOME(offset) = CodegenQbe::qbeEnumFieldOffset(emitter, defStore, typeStore, nominal, variantDef.tagValue, fieldNumber) else {
                    return;
                  };

                  let fieldAddress: String = CodegenQbe::qbeBodyOffset(&mut blocks, address, offset, tempCounter);

                  CodegenQbe::qbeMarkBody(emitter, defStore, typeStore, *payloadType, &fieldAddress, &mut blocks, tempCounter, labelCounter);

                  if (emitter.error.isSome()) {
                    return;
                  }
                }

                fieldNumber += 1;
              }
            }

            field += 1;
          }

          blocks.pushStr(`    jmp ${endLabel.toStr()}\n`.toStr());
          ordinal += 1;
        }
      }

      variantIndex += 1;
    }

    body.pushStr(checks.toStr());
    body.pushStr(`${noMatchLabel.toStr()}\n`.toStr());
    body.pushStr(`    jmp ${endLabel.toStr()}\n`.toStr());
    body.pushStr(blocks.toStr());
    body.pushStr(`${endLabel.toStr()}\n`.toStr());
  }

  /// The internal symbol of the guard that panics when a value of the nominal
  /// behind `owner` is used after it was dropped.
  function qbeGuardName(owner: Analyzer::DefinitionId): String {
    return `ignis_drop_guard_t${owner.raw()}`;
  }

  /// Panic before reading a method receiver whose owner implements `Drop` and
  /// whose drop-state byte is set. Mirrors the C emitter's
  /// `emitMethodReceiverDropGuard`.
  function qbeEmitReceiverGuard(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrCall,
  ): void {
    let mut ownerOpt: Option<Analyzer::DefinitionId> = Option::NONE;

    if (let Option::SOME(Analyzer::Definition::Method(methodDef)) = defStore.get(node.callee)) {
      if (!methodDef.isStatic) {
        ownerOpt = Option::SOME(methodDef.owner);
      }
    }

    let Option::SOME(owner) = ownerOpt else {
      return;
    };

    if (!CodegenC::hasDropTrait(defStore, owner)) {
      return;
    }

    let Option::SOME(receiver) = node.args.get(0) else {
      return;
    };

    let Option::SOME(address) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, receiver) else {
      return;
    };

    let name: String = CodegenQbe::qbeGuardName(owner);

    emitter.out.pushStr(`    call $${name.toStr()}(l ${address.toStr()})\n`.toStr());
  }

  /// One `ignis_drop_guard_t<id>` helper per nominal whose drop-state byte is
  /// read: it prints the same panic the C emitter's guard does and exits 101.
  function qbeEmitDropGuardHelpers(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    guardTypes: &Vector<u32>,
  ): void {
    if (guardTypes.length() == 0) {
      return;
    }

    emitter.out.pushStr("\n# Drop-state guards\n");

    let mut index: u64 = 0;

    while (index < guardTypes.length()) {
      let Option::SOME(raw) = guardTypes.get(index) else {
        index += 1;
        continue;
      };

      let owner: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*raw);
      let Option::SOME(offset) = CodegenQbe::qbeDropStateOffset(defStore, typeStore, owner) else {
        index += 1;
        continue;
      };

      let name: String = CodegenQbe::qbeGuardName(owner);
      let format: String = String::create("panic: %s\n");
      let formatSymbol: String = CodegenQbe::internString(emitter, &format);
      let message: String = String::create("use of dropped value");
      let messageSymbol: String = CodegenQbe::internString(emitter, &message);

      emitter.out.pushStr(`function $${name.toStr()}(l %base) {\n`.toStr());
      emitter.out.pushStr("@start\n");

      let pointer: String = CodegenQbe::freshTemp(emitter);
      emitter.out.pushStr(`    ${pointer.toStr()} =l add %base, ${offset}\n`.toStr());

      let state: String = CodegenQbe::freshTemp(emitter);
      emitter.out.pushStr(`    ${state.toStr()} =w loadub ${pointer.toStr()}\n`.toStr());
      emitter.out.pushStr(`    jnz ${state.toStr()}, @dropped, @live\n`.toStr());
      emitter.out.pushStr("@dropped\n");
      emitter.out.pushStr(`    call $dprintf(w 2, l ${formatSymbol.toStr()}, ..., l ${messageSymbol.toStr()})\n`.toStr());
      emitter.out.pushStr("    call $exit(w 101)\n");
      emitter.out.pushStr("    hlt\n");
      emitter.out.pushStr("@live\n");
      emitter.out.pushStr("    ret\n}\n\n");
      index += 1;
    }
  }

  /// One QBE function per collected glue type, named exactly as the C
  /// backend's `DropGlue` helper so the two agree.
  function qbeEmitDropGlueHelpers(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    glueTypes: &Vector<u32>,
  ): void {
    if (glueTypes.length() == 0) {
      return;
    }

    emitter.out.pushStr("\n# Drop glue\n");

    let mut index: u64 = 0;

    while (index < glueTypes.length()) {
      let Option::SOME(raw) = glueTypes.get(index) else {
        index += 1;
        continue;
      };

      let ty: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
      let name: String = CodegenQbe::qbeDropGlueName(defStore, typeStore, ty);

      emitter.out.pushStr(`function $${name.toStr()}(l %payload) {\n`.toStr());
      emitter.out.pushStr("@start\n");

      let mut body: String = String::create("");
      let mut tempCounter: u64 = 0;
      let mut labelCounter: u64 = 0;
      let payloadName: String = String::create("%payload");

      CodegenQbe::qbeDropBody(emitter, defStore, typeStore, symbols, ty, &payloadName, &mut body, &mut tempCounter, &mut labelCounter);

      if (emitter.error.isSome()) {
        return;
      }

      emitter.out.pushStr(body.toStr());
      emitter.out.pushStr("    ret\n}\n\n");
      index += 1;
    }
  }

  /// One internal mark-moved helper per collected type.
  function qbeEmitMarkHelpers(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    markTypes: &Vector<u32>,
  ): void {
    if (markTypes.length() == 0) {
      return;
    }

    emitter.out.pushStr("\n# Mark-moved helpers\n");

    let mut index: u64 = 0;

    while (index < markTypes.length()) {
      let Option::SOME(raw) = markTypes.get(index) else {
        index += 1;
        continue;
      };

      let ty: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
      let name: String = CodegenQbe::qbeMarkMovedName(defStore, typeStore, ty);

      emitter.out.pushStr(`function $${name.toStr()}(l %payload) {\n`.toStr());
      emitter.out.pushStr("@start\n");

      let mut body: String = String::create("");
      let mut tempCounter: u64 = 0;
      let mut labelCounter: u64 = 0;
      let payloadName: String = String::create("%payload");

      CodegenQbe::qbeMarkBody(emitter, defStore, typeStore, ty, &payloadName, &mut body, &mut tempCounter, &mut labelCounter);

      if (emitter.error.isSome()) {
        return;
      }

      emitter.out.pushStr(body.toStr());
      emitter.out.pushStr("    ret\n}\n\n");
      index += 1;
    }
  }

  /// Collects the glue function of `ty` and every nested type its body
  /// reaches, plus the `drop` methods the glue calls. A nominal with a `drop`
  /// method stops the walk, as in the C emitter: its fields are not dropped by glue.
  function qbeAddGlueType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    glueTypes: &mut Vector<u32>,
    glueMethods: &mut Vector<u32>,
    ty: Analyzer::TypeId,
  ): void {
    if (!CodegenQbe::needsDrop(defStore, typeStore, ty)) {
      return;
    }

    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    if (CodegenC::containsRaw(glueTypes, resolved.raw())) {
      return;
    }

    glueTypes.push(resolved.raw());

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return;
    };

    let mut nominalOpt: Option<Analyzer::DefinitionId> = Option::NONE;

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        nominalOpt = Option::SOME(defId);
      },
      Analyzer::Type::Enum(defId) -> {
        nominalOpt = Option::SOME(defId);
      },
      _ -> {},
    };

    let Option::SOME(nominal) = nominalOpt else {
      return;
    };

    if (let Option::SOME(methodId) = CodegenC::findDropMethod(defStore, symbols, nominal)) {
      if (!CodegenC::containsRaw(glueMethods, methodId.raw())) {
        glueMethods.push(methodId.raw());
      }

      return;
    }

    if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(nominal)) {
      let mut index: u64 = 0;

      while (index < recordDef.fields.length()) {
        let Option::SOME(fieldId) = recordDef.fields.get(index) else {
          index += 1;
          continue;
        };

        if (let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldId)) {
          let fieldType: Analyzer::TypeId = fieldDef.fieldType;

          if (Hir::recordFieldStorageType(defStore, typeStore, nominal, fieldType).raw() == fieldType.raw()) {
            if (Borrowck::needsDropType(defStore, typeStore, fieldType) || Hir::typeIsFunction(typeStore, fieldType)) {
              CodegenQbe::qbeAddGlueType(defStore, typeStore, symbols, glueTypes, glueMethods, fieldType);
            }
          }
        }

        index += 1;
      }

      return;
    }

    if (let Option::SOME(Analyzer::Definition::Enum(enumDef)) = defStore.get(nominal)) {
      let mut variantIndex: u64 = 0;

      while (variantIndex < enumDef.variants.length()) {
        let Option::SOME(variantId) = enumDef.variants.get(variantIndex) else {
          variantIndex += 1;
          continue;
        };

        if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
          let mut payloadIndex: u64 = 0;

          while (payloadIndex < variantDef.payload.length()) {
            if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
              if (Borrowck::needsDropType(defStore, typeStore, *payloadType) || Hir::typeIsFunction(typeStore, *payloadType)) {
                CodegenQbe::qbeAddGlueType(defStore, typeStore, symbols, glueTypes, glueMethods, *payloadType);
              }
            }

            payloadIndex += 1;
          }
        }

        variantIndex += 1;
      }
    }
  }

  /// Collects the mark-moved helper of `ty` and the nested types it reaches.
  function qbeAddMarkType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    markTypes: &mut Vector<u32>,
    ty: Analyzer::TypeId,
  ): void {
    if (!Borrowck::needsDropType(defStore, typeStore, ty)) {
      return;
    }

    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    if (CodegenC::containsRaw(markTypes, resolved.raw())) {
      return;
    }

    markTypes.push(resolved.raw());

    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      return;
    };

    let mut nominalOpt: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut isRecord: boolean = false;
    let mut isEnum: boolean = false;

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        nominalOpt = Option::SOME(defId);
        isRecord = true;
      },
      Analyzer::Type::Enum(defId) -> {
        nominalOpt = Option::SOME(defId);
        isEnum = true;
      },
      _ -> {},
    };

    let Option::SOME(nominal) = nominalOpt else {
      return;
    };

    if (CodegenC::hasDropTrait(defStore, nominal)) {
      return;
    }

    if (isEnum) {
      if (let Option::SOME(Analyzer::Definition::Enum(enumDef)) = defStore.get(nominal)) {
        let mut variantIndex: u64 = 0;

        while (variantIndex < enumDef.variants.length()) {
          let Option::SOME(variantId) = enumDef.variants.get(variantIndex) else {
            variantIndex += 1;
            continue;
          };

          if (let Option::SOME(Analyzer::Definition::Variant(variantDef)) = defStore.get(*variantId)) {
            let mut payloadIndex: u64 = 0;

            while (payloadIndex < variantDef.payload.length()) {
              if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
                CodegenQbe::qbeAddMarkType(defStore, typeStore, markTypes, *payloadType);
              }

              payloadIndex += 1;
            }
          }

          variantIndex += 1;
        }
      }

      return;
    }

    if (isRecord) {
      if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(nominal)) {
        let mut index: u64 = 0;

        while (index < recordDef.fields.length()) {
          let Option::SOME(fieldId) = recordDef.fields.get(index) else {
            index += 1;
            continue;
          };

          if (let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldId)) {
            CodegenQbe::qbeAddMarkType(defStore, typeStore, markTypes, fieldDef.fieldType);
          }

          index += 1;
        }
      }
    }
  }

  /// Scans every LIR instruction for the drop and mark helpers the unit needs,
  /// including the prologue mark of every droppable local.
  function qbeCollectDropHelpers(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    program: &Lir::LirProgram,
    glueTypes: &mut Vector<u32>,
    markTypes: &mut Vector<u32>,
    guardTypes: &mut Vector<u32>,
    glueMethods: &mut Vector<u32>,
  ): void {
    let mut functionIndex: u64 = 0;

    while (functionIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(functionIndex) else {
        functionIndex += 1;
        continue;
      };

      let scheduled: Vector<u32> = CodegenC::dropScheduledLocals(function_);
      let mut localIndex: u64 = 0;

      while (localIndex < function_.locals.length()) {
        let Option::SOME(local) = function_.locals.get(localIndex) else {
          localIndex += 1;
          continue;
        };

        if (!local.borrowedAlias && !CodegenC::isVoidType(typeStore, local.ty) && CodegenC::fixedArrayShape(typeStore, local.ty).isNone()) {
          if (CodegenC::containsLocalRaw(&scheduled, localIndex as u32) || Borrowck::needsDropType(defStore, typeStore, local.ty)) {
            CodegenQbe::qbeAddMarkType(defStore, typeStore, markTypes, local.ty);
          }
        }

        localIndex += 1;
      }

      let mut blockIndex: u64 = 0;

      while (blockIndex < function_.blocks.length()) {
        let Option::SOME(block) = function_.blocks.get(blockIndex) else {
          blockIndex += 1;
          continue;
        };

        let mut instructionIndex: u64 = 0;

        while (instructionIndex < block.instructions.length()) {
          if (let Option::SOME(instruction) = block.instructions.get(instructionIndex)) {
            match (instruction) {
              Lir::Instr::Drop(node) -> {
                if (let Option::SOME(local) = function_.locals.get(node.local.raw() as u64)) {
                  if (!local.borrowedAlias) {
                    CodegenQbe::qbeAddGlueType(defStore, typeStore, symbols, glueTypes, glueMethods, local.ty);
                  }
                }
              },
              Lir::Instr::DropInPlace(node) -> {
                CodegenQbe::qbeAddGlueType(defStore, typeStore, symbols, glueTypes, glueMethods, node.ty);
              },
              Lir::Instr::DropGlue(node) -> {
                CodegenQbe::qbeAddGlueType(defStore, typeStore, symbols, glueTypes, glueMethods, node.ty);
              },
              Lir::Instr::MarkMoved(node) -> {
                if (!Hir::typeIsFunction(typeStore, node.ty)) {
                  CodegenQbe::qbeAddMarkType(defStore, typeStore, markTypes, node.ty);
                }
              },
              Lir::Instr::GetFieldPtr(node) -> {
                if (let Option::SOME(baseType) = CodegenQbe::operandType(defStore, function_, &node.base)) {
                  if (let Option::SOME(owner) = CodegenC::resolveDroppableRecord(defStore, typeStore, baseType)) {
                    if (!CodegenC::containsRaw(guardTypes, owner.raw())) {
                      guardTypes.push(owner.raw());
                    }
                  }
                }
              },
              Lir::Instr::Call(node) -> {
                if (let Option::SOME(Analyzer::Definition::Method(methodDef)) = defStore.get(node.callee)) {
                  if (!methodDef.isStatic && CodegenC::hasDropTrait(defStore, methodDef.owner)) {
                    if (!CodegenC::containsRaw(guardTypes, methodDef.owner.raw())) {
                      guardTypes.push(methodDef.owner.raw());
                    }
                  }
                }
              },
              _ -> {},
            };
          }

          instructionIndex += 1;
        }

        blockIndex += 1;
      }

      functionIndex += 1;
    }
  }

  function qbeEmitDrop(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    local: Lir::LocalId,
  ): void {
    let Option::SOME(local_) = function_.locals.get(local.raw() as u64) else {
      return;
    };

    if (local_.borrowedAlias) {
      return;
    }

    if (!CodegenQbe::needsDrop(defStore, typeStore, local_.ty)) {
      return;
    }

    let name: String = CodegenQbe::qbeDropGlueName(defStore, typeStore, local_.ty);
    let line: String = `    call $${name.toStr()}(l %l${local.raw()})\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitDropInPlace(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrDropInPlace,
  ): void {
    if (!CodegenQbe::needsDrop(defStore, typeStore, node.ty)) {
      return;
    }

    let Option::SOME(address) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.ptr) else {
      return;
    };

    let name: String = CodegenQbe::qbeDropGlueName(defStore, typeStore, node.ty);
    let line: String = `    call $${name.toStr()}(l ${address.toStr()})\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitMarkMoved(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrMarkMoved,
  ): void {
    if (Hir::typeIsFunction(typeStore, node.ty)) {
      // A closure moved out of its place leaves a zeroed struct behind: its
      // `drop_fn` is null, so the owner's drop is a no-op and a later call
      // faults on the null `call` instead of reading a freed environment.
      let Option::SOME(address) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.ptr) else {
        return;
      };
      let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, node.ty);

      emitter.out.pushStr(`    call $memset(l ${address.toStr()}, w 0, l ${size})\n`.toStr());
      return;
    }

    if (!Borrowck::needsDropType(defStore, typeStore, node.ty)) {
      return;
    }

    let Option::SOME(address) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.ptr) else {
      return;
    };

    let name: String = CodegenQbe::qbeMarkMovedName(defStore, typeStore, node.ty);
    let line: String = `    call $${name.toStr()}(l ${address.toStr()})\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitGetFieldPtr(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrGetFieldPtr,
    closures: &CodegenC::ClosureTables,
  ): void {
    let Option::SOME(baseType) = CodegenQbe::operandType(defStore, function_, &node.base) else {
      CodegenQbe::failNamed(emitter, "GetFieldPtr");
      return;
    };

    // A capture read out of a thunk's environment: the base is the `*u8` the
    // thunk receives, and the field offset comes from the environment layout
    // `MakeClosure` wrote.
    if (CodegenC::operandIsEnvironmentPointer(typeStore, function_, &node.base)) {
      let Option::SOME(env) = CodegenQbe::qbeEnvFor(&closures.envs, function_.defId) else {
        CodegenQbe::failNamed(emitter, "GetFieldPtr");
        return;
      };

      let Option::SOME(baseAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.base) else {
        return;
      };

      let offset: u64 = CodegenQbe::qbeEnvFieldOffset(emitter, defStore, typeStore, env, node.fieldIndex as u64);
      let address: String = CodegenQbe::qbeAddressOffset(emitter, &baseAddress, offset);

      emitter.out.pushStr(`    %t${node.dest.raw()} =l copy ${address.toStr()}\n`.toStr());
      return;
    }

    let Option::SOME(recordDef) = CodegenQbe::nominalBehind(defStore, typeStore, baseType) else {
      CodegenQbe::failNamed(emitter, "GetFieldPtr");
      return;
    };

    let Option::SOME(baseAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.base) else {
      return;
    };

    // A read through a base whose nominal was already dropped panics, as the
    // C emitter's field guard does.
    if (let Option::SOME(owner) = CodegenC::resolveDroppableRecord(defStore, typeStore, baseType)) {
      let guard: String = CodegenQbe::qbeGuardName(owner);

      emitter.out.pushStr(`    call $${guard.toStr()}(l ${baseAddress.toStr()})\n`.toStr());
    }

    let offset: u64 = CodegenQbe::fieldOffset(emitter, defStore, typeStore, recordDef, node.fieldIndex);

    if (emitter.error.isSome()) {
      return;
    }

    let address: String = CodegenQbe::qbeAddressOffset(emitter, &baseAddress, offset);
    let line: String = `    %t${node.dest.raw()} =l copy ${address.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  function qbeEmitInitRecord(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrInitRecord,
  ): void {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, node.recordType);
    let Option::SOME(Analyzer::Type::Record(recordDef)) = typeStore.get(resolved) else {
      CodegenQbe::failNamed(emitter, "InitRecord");
      return;
    };

    let Option::SOME(pointer) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.destPtr) else {
      return;
    };

    let mut index: u64 = 0;

    while (index < node.fields.length()) {
      let Option::SOME(field) = node.fields.get(index) else {
        index += 1;
        continue;
      };

      let offset: u64 = CodegenQbe::fieldOffset(emitter, defStore, typeStore, recordDef, field.fieldIndex);

      if (emitter.error.isSome()) {
        return;
      }

      let address: String = CodegenQbe::qbeAddressOffset(emitter, &pointer, offset);

      let Option::SOME(valueType) = CodegenQbe::operandType(defStore, function_, &field.value) else {
        CodegenQbe::failNamed(emitter, "InitRecord");
        return;
      };

      if (CodegenQbe::isAggregateType(defStore, typeStore, valueType)) {
        let Option::SOME(valueAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &field.value) else {
          return;
        };

        let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, valueType);

        CodegenQbe::qbeMemcpy(emitter, &address, &valueAddress, size);
      } else {
        let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &field.value) else {
          return;
        };

        CodegenQbe::qbeStoreScalarAt(emitter, defStore, typeStore, valueType, &value, &address);
      }

      index += 1;
    }

    // A freshly built value is live: the slot may already hold the drop-state
    // byte of a value dropped earlier.
    if (CodegenC::hasDropTrait(defStore, recordDef)) {
      if (let Option::SOME(offset) = CodegenQbe::qbeDropStateOffset(defStore, typeStore, recordDef)) {
        let stateAddress: String = CodegenQbe::qbeAddressOffset(emitter, &pointer, offset);
        emitter.out.pushStr(`    storeb 0, ${stateAddress.toStr()}\n`.toStr());
      }
    }
  }

  function qbeEmitEnumGetTag(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrEnumGetTag,
  ): void {
    let Option::SOME(sourceType) = CodegenQbe::operandType(defStore, function_, &node.source) else {
      CodegenQbe::failNamed(emitter, "EnumGetTag");
      return;
    };

    let enumDefId: Analyzer::DefinitionId = CodegenQbe::enumDefOf(emitter, defStore, typeStore, sourceType);

    if (emitter.error.isSome()) {
      return;
    }

    if (!CodegenQbe::enumIsScalar(defStore, enumDefId)) {
      // A payload enum is an aggregate, so the source value is the address of
      // its storage and the `u32` tag is the first word of it.
      let Option::SOME(address) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.source) else {
        return;
      };

      let line: String = `    %t${node.dest.raw()} =w loaduw ${address.toStr()}\n`;

      emitter.out.pushStr(line.toStr());
      return;
    }

    let Option::SOME(tag) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.source) else {
      return;
    };

    let line: String = `    %t${node.dest.raw()} =w copy ${tag.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  /// The ABI offset of payload field `fieldIndex` of the variant with tag
  /// `variantTag`, or NONE after recording `failNamed(fallback)`.
  function enumPayloadOffset(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    enumDef: Analyzer::DefinitionId,
    variantTag: u32,
    fieldIndex: u64,
    fallback: str,
  ): Option<u64> {
    return match (Abi::enumPayloadFieldOffset(defStore, typeStore, enumDef, variantTag, fieldIndex)) {
      Result::OK(offset) -> Option::SOME(offset),
      Result::ERROR(_) -> {
        CodegenQbe::failNamed(emitter, fallback);
        Option::NONE
      },
    };
  }

  /// One `InitEnumVariant`: clear the whole value so the rest of the union
  /// holds zeros, store the tag, then store every non-void payload field at
  /// its ABI offset. A fieldless enum keeps its bare `w` tag store.
  function qbeEmitInitEnumVariant(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrInitEnumVariant,
  ): void {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, node.enumType);
    let Option::SOME(typeNode) = typeStore.get(resolved) else {
      CodegenQbe::failNamed(emitter, "InitEnumVariant");
      return;
    };

    let mut enumDef: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);
    let mut isEnum: boolean = false;

    if (let Analyzer::Type::Enum(found) = typeNode) {
      enumDef = found;
      isEnum = true;
    }

    if (!isEnum) {
      CodegenQbe::failNamed(emitter, "InitEnumVariant");
      return;
    }

    if (CodegenQbe::enumIsScalar(defStore, enumDef)) {
      if (let Option::SOME(address) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.destPtr)) {
        let line: String = `    storew ${node.variantTag}, ${address.toStr()}\n`;

        emitter.out.pushStr(line.toStr());
      }

      return;
    }

    CodegenQbe::enumPayloadsSupported(emitter, defStore, typeStore, enumDef);

    if (emitter.error.isSome()) {
      return;
    }

    let Option::SOME(pointer) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.destPtr) else {
      return;
    };

    let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, node.enumType);

    if (emitter.error.isSome()) {
      return;
    }

    let clear: String = `    call $memset(l ${pointer.toStr()}, w 0, l ${size})\n`;

    emitter.out.pushStr(clear.toStr());
    emitter.out.pushStr(`    storew ${node.variantTag}, ${pointer.toStr()}\n`.toStr());

    let mut payloadIndex: u64 = 0;
    let mut fieldIndex: u64 = 0;

    while (payloadIndex < node.payload.length()) {
      if (let Option::SOME(payloadOperand) = node.payload.get(payloadIndex)) {
        if (!CodegenC::operandIsVoid(typeStore, function_, payloadOperand)) {
          let Option::SOME(offset) = CodegenQbe::enumPayloadOffset(emitter, defStore, typeStore, enumDef, node.variantTag, fieldIndex, "InitEnumVariant") else {
            return;
          };

          let address: String = CodegenQbe::qbeAddressOffset(emitter, &pointer, offset);
          let Option::SOME(valueType) = CodegenQbe::operandType(defStore, function_, payloadOperand) else {
            CodegenQbe::failNamed(emitter, "InitEnumVariant");
            return;
          };

          if (CodegenQbe::isAggregateType(defStore, typeStore, valueType)) {
            let Option::SOME(valueAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, payloadOperand) else {
              return;
            };

            let fieldSize: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, valueType);

            if (emitter.error.isSome()) {
              return;
            }

            CodegenQbe::qbeMemcpy(emitter, &address, &valueAddress, fieldSize);
          } else {
            let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, payloadOperand) else {
              return;
            };

            CodegenQbe::qbeStoreScalarAt(emitter, defStore, typeStore, valueType, &value, &address);
          }

          fieldIndex += 1;
        }
      }

      payloadIndex += 1;
    }
  }

  /// One `EnumGetPayloadField`: load (or copy, for an aggregate) the payload
  /// field out of the enum's storage at its ABI offset.
  function qbeEmitEnumGetPayloadField(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    context: &mut CodegenQbe::QbeFuncCtx,
    node: &Lir::InstrEnumGetPayloadField,
  ): void {
    let Option::SOME(sourceType) = CodegenQbe::operandType(defStore, function_, &node.source) else {
      CodegenQbe::failNamed(emitter, "EnumGetPayloadField");
      return;
    };

    let Option::SOME(enumDef) = CodegenQbe::nominalBehind(defStore, typeStore, sourceType) else {
      CodegenQbe::failNamed(emitter, "EnumGetPayloadField");
      return;
    };

    let Option::SOME(offset) = CodegenQbe::enumPayloadOffset(emitter, defStore, typeStore, enumDef, node.variantTag, node.fieldIndex as u64, "EnumGetPayloadField") else {
      return;
    };

    let Option::SOME(sourceAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.source) else {
      return;
    };

    let fieldAddress: String = CodegenQbe::qbeAddressOffset(emitter, &sourceAddress, offset);
    let destOperand: Lir::Operand = Lir::Operand::Temp(node.dest);
    let Option::SOME(destType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
      CodegenQbe::failNamed(emitter, "EnumGetPayloadField");
      return;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, destType)) {
      let Option::SOME(slot) = context.slotFor(node.dest.raw()) else {
        CodegenQbe::failNamed(emitter, "EnumGetPayloadField");
        return;
      };

      let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, destType);

      if (emitter.error.isSome()) {
        return;
      }

      CodegenQbe::qbeMemcpy(emitter, &slot, &fieldAddress, size);
      emitter.out.pushStr(`    %t${node.dest.raw()} =l copy ${slot.toStr()}\n`.toStr());
      return;
    }

    let Option::SOME(load) = CodegenQbe::loadOp(defStore, typeStore, destType) else {
      CodegenQbe::failNamed(emitter, "EnumGetPayloadField");
      return;
    };

    let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, destType) else {
      CodegenQbe::failNamed(emitter, "EnumGetPayloadField");
      return;
    };

    let line: String = `    %t${node.dest.raw()} =${cls.toStr()} ${load.toStr()} ${fieldAddress.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  /// One `EnumGetPayloadFieldPtr`: the address of a payload field, given a
  /// pointer to the enum storage.
  function qbeEmitEnumGetPayloadFieldPtr(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrEnumGetPayloadFieldPtr,
  ): void {
    let Option::SOME(sourceType) = CodegenQbe::operandType(defStore, function_, &node.source) else {
      CodegenQbe::failNamed(emitter, "EnumGetPayloadFieldPtr");
      return;
    };

    let Option::SOME(enumDef) = CodegenQbe::nominalBehind(defStore, typeStore, sourceType) else {
      CodegenQbe::failNamed(emitter, "EnumGetPayloadFieldPtr");
      return;
    };

    let Option::SOME(offset) = CodegenQbe::enumPayloadOffset(emitter, defStore, typeStore, enumDef, node.variantTag, node.fieldIndex as u64, "EnumGetPayloadFieldPtr") else {
      return;
    };

    let Option::SOME(base) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.source) else {
      return;
    };

    let address: String = CodegenQbe::qbeAddressOffset(emitter, &base, offset);
    let line: String = `    %t${node.dest.raw()} =l copy ${address.toStr()}\n`;

    emitter.out.pushStr(line.toStr());
  }

  function enumDefOf(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Analyzer::DefinitionId {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);
    let Option::SOME(Analyzer::Type::Enum(enumDef)) = typeStore.get(resolved) else {
      CodegenQbe::failNamed(emitter, "EnumGetTag");
      return Id::fromRaw<Analyzer::DefinitionTag>(0);
    };

    return enumDef;
  }

  /// `@eq<T>` takes both operands as `&T`. A primitive or `str` comparison
  /// loads the values through them first, as the C backend dereferences
  /// them; an `equals` method takes the references as they are.
  function qbeEmitBuiltinEq(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrBuiltinEq,
  ): void {
    let Option::SOME(left) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.left) else {
      return;
    };

    let Option::SOME(right) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.right) else {
      return;
    };

    match (node.kind) {
      Lir::BuiltinEqKind::Primitive -> {
        let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, node.ty) else {
          CodegenQbe::failNamed(emitter, "BuiltinEq");
          return;
        };
        let Option::SOME(load) = CodegenQbe::loadOp(defStore, typeStore, node.ty) else {
          CodegenQbe::failNamed(emitter, "BuiltinEq");
          return;
        };

        // A narrow load sign- or zero-extends into the full class, so the
        // loaded values compare like the C operands do.
        let leftValue: String = CodegenQbe::freshTemp(emitter);
        let rightValue: String = CodegenQbe::freshTemp(emitter);
        let compare: String = `ceq${cls.toStr()}`;

        emitter.out.pushStr(`    ${leftValue.toStr()} =${cls.toStr()} ${load.toStr()} ${left.toStr()}\n`.toStr());
        emitter.out.pushStr(`    ${rightValue.toStr()} =${cls.toStr()} ${load.toStr()} ${right.toStr()}\n`.toStr());
        emitter.out.pushStr(`    %t${node.dest.raw()} =w ${compare.toStr()} ${leftValue.toStr()}, ${rightValue.toStr()}\n`.toStr());
      },
      Lir::BuiltinEqKind::Str -> {
        let leftValue: String = CodegenQbe::freshTemp(emitter);
        let rightValue: String = CodegenQbe::freshTemp(emitter);
        let call: String = CodegenQbe::freshTemp(emitter);

        emitter.out.pushStr(`    ${leftValue.toStr()} =l loadl ${left.toStr()}\n`.toStr());
        emitter.out.pushStr(`    ${rightValue.toStr()} =l loadl ${right.toStr()}\n`.toStr());
        emitter.out.pushStr(`    ${call.toStr()} =w call $strcmp(l ${leftValue.toStr()}, l ${rightValue.toStr()})\n`.toStr());
        emitter.out.pushStr(`    %t${node.dest.raw()} =w ceqw ${call.toStr()}, 0\n`.toStr());
      },
      Lir::BuiltinEqKind::Method(methodId) -> {
        // `equals(&self, other: &T)` returns a `boolean`, which comes back as
        // a byte in a `w`.
        let name: String = CodegenQbe::qbeMangledName(defStore, symbols, methodId);
        let call: String = CodegenQbe::freshTemp(emitter);

        emitter.out.pushStr(`    ${call.toStr()} =w call $${name.toStr()}(l ${left.toStr()}, l ${right.toStr()})\n`.toStr());
        emitter.out.pushStr(`    %t${node.dest.raw()} =w extub ${call.toStr()}\n`.toStr());
      },
    };
  }

  /// A fresh `@v<N>` label, kept apart from the `%v<N>` temporaries by the
  /// sigil.
  function freshLabel(emitter: &mut CodegenQbe::Emitter): String {
    let name: String = `@v${emitter.fresh}`;

    emitter.fresh += 1;

    return name;
  }

  /// One `call %fn(args)` line, with the destination prefix the return type
  /// asks for. The indirect counterpart of `qbeCallLine`.
  function qbeIndirectCallLine(
    emitter: &mut CodegenQbe::Emitter,
    functionPointer: &String,
    args: &Vector<String>,
    destPrefix: &String,
  ): void {
    let mut call: String = String::create("    ");

    call.pushStr(destPrefix.toStr());
    call.pushStr(`call ${functionPointer.toStr()}(`.toStr());

    let mut index: u64 = 0;

    while (index < args.length()) {
      if (let Option::SOME(argument) = args.get(index)) {
        if (index > 0) {
          call.pushStr(", ");
        }

        call.pushStr(argument.toStr());
      }

      index += 1;
    }

    call.pushStr(")\n");

    emitter.out.pushStr(call.toStr());
  }

  /// The destination prefix of a call whose result is `ty`: empty for void,
  /// `<dest> =<cls> ` for a scalar, `<dest> =<typeref> ` for an aggregate.
  function qbeCallDestinationPrefix(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    ty: Analyzer::TypeId,
    destName: &String,
  ): String {
    let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);

    if (CodegenC::isVoidType(typeStore, resolved)) {
      return String::create("");
    }

    if (let Option::SOME(Analyzer::Type::NEVER) = typeStore.get(resolved)) {
      return String::create("");
    }

    if (let Option::SOME(cls) = CodegenQbe::qbeClass(defStore, typeStore, ty)) {
      return `${destName.toStr()} =${cls.toStr()} `;
    }

    let reference: String = CodegenQbe::qbeTypeRef(defStore, typeStore, symbols, ty);

    return `${destName.toStr()} =${reference.toStr()} `;
  }

  /// `MakeClosure`: build the environment (heap for an escaping closure, the
  /// reserved frame slot otherwise), write every capture at its offset, and
  /// assemble the `{ call, drop_fn, env }` value the C backend builds.
  function qbeEmitMakeClosure(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    context: &mut CodegenQbe::QbeFuncCtx,
    node: &Lir::InstrMakeClosure,
    closures: &CodegenC::ClosureTables,
  ): void {
    let Option::SOME(closureSlot) = context.slotFor(node.dest.raw()) else {
      CodegenQbe::failNamed(emitter, "MakeClosure");
      return;
    };

    let Option::SOME(env) = CodegenQbe::qbeEnvFor(&closures.envs, node.thunk) else {
      CodegenQbe::failNamed(emitter, "MakeClosure");
      return;
    };

    let mut environment: String = String::create("0");

    if (node.heapAllocate) {
      let mut envSize: u64 = CodegenQbe::qbeEnvSize(emitter, defStore, typeStore, env);

      if (envSize == 0) {
        envSize = 1;
      }

      environment = CodegenQbe::freshTemp(emitter);

      emitter.out.pushStr(`    ${environment.toStr()} =l call $malloc(l ${envSize})\n`.toStr());
    } else {
      if (let Option::SOME(slot) = context.envSlotFor(node.dest.raw())) {
        environment = slot;
      }
    }

    let mut captureIndex: u64 = 0;

    while (captureIndex < node.captures.length()) {
      if (let Option::SOME(capture) = node.captures.get(captureIndex)) {
        let offset: u64 = CodegenQbe::qbeEnvFieldOffset(emitter, defStore, typeStore, env, captureIndex);
        let address: String = CodegenQbe::qbeAddressOffset(emitter, &environment, offset);

        let Option::SOME(captureType) = CodegenQbe::operandType(defStore, function_, capture) else {
          CodegenQbe::failNamed(emitter, "MakeClosure");
          return;
        };

        if (CodegenQbe::isAggregateType(defStore, typeStore, captureType)) {
          let Option::SOME(valueAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, capture) else {
            return;
          };
          let size: u64 = CodegenQbe::typeSize(emitter, defStore, typeStore, captureType);

          CodegenQbe::qbeMemcpy(emitter, &address, &valueAddress, size);
        } else {
          let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, capture) else {
            return;
          };

          CodegenQbe::qbeStoreScalarAt(emitter, defStore, typeStore, captureType, &value, &address);
        }
      }

      captureIndex += 1;
    }

    let thunkName: String = CodegenQbe::qbeMangledName(defStore, symbols, node.thunk);
    let callField: String = CodegenQbe::qbeAddressOffset(emitter, &closureSlot, 0);

    emitter.out.pushStr(`    storel $${thunkName.toStr()}, ${callField.toStr()}\n`.toStr());

    let dropField: String = CodegenQbe::qbeAddressOffset(emitter, &closureSlot, 8);

    if (let Option::SOME(dropId) = node.dropFn) {
      let dropName: String = CodegenQbe::qbeMangledName(defStore, symbols, dropId);

      emitter.out.pushStr(`    storel $${dropName.toStr()}, ${dropField.toStr()}\n`.toStr());
    } else {
      emitter.out.pushStr(`    storel 0, ${dropField.toStr()}\n`.toStr());
    }

    let envField: String = CodegenQbe::qbeAddressOffset(emitter, &closureSlot, 16);

    emitter.out.pushStr(`    storel ${environment.toStr()}, ${envField.toStr()}\n`.toStr());
    emitter.out.pushStr(`    %t${node.dest.raw()} =l copy ${closureSlot.toStr()}\n`.toStr());
  }

  /// `CallClosure`: an indirect call through the thunk stored at offset 0 of
  /// the closure value, with the environment at offset 16 as the first
  /// argument. The argument and result conventions match a direct call.
  function qbeEmitCallClosure(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrCallClosure,
  ): void {
    let Option::SOME(closureAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.closure) else {
      return;
    };

    let callField: String = CodegenQbe::qbeAddressOffset(emitter, &closureAddress, 0);
    let functionPointer: String = CodegenQbe::freshTemp(emitter);

    emitter.out.pushStr(`    ${functionPointer.toStr()} =l loadl ${callField.toStr()}\n`.toStr());

    let envField: String = CodegenQbe::qbeAddressOffset(emitter, &closureAddress, 16);
    let environment: String = CodegenQbe::freshTemp(emitter);

    emitter.out.pushStr(`    ${environment.toStr()} =l loadl ${envField.toStr()}\n`.toStr());

    let mut args: Vector<String> = Vector::new<String>();

    args.push(`l ${environment.toStr()}`);

    let mut index: u64 = 0;

    while (index < node.args.length()) {
      if (let Option::SOME(argument) = node.args.get(index)) {
        let text: String = CodegenQbe::qbeCallArg(emitter, defStore, typeStore, symbols, function_, argument);

        if (emitter.error.isSome()) {
          return;
        }

        args.push(text);
      }

      index += 1;
    }

    let Option::SOME(dest) = node.dest else {
      let noPrefix: String = String::create("");

      CodegenQbe::qbeIndirectCallLine(emitter, &functionPointer, &args, &noPrefix);
      return;
    };

    let destOperand: Lir::Operand = Lir::Operand::Temp(dest);
    let Option::SOME(returnType) = CodegenQbe::operandType(defStore, function_, &destOperand) else {
      CodegenQbe::failNamed(emitter, "CallClosure");
      return;
    };

    let destName: String = `%t${dest.raw()}`;
    let prefix: String = CodegenQbe::qbeCallDestinationPrefix(emitter, defStore, typeStore, symbols, returnType, &destName);

    CodegenQbe::qbeIndirectCallLine(emitter, &functionPointer, &args, &prefix);

    if (prefix.length() > 0) {
      if (CodegenQbe::qbeClass(defStore, typeStore, returnType).isSome()) {
        CodegenQbe::qbeNormalizeInPlace(emitter, defStore, typeStore, returnType, &destName);
      }
    }
  }

  /// `DropClosure`: call the environment drop function at offset 8 when it is
  /// non-null, with the environment at offset 16.
  function qbeEmitDropClosure(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrDropClosure,
  ): void {
    let Option::SOME(closureAddress) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.closure) else {
      return;
    };

    let dropField: String = CodegenQbe::qbeAddressOffset(emitter, &closureAddress, 8);
    let dropPointer: String = CodegenQbe::freshTemp(emitter);

    emitter.out.pushStr(`    ${dropPointer.toStr()} =l loadl ${dropField.toStr()}\n`.toStr());

    let envField: String = CodegenQbe::qbeAddressOffset(emitter, &closureAddress, 16);
    let environment: String = CodegenQbe::freshTemp(emitter);

    emitter.out.pushStr(`    ${environment.toStr()} =l loadl ${envField.toStr()}\n`.toStr());

    let condition: String = CodegenQbe::freshTemp(emitter);
    let liveLabel: String = CodegenQbe::freshLabel(emitter);
    let endLabel: String = CodegenQbe::freshLabel(emitter);

    emitter.out.pushStr(`    ${condition.toStr()} =w cnel ${dropPointer.toStr()}, 0\n`.toStr());
    emitter.out.pushStr(`    jnz ${condition.toStr()}, ${liveLabel.toStr()}, ${endLabel.toStr()}\n`.toStr());
    emitter.out.pushStr(`${liveLabel.toStr()}\n`.toStr());
    emitter.out.pushStr(`    call ${dropPointer.toStr()}(l ${environment.toStr()})\n`.toStr());
    emitter.out.pushStr(`    jmp ${endLabel.toStr()}\n`.toStr());
    emitter.out.pushStr(`${endLabel.toStr()}\n`.toStr());
  }

  /// `FreeEnv`: release the heap environment of an escaping closure.
  function qbeEmitFreeEnv(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrFreeEnv,
  ): void {
    let Option::SOME(environment) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.env) else {
      return;
    };

    let condition: String = CodegenQbe::freshTemp(emitter);
    let liveLabel: String = CodegenQbe::freshLabel(emitter);
    let endLabel: String = CodegenQbe::freshLabel(emitter);

    emitter.out.pushStr(`    ${condition.toStr()} =w cnel ${environment.toStr()}, 0\n`.toStr());
    emitter.out.pushStr(`    jnz ${condition.toStr()}, ${liveLabel.toStr()}, ${endLabel.toStr()}\n`.toStr());
    emitter.out.pushStr(`${liveLabel.toStr()}\n`.toStr());
    emitter.out.pushStr(`    call $free(l ${environment.toStr()})\n`.toStr());
    emitter.out.pushStr(`${endLabel.toStr()}\n`.toStr());
  }

  /// `MakeRawFunction`: the C function pointer of a named function, or of the
  /// null-environment wrapper around a capture-free thunk.
  function qbeEmitMakeRawFunction(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    node: &Lir::InstrMakeRawFunction,
  ): void {
    let mut target: String = CodegenQbe::qbeMangledName(defStore, symbols, node.callee);

    if (node.viaThunk) {
      target = CodegenQbe::qbeRawThunkWrapperName(defStore, symbols, node.callee);
    }

    emitter.out.pushStr(`    %t${node.dest.raw()} =l copy $${target.toStr()}\n`.toStr());
  }

  /// `RawToClosure`: wrap a C function pointer the way the C backend's
  /// trampoline does, as the closure's environment and its `call` target.
  function qbeEmitRawToClosure(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    context: &mut CodegenQbe::QbeFuncCtx,
    node: &Lir::InstrRawToClosure,
  ): void {
    let Option::SOME(closureSlot) = context.slotFor(node.dest.raw()) else {
      CodegenQbe::failNamed(emitter, "RawToClosure");
      return;
    };

    let Option::SOME(raw) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.raw) else {
      return;
    };

    let trampoline: String = CodegenQbe::qbeRawTrampolineName(node.rawType);
    let callField: String = CodegenQbe::qbeAddressOffset(emitter, &closureSlot, 0);
    let dropField: String = CodegenQbe::qbeAddressOffset(emitter, &closureSlot, 8);
    let envField: String = CodegenQbe::qbeAddressOffset(emitter, &closureSlot, 16);

    emitter.out.pushStr(`    storel $${trampoline.toStr()}, ${callField.toStr()}\n`.toStr());
    emitter.out.pushStr(`    storel 0, ${dropField.toStr()}\n`.toStr());
    emitter.out.pushStr(`    storel ${raw.toStr()}, ${envField.toStr()}\n`.toStr());
    emitter.out.pushStr(`    %t${node.dest.raw()} =l copy ${closureSlot.toStr()}\n`.toStr());
  }

  /// The `_raw` wrappers and raw trampolines the program needs: one per thunk
  /// passed to C, one per C function pointer read back as a closure.
  function qbeEmitRawAdapters(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    program: &Lir::LirProgram,
  ): void {
    let mut thunks: Vector<u32> = Vector::new<u32>();
    let mut rawTypes: Vector<u32> = Vector::new<u32>();
    let mut functionIndex: u64 = 0;

    while (functionIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(functionIndex) else {
        functionIndex += 1;
        continue;
      };

      let mut blockIndex: u64 = 0;

      while (blockIndex < function_.blocks.length()) {
        let Option::SOME(block) = function_.blocks.get(blockIndex) else {
          blockIndex += 1;
          continue;
        };

        let mut instructionIndex: u64 = 0;

        while (instructionIndex < block.instructions.length()) {
          if (let Option::SOME(instruction) = block.instructions.get(instructionIndex)) {
            if (let Lir::Instr::MakeRawFunction(node) = instruction) {
              if (node.viaThunk && !CodegenC::containsRaw(&mut thunks, node.callee.raw())) {
                thunks.push(node.callee.raw());
              }
            }

            if (let Lir::Instr::RawToClosure(node) = instruction) {
              if (!CodegenC::containsRaw(&mut rawTypes, node.rawType.raw())) {
                rawTypes.push(node.rawType.raw());
              }
            }
          }

          instructionIndex += 1;
        }

        blockIndex += 1;
      }

      functionIndex += 1;
    }

    if (thunks.isEmpty() && rawTypes.isEmpty()) {
      return;
    }

    emitter.out.pushStr("\n# C function pointer adapters\n");

    let mut thunkIndex: u64 = 0;

    while (thunkIndex < thunks.length()) {
      let Option::SOME(raw) = thunks.get(thunkIndex) else {
        thunkIndex += 1;
        continue;
      };

      let thunk: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*raw);
      let Option::SOME(thunkFunction) = program.functions.get(thunk) else {
        thunkIndex += 1;
        continue;
      };

      let wrapper: String = CodegenQbe::qbeRawThunkWrapperName(defStore, symbols, thunk);
      let thunkName: String = CodegenQbe::qbeMangledName(defStore, symbols, thunk);
      let returnText: String = CodegenQbe::qbeTypeText(emitter, defStore, typeStore, symbols, thunkFunction.returnType);

      if (emitter.error.isSome()) {
        return;
      }

      let mut header: String = `function ${returnText.toStr()}$${wrapper.toStr()}(`;
      let mut args: Vector<String> = Vector::new<String>();

      args.push(String::create("l 0"));

      let mut paramIndex: u64 = 1;

      while (paramIndex < thunkFunction.params.length()) {
        let mut paramType: Option<Analyzer::TypeId> = Option::NONE;

        if (let Option::SOME(paramDef) = thunkFunction.params.get(paramIndex)) {
          if (let Option::SOME(Analyzer::Definition::Variable(variableDef)) = defStore.get(*paramDef)) {
            paramType = Option::SOME(variableDef.declaredType);
          }
        }

        let Option::SOME(foundType) = paramType else {
          CodegenQbe::failNamed(emitter, "MakeRawFunction");
          return;
        };

        if (paramIndex > 1) {
          header.pushStr(", ");
        }

        let text: String = CodegenQbe::qbeParameterPrefix(emitter, defStore, typeStore, symbols, foundType);
        let tempName: String = `%t${paramIndex}`;

        header.pushStr(`${text.toStr()}${tempName.toStr()}`.toStr());
        args.push(`${text.toStr()}${tempName.toStr()}`);
        paramIndex += 1;
      }

      header.pushStr(") {\n@start\n");
      emitter.out.pushStr(header.toStr());

      let destinationName: String = String::create("%r");
      let prefix: String = CodegenQbe::qbeCallDestinationPrefix(emitter, defStore, typeStore, symbols, thunkFunction.returnType, &destinationName);

      CodegenQbe::qbeCallLine(emitter, defStore, typeStore, symbols, &thunkName, &args, &prefix);

      if (CodegenC::isVoidType(typeStore, thunkFunction.returnType)) {
        emitter.out.pushStr("    ret\n}\n\n");
      } else {
        emitter.out.pushStr("    ret %r\n}\n\n");
      }

      thunkIndex += 1;
    }

    let mut rawIndex: u64 = 0;

    while (rawIndex < rawTypes.length()) {
      let Option::SOME(raw) = rawTypes.get(rawIndex) else {
        rawIndex += 1;
        continue;
      };

      let rawType: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(*raw);
      let Option::SOME(Analyzer::Type::RawFunction(signature)) = typeStore.get(rawType) else {
        rawIndex += 1;
        continue;
      };

      let trampoline: String = CodegenQbe::qbeRawTrampolineName(rawType);
      let returnText: String = CodegenQbe::qbeTypeText(emitter, defStore, typeStore, symbols, signature.returnType);

      if (emitter.error.isSome()) {
        return;
      }

      let mut header: String = `function ${returnText.toStr()}$${trampoline.toStr()}(l %t0`;
      let mut args: Vector<String> = Vector::new<String>();
      let mut paramIndex: u64 = 0;

      while (paramIndex < signature.params.length()) {
        if (let Option::SOME(paramType) = signature.params.get(paramIndex)) {
          let text: String = CodegenQbe::qbeParameterPrefix(emitter, defStore, typeStore, symbols, *paramType);
          let tempName: String = `%t${paramIndex + 1}`;

          header.pushStr(`, ${text.toStr()}${tempName.toStr()}`.toStr());
          args.push(`${text.toStr()}${tempName.toStr()}`);
        }

        paramIndex += 1;
      }

      header.pushStr(") {\n@start\n");
      emitter.out.pushStr(header.toStr());
      emitter.out.pushStr("    %r0 =l copy %t0\n");

      let destinationName: String = String::create("%r");
      let prefix: String = CodegenQbe::qbeCallDestinationPrefix(emitter, defStore, typeStore, symbols, signature.returnType, &destinationName);
      let functionPointerName: String = String::create("%r0");

      CodegenQbe::qbeIndirectCallLine(emitter, &functionPointerName, &args, &prefix);

      if (CodegenC::isVoidType(typeStore, signature.returnType)) {
        emitter.out.pushStr("    ret\n}\n\n");
      } else {
        emitter.out.pushStr("    ret %r\n}\n\n");
      }

      rawIndex += 1;
    }
  }

  /// Emits one block terminator: `jmp`, a `jnz` over an evaluated condition,
  /// a `ret` of the normalized return value, or `hlt` for unreachable.
  function qbeEmitTerminator(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    terminator: &Lir::Terminator,
  ): void {
    match (terminator) {
      Lir::Terminator::Goto(target) -> {
        let line: String = `    jmp @b${target.raw()}\n`;

        emitter.out.pushStr(line.toStr());
      },
      Lir::Terminator::Branch(node) -> {
        let Option::SOME(condition) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, &node.condition) else {
          return;
        };

        let line: String = `    jnz ${condition.toStr()}, @b${node.thenBlock.raw()}, @b${node.elseBlock.raw()}\n`;

        emitter.out.pushStr(line.toStr());
      },
      Lir::Terminator::Return(value) -> {
        let Option::SOME(operand) = value else {
          emitter.out.pushStr("    ret\n");
          return;
        };

        if (CodegenC::isVoidType(typeStore, function_.returnType)) {
          CodegenQbe::qbeEmitValueForEffect(emitter, defStore, typeStore, symbols, function_, &operand);
          emitter.out.pushStr("    ret\n");
          return;
        }

        let Option::SOME(text) = CodegenQbe::qbeReturnValue(emitter, defStore, typeStore, symbols, function_, &operand) else {
          return;
        };

        let line: String = `    ret ${text.toStr()}\n`;

        emitter.out.pushStr(line.toStr());
      },
      Lir::Terminator::Unreachable -> {
        emitter.out.pushStr("    hlt\n");
      },
    };
  }

  /// Evaluates an operand only for its side effects, when a void function
  /// returns a value the LIR still carries.
  function qbeEmitValueForEffect(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): void {
    CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, operand);
  }

  /// The return text for one operand: a normalized scalar temp or immediate,
  /// or the aggregate address `ret` hands to QBE's hidden return slot.
  function qbeReturnValue(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): Option<String> {
    let Option::SOME(value) = CodegenQbe::valueOperand(emitter, defStore, typeStore, symbols, function_, operand) else {
      return Option::NONE;
    };

    if (CodegenQbe::isAggregateType(defStore, typeStore, function_.returnType)) {
      return Option::SOME(value);
    }

    let normalized: String = CodegenQbe::qbeNormalize(emitter, defStore, typeStore, function_.returnType, &value);

    if (emitter.error.isSome()) {
      return Option::NONE;
    }

    return Option::SOME(normalized);
  }

  function instructionDiverges(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    instruction: &Lir::Instr,
  ): boolean {
    if (let Lir::Instr::PanicMessage(_) = instruction) {
      return true;
    }
    if (let Lir::Instr::Call(node) = instruction) {
      let mut returnType: Option<Analyzer::TypeId> = Option::NONE;
      if (let Option::SOME(Analyzer::Definition::Function(definition)) = defStore.get(node.callee)) {
        returnType = Option::SOME(definition.returnType);
      }
      if (let Option::SOME(Analyzer::Definition::Method(definition)) = defStore.get(node.callee)) {
        returnType = Option::SOME(definition.returnType);
      }
      if (let Option::SOME(ty) = returnType) {
        let resolved: Analyzer::TypeId = CodegenQbe::resolveType(defStore, typeStore, ty);
        if (let Option::SOME(Analyzer::Type::NEVER) = typeStore.get(resolved)) {
          return true;
        }
      }
    }
    return false;
  }

  /// One whole function body: locals as stack slots in the entry block,
  /// parameters stored from their arrival temps, and every block with its
  /// instructions and terminator. Extern functions are skipped: the symbol
  /// resolves at link time.
  function qbeEmitFunction(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    function_: &Lir::FunctionLir,
    externalSymbols: &Vector<u32>,
    closures: &CodegenC::ClosureTables,
  ): boolean {
    if (CodegenC::isExternFunction(defStore, function_.defId)) {
      return false;
    }

    let header: String = CodegenQbe::qbeFunctionHeader(emitter, defStore, typeStore, symbols, function_, externalSymbols);

    if (emitter.error.isSome()) {
      // The written name, not the mangled symbol: a definition id in the
      // message makes the pinned lane skip reasons churn whenever an upstream
      // module shifts the ids.
      let name: String = CodegenC::definitionName(defStore, symbols, function_.defId);
      let Option::SOME(message) = &emitter.error else {
        return false;
      };
      let contextual: String = `${message.toStr()} (${name.toStr()})`;
      emitter.error = Option::SOME(contextual);
      return false;
    }

    emitter.out.pushStr(header.toStr());
    emitter.out.pushStr("@start\n");

    let mut context: CodegenQbe::QbeFuncCtx = CodegenQbe::QbeFuncCtx::init();

    CodegenQbe::qbeEmitLocalSlots(emitter, defStore, typeStore, function_);
    CodegenQbe::qbeReserveSlots(emitter, defStore, typeStore, symbols, function_, &mut context, closures);

    if (emitter.error.isSome()) {
      return false;
    }

    let entry: u32 = function_.entryBlock.raw();
    let entryJump: String = `    jmp @b${entry}\n`;
    emitter.out.pushStr(entryJump.toStr());
    let mut index: u64 = 0;

    while (index < function_.blocks.length()) {
      let Option::SOME(block) = function_.blocks.get(index) else {
        index += 1;
        continue;
      };

      let label: String = `@b${index}\n`;

      emitter.out.pushStr(label.toStr());

      let mut instrIndex: u64 = 0;
      let mut diverged: boolean = false;

      while (instrIndex < block.instructions.length()) {
        let Option::SOME(instruction) = block.instructions.get(instrIndex) else {
          instrIndex += 1;
          continue;
        };

        CodegenQbe::qbeEmitInstruction(emitter, defStore, typeStore, symbols, function_, &mut context, instruction, closures);
        if (CodegenQbe::instructionDiverges(defStore, typeStore, instruction)) {
          diverged = true;
          break;
        }
        instrIndex += 1;
      }

      if (diverged) {
        emitter.out.pushStr("    hlt\n");
      } else {
        CodegenQbe::qbeEmitTerminator(emitter, defStore, typeStore, symbols, function_, &block.terminator);
      }
      index += 1;
    }

    emitter.out.pushStr("}\n\n");

    return true;
  }

  /// The fixed process entry: `$main` receives argc/argv, runs the std
  /// runtime init when this unit defines it, calls the user main and returns
  /// its i32 (or 0 for a void main).
  function qbeEmitEntryWrapper(
    emitter: &mut CodegenQbe::Emitter,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    program: &Lir::LirProgram,
  ): boolean {
    let Option::SOME(entryDef) = program.entryPoint else {
      return false;
    };

    let Option::SOME(entry) = program.functions.get(entryDef) else {
      return false;
    };

    if (!CodegenC::isVoidType(typeStore, entry.returnType)) {
      if (CodegenQbe::qbeClass(defStore, typeStore, entry.returnType).isNone()) {
        CodegenQbe::failNamed(emitter, "EntryPoint");
        emitter.errorSpan = Option::SOME(entry.span);
        return false;
      }

      if (!(CodegenQbe::qbeClass(defStore, typeStore, entry.returnType).unwrapOr(String::create("")).equals("w"))) {
        CodegenQbe::failNamed(emitter, "EntryPoint");
        emitter.errorSpan = Option::SOME(entry.span);
        return false;
      }
    }

    let name: String = CodegenQbe::qbeMangledName(defStore, symbols, entryDef);
    let mut callBody: String = `call $${name.toStr()}()`;

    if (entry.params.length() == 2) {
      callBody = `call $${name.toStr()}(w %argc, l %argv)`;
    }

    let mut body: String = String::create("");

    if (CodegenQbe::hasRuntimeInit(defStore)) {
      body = String::create("    call $ignis_runtime_init(w %argc, l %argv)\n");
    }

    let head: String = String::create("export function w $main(w %argc, l %argv) {\n@start\n");
    let mut wrapper: String = `${head.toStr()}${body.toStr()}`;

    if (CodegenC::isVoidType(typeStore, entry.returnType)) {
      wrapper = `${wrapper.toStr()}    ${callBody.toStr()}\n    ret 0\n}\n`;
    } else {
      wrapper = `${wrapper.toStr()}    %r =w ${callBody.toStr()}\n    ret %r\n}\n`;
    }

    emitter.out.pushStr(wrapper.toStr());

    return true;
  }

  /// Whether this unit carries the std runtime init definition, which only a
  /// build with std linked does; standalone units skip the call.
  function hasRuntimeInit(defStore: &mut Analyzer::DefinitionStore): boolean {
    let mut index: u64 = 0;

    while (index < defStore.length()) {
      let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);

      if (let Option::SOME(Analyzer::Definition::Function(functionDef)) = defStore.get(defId)) {
        if (let Option::SOME(name) = &functionDef.externName) {
          if (name.equals("ignis_runtime_init")) {
            return true;
          }
        }
      }

      index += 1;
    }

    return false;
  }

  function addReachable(reachable: &mut Vector<u32>, defId: Analyzer::DefinitionId): void {
    let mut index: u64 = 0;
    while (index < reachable.length()) {
      if (let Option::SOME(raw) = reachable.get(index)) {
        if (*raw == defId.raw()) {
          return;
        }
      }
      index += 1;
    }
    reachable.push(defId.raw());
  }

  function addOperandFunction(reachable: &mut Vector<u32>, operand: &Lir::Operand): void {
    if (let Lir::Operand::FuncRef(defId) = operand) {
      CodegenQbe::addReachable(reachable, defId);
    }
  }

  function addOperandFunctions(reachable: &mut Vector<u32>, operands: &Vector<Lir::Operand>): void {
    let mut index: u64 = 0;
    while (index < operands.length()) {
      if (let Option::SOME(operand) = operands.get(index)) {
        CodegenQbe::addOperandFunction(reachable, operand);
      }
      index += 1;
    }
  }

  function addInstructionFunctions(reachable: &mut Vector<u32>, instruction: &Lir::Instr): void {
    match (instruction) {
      Lir::Instr::Call(node) -> {
        CodegenQbe::addReachable(reachable, node.callee);
        CodegenQbe::addOperandFunctions(reachable, &node.args);
      },
      Lir::Instr::RuntimeCall(node) -> { CodegenQbe::addOperandFunctions(reachable, &node.args); },
      Lir::Instr::Store(node) -> { CodegenQbe::addOperandFunction(reachable, &node.value); },
      Lir::Instr::StorePtr(node) -> { CodegenQbe::addOperandFunction(reachable, &node.value); CodegenQbe::addOperandFunction(reachable, &node.ptr); },
      Lir::Instr::LoadPtr(node) -> { CodegenQbe::addOperandFunction(reachable, &node.ptr); },
      Lir::Instr::BuiltinLoad(node) -> { CodegenQbe::addOperandFunction(reachable, &node.ptr); },
      Lir::Instr::BuiltinStore(node) -> { CodegenQbe::addOperandFunction(reachable, &node.value); CodegenQbe::addOperandFunction(reachable, &node.ptr); },
      Lir::Instr::Atomic(node) -> { CodegenQbe::addOperandFunctions(reachable, &node.operands); },
      Lir::Instr::Copy(node) -> { CodegenQbe::addOperandFunction(reachable, &node.source); },
      Lir::Instr::Cast(node) -> { CodegenQbe::addOperandFunction(reachable, &node.source); },
      Lir::Instr::UnaryOp(node) -> { CodegenQbe::addOperandFunction(reachable, &node.operand); },
      Lir::Instr::BinOp(node) -> { CodegenQbe::addOperandFunction(reachable, &node.left); CodegenQbe::addOperandFunction(reachable, &node.right); },
      Lir::Instr::BuiltinEq(node) -> {
        CodegenQbe::addOperandFunction(reachable, &node.left);
        CodegenQbe::addOperandFunction(reachable, &node.right);

        // An `equals` method reached only through `@eq` is still called.
        if (let Lir::BuiltinEqKind::Method(methodId) = node.kind) {
          CodegenQbe::addReachable(reachable, methodId);
        }
      },
      Lir::Instr::GetElementPtr(node) -> { CodegenQbe::addOperandFunction(reachable, &node.base); CodegenQbe::addOperandFunction(reachable, &node.index); },
      Lir::Instr::GetFieldPtr(node) -> { CodegenQbe::addOperandFunction(reachable, &node.base); },
      Lir::Instr::MakeClosure(node) -> {
        CodegenQbe::addReachable(reachable, node.thunk);

        if (let Option::SOME(dropFn) = node.dropFn) {
          CodegenQbe::addReachable(reachable, dropFn);
        }
      },
      Lir::Instr::CallClosure(node) -> {
        CodegenQbe::addOperandFunctions(reachable, &node.args);
      },
      Lir::Instr::MakeRawFunction(node) -> {
        CodegenQbe::addReachable(reachable, node.callee);
      },
      Lir::Instr::RawToClosure(node) -> {
        CodegenQbe::addOperandFunction(reachable, &node.raw);
      },
      Lir::Instr::InitRecord(node) -> {
        let mut index: u64 = 0;
        while (index < node.fields.length()) {
          if (let Option::SOME(field) = node.fields.get(index)) { CodegenQbe::addOperandFunction(reachable, &field.value); }
          index += 1;
        }
      },
      _ -> {},
    };
  }

  // The hosted mono roots include C-only std entrypoints such as snprintfDouble.
  // A binary needs only the entry, harness roots, runtime initialization and
  // their dependencies; a library without an entry keeps all of its definitions.
  function reachableFunctions(
    defStore: &mut Analyzer::DefinitionStore,
    program: &Lir::LirProgram,
    externalSymbols: &Vector<u32>,
    foreignDefinitions: &Vector<u32>,
    extraRoots: &Vector<u32>,
  ): Vector<u32> {
    let mut reachable: Vector<u32> = Vector::new<u32>();
    if (let Option::SOME(entry) = program.entryPoint) {
      CodegenQbe::addReachable(&mut reachable, entry);
    }

    // The drop methods generated glue calls are roots even though no LIR
    // instruction names them directly.
    let mut rootIndex: u64 = 0;
    while (rootIndex < extraRoots.length()) {
      if (let Option::SOME(raw) = extraRoots.get(rootIndex)) {
        CodegenQbe::addReachable(&mut reachable, Id::fromRaw<Analyzer::DefinitionTag>(*raw));
      }
      rootIndex += 1;
    }

    let mut index: u64 = 0;
    while (index < program.functions.length()) {
      if (let Option::SOME(function_) = program.functions.functionAt(index)) {
        if ((program.entryPoint.isNone() && externalSymbols.length() == 0) || CodegenC::hasRaw(externalSymbols, function_.defId.raw())) {
          CodegenQbe::addReachable(&mut reachable, function_.defId);
        }
        if (program.entryPoint.isSome() || externalSymbols.length() > 0) {
          if (let Option::SOME(Analyzer::Definition::Function(definition)) = defStore.get(function_.defId)) {
            if (let Option::SOME(name) = &definition.externName) {
              if (name.equals("ignis_runtime_init")) {
                CodegenQbe::addReachable(&mut reachable, function_.defId);
              }
            }
          }
        }
      }
      index += 1;
    }
    let mut cursor: u64 = 0;
    while (cursor < reachable.length()) {
      let Option::SOME(raw) = reachable.get(cursor) else {
        break;
      };
      let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*raw);

      // A foreign function's body lives in another unit, so what it calls is
      // that unit's to emit.
      if (CodegenC::hasRaw(foreignDefinitions, *raw)) {
        cursor += 1;
        continue;
      }
      if (let Option::SOME(function_) = program.functions.get(defId)) {
        let mut blockIndex: u64 = 0;
        while (blockIndex < function_.blocks.length()) {
          if (let Option::SOME(block) = function_.blocks.get(blockIndex)) {
            let mut instructionIndex: u64 = 0;
            while (instructionIndex < block.instructions.length()) {
              if (let Option::SOME(instruction) = block.instructions.get(instructionIndex)) {
                CodegenQbe::addInstructionFunctions(&mut reachable, instruction);
              }
              instructionIndex += 1;
            }
            if (let Lir::Terminator::Return(Option::SOME(value)) = &block.terminator) {
              CodegenQbe::addOperandFunction(&mut reachable, &value);
            }
          }
          blockIndex += 1;
        }
      }
      cursor += 1;
    }
    return reachable;
  }

  /// The `B4004` diagnostic for `output.error`. It points at the body of the
  /// function that holds the unsupported instruction and its label says so,
  /// since LIR instructions carry no span of their own.
  function errorDiagnostic(output: &CodegenQbe::EmitOutput, message: str): Diagnostic {
    let Option::SOME(span) = output.errorSpan else {
      return Diagnostic::new(Severity::ERROR, DiagnosticCode::BACKEND_UNSUPPORTED, message, SourceSpan::detached(0, 0));
    };

    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::BACKEND_UNSUPPORTED, message, span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, "in this function (the unsupported instruction has no span of its own)");

    return diagnostic;
  }

  /// The QBE IL for the whole program, or the first unsupported instruction.
  /// A run that meets anything unsupported fails closed: `source` stays empty
  /// and `error` carries the exact instruction name, so the driver reports a
  /// build failure instead of emitting wrong code.
  ///
  /// `foreignDefinitions` holds the raw ids of the functions and statics
  /// another unit defines (the std archive's, in a unit linked against
  /// `libignis_std.a`): they get no body and no data here, and their uses
  /// stay `$symbol` references the linker resolves.
  function emitProgram(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    program: &Lir::LirProgram,
    externalSymbols: &Vector<u32>,
    foreignDefinitions: &Vector<u32>,
  ): CodegenQbe::EmitOutput {
    let mut emitter: CodegenQbe::Emitter = CodegenQbe::Emitter::init();

    // The closure environments are collected before emission: a `MakeClosure`
    // writes the layout its thunk reads back.
    let closureTables: CodegenC::ClosureTables = CodegenC::collectClosureTables(defStore, typeStore, program);

    // The drop and mark-moved helpers are type-keyed, so they are collected
    // from the LIR before reachability, and the drop methods they call join
    // the reachable set as extra roots.
    let mut glueTypes: Vector<u32> = Vector::new<u32>();
    let mut markTypes: Vector<u32> = Vector::new<u32>();
    let mut guardTypes: Vector<u32> = Vector::new<u32>();
    let mut glueMethods: Vector<u32> = Vector::new<u32>();

    CodegenQbe::qbeCollectDropHelpers(defStore, typeStore, symbols, program, &mut glueTypes, &mut markTypes, &mut guardTypes, &mut glueMethods);

    let reachable: Vector<u32> = CodegenQbe::reachableFunctions(defStore, program, externalSymbols, foreignDefinitions, &glueMethods);

    // Type declarations first: aggregate signatures and aggregate call
    // results reference them by name.
    let mut emittedTypes: Vector<u32> = Vector::new<u32>();
    let mut typeIndex: u64 = 0;
    while (typeIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(typeIndex) else {
        break;
      };
      if (CodegenC::isExternFunction(defStore, function_.defId) || !CodegenC::hasRaw(&reachable, function_.defId.raw()) || CodegenC::hasRaw(foreignDefinitions, function_.defId.raw())) {
        typeIndex += 1;
        continue;
      }
      CodegenQbe::qbeEmitTypeDeclarations(&mut emitter, defStore, typeStore, symbols, &mut emittedTypes, function_.returnType);
      let mut localIndex: u64 = 0;
      while (localIndex < function_.locals.length()) {
        if (let Option::SOME(local) = function_.locals.get(localIndex)) {
          CodegenQbe::qbeEmitTypeDeclarations(&mut emitter, defStore, typeStore, symbols, &mut emittedTypes, local.ty);
        }
        localIndex += 1;
      }
      let mut tempIndex: u64 = 0;
      while (tempIndex < function_.temps.length()) {
        if (let Option::SOME(temp) = function_.temps.get(tempIndex)) {
          CodegenQbe::qbeEmitTypeDeclarations(&mut emitter, defStore, typeStore, symbols, &mut emittedTypes, temp.ty);
        }
        tempIndex += 1;
      }
      typeIndex += 1;
    }
    let mut globalIndex: u64 = 0;
    while (globalIndex < program.globalInits.length()) {
      if (let Option::SOME(global) = program.globalInits.get(globalIndex)) {
        if (let Option::SOME(Analyzer::Definition::Variable(variable)) = defStore.get(global.defId)) {
          CodegenQbe::qbeEmitTypeDeclarations(&mut emitter, defStore, typeStore, symbols, &mut emittedTypes, variable.declaredType);
        }
      }
      globalIndex += 1;
    }

    CodegenQbe::qbeEmitGlobals(&mut emitter, defStore, typeStore, symbols, program, foreignDefinitions);
    CodegenQbe::qbeEmitDropGlueHelpers(&mut emitter, defStore, typeStore, symbols, &glueTypes);
    CodegenQbe::qbeEmitMarkHelpers(&mut emitter, defStore, typeStore, &markTypes);
    CodegenQbe::qbeEmitDropGuardHelpers(&mut emitter, defStore, typeStore, &guardTypes);
    CodegenQbe::qbeEmitRawAdapters(&mut emitter, defStore, typeStore, symbols, program);

    if (emitter.error.isSome()) {
      return CodegenQbe::EmitOutput {
        source: String::create(""),
        error: emitter.error,
        errorSpan: emitter.errorSpan,
        functions: 0,
      };
    }

    let mut functions: u64 = 0;
    let mut functionIndex: u64 = 0;

    while (functionIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(functionIndex) else {
        functionIndex += 1;
        continue;
      };

      if (CodegenC::hasRaw(&reachable, function_.defId.raw()) && !CodegenC::hasRaw(foreignDefinitions, function_.defId.raw()) && CodegenQbe::qbeEmitFunction(&mut emitter, defStore, typeStore, symbols, function_, externalSymbols, &closureTables)) {
        functions += 1;
      }

      if (emitter.error.isSome()) {
        // LIR instructions carry no source span, so the function holding the
        // unsupported one is the closest site there is.
        if (emitter.errorSpan.isNone()) {
          emitter.errorSpan = Option::SOME(function_.span);
        }

        return CodegenQbe::EmitOutput {
          source: String::create(""),
          error: emitter.error,
          errorSpan: emitter.errorSpan,
          functions: 0,
        };
      }

      functionIndex += 1;
    }

    CodegenQbe::qbeEmitEntryWrapper(&mut emitter, defStore, typeStore, symbols, program);

    if (emitter.error.isSome()) {
      return CodegenQbe::EmitOutput {
        source: String::create(""),
        error: emitter.error,
        errorSpan: emitter.errorSpan,
        functions: 0,
      };
    }

    let head: String = String::create("# Types\n");

    return CodegenQbe::EmitOutput {
      source: `${head.toStr()}${emitter.data.toStr()}# Code\n${emitter.out.toStr()}`,
      error: Option::NONE,
      errorSpan: Option::NONE,
      functions: functions,
    };
  }
}
