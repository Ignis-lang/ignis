import Symbol from "@compiler::symbols";
import HashMap from "std::collections";
import Hasher from "std::hash";

@implements(Display)
export record StringInterner {
  texts: Vector<String>;
  /// Indices into `texts`, grouped by the hash of the text they hold.
  ///
  /// `String` carries no `Hash` implementation, so the text cannot key a map
  /// directly. A bucket is a candidate list that `intern` still compares
  /// against, which keeps a hash collision costing one comparison rather than
  /// handing back the wrong symbol.
  byTextHash: HashMap<u64, Vector<u32>>;

  public static init(): StringInterner {
    return StringInterner {
      texts: Vector {
        data: null,
        length: 0,
        capacity: 0,
      },
      byTextHash: HashMap::new<u64, Vector<u32>>(),
    };
  }

  public intern(&mut self, text: str): Symbol {
    let mut hasher: Hasher = Hasher::new();
    hasher.writeStr(text);
    let key: u64 = hasher.finish();

    if (let Option::SOME(bucket) = self.byTextHash.get(&key)) {
      let mut index: u64 = 0;

      while (index < bucket.length()) {
        let mut candidate: u32 = 0;
        if (let Option::SOME(entry) = bucket.get(index)) {
          candidate = *entry;
        }

        if (let Option::SOME(existing) = self.texts.get(candidate as u64) && existing.equals(text)) {
          return Symbol::fromRaw(candidate);
        }

        index += 1;
      }
    }

    self.texts.push(String::create(text));
    let symbolRaw: u32 = (self.texts.length() - 1) as u32;

    if (let Option::SOME(bucket) = self.byTextHash.getMut(&key)) {
      let mut bucketRef: &mut Vector<u32> = bucket;
      bucketRef.push(symbolRaw);
      return Symbol::fromRaw(symbolRaw);
    }

    let mut bucket: Vector<u32> = Vector::new<u32>();
    bucket.push(symbolRaw);
    self.byTextHash.insert(key, bucket);

    return Symbol::fromRaw(symbolRaw);
  }

  public resolve(&self, symbol: Symbol): Option<str> {
    return match (self.texts.get(symbol.raw() as u64)) {
      Option::SOME(text) -> Option::SOME(text.toStr()),
      Option::NONE -> Option::NONE,
    };
  }

  public length(&self): u64 {
    return self.texts.length();
  }

  public display(&self): String {
    let mut result: String = String::create("StringInterner[");
    let mut index: u64 = 0;

    while (index < self.texts.length()) {
      if (index > 0) {
        result.pushStr("\n");
      }

      if (let Option::SOME(text) = self.texts.get(index)) {
        let symbol: Symbol = Symbol::fromRaw(index as u32);
        let symbolText: String = symbol.display();
        result.pushStr(symbolText.toStr());
        result.pushStr(": \"");
        result.pushStr(text.toStr());
        result.pushStr("\"");
      }

      index += 1;
    }

    if (self.texts.length() > 0) {
      result.pushStr("\n");
    }

    result.pushStr("]");
    return result;
  }
}
