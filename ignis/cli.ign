/// `clap` validates conflicts only after matching the whole command line, so
/// a preceding, non-conflicting flag still appears in the `Usage:` line
/// (verified against the host binary on this exact command line).
@test
function cliRejectsUseTabsWithSpacesAfterOnePrecedingFlag(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--check");
  cliPush(&mut arguments, "--use-tabs");
  cliPush(&mut arguments, "--spaces");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--use-tabs' cannot be used with '--spaces'\n\nUsage: ignis fmt --check --use-tabs [FILE_PATHS]...\n\nFor more information, try '--help'."
  );
}

/// Same as above with two preceding flags, in the order they were parsed.
@test
function cliRejectsUseTabsWithSpacesAfterTwoPrecedingFlags(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--check");
  cliPush(&mut arguments, "--sort-imports");
  cliPush(&mut arguments, "--use-tabs");
  cliPush(&mut arguments, "--spaces");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--use-tabs' cannot be used with '--spaces'\n\nUsage: ignis fmt --check --sort-imports --use-tabs [FILE_PATHS]...\n\nFor more information, try '--help'."
  );
}

/// A flag placed *after* the rejected argument still appears in the
/// `Usage:` line: `clap` matches the whole line before validating a
/// conflict, so this is not limited to flags seen before the conflict.
@test
function cliRejectsUseTabsWithSpacesFollowedByALaterFlag(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--use-tabs");
  cliPush(&mut arguments, "--spaces");
  cliPush(&mut arguments, "--sort-imports");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--use-tabs' cannot be used with '--spaces'\n\nUsage: ignis fmt --use-tabs --sort-imports [FILE_PATHS]...\n\nFor more information, try '--help'."
  );
}

/// `--stdin-json` after a preceding flag: the `Usage:` line keeps the
/// preceding flag even though it is unrelated to the conflict.
@test
function cliRejectsStdinJsonWithProjectAfterAPrecedingFlag(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--check");
  cliPush(&mut arguments, "--stdin-json");
  cliPush(&mut arguments, "--project");
  cliPush(&mut arguments, "demo");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--stdin-json' cannot be used with '--project <PROJECT>'\n\nUsage: ignis fmt --check --stdin-json [FILE_PATHS]...\n\nFor more information, try '--help'."
  );
}

/// A `FILE_PATHS` value present anywhere on the line — even *before* both
/// conflicting flags, and never actually consumed since the conflict fires
/// first — still switches the trailing placeholder to `<FILE_PATHS>...`.
@test
function cliRejectsUseTabsWithSpacesWithALeadingFilePath(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "a.ign");
  cliPush(&mut arguments, "--use-tabs");
  cliPush(&mut arguments, "--spaces");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--use-tabs' cannot be used with '--spaces'\n\nUsage: ignis fmt --use-tabs <FILE_PATHS>...\n\nFor more information, try '--help'."
  );
}

/// A non-repeatable `fmt` flag given twice is `clap`'s own "used multiple
/// times" error, not the formatter's own conflict wording, and its
/// `Usage:` line is the generic one, not the accumulated per-flag list a
/// conflict error builds. Verified against the host binary.
@test
function cliRejectsCheckUsedTwice(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--check");
  cliPush(&mut arguments, "--check");
  cliPush(&mut arguments, "a.ign");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--check' cannot be used multiple times\n\nUsage: ignis fmt [OPTIONS] [FILE_PATHS]...\n\nFor more information, try '--help'."
  );
}

/// Same as above for a value-taking flag: the message-form subject includes
/// its placeholder (`--project <PROJECT>`), not just the flag name.
@test
function cliRejectsProjectUsedTwice(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--project");
  cliPush(&mut arguments, "a");
  cliPush(&mut arguments, "--project");
  cliPush(&mut arguments, "b");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--project <PROJECT>' cannot be used multiple times\n\nUsage: ignis fmt [OPTIONS] [FILE_PATHS]...\n\nFor more information, try '--help'."
  );
}

/// `--use-tabs` and `--spaces` are each individually non-repeatable too,
/// independent of their mutual-exclusion conflict with each other.
@test
function cliRejectsUseTabsUsedTwice(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--use-tabs");
  cliPush(&mut arguments, "--use-tabs");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--use-tabs' cannot be used multiple times\n\nUsage: ignis fmt [OPTIONS] [FILE_PATHS]...\n\nFor more information, try '--help'."
  );
}

/// `--emit` is the one `fmt` flag `clap` allows repeated: no error.
@test
function cliAllowsEmitUsedTwice(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--emit");
  cliPush(&mut arguments, "diff");
  cliPush(&mut arguments, "--emit");
  cliPush(&mut arguments, "diff");

  let options: CliOptions = cliParse(&arguments);

  Test::assertEq<boolean>(options.fmtEmitDiff, true);
}

/// A duplicate flag is reported ahead of an unrelated conflict elsewhere on
/// the same line, even when the duplicate itself comes *after* the
/// conflicting pair in argv order: `clap` matches the whole line before
/// validating anything, and a "used multiple times" error takes priority
/// over a conflict error. Verified against the host binary.
@test
function cliRejectsADuplicateFlagBeforeAnUnrelatedConflict(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--use-tabs");
  cliPush(&mut arguments, "--spaces");
  cliPush(&mut arguments, "--check");
  cliPush(&mut arguments, "--check");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--check' cannot be used multiple times\n\nUsage: ignis fmt [OPTIONS] [FILE_PATHS]...\n\nFor more information, try '--help'."
  );
}
