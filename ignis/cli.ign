  Test::assertEq<str>(options.init.projectVersion.toStr(), "2.0.0");
  Test::assertEq<str>(options.init.target.toStr(), "none");
  Test::assertEq<str>(cliOptionText(&options.init.mainFile).toStr(), "app.ign");
  Test::assertEq<str>(options.init.outputDir.toStr(), "out");
  Test::assertEq<boolean>(options.outputPath.isNone(), true);
  Test::assertEq<str>(options.init.sourceDir.toStr(), "lib");
  Test::assertEq<str>(options.init.repository.toStr(), "repo");
  Test::assertEq<str>(cliJoined(&options.init.keywords).toStr(), "cli");
}

/// `init` rejects a missing name, a second name, an unknown target, a flag
/// missing its value, and flags that belong to other commands.
@test
function cliRejectsWhatInitDoesNotTake(): void {
  let mut noName: Vector<String> = Vector::new<String>();
  cliPush(&mut noName, "init");
  cliPush(&mut noName, "--lib");
  Test::assertEq<str>(cliParseError(&noName).toStr(), "error: init requires a project name");

  let mut twoNames: Vector<String> = Vector::new<String>();
  cliPush(&mut twoNames, "init");
  cliPush(&mut twoNames, "a");
  cliPush(&mut twoNames, "b");
  Test::assertEq<str>(cliParseError(&twoNames).toStr(), "error: unexpected argument 'b'");

  let mut badTarget: Vector<String> = Vector::new<String>();
  cliPush(&mut badTarget, "init");
  cliPush(&mut badTarget, "demo");
  cliPush(&mut badTarget, "--target");
  cliPush(&mut badTarget, "wasm");
  Test::assertEq<str>(
    cliParseError(&badTarget).toStr(),
    "error: invalid value 'wasm' for '--target': expected c, iir or none",
  );

  let mut missingValue: Vector<String> = Vector::new<String>();
  cliPush(&mut missingValue, "init");
  cliPush(&mut missingValue, "demo");
  cliPush(&mut missingValue, "-e");
  Test::assertEq<str>(cliParseError(&missingValue).toStr(), "error: --email requires a value");

  let mut buildFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut buildFlag, "init");
  cliPush(&mut buildFlag, "demo");
  cliPush(&mut buildFlag, "--cc");
  cliPush(&mut buildFlag, "clang");
  Test::assertEq<str>(cliParseError(&buildFlag).toStr(), "error: unknown argument: --cc");
}

/// `check-std` reads only its output directory, as `-o` or `--output-dir`.
@test
function cliParsesCheckStdWithAnOutputDirectory(): void {
  let mut bare: Vector<String> = Vector::new<String>();
  cliPush(&mut bare, "check-std");

  let bareOptions: CliOptions = cliParse(&bare);

  Test::assertEq<str>(cliCommandName(bareOptions.command), "check-std");
  Test::assertEq<boolean>(bareOptions.outDir.isNone(), true);

  let mut shortForm: Vector<String> = Vector::new<String>();
  cliPush(&mut shortForm, "check-std");
  cliPush(&mut shortForm, "-o");
  cliPush(&mut shortForm, "out");
  Test::assertEq<str>(cliOptionText(&cliParse(&shortForm).outDir).toStr(), "out");

  let mut longForm: Vector<String> = Vector::new<String>();
  cliPush(&mut longForm, "check-std");
  cliPush(&mut longForm, "--output-dir=checked");
  Test::assertEq<str>(cliOptionText(&cliParse(&longForm).outDir).toStr(), "checked");
}

/// `check-std` takes no path and no build flag.
@test
function cliRejectsWhatCheckStdDoesNotTake(): void {
  let mut path: Vector<String> = Vector::new<String>();
  cliPush(&mut path, "check-std");
  cliPush(&mut path, "std");
  Test::assertEq<str>(cliParseError(&path).toStr(), "error: unexpected argument 'std'");

  let mut buildFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut buildFlag, "check-std");
  cliPush(&mut buildFlag, "--debug");
  Test::assertEq<str>(cliParseError(&buildFlag).toStr(), "error: unknown argument: --debug");
}

/// `-j` / `--jobs` sizes a test run's pool in every spelling `clap` accepts,
/// and stays unset when absent so `IGNIS_TEST_JOBS` still applies.
@test
function cliParsesTheTestJobCount(): void {
  let mut absent: Vector<String> = Vector::new<String>();
  cliPush(&mut absent, "test");
  Test::assertEq<boolean>(cliParse(&absent).jobs.isNone(), true);

  let mut shortForm: Vector<String> = Vector::new<String>();
  cliPush(&mut shortForm, "test");
  cliPush(&mut shortForm, "-j");
  cliPush(&mut shortForm, "2");
  let shortFormOptions: CliOptions = cliParse(&shortForm);
  Test::assertEq<u64>(cliJobCount(&shortFormOptions), 2);

  let mut attached: Vector<String> = Vector::new<String>();
  cliPush(&mut attached, "test");
  cliPush(&mut attached, "-j3");
  let attachedOptions: CliOptions = cliParse(&attached);
  Test::assertEq<u64>(cliJobCount(&attachedOptions), 3);

  let mut longForm: Vector<String> = Vector::new<String>();
  cliPush(&mut longForm, "test");
  cliPush(&mut longForm, "--jobs");
  cliPush(&mut longForm, "4");
  cliPush(&mut longForm, "math");
  let longOptions: CliOptions = cliParse(&longForm);
  Test::assertEq<u64>(cliJobCount(&longOptions), 4);
  Test::assertEq<str>(cliPathText(&longOptions).toStr(), "math");

  let mut equalsForm: Vector<String> = Vector::new<String>();
  cliPush(&mut equalsForm, "test");
  cliPush(&mut equalsForm, "--jobs=5");
  let equalsFormOptions: CliOptions = cliParse(&equalsForm);
  Test::assertEq<u64>(cliJobCount(&equalsFormOptions), 5);
}

/// A job count has to be a whole number from 1 up, and only `test` takes one.
@test
function cliRejectsAnInvalidJobCount(): void {
  let mut zero: Vector<String> = Vector::new<String>();
  cliPush(&mut zero, "test");
  cliPush(&mut zero, "-j");
  cliPush(&mut zero, "0");
  Test::assertEq<str>(cliParseError(&zero).toStr(), "error: invalid job count: 0");

  let mut word: Vector<String> = Vector::new<String>();
  cliPush(&mut word, "test");
  cliPush(&mut word, "--jobs=many");
  Test::assertEq<str>(cliParseError(&word).toStr(), "error: invalid job count: many");

  let mut tooLarge: Vector<String> = Vector::new<String>();
  cliPush(&mut tooLarge, "test");
  cliPush(&mut tooLarge, "-j");
  cliPush(&mut tooLarge, "4294967296");
  Test::assertEq<str>(cliParseError(&tooLarge).toStr(), "error: invalid job count: 4294967296");

  let mut missing: Vector<String> = Vector::new<String>();
  cliPush(&mut missing, "test");
  cliPush(&mut missing, "-j");
  Test::assertEq<str>(cliParseError(&missing).toStr(), "error: -j requires a number of jobs");

  let mut build: Vector<String> = Vector::new<String>();
  cliPush(&mut build, "build");
  cliPush(&mut build, "-j");
  cliPush(&mut build, "2");
  Test::assertEq<str>(cliParseError(&build).toStr(), "error: unknown argument: -j");
}

/// Every `init` flag except `--authors` and `--keywords` may appear once, the
/// way `clap` rejects a repeated single-value argument or switch.
@test
function cliRejectsARepeatedInitFlag(): void {
  let mut email: Vector<String> = Vector::new<String>();
  cliPush(&mut email, "init");
  cliPush(&mut email, "demo");
  cliPush(&mut email, "-e");
  cliPush(&mut email, "a@example.com");
  cliPush(&mut email, "--email=b@example.com");
  Test::assertEq<str>(cliParseError(&email).toStr(), "error: the argument '--email' cannot be used multiple times");

  let mut lib: Vector<String> = Vector::new<String>();
  cliPush(&mut lib, "init");
  cliPush(&mut lib, "--lib");
  cliPush(&mut lib, "demo");
  cliPush(&mut lib, "--lib");
  Test::assertEq<str>(cliParseError(&lib).toStr(), "error: the argument '--lib' cannot be used multiple times");

  let mut quiet: Vector<String> = Vector::new<String>();
  cliPush(&mut quiet, "init");
  cliPush(&mut quiet, "demo");
  cliPush(&mut quiet, "--quiet");
  cliPush(&mut quiet, "-q");
  Test::assertEq<str>(cliParseError(&quiet).toStr(), "error: the argument '--quiet' cannot be used multiple times");

  let mut repeatable: Vector<String> = Vector::new<String>();
  cliPush(&mut repeatable, "init");
  cliPush(&mut repeatable, "demo");
  cliPush(&mut repeatable, "-a");
  cliPush(&mut repeatable, "Ann");
  cliPush(&mut repeatable, "-a");
  cliPush(&mut repeatable, "Bob");
  cliPush(&mut repeatable, "-k");
  cliPush(&mut repeatable, "x");
  cliPush(&mut repeatable, "--keywords=y");
  let repeatableOptions: CliOptions = cliParse(&repeatable);
  Test::assertEq<str>(cliJoined(&repeatableOptions.init.authors).toStr(), "Ann,Bob");
  Test::assertEq<str>(cliJoined(&repeatableOptions.init.keywords).toStr(), "x,y");
}

/// A separate value starting with `-` is never taken as a value, as in `clap`
/// without `allow_hyphen_values`: a known flag there leaves the value missing,
/// anything else is an unknown argument. A lone `-` and an attached value
/// still count as values.
@test
function cliRejectsAFlagWhereAnInitValueBelongs(): void {
  let mut knownFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut knownFlag, "init");
  cliPush(&mut knownFlag, "demo");
  cliPush(&mut knownFlag, "--email");
  cliPush(&mut knownFlag, "--lib");
  Test::assertEq<str>(cliParseError(&knownFlag).toStr(), "error: --email requires a value");

  let mut knownShort: Vector<String> = Vector::new<String>();
  cliPush(&mut knownShort, "init");
  cliPush(&mut knownShort, "demo");
  cliPush(&mut knownShort, "-a");
  cliPush(&mut knownShort, "-eann@example.com");
  Test::assertEq<str>(cliParseError(&knownShort).toStr(), "error: --authors requires a value");

  let mut unknown: Vector<String> = Vector::new<String>();
  cliPush(&mut unknown, "init");
  cliPush(&mut unknown, "demo");
  cliPush(&mut unknown, "-e");
  cliPush(&mut unknown, "-5");
  Test::assertEq<str>(cliParseError(&unknown).toStr(), "error: unknown argument: -5");

  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "init");
  cliPush(&mut values, "demo");
  cliPush(&mut values, "--email");
  cliPush(&mut values, "-");
  cliPush(&mut values, "--description=--lib");
  cliPush(&mut values, "-r-x");
  let valueOptions: CliOptions = cliParse(&values);
  Test::assertEq<str>(valueOptions.init.email.toStr(), "-");
  Test::assertEq<str>(valueOptions.init.description.toStr(), "--lib");
  Test::assertEq<str>(valueOptions.init.repository.toStr(), "-x");
  Test::assertEq<boolean>(valueOptions.init.lib, false);
}

/// `test-std` takes `-j` / `--jobs` too, the host's option being global.
@test
function cliParsesTheTestStdJobCount(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "test-std");
  cliPush(&mut arguments, "-j");
  cliPush(&mut arguments, "2");
  cliPush(&mut arguments, "string");

  let options: CliOptions = cliParse(&arguments);

  Test::assertEq<u64>(cliJobCount(&options), 2);
  Test::assertEq<str>(options.filter.toStr(), "string");

  let mut attached: Vector<String> = Vector::new<String>();
  cliPush(&mut attached, "test-std");
  cliPush(&mut attached, "--jobs=4");

  let attachedOptions: CliOptions = cliParse(&attached);

  Test::assertEq<u64>(cliJobCount(&attachedOptions), 4);
}
