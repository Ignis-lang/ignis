import String from "std::string";
import Test from "std::test";
import Vector from "std::vector";

/// The version this compiler reports, kept equal to the host compiler's
/// workspace version so `ignis --version` prints the same string whichever
/// binary answers it.
export const IGNIS_VERSION: str = "0.4.0";

/// The subcommand a command line selected.
export enum CliCommand {
  BUILD,
  CHECK,
  BUILD_STD,
  TEST,
  FMT,
  HELP,
  VERSION,
}

/// A `k/n` shard selector, 1-based, as the command line spells it.
export record PartitionSpec {
  public index: u64;
  public count: u64;
}

/// Everything a parsed command line carries.
///
/// `path` is the project directory or source file the command runs against,
/// absent when the command runs against the current directory. `outputPath`
/// is the binary `-o` names, and `outDir` the directory `--out-dir` names;
/// the rest override what the project file declares.
export record CliOptions {
  public command: CliCommand;
  public path: Option<String>;
  public outputPath: Option<String>;
  public outDir: Option<String>;
  public stdPath: Option<String>;
  public cc: Option<String>;
  public targetTriple: Option<String>;
  public optLevel: Option<u64>;
  public debug: Option<boolean>;
  public features: Vector<String>;
  public filter: String;
  public updateSnapshots: boolean;
  /// Fixture directories added to the ones the project file declares.
  public fixtureDirs: Vector<String>;
  /// The shard a run executes, absent when the command line named none.
  public partition: Option<PartitionSpec>;
  /// Wall-clock budget in seconds for a single test process.
  public testTimeout: Option<u64>;
  /// Explicit files to format (fmt only); empty selects project discovery.
  public fmtFilePaths: Vector<String>;
  /// Explicit project directory to format (fmt only).
  public fmtProject: Option<String>;
  /// Validates formatting without rewriting files (fmt only).
  public fmtCheck: boolean;
  /// Explicit formatter config file (fmt only).
  public fmtConfigPath: Option<String>;
  public fmtIndentWidth: Option<u64>;
  public fmtLineWidth: Option<u64>;
  public fmtUseTabs: Option<boolean>;
  public fmtSortImports: boolean;
  /// Reads an NDJSON batch from stdin instead of formatting files (fmt only).
  public fmtStdinJson: boolean;
  /// Emits a unified diff instead of rewriting files (fmt only).
  public fmtEmitDiff: boolean;

  public static create(command: CliCommand): CliOptions {
    return CliOptions {
      command: command,
      path: Option::NONE,
      outputPath: Option::NONE,
      outDir: Option::NONE,
      stdPath: Option::NONE,
      cc: Option::NONE,
      targetTriple: Option::NONE,
      optLevel: Option::NONE,
      debug: Option::NONE,
      features: Vector::new<String>(),
      filter: String::new(),
      updateSnapshots: false,
      fixtureDirs: Vector::new<String>(),
      partition: Option::NONE,
      testTimeout: Option::NONE,
      fmtFilePaths: Vector::new<String>(),
      fmtProject: Option::NONE,
      fmtCheck: false,
      fmtConfigPath: Option::NONE,
      fmtIndentWidth: Option::NONE,
      fmtLineWidth: Option::NONE,
      fmtUseTabs: Option::NONE,
      fmtSortImports: false,
      fmtStdinJson: false,
      fmtEmitDiff: false,
    };
  }

  /// The binary path a build writes, or `fallback` when `-o` was absent.
  public outputPathOr(&self, fallback: str): String {
    return match (&self.outputPath) {
      Option::SOME(value) -> value.clone(),
      Option::NONE -> String::create(fallback),
    };
  }

  public isTestMode(&self): boolean {
    if (let CliCommand::TEST = self.command) {
      return true;
    }

    return false;
  }

  public isFmtMode(&self): boolean {
    if (let CliCommand::FMT = self.command) {
      return true;
    }

    return false;
  }
}

/// Splits a comma-separated list into its items, dropping empty ones.
export function splitCommaSeparated(value: &String): Vector<String> {
  let mut items: Vector<String> = Vector::new<String>();
  let mut start: u64 = 0;
  let mut index: u64 = 0;

  while (index <= value.length()) {
    let mut atSeparator: boolean = index == value.length();

    if (!atSeparator) {
      if (let Option::SOME(byte) = value.byteAt(index)) {
        atSeparator = byte == ',' as u8;
      }
    }

    if (atSeparator) {
      let item: String = value.substringBytes(start, index).trimAsciiWhitespace();

      if (item.length() > 0) {
        items.push(item.clone());
      }

      start = index + 1;
    }

    index += 1;
  }

  return items;
}

/// Read a decimal number, rejecting an empty string and any non-digit byte.
function parseDecimal(text: &String): Option<u64> {
  if (text.length() == 0) {
    return Option::NONE;
  }

  let mut parsed: u64 = 0;
  let mut index: u64 = 0;

  while (index < text.length()) {
    let Option::SOME(digit) = text.byteAt(index) else {
      return Option::NONE;
    };

    if (digit < 48 || digit > 57) {
      return Option::NONE;
    }

    parsed = parsed * 10 + ((digit - 48) as u64);
    index += 1;
  }

  return Option::SOME(parsed);
}

/// Parses a `k/n` shard selector, which is 1-based and has to name a shard the
/// count actually holds.
export function parsePartitionSpec(raw: &String): Result<PartitionSpec, String> {
  let malformed: String = `Invalid partition '${raw.toStr()}': expected the form k/n, for example 1/4`;
  let mut separator: u64 = raw.length();
  let mut index: u64 = 0;

  while (index < raw.length()) {
    if (let Option::SOME(byte) = raw.byteAt(index) && byte == '/' as u8) {
      separator = index;
      break;
    }

    index += 1;
  }

  if (separator == raw.length()) {
    return Result::ERROR(malformed);
  }

  let indexText: String = raw.substringBytes(0, separator).trimAsciiWhitespace();
  let countText: String = raw.substringBytes(separator + 1, raw.length()).trimAsciiWhitespace();

  let Option::SOME(shardIndex) = parseDecimal(&indexText) else {
    return Result::ERROR(malformed);
  };
  let Option::SOME(shardCount) = parseDecimal(&countText) else {
    return Result::ERROR(malformed);
  };

  if (shardCount == 0 || shardIndex == 0 || shardIndex > shardCount) {
    return Result::ERROR(`Invalid partition '${raw.toStr()}': expected 1 <= k <= n with n >= 1`);
  }

  return Result::OK(PartitionSpec {
    index: shardIndex,
    count: shardCount,
  });
}

/// Read an `--opt-level` / `-O` value, which the C toolchain takes as `-O<level>`.
function parseOptLevelArgument(text: &String): Option<u64> {
  if (text.length() != 1) {
    return Option::NONE;
  }

  let Option::SOME(digit) = text.charAt(0) else {
    return Option::NONE;
  };

  if (digit < '0' || digit > '3') {
    return Option::NONE;
  }

  return Option::SOME((digit as u64) - ('0' as u64));
}

function cliSubcommandOf(argument: &String): Option<CliCommand> {
  if (argument.equals("build")) {
    return Option::SOME(CliCommand::BUILD);
  }

  if (argument.equals("check")) {
    return Option::SOME(CliCommand::CHECK);
  }

  if (argument.equals("build-std")) {
    return Option::SOME(CliCommand::BUILD_STD);
  }

  if (argument.equals("test")) {
    return Option::SOME(CliCommand::TEST);
  }

  if (argument.equals("fmt")) {
    return Option::SOME(CliCommand::FMT);
  }

  return Option::NONE;
}

/// True for an argument that names a source file rather than a subcommand.
///
/// The bare form `ignis <entry.ign>` predates the subcommands and is still what
/// the bootstrap ladder and the parity harness call, so a path in the first
/// position stays a build.
function cliLooksLikePath(argument: &String): boolean {
  return cliEndsWith(argument, ".ign") || argument.startsWith("./") || argument.startsWith("../") || argument.startsWith("/") || argument.equals(".");
}

function cliEndsWith(value: &String, suffix: str): boolean {
  let suffixText: String = String::create(suffix);

  if (value.length() < suffixText.length()) {
    return false;
  }

  let actualSuffix: String = value.substringBytes(value.length() - suffixText.length(), value.length());
  return actualSuffix.equals(&suffixText);
}

function cliMissingValue(flag: str, expected: str): String {
  return `error: ${flag} requires ${expected}`;
}

/// `ESC`. Ignis string literals have no `\x`/`\u{}` escape, so every ANSI
/// code below is built one `char` at a time from this rather than embedding
/// a raw control byte in the source.
function ansiEsc(): char {
  return '\u{1b}';
}

function pushAnsiBold(output: &mut String, text: str): void {
  let mut outputRef: &mut String = output;
  outputRef.pushChar(ansiEsc());
  outputRef.pushStr("[1m");
  outputRef.pushStr(text);
  outputRef.pushChar(ansiEsc());
  outputRef.pushStr("[0m");
}

function pushAnsiYellow(output: &mut String, text: str): void {
  let mut outputRef: &mut String = output;
  outputRef.pushChar(ansiEsc());
  outputRef.pushStr("[33m");
  outputRef.pushStr(text);
  outputRef.pushChar(ansiEsc());
  outputRef.pushStr("[0m");
}

/// `--indent-width=`/`--line-width=` with nothing after the `=`: `clap`
/// rejects an empty string for a numeric argument with this exact message
/// (still `ColorChoice::Always`, so still ANSI) instead of the generic
/// missing-value error a bare `--indent-width` with no argument at all gets.
function clapEmptyIntegerValueError(flagUsage: str): String {
  let mut message: String = String::new();

  message.pushChar(ansiEsc());
  message.pushStr("[1m");
  message.pushChar(ansiEsc());
  message.pushStr("[31merror:");
  message.pushChar(ansiEsc());
  message.pushStr("[0m invalid value '");
  pushAnsiYellow(&mut message, "");
  message.pushStr("' for '");
  pushAnsiBold(&mut message, flagUsage);
  message.pushStr("': cannot parse integer from empty string\n\nFor more information, try '");
  pushAnsiBold(&mut message, "--help");
  message.pushStr("'.");

  return message;
}

/// One flag `clap` has already matched, as the `Usage:` line renders it: the
/// flag name itself is always bold (`boldPart`), and a value-taking flag's
/// placeholder is plain text appended after it (`plainSuffix`, including its
/// own leading space, e.g. `" <PROJECT>"`; empty for a boolean flag).
record FmtUsageToken {
  public boldPart: str;
  public plainSuffix: str;
}

/// Which of the two order-sensitive `fmt` conflicts `parseArguments` has
/// already seen a flag for (`--use-tabs`/`--spaces` name whichever one
/// `clap` saw first as the conflict's subject), plus everything a conflict
/// error's `Usage:` line needs: every flag matched so far, in the order
/// `clap` matched them, and whether a `FILE_PATHS` positional value has been
/// seen anywhere (its own placeholder always renders last, regardless of
/// where it appeared relative to the other flags: `<FILE_PATHS>...` once a
/// value was given, `[FILE_PATHS]...` when none was).
record FmtFlagState {
  public useTabsSeen: boolean;
  public spacesSeen: boolean;
  public usageTokens: Vector<FmtUsageToken>;
  public sawFilePath: boolean;
}

/// Appends one matched flag to `state`'s `Usage:`-line token list.
function fmtFlagStateRecordToken(state: &mut FmtFlagState, boldPart: str, plainSuffix: str): void {
  let mut stateRef: &mut FmtFlagState = state;
  stateRef.usageTokens.push(FmtUsageToken { boldPart: boldPart, plainSuffix: plainSuffix });
}

/// One `fmt`-only flag's shape, table-driven rather than one hand-written
/// recognizer per flag: `plainSuffix` is `FmtUsageToken`'s (empty for a
/// boolean flag), `takesValue` decides whether a bare `--name` token still
/// needs a following value token (arity 2) or is complete on its own (arity
/// 1; `--name=value` is always arity 1), and `repeatable` is false for
/// every flag except `--emit`, the only one `clap` allows more than once.
record FmtFlagSpec {
  public name: str;
  public plainSuffix: str;
  public takesValue: boolean;
  public repeatable: boolean;
}

/// The single source of truth for every `fmt`-only flag's identity, used by
/// both the duplicate-flag pre-scan and the conflict `Usage:` line's
/// forward scan, so the two can never drift out of sync with each other.
function fmtFlagSpecTable(): Vector<FmtFlagSpec> {
  let mut specs: Vector<FmtFlagSpec> = Vector::new<FmtFlagSpec>();
  specs.push(FmtFlagSpec { name: "--check", plainSuffix: "", takesValue: false, repeatable: false });
  specs.push(FmtFlagSpec { name: "--sort-imports", plainSuffix: "", takesValue: false, repeatable: false });
  specs.push(FmtFlagSpec { name: "--use-tabs", plainSuffix: "", takesValue: false, repeatable: false });
  specs.push(FmtFlagSpec { name: "--spaces", plainSuffix: "", takesValue: false, repeatable: false });
  specs.push(FmtFlagSpec { name: "--stdin-json", plainSuffix: "", takesValue: false, repeatable: false });
  specs.push(FmtFlagSpec { name: "--project", plainSuffix: " <PROJECT>", takesValue: true, repeatable: false });
  specs.push(FmtFlagSpec { name: "--config", plainSuffix: " <CONFIG>", takesValue: true, repeatable: false });
  specs.push(FmtFlagSpec {
    name: "--indent-width",
    plainSuffix: " <INDENT_WIDTH>",
    takesValue: true,
    repeatable: false,
  });
  specs.push(FmtFlagSpec { name: "--line-width", plainSuffix: " <LINE_WIDTH>", takesValue: true, repeatable: false });
  specs.push(FmtFlagSpec { name: "--emit", plainSuffix: " <EMIT>", takesValue: true, repeatable: true });
  return specs;
}

/// Which spec in `fmtFlagSpecTable()` (by index) `argument` matches, and how
/// many argv tokens that occurrence consumes: 1 for a boolean flag or the
/// `--name=value` form, 2 for a value-taking flag's `--name value` form.
record FmtFlagMatch {
  public specIndex: u64;
  public consumed: u64;
}

function fmtMatchFlagSpec(specs: &Vector<FmtFlagSpec>, argument: &String): Option<FmtFlagMatch> {
  let mut index: u64 = 0;

  while (index < specs.length()) {
    if (let Option::SOME(spec) = specs.get(index)) {
      if (spec.takesValue) {
        if (let Option::SOME(_) = flagEqualsValue(argument, spec.name)) {
          return Option::SOME(FmtFlagMatch { specIndex: index, consumed: 1 });
        }

        if (argument.equals(spec.name)) {
          return Option::SOME(FmtFlagMatch { specIndex: index, consumed: 2 });
        }
      } else if (argument.equals(spec.name)) {
        return Option::SOME(FmtFlagMatch { specIndex: index, consumed: 1 });
      }
    }

    index += 1;
  }

  return Option::NONE;
}

/// `clap` rejects a non-repeatable `fmt` flag given twice with `the
/// argument '<name>' cannot be used multiple times`, and it does so only
/// after matching the *entire* command line: a duplicate positioned after
/// an unrelated conflict (`--use-tabs --spaces --check --check`) is still
/// reported ahead of that conflict, and ahead of `--help`/`--version` too.
/// This scans the whole `fmt` argument list once, independently of
/// `parseArguments`'s own incremental loop, and returns the first
/// non-repeatable flag (its message-form text, e.g. `--project <PROJECT>`)
/// seen a second time — or `Option::NONE` if every flag present is either
/// repeatable or seen at most once.
function fmtFindFirstDuplicateFlag(arguments: &Vector<String>, startIndex: u64): Option<String> {
  let specs: Vector<FmtFlagSpec> = fmtFlagSpecTable();
  let mut seen: Vector<boolean> = Vector::new<boolean>();
  let mut seenInit: u64 = 0;

  while (seenInit < specs.length()) {
    seen.push(false);
    seenInit += 1;
  }

  let mut index: u64 = startIndex;

  while (index < arguments.length()) {
    let Option::SOME(argument) = arguments.get(index) else {
      break;
    };

    let Option::SOME(matched) = fmtMatchFlagSpec(&specs, argument) else {
      index += 1;
      continue;
    };

    let Option::SOME(spec) = specs.get(matched.specIndex) else {
      index += matched.consumed;
      continue;
    };

    if (!spec.repeatable) {
      let Option::SOME(alreadySeen) = seen.get(matched.specIndex) else {
        index += matched.consumed;
        continue;
      };

      if (*alreadySeen) {
        let mut subject: String = String::create(spec.name);
        subject.pushStr(spec.plainSuffix);
        return Option::SOME(subject);
      }

      seen.set(matched.specIndex, true);
    }

    index += matched.consumed;
  }

  return Option::NONE;
}

/// `clap` validates argument conflicts only after matching the entire
/// command line, so a flag or a `FILE_PATHS` value coming *after* the
/// argument that triggers a conflict still appears in that conflict's
/// `Usage:` line. This continues a read-only scan of `arguments` from
/// `fromIndex` (the token right after the conflicting argument and its own
/// value, if it takes one) purely to extend `state` with whatever `clap`
/// would still recognize there. It does not apply any flag's effect, and it
/// does not itself detect a second conflict or a missing value past this
/// point: the line is already failing on the first one, and `clap`'s exact
/// behavior for two independent failures on the same line is not this
/// function's concern.
function fmtScanRemainingUsageTokensForConflict(
  arguments: &Vector<String>,
  fromIndex: u64,
  state: &mut FmtFlagState
): void {
  let stateRef: &mut FmtFlagState = state;
  let specs: Vector<FmtFlagSpec> = fmtFlagSpecTable();
  let mut index: u64 = fromIndex;

  while (index < arguments.length()) {
    let Option::SOME(argument) = arguments.get(index) else {
      break;
    };

    if (let Option::SOME(matched) = fmtMatchFlagSpec(&specs, argument)) {
      if (let Option::SOME(spec) = specs.get(matched.specIndex)) {
        fmtFlagStateRecordToken(stateRef, spec.name, spec.plainSuffix);
      }

      index += matched.consumed;
      continue;
    }

    if (argument.startsWith("-")) {
      index += 1;
      continue;
    }

    stateRef.sawFilePath = true;
    index += 1;
  }
}

/// Reconstructs the exact `clap`-generated "used multiple times" error: a
/// generic `Usage: ignis fmt [OPTIONS] [FILE_PATHS]...` line, unlike a
/// conflict error's accumulated one, since `clap` reports this before ever
/// building a flag-specific usage summary. `subject` is the flag's own
/// message-form text (e.g. `--project <PROJECT>`), matching
/// `fmtFindFirstDuplicateFlag`'s return value.
function clapFmtDuplicateError(subject: &String): String {
  let mut message: String = String::new();

  message.pushChar(ansiEsc());
  message.pushStr("[1m");
  message.pushChar(ansiEsc());
  message.pushStr("[31merror:");
  message.pushChar(ansiEsc());
  message.pushStr("[0m the argument '");
  pushAnsiYellow(&mut message, subject.toStr());
  message.pushStr("' cannot be used multiple times\n\n");
  message.pushChar(ansiEsc());
  message.pushStr("[1m");
  message.pushChar(ansiEsc());
  message.pushStr("[4mUsage:");
  message.pushChar(ansiEsc());
  message.pushStr("[0m ");
  pushAnsiBold(&mut message, "ignis fmt");
  message.pushStr(" [OPTIONS] [FILE_PATHS]...");
  message.pushStr("\n\nFor more information, try '");
  pushAnsiBold(&mut message, "--help");
  message.pushStr("'.");
  return message;
}

/// Reconstructs the exact `clap`-generated conflict error the host CLI
/// prints. The host's `Cli` is `#[command(color = ColorChoice::Always)]`, so
/// this always carries ANSI codes, checked byte-for-byte against the host
/// binary, even though nothing here runs in a TTY.
///
/// `clap` names whichever argument was already present when the conflicting
/// one was parsed as the "subject" (`subject` here); the other argument
/// (`other`) is the one that triggered the conflict. The `Usage:` line lists
/// every flag `clap` matched on the whole command line (in match order,
/// each bolded, with any value placeholder plain), the rejected argument
/// excluded, followed by the `FILE_PATHS` positional placeholder (always
/// last, `state.sawFilePath` choosing its brackets).
function clapFmtConflictError(subject: str, other: str, state: &mut FmtFlagState): String {
  let mut message: String = String::new();

  message.pushChar(ansiEsc());
  message.pushStr("[1m");
  message.pushChar(ansiEsc());
  message.pushStr("[31merror:");
  message.pushChar(ansiEsc());
  message.pushStr("[0m the argument '");
  pushAnsiYellow(&mut message, subject);
  message.pushStr("' cannot be used with '");
  pushAnsiYellow(&mut message, other);
  message.pushStr("'\n\n");
  message.pushChar(ansiEsc());
  message.pushStr("[1m");
  message.pushChar(ansiEsc());
  message.pushStr("[4mUsage:");
  message.pushChar(ansiEsc());
  message.pushStr("[0m ");
  pushAnsiBold(&mut message, "ignis fmt");

  let mut tokenIndex: u64 = 0;

  while (tokenIndex < state.usageTokens.length()) {
    if (let Option::SOME(token) = state.usageTokens.get(tokenIndex)) {
      message.pushStr(" ");
      pushAnsiBold(&mut message, token.boldPart);
      message.pushStr(token.plainSuffix);
    }

    tokenIndex += 1;
  }

  message.pushStr(" ");

  if (state.sawFilePath) {
    message.pushStr("<FILE_PATHS>...");
  } else {
    message.pushStr("[FILE_PATHS]...");
  }

  message.pushStr("\n\nFor more information, try '");
  pushAnsiBold(&mut message, "--help");
  message.pushStr("'.");
  return message;
}

/// If `argument` is exactly `flagName` followed by `=` and a (possibly
/// empty) value, returns that value: the `--flag=value` form editors build
/// argv with, which `clap` accepts for every value-taking flag alongside
/// the two-token `--flag value` form.
function flagEqualsValue(argument: &String, flagName: str): Option<String> {
  if (!argument.startsWith(flagName)) {
    return Option::NONE;
  }

  let flagNameText: String = String::create(flagName);
  let prefixLength: u64 = flagNameText.length();

  let Option::SOME(afterPrefix) = argument.byteAt(prefixLength) else {
    return Option::NONE;
  };

  if (afterPrefix != '=' as u8) {
    return Option::NONE;
  }

  return Option::SOME(argument.substringBytes(prefixLength + 1, argument.length()));
}

/// Applies `--emit`'s comma-separated mode list to `options`. An empty
/// value (`--emit=`) enables nothing, matching the host.
function applyFmtEmitModes(options: &mut CliOptions, value: &String): void {
  let mut optionsRef: &mut CliOptions = options;
  let modes: Vector<String> = splitCommaSeparated(value);
  let mut modeIndex: u64 = 0;

  while (modeIndex < modes.length()) {
    if (let Option::SOME(mode) = modes.get(modeIndex) && mode.equals("diff")) {
      optionsRef.fmtEmitDiff = true;
    }

    modeIndex += 1;
  }
}

/// `--project`/`--project=<dir>`, including its conflict with `--stdin-json`.
function tryParseFmtProjectFlag(
  arguments: &Vector<String>,
  argument: &String,
  index: u64,
  options: &mut CliOptions,
  state: &mut FmtFlagState
): Result<Option<u64>, String> {
  let mut optionsRef: &mut CliOptions = options;
  let stateRef: &mut FmtFlagState = state;
  let projectEqualsValue: Option<String> = flagEqualsValue(argument, "--project");
  let isProjectFlag: boolean = argument.equals("--project") || projectEqualsValue.isSome();

  if (!isProjectFlag) {
    return Result::OK(Option::NONE);
  }

  if (optionsRef.fmtStdinJson) {
    let projectArity: u64 = projectEqualsValue.isSome() ? 1 : 2;
    fmtScanRemainingUsageTokensForConflict(arguments, index + projectArity, stateRef);
    return Result::ERROR(clapFmtConflictError("--stdin-json", "--project <PROJECT>", stateRef));
  }

  fmtFlagStateRecordToken(stateRef, "--project", " <PROJECT>");

  if (let Option::SOME(equalsValue) = flagEqualsValue(argument, "--project")) {
    optionsRef.fmtProject = Option::SOME(equalsValue);
    return Result::OK(Option::SOME(index + 1));
  }

  let Option::SOME(value) = arguments.get(index + 1) else {
    return Result::ERROR(cliMissingValue("--project", "a directory"));
  };

  optionsRef.fmtProject = Option::SOME(value.clone());
  return Result::OK(Option::SOME(index + 2));
}

/// `--check` and `--config`/`--config=<file>`.
function tryParseFmtCheckOrConfigFlag(
  arguments: &Vector<String>,
  argument: &String,
  index: u64,
  options: &mut CliOptions,
  state: &mut FmtFlagState
): Result<Option<u64>, String> {
  let mut optionsRef: &mut CliOptions = options;
  let stateRef: &mut FmtFlagState = state;

  if (argument.equals("--check")) {
    optionsRef.fmtCheck = true;
    fmtFlagStateRecordToken(stateRef, "--check", "");
    return Result::OK(Option::SOME(index + 1));
  }

  if (let Option::SOME(equalsValue) = flagEqualsValue(argument, "--config")) {
    optionsRef.fmtConfigPath = Option::SOME(equalsValue);
    fmtFlagStateRecordToken(stateRef, "--config", " <CONFIG>");
    return Result::OK(Option::SOME(index + 1));
  }

  if (argument.equals("--config")) {
    let Option::SOME(value) = arguments.get(index + 1) else {
      return Result::ERROR(cliMissingValue("--config", "a file"));
    };

    optionsRef.fmtConfigPath = Option::SOME(value.clone());
    fmtFlagStateRecordToken(stateRef, "--config", " <CONFIG>");
    return Result::OK(Option::SOME(index + 2));
  }

  return Result::OK(Option::NONE);
}

/// `--indent-width`/`--indent-width=<n>` and `--line-width`/`--line-width=<n>`.
function tryParseFmtWidthFlag(
  arguments: &Vector<String>,
  argument: &String,
  index: u64,
  options: &mut CliOptions,
  state: &mut FmtFlagState
): Result<Option<u64>, String> {
  let mut optionsRef: &mut CliOptions = options;
  let stateRef: &mut FmtFlagState = state;

  if (let Option::SOME(equalsValue) = flagEqualsValue(argument, "--indent-width")) {
    if (equalsValue.length() == 0) {
      return Result::ERROR(clapEmptyIntegerValueError("--indent-width <INDENT_WIDTH>"));
    }

    let Option::SOME(width) = parseDecimal(&equalsValue) else {
      return Result::ERROR(`error: invalid indent width: ${equalsValue.toStr()}`);
    };

    optionsRef.fmtIndentWidth = Option::SOME(width);
    fmtFlagStateRecordToken(stateRef, "--indent-width", " <INDENT_WIDTH>");
    return Result::OK(Option::SOME(index + 1));
  }

  if (argument.equals("--indent-width")) {
    let Option::SOME(value) = arguments.get(index + 1) else {
      return Result::ERROR(cliMissingValue("--indent-width", "a number"));
    };

    let Option::SOME(width) = parseDecimal(value) else {
      return Result::ERROR(`error: invalid indent width: ${value.toStr()}`);
    };

    optionsRef.fmtIndentWidth = Option::SOME(width);
    fmtFlagStateRecordToken(stateRef, "--indent-width", " <INDENT_WIDTH>");
    return Result::OK(Option::SOME(index + 2));
  }

  if (let Option::SOME(equalsValue) = flagEqualsValue(argument, "--line-width")) {
    if (equalsValue.length() == 0) {
      return Result::ERROR(clapEmptyIntegerValueError("--line-width <LINE_WIDTH>"));
    }

    let Option::SOME(width) = parseDecimal(&equalsValue) else {
      return Result::ERROR(`error: invalid line width: ${equalsValue.toStr()}`);
    };

    optionsRef.fmtLineWidth = Option::SOME(width);
    fmtFlagStateRecordToken(stateRef, "--line-width", " <LINE_WIDTH>");
    return Result::OK(Option::SOME(index + 1));
  }

  if (argument.equals("--line-width")) {
    let Option::SOME(value) = arguments.get(index + 1) else {
      return Result::ERROR(cliMissingValue("--line-width", "a number"));
    };

    let Option::SOME(width) = parseDecimal(value) else {
      return Result::ERROR(`error: invalid line width: ${value.toStr()}`);
    };

    optionsRef.fmtLineWidth = Option::SOME(width);
    fmtFlagStateRecordToken(stateRef, "--line-width", " <LINE_WIDTH>");
    return Result::OK(Option::SOME(index + 2));
  }

  return Result::OK(Option::NONE);
}

/// `--use-tabs`/`--spaces` (mutually exclusive, tracked in `state`) and the
/// plain boolean `--sort-imports`.
function tryParseFmtStyleFlag(
  arguments: &Vector<String>,
  argument: &String,
  index: u64,
  options: &mut CliOptions,
  state: &mut FmtFlagState
): Result<Option<u64>, String> {
  let mut optionsRef: &mut CliOptions = options;
  let mut stateRef: &mut FmtFlagState = state;

  if (argument.equals("--use-tabs")) {
    if (stateRef.spacesSeen) {
      fmtScanRemainingUsageTokensForConflict(arguments, index + 1, stateRef);
      return Result::ERROR(clapFmtConflictError("--spaces", "--use-tabs", stateRef));
    }

    stateRef.useTabsSeen = true;
    optionsRef.fmtUseTabs = Option::SOME(true);
    fmtFlagStateRecordToken(stateRef, "--use-tabs", "");
    return Result::OK(Option::SOME(index + 1));
  }

  if (argument.equals("--spaces")) {
    if (stateRef.useTabsSeen) {
      fmtScanRemainingUsageTokensForConflict(arguments, index + 1, stateRef);
      return Result::ERROR(clapFmtConflictError("--use-tabs", "--spaces", stateRef));
    }

    stateRef.spacesSeen = true;
    optionsRef.fmtUseTabs = Option::SOME(false);
    fmtFlagStateRecordToken(stateRef, "--spaces", "");
    return Result::OK(Option::SOME(index + 1));
  }

  if (argument.equals("--sort-imports")) {
    optionsRef.fmtSortImports = true;
    fmtFlagStateRecordToken(stateRef, "--sort-imports", "");
    return Result::OK(Option::SOME(index + 1));
  }

  return Result::OK(Option::NONE);
}

/// `--stdin-json`, including its conflicts with `--project` and explicit
/// file paths.
function tryParseFmtStdinJsonFlag(
  arguments: &Vector<String>,
  argument: &String,
  index: u64,
  options: &mut CliOptions,
  state: &mut FmtFlagState
): Result<Option<u64>, String> {
  let mut optionsRef: &mut CliOptions = options;
  let stateRef: &mut FmtFlagState = state;

  if (!argument.equals("--stdin-json")) {
    return Result::OK(Option::NONE);
  }

  if (let Option::SOME(_) = &optionsRef.fmtProject) {
    fmtScanRemainingUsageTokensForConflict(arguments, index + 1, stateRef);
    return Result::ERROR(clapFmtConflictError("--project <PROJECT>", "--stdin-json", stateRef));
  }

  if (optionsRef.fmtFilePaths.length() > 0) {
    fmtScanRemainingUsageTokensForConflict(arguments, index + 1, stateRef);
    return Result::ERROR(clapFmtConflictError("[FILE_PATHS]...", "--stdin-json", stateRef));
  }

  fmtFlagStateRecordToken(stateRef, "--stdin-json", "");
  optionsRef.fmtStdinJson = true;
  return Result::OK(Option::SOME(index + 1));
}

/// `--emit`/`--emit=<modes>`.
function tryParseFmtEmitFlag(
  arguments: &Vector<String>,
  argument: &String,
  index: u64,
  options: &mut CliOptions,
  state: &mut FmtFlagState
): Result<Option<u64>, String> {
  let optionsRef: &mut CliOptions = options;
  let stateRef: &mut FmtFlagState = state;

  if (let Option::SOME(equalsValue) = flagEqualsValue(argument, "--emit")) {
    applyFmtEmitModes(optionsRef, &equalsValue);
    fmtFlagStateRecordToken(stateRef, "--emit", " <EMIT>");
    return Result::OK(Option::SOME(index + 1));
  }

  if (argument.equals("--emit")) {
    let Option::SOME(value) = arguments.get(index + 1) else {
      return Result::ERROR(cliMissingValue("--emit", "a mode"));
    };

    applyFmtEmitModes(optionsRef, value);
    fmtFlagStateRecordToken(stateRef, "--emit", " <EMIT>");
    return Result::OK(Option::SOME(index + 2));
  }

  return Result::OK(Option::NONE);
}

/// Handles one `fmt`-only flag during `parseArguments`'s scan. `Ok(Some(i))`
/// means `argument` was one of these flags and parsing resumes at index `i`;
/// `Ok(None)` means it was not, so the caller keeps trying other cases.
/// Split out of `parseArguments` itself, which was long enough on its own to
/// make the `fmt`-specific cases hard to see among the rest.
function tryParseFmtFlag(
  arguments: &Vector<String>,
  argument: &String,
  index: u64,
  options: &mut CliOptions,
  state: &mut FmtFlagState
): Result<Option<u64>, String> {
  match (tryParseFmtProjectFlag(arguments, argument, index, options, state)) {
    Result::ERROR(message) -> {
      return Result::ERROR(message);
    },
    Result::OK(handled) -> {
      if (let Option::SOME(_) = handled) {
        return Result::OK(handled);
      }
    },
  };

  match (tryParseFmtCheckOrConfigFlag(arguments, argument, index, options, state)) {
    Result::ERROR(message) -> {
      return Result::ERROR(message);
    },
    Result::OK(handled) -> {
      if (let Option::SOME(_) = handled) {
        return Result::OK(handled);
      }
    },
  };

  match (tryParseFmtWidthFlag(arguments, argument, index, options, state)) {
    Result::ERROR(message) -> {
      return Result::ERROR(message);
    },
    Result::OK(handled) -> {
      if (let Option::SOME(_) = handled) {
        return Result::OK(handled);
      }
    },
  };

  match (tryParseFmtStyleFlag(arguments, argument, index, options, state)) {
    Result::ERROR(message) -> {
      return Result::ERROR(message);
    },
    Result::OK(handled) -> {
      if (let Option::SOME(_) = handled) {
        return Result::OK(handled);
      }
    },
  };

  match (tryParseFmtStdinJsonFlag(arguments, argument, index, options, state)) {
    Result::ERROR(message) -> {
      return Result::ERROR(message);
    },
    Result::OK(handled) -> {
      if (let Option::SOME(_) = handled) {
        return Result::OK(handled);
      }
    },
  };

  return tryParseFmtEmitFlag(arguments, argument, index, options, state);
}

/// Parses a command line into the options every subcommand reads.
///
/// `arguments` is the process argument vector, so the first entry is the
/// program name. The error is the message to print before exiting with 2.
export function parseArguments(arguments: &Vector<String>): Result<CliOptions, String> {
  let mut command: CliCommand = CliCommand::BUILD;
  let mut index: u64 = 1;

  if (let Option::SOME(first) = arguments.get(1)) {
    if (let Option::SOME(subcommand) = cliSubcommandOf(first)) {
      command = subcommand;
      index = 2;
    } else if (!first.startsWith("-") && !cliLooksLikePath(first)) {
      return Result::ERROR(`error: unrecognized subcommand '${first.toStr()}'`);
    }
  }

  if (let CliCommand::FMT = command) {
    if (let Option::SOME(subject) = fmtFindFirstDuplicateFlag(arguments, index)) {
      return Result::ERROR(clapFmtDuplicateError(&subject));
    }
  }

  let mut options: CliOptions = CliOptions::create(command);
  let mut fmtFlagState: FmtFlagState = FmtFlagState {
    useTabsSeen: false,
    spacesSeen: false,
    usageTokens: Vector::new<FmtUsageToken>(),
    sawFilePath: false,
  };

  while (index < arguments.length()) {
    let Option::SOME(argument) = arguments.get(index) else {
      break;
    };

    if (argument.equals("-h") || argument.equals("--help")) {
      options.command = CliCommand::HELP;
      return Result::OK(options);
    }

    if (argument.equals("-V") || argument.equals("--version")) {
      options.command = CliCommand::VERSION;
      return Result::OK(options);
    }

    if (argument.equals("-o")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("-o", "an output path"));
      };

      options.outputPath = Option::SOME(value.clone());
      index += 2;
      continue;
    }

    if (argument.equals("--out-dir")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--out-dir", "a directory"));
      };

      options.outDir = Option::SOME(value.clone());
      index += 2;
      continue;
    }

    if (argument.equals("--std-path")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--std-path", "a directory"));
      };

      options.stdPath = Option::SOME(value.clone());
      index += 2;
      continue;
    }

    if (argument.equals("--cc")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--cc", "a C compiler"));
      };

      options.cc = Option::SOME(value.clone());
      index += 2;
      continue;
    }

    if (argument.equals("--target-triple")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--target-triple", "a target triple"));
      };

      options.targetTriple = Option::SOME(value.clone());
      index += 2;
      continue;
    }

    if (argument.equals("-O") || argument.equals("--opt-level")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(String::create("error: --opt-level requires a level between 0 and 3"));
      };

      let Option::SOME(level) = parseOptLevelArgument(value) else {
        return Result::ERROR(`error: invalid optimization level: ${value.toStr()}`);
      };

      options.optLevel = Option::SOME(level);
      index += 2;
      continue;
    }

    if (argument.equals("--debug")) {
      options.debug = Option::SOME(true);
      index += 1;
      continue;
    }

    if (argument.equals("--no-debug")) {
      options.debug = Option::SOME(false);
      index += 1;
      continue;
    }

    if (argument.equals("--feature")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--feature", "a name"));
      };

      options.features.push(value.clone());
      index += 2;
      continue;
    }

    if (argument.equals("--features")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--features", "a comma-separated list"));
      };

      let parsed: Vector<String> = splitCommaSeparated(value);
      let mut parsedIndex: u64 = 0;

      while (parsedIndex < parsed.length()) {
        if (let Option::SOME(feature) = parsed.get(parsedIndex)) {
          options.features.push(feature.clone());
        }

        parsedIndex += 1;
      }

      index += 2;
      continue;
    }

    if (options.isTestMode() && argument.equals("--filter")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--filter", "a substring"));
      };

      options.filter = value.clone();
      index += 2;
      continue;
    }

    if (options.isTestMode() && argument.equals("--update-snapshots")) {
      options.updateSnapshots = true;
      index += 1;
      continue;
    }

    if (options.isTestMode() && argument.equals("--fixtures")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--fixtures", "a directory"));
      };

      options.fixtureDirs.push(value.clone());
      index += 2;
      continue;
    }

    if (options.isTestMode() && argument.equals("--partition")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--partition", "a shard written as k/n"));
      };

      match (parsePartitionSpec(value)) {
        Result::OK(spec) -> options.partition = Option::SOME(spec),
        Result::ERROR(message) -> {
          return Result::ERROR(message);
        },
      };

      index += 2;
      continue;
    }

    if (options.isTestMode() && argument.equals("--test-timeout")) {
      let Option::SOME(value) = arguments.get(index + 1) else {
        return Result::ERROR(cliMissingValue("--test-timeout", "a number of seconds"));
      };

      let Option::SOME(seconds) = parseDecimal(value) else {
        return Result::ERROR(`error: invalid test timeout: ${value.toStr()}`);
      };

      options.testTimeout = Option::SOME(seconds);
      index += 2;
      continue;
    }

    if (options.isFmtMode()) {
      match (tryParseFmtFlag(arguments, argument, index, &mut options, &mut fmtFlagState)) {
        Result::ERROR(message) -> {
          return Result::ERROR(message);
        },
        Result::OK(handled) -> {
          if (let Option::SOME(newIndex) = handled) {
            index = newIndex;
            continue;
          }
        },
      };
    }

    if (argument.startsWith("-")) {
      return Result::ERROR(`error: unknown argument: ${argument.toStr()}`);
    }

    if (options.isFmtMode()) {
      if (options.fmtStdinJson) {
        fmtScanRemainingUsageTokensForConflict(arguments, index + 1, &mut fmtFlagState);
        return Result::ERROR(clapFmtConflictError("--stdin-json", "[FILE_PATHS]...", &mut fmtFlagState));
      }

      options.fmtFilePaths.push(argument.clone());
      fmtFlagState.sawFilePath = true;
      index += 1;
      continue;
    }

    options.path = Option::SOME(argument.clone());
    index += 1;
  }

  return Result::OK(options);
}

/// The text `--help` prints, listing what this compiler answers today.
export function helpText(): String {
  let mut text: String = String::new();
  text.pushStr("The Ignis compiler\n");
  text.pushStr("\n");
  text.pushStr("Usage: ignis [COMMAND] [OPTIONS] [PATH]\n");
  text.pushStr("\n");
  text.pushStr("Commands:\n");
  text.pushStr("  build      Build file or project\n");
  text.pushStr("  check      Check file or project without codegen or linking\n");
  text.pushStr("  build-std  Build the standard library\n");
  text.pushStr("  test       Run language-native tests for a project\n");
  text.pushStr("  fmt        Format Ignis source canonically with parse/reparse safety checks\n");
  text.pushStr("\n");
  text.pushStr("Without a command the path is built, which is what `ignis build <path>` does.\n");
  text.pushStr("Without a path the project containing the current directory is used.\n");
  text.pushStr("\n");
  text.pushStr("Options:\n");
  text.pushStr("  -o <PATH>                 Write the linked binary here, or the directory build-std fills\n");
  text.pushStr("      --out-dir <DIR>       Override [build] out_dir\n");
  text.pushStr("      --std-path <DIR>      Override the standard library root\n");
  text.pushStr("      --cc <CC>             Override [build] cc\n");
  text.pushStr("      --target-triple <T>   Override the target triple directives are answered with\n");
  text.pushStr("  -O, --opt-level <0-3>     Override [build] opt_level\n");
  text.pushStr("      --debug               Build with debug information\n");
  text.pushStr("      --no-debug            Build without debug information\n");
  text.pushStr("      --feature <NAME>      Enable one feature (can be repeated)\n");
  text.pushStr("      --features <LIST>     Enable features separated by commas\n");
  text.pushStr("      --filter <SUBSTRING>  Select tests whose name contains it (test only)\n");
  text.pushStr("      --update-snapshots    Create or replace selected snapshots (test only)\n");
  text.pushStr("      --fixtures <DIR>      Add a directory of program fixture cases (test only)\n");
  text.pushStr("      --partition <K/N>     Run only shard K of N, 1-based (test only)\n");
  text.pushStr("      --test-timeout <SECS> Wall-clock budget for one test process (test only)\n");
  text.pushStr("      --project <DIR>       Explicit project directory (fmt only)\n");
  text.pushStr("      --check               Validate formatting without rewriting files (fmt only)\n");
  text.pushStr("      --config <FILE>       Explicit formatter config file (fmt only)\n");
  text.pushStr("      --indent-width <N>    Override formatter indentation width (fmt only)\n");
  text.pushStr("      --line-width <N>      Override formatter line width (fmt only)\n");
  text.pushStr("      --use-tabs            Override formatter indentation to use tabs (fmt only)\n");
  text.pushStr("      --spaces              Override formatter indentation to use spaces (fmt only)\n");
  text.pushStr("      --sort-imports        Enable import sorting (fmt only)\n");
  text.pushStr("      --stdin-json          Read an NDJSON batch from stdin (fmt only)\n");
  text.pushStr("      --emit <MODE>         Emit mode: diff previews without rewriting (fmt only)\n");
  text.pushStr("  -h, --help                Print this message\n");
  text.pushStr("  -V, --version             Print the compiler version\n");
  return text;
}

/// The text `--version` prints.
export function versionText(): String {
  let mut text: String = String::create("ignis ");
  text.pushStr(IGNIS_VERSION);
  return text;
}
function cliArguments(values: &Vector<String>): Vector<String> {
  let mut arguments: Vector<String> = Vector::new<String>();
  arguments.push(String::create("ignis"));

  let mut index: u64 = 0;

  while (index < values.length()) {
    let Option::SOME(value) = values.get(index) else {
      break;
    };

    arguments.push(value.clone());
    index += 1;
  }

  return arguments;
}

function cliParse(values: &Vector<String>): CliOptions {
  let arguments: Vector<String> = cliArguments(values);

  let Result::OK(options) = parseArguments(&arguments) else {
    Test::fail();
    return CliOptions::create(CliCommand::HELP);
  };

  return options;
}

function cliParseError(values: &Vector<String>): String {
  let arguments: Vector<String> = cliArguments(values);

  let Result::ERROR(message) = parseArguments(&arguments) else {
    Test::fail();
    return String::new();
  };

  return message;
}

function cliCommandName(command: CliCommand): str {
  return match (command) {
    CliCommand::BUILD -> "build",
    CliCommand::CHECK -> "check",
    CliCommand::BUILD_STD -> "build-std",
    CliCommand::TEST -> "test",
    CliCommand::FMT -> "fmt",
    CliCommand::HELP -> "help",
    CliCommand::VERSION -> "version",
  };
}

function cliOptionText(value: &Option<String>): String {
  return match (value) {
    Option::SOME(text) -> text.clone(),
    Option::NONE -> String::new(),
  };
}

function cliPathText(options: &CliOptions): String {
  return cliOptionText(&options.path);
}

/// Builds a test's argument vector out of the words a command line carries.
function cliWords(): Vector<String> {
  return Vector::new<String>();
}

function cliPush(arguments: &mut Vector<String>, value: str): void {
  let mut target: &mut Vector<String> = arguments;
  target.push(String::create(value));
}

/// No arguments at all selects a project build of the current directory.
@test
function cliDefaultsToBuildingTheCurrentProject(): void {
  let arguments: Vector<String> = cliWords();
  let options: CliOptions = cliParse(&arguments);

  Test::assertEq<str>(cliCommandName(options.command), "build");
  Test::assertEq<str>(cliPathText(&options).toStr(), "");
}

/// The bare form the bootstrap ladder calls stays a build of that file.
@test
function cliBareSourcePathBuildsThatFile(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "ignis/main.ign");
  cliPush(&mut arguments, "-o");
  cliPush(&mut arguments, "build/out/ignis");

  let options: CliOptions = cliParse(&arguments);

  Test::assertEq<str>(cliCommandName(options.command), "build");
  Test::assertEq<str>(cliPathText(&options).toStr(), "ignis/main.ign");
  Test::assertEq<str>(options.outputPathOr("selfhost_out").toStr(), "build/out/ignis");
}

/// Each subcommand is selected by name, with the path that follows it.
@test
function cliParsesEverySubcommand(): void {
  let mut buildArguments: Vector<String> = Vector::new<String>();
  cliPush(&mut buildArguments, "build");
  cliPush(&mut buildArguments, "example");
  Test::assertEq<str>(cliCommandName(cliParse(&buildArguments).command), "build");

  let mut checkArguments: Vector<String> = Vector::new<String>();
  cliPush(&mut checkArguments, "check");
  Test::assertEq<str>(cliCommandName(cliParse(&checkArguments).command), "check");

  let mut stdArguments: Vector<String> = Vector::new<String>();
  cliPush(&mut stdArguments, "build-std");
  Test::assertEq<str>(cliCommandName(cliParse(&stdArguments).command), "build-std");

  let mut testArguments: Vector<String> = Vector::new<String>();
  cliPush(&mut testArguments, "test");
  Test::assertEq<str>(cliCommandName(cliParse(&testArguments).command), "test");
}

/// A subcommand takes a project path the same way a build takes one.
@test
function cliSubcommandTakesAProjectPath(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "check");
  cliPush(&mut arguments, "example/demo");

  let options: CliOptions = cliParse(&arguments);

  Test::assertEq<str>(cliCommandName(options.command), "check");
  Test::assertEq<str>(cliPathText(&options).toStr(), "example/demo");
}

/// Every project-file override reaches the options a build reads.
@test
function cliParsesProjectOverrides(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "build");
  cliPush(&mut arguments, "--out-dir");
  cliPush(&mut arguments, "build/other");
  cliPush(&mut arguments, "--std-path");
  cliPush(&mut arguments, "./std");
  cliPush(&mut arguments, "--cc");
  cliPush(&mut arguments, "clang");
  cliPush(&mut arguments, "--target-triple");
  cliPush(&mut arguments, "x86_64-unknown-linux-gnu");
  cliPush(&mut arguments, "-O");
  cliPush(&mut arguments, "2");
  cliPush(&mut arguments, "--debug");
  cliPush(&mut arguments, "--features");
  cliPush(&mut arguments, "alpha,beta");
  cliPush(&mut arguments, "--feature");
  cliPush(&mut arguments, "gamma");

  let options: CliOptions = cliParse(&arguments);

  Test::assertEq<str>(cliOptionText(&options.outDir).toStr(), "build/other");
  Test::assertEq<str>(cliOptionText(&options.stdPath).toStr(), "./std");
  Test::assertEq<str>(cliOptionText(&options.cc).toStr(), "clang");
  Test::assertEq<str>(cliOptionText(&options.targetTriple).toStr(), "x86_64-unknown-linux-gnu");
  Test::assertEq<u64>(options.optLevel.unwrapOr(0), 2);
  Test::assertEq<boolean>(options.debug.unwrapOr(false), true);
  Test::assertEq<u64>(options.features.length(), 3);
}

/// `--no-debug` selects a build without debug information.
@test
function cliNoDebugOverridesTheProjectFile(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "build");
  cliPush(&mut arguments, "--no-debug");

  let options: CliOptions = cliParse(&arguments);

  Test::assertEq<boolean>(options.debug.unwrapOr(true), false);
}

/// The test flags are only read by a test run.
@test
function cliParsesTestFlags(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "test");
  cliPush(&mut arguments, "--filter");
  cliPush(&mut arguments, "resolver");
  cliPush(&mut arguments, "--update-snapshots");

  let options: CliOptions = cliParse(&arguments);

  Test::assertEq<str>(options.filter.toStr(), "resolver");
  Test::assertEq<boolean>(options.updateSnapshots, true);
}

/// A build has no `--filter`, so the flag is rejected instead of ignored.
/// The fixture, shard and timeout flags are only read by a test run.
@test
function cliParsesFixturePartitionAndTimeoutFlags(): void {
  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "test");
  cliPush(&mut values, "--fixtures");
  cliPush(&mut values, "test_cases/e2e/ok");
  cliPush(&mut values, "--partition");
  cliPush(&mut values, "2/4");
  cliPush(&mut values, "--test-timeout");
  cliPush(&mut values, "45");

  let options: CliOptions = cliParse(&values);

  Test::assertEq<u64>(options.fixtureDirs.length(), 1);

  let Option::SOME(fixtureDir) = options.fixtureDirs.get(0) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(fixtureDir.toStr(), "test_cases/e2e/ok");

  let Option::SOME(partition) = &options.partition else {
    Test::fail();
    return;
  };

  Test::assertEq<u64>(partition.index, 2);
  Test::assertEq<u64>(partition.count, 4);
  Test::assertEq<u64>(options.testTimeout.unwrapOr(0), 45);
}

@test
function cliLeavesFixturePartitionAndTimeoutUnsetByDefault(): void {
  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "test");

  let options: CliOptions = cliParse(&values);

  Test::assertEq<u64>(options.fixtureDirs.length(), 0);
  Test::assertEq<boolean>(options.partition.isNone(), true);
  Test::assertEq<u64>(options.testTimeout.unwrapOr(0), 0);
}

