  Test::assertEq<u64>(options.fmtIndentWidth.unwrapOr(0), 4);
  Test::assertEq<u64>(options.fmtLineWidth.unwrapOr(0), 120);
  Test::assertEq<boolean>(options.fmtUseTabs.unwrapOr(false), true);
  Test::assertEq<boolean>(options.fmtSortImports, true);
  Test::assertEq<str>(cliOptionText(&options.fmtConfigPath).toStr(), "ignisfmt.toml");
}

