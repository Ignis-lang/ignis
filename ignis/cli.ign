/// Strips `ESC [ ... <letter>` ANSI CSI sequences, keeping everything else
/// (including whitespace and layout) so a stripped conflict message still
/// reads the way the exact `clap`-generated text does, just without color.
/// Used only to assert wording; the full-fidelity match with the host,
/// escape codes included, is verified by running both binaries in the PR.
function stripAnsi(text: &String): String {
  let mut result: String = String::new();
  let mut index: u64 = 0;

  while (index < text.length()) {
    let Option::SOME(byte) = text.byteAt(index) else {
      break;
    };

    if (byte == 27) {
      index += 1;

      while (index < text.length()) {
        let Option::SOME(next) = text.byteAt(index) else {
          break;
        };

        index += 1;

        if ((next >= 'a' as u8 && next <= 'z' as u8) || (next >= 'A' as u8 && next <= 'Z' as u8)) {
          break;
        }
      }

      continue;
    }

    result.pushByte(byte);
    index += 1;
  }

  return result;
}

/// `--use-tabs` then `--spaces`: `clap` names whichever flag it saw first as
/// the subject. Matches the host's exact wording (color codes included,
/// verified by running the host binary on this exact command line).
@test
function cliRejectsUseTabsWithSpaces(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--use-tabs");
  cliPush(&mut arguments, "--spaces");
  cliPush(&mut arguments, "a.ign");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--use-tabs' cannot be used with '--spaces'\n\nUsage: ignis fmt --use-tabs <FILE_PATHS>...\n\nFor more information, try '--help'."
  );
}

/// The reverse order swaps which flag `clap` names as the subject.
@test
function cliRejectsSpacesWithUseTabs(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--spaces");
  cliPush(&mut arguments, "--use-tabs");
  cliPush(&mut arguments, "a.ign");

  let message: String = cliParseError(&arguments);

  Test::assertEq<str>(
    stripAnsi(&message).toStr(),
    "error: the argument '--spaces' cannot be used with '--use-tabs'\n\nUsage: ignis fmt --spaces <FILE_PATHS>...\n\nFor more information, try '--help'."
  );
}

/// `--stdin-json` before an explicit file: matches the host's exact wording.
@test
function cliRejectsStdinJsonWithAnExplicitFile(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "fmt");
  cliPush(&mut arguments, "--stdin-json");
