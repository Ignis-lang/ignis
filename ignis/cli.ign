  );
}

@test
function cliIsValidFeatureNameAcceptsAndRejects(): void {
  let simd: String = String::create("simd");
  let allocTrace: String = String::create("alloc-trace");
  let allocTraceUnderscore: String = String::create("alloc_trace");
  let versioned: String = String::create("v1.2");
  let empty: String = String::new();
  let comma: String = String::create("a,b");
  let equals: String = String::create("a=b");
  let space: String = String::create("a b");

  Test::assertEq<boolean>(cliIsValidFeatureName(&simd), true);
  Test::assertEq<boolean>(cliIsValidFeatureName(&allocTrace), true);
  Test::assertEq<boolean>(cliIsValidFeatureName(&allocTraceUnderscore), true);
  Test::assertEq<boolean>(cliIsValidFeatureName(&versioned), true);

  Test::assertEq<boolean>(cliIsValidFeatureName(&empty), false);
  Test::assertEq<boolean>(cliIsValidFeatureName(&comma), false);
  Test::assertEq<boolean>(cliIsValidFeatureName(&equals), false);
  Test::assertEq<boolean>(cliIsValidFeatureName(&space), false);
}

