  cliPush(&mut values, "test-std");
  cliPush(&mut values, "-o");
  cliPush(&mut values, "out");

  let options: CliOptions = cliParse(&values);
  Test::assertEq<str>(cliOptionText(&options.outDir).toStr(), "out");
  Test::assertEq<boolean>(options.outputPath.isNone(), true);
}

@test
function cliParsesTestStdWithoutAFilter(): void {
  let mut values: Vector<String> = cliWords();
  cliPush(&mut values, "test-std");

  let options: CliOptions = cliParse(&values);
  Test::assertEq<str>(cliCommandName(options.command), "test-std");
  Test::assertEq<str>(options.filter.toStr(), "");
  Test::assertEq<boolean>(options.updateSnapshots, false);
  Test::assertEq<boolean>(options.stdPath.isNone(), true);
  Test::assertEq<boolean>(options.outDir.isNone(), true);
  Test::assertEq<u64>(options.features.length(), 0);
}

/// `test-std` rejects the flags the host's `TestStdCommand` does not declare,
/// including `test`'s own `--filter` and the build overrides.
@test
function cliRejectsFlagsTestStdDoesNotTake(): void {
  let mut filterFlag: Vector<String> = cliWords();
  cliPush(&mut filterFlag, "test-std");
  cliPush(&mut filterFlag, "--filter");
  cliPush(&mut filterFlag, "time");
  Test::assertEq<str>(cliParseError(&filterFlag).toStr(), "error: unknown argument: --filter");

  let mut ccFlag: Vector<String> = cliWords();
  cliPush(&mut ccFlag, "test-std");
  cliPush(&mut ccFlag, "--cc");
  cliPush(&mut ccFlag, "clang");
  Test::assertEq<str>(cliParseError(&ccFlag).toStr(), "error: unknown argument: --cc");

  let mut forceFlag: Vector<String> = cliWords();
  cliPush(&mut forceFlag, "test-std");
  cliPush(&mut forceFlag, "-f");
  Test::assertEq<str>(cliParseError(&forceFlag).toStr(), "error: unknown argument: -f");
}

@test
function cliRejectsASecondTestStdFilter(): void {
  let mut values: Vector<String> = cliWords();
  cliPush(&mut values, "test-std");
  cliPush(&mut values, "time");
  cliPush(&mut values, "vector");
  Test::assertEq<str>(cliParseError(&values).toStr(), "error: unexpected argument 'vector'");
}

/// A build has no `--filter`, so the flag is rejected instead of ignored.
/// The fixture, shard and timeout flags are only read by a test run.
@test
function cliParsesFixturePartitionAndTimeoutFlags(): void {
  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "test");
  cliPush(&mut values, "--fixtures");
  cliPush(&mut values, "test_cases/e2e/ok");
  cliPush(&mut values, "--partition");
  cliPush(&mut values, "2/4");
  cliPush(&mut values, "--test-timeout");
  cliPush(&mut values, "45");

  let options: CliOptions = cliParse(&values);

  Test::assertEq<u64>(options.fixtureDirs.length(), 1);

  let Option::SOME(fixtureDir) = options.fixtureDirs.get(0) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(fixtureDir.toStr(), "test_cases/e2e/ok");

  let Option::SOME(partition) = &options.partition else {
    Test::fail();
    return;
  };

  Test::assertEq<u64>(partition.index, 2);
  Test::assertEq<u64>(partition.count, 4);
  Test::assertEq<u64>(options.testTimeout.unwrapOr(0), 45);
}

@test
function cliLeavesFixturePartitionAndTimeoutUnsetByDefault(): void {
  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "test");

  let options: CliOptions = cliParse(&values);

  Test::assertEq<u64>(options.fixtureDirs.length(), 0);
  Test::assertEq<boolean>(options.partition.isNone(), true);
  Test::assertEq<u64>(options.testTimeout.unwrapOr(0), 0);
}

@test
function cliRejectsAMalformedPartition(): void {
  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "test");
  cliPush(&mut values, "--partition");
  cliPush(&mut values, "half");

  Test::assertEq<str>(
    cliParseError(&values).toStr(),
    "Invalid partition 'half': expected the form k/n, for example 1/4",
  );
}

@test
function cliRejectsAPartitionOutsideItsCount(): void {
  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "test");
  cliPush(&mut values, "--partition");
  cliPush(&mut values, "5/4");

  Test::assertEq<str>(
    cliParseError(&values).toStr(),
    "Invalid partition '5/4': expected 1 <= k <= n with n >= 1",
  );
}

@test
function cliRejectsAZeroPartitionCount(): void {
  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "test");
  cliPush(&mut values, "--partition");
  cliPush(&mut values, "1/0");

  Test::assertEq<str>(
    cliParseError(&values).toStr(),
    "Invalid partition '1/0': expected 1 <= k <= n with n >= 1",
  );
}

@test
function cliRejectsFixtureFlagsOutsideTestMode(): void {
  let mut values: Vector<String> = Vector::new<String>();
  cliPush(&mut values, "build");
  cliPush(&mut values, "--partition");
  cliPush(&mut values, "1/2");

  Test::assertEq<str>(cliParseError(&values).toStr(), "error: unknown argument: --partition");
}

@test
function cliRejectsTestFlagsOutsideTestMode(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "build");
  cliPush(&mut arguments, "--filter");
  cliPush(&mut arguments, "resolver");

  Test::assertEq<str>(cliParseError(&arguments).toStr(), "error: unknown argument: --filter");
}

/// A flag this compiler does not answer is an error, not a path.
@test
function cliRejectsUnknownFlags(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "--nope");

  Test::assertEq<str>(cliParseError(&arguments).toStr(), "error: unknown argument: --nope");
}

/// `-f` and its aliases bypass the build cache on every command that writes
/// artifacts the cache guards.
@test
function cliForceFlagAndItsAliasesSelectARebuild(): void {
  let mut shortFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut shortFlag, "build");
  cliPush(&mut shortFlag, "-f");
  Test::assertEq<boolean>(cliParse(&shortFlag).force, true);

  let mut longFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut longFlag, "build");
  cliPush(&mut longFlag, "--force");
  Test::assertEq<boolean>(cliParse(&longFlag).force, true);

  let mut aliasFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut aliasFlag, "build");
  cliPush(&mut aliasFlag, "--rebuild");
  Test::assertEq<boolean>(cliParse(&aliasFlag).force, true);

  let mut standardLibrary: Vector<String> = Vector::new<String>();
  cliPush(&mut standardLibrary, "build-std");
  cliPush(&mut standardLibrary, "--force");
  Test::assertEq<boolean>(cliParse(&standardLibrary).force, true);

  let mut testRun: Vector<String> = Vector::new<String>();
  cliPush(&mut testRun, "test");
  cliPush(&mut testRun, "-f");
  Test::assertEq<boolean>(cliParse(&testRun).force, true);
}

/// `-v` and `--verbose` turn on the phase lines for every command that runs the
/// compiler pipeline, and leave the default summary-only output otherwise.
@test
function cliVerboseFlagSelectsPhaseLines(): void {
  let mut quietBuild: Vector<String> = Vector::new<String>();
  cliPush(&mut quietBuild, "build");
  Test::assertEq<boolean>(cliParse(&quietBuild).verbose, false);

  let mut shortFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut shortFlag, "build");
  cliPush(&mut shortFlag, "-v");
  Test::assertEq<boolean>(cliParse(&shortFlag).verbose, true);

  let mut longFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut longFlag, "check");
  cliPush(&mut longFlag, "--verbose");
  Test::assertEq<boolean>(cliParse(&longFlag).verbose, true);

  let mut standardLibrary: Vector<String> = Vector::new<String>();
  cliPush(&mut standardLibrary, "check-std");
  cliPush(&mut standardLibrary, "-v");
  Test::assertEq<boolean>(cliParse(&standardLibrary).verbose, true);

  let mut stdTests: Vector<String> = Vector::new<String>();
  cliPush(&mut stdTests, "test-std");
  cliPush(&mut stdTests, "--verbose");
  Test::assertEq<boolean>(cliParse(&stdTests).verbose, true);

  let mut testRun: Vector<String> = Vector::new<String>();
  cliPush(&mut testRun, "test");
  cliPush(&mut testRun, "-v");
  Test::assertEq<boolean>(cliParse(&testRun).verbose, true);
}

/// `--progress` picks the live line's mode for the commands that run the
/// compiler pipeline, in both spellings, and defaults to `auto`.
@test
function cliProgressFlagSelectsMode(): void {
  let mut defaultBuild: Vector<String> = Vector::new<String>();
  cliPush(&mut defaultBuild, "build");
  let defaultOptions: CliOptions = cliParse(&defaultBuild);
  Test::assertEq<str>(cliProgressName(&defaultOptions), "auto");

  let mut separateValue: Vector<String> = Vector::new<String>();
  cliPush(&mut separateValue, "check");
  cliPush(&mut separateValue, "--progress");
  cliPush(&mut separateValue, "plain");
  let separateOptions: CliOptions = cliParse(&separateValue);
  Test::assertEq<str>(cliProgressName(&separateOptions), "plain");

  let mut attachedValue: Vector<String> = Vector::new<String>();
  cliPush(&mut attachedValue, "test");
  cliPush(&mut attachedValue, "--progress=live");
  let attachedOptions: CliOptions = cliParse(&attachedValue);
  Test::assertEq<str>(cliProgressName(&attachedOptions), "live");

  let mut stdTests: Vector<String> = Vector::new<String>();
  cliPush(&mut stdTests, "test-std");
  cliPush(&mut stdTests, "--progress=plain");
  let stdTestOptions: CliOptions = cliParse(&stdTests);
  Test::assertEq<str>(cliProgressName(&stdTestOptions), "plain");
}

/// An unknown `--progress` mode or a missing one is an error, and the flag
/// means nothing to the commands that do not run the compiler pipeline.
@test
function cliRejectsInvalidProgressFlags(): void {
  let mut unknownMode: Vector<String> = Vector::new<String>();
  cliPush(&mut unknownMode, "build");
  cliPush(&mut unknownMode, "--progress=fancy");
  Test::assertEq<str>(cliParseError(&unknownMode).toStr(), "error: invalid progress mode 'fancy': expected auto, live or plain");

  let mut missingMode: Vector<String> = Vector::new<String>();
  cliPush(&mut missingMode, "build");
  cliPush(&mut missingMode, "--progress");
  Test::assertEq<str>(cliParseError(&missingMode).toStr(), "error: --progress requires auto, live or plain");

  let mut fmtFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut fmtFlag, "fmt");
  cliPush(&mut fmtFlag, "--progress=plain");
  Test::assertEq<str>(cliParseError(&fmtFlag).toStr(), "error: unknown argument: --progress=plain");
}

function cliProgressName(options: &CliOptions): str {
  return match (options.progress) {
    Output::ProgressMode::AUTO -> "auto",
    Output::ProgressMode::LIVE -> "live",
    Output::ProgressMode::PLAIN -> "plain",
  };
}

/// `-v` keeps meaning nothing to the commands that do not run the compiler
/// pipeline, and `-V` stays the version flag.
@test
function cliRejectsVerboseFlagOutsideCompilerCommands(): void {
  let mut fmtFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut fmtFlag, "fmt");
  cliPush(&mut fmtFlag, "--verbose");
  Test::assertEq<str>(cliParseError(&fmtFlag).toStr(), "error: unknown argument: --verbose");

  let mut versionFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut versionFlag, "-V");
  Test::assertEq<boolean>(cliParse(&versionFlag).verbose, false);
}

/// `check` emits, compiles and links nothing, so it has no cached artifacts a
/// rebuild could bypass and rejects the flag the way the host CLI does.
@test
function cliRejectsForceFlagOnCheck(): void {
  let mut checkFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut checkFlag, "check");
  cliPush(&mut checkFlag, "-f");
  Test::assertEq<str>(cliParseError(&checkFlag).toStr(), "error: unknown argument: -f");

  let mut fmtFlag: Vector<String> = Vector::new<String>();
  cliPush(&mut fmtFlag, "fmt");
  cliPush(&mut fmtFlag, "--force");
  Test::assertEq<str>(cliParseError(&fmtFlag).toStr(), "error: unknown argument: --force");
}

/// A first argument that is neither a subcommand nor a path is a typo.
@test
function cliRejectsUnknownSubcommands(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "buld");

  Test::assertEq<str>(cliParseError(&arguments).toStr(), "error: unrecognized subcommand 'buld'");
}

/// A flag whose value is missing is an error rather than a silent default.
@test
function cliRejectsFlagsMissingTheirValue(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "build");
  cliPush(&mut arguments, "--out-dir");

  Test::assertEq<str>(cliParseError(&arguments).toStr(), "error: --out-dir requires a directory");
}

/// An optimization level the C toolchain would not accept is rejected.
@test
function cliRejectsInvalidOptimizationLevels(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "build");
  cliPush(&mut arguments, "-O");
  cliPush(&mut arguments, "9");

  Test::assertEq<str>(cliParseError(&arguments).toStr(), "error: invalid optimization level: 9");
}

/// A `,` in a `--feature` name is rejected: it collides with the delimiter
/// the build fingerprint's stamp format uses to join the enabled set, which
/// would let an archive built for the single feature "a,b" be reused for
/// the set {a, b}.
@test
function cliRejectsAFeatureNameContainingAComma(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "build");
  cliPush(&mut arguments, "--feature");
  cliPush(&mut arguments, "a,b");

  Test::assertEq<str>(
    cliParseError(&arguments).toStr(),
    "error: invalid feature name 'a,b': feature names must be non-empty and contain only ASCII letters, digits, '_', '.' or '-'",
  );
}

/// Every comma-separated entry in `--features` is validated too, not just
/// the first.
@test
function cliRejectsAnInvalidNameInACommaSeparatedFeatureList(): void {
  let mut arguments: Vector<String> = Vector::new<String>();
  cliPush(&mut arguments, "build");
  cliPush(&mut arguments, "--features");
  cliPush(&mut arguments, "alpha,a=b");

  Test::assertEq<str>(
    cliParseError(&arguments).toStr(),
    "error: invalid feature name 'a=b': feature names must be non-empty and contain only ASCII letters, digits, '_', '.' or '-'",
  );
}

