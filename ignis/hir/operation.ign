export namespace Hir {
  /// Mirrors `ignis_hir::operation::BinaryOperation`.
  enum BinaryOperation {
    Add,
    Sub,
    Mul,
    Div,
    Mod,
    Pow,

    And,
    Or,

    Equal,
    NotEqual,
    LessThan,
    LessEqual,
    GreaterThan,
    GreaterEqual,

    BitAnd,
    BitOr,
    BitXor,
    BitShiftLeft,
    BitShiftRight,

    /// Variant name as Rust's derived `Debug` prints it, used by the HIR
    /// display format (`Binary(Add)`, `Assign(Add=)`).
    public debugName(&self): str {
      return match (self) {
        Hir::BinaryOperation::Add -> "Add",
        Hir::BinaryOperation::Sub -> "Sub",
        Hir::BinaryOperation::Mul -> "Mul",
        Hir::BinaryOperation::Div -> "Div",
        Hir::BinaryOperation::Mod -> "Mod",
        Hir::BinaryOperation::Pow -> "Pow",
        Hir::BinaryOperation::And -> "And",
        Hir::BinaryOperation::Or -> "Or",
        Hir::BinaryOperation::Equal -> "Equal",
        Hir::BinaryOperation::NotEqual -> "NotEqual",
        Hir::BinaryOperation::LessThan -> "LessThan",
        Hir::BinaryOperation::LessEqual -> "LessEqual",
        Hir::BinaryOperation::GreaterThan -> "GreaterThan",
        Hir::BinaryOperation::GreaterEqual -> "GreaterEqual",
        Hir::BinaryOperation::BitAnd -> "BitAnd",
        Hir::BinaryOperation::BitOr -> "BitOr",
        Hir::BinaryOperation::BitXor -> "BitXor",
        Hir::BinaryOperation::BitShiftLeft -> "BitShiftLeft",
        Hir::BinaryOperation::BitShiftRight -> "BitShiftRight",
      };
    }
  }

  /// Mirrors `ignis_hir::operation::UnaryOperation`.
  enum UnaryOperation {
    Not,
    Neg,
    BitNot,

    /// Variant name as Rust's derived `Debug` prints it.
    public debugName(&self): str {
      return match (self) {
        Hir::UnaryOperation::Not -> "Not",
        Hir::UnaryOperation::Neg -> "Neg",
        Hir::UnaryOperation::BitNot -> "BitNot",
      };
    }
  }
}
