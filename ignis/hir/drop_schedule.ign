import Vector from "std::vector";

import SourceSpan from "@compiler::diagnostics";
import Analyzer from "@compiler::analyzer";

import _ from "./ids";

export namespace Hir {
  /// Mirrors `ignis_hir::drop_schedule::ExitKey`: the early exit a drop list
  /// belongs to. `FnEnd` is the synthetic return at the end of a body, which
  /// has no `Return` node to key on.
  enum ExitKey {
    Return(Hir::HirId),
    Break(Hir::HirId),
    Continue(Hir::HirId),
    FnEnd(Analyzer::DefinitionId),
  }

  function exitKeyTag(key: &Hir::ExitKey): u32 {
    return match (key) {
      Hir::ExitKey::Return(_) -> 0,
      Hir::ExitKey::Break(_) -> 1,
      Hir::ExitKey::Continue(_) -> 2,
      Hir::ExitKey::FnEnd(_) -> 3,
    };
  }

  /// Raw id of whatever the key points at. Paired with `exitKeyTag` it gives
  /// the structural equality the Rust `HashMap<ExitKey, _>` gets from `Eq`,
  /// without a nested match over two values.
  function exitKeyRaw(key: &Hir::ExitKey): u32 {
    return match (key) {
      Hir::ExitKey::Return(nodeId) -> nodeId.raw(),
      Hir::ExitKey::Break(nodeId) -> nodeId.raw(),
      Hir::ExitKey::Continue(nodeId) -> nodeId.raw(),
      Hir::ExitKey::FnEnd(defId) -> defId.raw(),
    };
  }

  /// Rebuilds an exit key from a borrow of one. The payloads are ids, so this
  /// is a copy in every sense; it exists because an enum value cannot be read
  /// out of a borrow without one.
  function copyExitKey(key: &Hir::ExitKey): Hir::ExitKey {
    return match (key) {
      Hir::ExitKey::Return(nodeId) -> Hir::ExitKey::Return(nodeId),
      Hir::ExitKey::Break(nodeId) -> Hir::ExitKey::Break(nodeId),
      Hir::ExitKey::Continue(nodeId) -> Hir::ExitKey::Continue(nodeId),
      Hir::ExitKey::FnEnd(defId) -> Hir::ExitKey::FnEnd(defId),
    };
  }

  function exitKeysEqual(left: &Hir::ExitKey, right: &Hir::ExitKey): boolean {
    if (Hir::exitKeyTag(left) != Hir::exitKeyTag(right)) {
      return false;
    }

    return Hir::exitKeyRaw(left) == Hir::exitKeyRaw(right);
  }

  function copyDefinitionIds(
    source: &Vector<Analyzer::DefinitionId>
  ): Vector<Analyzer::DefinitionId> {
    let mut result: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(defId) = source.get(index)) {
        result.push(*defId);
      }

      index += 1;
    }

    return result;
  }

  function copyHirIds(source: &Vector<Hir::HirId>): Vector<Hir::HirId> {
    let mut result: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(nodeId) = source.get(index)) {
        result.push(*nodeId);
      }

      index += 1;
    }

    return result;
  }

  /// One drop list keyed by a HIR node: a block for `onScopeEnd`, a match arm
  /// body for `onMatchArmEnd`, an assignment for `onOverwrite`.
  record NodeDropEntry {
    public node: Hir::HirId;
    public defs: Vector<Analyzer::DefinitionId>;
  }

  /// One drop list keyed by an early exit.
  record ExitDropEntry {
    public key: Hir::ExitKey;
    public defs: Vector<Analyzer::DefinitionId>;
  }

  /// One deferred-body list keyed by a block.
  record NodeDeferEntry {
    public node: Hir::HirId;
    public bodies: Vector<Hir::HirId>;
  }

  /// One deferred-body list keyed by an early exit.
  record ExitDeferEntry {
    public key: Hir::ExitKey;
    public bodies: Vector<Hir::HirId>;
  }

  /// Mirrors `ignis_hir::drop_schedule::MoveSite`: a point where a binding's
  /// ownership was transferred away. Recorded for `--dump-drop-schedule`
  /// only; nothing in lowering reads it.
  record MoveSite {
    /// Function whose body contains the move.
    public functionId: Analyzer::DefinitionId;
    /// Span of the expression that consumed the binding.
    public span: SourceSpan;
  }

  /// One binding's move sites, keyed by the moved definition.
  record MoveEntry {
    public def: Analyzer::DefinitionId;
    public sites: Vector<Hir::MoveSite>;
  }

  /// Mirrors `ignis_hir::drop_schedule::DropSchedules`, the output the Rust
  /// ownership walk produces alongside its diagnostics and that LIR lowering
  /// reads to place drop and defer emissions.
  ///
  /// The Rust type is a set of `HashMap`s; here each one is a vector of entries,
  /// following the selfhost convention of avoiding hashing for small maps.
  /// Lookup is linear and keyed structurally, which is what the Rust `Eq`
  /// derives amount to.
  ///
  /// Every `defs` list is in drop order — reverse declaration, inner scope
  /// before outer — and every `bodies` list is in LIFO order, exactly like the
  /// Rust documentation states.
  ///
  /// Mutation lives in methods rather than in free functions because a direct
  /// field write from outside a record is currently miscompiled for owning
  /// fields.
  record DropSchedules {
    public onScopeEnd: Vector<Hir::NodeDropEntry>;
    public onMatchArmEnd: Vector<Hir::NodeDropEntry>;
    public onExit: Vector<Hir::ExitDropEntry>;

    /// Drops owed by a `&&` whose right operand evaluated to false, keyed by
    /// that `Binary` node. Mirrors `on_condition_fail`.
    ///
    /// A chain of `let` conditions (`if (let A = f() && let B = g())`) hands
    /// its bindings to the branch it guards, and the branch is the only place
    /// they are dropped. When a later link of the chain fails, that branch
    /// never runs, yet everything the earlier links bound is already
    /// initialized: the short-circuit false path is the only site where those
    /// bindings are live and unowned. Keying on the `&&` node — rather than on
    /// the `if` — is what keeps the drop precise: reaching this node's false
    /// path with the right operand evaluated means every `let` on the left
    /// succeeded, so exactly the bindings listed here hold a value.
    public onConditionFail: Vector<Hir::NodeDropEntry>;

    /// Drops owed by a `&&` whose *left* operand evaluated to false, keyed by
    /// that `Binary` node. Mirrors `on_condition_skip`.
    ///
    /// A `let` condition consumes its scrutinee, and the ownership walk records
    /// that move once for the whole condition. Behind a short-circuit the move
    /// is conditional: with `if (before && let P = value)` a false `before`
    /// skips the `let` entirely, so `value` was never moved and no later site
    /// frees it — scope end already skipped it. This path is where it is still
    /// live and unowned, and the only place its drop can go.
    ///
    /// Only a scrutinee that is a *place* is listed: a call temporary the
    /// skipped operand would have produced was never created, so nothing is
    /// owed for it.
    public onConditionSkip: Vector<Hir::NodeDropEntry>;

    public onOverwrite: Vector<Hir::NodeDropEntry>;

    /// Drops before overwriting one field of an owned value, keyed by the
    /// assignment and carrying the field's definition. Separate from
    /// `onOverwrite` because the two name different things: an entry there is a
    /// local, dropped through its local slot, while an entry here is a field,
    /// dropped through the field pointer the store already computed.
    public onFieldOverwrite: Vector<Hir::NodeDropEntry>;

    public onScopeEndDefers: Vector<Hir::NodeDeferEntry>;
    public onExitDefers: Vector<Hir::ExitDeferEntry>;

    /// Where each binding was marked moved. Debug metadata only, mirroring
    /// the Rust `moves` field: nothing in lowering reads it, and it is
    /// deliberately excluded from `isEmpty`.
    public moves: Vector<Hir::MoveEntry>;

    public static init(): DropSchedules {
      return DropSchedules {
        onScopeEnd: Vector::new<Hir::NodeDropEntry>(),
        onMatchArmEnd: Vector::new<Hir::NodeDropEntry>(),
        onExit: Vector::new<Hir::ExitDropEntry>(),
        onConditionFail: Vector::new<Hir::NodeDropEntry>(),
        onConditionSkip: Vector::new<Hir::NodeDropEntry>(),
        onOverwrite: Vector::new<Hir::NodeDropEntry>(),
        onFieldOverwrite: Vector::new<Hir::NodeDropEntry>(),
        onScopeEndDefers: Vector::new<Hir::NodeDeferEntry>(),
        onExitDefers: Vector::new<Hir::ExitDeferEntry>(),
        moves: Vector::new<Hir::MoveEntry>(),
      };
    }

    public isEmpty(&self): boolean {
      return self.onScopeEnd.isEmpty() && self.onMatchArmEnd.isEmpty() && self.onExit.isEmpty() && self.onConditionFail.isEmpty() && self.onConditionSkip.isEmpty() && self.onOverwrite.isEmpty() && self.onFieldOverwrite.isEmpty() && self.onScopeEndDefers.isEmpty() && self.onExitDefers.isEmpty();
    }

    /// Replaces the drop list of a block, mirroring the Rust `HashMap::insert`
    /// on `on_scope_end`. A loop body is walked twice, and the second walk must
    /// supersede the first rather than add to it.
    public setScopeEnd(&mut self, block: Hir::HirId, defs: Vector<Analyzer::DefinitionId>): void {
      let existing: Option<u64> = Hir::findNodeEntry(&self.onScopeEnd, block);

      if (let Option::SOME(index) = existing) {
        self.onScopeEnd.set(index, Hir::NodeDropEntry { node: block, defs: defs });
        return;
      }

      self.onScopeEnd.push(Hir::NodeDropEntry { node: block, defs: defs });
    }

    /// Appends to the drop list of a match arm body, mirroring the Rust
    /// `entry(..).or_default().extend(..)` on `on_match_arm_end`.
    public appendMatchArmEnd(
      &mut self,
      body: Hir::HirId,
      defs: Vector<Analyzer::DefinitionId>
    ): void {
      let existing: Option<u64> = Hir::findNodeEntry(&self.onMatchArmEnd, body);

      if (let Option::SOME(index) = existing) {
        let mut merged: Vector<Analyzer::DefinitionId> = self.matchArmDrops(body);
        let extra: Vector<Analyzer::DefinitionId> = defs;
        let mut extraIndex: u64 = 0;

        while (extraIndex < extra.length()) {
          if (let Option::SOME(defId) = extra.get(extraIndex)) {
            merged.push(*defId);
          }

          extraIndex += 1;
        }

        self.onMatchArmEnd.set(index, Hir::NodeDropEntry { node: body, defs: merged });
        return;
      }

      self.onMatchArmEnd.push(Hir::NodeDropEntry { node: body, defs: defs });
    }

    /// Replaces the drop list a short-circuited `&&` owes, mirroring the Rust
    /// `HashMap::insert` on `on_condition_fail`. A loop condition is walked
    /// once, but replacing rather than appending keeps a second walk from
    /// doubling the list.
    public setConditionFail(
      &mut self,
      condition: Hir::HirId,
      defs: Vector<Analyzer::DefinitionId>
    ): void {
      let existing: Option<u64> = Hir::findNodeEntry(&self.onConditionFail, condition);

      if (let Option::SOME(index) = existing) {
        self.onConditionFail.set(index, Hir::NodeDropEntry { node: condition, defs: defs });
        return;
      }

      self.onConditionFail.push(Hir::NodeDropEntry { node: condition, defs: defs });
    }

    /// Replaces the drop list a short-circuited `&&` owes on its skipped path,
    /// mirroring the Rust `HashMap::insert` on `on_condition_skip`. A loop
    /// condition is walked once, but replacing rather than appending keeps a
    /// second walk from doubling the list.
    public setConditionSkip(
      &mut self,
      condition: Hir::HirId,
      defs: Vector<Analyzer::DefinitionId>
    ): void {
      let existing: Option<u64> = Hir::findNodeEntry(&self.onConditionSkip, condition);

      if (let Option::SOME(index) = existing) {
        self.onConditionSkip.set(index, Hir::NodeDropEntry { node: condition, defs: defs });
        return;
      }

      self.onConditionSkip.push(Hir::NodeDropEntry { node: condition, defs: defs });
    }

    /// Forgets the drop list a short-circuited `&&` owed on its skipped path,
    /// mirroring the Rust `HashMap::remove` on `on_condition_skip`.
    public clearConditionSkip(&mut self, condition: Hir::HirId): void {
      let existing: Option<u64> = Hir::findNodeEntry(&self.onConditionSkip, condition);

      if (let Option::SOME(index) = existing) {
        self.onConditionSkip.set(index, Hir::NodeDropEntry {
          node: condition,
          defs: Vector::new<Analyzer::DefinitionId>(),
        });
      }

      return;
    }

    /// Appends one local to the drop-before-overwrite list of an assignment,
    /// mirroring the Rust `entry(..).or_default().push(..)`.
    public appendOverwrite(&mut self, assign: Hir::HirId, defId: Analyzer::DefinitionId): void {
      let existing: Option<u64> = Hir::findNodeEntry(&self.onOverwrite, assign);

      if (let Option::SOME(index) = existing) {
        let mut merged: Vector<Analyzer::DefinitionId> = self.overwriteDrops(assign);
        merged.push(defId);

        self.onOverwrite.set(index, Hir::NodeDropEntry { node: assign, defs: merged });
        return;
      }

      let mut defs: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      defs.push(defId);

      self.onOverwrite.push(Hir::NodeDropEntry { node: assign, defs: defs });
    }

    /// Appends one field to the drop-before-overwrite list of an assignment
    /// whose target is a field, mirroring `on_field_overwrite`.
    public appendFieldOverwrite(
      &mut self,
      assign: Hir::HirId,
      defId: Analyzer::DefinitionId
    ): void {
      let existing: Option<u64> = Hir::findNodeEntry(&self.onFieldOverwrite, assign);

      if (let Option::SOME(index) = existing) {
        let mut merged: Vector<Analyzer::DefinitionId> = self.fieldOverwriteDrops(assign);
        merged.push(defId);

        self.onFieldOverwrite.set(index, Hir::NodeDropEntry { node: assign, defs: merged });
        return;
      }

      let mut defs: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      defs.push(defId);

      self.onFieldOverwrite.push(Hir::NodeDropEntry { node: assign, defs: defs });
    }

    public setExit(&mut self, key: Hir::ExitKey, defs: Vector<Analyzer::DefinitionId>): void {
      let existing: Option<u64> = Hir::findExitDropEntry(&self.onExit, &key);

      if (let Option::SOME(index) = existing) {
        self.onExit.set(index, Hir::ExitDropEntry { key: key, defs: defs });
        return;
      }

      self.onExit.push(Hir::ExitDropEntry { key: key, defs: defs });
    }

    public setScopeEndDefers(&mut self, block: Hir::HirId, bodies: Vector<Hir::HirId>): void {
      let existing: Option<u64> = Hir::findNodeDeferEntry(&self.onScopeEndDefers, block);

      if (let Option::SOME(index) = existing) {
        self.onScopeEndDefers.set(index, Hir::NodeDeferEntry { node: block, bodies: bodies });
        return;
      }

      self.onScopeEndDefers.push(Hir::NodeDeferEntry { node: block, bodies: bodies });
    }

    public setExitDefers(&mut self, key: Hir::ExitKey, bodies: Vector<Hir::HirId>): void {
      let existing: Option<u64> = Hir::findExitDeferEntry(&self.onExitDefers, &key);

      if (let Option::SOME(index) = existing) {
        self.onExitDefers.set(index, Hir::ExitDeferEntry { key: key, bodies: bodies });
        return;
      }

      self.onExitDefers.push(Hir::ExitDeferEntry { key: key, bodies: bodies });
    }

    /// Appends one move site for `defId`, mirroring the Rust
    /// `entry(..).or_default().push(..)` on `moves`.
    public recordMove(
      &mut self,
      defId: Analyzer::DefinitionId,
      functionId: Analyzer::DefinitionId,
      span: SourceSpan
    ): void {
      let site: Hir::MoveSite = Hir::MoveSite { functionId: functionId, span: span };
      let existing: Option<u64> = Hir::findMoveEntry(&self.moves, defId);

      if (let Option::SOME(index) = existing) {
        let mut sites: Vector<Hir::MoveSite> = self.movesOf(defId);
        sites.push(site);

        self.moves.set(index, Hir::MoveEntry { def: defId, sites: sites });
        return;
      }

      let mut sites: Vector<Hir::MoveSite> = Vector::new<Hir::MoveSite>();
      sites.push(site);

      self.moves.push(Hir::MoveEntry { def: defId, sites: sites });
    }

    /// Move sites recorded for `defId`, in recording order. Returns a copy so
    /// the caller can keep reading the schedules while it walks it.
    public movesOf(&self, defId: Analyzer::DefinitionId): Vector<Hir::MoveSite> {
      let mut index: u64 = 0;

      while (index < self.moves.length()) {
        if (let Option::SOME(entry) = self.moves.get(index)) {
          if (entry.def.equals(&defId)) {
            let mut result: Vector<Hir::MoveSite> = Vector::new<Hir::MoveSite>();
            let mut siteIndex: u64 = 0;

            while (siteIndex < entry.sites.length()) {
              if (let Option::SOME(site) = entry.sites.get(siteIndex)) {
                result.push(Hir::MoveSite { functionId: site.functionId, span: site.span });
              }

              siteIndex += 1;
            }

            return result;
          }
        }

        index += 1;
      }

      return Vector::new<Hir::MoveSite>();
    }

    /// Drop list of a block, empty when nothing is scheduled there. Returns a
    /// copy so the caller can keep reading the schedules while it walks it.
    public scopeEndDrops(&self, block: Hir::HirId): Vector<Analyzer::DefinitionId> {
      return Hir::nodeEntryDrops(&self.onScopeEnd, block);
    }

    public matchArmDrops(&self, body: Hir::HirId): Vector<Analyzer::DefinitionId> {
      return Hir::nodeEntryDrops(&self.onMatchArmEnd, body);
    }

    public conditionFailDrops(&self, condition: Hir::HirId): Vector<Analyzer::DefinitionId> {
      return Hir::nodeEntryDrops(&self.onConditionFail, condition);
    }

    public conditionSkipDrops(&self, condition: Hir::HirId): Vector<Analyzer::DefinitionId> {
      return Hir::nodeEntryDrops(&self.onConditionSkip, condition);
    }

    public overwriteDrops(&self, assign: Hir::HirId): Vector<Analyzer::DefinitionId> {
      return Hir::nodeEntryDrops(&self.onOverwrite, assign);
    }

    public fieldOverwriteDrops(&self, assign: Hir::HirId): Vector<Analyzer::DefinitionId> {
      return Hir::nodeEntryDrops(&self.onFieldOverwrite, assign);
    }

    public exitDrops(&self, key: &Hir::ExitKey): Vector<Analyzer::DefinitionId> {
      let mut index: u64 = 0;

      while (index < self.onExit.length()) {
        if (let Option::SOME(entry) = self.onExit.get(index)) {
          if (Hir::exitKeysEqual(&entry.key, key)) {
            return Hir::copyDefinitionIds(&entry.defs);
          }
        }

        index += 1;
      }

      return Vector::new<Analyzer::DefinitionId>();
    }

    public scopeEndDefers(&self, block: Hir::HirId): Vector<Hir::HirId> {
      let mut index: u64 = 0;

      while (index < self.onScopeEndDefers.length()) {
        if (let Option::SOME(entry) = self.onScopeEndDefers.get(index)) {
          if (entry.node.equals(&block)) {
            return Hir::copyHirIds(&entry.bodies);
          }
        }

        index += 1;
      }

      return Vector::new<Hir::HirId>();
    }

    public exitDefers(&self, key: &Hir::ExitKey): Vector<Hir::HirId> {
      let mut index: u64 = 0;

      while (index < self.onExitDefers.length()) {
        if (let Option::SOME(entry) = self.onExitDefers.get(index)) {
          if (Hir::exitKeysEqual(&entry.key, key)) {
            return Hir::copyHirIds(&entry.bodies);
          }
        }

        index += 1;
      }

      return Vector::new<Hir::HirId>();
    }
  }

  function findNodeEntry(entries: &Vector<Hir::NodeDropEntry>, node: Hir::HirId): Option<u64> {
    let mut index: u64 = 0;

    while (index < entries.length()) {
      if (let Option::SOME(entry) = entries.get(index)) {
        if (entry.node.equals(&node)) {
          return Option::SOME(index);
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  function nodeEntryDrops(
    entries: &Vector<Hir::NodeDropEntry>,
    node: Hir::HirId,
  ): Vector<Analyzer::DefinitionId> {
    let mut index: u64 = 0;

    while (index < entries.length()) {
      if (let Option::SOME(entry) = entries.get(index)) {
        if (entry.node.equals(&node)) {
          return Hir::copyDefinitionIds(&entry.defs);
        }
      }

      index += 1;
    }

    return Vector::new<Analyzer::DefinitionId>();
  }

  function findNodeDeferEntry(
    entries: &Vector<Hir::NodeDeferEntry>,
    node: Hir::HirId
  ): Option<u64> {
    let mut index: u64 = 0;

    while (index < entries.length()) {
      if (let Option::SOME(entry) = entries.get(index)) {
        if (entry.node.equals(&node)) {
          return Option::SOME(index);
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  function findExitDropEntry(
    entries: &Vector<Hir::ExitDropEntry>,
    key: &Hir::ExitKey
  ): Option<u64> {
    let mut index: u64 = 0;

    while (index < entries.length()) {
      if (let Option::SOME(entry) = entries.get(index)) {
        if (Hir::exitKeysEqual(&entry.key, key)) {
          return Option::SOME(index);
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  function findExitDeferEntry(
    entries: &Vector<Hir::ExitDeferEntry>,
    key: &Hir::ExitKey
  ): Option<u64> {
    let mut index: u64 = 0;

    while (index < entries.length()) {
      if (let Option::SOME(entry) = entries.get(index)) {
        if (Hir::exitKeysEqual(&entry.key, key)) {
          return Option::SOME(index);
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  function findMoveEntry(
    entries: &Vector<Hir::MoveEntry>,
    defId: Analyzer::DefinitionId
  ): Option<u64> {
    let mut index: u64 = 0;

    while (index < entries.length()) {
      if (let Option::SOME(entry) = entries.get(index)) {
        if (entry.def.equals(&defId)) {
          return Option::SOME(index);
        }
      }

      index += 1;
    }

    return Option::NONE;
  }
}
