import Vector from "std::vector";

import Id from "@compiler::ids";
import Analyzer from "@compiler::analyzer";
import Borrowck from "@compiler::analyzer::borrowck";
import Lir from "./mod";

/// LIR well-formedness verification, mirroring `ignis_lir::verify`: every
/// referenced block, local and temp must exist, temps must be defined before
/// use in block-store order, branch conditions must be boolean, and return
/// values must agree with the function signature. Findings are rendered as
/// strings; the measured loop needs counts and labels, not a typed error
/// model, and the C emitter never consumes them.
export namespace LirVerify {
  record VerifyState {
    public errors: Vector<String>;
    public definedTemps: Vector<boolean>;

    public static init(): VerifyState {
      return VerifyState {
        errors: Vector::new<String>(),
        definedTemps: Vector::new<boolean>(),
      };
    }
  }

  function report(
    state: &mut LirVerify::VerifyState,
    functionLabel: u32,
    blockLabel: &String,
    message: str,
  ): void {
    state.errors.push(`fn_${functionLabel} ${blockLabel.toStr()}: ${message}`);
  }

  function markDefined(state: &mut LirVerify::VerifyState, temp: Lir::TempId): void {
    let index: u64 = temp.raw() as u64;

    while (state.definedTemps.length() <= index) {
      state.definedTemps.push(false);
    }

    let _ = state.definedTemps.set(index, true);
  }

  function checkTemp(
    state: &mut LirVerify::VerifyState,
    function_: &Lir::FunctionLir,
    functionLabel: u32,
    blockLabel: &String,
    temp: Lir::TempId,
  ): void {
    if (temp.raw() as u64 >= function_.temps.length()) {
      LirVerify::report(state, functionLabel, blockLabel, "invalid temp ref");
      return;
    }

    let mut defined: boolean = false;

    if (let Option::SOME(flag) = state.definedTemps.get(temp.raw() as u64)) {
      defined = *flag;
    }

    if (!defined) {
      LirVerify::report(state, functionLabel, blockLabel, "temp used before def");
    }
  }

  function checkLocal(
    state: &mut LirVerify::VerifyState,
    function_: &Lir::FunctionLir,
    functionLabel: u32,
    blockLabel: &String,
    local: Lir::LocalId,
  ): void {
    if (local.raw() as u64 >= function_.locals.length()) {
      LirVerify::report(state, functionLabel, blockLabel, "invalid local ref");
    }
  }

  function checkBlock(
    state: &mut LirVerify::VerifyState,
    function_: &Lir::FunctionLir,
    functionLabel: u32,
    blockLabel: &String,
    target: Lir::BlockId,
  ): void {
    if (target.raw() as u64 >= function_.blocks.length()) {
      LirVerify::report(state, functionLabel, blockLabel, "invalid block ref");
    }
  }

  function checkOperand(
    state: &mut LirVerify::VerifyState,
    function_: &Lir::FunctionLir,
    functionLabel: u32,
    blockLabel: &String,
    operand: &Lir::Operand,
  ): void {
    match (operand) {
      Lir::Operand::Temp(temp) -> {
        LirVerify::checkTemp(state, function_, functionLabel, blockLabel, temp);
      },
      Lir::Operand::Local(local) -> {
        LirVerify::checkLocal(state, function_, functionLabel, blockLabel, local);
      },
      _ -> {},
    };
  }

  function checkOperandList(
    state: &mut LirVerify::VerifyState,
    function_: &Lir::FunctionLir,
    functionLabel: u32,
    blockLabel: &String,
    operands: &Vector<Lir::Operand>,
  ): void {
    let mut index: u64 = 0;

    while (index < operands.length()) {
      if (let Option::SOME(operand) = operands.get(index)) {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, operand);
      }

      index += 1;
    }
  }

  /// Canonical form of a type for equality: alias chains resolved, so an
  /// aliased return annotation compares equal to the canonical type the
  /// expression carries. Mirrors the oracle, whose LIR never sees aliases.
  function canonicalType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ty: Analyzer::TypeId,
  ): Analyzer::TypeId {
    let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, ty);

    if (resolved.cycleAlias.isSome()) {
      return ty;
    }

    return resolved.typeId;
  }

  /// Type of an operand, `NONE` for function/global references.
  function operandType(
    function_: &Lir::FunctionLir,
    operand: &Lir::Operand,
  ): Option<Analyzer::TypeId> {
    return match (operand) {
      Lir::Operand::Temp(temp) -> function_.tempType(temp),
      Lir::Operand::Local(local) -> function_.localType(local),
      Lir::Operand::Const(value) -> Option::SOME(Lir::constValueType(&value)),
      _ -> Option::NONE,
    };
  }

  function verifyInstr(
    state: &mut LirVerify::VerifyState,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    functionLabel: u32,
    blockLabel: &String,
    instr: &Lir::Instr,
  ): void {
    match (instr) {
      Lir::Instr::Load(node) -> {
        LirVerify::checkLocal(state, function_, functionLabel, blockLabel, node.source);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::Store(node) -> {
        LirVerify::checkLocal(state, function_, functionLabel, blockLabel, node.dest);
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.value);
      },
      Lir::Instr::LoadPtr(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.ptr);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::StorePtr(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.ptr);
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.value);
      },
      Lir::Instr::BuiltinLoad(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.ptr);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::BuiltinStore(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.ptr);
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.value);
      },
      Lir::Instr::BuiltinHash(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.value);
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.hasher);
      },
      Lir::Instr::BuiltinEq(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.left);
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.right);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::Copy(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.source);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::BinOp(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.left);
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.right);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::UnaryOp(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.operand);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::Call(node) -> {
        LirVerify::checkOperandList(state, function_, functionLabel, blockLabel, &node.args);

        if (let Option::SOME(dest) = node.dest) {
          LirVerify::markDefined(state, dest);
        }
      },
      Lir::Instr::Cast(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.source);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::BitCast(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.source);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::AddrOfLocal(node) -> {
        LirVerify::checkLocal(state, function_, functionLabel, blockLabel, node.local);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::AddrOfGlobal(node) -> {
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::GetElementPtr(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.base);
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.index);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::MakeSlice(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.data);
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.len);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::InitVector(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.destPtr);
        LirVerify::checkOperandList(state, function_, functionLabel, blockLabel, &node.elements);
      },
      Lir::Instr::Nop -> {},
      Lir::Instr::RuntimeCall(node) -> {
        LirVerify::checkOperandList(state, function_, functionLabel, blockLabel, &node.args);
      },
      Lir::Instr::TypeIdOf(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.source);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::SizeOf(node) -> {
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::AlignOf(node) -> {
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::MaxOf(node) -> {
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::MinOf(node) -> {
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::Trap(_) -> {},
      Lir::Instr::PanicMessage(_) -> {},
      Lir::Instr::Drop(node) -> {
        LirVerify::checkLocal(state, function_, functionLabel, blockLabel, node.local);

        // A drop of a slot that owns nothing is a schedule and a lowering disagreeing
        // about what the slot holds — a pointer alias given the payload's drop, say.
        // The host's verifier catches it; this one has to agree or the two compilers
        // accept different programs.
        if (let Option::SOME(localData) = function_.locals.get(node.local.raw() as u64)) {
          if (!Borrowck::needsDropType(defStore, typeStore, localData.ty)) {
            LirVerify::report(state, functionLabel, blockLabel, "drop of a non-droppable local");
          }
        }
      },
      Lir::Instr::GetFieldPtr(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.base);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::InitRecord(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.destPtr);

        let mut fieldIndex: u64 = 0;
        while (fieldIndex < node.fields.length()) {
          if (let Option::SOME(field) = node.fields.get(fieldIndex)) {
            LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &field.value);
          }
          fieldIndex += 1;
        }
      },
      Lir::Instr::InitEnumVariant(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.destPtr);
        LirVerify::checkOperandList(state, function_, functionLabel, blockLabel, &node.payload);
      },
      Lir::Instr::EnumGetTag(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.source);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::EnumGetPayloadField(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.source);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::EnumGetPayloadFieldPtr(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.source);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::DropInPlace(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.ptr);
      },
      Lir::Instr::MarkMoved(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.ptr);
      },
      Lir::Instr::DropGlue(node) -> {
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::MakeClosure(node) -> {
        LirVerify::checkOperandList(state, function_, functionLabel, blockLabel, &node.captures);
        LirVerify::markDefined(state, node.dest);
      },
      Lir::Instr::CallClosure(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.closure);
        LirVerify::checkOperandList(state, function_, functionLabel, blockLabel, &node.args);

        if (let Option::SOME(dest) = node.dest) {
          LirVerify::markDefined(state, dest);
        }
      },
      Lir::Instr::DropClosure(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.closure);
      },
      Lir::Instr::FreeEnv(node) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &node.env);
      },
    };
  }

  function markAddressed(addressed: &mut Vector<boolean>, local: Lir::LocalId): void {
    let mut flags: &mut Vector<boolean> = addressed;
    let index: u64 = local.raw() as u64;

    while (flags.length() <= index) {
      flags.push(false);
    }

    let _ = flags.set(index, true);
  }

  function isAddressed(addressed: &Vector<boolean>, local: Lir::LocalId): boolean {
    if (let Option::SOME(flag) = addressed.get(local.raw() as u64)) {
      return *flag;
    }

    return false;
  }

  function markAddressedOperand(addressed: &mut Vector<boolean>, operand: &Lir::Operand): void {
    match (operand) {
      Lir::Operand::Local(local) -> {
        LirVerify::markAddressed(addressed, local);
      },
      _ -> {},
    };
  }

  function markAddressedOperandList(
    addressed: &mut Vector<boolean>,
    operands: &Vector<Lir::Operand>,
  ): void {
    let mut index: u64 = 0;

    while (index < operands.length()) {
      if (let Option::SOME(operand) = operands.get(index)) {
        LirVerify::markAddressedOperand(addressed, operand);
      }

      index += 1;
    }
  }

  /// Marks every local one instruction could hand an address of.
  ///
  /// `AddrOfLocal` hands out the address explicitly; an `Operand::Local` is a
  /// slot used where a pointer is expected, which is the same thing. Written
  /// out arm by arm rather than with a catch-all so a new instruction carrying
  /// an operand has to be listed here instead of silently going unseen.
  function collectAddressed(addressed: &mut Vector<boolean>, instr: &Lir::Instr): void {
    match (instr) {
      Lir::Instr::Store(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.value);
      },
      Lir::Instr::LoadPtr(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.ptr);
      },
      Lir::Instr::StorePtr(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.ptr);
        LirVerify::markAddressedOperand(addressed, &node.value);
      },
      Lir::Instr::BuiltinLoad(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.ptr);
      },
      Lir::Instr::BuiltinStore(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.ptr);
        LirVerify::markAddressedOperand(addressed, &node.value);
      },
      Lir::Instr::BuiltinHash(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.value);
        LirVerify::markAddressedOperand(addressed, &node.hasher);
      },
      Lir::Instr::BuiltinEq(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.left);
        LirVerify::markAddressedOperand(addressed, &node.right);
      },
      Lir::Instr::Copy(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.source);
      },
      Lir::Instr::BinOp(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.left);
        LirVerify::markAddressedOperand(addressed, &node.right);
      },
      Lir::Instr::UnaryOp(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.operand);
      },
      Lir::Instr::Call(node) -> {
        LirVerify::markAddressedOperandList(addressed, &node.args);
      },
      Lir::Instr::Cast(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.source);
      },
      Lir::Instr::BitCast(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.source);
      },
      Lir::Instr::AddrOfLocal(node) -> {
        LirVerify::markAddressed(addressed, node.local);
      },
      Lir::Instr::AddrOfGlobal(_) -> {},
      Lir::Instr::GetElementPtr(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.base);
        LirVerify::markAddressedOperand(addressed, &node.index);
      },
      Lir::Instr::MakeSlice(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.data);
        LirVerify::markAddressedOperand(addressed, &node.len);
      },
      Lir::Instr::InitVector(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.destPtr);
        LirVerify::markAddressedOperandList(addressed, &node.elements);
      },
      Lir::Instr::Nop -> {},
      Lir::Instr::RuntimeCall(node) -> {
        LirVerify::markAddressedOperandList(addressed, &node.args);
      },
      Lir::Instr::TypeIdOf(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.source);
      },
      Lir::Instr::SizeOf(_) -> {},
      Lir::Instr::AlignOf(_) -> {},
      Lir::Instr::MaxOf(_) -> {},
      Lir::Instr::MinOf(_) -> {},
      Lir::Instr::Trap(_) -> {},
      Lir::Instr::PanicMessage(_) -> {},
      Lir::Instr::Load(_) -> {},
      Lir::Instr::Drop(_) -> {},
      Lir::Instr::GetFieldPtr(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.base);
      },
      Lir::Instr::InitRecord(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.destPtr);

        let mut fieldIndex: u64 = 0;

        while (fieldIndex < node.fields.length()) {
          if (let Option::SOME(field) = node.fields.get(fieldIndex)) {
            LirVerify::markAddressedOperand(addressed, &field.value);
          }

          fieldIndex += 1;
        }
      },
      Lir::Instr::InitEnumVariant(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.destPtr);
        LirVerify::markAddressedOperandList(addressed, &node.payload);
      },
      Lir::Instr::EnumGetTag(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.source);
      },
      Lir::Instr::EnumGetPayloadField(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.source);
      },
      Lir::Instr::EnumGetPayloadFieldPtr(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.source);
      },
      Lir::Instr::DropInPlace(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.ptr);
      },
      Lir::Instr::MarkMoved(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.ptr);
      },
      Lir::Instr::DropGlue(_) -> {},
      Lir::Instr::MakeClosure(node) -> {
        LirVerify::markAddressedOperandList(addressed, &node.captures);
      },
      Lir::Instr::CallClosure(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.closure);
        LirVerify::markAddressedOperandList(addressed, &node.args);
      },
      Lir::Instr::DropClosure(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.closure);
      },
      Lir::Instr::FreeEnv(node) -> {
        LirVerify::markAddressedOperand(addressed, &node.env);
      },
    };
  }

  function addressedLocals(function_: &Lir::FunctionLir): Vector<boolean> {
    let mut addressed: Vector<boolean> = Vector::new<boolean>();
    let mut blockIndex: u64 = 0;

    while (blockIndex < function_.blocks.length()) {
      let Option::SOME(block) = function_.blocks.get(blockIndex) else {
        blockIndex += 1;
        continue;
      };

      let mut instrIndex: u64 = 0;

      while (instrIndex < block.instructions.length()) {
        if (let Option::SOME(instr) = block.instructions.get(instrIndex)) {
          LirVerify::collectAddressed(&mut addressed, instr);
        }

        instrIndex += 1;
      }

      match (&block.terminator) {
        Lir::Terminator::Branch(branch) -> {
          LirVerify::markAddressedOperand(&mut addressed, &branch.condition);
        },
        Lir::Terminator::Return(valueOpt) -> {
          if (let Option::SOME(value) = valueOpt) {
            LirVerify::markAddressedOperand(&mut addressed, &value);
          }
        },
        _ -> {},
      };

      blockIndex += 1;
    }

    return addressed;
  }

  /// The local a drop names when the value reached the instruction through a
  /// temp. A closure is freed as a `Load` into a temp followed by
  /// `DropClosure` on that temp, so without this the pair reads as a drop of
  /// nothing. `loadedFrom` holds the source local of each temp, or -1.
  function localBehind(operand: &Lir::Operand, loadedFrom: &Vector<i64>): Option<Lir::LocalId> {
    match (operand) {
      Lir::Operand::Local(local) -> {
        return Option::SOME(local);
      },
      Lir::Operand::Temp(temp) -> {
        if (let Option::SOME(source) = loadedFrom.get(temp.raw() as u64)) {
          if (*source >= 0) {
            return Option::SOME(Id::fromRaw<Lir::LocalTag>(*source as u32));
          }
        }
      },
      _ -> {},
    };

    return Option::NONE;
  }

  function recordLoadAlias(
    loadedFrom: &mut Vector<i64>,
    temp: Lir::TempId,
    local: Lir::LocalId,
  ): void {
    let mut aliases: &mut Vector<i64> = loadedFrom;
    let index: u64 = temp.raw() as u64;

    while (aliases.length() <= index) {
      aliases.push(-1);
    }

    let _ = aliases.set(index, local.raw() as i64);
  }

  /// Forgets every temp alias that named `local`, because the store replaced
  /// what those temps were read from.
  function clearLoadAliases(loadedFrom: &mut Vector<i64>, local: Lir::LocalId): void {
    let mut aliases: &mut Vector<i64> = loadedFrom;
    let target: i64 = local.raw() as i64;
    let mut index: u64 = 0;

    while (index < aliases.length()) {
      let mut matches: boolean = false;

      if (let Option::SOME(source) = aliases.get(index)) {
        matches = *source == target;
      }

      if (matches) {
        let _ = aliases.set(index, -1);
      }

      index += 1;
    }
  }

  function markDroppedOnce(
    state: &mut LirVerify::VerifyState,
    dropped: &mut Vector<boolean>,
    addressed: &Vector<boolean>,
    functionLabel: u32,
    blockLabel: &String,
    local: Lir::LocalId,
  ): void {
    if (LirVerify::isAddressed(addressed, local)) {
      return;
    }

    let mut flags: &mut Vector<boolean> = dropped;
    let index: u64 = local.raw() as u64;

    while (flags.length() <= index) {
      flags.push(false);
    }

    let mut alreadyDropped: boolean = false;

    if (let Option::SOME(flag) = flags.get(index)) {
      alreadyDropped = *flag;
    }

    if (alreadyDropped) {
      LirVerify::report(state, functionLabel, blockLabel, "double drop of a local without an intervening store");
      return;
    }

    let _ = flags.set(index, true);
  }

  function clearDropped(dropped: &mut Vector<boolean>, local: Lir::LocalId): void {
    let mut flags: &mut Vector<boolean> = dropped;
    let index: u64 = local.raw() as u64;

    if (index < flags.length()) {
      let _ = flags.set(index, false);
    }
  }

  /// Rejects a local freed twice inside one block with nothing between the two
  /// drops that gives it a new value.
  ///
  /// This is what a duplicated drop schedule reaches the program as: ownership
  /// lists the same value twice for one site, and lowering emits both frees
  /// back to back. Mirrors the host's `verify_no_double_drops`, including its
  /// limit: the walk never follows an edge, so two drops in different blocks
  /// are not compared even when one dominates the other. A cross-block rule
  /// needs a liveness dataflow over the whole function, and the shape this
  /// exists to catch always emits both frees into one block.
  ///
  /// Only a `Store` re-initializes. Reads do not: a closure is freed as `Load`
  /// then `DropClosure`, so treating the `Load` as a write would hide exactly
  /// the double free the check is for. A local whose address is ever taken is
  /// skipped, because anything reachable through that pointer can write the
  /// slot where the walk cannot see it.
  function verifyNoDoubleDrops(
    state: &mut LirVerify::VerifyState,
    function_: &Lir::FunctionLir,
    functionLabel: u32,
  ): void {
    let addressed: Vector<boolean> = LirVerify::addressedLocals(function_);
    let mut blockIndex: u64 = 0;

    while (blockIndex < function_.blocks.length()) {
      let Option::SOME(block) = function_.blocks.get(blockIndex) else {
        blockIndex += 1;
        continue;
      };

      // Cleared per block: the walk never follows an edge, so nothing carries over.
      let mut dropped: Vector<boolean> = Vector::new<boolean>();
      let mut loadedFrom: Vector<i64> = Vector::new<i64>();
      let mut instrIndex: u64 = 0;

      while (instrIndex < block.instructions.length()) {
        let Option::SOME(instr) = block.instructions.get(instrIndex) else {
          instrIndex += 1;
          continue;
        };

        match (instr) {
          Lir::Instr::Load(node) -> {
            LirVerify::recordLoadAlias(&mut loadedFrom, node.dest, node.source);
          },
          Lir::Instr::Store(node) -> {
            LirVerify::clearDropped(&mut dropped, node.dest);
            LirVerify::clearLoadAliases(&mut loadedFrom, node.dest);
          },
          Lir::Instr::MarkMoved(node) -> {
            if (let Option::SOME(local) = LirVerify::localBehind(&node.ptr, &loadedFrom)) {
              LirVerify::clearDropped(&mut dropped, local);
            }
          },
          Lir::Instr::Drop(node) -> {
            LirVerify::markDroppedOnce(state, &mut dropped, &addressed, functionLabel, &block.label, node.local);
          },
          Lir::Instr::DropClosure(node) -> {
            if (let Option::SOME(local) = LirVerify::localBehind(&node.closure, &loadedFrom)) {
              LirVerify::markDroppedOnce(state, &mut dropped, &addressed, functionLabel, &block.label, local);
            }
          },
          _ -> {},
        };

        instrIndex += 1;
      }

      blockIndex += 1;
    }
  }

  function verifyTerminator(
    state: &mut LirVerify::VerifyState,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
    functionLabel: u32,
    blockLabel: &String,
    terminator: &Lir::Terminator,
  ): void {
    match (terminator) {
      Lir::Terminator::Goto(target) -> {
        LirVerify::checkBlock(state, function_, functionLabel, blockLabel, target);
      },
      Lir::Terminator::Branch(branch) -> {
        LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &branch.condition);
        LirVerify::checkBlock(state, function_, functionLabel, blockLabel, branch.thenBlock);
        LirVerify::checkBlock(state, function_, functionLabel, blockLabel, branch.elseBlock);

        if (let Option::SOME(conditionType) = LirVerify::operandType(function_, &branch.condition)) {
          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          let boolType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::BOOLEAN);

          if (conditionType.raw() != boolType.raw()) {
            LirVerify::report(state, functionLabel, blockLabel, "non-bool branch condition");
          }
        }
      },
      Lir::Terminator::Return(valueOpt) -> {
        let mut isVoid: boolean = false;

        if (let Option::SOME(typeNode) = typeStore.get(function_.returnType)) {
          if (let Analyzer::Type::VOID = typeNode) {
            isVoid = true;
          }
        }

        match (valueOpt) {
          Option::SOME(value) -> {
            LirVerify::checkOperand(state, function_, functionLabel, blockLabel, &value);

            if (isVoid) {
              LirVerify::report(state, functionLabel, blockLabel, "unexpected return value");
            } else {
              if (let Option::SOME(valueType) = LirVerify::operandType(function_, &value)) {
                let canonicalValue: Analyzer::TypeId = LirVerify::canonicalType(defStore, typeStore, valueType);
                let canonicalReturn: Analyzer::TypeId = LirVerify::canonicalType(defStore, typeStore, function_.returnType);

                if (canonicalValue.raw() != canonicalReturn.raw()) {
                  LirVerify::report(state, functionLabel, blockLabel, "return type mismatch");
                }
              }
            }
          },
          Option::NONE -> {
            if (!isVoid) {
              LirVerify::report(state, functionLabel, blockLabel, "missing return value");
            }
          },
        };
      },
      Lir::Terminator::Unreachable -> {},
    };
  }

  function verifyFunction(
    state: &mut LirVerify::VerifyState,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &Lir::FunctionLir,
  ): void {
    let functionLabel: u32 = function_.defId.raw();

    state.definedTemps = Vector::new<boolean>();

    let mut paramIndex: u64 = 0;
    while (paramIndex < function_.params.length()) {
      LirVerify::markDefined(state, Id::fromRaw<Lir::TempTag>(paramIndex as u32));
      paramIndex += 1;
    }

    let mut blockIndex: u64 = 0;

    while (blockIndex < function_.blocks.length()) {
      let Option::SOME(block) = function_.blocks.get(blockIndex) else {
        blockIndex += 1;
        continue;
      };

      let mut instrIndex: u64 = 0;

      while (instrIndex < block.instructions.length()) {
        if (let Option::SOME(instr) = block.instructions.get(instrIndex)) {
          LirVerify::verifyInstr(state, defStore, typeStore, function_, functionLabel, &block.label, instr);
        }

        instrIndex += 1;
      }

      LirVerify::verifyTerminator(state, defStore, typeStore, function_, functionLabel, &block.label, &block.terminator);

      blockIndex += 1;
    }

    LirVerify::verifyNoDoubleDrops(state, function_, functionLabel);
  }

  /// Verifies every non-extern function of a lowered program and returns the
  /// findings, empty when the program is well-formed.
  function verifyProgram(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    program: &Lir::LirProgram,
  ): Vector<String> {
    let mut state: LirVerify::VerifyState = LirVerify::VerifyState::init();
    let mut functionIndex: u64 = 0;

    while (functionIndex < program.functions.length()) {
      let Option::SOME(function_) = program.functions.functionAt(functionIndex) else {
        functionIndex += 1;
        continue;
      };

      if (!function_.isExtern) {
        LirVerify::verifyFunction(&mut state, defStore, typeStore, function_);
      }

      functionIndex += 1;
    }

    return state.errors;
  }
}
