import Analyzer from "@compiler::analyzer";
import _ from "./ids";

export namespace Lir {
  /// Mirrors `ignis_lir::ConstValue`: a compile-time constant carrying its
  /// semantic type.
  enum ConstValue {
    Int(i64, Analyzer::TypeId),
    UInt(u64, Analyzer::TypeId),
    Float(f64, Analyzer::TypeId),
    Bool(boolean, Analyzer::TypeId),
    Char(u32, Analyzer::TypeId),
    Str(String, Analyzer::TypeId),
    Atom(u32, Analyzer::TypeId),
    Null(Analyzer::TypeId),
    Undef(Analyzer::TypeId),
  }

  function constValueType(value: &Lir::ConstValue): Analyzer::TypeId {
    return match (value) {
      Lir::ConstValue::Int(_, ty) -> ty,
      Lir::ConstValue::UInt(_, ty) -> ty,
      Lir::ConstValue::Float(_, ty) -> ty,
      Lir::ConstValue::Bool(_, ty) -> ty,
      Lir::ConstValue::Char(_, ty) -> ty,
      Lir::ConstValue::Str(_, ty) -> ty,
      Lir::ConstValue::Atom(_, ty) -> ty,
      Lir::ConstValue::Null(ty) -> ty,
      Lir::ConstValue::Undef(ty) -> ty,
    };
  }

  /// Mirrors `ignis_lir::Operand`: a value an instruction can read.
  enum Operand {
    Temp(Lir::TempId),
    Local(Lir::LocalId),
    Const(Lir::ConstValue),
    FuncRef(Analyzer::DefinitionId),
    GlobalRef(Analyzer::DefinitionId),
  }

  /// Manual clone for operands: pattern checks read the same scrutinee
  /// operand several times and `Operand` owns a `String` in its `Str` case.
  function copyOperand(operand: &Lir::Operand): Lir::Operand {
    return match (operand) {
      Lir::Operand::Temp(temp) -> Lir::Operand::Temp(temp),
      Lir::Operand::Local(local) -> Lir::Operand::Local(local),
      Lir::Operand::Const(value) -> Lir::Operand::Const(Lir::copyConstValue(&value)),
      Lir::Operand::FuncRef(defId) -> Lir::Operand::FuncRef(defId),
      Lir::Operand::GlobalRef(defId) -> Lir::Operand::GlobalRef(defId),
    };
  }

  function copyConstValue(value: &Lir::ConstValue): Lir::ConstValue {
    return match (value) {
      Lir::ConstValue::Int(raw, ty) -> Lir::ConstValue::Int(raw, ty),
      Lir::ConstValue::UInt(raw, ty) -> Lir::ConstValue::UInt(raw, ty),
      Lir::ConstValue::Float(raw, ty) -> Lir::ConstValue::Float(raw, ty),
      Lir::ConstValue::Bool(raw, ty) -> Lir::ConstValue::Bool(raw, ty),
      Lir::ConstValue::Char(raw, ty) -> Lir::ConstValue::Char(raw, ty),
      Lir::ConstValue::Str(text, ty) -> Lir::ConstValue::Str(text.clone(), ty),
      Lir::ConstValue::Atom(raw, ty) -> Lir::ConstValue::Atom(raw, ty),
      Lir::ConstValue::Null(ty) -> Lir::ConstValue::Null(ty),
      Lir::ConstValue::Undef(ty) -> Lir::ConstValue::Undef(ty),
    };
  }
}
