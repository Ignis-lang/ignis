/// How many `MakeSlice` instructions the whole program carries.
function lirCountMakeSlice(program: &Lir::LirProgram): u64 {
  let mut count: u64 = 0;
  let mut functionIndex: u64 = 0;

  while (functionIndex < program.functions.length()) {
    let Option::SOME(function_) = program.functions.functionAt(functionIndex) else {
      functionIndex += 1;
      continue;
    };

    let mut blockIndex: u64 = 0;

    while (blockIndex < function_.blocks.length()) {
      let Option::SOME(block) = function_.blocks.get(blockIndex) else {
        blockIndex += 1;
        continue;
      };

      let mut instrIndex: u64 = 0;

      while (instrIndex < block.instructions.length()) {
        if (let Option::SOME(instruction) = block.instructions.get(instrIndex)) {
          if (let Lir::Instr::MakeSlice(_) = instruction) {
            count += 1;
          }
        }

        instrIndex += 1;
      }

      blockIndex += 1;
    }

    functionIndex += 1;
  }

  return count;
}

/// Runs the whole front end over `source` and counts the slices LIR lowering
/// built for it.
function lirCountLoweredMakeSlice(source: str): u64 {
  let file: SourceFile = SourceFile::create("lowering_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(lirCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(lirCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(lirCountErrors(&output.diagnostics), 0);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let checked: Borrowck::BorrowckOutput = Borrowck::checkModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &hir,
  );

  Test::assertEq<u64>(lirCountErrors(&checked.diagnostics), 0);

  let constValues: Analyzer::ConstEval::ConstValueMap = Analyzer::ConstEval::ConstValueMap {
    defIdRaws: Vector::new<u32>(),
    values: Vector::new<Analyzer::ConstEval::ConstValue>(),
  };

  let lowered: LirLowering::LowerModuleResult = LirLowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &hir,
    &checked.dropSchedules,
    &constValues,
  );

  return lirCountMakeSlice(&lowered.program);
}

/// Scenario: an array flows into a slice parameter, a slice return type and a
/// slice-annotated binding. Each of the three positions needs the slice built
/// from the array's data pointer and its static length.
/// Spec: IGN-170 — array values satisfy a slice of the same element type.
@test
function lirLoweringBuildsSlicesWhereArraysFlowIntoSlicePositions(): void {
  let built: u64 = lirCountLoweredMakeSlice(
    "function first(values: i32[]): i32 {\n  return values[0];\n}\n\nfunction view(): i32[] {\n  let data: i32[2] = [4, 5];\n  return data;\n}\n\nfunction run(): i32 {\n  let data: i32[2] = [1, 2];\n  let held: i32[] = data;\n\n  return first(data) + held[1];\n}\n",
  );

  Test::assertEq<u64>(built, 3);
}

/// Scenario: an array bound to an array annotation and passed to an array
/// parameter. Nothing asks for a slice, so no slice is built.
/// Spec: IGN-170 — array values satisfy a slice of the same element type.
@test
function lirLoweringBuildsNoSliceWhenNoPositionAsksForOne(): void {
  let built: u64 = lirCountLoweredMakeSlice(
    "function first(values: i32[2]): i32 {\n  return values[0];\n}\n\nfunction run(): i32 {\n  let data: i32[2] = [1, 2];\n\n  return first(data);\n}\n",
  );

  Test::assertEq<u64>(built, 0);
}

/// Scenario: a binding whose initializer diverges, an assignment whose value
/// diverges, and a `let mut x;` waiting for its first assignment.
/// Spec: the slot carries the type the binding was declared with, and a store
/// fed by a value that never produces one is not emitted.
@test
function lirLoweringSkipsStoresFedByDivergingValues(): void {
  let rendered: String = lirRenderLoweredLocals(
    "function fromPanic(): u64 {\n  let value: u64 = @panic(\"init\");\n  return value;\n}\n\nfunction assignedFromPanic(flag: boolean): u64 {\n  let mut value: u64 = 5;\n\n  if (flag) {\n    value = @panic(\"bail\");\n  }\n\n  return value;\n}\n\nfunction deferred(): i32 {\n  let mut x;\n  x = 10;\n  return x;\n}\n",
  );

  Test::assertSnapshot("lir-lowering-diverging-stores", rendered.toStr());
}

/// Scenario: an owning local that falls out of scope, one whose value moved
/// into a call, and an early return out of an `if`.
/// Spec: IGN-39 — scope-end, exit and function-end drops reach the LIR.
@test
function lirLoweringEmitsScheduledDrops(): void {
  let rendered: String = lirRenderLoweredDrops(
    "@implements(Drop)\nrecord Owned {\n  public id: u32;\n}\n\nfunction consume(value: Owned): u32 {\n  return value.id;\n}\n\nfunction run(flag: boolean): u32 {\n  let kept: Owned = Owned { id: 1 };\n  let moved: Owned = Owned { id: 2 };\n  let taken: u32 = consume(moved);\n\n  if (flag) {\n    return taken;\n  }\n\n  return kept.id + taken;\n}\n",
  );

  Test::assertSnapshot("lir-lowering-scheduled-drops", rendered.toStr());
}

/// Scenario: values of an owning type produced by an expression and bound to
/// nothing — discarded at block end, discarded inside a loop that then
/// continues, and discarded before an early return. The last function reads a
/// named local as a statement, which owns nothing new and must not add a
/// second drop.
/// Spec: IGN-39 — owned temporaries reach the LIR as unnamed dropped locals.
@test
function lirLoweringDropsOwnedTemporaries(): void {
  let rendered: String = lirRenderLoweredDrops(
    "@implements(Drop)\nrecord Owned {\n  public id: u32;\n}\n\nfunction make(id: u32): Owned {\n  return Owned { id: id };\n}\n\nfunction discarded(): void {\n  make(1);\n}\n\nfunction discardedInLoop(limit: u32): void {\n  let mut index: u32 = 0;\n\n  while (index < limit) {\n    make(index);\n    index += 1;\n    continue;\n  }\n}\n\nfunction discardedBeforeReturn(flag: boolean): u32 {\n  make(7);\n\n  if (flag) {\n    return 1;\n  }\n\n  return 0;\n}\n\nfunction boundThenRead(): void {\n  let bound: Owned = make(3);\n  bound;\n}\n",
  );

  Test::assertSnapshot("lir-lowering-owned-temporaries", rendered.toStr());
}

/// Scenario: a let-else that destructures a variant payload reached through a
/// reference (`Lookup::FOUND(&Definition)`). The binding names storage the
/// store owns, so its slot is a borrowed alias and its scheduled drop must not
/// free anything.
/// Spec: IGN-39 — bindings through a reference alias, they do not own.
@test
function lirLoweringMarksBindingsThroughReferenceAsAliases(): void {
  let rendered: String = lirRenderLoweredDrops(
    "@implements(Drop)\nrecord Owned {\n  public id: u32;\n}\n\nenum Definition {\n  ITEM(Owned),\n  OTHER,\n}\n\nenum Lookup {\n  FOUND(&Definition),\n  MISSING,\n}\n\nfunction idOf(lookup: Lookup): u32 {\n  let Lookup::FOUND(Definition::ITEM(owned)) = lookup else {\n    return 0;\n  };\n\n  return owned.id;\n}\n",
  );

  Test::assertSnapshot("lir-lowering-binding-through-reference", rendered.toStr());
}

/// Scenario: a record literal takes a droppable field out of a local by
/// value. The load is followed by a move barrier so the local's scope-end
/// drop skips the field; a read through a reference gets no barrier.
/// Spec: IGN-39 — `should_mark_field_moved`.
@test
function lirLoweringMarksMovedFieldsOutOfOwnedBases(): void {
  let rendered: String = lirRenderLoweredDrops(
    "@implements(Drop)\nrecord Owned {\n  public id: u32;\n}\n\nrecord Holder {\n  public item: Owned;\n  public count: u32;\n}\n\nrecord Output {\n  public item: Owned;\n}\n\nfunction take(holder: Holder): Output {\n  return Output { item: holder.item };\n}\n\nfunction peek(holder: &Holder): u32 {\n  return holder.count;\n}\n",
  );

  Test::assertSnapshot("lir-lowering-mark-moved-field", rendered.toStr());
}

/// Scenario: `&&` guarding a division against a zero divisor, and `||` whose
/// right operand divides as well. Each right operand belongs to the block the
/// branch reaches only when the left operand did not already decide the answer.
/// Spec: `&&` skips its right operand on a false left, `||` on a true left.
@test
function lirLoweringPutsShortCircuitOperandsBehindABranch(): void {
  let rendered: String = lirRenderLoweredLocals(
    "function guarded(count: u64, stride: u64): boolean {\n  let total: u64 = count * stride;\n  return count != 0 && total / count != stride;\n}\n\nfunction fallback(flag: boolean, count: u64): boolean {\n  return flag || count / count == 1;\n}\n",
  );

  Test::assertSnapshot("lir-lowering-short-circuit", rendered.toStr());
}

/// Scenario: a `match` arm whose body is a second `match`, every arm of which
/// diverges, so the inner one carries the `never` type. A slot for it would be
/// declared with a C type that holds nothing.
/// Spec: neither `void` nor `never` reaches a merge point with a value, so
/// neither allocates a result slot.
@test
function lirLoweringAllocatesNoSlotForADivergingMatch(): void {
  let rendered: String = lirRenderLoweredSlotTypes(
    "enum Shade {\n  LIGHT,\n  DARK,\n}\n\nenum Holder {\n  FILLED(Shade),\n  EMPTY,\n}\n\nfunction classify(holder: Holder): i32 {\n  match (holder) {\n    Holder::FILLED(inner) -> match (inner) {\n      Shade::LIGHT -> {\n        return 1;\n      },\n      Shade::DARK -> @panic(\"dark\"),\n    },\n    Holder::EMPTY -> @panic(\"empty\"),\n  };\n\n  @panic(\"unreachable classify\");\n}\n",
  );

  Test::assertSnapshot("lir-lowering-diverging-match-slots", rendered.toStr());
}
