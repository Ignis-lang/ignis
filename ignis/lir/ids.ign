import Id from "@compiler::ids";

export namespace Lir {
  record BlockTag {}
  record LocalTag {}
  record TempTag {}

  /// Typed handle for basic blocks, mirroring `ignis_lir::BlockId`.
  type BlockId = Id<Lir::BlockTag>;

  /// Typed handle for local slots, mirroring `ignis_lir::LocalId`.
  type LocalId = Id<Lir::LocalTag>;

  /// Typed handle for temporaries, mirroring `ignis_lir::TempId`.
  type TempId = Id<Lir::TempTag>;
}
