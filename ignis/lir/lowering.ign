import Vector from "std::vector";

import SourceSpan from "@compiler::diagnostics";
import Id from "@compiler::ids";
import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import Lir from "./mod";

/// HIR -> LIR lowering for the selfhost compiler (IGN-155), grown with the
/// same measured-loop discipline as the AST -> HIR slice: every construct
/// outside the supported core emits `Instr::Nop`, bumps the state's
/// `unsupported` counter and keeps going, so one full-corpus run yields the
/// exact distance left instead of stopping at the first gap.
export namespace LirLowering {
  /// Per-function lowering state. Locals are mapped by raw definition id,
  /// parallel-vector style like `Lowering::LocalMap`.
  record LowerState {
    public unsupported: u64;
    public localDefRaws: Vector<u32>;
    public localSlotRaws: Vector<u32>;
    public currentBlock: u64;
    /// True once the current block got its real terminator: later terminators
    /// are dropped, mirroring the oracle builder guard.
    public terminated: boolean;
    public breakBlockRaws: Vector<u32>;
    public continueBlockRaws: Vector<u32>;

    public static init(): LowerState {
      return LowerState {
        unsupported: 0,
        localDefRaws: Vector::new<u32>(),
        localSlotRaws: Vector::new<u32>(),
        currentBlock: 0,
        terminated: false,
        breakBlockRaws: Vector::new<u32>(),
        continueBlockRaws: Vector::new<u32>(),
      };
    }
  }

  /// The whole-module result: one function table plus the unsupported count
  /// the measured loop tracks.
  record LowerModuleResult {
    public program: Lir::LirProgram;
    public unsupported: u64;
    public loweredFunctions: u64;
  }

  /// Debug label of a HIR node kind, used by the measured loop to bucket
  /// unsupported constructs.
  function hirKindLabel(kind: &Hir::HirKind): str {
    return match (kind) {
      Hir::HirKind::Literal(_) -> "Literal",
      Hir::HirKind::Unit -> "Unit",
      Hir::HirKind::Variable(_) -> "Variable",
      Hir::HirKind::Binary(_) -> "Binary",
      Hir::HirKind::Unary(_) -> "Unary",
      Hir::HirKind::Call(_) -> "Call",
      Hir::HirKind::CallClosure(_) -> "CallClosure",
      Hir::HirKind::Closure(_) -> "Closure",
      Hir::HirKind::Cast(_) -> "Cast",
      Hir::HirKind::BitCast(_) -> "BitCast",
      Hir::HirKind::Reference(_) -> "Reference",
      Hir::HirKind::Dereference(_) -> "Dereference",
      Hir::HirKind::Index(_) -> "Index",
      Hir::HirKind::VectorLiteral(_) -> "VectorLiteral",
      Hir::HirKind::TupleLiteral(_) -> "TupleLiteral",
      Hir::HirKind::MakeSlice(_) -> "MakeSlice",
      Hir::HirKind::TypeOf(_) -> "TypeOf",
      Hir::HirKind::SizeOf(_) -> "SizeOf",
      Hir::HirKind::AlignOf(_) -> "AlignOf",
      Hir::HirKind::MaxOf(_) -> "MaxOf",
      Hir::HirKind::MinOf(_) -> "MinOf",
      Hir::HirKind::BuiltinLoad(_) -> "BuiltinLoad",
      Hir::HirKind::BuiltinStore(_) -> "BuiltinStore",
      Hir::HirKind::BuiltinHash(_) -> "BuiltinHash",
      Hir::HirKind::BuiltinEq(_) -> "BuiltinEq",
      Hir::HirKind::BuiltinDropInPlace(_) -> "BuiltinDropInPlace",
      Hir::HirKind::BuiltinDropGlue(_) -> "BuiltinDropGlue",
      Hir::HirKind::Panic(_) -> "Panic",
      Hir::HirKind::Trap -> "Trap",
      Hir::HirKind::BuiltinUnreachable -> "BuiltinUnreachable",
      Hir::HirKind::FieldAccess(_) -> "FieldAccess",
      Hir::HirKind::RecordInit(_) -> "RecordInit",
      Hir::HirKind::MethodCall(_) -> "MethodCall",
      Hir::HirKind::EnumVariant(_) -> "EnumVariant",
      Hir::HirKind::StaticAccess(_) -> "StaticAccess",
      Hir::HirKind::Let(_) -> "Let",
      Hir::HirKind::Assign(_) -> "Assign",
      Hir::HirKind::Block(_) -> "Block",
      Hir::HirKind::If(_) -> "If",
      Hir::HirKind::LetElse(_) -> "LetElse",
      Hir::HirKind::Loop(_) -> "Loop",
      Hir::HirKind::Break -> "Break",
      Hir::HirKind::Continue -> "Continue",
      Hir::HirKind::Return(_) -> "Return",
      Hir::HirKind::Defer(_) -> "Defer",
      Hir::HirKind::ExpressionStatement(_) -> "ExpressionStatement",
      Hir::HirKind::Match(_) -> "Match",
      Hir::HirKind::Error -> "Error",
    };
  }

  function pushInstr(
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    instr: Lir::Instr,
  ): void {
    let mut functionRef: &mut Lir::FunctionLir = function_;

    let Option::SOME(block) = functionRef.blocks.getMut(state.currentBlock) else {
      return;
    };

    block.instructions.push(instr);
  }

  function createBlock(function_: &mut Lir::FunctionLir, label: str): Lir::BlockId {
    let mut functionRef: &mut Lir::FunctionLir = function_;

    return functionRef.allocBlock(Lir::Block::create(String::create(label)));
  }

  function switchToBlock(state: &mut LirLowering::LowerState, block: Lir::BlockId): void {
    state.currentBlock = block.raw() as u64;
    state.terminated = false;
  }

  /// Sets the current block's terminator unless one is already in place.
  function terminate(
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    terminator: Lir::Terminator,
  ): void {
    if (state.terminated) {
      return;
    }

    let mut functionRef: &mut Lir::FunctionLir = function_;

    let Option::SOME(block) = functionRef.blocks.getMut(state.currentBlock) else {
      return;
    };

    block.terminator = terminator;
    state.terminated = true;
  }

  function isVoidType(typeStore: &mut Analyzer::TypeStore, ty: Analyzer::TypeId): boolean {
    if (let Option::SOME(typeNode) = typeStore.get(ty)) {
      if (let Analyzer::Type::VOID = typeNode) {
        return true;
      }
    }

    return false;
  }

  function isPointerLikeType(typeStore: &mut Analyzer::TypeStore, ty: Analyzer::TypeId): boolean {
    if (let Option::SOME(typeNode) = typeStore.get(ty)) {
      return match (typeNode) {
        Analyzer::Type::Pointer(_) -> true,
        Analyzer::Type::Reference(_) -> true,
        _ -> false,
      };
    }

    return false;
  }

  /// Allocates an anonymous slot for a value the next instruction needs an
  /// address for, the oracle's synthetic local.
  function allocSyntheticLocal(
    function_: &mut Lir::FunctionLir,
    ty: Analyzer::TypeId,
  ): Lir::LocalId {
    let mut functionRef: &mut Lir::FunctionLir = function_;

    return functionRef.allocLocal(Lir::LocalData {
      defId: Option::NONE,
      ty: ty,
      mutable: true,
      name: Option::NONE,
      borrowedAlias: false,
    });
  }

  function markUnsupported(
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
  ): void {
    state.unsupported += 1;
    LirLowering::pushInstr(function_, state, Lir::Instr::Nop);
  }

  function lookupLocal(
    state: &mut LirLowering::LowerState,
    defId: Analyzer::DefinitionId,
  ): Option<Lir::LocalId> {
    let mut index: u64 = 0;

    while (index < state.localDefRaws.length()) {
      if (let Option::SOME(raw) = state.localDefRaws.get(index)) {
        if (*raw == defId.raw()) {
          let Option::SOME(slotRaw) = state.localSlotRaws.get(index) else {
            return Option::NONE;
          };

          return Option::SOME(Id::fromRaw<Lir::LocalTag>(*slotRaw));
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  function registerLocal(
    state: &mut LirLowering::LowerState,
    defId: Analyzer::DefinitionId,
    slot: Lir::LocalId,
  ): void {
    state.localDefRaws.push(defId.raw());
    state.localSlotRaws.push(slot.raw());
  }

  function freshTemp(
    function_: &mut Lir::FunctionLir,
    ty: Analyzer::TypeId,
    span: SourceSpan,
  ): Lir::TempId {
    let mut functionRef: &mut Lir::FunctionLir = function_;

    return functionRef.allocTemp(Lir::TempData {
      ty: ty,
      span: span,
    });
  }

  /// Maps a HIR literal to a LIR constant. Every numeric width widens into
  /// the Rust model's `Int`/`UInt`/`Float` carriers with the node's own type.
  function constFromLiteral(
    literal: &Hir::LiteralValue,
    ty: Analyzer::TypeId,
  ): Option<Lir::ConstValue> {
    return match (literal) {
      Hir::LiteralValue::Int8(value) -> Option::SOME(Lir::ConstValue::Int(value as i64, ty)),
      Hir::LiteralValue::Int16(value) -> Option::SOME(Lir::ConstValue::Int(value as i64, ty)),
      Hir::LiteralValue::Int32(value) -> Option::SOME(Lir::ConstValue::Int(value as i64, ty)),
      Hir::LiteralValue::Int64(value) -> Option::SOME(Lir::ConstValue::Int(value, ty)),
      Hir::LiteralValue::UnsignedInt8(value) -> Option::SOME(Lir::ConstValue::UInt(value as u64, ty)),
      Hir::LiteralValue::UnsignedInt16(value) -> Option::SOME(Lir::ConstValue::UInt(value as u64, ty)),
      Hir::LiteralValue::UnsignedInt32(value) -> Option::SOME(Lir::ConstValue::UInt(value as u64, ty)),
      Hir::LiteralValue::UnsignedInt64(value) -> Option::SOME(Lir::ConstValue::UInt(value, ty)),
      Hir::LiteralValue::Float32(value) -> Option::SOME(Lir::ConstValue::Float(value as f64, ty)),
      Hir::LiteralValue::Float64(value) -> Option::SOME(Lir::ConstValue::Float(value, ty)),
      Hir::LiteralValue::Boolean(value) -> Option::SOME(Lir::ConstValue::Bool(value, ty)),
      Hir::LiteralValue::Char(value) -> Option::SOME(Lir::ConstValue::Char(value, ty)),
      Hir::LiteralValue::String(value) -> Option::SOME(Lir::ConstValue::Str(value.clone(), ty)),
      Hir::LiteralValue::Atom(symbol) -> Option::SOME(Lir::ConstValue::Atom(symbol.raw(), ty)),
      Hir::LiteralValue::Hex(digits) -> Option::SOME(Lir::ConstValue::UInt(LirLowering::parseRadixDigits(&digits, 16), ty)),
      Hir::LiteralValue::Binary(digits) -> Option::SOME(Lir::ConstValue::UInt(LirLowering::parseRadixDigits(&digits, 2), ty)),
      Hir::LiteralValue::Null -> Option::SOME(Lir::ConstValue::Null(ty)),
    };
  }

  /// Parses the digit run of a hex or binary literal (the lexeme without the
  /// `0x`/`0b` prefix, though a leading prefix is skipped defensively) into
  /// its unsigned bit pattern, the oracle's `from_str_radix` with 0 on any
  /// malformed digit.
  function parseRadixDigits(digits: &String, radix: u64): u64 {
    let mut result: u64 = 0;
    let mut index: u64 = 0;

    if (digits.length() >= 2) {
      if (let Option::SOME(first) = digits.charAt(0)) {
        if (first == '0') {
          if (let Option::SOME(second) = digits.charAt(1)) {
            if (second == 'x' || second == 'X' || second == 'b' || second == 'B') {
              index = 2;
            }
          }
        }
      }
    }

    while (index < digits.length()) {
      let Option::SOME(character) = digits.charAt(index) else {
        return 0;
      };

      let mut digit: u64 = 0;

      if (character >= '0' && character <= '9') {
        digit = (character as u64) - ('0' as u64);
      } else if (character >= 'a' && character <= 'f') {
        digit = (character as u64) - ('a' as u64) + 10;
      } else if (character >= 'A' && character <= 'F') {
        digit = (character as u64) - ('A' as u64) + 10;
      } else if (character == '_') {
        index += 1;
        continue;
      } else {
        return 0;
      }

      if (digit >= radix) {
        return 0;
      }

      result = result * radix + digit;
      index += 1;
    }

    return result;
  }

  /// Lowers one HIR expression tree to an operand, appending instructions to
  /// the state's current block. Unsupported constructs count once and yield
  /// `Undef` of the node's type.
  function lowerExpr(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hirStore: &Hir::HirStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    hirId: Hir::HirId,
  ): Lir::Operand {
    let Option::SOME(node) = hirStore.get(hirId) else {
      state.unsupported += 1;
      return Lir::Operand::Const(Lir::ConstValue::Undef(function_.returnType));
    };

    let nodeType: Analyzer::TypeId = node.typeId;
    let nodeSpan: SourceSpan = node.span;

    match (&node.kind) {
      Hir::HirKind::Literal(literal) -> {
        if (let Option::SOME(constant) = LirLowering::constFromLiteral(&literal, nodeType)) {
          return Lir::Operand::Const(constant);
        }

        LirLowering::markUnsupported(function_, state);
        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Unit -> {
        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Variable(defId) -> {
        if (let Option::SOME(slot) = LirLowering::lookupLocal(state, defId)) {
          let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

          LirLowering::pushInstr(function_, state, Lir::Instr::Load(Lir::InstrLoad {
            dest: dest,
            source: slot,
          }));

          return Lir::Operand::Temp(dest);
        }

        return Lir::Operand::GlobalRef(defId);
      },
      Hir::HirKind::Binary(binaryNode) -> {
        let left: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, binaryNode.left);
        let right: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, binaryNode.right);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::BinOp(Lir::InstrBinOp {
          dest: dest,
          op: binaryNode.operation,
          left: left,
          right: right,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::Call(call) -> {
        let mut args: Vector<Lir::Operand> = Vector::new<Lir::Operand>();
        let mut argIndex: u64 = 0;

        while (argIndex < call.args.length()) {
          if (let Option::SOME(argId) = call.args.get(argIndex)) {
            args.push(LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, *argId));
          }

          argIndex += 1;
        }

        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::Call(Lir::InstrCall {
          dest: Option::SOME(dest),
          callee: call.callee,
          args: args,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::Let(letNode) -> {
        let mut declaredType: Analyzer::TypeId = nodeType;
        let mut mutable: boolean = false;
        let mut name: Option<String> = Option::NONE;

        if (let Option::SOME(definition) = defStore.get(letNode.name)) {
          if (let Analyzer::Definition::Variable(variableDef) = definition) {
            declaredType = variableDef.declaredType;
            mutable = variableDef.mutable;
          }
        }

        let mut allocFunctionRef: &mut Lir::FunctionLir = function_;
        let slot: Lir::LocalId = allocFunctionRef.allocLocal(Lir::LocalData {
          defId: Option::SOME(letNode.name),
          ty: declaredType,
          mutable: mutable,
          name: name,
          borrowedAlias: false,
        });

        LirLowering::registerLocal(state, letNode.name, slot);

        if (let Option::SOME(valueId) = letNode.value) {
          let value: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, valueId);

          LirLowering::pushInstr(function_, state, Lir::Instr::Store(Lir::InstrStore {
            dest: slot,
            value: value,
          }));
        }

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Block(block) -> {
        let mut statementIndex: u64 = 0;

        while (statementIndex < block.statements.length()) {
          if (let Option::SOME(statementId) = block.statements.get(statementIndex)) {
            let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, *statementId);
          }

          statementIndex += 1;
        }

        if (let Option::SOME(valueId) = block.expression) {
          return LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, valueId);
        }

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::ExpressionStatement(innerId) -> {
        let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, innerId);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Return(valueOpt) -> {
        let mut returned: Option<Lir::Operand> = Option::NONE;

        if (let Option::SOME(valueId) = valueOpt) {
          returned = Option::SOME(LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, valueId));
        }

        let mut returnFunctionRef: &mut Lir::FunctionLir = function_;

        let Option::SOME(block) = returnFunctionRef.blocks.getMut(state.currentBlock) else {
          return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
        };

        block.terminator = Lir::Terminator::Return(returned);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Unary(unaryNode) -> {
        let operand: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, unaryNode.operand);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::UnaryOp(Lir::InstrUnaryOp {
          dest: dest,
          op: unaryNode.operation,
          operand: operand,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::Cast(castNode) -> {
        let source: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, castNode.expression);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, castNode.target, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::Cast(Lir::InstrCast {
          dest: dest,
          source: source,
          targetType: castNode.target,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::BitCast(castNode) -> {
        let source: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, castNode.expression);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, castNode.target, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::BitCast(Lir::InstrCast {
          dest: dest,
          source: source,
          targetType: castNode.target,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::Dereference(innerId) -> {
        let pointer: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, innerId);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::LoadPtr(Lir::InstrLoadPtr {
          dest: dest,
          ptr: pointer,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::Index(indexNode) -> {
        let base: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, indexNode.base);
        let indexOperand: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, indexNode.index);

        let mut pointerTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let elementPtrType: Analyzer::TypeId = pointerTypeStoreRef.pointer(nodeType);
        let elementPtr: Lir::TempId = LirLowering::freshTemp(function_, elementPtrType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::GetElementPtr(Lir::InstrGetElementPtr {
          dest: elementPtr,
          base: base,
          index: indexOperand,
          elementType: nodeType,
        }));

        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::LoadPtr(Lir::InstrLoadPtr {
          dest: dest,
          ptr: Lir::Operand::Temp(elementPtr),
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::VectorLiteral(elements) -> {
        let mut elementType: Option<Analyzer::TypeId> = Option::NONE;

        if (let Option::SOME(typeNode) = typeStore.get(nodeType)) {
          if (let Analyzer::Type::FixedArray(element, _) = typeNode) {
            elementType = Option::SOME(element);
          }
        }

        let Option::SOME(element) = elementType else {
          LirLowering::markUnsupported(function_, state);

          return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
        };

        let local: Lir::LocalId = LirLowering::allocSyntheticLocal(function_, nodeType);

        let mut elementOperands: Vector<Lir::Operand> = Vector::new<Lir::Operand>();
        let mut elementIndex: u64 = 0;

        while (elementIndex < elements.length()) {
          if (let Option::SOME(elementId) = elements.get(elementIndex)) {
            elementOperands.push(LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, *elementId));
          }

          elementIndex += 1;
        }

        let mut vectorPtrTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let elementPtrType: Analyzer::TypeId = vectorPtrTypeStoreRef.pointer(element);
        let vectorPtr: Lir::TempId = LirLowering::freshTemp(function_, elementPtrType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::AddrOfLocal(Lir::InstrAddrOfLocal {
          dest: vectorPtr,
          local: local,
          mutable: true,
        }));

        LirLowering::pushInstr(function_, state, Lir::Instr::InitVector(Lir::InstrInitVector {
          destPtr: Lir::Operand::Temp(vectorPtr),
          elements: elementOperands,
          elementType: element,
        }));

        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::Load(Lir::InstrLoad {
          dest: dest,
          source: local,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::MakeSlice(sliceNode) -> {
        let data: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, sliceNode.data);
        let len: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, sliceNode.len);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::MakeSlice(Lir::InstrMakeSlice {
          dest: dest,
          data: data,
          len: len,
          elementType: sliceNode.elementType,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::SizeOf(ty) -> {
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::SizeOf(Lir::InstrTypeQuery {
          dest: dest,
          ty: ty,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::AlignOf(ty) -> {
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::AlignOf(Lir::InstrTypeQuery {
          dest: dest,
          ty: ty,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::MaxOf(ty) -> {
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::MaxOf(Lir::InstrTypeQuery {
          dest: dest,
          ty: ty,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::MinOf(ty) -> {
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::MinOf(Lir::InstrTypeQuery {
          dest: dest,
          ty: ty,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::BuiltinLoad(loadNode) -> {
        let pointer: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, loadNode.ptr);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, loadNode.ty, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::BuiltinLoad(Lir::InstrBuiltinLoad {
          dest: dest,
          ptr: pointer,
          ty: loadNode.ty,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::BuiltinStore(storeNode) -> {
        let pointer: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, storeNode.ptr);
        let value: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, storeNode.value);

        LirLowering::pushInstr(function_, state, Lir::Instr::BuiltinStore(Lir::InstrBuiltinStore {
          ptr: pointer,
          value: value,
          ty: storeNode.ty,
        }));

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::BuiltinHash(hashNode) -> {
        let value: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, hashNode.value);
        let hasher: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, hashNode.hasher);

        LirLowering::pushInstr(function_, state, Lir::Instr::BuiltinHash(Lir::InstrBuiltinHash {
          value: value,
          hasher: hasher,
          ty: hashNode.ty,
        }));

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::BuiltinEq(eqNode) -> {
        let left: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, eqNode.left);
        let right: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, eqNode.right);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        let kind: Lir::BuiltinEqKind = match (&eqNode.kind) {
          Hir::BuiltinEqKind::Primitive -> Lir::BuiltinEqKind::Primitive,
          Hir::BuiltinEqKind::Str -> Lir::BuiltinEqKind::Str,
          Hir::BuiltinEqKind::Method(methodDef) -> Lir::BuiltinEqKind::Method(methodDef),
          Hir::BuiltinEqKind::Pending -> Lir::BuiltinEqKind::Primitive,
        };

        LirLowering::pushInstr(function_, state, Lir::Instr::BuiltinEq(Lir::InstrBuiltinEq {
          dest: dest,
          left: left,
          right: right,
          ty: eqNode.ty,
          kind: kind,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::BuiltinDropInPlace(dropNode) -> {
        let pointer: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, dropNode.ptr);

        LirLowering::pushInstr(function_, state, Lir::Instr::DropInPlace(Lir::InstrDropInPlace {
          ptr: pointer,
          ty: dropNode.ty,
        }));

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::BuiltinDropGlue(ty) -> {
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::DropGlue(Lir::InstrDropGlue {
          dest: dest,
          ty: ty,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::TypeOf(innerId) -> {
        let source: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, innerId);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::TypeIdOf(Lir::InstrTypeIdOf {
          dest: dest,
          source: source,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::Panic(messageId) -> {
        let mut message: String = String::create("<non-literal panic>");

        if (let Option::SOME(messageNode) = hirStore.get(messageId)) {
          if (let Hir::HirKind::Literal(literal) = &messageNode.kind) {
            if (let Hir::LiteralValue::String(text) = literal) {
              message = text.clone();
            }
          }
        }

        LirLowering::pushInstr(function_, state, Lir::Instr::PanicMessage(Lir::InstrPanicMessage {
          message: message,
          span: nodeSpan,
        }));
        LirLowering::terminate(function_, state, Lir::Terminator::Unreachable);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Trap -> {
        LirLowering::pushInstr(function_, state, Lir::Instr::Trap(Lir::InstrTrap {
          span: nodeSpan,
        }));
        LirLowering::terminate(function_, state, Lir::Terminator::Unreachable);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::BuiltinUnreachable -> {
        LirLowering::terminate(function_, state, Lir::Terminator::Unreachable);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::FieldAccess(fieldNode) -> {
        let basePtr: Lir::Operand = LirLowering::lowerPlacePtr(defStore, typeStore, hirStore, function_, state, fieldNode.base);

        let mut fieldPtrTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let fieldPtrType: Analyzer::TypeId = fieldPtrTypeStoreRef.pointer(nodeType);
        let fieldPtr: Lir::TempId = LirLowering::freshTemp(function_, fieldPtrType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::GetFieldPtr(Lir::InstrGetFieldPtr {
          dest: fieldPtr,
          base: basePtr,
          fieldIndex: fieldNode.fieldIndex,
          fieldType: nodeType,
        }));

        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::LoadPtr(Lir::InstrLoadPtr {
          dest: dest,
          ptr: Lir::Operand::Temp(fieldPtr),
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::Reference(referenceNode) -> {
        return LirLowering::lowerPlacePtr(defStore, typeStore, hirStore, function_, state, referenceNode.expression);
      },
      Hir::HirKind::RecordInit(recordNode) -> {
        let local: Lir::LocalId = LirLowering::allocSyntheticLocal(function_, nodeType);

        let mut fieldOperands: Vector<Lir::InitRecordField> = Vector::new<Lir::InitRecordField>();
        let mut fieldIndex: u64 = 0;

        while (fieldIndex < recordNode.fields.length()) {
          if (let Option::SOME(field) = recordNode.fields.get(fieldIndex)) {
            fieldOperands.push(Lir::InitRecordField {
              fieldIndex: field.fieldIndex,
              value: LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, field.value),
            });
          }

          fieldIndex += 1;
        }

        let mut recordPtrTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let recordPtrType: Analyzer::TypeId = recordPtrTypeStoreRef.pointer(nodeType);
        let recordPtr: Lir::TempId = LirLowering::freshTemp(function_, recordPtrType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::AddrOfLocal(Lir::InstrAddrOfLocal {
          dest: recordPtr,
          local: local,
          mutable: true,
        }));

        LirLowering::pushInstr(function_, state, Lir::Instr::InitRecord(Lir::InstrInitRecord {
          destPtr: Lir::Operand::Temp(recordPtr),
          fields: fieldOperands,
          recordType: nodeType,
        }));

        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::Load(Lir::InstrLoad {
          dest: dest,
          source: local,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::EnumVariant(variantNode) -> {
        let local: Lir::LocalId = LirLowering::allocSyntheticLocal(function_, nodeType);

        let mut payloadOperands: Vector<Lir::Operand> = Vector::new<Lir::Operand>();
        let mut payloadIndex: u64 = 0;

        while (payloadIndex < variantNode.payload.length()) {
          if (let Option::SOME(payloadId) = variantNode.payload.get(payloadIndex)) {
            payloadOperands.push(LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, *payloadId));
          }

          payloadIndex += 1;
        }

        let mut enumPtrTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let enumPtrType: Analyzer::TypeId = enumPtrTypeStoreRef.pointer(nodeType);
        let enumPtr: Lir::TempId = LirLowering::freshTemp(function_, enumPtrType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::AddrOfLocal(Lir::InstrAddrOfLocal {
          dest: enumPtr,
          local: local,
          mutable: true,
        }));

        LirLowering::pushInstr(function_, state, Lir::Instr::InitEnumVariant(Lir::InstrInitEnumVariant {
          destPtr: Lir::Operand::Temp(enumPtr),
          enumType: nodeType,
          variantTag: variantNode.variantTag,
          payload: payloadOperands,
        }));

        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::Load(Lir::InstrLoad {
          dest: dest,
          source: local,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::MethodCall(methodNode) -> {
        let mut callArgs: Vector<Lir::Operand> = Vector::new<Lir::Operand>();

        if (let Option::SOME(receiverId) = methodNode.receiver) {
          callArgs.push(LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, receiverId));
        }

        let mut argIndex: u64 = 0;

        while (argIndex < methodNode.args.length()) {
          if (let Option::SOME(argId) = methodNode.args.get(argIndex)) {
            callArgs.push(LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, *argId));
          }

          argIndex += 1;
        }

        if (LirLowering::isVoidType(typeStore, nodeType)) {
          LirLowering::pushInstr(function_, state, Lir::Instr::Call(Lir::InstrCall {
            dest: Option::NONE,
            callee: methodNode.method,
            args: callArgs,
          }));

          return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
        }

        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::Call(Lir::InstrCall {
          dest: Option::SOME(dest),
          callee: methodNode.method,
          args: callArgs,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::CallClosure(closureCallNode) -> {
        let closure: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, closureCallNode.callee);

        let mut closureArgs: Vector<Lir::Operand> = Vector::new<Lir::Operand>();
        let mut argIndex: u64 = 0;

        while (argIndex < closureCallNode.args.length()) {
          if (let Option::SOME(argId) = closureCallNode.args.get(argIndex)) {
            closureArgs.push(LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, *argId));
          }

          argIndex += 1;
        }

        if (LirLowering::isVoidType(typeStore, nodeType)) {
          LirLowering::pushInstr(function_, state, Lir::Instr::CallClosure(Lir::InstrCallClosure {
            dest: Option::NONE,
            closure: closure,
            args: closureArgs,
            returnType: nodeType,
          }));

          return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
        }

        let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::CallClosure(Lir::InstrCallClosure {
          dest: Option::SOME(dest),
          closure: closure,
          args: closureArgs,
          returnType: nodeType,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirKind::StaticAccess(defId) -> {
        return Lir::Operand::GlobalRef(defId);
      },
      Hir::HirKind::Assign(assignNode) -> {
        LirLowering::lowerAssign(defStore, typeStore, hirStore, function_, state, &assignNode);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::If(ifNode) -> {
        return LirLowering::lowerIf(defStore, typeStore, hirStore, function_, state, &ifNode, nodeType, nodeSpan);
      },
      Hir::HirKind::Loop(loopNode) -> {
        LirLowering::lowerLoop(defStore, typeStore, hirStore, function_, state, &loopNode);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Break -> {
        let breakLength: u64 = state.breakBlockRaws.length();

        if (breakLength > 0) {
          if (let Option::SOME(targetRaw) = state.breakBlockRaws.get(breakLength - 1)) {
            LirLowering::terminate(function_, state, Lir::Terminator::Goto(Id::fromRaw<Lir::BlockTag>(*targetRaw)));
          }
        }

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Continue -> {
        let continueLength: u64 = state.continueBlockRaws.length();

        if (continueLength > 0) {
          if (let Option::SOME(targetRaw) = state.continueBlockRaws.get(continueLength - 1)) {
            LirLowering::terminate(function_, state, Lir::Terminator::Goto(Id::fromRaw<Lir::BlockTag>(*targetRaw)));
          }
        }

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Match(matchNode) -> {
        return LirLowering::lowerMatch(defStore, typeStore, hirStore, function_, state, &matchNode, nodeType, nodeSpan);
      },
      Hir::HirKind::LetElse(letElseNode) -> {
        LirLowering::lowerLetElse(defStore, typeStore, hirStore, function_, state, &letElseNode, nodeSpan);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      Hir::HirKind::Defer(_) -> {
        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
      _ -> {
        LirLowering::markUnsupported(function_, state);

        return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
      },
    };
  }

  /// Pointer to the storage a place expression names, mirroring the oracle's
  /// lvalue paths: a pointer-typed base passes through, a local variable
  /// takes its address, a nested field access chains `GetFieldPtr`, and any
  /// other value spills to a synthetic local first.
  function lowerPlacePtr(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hirStore: &Hir::HirStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    hirId: Hir::HirId,
  ): Lir::Operand {
    let Option::SOME(node) = hirStore.get(hirId) else {
      state.unsupported += 1;
      return Lir::Operand::Const(Lir::ConstValue::Undef(function_.returnType));
    };

    let nodeType: Analyzer::TypeId = node.typeId;
    let nodeSpan: SourceSpan = node.span;

    if (LirLowering::isPointerLikeType(typeStore, nodeType)) {
      return LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, hirId);
    }

    if (let Hir::HirKind::Variable(defId) = &node.kind) {
      if (let Option::SOME(slot) = LirLowering::lookupLocal(state, defId)) {
        let mut ptrTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let ptrType: Analyzer::TypeId = ptrTypeStoreRef.pointer(nodeType);
        let dest: Lir::TempId = LirLowering::freshTemp(function_, ptrType, nodeSpan);

        LirLowering::pushInstr(function_, state, Lir::Instr::AddrOfLocal(Lir::InstrAddrOfLocal {
          dest: dest,
          local: slot,
          mutable: true,
        }));

        return Lir::Operand::Temp(dest);
      }
    }

    if (let Hir::HirKind::Dereference(innerId) = &node.kind) {
      return LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, innerId);
    }

    if (let Hir::HirKind::FieldAccess(fieldNode) = &node.kind) {
      let basePtr: Lir::Operand = LirLowering::lowerPlacePtr(defStore, typeStore, hirStore, function_, state, fieldNode.base);

      let mut fieldPtrTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let fieldPtrType: Analyzer::TypeId = fieldPtrTypeStoreRef.pointer(nodeType);
      let fieldPtr: Lir::TempId = LirLowering::freshTemp(function_, fieldPtrType, nodeSpan);

      LirLowering::pushInstr(function_, state, Lir::Instr::GetFieldPtr(Lir::InstrGetFieldPtr {
        dest: fieldPtr,
        base: basePtr,
        fieldIndex: fieldNode.fieldIndex,
        fieldType: nodeType,
      }));

      return Lir::Operand::Temp(fieldPtr);
    }

    let value: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, hirId);
    let spill: Lir::LocalId = LirLowering::allocSyntheticLocal(function_, nodeType);

    LirLowering::pushInstr(function_, state, Lir::Instr::Store(Lir::InstrStore {
      dest: spill,
      value: value,
    }));

    let mut spillPtrTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
    let spillPtrType: Analyzer::TypeId = spillPtrTypeStoreRef.pointer(nodeType);
    let dest: Lir::TempId = LirLowering::freshTemp(function_, spillPtrType, nodeSpan);

    LirLowering::pushInstr(function_, state, Lir::Instr::AddrOfLocal(Lir::InstrAddrOfLocal {
      dest: dest,
      local: spill,
      mutable: false,
    }));

    return Lir::Operand::Temp(dest);
  }

  /// `target = value` and `target op= value`. A plain local stores directly;
  /// every other target goes through its place pointer and `StorePtr`.
  function lowerAssign(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hirStore: &Hir::HirStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    assignNode: &Hir::HirAssign,
  ): void {
    let mut targetType: Analyzer::TypeId = function_.returnType;
    let mut targetIsLocal: boolean = false;
    let mut targetSlot: Lir::LocalId = Id::fromRaw<Lir::LocalTag>(0);

    if (let Option::SOME(targetNode) = hirStore.get(assignNode.target)) {
      targetType = targetNode.typeId;

      if (let Hir::HirKind::Variable(defId) = &targetNode.kind) {
        if (let Option::SOME(slot) = LirLowering::lookupLocal(state, defId)) {
          targetIsLocal = true;
          targetSlot = slot;
        }
      }
    }

    if (targetIsLocal) {
      if (let Option::SOME(operation) = assignNode.operation) {
        let current: Lir::TempId = LirLowering::freshTemp(function_, targetType, SourceSpan::new("", 0, 0));

        LirLowering::pushInstr(function_, state, Lir::Instr::Load(Lir::InstrLoad {
          dest: current,
          source: targetSlot,
        }));

        let rhs: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, assignNode.value);
        let result: Lir::TempId = LirLowering::freshTemp(function_, targetType, SourceSpan::new("", 0, 0));

        LirLowering::pushInstr(function_, state, Lir::Instr::BinOp(Lir::InstrBinOp {
          dest: result,
          op: operation,
          left: Lir::Operand::Temp(current),
          right: rhs,
        }));

        LirLowering::pushInstr(function_, state, Lir::Instr::Store(Lir::InstrStore {
          dest: targetSlot,
          value: Lir::Operand::Temp(result),
        }));

        return;
      }

      let value: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, assignNode.value);

      LirLowering::pushInstr(function_, state, Lir::Instr::Store(Lir::InstrStore {
        dest: targetSlot,
        value: value,
      }));

      return;
    }

    let targetPtr: Lir::Operand = LirLowering::lowerPlacePtr(defStore, typeStore, hirStore, function_, state, assignNode.target);

    if (let Option::SOME(operation) = assignNode.operation) {
      // A place pointer is always a temp; the temp id copies, so the same
      // pointer reads the old value and receives the new one.
      let Lir::Operand::Temp(ptrTemp) = targetPtr else {
        state.unsupported += 1;
        return;
      };

      let current: Lir::TempId = LirLowering::freshTemp(function_, targetType, SourceSpan::new("", 0, 0));

      LirLowering::pushInstr(function_, state, Lir::Instr::LoadPtr(Lir::InstrLoadPtr {
        dest: current,
        ptr: Lir::Operand::Temp(ptrTemp),
      }));

      let rhs: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, assignNode.value);
      let result: Lir::TempId = LirLowering::freshTemp(function_, targetType, SourceSpan::new("", 0, 0));

      LirLowering::pushInstr(function_, state, Lir::Instr::BinOp(Lir::InstrBinOp {
        dest: result,
        op: operation,
        left: Lir::Operand::Temp(current),
        right: rhs,
      }));

      LirLowering::pushInstr(function_, state, Lir::Instr::StorePtr(Lir::InstrStorePtr {
        ptr: Lir::Operand::Temp(ptrTemp),
        value: Lir::Operand::Temp(result),
      }));

      return;
    }

    let value: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, assignNode.value);

    LirLowering::pushInstr(function_, state, Lir::Instr::StorePtr(Lir::InstrStorePtr {
      ptr: targetPtr,
      value: value,
    }));
  }

  function booleanTypeId(typeStore: &mut Analyzer::TypeStore): Analyzer::TypeId {
    let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
    return typeStoreRef.intern(Analyzer::Type::BOOLEAN);
  }

  function unsignedInt32TypeId(typeStore: &mut Analyzer::TypeStore): Analyzer::TypeId {
    let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
    return typeStoreRef.intern(Analyzer::Type::U32);
  }

  function boolConstOperand(
    typeStore: &mut Analyzer::TypeStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    value: boolean,
    span: SourceSpan,
  ): Lir::Operand {
    let boolType: Analyzer::TypeId = LirLowering::booleanTypeId(typeStore);
    let dest: Lir::TempId = LirLowering::freshTemp(function_, boolType, span);

    LirLowering::pushInstr(function_, state, Lir::Instr::Copy(Lir::InstrCopy {
      dest: dest,
      source: Lir::Operand::Const(Lir::ConstValue::Bool(value, boolType)),
    }));

    return Lir::Operand::Temp(dest);
  }

  /// Loads through reference layers until the value is not a reference, the
  /// oracle's `materialize_pattern_value`. Returns the value operand and its
  /// dereferenced type through `LowerState`-independent out parameters is not
  /// expressible here, so the type is re-derived by the caller when needed.
  function materializedPatternType(
    typeStore: &mut Analyzer::TypeStore,
    valueType: Analyzer::TypeId,
  ): Analyzer::TypeId {
    let mut currentType: Analyzer::TypeId = valueType;
    let mut guard: u64 = 0;

    while (guard < 16) {
      let mut referent: Option<Analyzer::TypeId> = Option::NONE;

      if (let Option::SOME(typeNode) = typeStore.get(currentType)) {
        if (let Analyzer::Type::Reference(referenceType) = typeNode) {
          referent = Option::SOME(referenceType.referent);
        }
      }

      let Option::SOME(inner) = referent else {
        return currentType;
      };

      currentType = inner;
      guard += 1;
    }

    return currentType;
  }

  function materializePatternValue(
    typeStore: &mut Analyzer::TypeStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    value: Lir::Operand,
    valueType: Analyzer::TypeId,
    span: SourceSpan,
  ): Lir::Operand {
    let mut currentValue: Lir::Operand = value;
    let mut currentType: Analyzer::TypeId = valueType;
    let mut guard: u64 = 0;

    while (guard < 16) {
      let mut referent: Option<Analyzer::TypeId> = Option::NONE;

      if (let Option::SOME(typeNode) = typeStore.get(currentType)) {
        if (let Analyzer::Type::Reference(referenceType) = typeNode) {
          referent = Option::SOME(referenceType.referent);
        }
      }

      let Option::SOME(inner) = referent else {
        return currentValue;
      };

      let loaded: Lir::TempId = LirLowering::freshTemp(function_, inner, span);

      LirLowering::pushInstr(function_, state, Lir::Instr::LoadPtr(Lir::InstrLoadPtr {
        dest: loaded,
        ptr: currentValue,
      }));

      currentValue = Lir::Operand::Temp(loaded);
      currentType = inner;
      guard += 1;
    }

    return currentValue;
  }

  /// Payload types of `variantTag` for a scrutinee whose (dereferenced) type
  /// names an enum, with instance type arguments substituted.
  function enumVariantPayloadTypes(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    scrutineeType: Analyzer::TypeId,
    variantTag: u32,
  ): Option<Vector<Analyzer::TypeId>> {
    let mut enumDefOpt: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut instanceArgs: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    if (let Option::SOME(typeNode) = typeStore.get(scrutineeType)) {
      match (typeNode) {
        Analyzer::Type::Enum(defId) -> {
          enumDefOpt = Option::SOME(defId);
        },
        Analyzer::Type::Instance(instance) -> {
          enumDefOpt = Option::SOME(instance.definition);

          let mut argIndex: u64 = 0;
          while (argIndex < instance.typeArguments.length()) {
            if (let Option::SOME(argument) = instance.typeArguments.get(argIndex)) {
              instanceArgs.push(*argument);
            }
            argIndex += 1;
          }
        },
        _ -> {},
      };
    }

    let Option::SOME(enumDefId) = enumDefOpt else {
      return Option::NONE;
    };

    let mut variantDefOpt: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut paramSymbols: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();

    if (let Option::SOME(definition) = defStore.get(enumDefId)) {
      if (let Analyzer::Definition::Enum(enumDef) = definition) {
        if (let Option::SOME(variantId) = enumDef.variants.get(variantTag as u64)) {
          variantDefOpt = Option::SOME(*variantId);
        }

        if (instanceArgs.length() > 0) {
          paramSymbols = Analyzer::Typecheck::ownerTypeParamSymbols(defStore, &enumDef.typeParams);
        }
      }
    }

    let Option::SOME(variantDefId) = variantDefOpt else {
      return Option::NONE;
    };

    let mut payloadTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    if (let Option::SOME(variantNode) = defStore.get(variantDefId)) {
      if (let Analyzer::Definition::Variant(variantDef) = variantNode) {
        let mut payloadIndex: u64 = 0;

        while (payloadIndex < variantDef.payload.length()) {
          if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
            if (paramSymbols.length() > 0 && paramSymbols.length() == instanceArgs.length()) {
              let mut substituteTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
              payloadTypes.push(substituteTypeStoreRef.substitute(*payloadType, &paramSymbols, &instanceArgs));
            } else {
              payloadTypes.push(*payloadType);
            }
          }

          payloadIndex += 1;
        }
      }
    }

    return Option::SOME(payloadTypes);
  }

  /// The oracle's `lower_pattern_check`: emits instructions that leave a
  /// boolean operand describing whether `value` matches `pattern`, binding
  /// pattern locals along the way. Tuple patterns keep the oracle's own
  /// empty-tuple simplification.
  function lowerPatternCheck(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    value: &Lir::Operand,
    valueType: Analyzer::TypeId,
    pattern: &Hir::HirPattern,
    span: SourceSpan,
  ): Lir::Operand {
    let boolType: Analyzer::TypeId = LirLowering::booleanTypeId(typeStore);

    match (pattern) {
      Hir::HirPattern::Wildcard -> {
        return LirLowering::boolConstOperand(typeStore, function_, state, true, span);
      },
      Hir::HirPattern::Literal(literal) -> {
        let matchType: Analyzer::TypeId = LirLowering::materializedPatternType(typeStore, valueType);
        let matchValue: Lir::Operand = LirLowering::materializePatternValue(
          typeStore,
          function_,
          state,
          Lir::copyOperand(value),
          valueType,
          span,
        );

        let mut literalOperand: Lir::Operand = Lir::Operand::Const(Lir::ConstValue::Undef(matchType));

        if (let Option::SOME(constant) = LirLowering::constFromLiteral(&literal, matchType)) {
          literalOperand = Lir::Operand::Const(constant);
        }

        let dest: Lir::TempId = LirLowering::freshTemp(function_, boolType, span);

        LirLowering::pushInstr(function_, state, Lir::Instr::BinOp(Lir::InstrBinOp {
          dest: dest,
          op: Hir::BinaryOperation::Equal,
          left: matchValue,
          right: literalOperand,
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirPattern::Constant(defId) -> {
        let matchValue: Lir::Operand = LirLowering::materializePatternValue(
          typeStore,
          function_,
          state,
          Lir::copyOperand(value),
          valueType,
          span,
        );

        let dest: Lir::TempId = LirLowering::freshTemp(function_, boolType, span);

        LirLowering::pushInstr(function_, state, Lir::Instr::BinOp(Lir::InstrBinOp {
          dest: dest,
          op: Hir::BinaryOperation::Equal,
          left: matchValue,
          right: Lir::Operand::GlobalRef(defId),
        }));

        return Lir::Operand::Temp(dest);
      },
      Hir::HirPattern::Binding(defId) -> {
        let mut bindingSlot: Lir::LocalId = Id::fromRaw<Lir::LocalTag>(0);
        let mut haveSlot: boolean = false;

        if (let Option::SOME(existing) = LirLowering::lookupLocal(state, defId)) {
          bindingSlot = existing;
          haveSlot = true;
        }

        if (!haveSlot) {
          let mut bindingMutable: boolean = false;

          if (let Option::SOME(definition) = defStore.get(defId)) {
            if (let Analyzer::Definition::Variable(variableDef) = definition) {
              bindingMutable = variableDef.mutable;
            }
          }

          let mut bindingFunctionRef: &mut Lir::FunctionLir = function_;
          bindingSlot = bindingFunctionRef.allocLocal(Lir::LocalData {
            defId: Option::SOME(defId),
            ty: valueType,
            mutable: bindingMutable,
            name: Option::NONE,
            borrowedAlias: false,
          });

          LirLowering::registerLocal(state, defId, bindingSlot);
        }

        LirLowering::pushInstr(function_, state, Lir::Instr::Store(Lir::InstrStore {
          dest: bindingSlot,
          value: Lir::copyOperand(value),
        }));

        return LirLowering::boolConstOperand(typeStore, function_, state, true, span);
      },
      Hir::HirPattern::Variant(variantPattern) -> {
        let enumValue: Lir::Operand = LirLowering::materializePatternValue(
          typeStore,
          function_,
          state,
          Lir::copyOperand(value),
          valueType,
          span,
        );
        let enumType: Analyzer::TypeId = LirLowering::materializedPatternType(typeStore, valueType);

        let Option::SOME(payloadTypes) = LirLowering::enumVariantPayloadTypes(
          defStore,
          typeStore,
          enumType,
          variantPattern.variantTag,
        ) else {
          return LirLowering::boolConstOperand(typeStore, function_, state, false, span);
        };

        let tagType: Analyzer::TypeId = LirLowering::unsignedInt32TypeId(typeStore);
        let tagTemp: Lir::TempId = LirLowering::freshTemp(function_, tagType, span);

        LirLowering::pushInstr(function_, state, Lir::Instr::EnumGetTag(Lir::InstrEnumGetTag {
          dest: tagTemp,
          source: Lir::copyOperand(&enumValue),
        }));

        let tagMatch: Lir::TempId = LirLowering::freshTemp(function_, boolType, span);

        LirLowering::pushInstr(function_, state, Lir::Instr::BinOp(Lir::InstrBinOp {
          dest: tagMatch,
          op: Hir::BinaryOperation::Equal,
          left: Lir::Operand::Temp(tagTemp),
          right: Lir::Operand::Const(Lir::ConstValue::UInt(variantPattern.variantTag as u64, tagType)),
        }));

        let mut combined: Lir::Operand = Lir::Operand::Temp(tagMatch);
        let mut checkIndex: u64 = 0;
        let mut runtimeFieldIndex: u32 = 0;

        while (checkIndex < variantPattern.args.length() && checkIndex < payloadTypes.length()) {
          let Option::SOME(argPattern) = variantPattern.args.get(checkIndex) else {
            checkIndex += 1;
            continue;
          };
          let Option::SOME(fieldType) = payloadTypes.get(checkIndex) else {
            checkIndex += 1;
            continue;
          };

          let mut nested: Lir::Operand = Lir::Operand::Const(Lir::ConstValue::Bool(true, boolType));

          if (LirLowering::isVoidType(typeStore, *fieldType)) {
            nested = LirLowering::boolConstOperand(typeStore, function_, state, true, span);
          } else {
            let fieldTemp: Lir::TempId = LirLowering::freshTemp(function_, *fieldType, span);

            LirLowering::pushInstr(function_, state, Lir::Instr::EnumGetPayloadField(Lir::InstrEnumGetPayloadField {
              dest: fieldTemp,
              source: Lir::copyOperand(&enumValue),
              variantTag: variantPattern.variantTag,
              fieldIndex: runtimeFieldIndex,
            }));
            runtimeFieldIndex += 1;

            let fieldOperand: Lir::Operand = Lir::Operand::Temp(fieldTemp);
            nested = LirLowering::lowerPatternCheck(
              defStore,
              typeStore,
              function_,
              state,
              &fieldOperand,
              *fieldType,
              argPattern,
              span,
            );
          }

          let andTemp: Lir::TempId = LirLowering::freshTemp(function_, boolType, span);

          LirLowering::pushInstr(function_, state, Lir::Instr::BinOp(Lir::InstrBinOp {
            dest: andTemp,
            op: Hir::BinaryOperation::And,
            left: combined,
            right: nested,
          }));

          combined = Lir::Operand::Temp(andTemp);
          checkIndex += 1;
        }

        return combined;
      },
      Hir::HirPattern::Or(alternatives) -> {
        let mut combined: Lir::Operand = LirLowering::boolConstOperand(typeStore, function_, state, false, span);
        let mut alternativeIndex: u64 = 0;

        while (alternativeIndex < alternatives.length()) {
          let Option::SOME(alternative) = alternatives.get(alternativeIndex) else {
            alternativeIndex += 1;
            continue;
          };

          let check: Lir::Operand = LirLowering::lowerPatternCheck(
            defStore,
            typeStore,
            function_,
            state,
            value,
            valueType,
            alternative,
            span,
          );

          let orTemp: Lir::TempId = LirLowering::freshTemp(function_, boolType, span);

          LirLowering::pushInstr(function_, state, Lir::Instr::BinOp(Lir::InstrBinOp {
            dest: orTemp,
            op: Hir::BinaryOperation::Or,
            left: combined,
            right: check,
          }));

          combined = Lir::Operand::Temp(orTemp);
          alternativeIndex += 1;
        }

        return combined;
      },
      Hir::HirPattern::Tuple(elements) -> {
        let mut matchesEmptyTuple: boolean = false;

        if (elements.length() == 0) {
          if (let Option::SOME(typeNode) = typeStore.get(valueType)) {
            if (let Analyzer::Type::Tuple(tupleType) = typeNode) {
              matchesEmptyTuple = tupleType.elements.length() == 0;
            }
          }
        }

        return LirLowering::boolConstOperand(typeStore, function_, state, matchesEmptyTuple, span);
      },
    };

    return LirLowering::boolConstOperand(typeStore, function_, state, false, span);
  }

  /// The oracle's `lower_match` minus drop scheduling: scrutinee spilled to a
  /// slot, one check/arm block pair per arm, guards branching to the next
  /// check, a panic block for the non-exhaustive tail, and a result local
  /// loaded in the merge block for non-void matches.
  function lowerMatch(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hirStore: &Hir::HirStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    matchNode: &Hir::HirMatch,
    nodeType: Analyzer::TypeId,
    nodeSpan: SourceSpan,
  ): Lir::Operand {
    let scrutineeValue: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, matchNode.scrutinee);

    let mut scrutineeType: Analyzer::TypeId = nodeType;
    if (let Option::SOME(scrutineeNode) = hirStore.get(matchNode.scrutinee)) {
      scrutineeType = scrutineeNode.typeId;
    }

    let scrutineeSlot: Lir::LocalId = LirLowering::allocSyntheticLocal(function_, scrutineeType);

    LirLowering::pushInstr(function_, state, Lir::Instr::Store(Lir::InstrStore {
      dest: scrutineeSlot,
      value: scrutineeValue,
    }));

    let isVoid: boolean = LirLowering::isVoidType(typeStore, nodeType);

    let mut resultSlot: Lir::LocalId = Id::fromRaw<Lir::LocalTag>(0);
    let mut hasResult: boolean = false;

    if (!isVoid) {
      resultSlot = LirLowering::allocSyntheticLocal(function_, nodeType);
      hasResult = true;
    }

    if (matchNode.arms.length() == 0) {
      LirLowering::pushInstr(function_, state, Lir::Instr::PanicMessage(Lir::InstrPanicMessage {
        message: String::create("non-exhaustive match"),
        span: nodeSpan,
      }));
      LirLowering::terminate(function_, state, Lir::Terminator::Unreachable);

      return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
    }

    let mergeBlock: Lir::BlockId = LirLowering::createBlock(function_, "match_merge");
    let panicBlock: Lir::BlockId = LirLowering::createBlock(function_, "match_panic");

    let mut checkBlockRaws: Vector<u32> = Vector::new<u32>();
    let mut armBlockRaws: Vector<u32> = Vector::new<u32>();
    let mut blockIndex: u64 = 0;

    while (blockIndex < matchNode.arms.length()) {
      checkBlockRaws.push(LirLowering::createBlock(function_, "match_check").raw());
      armBlockRaws.push(LirLowering::createBlock(function_, "match_arm").raw());
      blockIndex += 1;
    }

    if (!state.terminated) {
      if (let Option::SOME(firstCheckRaw) = checkBlockRaws.get(0)) {
        LirLowering::terminate(function_, state, Lir::Terminator::Goto(Id::fromRaw<Lir::BlockTag>(*firstCheckRaw)));
      }
    }

    let mut armIndex: u64 = 0;

    while (armIndex < matchNode.arms.length()) {
      let Option::SOME(arm) = matchNode.arms.get(armIndex) else {
        armIndex += 1;
        continue;
      };
      let Option::SOME(checkRaw) = checkBlockRaws.get(armIndex) else {
        armIndex += 1;
        continue;
      };
      let Option::SOME(armRaw) = armBlockRaws.get(armIndex) else {
        armIndex += 1;
        continue;
      };

      let armBlock: Lir::BlockId = Id::fromRaw<Lir::BlockTag>(*armRaw);

      let mut elseTargetRaw: u32 = panicBlock.raw();
      if (armIndex + 1 < matchNode.arms.length()) {
        if (let Option::SOME(nextCheckRaw) = checkBlockRaws.get(armIndex + 1)) {
          elseTargetRaw = *nextCheckRaw;
        }
      }
      let elseTarget: Lir::BlockId = Id::fromRaw<Lir::BlockTag>(elseTargetRaw);

      LirLowering::switchToBlock(state, Id::fromRaw<Lir::BlockTag>(*checkRaw));

      let scrutineeTemp: Lir::TempId = LirLowering::freshTemp(function_, scrutineeType, nodeSpan);

      LirLowering::pushInstr(function_, state, Lir::Instr::Load(Lir::InstrLoad {
        dest: scrutineeTemp,
        source: scrutineeSlot,
      }));

      let scrutineeOperand: Lir::Operand = Lir::Operand::Temp(scrutineeTemp);
      let matches: Lir::Operand = LirLowering::lowerPatternCheck(
        defStore,
        typeStore,
        function_,
        state,
        &scrutineeOperand,
        scrutineeType,
        &arm.pattern,
        nodeSpan,
      );

      if (let Option::SOME(guardId) = arm.guard) {
        let guardBlock: Lir::BlockId = LirLowering::createBlock(function_, "match_guard");

        LirLowering::terminate(function_, state, Lir::Terminator::Branch(Lir::TerminatorBranch {
          condition: matches,
          thenBlock: guardBlock,
          elseBlock: elseTarget,
        }));

        LirLowering::switchToBlock(state, guardBlock);

        let guardValue: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, guardId);

        // `terminate` already drops a second terminator, so the branch is
        // built unconditionally and the operand moves on every path.
        LirLowering::terminate(function_, state, Lir::Terminator::Branch(Lir::TerminatorBranch {
          condition: guardValue,
          thenBlock: armBlock,
          elseBlock: elseTarget,
        }));
      } else {
        LirLowering::terminate(function_, state, Lir::Terminator::Branch(Lir::TerminatorBranch {
          condition: matches,
          thenBlock: armBlock,
          elseBlock: elseTarget,
        }));
      }

      LirLowering::switchToBlock(state, armBlock);

      let bodyValue: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, arm.body);

      let bodyLive: boolean = !state.terminated;
      LirLowering::storeResult(function_, state, hasResult && bodyLive, resultSlot, bodyValue);

      if (bodyLive) {
        LirLowering::terminate(function_, state, Lir::Terminator::Goto(mergeBlock));
      }

      armIndex += 1;
    }

    LirLowering::switchToBlock(state, panicBlock);
    LirLowering::pushInstr(function_, state, Lir::Instr::PanicMessage(Lir::InstrPanicMessage {
      message: String::create("non-exhaustive match"),
      span: nodeSpan,
    }));
    LirLowering::terminate(function_, state, Lir::Terminator::Unreachable);

    LirLowering::switchToBlock(state, mergeBlock);

    if (hasResult) {
      let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

      LirLowering::pushInstr(function_, state, Lir::Instr::Load(Lir::InstrLoad {
        dest: dest,
        source: resultSlot,
      }));

      return Lir::Operand::Temp(dest);
    }

    return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
  }

  /// The oracle's `lower_let_else`: spill the value, check the pattern, and
  /// branch between the continuation and the diverging else block.
  function lowerLetElse(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hirStore: &Hir::HirStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    letElseNode: &Hir::HirLetElse,
    nodeSpan: SourceSpan,
  ): void {
    let mut valueType: Analyzer::TypeId = function_.returnType;
    if (let Option::SOME(valueNode) = hirStore.get(letElseNode.value)) {
      valueType = valueNode.typeId;
    }

    let valueOperand: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, letElseNode.value);
    let scrutineeSlot: Lir::LocalId = LirLowering::allocSyntheticLocal(function_, valueType);

    LirLowering::pushInstr(function_, state, Lir::Instr::Store(Lir::InstrStore {
      dest: scrutineeSlot,
      value: valueOperand,
    }));

    let scrutineeOperand: Lir::Operand = Lir::Operand::Local(scrutineeSlot);
    let matches: Lir::Operand = LirLowering::lowerPatternCheck(
      defStore,
      typeStore,
      function_,
      state,
      &scrutineeOperand,
      valueType,
      &letElseNode.pattern,
      nodeSpan,
    );

    let continueBlock: Lir::BlockId = LirLowering::createBlock(function_, "let_else_ok");
    let failBlock: Lir::BlockId = LirLowering::createBlock(function_, "let_else_fail");

    LirLowering::terminate(function_, state, Lir::Terminator::Branch(Lir::TerminatorBranch {
      condition: matches,
      thenBlock: continueBlock,
      elseBlock: failBlock,
    }));

    LirLowering::switchToBlock(state, failBlock);
    let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, letElseNode.elseBlock);

    if (!state.terminated) {
      LirLowering::terminate(function_, state, Lir::Terminator::Unreachable);
    }

    LirLowering::switchToBlock(state, continueBlock);
  }

  /// Consumes `value`, storing it into `slot` only when `wanted`. Split out
  /// so the operand is moved on every path, which the ownership checker
  /// requires of branch-dependent stores.
  function storeResult(
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    wanted: boolean,
    slot: Lir::LocalId,
    value: Lir::Operand,
  ): void {
    if (!wanted) {
      return;
    }

    LirLowering::pushInstr(function_, state, Lir::Instr::Store(Lir::InstrStore {
      dest: slot,
      value: value,
    }));
  }

  /// The oracle's `lower_if`: branch, then/else blocks storing into one
  /// result local when the expression is non-void, merge block loading it.
  function lowerIf(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hirStore: &Hir::HirStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    ifNode: &Hir::HirIf,
    nodeType: Analyzer::TypeId,
    nodeSpan: SourceSpan,
  ): Lir::Operand {
    let condition: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, ifNode.condition);

    let thenBlock: Lir::BlockId = LirLowering::createBlock(function_, "then");
    let elseBlock: Lir::BlockId = LirLowering::createBlock(function_, "else");
    let mergeBlock: Lir::BlockId = LirLowering::createBlock(function_, "merge");

    let isVoid: boolean = LirLowering::isVoidType(typeStore, nodeType);

    let mut resultSlot: Lir::LocalId = Id::fromRaw<Lir::LocalTag>(0);
    let mut hasResult: boolean = false;

    if (!isVoid) {
      resultSlot = LirLowering::allocSyntheticLocal(function_, nodeType);
      hasResult = true;
    }

    LirLowering::terminate(function_, state, Lir::Terminator::Branch(Lir::TerminatorBranch {
      condition: condition,
      thenBlock: thenBlock,
      elseBlock: elseBlock,
    }));

    LirLowering::switchToBlock(state, thenBlock);
    let thenValue: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, ifNode.thenBranch);

    let thenLive: boolean = !state.terminated;
    LirLowering::storeResult(function_, state, hasResult && thenLive, resultSlot, thenValue);

    if (thenLive) {
      LirLowering::terminate(function_, state, Lir::Terminator::Goto(mergeBlock));
    }

    LirLowering::switchToBlock(state, elseBlock);

    if (let Option::SOME(elseId) = ifNode.elseBranch) {
      let elseValue: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, elseId);

      let elseLive: boolean = !state.terminated;
      LirLowering::storeResult(function_, state, hasResult && elseLive, resultSlot, elseValue);

      if (elseLive) {
        LirLowering::terminate(function_, state, Lir::Terminator::Goto(mergeBlock));
      }
    } else {
      LirLowering::terminate(function_, state, Lir::Terminator::Goto(mergeBlock));
    }

    LirLowering::switchToBlock(state, mergeBlock);

    if (hasResult) {
      let dest: Lir::TempId = LirLowering::freshTemp(function_, nodeType, nodeSpan);

      LirLowering::pushInstr(function_, state, Lir::Instr::Load(Lir::InstrLoad {
        dest: dest,
        source: resultSlot,
      }));

      return Lir::Operand::Temp(dest);
    }

    return Lir::Operand::Const(Lir::ConstValue::Undef(nodeType));
  }

  /// The oracle's `lower_loop` for infinite, while and for shapes.
  function lowerLoop(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hirStore: &Hir::HirStore,
    function_: &mut Lir::FunctionLir,
    state: &mut LirLowering::LowerState,
    loopNode: &Hir::HirLoop,
  ): void {
    let exitBlock: Lir::BlockId = LirLowering::createBlock(function_, "loop_exit");

    match (&loopNode.condition) {
      Hir::LoopKind::Infinite -> {
        let bodyBlock: Lir::BlockId = LirLowering::createBlock(function_, "loop_body");

        state.breakBlockRaws.push(exitBlock.raw());
        state.continueBlockRaws.push(bodyBlock.raw());

        LirLowering::terminate(function_, state, Lir::Terminator::Goto(bodyBlock));

        LirLowering::switchToBlock(state, bodyBlock);
        let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, loopNode.body);

        if (!state.terminated) {
          LirLowering::terminate(function_, state, Lir::Terminator::Goto(bodyBlock));
        }
      },
      Hir::LoopKind::While(conditionId) -> {
        let headerBlock: Lir::BlockId = LirLowering::createBlock(function_, "loop_header");
        let bodyBlock: Lir::BlockId = LirLowering::createBlock(function_, "loop_body");
        let continueBlock: Lir::BlockId = LirLowering::createBlock(function_, "loop_continue");

        state.breakBlockRaws.push(exitBlock.raw());
        state.continueBlockRaws.push(continueBlock.raw());

        LirLowering::terminate(function_, state, Lir::Terminator::Goto(headerBlock));

        LirLowering::switchToBlock(state, headerBlock);
        let condition: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, conditionId);

        LirLowering::terminate(function_, state, Lir::Terminator::Branch(Lir::TerminatorBranch {
          condition: condition,
          thenBlock: bodyBlock,
          elseBlock: exitBlock,
        }));

        LirLowering::switchToBlock(state, bodyBlock);
        let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, loopNode.body);

        if (!state.terminated) {
          LirLowering::terminate(function_, state, Lir::Terminator::Goto(continueBlock));
        }

        LirLowering::switchToBlock(state, continueBlock);
        LirLowering::terminate(function_, state, Lir::Terminator::Goto(headerBlock));
      },
      Hir::LoopKind::For(forNode) -> {
        let headerBlock: Lir::BlockId = LirLowering::createBlock(function_, "loop_header");
        let bodyBlock: Lir::BlockId = LirLowering::createBlock(function_, "loop_body");
        let continueBlock: Lir::BlockId = LirLowering::createBlock(function_, "loop_continue");

        state.breakBlockRaws.push(exitBlock.raw());
        state.continueBlockRaws.push(continueBlock.raw());

        if (let Option::SOME(initId) = forNode.init) {
          let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, initId);
        }

        if (!state.terminated) {
          LirLowering::terminate(function_, state, Lir::Terminator::Goto(headerBlock));
        }

        LirLowering::switchToBlock(state, headerBlock);

        if (let Option::SOME(conditionId) = forNode.condition) {
          let condition: Lir::Operand = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, conditionId);

          LirLowering::terminate(function_, state, Lir::Terminator::Branch(Lir::TerminatorBranch {
            condition: condition,
            thenBlock: bodyBlock,
            elseBlock: exitBlock,
          }));
        } else {
          LirLowering::terminate(function_, state, Lir::Terminator::Goto(bodyBlock));
        }

        LirLowering::switchToBlock(state, bodyBlock);
        let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, loopNode.body);

        if (!state.terminated) {
          LirLowering::terminate(function_, state, Lir::Terminator::Goto(continueBlock));
        }

        LirLowering::switchToBlock(state, continueBlock);

        if (let Option::SOME(updateId) = forNode.update) {
          let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, function_, state, updateId);
        }

        LirLowering::terminate(function_, state, Lir::Terminator::Goto(headerBlock));
      },
    };

    let _breakPopped = state.breakBlockRaws.pop();
    let _continuePopped = state.continueBlockRaws.pop();

    LirLowering::switchToBlock(state, exitBlock);
  }

  /// Lowers every function body of one module's HIR store.
  function lowerModule(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hirStore: &Hir::HirStore,
  ): LirLowering::LowerModuleResult {
    let mut program: Lir::LirProgram = Lir::LirProgram::init();
    let mut unsupported: u64 = 0;
    let mut loweredFunctions: u64 = 0;

    let mut itemIndex: u64 = 0;

    while (itemIndex < hirStore.items.length()) {
      let Option::SOME(itemDef) = hirStore.items.get(itemIndex) else {
        itemIndex += 1;
        continue;
      };

      let Option::SOME(bodyId) = hirStore.functionBodies.get(*itemDef) else {
        itemIndex += 1;
        continue;
      };

      let mut returnType: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(0);

      if (let Option::SOME(definition) = defStore.get(*itemDef)) {
        if (let Analyzer::Definition::Function(functionDef) = definition) {
          returnType = functionDef.returnType;
        }
      }

      let mut function_: Lir::FunctionLir = Lir::FunctionLir::create(*itemDef, returnType);
      let entry: Lir::BlockId = function_.allocBlock(Lir::Block::create(String::create("entry")));
      function_.entryBlock = entry;

      let mut state: LirLowering::LowerState = LirLowering::LowerState::init();

      let _ = LirLowering::lowerExpr(defStore, typeStore, hirStore, &mut function_, &mut state, bodyId);

      unsupported += state.unsupported;
      loweredFunctions += 1;

      program.functions.set(*itemDef, function_);
      itemIndex += 1;
    }

    if (let Option::SOME(entryDef) = hirStore.entryPoint) {
      program.entryPoint = Option::SOME(entryDef);
    }

    return LirLowering::LowerModuleResult {
      program: program,
      unsupported: unsupported,
      loweredFunctions: loweredFunctions,
    };
  }
}
