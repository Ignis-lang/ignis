  const RUNTIME_HANDLER_IN_HOSTED_BUILD: static str = "A0228";
  /// A second function carrying the same runtime handler attribute.
  const DUPLICATE_RUNTIME_HANDLER: static str = "A0229";
  /// A `static mut` field whose initializer, or an element or field of its
