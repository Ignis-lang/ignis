  const REDUNDANT_PRELUDE_IMPORT: static str = "A0266";
  /// A `static` or `static mut` field whose type is a view type: a view
  /// (`str`, a reference, a slice, a record or generic instance holding one)
  /// borrows storage it does not own, and a static outlives every owner it
  /// could borrow. A `static str` field is accepted: a static string owns its
  /// bytes.
  const STATIC_FIELD_OF_VIEW_TYPE: static str = "A0268";
  /// A view type argument for a type parameter marked `@owns`, an owning
  /// storage slot: the declaring type stores the argument where the type
  /// system cannot see whose bytes a view borrows, so only an owned type
  /// (`String`, `static str`, a record without view fields) may fill it.
  const VIEW_IN_OWNING_SLOT: static str = "A0269";
  /// Construct not yet implemented by the selfhost compiler (a temporary
  /// wall). Shared by every "not supported"/"not yet supported" site across
  /// the resolver and typechecker; removed as each wall is lifted.
  const UNSUPPORTED_CONSTRUCT: static str = "A0053";
  /// A generic type reference supplies the wrong number of type arguments.
  const GENERIC_ARITY_MISMATCH: static str = "A0070";
  /// Generic arguments applied to a type-parameter or primitive base, which
  /// cannot take generic arguments.
  const GENERIC_ARGS_NOT_ALLOWED: static str = "A0073";
  /// A definition kind is used where its kind is not valid syntactically
  /// (e.g. a trait name in type position, a method in pattern position).
  const INVALID_ENTITY_POSITION: static str = "A0185";
  /// A direct import binds a name that already exists in the importing
