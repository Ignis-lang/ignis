  const METHOD_CALL_KIND_MISMATCH: static str = "A0270";
  /// An enum variant written with the `static` modifier.
  const STATIC_ON_ENUM_VARIANT: static str = "A0067";
  /// `break` used outside of a loop.
  const BREAK_OUTSIDE_LOOP: static str = "A0040";
  /// `continue` used outside of a loop.
  const CONTINUE_OUTSIDE_LOOP: static str = "A0041";
  /// A call expression whose callee is a value that is not a function.
