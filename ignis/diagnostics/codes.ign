  const OR_PATTERN_BINDINGS_DISALLOWED: static str = "A0157";
  /// A referenced record field or method does not exist on its owner type.
  const FIELD_NOT_FOUND: static str = "A0054";
  /// A method named without calling it.
  const METHOD_MUST_BE_CALLED: static str = "A0061";
  /// A record initializer supplies the same field more than once.
