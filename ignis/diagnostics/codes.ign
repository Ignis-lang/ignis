  const EXPORTED_SYMBOL_IS_GENERIC: static str = "A0204";
  /// Two definitions claiming one C symbol through `@externName`.
  const DUPLICATE_EXPORTED_SYMBOL: static str = "A0205";
  /// A bare pattern name equal to a variant of the scrutinee's enum, which
