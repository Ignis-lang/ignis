  const DUPLICATE_IMPORT_NAME: static str = "M0003";
  /// An import naming a module the build cannot resolve.
  const MODULE_NOT_FOUND: static str = "M0001";
  /// An import naming something the target module does not export.
  const SYMBOL_NOT_EXPORTED: static str = "M0002";
  /// An `import _` that lists other names beside the discard.
  const DISCARD_IMPORT_MUST_BE_SOLE_ITEM: static str = "M0005";
  /// A `_` discard written as the first name of an `export` list.
  const DISCARD_EXPORT_FROM_NOT_ALLOWED: static str = "M0006";
  /// A `match` arm produces a type that disagrees with its sibling arms.
  const MATCH_ARM_TYPE_MISMATCH: static str = "A0163";
  /// A pattern whose shape cannot describe the scrutinee type.
  const PATTERN_TYPE_MISMATCH: static str = "A0159";
  /// An `if` expression used in value position has no `else` branch.
  const IF_MISSING_ELSE: static str = "A0059";
  /// A type alias chain refers back to itself.
  const CYCLIC_TYPE_ALIAS: static str = "A0066";
  /// A `match` does not cover every possible value of its scrutinee type.
