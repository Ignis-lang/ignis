  const TUPLE_PATTERN_NEEDS_A_TUPLE_LITERAL: static str = "A0208";
  /// A builtin whose type argument or value argument breaks a constraint the
  /// builtin itself imposes, such as `@pointerCast` on a non-pointer.
  const BUILTIN_TYPE_CONSTRAINT: static str = "A0116";
  /// A call to a function or method marked `@deprecated`.
  /// Emitted as a WARNING by the lint phase.
  const DEPRECATED_CALL: static str = "A0124";
  /// A shared borrow taken while a mutable borrow of the same local is live.
  const BORROW_IMMUTABLE_WHILE_MUTABLE: static str = "A0036";
  /// A mutable borrow taken while a shared borrow of the same local is live.
  const BORROW_MUTABLE_WHILE_IMMUTABLE: static str = "A0037";
  /// A second mutable borrow taken while the first one is still live.
  const BORROW_MUTABLE_WHILE_MUTABLE: static str = "A0038";
  /// An assignment to a local while a borrow of it is live.
  const MUTATED_WHILE_BORROWED: static str = "A0047";
  /// A move of a local while a borrow of it is live, such as moving the owner
  /// of a view the function still holds.
  const MOVED_WHILE_BORROWED: static str = "A0258";
  /// A `@threadLocal` on a field that is not `static mut`: an immutable
  /// `static` has no storage, it folds into its uses, and an instance field
  /// lives in its record.
  const THREAD_LOCAL_NOT_STATIC_MUT: static str = "A0259";
  /// A `@threadLocal` field whose type runs a drop: nothing runs when a thread
  /// exits, so the value would never be torn down.
  const THREAD_LOCAL_NEEDS_DROP: static str = "A0260";
  /// A borrow of a thread-local, written as `&` or `&mut`, taken by a `&self`
  /// or `&mut self` method call, or made by a fixed array becoming a slice: the
  /// reference would dangle once the thread that owns the storage exits.
  const THREAD_LOCAL_BORROWED: static str = "A0261";
  /// A `let` or an assignment that keeps a view (`&T`, `&mut T`, a slice or a
  /// `str` a method returned from its receiver) of a temporary, or of a local
  /// declared in a deeper scope than the binding.
  const VIEW_OUTLIVES_OWNER: static str = "A0202";
  /// A `return` whose value is a view of a temporary or of a local of the
  /// function.
  const RETURN_OF_LOCAL_VIEW: static str = "A0043";

  /// A closure that outlives its defining scope while holding a reference
  /// capture: the frame the reference points into is gone by the time the
  /// closure runs.
  const CLOSURE_ESCAPES_WITH_REF_CAPTURE: static str = "A0170";
  /// A capturing closure that escapes in a freestanding build declaring no
  /// `@allocHandler` and `@freeHandler`: its heap environment has nothing to
