  /// An extension method called on any other temporary.
  const EXTENSION_METHOD_ON_TEMPORARY: static str = "A0139";
  /// A record declaring `@implements(Copy)` whose field type is not Copy.
  const COPY_ON_NON_COPY_FIELD: static str = "A0148";
  /// An enum declaring `@implements(Copy)` whose variant payload type is not
