  /// to start at a value fixed at compile time.
  const STATIC_MUT_NON_CONSTANT_INITIALIZER: static str = "A0230";
  /// A range bound that is not an integer: a range counts, so both of its
  /// bounds have to be integers.
  const RANGE_BOUND_NOT_INTEGER: static str = "A0231";
  /// A `for..of` over a range whose binding is a `&` or `&mut` reference: a
  /// range yields values that no storage holds.
  const RANGE_FOR_OF_BY_REFERENCE: static str = "A0232";
  /// A bound of an array range, `[a..b]`, that is not an integer literal.
  const ARRAY_RANGE_BOUND_NOT_LITERAL: static str = "A0233";
  /// An array range written next to other elements, `[0..3, 10]`.
  const ARRAY_RANGE_MIXED: static str = "A0234";
  /// An array range with more elements than the 65536 an array literal may
  /// expand to.
  const ARRAY_RANGE_TOO_LARGE: static str = "A0235";
  /// An array range that yields nothing, `[3..3]`, and so has no element type.
  const ARRAY_RANGE_EMPTY: static str = "A0236";
  /// A `Range<T>` or `RangeInclusive<T>` annotation whose element type is not
  /// an integer type.
  const RANGE_ELEMENT_NOT_INTEGER: static str = "A0237";
  /// A field access on a range other than `start` and `end`.
  const RANGE_UNKNOWN_FIELD: static str = "A0238";
  /// A `static mut` field without an initializer, or an `@zeroed` type
  /// argument, whose type has no all-zero-bytes value: a string, a reference, a
  /// function value, a value that runs a drop, an enum with a payload or a
  /// range.
  const TYPE_NOT_ZEROABLE: static str = "A0239";
  /// An `@splat` in a `const` or `static` initializer whose non-zero value
  /// would expand into more than the 65536 elements an array literal may hold.
  const SPLAT_TOO_LARGE: static str = "A0240";
  /// An `@splat` whose type argument is not a fixed array type.
  const SPLAT_TARGET_NOT_ARRAY: static str = "A0241";
  /// An `@splat` whose element type is not Copy, so the value cannot be
  /// copied into every element.
  const SPLAT_ELEMENT_NOT_COPY: static str = "A0242";
  /// An `@aligned(N)` whose `N` is larger than 1 GiB, the largest alignment the
  /// compiler accepts.
  const ALIGNMENT_TOO_LARGE: static str = "A0243";
  /// An `@aligned(N)` whose argument is not an integer literal.
  const ALIGNMENT_NOT_AN_INTEGER: static str = "A0244";
  /// The address taken of an immutable static field or module constant whose
  /// initializer is not a constant expression. Only a constant initializer
  /// seeds the read-only global an address names; anything else is rebuilt at
  /// every use, so the address would point into a stack copy of it.
  const STATIC_ADDRESS_NON_CONSTANT_INITIALIZER: static str = "A0245";
  /// `@eq<T>` whose `T`, once substituted, has no equality the compiler can
  /// emit: it is neither an integer primitive, `boolean`, `char` nor `str`,
  /// nor a record or enum declaring `@implements(Eq)` with an `equals` method.
  const UNSUPPORTED_EQUALITY: static str = "A0246";
  /// A type argument that does not satisfy a bound of the type parameter it
  /// binds: the record or enum does not declare `@implements` for the trait,
  /// the type parameter does not declare the bound, or a primitive is bound
  /// by a trait other than `Eq`, `Hash` or `Copy`.
  const GENERIC_BOUND_NOT_SATISFIED: static str = "A0247";
  /// An ordering or `@atomicRmw` operation argument of an atomic builtin that
  /// is not an atom literal written at the call.
  const ATOMIC_ARGUMENT_NOT_ATOM_LITERAL: static str = "A0248";
  /// An atom literal that names no memory ordering, or no `@atomicRmw`
  /// operation, where one is expected.
  const ATOMIC_UNKNOWN_ATOM: static str = "A0249";
  /// A memory ordering the atomic operation does not accept: `:release` or
  /// `:acqRel` on a load or a compare-exchange failure, `:acquire` or
  /// `:acqRel` on a store.
  const ATOMIC_ORDERING_NOT_ALLOWED: static str = "A0250";
  /// An atomic builtin whose type argument is not an integer primitive,
  /// `boolean` or a raw pointer, or an arithmetic or bitwise `@atomicRmw` on
  /// a type that is not an integer primitive.
  const ATOMIC_UNSUPPORTED_TYPE: static str = "A0251";
  /// A closure passed where a type parameter bounded by `Send` or `Sync` is
  /// expected that captures a value the bound does not allow across threads.
  const CLOSURE_CAPTURE_NOT_THREAD_SAFE: static str = "A0252";
  /// A function value that is neither a closure literal nor a named function
  /// passed where a type parameter bounded by `Send` or `Sync` is expected:
  /// what it captured cannot be known at the call.
  const FUNCTION_VALUE_NOT_THREAD_SAFE: static str = "A0253";
  /// A closure literal that captures a value, supplied where a function
  /// pointer type `fn(A) -> R` is expected. A function pointer has no
  /// environment to hold the capture.
  const FUNCTION_POINTER_CAPTURES: static str = "A0264";
  /// A closure-typed value supplied where a function pointer type
  /// `fn(A) -> R` is expected. Its type does not say what it captured, so only
  /// a named function, a closure literal that captures nothing or another
  /// `fn` value converts.
  const FUNCTION_POINTER_FROM_CLOSURE_VALUE: static str = "A0265";
  /// A record or enum declaring `@implements(Send)` or `@implements(Sync)`
  /// while a field or payload is not Send or Sync.
  /// Emitted by the lint phase at the level of the `thread_safety` lint.
  const THREAD_SAFETY_DECLARATION: static str = "A0254";
  /// `@sendable` on a parameter whose declared type is not a function type.
  const SENDABLE_PARAMETER_NOT_FUNCTION: static str = "A0255";
  /// A record or enum that holds a value of itself inline, directly or
  /// through other types, so its size would be infinite.
  const RECURSIVE_TYPE_WITHOUT_INDIRECTION: static str = "A0256";
  /// A generic record or enum that refers to itself, directly or through
  /// other types, with a type argument that nests one of its type parameters
  /// (`Nest<T>` holding `Nest<Vector<T>>`): monomorphizing it would need an
  /// unbounded family of instances.
  const EXPANDING_GENERIC_RECURSION: static str = "A0275";
  /// A record declaring an instance method and a field of function type with
  /// the same name: `value.name(args)` calls either, so it could mean both.
  const METHOD_AND_FUNCTION_FIELD_SHARE_NAME: static str = "A0257";
  /// A runtime handler whose signature is not the one its kind requires, or
  /// that is an extern declaration rather than a definition.
  const RUNTIME_HANDLER_SIGNATURE: static str = "A0209";
  /// `@allocHandler` without `@freeHandler`, or the reverse.
  const INCOMPLETE_ALLOCATOR_HANDLERS: static str = "A0210";
  /// A freestanding build whose generated code can panic with no
  /// `@panicHandler` function to report through.
  const MISSING_PANIC_HANDLER: static str = "A0211";
  /// A method or static field on a record declared inside an extern block,
  /// which describes a C struct and nothing else.
  const EXTERN_RECORD_UNSUPPORTED_MEMBER: static str = "A0212";
  /// A generic record with a C layout: an extern record or a `@cLayout`
  /// record.
  const C_LAYOUT_RECORD_IS_GENERIC: static str = "A0213";
  /// `@implements` on an extern record, or `@implements(Drop)` on a
  /// `@cLayout` record, whose drop state byte would change the C layout.
  const C_LAYOUT_RECORD_IMPLEMENTS: static str = "A0214";
  /// Two extern records with one name. Each defines a C struct under its
  /// written name, which is global in C.
  const DUPLICATE_EXTERN_RECORD: static str = "A0215";
  /// A field of a C-layout record whose type has no C representation.
  const C_LAYOUT_FIELD_TYPE: static str = "A0216";
  /// A function value passed where C takes a plain function pointer that is
  /// not provably capture-free (a named function or a closure literal without
  /// captures), or whose signature takes or returns a function value.
  const C_FUNCTION_POINTER_NOT_CAPTURE_FREE: static str = "A0217";
  /// A field of a C-layout record named by a C keyword. The struct keeps its
  /// written field names, and C cannot spell a member that way.
  const C_LAYOUT_FIELD_RESERVED_NAME: static str = "A0218";
  /// A reference to a function-typed field of a C-layout record. The field
  /// holds a C function pointer, so the reference could only point at a
  /// temporary function value built from it, and writes through it would be
  /// lost.
  const C_LAYOUT_FUNCTION_FIELD_REFERENCE: static str = "A0219";
  /// An `asm` location or clobber that names no register asm can use and no
  /// operand class: an unknown name, a register reserved for the stack, or a
  /// class in a place it cannot be, such as an `imm` output.
  const INLINE_ASM_LOCATION: static str = "A0220";
  /// An `asm` operand whose type a register or an immediate cannot hold. Only
  /// integers and raw pointers go in registers, and only integers in `imm`.
  const INLINE_ASM_OPERAND_TYPE: static str = "A0221";
  /// An `asm` operand whose type is not as wide as the register it names.
  const INLINE_ASM_REGISTER_WIDTH: static str = "A0222";
  /// A `{name}` hole of an `asm` body that names no operand, or names two.
  const INLINE_ASM_HOLE: static str = "A0223";
  /// Two `asm` inputs or two outputs in one register, a clobber that names an
  /// operand's register, or a clobber written twice.
  const INLINE_ASM_DUPLICATE_REGISTER: static str = "A0224";
  /// An `asm` input that cannot be used the way its location says: an `imm`
  /// input that is not a constant, a `mem` input that is not a place, or an
  /// `inout` input that is not a place the asm may write.
  const INLINE_ASM_OPERAND_PLACE: static str = "A0225";
  /// An `asm` whose outputs do not fit its form: `pure` without outputs, an
  /// expression with more than one output, or two outputs with one name.
  const INLINE_ASM_OUTPUTS: static str = "A0226";
  /// A read of a local whose value was moved away. Belongs to the ownership
  /// family (`O`) in the Rust oracle, which emits it from the HIR ownership
  /// checker rather than from the borrow checker.
  const USE_AFTER_MOVE: static str = "O0001";
  /// A move whose source is borrowed storage: a pattern binding destructured
  /// out of a reference-typed scrutinee, handed on as if it were owned.
  const CANNOT_MOVE_OUT_OF_BORROW: static str = "A0186";
  /// A local that some branch of a join moved and another left live.
  const INCONSISTENT_MOVE_IN_BRANCHES: static str = "O0003";
  /// A read of a local whose value was handed to a manual `.drop()` call.
  const USE_AFTER_DROP: static str = "O0006";
  /// A second manual `.drop()` on a local the first one already dropped.
  const DOUBLE_DROP: static str = "O0007";
  /// A local that some branch of a join dropped manually and another left live.
  const INCONSISTENT_DROP_IN_BRANCHES: static str = "O0008";
  /// A manual `.drop()` whose receiver is neither a local nor a field of one,
  /// so no compile-time state tracks it. Reported as a warning.
  const DROP_ON_COMPLEX_RECEIVER: static str = "O0010";

  /// The standard library manifest is missing.
  const BUILD_STD_MANIFEST_MISSING: static str = "B1001";
  const BUILD_STD_MANIFEST_MALFORMED: static str = "B1002";
  const BUILD_STD_MANIFEST_INVALID_FIELD_TYPE: static str = "B1003";
  const BUILD_UNKNOWN_KEY: static str = "B1004";
  const BUILD_CONFIG_INVALID_ENTRY: static str = "B1010";
  /// A module source that cannot be found or read, which also names a project
  /// or std root that cannot be resolved.
  const BUILD_MISSING_MODULE: static str = "B2001";
  const BUILD_AMBIGUOUS_IMPORT: static str = "B2002";
  const BUILD_CYCLIC_IMPORT: static str = "B2003";
  const BUILD_INVALID_PROFILE: static str = "B2004";
  const TOOLCHAIN_COMPILE_FAILED: static str = "B4001";
  const TOOLCHAIN_ARCHIVE_FAILED: static str = "B4002";
  const TOOLCHAIN_LINK_FAILED: static str = "B4003";
  /// A backend that cannot build what was asked: an unknown target, a mode
  /// the backend does not support, or an instruction it cannot lower yet.
  const BACKEND_UNSUPPORTED: static str = "B4004";
  const QBE_LOWER_FAILED: static str = "B4005";
  const PIPELINE_STD_BUILD_FAILED: static str = "B5001";
  const PIPELINE_STD_HEADER_WRITE_FAILED: static str = "B5002";
  const PIPELINE_STD_ARCHIVE_MISSING: static str = "B5003";
  const PIPELINE_USER_LINK_BLOCKED: static str = "B5004";
  const CONFIG_NOT_FOUND: static str = "C1001";
  const CONFIG_MALFORMED_TOML: static str = "C1002";
  const CONFIG_INVALID_FIELD_TYPE: static str = "C1003";
  const CONFIG_EMPTY_FIELD: static str = "C1004";
  const CONFIG_RESERVED_ALIAS: static str = "C1005";
  const CONFIG_PATH_NOT_FOUND: static str = "C1006";
  const CONFIG_MISSING_STD_MANIFEST: static str = "C1007";
  const CONFIG_UNKNOWN_KEY: static str = "C1008";
  const FORMAT_CONFIG_IO: static str = "F1001";
  const FORMAT_CONFIG_PARSE: static str = "F1002";
  const FORMAT_CONFIG_UNKNOWN_KEY: static str = "F1003";
  const FORMAT_CONFIG_INVALID_VALUE: static str = "F1004";

  function isStable(value: str): boolean {
    let code: String = String::create(value);

    if (code.length() != 5) {
      return false;
    }

    let prefixOption: Option<char> = code.charAt(0);

    if (let Option::SOME(prefix) = prefixOption) {
      if (!isUppercaseLetter(prefix)) {
        return false;
      }
    } else {
      return false;
    }

    let mut index: u64 = 1;

    while (index < 5) {
      let currentOption: Option<char> = code.charAt(index);

      if (let Option::SOME(current) = currentOption) {
        if (!isDigit(current)) {
          return false;
        }
      } else {
        return false;
      }

      index += 1;
    }

    return true;
  }
}
