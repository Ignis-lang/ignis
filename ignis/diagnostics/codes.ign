  /// A `mut` local binding that is never mutated.
  /// Emitted by the lint phase at the level of the `unused_mut` lint.
  const UNUSED_MUT: static str = "A0127";
  /// An `@allow`/`@warn`/`@deny` argument that names no known lint.
  const UNKNOWN_LINT: static str = "A0125";
  /// An attribute supplied with the wrong number of arguments.
  const ATTRIBUTE_ARG_COUNT: static str = "A0118";
  /// An attribute the declaration it is written on does not accept.
  const UNKNOWN_ATTRIBUTE: static str = "A0117";
  /// A `@lang(try)` enum that does not have exactly two variants.
  const LANG_TRY_REQUIRES_TWO_VARIANTS: static str = "A0274";
  /// An `@aligned(N)` whose `N` is not a power of two.
  const ALIGNMENT_NOT_POWER_OF_TWO: static str = "A0121";
  /// An `@externName` export written on a generic function: every
