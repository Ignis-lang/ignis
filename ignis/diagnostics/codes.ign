import Char from "std::char";

function isUppercaseLetter(value: char): boolean {
  return Char::isAsciiUppercase(value);
}

function isDigit(value: char): boolean {
  return Char::isAsciiNumeric(value);
}

export namespace DiagnosticCode {
  const EXPECTED_TOKEN: str = "I0001";
  const UNEXPECTED_TOKEN: str = "I0002";
  const INVALID_TOKEN: str = "I0003";
  const EXPECTED_EXPRESSION: str = "I0004";
  const EXPECTED_VARIABLE_NAME: str = "I0005";
  const EXPECTED_RETURN_TYPE_AFTER_FUNCTION: str = "I0006";
  const EXPECTED_AFTER_EXPRESSION: str = "I0007";
  const EXPECTED_EXPRESSION_AFTER: str = "I0008";
  const INVALID_ASSIGNMENT_TARGET: str = "I0009";
  const EXPECTED_TYPE_AFTER_VARIABLE: str = "I0010";
  const INVALID_NUMBER_OF_ARGUMENTS: str = "I0011";
  const EXPECTED_SEMICOLON_AFTER_EXPRESSION: str = "I0012";
  const INVALID_ENUM_MEMBER: str = "I0013";
  const EXPECTED_TYPE_AFTER_PIPE: str = "I0014";
  const EXPECTED_DELIMITER: str = "I0015";
  const EXPECTED_TYPE: str = "I0016";
  const UNEXPECTED_KEYWORD: str = "I0017";
  const EXPECTED_IDENTIFIER: str = "I0018";
  const UNINITIALIZED_CONSTANT: str = "I0019";
  const EXPECTED_PATTERN: str = "I0020";
  const UNTERMINATED_COMMENT: str = "I0021";
  const UNTERMINATED_CHARACTER: str = "I0022";
  const INVALID_CHARACTER_ESCAPE_SEQUENCE: str = "I0023";
  const INVALID_CHARACTER: str = "I0024";
  const UNTERMINATED_STRING: str = "I0025";
  const UNEXPECTED_GENERICS: str = "I0026";
  const UNDEFINED_META: str = "I0027";
  const INVALID_META_ENTITY: str = "I0028";
  const MISSING_ARGUMENT: str = "I0029";
  const INVALID_ARGUMENT_TYPE: str = "I0030";
  const TYPE_MISMATCH: str = "I0031";
  const UNDECLARED_VARIABLE: str = "I0033";
  const VARIABLE_ALREADY_DEFINED: str = "I0041";
  const FUNCTION_ALREADY_DEFINED: str = "I0042";
  const UNDEFINED_TYPE: str = "I0043";
  const EXPECTED_INTEGER: str = "I0044";
  const EXPECTED_FLOAT: str = "I0045";
  const EXPECTED_HEX: str = "I0046";
  const EXPECTED_BINARY: str = "I0047";
  const MULTI_BYTE_CHARACTER_LITERAL: str = "I0050";
  const RAW_NUL_IN_SOURCE: str = "I0051";
  const UNTERMINATED_TEMPLATE_STRING: str = "I0052";
  /// A `&mut` reference taken to an immutable binding or place.
  const MUTABLE_REFERENCE_TO_IMMUTABLE: str = "A0014";
  /// A cast between two types with no supported conversion.
  const INVALID_CAST: str = "A0015";
  /// A shift or bitwise binary operator applied to non-integer operands.
  const INVALID_BINARY_OPERAND_TYPE: str = "A0019";
  /// A unary operator applied to an operand type it does not support.
  const INVALID_UNARY_OPERAND_TYPE: str = "A0020";
  /// A dereference of a value that is neither a pointer nor a reference.
  const DEREFERENCE_NON_POINTER: str = "A0021";
  /// A vector index expression whose type is not an integer.
  const VECTOR_INDEX_NON_INTEGER: str = "A0022";
  /// An index applied to a value that is not a slice, fixed array, or
  /// pointer.
  const ACCESS_NON_VECTOR: str = "A0023";
  /// A `&`/`&mut` reference taken to an expression that is not an lvalue.
  const INVALID_REFERENCE_TARGET: str = "A0029";
  const COMPOUND_ASSIGNMENT_NON_NUMERIC: str = "A0030";
  const NO_OVERLOAD_MATCHES: str = "A0100";
  const AMBIGUOUS_OVERLOAD: str = "A0101";
  /// An integer literal that does not fit the expected integer type.
  const INTEGER_OVERFLOW: str = "A0046";
  const TYPE_ALREADY_DEFINED: str = "A0052";
  /// Construct not yet implemented by the selfhost compiler (a temporary
  /// wall). Shared by every "not supported"/"not yet supported" site across
  /// the resolver and typechecker; removed as each wall is lifted.
  const UNSUPPORTED_CONSTRUCT: str = "A0053";
  /// A generic type reference supplies the wrong number of type arguments.
  const GENERIC_ARITY_MISMATCH: str = "A0054";
  /// Generic arguments applied to a type-parameter or primitive base, which
  /// cannot take generic arguments.
  const GENERIC_ARGS_NOT_ALLOWED: str = "A0055";
  /// A definition kind is used where its kind is not valid syntactically
  /// (e.g. a trait name in type position, a method in pattern position).
  const INVALID_ENTITY_POSITION: str = "A0056";
  /// A direct import binds a name that already exists in the importing
  /// module's direct-import overlay.
  const DUPLICATE_IMPORT_NAME: str = "A0057";
  /// A `match` arm or `if`/`else` branch produces a type that disagrees with
  /// its sibling arms/branches.
  const ARM_OR_BRANCH_TYPE_MISMATCH: str = "A0058";
  /// An `if` expression used in value position has no `else` branch.
  const IF_MISSING_ELSE: str = "A0059";
  /// A type alias chain refers back to itself.
  const CYCLIC_TYPE_ALIAS: str = "A0060";
  /// A `match` does not cover every possible value of its scrutinee type.
  /// Emitted as a WARNING in statement position and an ERROR in value
  /// position.
  const NON_EXHAUSTIVE_MATCH: str = "A0061";
  /// A destructuring pattern supplies the wrong number of record fields or
  /// enum-variant payload elements.
  const PATTERN_ARITY_MISMATCH: str = "A0062";
  /// An or-pattern whose alternatives introduce bindings. The resolver has no
  /// binding-merge across alternatives yet (IGN-15), so only binding-free
  /// alternatives are accepted.
  const OR_PATTERN_BINDINGS_DISALLOWED: str = "A0157";
  /// A referenced record field or method does not exist on its owner type.
  const UNKNOWN_MEMBER: str = "A0063";
  /// A record initializer supplies the same field more than once.
  const DUPLICATE_RECORD_FIELD_INIT: str = "A0064";
  /// A record initializer omits a field declared by the record.
  const MISSING_RECORD_FIELD_INIT: str = "A0065";
  /// A method is called or referenced in a way that mismatches its static
  /// vs. instance calling convention (called without a receiver, called
  /// through an incompatible receiver, or referenced without a call).
  const METHOD_CALL_KIND_MISMATCH: str = "A0066";
  /// An assignment or mutable method call targets an immutable binding.
  const MUTABILITY_VIOLATION: str = "A0067";
  /// `break` or `continue` used outside of a loop.
  const CONTROL_FLOW_OUTSIDE_LOOP: str = "A0068";
  /// A call expression whose callee is a value that is not a function.
  const CALL_ON_NON_CALLABLE: str = "A0069";
  /// A `@name(...)` call naming a builtin the compiler does not define.
  const UNKNOWN_BUILTIN: str = "A0070";
  /// A `_` placeholder written outside the right side of a pipe.
  const PIPE_PLACEHOLDER_OUTSIDE_PIPE: str = "A0071";
  /// More than one `_` placeholder in a single pipe step.
  const PIPE_MULTIPLE_PLACEHOLDERS: str = "A0072";
  /// A `_` placeholder standing alone as the whole right side of a pipe.
  const PIPE_PLACEHOLDER_NOT_IN_CALL: str = "A0073";
  /// A pipe whose right side is not something that can be called.
  const PIPE_RIGHT_NOT_CALLABLE: str = "A0074";
  /// A pipe right side that takes arguments but cannot receive the value implicitly.
  const PIPE_RIGHT_NEEDS_PLACEHOLDER: str = "A0075";
  /// A type the checker cannot determine: an unannotated local without an
  /// initializer, or a `null` literal with no expected pointer type.
  const CANNOT_INFER_TYPE: str = "A0076";
  /// A `null` literal supplied where the expected type is not a pointer.
  const INVALID_NULL_LITERAL: str = "A0077";
  /// The operand of `!` is not a `@lang(try)` enum.
  const TRY_ON_NON_TRY_TYPE: str = "A0078";
  /// The enclosing function's return type cannot carry the error `!` propagates:
  /// it is not the same `@lang(try)` enum as the operand's.
  const TRY_RETURN_TYPE_MISMATCH: str = "A0079";
  /// The operand's error payload differs from the enclosing return type's
  /// error payload, so `!` cannot propagate it unchanged.
  const TRY_ERROR_TYPE_MISMATCH: str = "A0080";
  /// A `for..of` iterable that is not a slice, fixed array, or iterable
  /// record (`data: *T` plus `length: u64`).
  const FOR_OF_EXPECTS_VECTOR: str = "A0081";
  /// A `for..of` binding that takes a non-Copy element by value instead of
  /// by reference.
  const FOR_OF_REQUIRES_COPY_OR_REF: str = "A0082";
  /// A `&mut` `for..of` binding over an iterable that is not a mutable place.
  const FOR_OF_MUT_REQUIRES_MUTABLE_ITER: str = "A0083";
  /// A deferred expression whose type is not `void`.
  const DEFER_EXPRESSION_MUST_BE_VOID: str = "A0084";
  /// A `.member` access whose receiver holds no fields — a primitive, an
  /// enum, a reference to one, or any other non-record type.
  const MEMBER_ACCESS_ON_NON_RECORD: str = "A0085";
  /// A call whose explicit type arguments do not match the callee's declared
  /// type parameters in number.
  const TYPE_ARGUMENT_COUNT_MISMATCH: str = "A0086";
  /// A record declaring `@implements(Copy)` whose field type is not Copy.
  const COPY_ON_NON_COPY_FIELD: str = "A0148";
  /// An enum declaring `@implements(Copy)` whose variant payload type is not
  /// Copy.
  const COPY_ON_NON_COPY_VARIANT_PAYLOAD: str = "A0149";
  /// A statement inside a block after a terminator (`return`/`break`/
  /// `continue` or a `never`-typed expression statement).
  const UNREACHABLE_CODE: str = "A0025";
  /// A non-void function or method whose body does not always return.
  const MISSING_RETURN_STATEMENT: str = "A0039";
  /// A `let else` whose else block does not always diverge.
  const LET_ELSE_MUST_DIVERGE: str = "A0168";
  /// A `let name: T = value else` whose value is not a `@lang(try)` enum, so
  /// there is no ok payload for the binding to take.
  const LET_ELSE_BINDING_REQUIRES_TRY_TYPE: str = "A0187";
  /// Reserved for `defer` outside a function (Rust oracle parity). The
  /// selfhost grammar has no top-level statements, so the extra-checks phase
  /// never emits it.
  const DEFER_OUTSIDE_FUNCTION: str = "A0183";
  /// A postfix try operator `!` used anywhere inside a deferred statement.
  const TRY_OPERATOR_IN_DEFER: str = "A0184";
  /// A local binding that is never read.
  /// Emitted by the lint phase at the level of the `unused_variable` lint.
  const UNUSED_VARIABLE: str = "A0122";
  /// An imported definition never referenced in the importing module.
  /// Emitted as a WARNING by the lint phase.
  const UNUSED_IMPORT: str = "A0123";
  /// A `mut` local binding that is never mutated.
  /// Emitted by the lint phase at the level of the `unused_mut` lint.
  const UNUSED_MUT: str = "A0127";
  /// An `@allow`/`@warn`/`@deny` argument that names no known lint.
  const UNKNOWN_LINT: str = "A0125";
  /// An attribute supplied with the wrong number of arguments.
  const ATTRIBUTE_ARG_COUNT: str = "A0118";
  /// A builtin whose type argument or value argument breaks a constraint the
  /// builtin itself imposes, such as `@pointerCast` on a non-pointer.
  const BUILTIN_TYPE_CONSTRAINT: str = "A0116";
  /// A call to a function or method marked `@deprecated`.
  /// Emitted as a WARNING by the lint phase.
  const DEPRECATED_CALL: str = "A0124";
  /// A shared borrow taken while a mutable borrow of the same local is live.
  const BORROW_IMMUTABLE_WHILE_MUTABLE: str = "A0036";
  /// A mutable borrow taken while a shared borrow of the same local is live.
  const BORROW_MUTABLE_WHILE_IMMUTABLE: str = "A0037";
  /// A second mutable borrow taken while the first one is still live.
  const BORROW_MUTABLE_WHILE_MUTABLE: str = "A0038";
  /// An assignment to a local while a borrow of it is live.
  const MUTATED_WHILE_BORROWED: str = "A0047";

  /// A closure that outlives its defining scope while holding a reference
  /// capture: the frame the reference points into is gone by the time the
  /// closure runs.
  const CLOSURE_ESCAPES_WITH_REF_CAPTURE: str = "A0170";
  /// A read of a local whose value was moved away. Belongs to the ownership
  /// family (`O`) in the Rust oracle, which emits it from the HIR ownership
  /// checker rather than from the borrow checker.
  const USE_AFTER_MOVE: str = "O0001";
  /// A move whose source is borrowed storage: a pattern binding destructured
  /// out of a reference-typed scrutinee, handed on as if it were owned.
  const CANNOT_MOVE_OUT_OF_BORROW: str = "O0002";
  /// A local that some branch of a join moved and another left live.
  const INCONSISTENT_MOVE_IN_BRANCHES: str = "O0003";
  /// A read of a local whose value was handed to a manual `.drop()` call.
  const USE_AFTER_DROP: str = "O0006";
  /// A second manual `.drop()` on a local the first one already dropped.
  const DOUBLE_DROP: str = "O0007";
  /// A local that some branch of a join dropped manually and another left live.
  const INCONSISTENT_DROP_IN_BRANCHES: str = "O0008";
  /// A manual `.drop()` whose receiver is neither a local nor a field of one,
  /// so no compile-time state tracks it. Reported as a warning.
  const DROP_ON_COMPLEX_RECEIVER: str = "O0010";

  function isStable(value: str): boolean {
    let code: String = String::create(value);

    if (code.length() != 5) {
      return false;
    }

    let prefixOption: Option<char> = code.charAt(0);

    if (let Option::SOME(prefix) = prefixOption) {
      if (!isUppercaseLetter(prefix)) {
        return false;
      }
    } else {
      return false;
    }

    let mut index: u64 = 1;

    while (index < 5) {
      let currentOption: Option<char> = code.charAt(index);

      if (let Option::SOME(current) = currentOption) {
        if (!isDigit(current)) {
          return false;
        }
      } else {
        return false;
      }

      index += 1;
    }

    return true;
  }
}
