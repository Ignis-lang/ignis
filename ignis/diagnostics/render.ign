import Terminal from "std::terminal";

import Diagnostic, DiagnosticBag, LabelKind, Severity from "./model";
import SourceFile, SourceLocation, SourceSpan, trimLineEnding from "./source";

function lineText(source: &SourceFile, lineIndex: u32): String {
  let start: u64 = source.lineStart(lineIndex);
  let endExclusive: u64 = source.lineEnd(lineIndex);
  let contentEnd: u64 = trimLineEnding(&source.text, start, endExclusive);

  return source.text.substring(start as i64, (contentEnd - start) as i64);
}

function lineDisplayWidth(line: &String): u32 {
  let mut column: u32 = 0;
  let mut offset: u64 = 0;

  while (offset < line.length()) {
    let mut endByte: u64 = offset;
    let Option::SOME(_) = line.charAt(offset, &mut endByte) else {
      break;
    };

    column += 1;
    offset = endByte;
  }

  return column;
}

function stage0CaretWidth(source: &SourceFile, span: &SourceSpan, location: SourceLocation): u32 {
  if (span.start == span.end) {
    return 1;
  }

  let endLocation: SourceLocation = source.lineCol(span.end);

  if (endLocation.line == location.line && endLocation.column > location.column) {
    return endLocation.column - location.column;
  }

  let currentLineText: String = lineText(source, location.line - 1);
  let lineLength: u32 = lineDisplayWidth(&currentLineText);

  if (lineLength >= location.column) {
    return lineLength - location.column + 1;
  }

  return 1;
}

function severityColor(severity: Severity): Terminal::TerminalColor {
  return match (severity) {
    Severity::ERROR -> Terminal::TerminalColor::RED,
    Severity::WARNING -> Terminal::TerminalColor::YELLOW,
    Severity::INFO -> Terminal::TerminalColor::BLUE,
    Severity::HINT -> Terminal::TerminalColor::CYAN,
  };
}

/// One underlined span of a snippet: where it starts on its line, how many
/// display columns it covers, and the text written after the underline.
record Annotation {
  public lineIndex: u32;
  public column: u32;
  public width: u32;
  public primary: boolean;
  public message: String;
}

/// How one diagnostic is drawn: whether ANSI styling is on, the color of its
/// primary underlines, and the gutter width every row of it shares.
record SnippetStyle {
  public useAnsi: boolean;
  public severityColor: Terminal::TerminalColor;
  public gutterWidth: u64;
}

function annotationFor(
  source: &SourceFile,
  span: &SourceSpan,
  primary: boolean,
  message: String
): Annotation {
  let location: SourceLocation = source.lineCol(span.start);

  return Annotation {
    lineIndex: location.line - 1,
    column: location.column,
    width: stage0CaretWidth(source, span, location),
    primary: primary,
    message: message,
  };
}

/// The index of the first file in `files` whose path is `path`.
function fileIndexOf(files: &Vector<SourceFile>, path: str): Option<u64> {
  let mut index: u64 = 0;

  while (index < files.length()) {
    if (let Option::SOME(file) = files.get(index) && path.equals(file.path.asStr())) {
      return Option::SOME(index);
    }

    index += 1;
  }

  return Option::NONE;
}

/// Whether `span` points into one of `files` other than `source`. Such a label
/// renders in that file's own snippet; any other renders against `source`.
function pointsIntoAnotherFile(
  span: &SourceSpan,
  source: &SourceFile,
  files: &Vector<SourceFile>
): boolean {
  if (span.file.equals(&source.id)) {
    return false;
  }

  let mut index: u64 = 0;

  while (index < files.length()) {
    if (let Option::SOME(file) = files.get(index) && span.file.equals(&file.id)) {
      return true;
    }

    index += 1;
  }

  return false;
}

/// The annotations of `diagnostic`, primary span first, then every label in
/// insertion order, except labels that point into another file of `files`.
/// The first primary label covering exactly the primary span is folded into
/// it. A primary label that repeats the diagnostic message carries no text,
/// since the header already shows it.
function collectAnnotations(
  diagnostic: &Diagnostic,
  source: &SourceFile,
  files: &Vector<SourceFile>
): Vector<Annotation> {
  let primarySpan: SourceSpan = diagnostic.primarySpan;
  let diagnosticMessage: str = diagnostic.messageText();
  let mut primaryMessage: String = String::new();
  let mut primaryMerged: boolean = false;
  let mut labelAnnotations: Vector<Annotation> = Vector::new<Annotation>();
  let mut labelIndex: u64 = 0;

  while (labelIndex < diagnostic.labels.length()) {
    let Option::SOME(label) = diagnostic.labels.get(labelIndex) else {
      labelIndex += 1;
      continue;
    };

    let labelSpan: SourceSpan = label.span;

    if (pointsIntoAnotherFile(&labelSpan, source, files)) {
      labelIndex += 1;
      continue;
    }

    let primary: boolean = label.kind == LabelKind::PRIMARY;
    let mut message: String = String::create(label.messageText());

    if (primary && message.equals(diagnosticMessage)) {
      message = String::new();
    }

    if (primary && !primaryMerged && @eq<SourceSpan>(&labelSpan, &primarySpan)) {
      primaryMessage = message;
      primaryMerged = true;
    } else {
      labelAnnotations.push(annotationFor(source, &labelSpan, primary, message));
    }

    labelIndex += 1;
  }

  let mut annotations: Vector<Annotation> = Vector::new<Annotation>();
  annotations.push(annotationFor(source, &primarySpan, true, primaryMessage));

  let mut index: u64 = 0;
  while (index < labelAnnotations.length()) {
    if (let Option::SOME(annotation) = labelAnnotations.get(index)) {
      annotations.push(Annotation {
        lineIndex: annotation.lineIndex,
        column: annotation.column,
        width: annotation.width,
        primary: annotation.primary,
        message: annotation.message.clone(),
      });
    }

    index += 1;
  }

  return annotations;
}

/// The annotations of the labels of `diagnostic` that point into `file`, in
/// insertion order.
function collectLabelsIn(diagnostic: &Diagnostic, file: &SourceFile): Vector<Annotation> {
  let mut annotations: Vector<Annotation> = Vector::new<Annotation>();
  let mut labelIndex: u64 = 0;

  while (labelIndex < diagnostic.labels.length()) {
    if (let Option::SOME(label) = diagnostic.labels.get(labelIndex) && label.span.file.equals(&file.id)) {
      let labelSpan: SourceSpan = label.span;

      annotations.push(annotationFor(file, &labelSpan, label.kind == LabelKind::PRIMARY, String::create(label.messageText())));
    }

    labelIndex += 1;
  }

  return annotations;
}

/// Where the first label of `diagnostic` that points into `file` starts.
function firstLabelStartIn(diagnostic: &Diagnostic, file: &SourceFile): u64 {
  let mut labelIndex: u64 = 0;

  while (labelIndex < diagnostic.labels.length()) {
    if (let Option::SOME(label) = diagnostic.labels.get(labelIndex) && label.span.file.equals(&file.id)) {
      return label.span.start;
    }

    labelIndex += 1;
  }

  return 0;
}

/// The snippet of another file that labels of a diagnostic point into.
record ForeignSnippet {
  public fileIndex: u64;

  /// Where the first label into the file starts, shown after `:::`.
  public location: SourceLocation;
  public annotations: Vector<Annotation>;
}

/// The snippet of `files[fileIndex]` for `diagnostic`, or `NONE` when that file
/// is `source`, repeats an earlier path, or holds none of its labels.
function foreignSnippetFor(
  diagnostic: &Diagnostic,
  source: &SourceFile,
  files: &Vector<SourceFile>,
  fileIndex: u64
): Option<ForeignSnippet> {
  let Option::SOME(file) = files.get(fileIndex) else {
    return Option::NONE;
  };
  let path: str = file.path.asStr();

  if (path.equals(source.path.asStr())) {
    return Option::NONE;
  }

  let Option::SOME(firstIndex) = fileIndexOf(files, path) else {
    return Option::NONE;
  };

  if (firstIndex != fileIndex) {
    return Option::NONE;
  }

  let labels: Vector<Annotation> = collectLabelsIn(diagnostic, file);

  if (labels.length() == 0) {
    return Option::NONE;
  }

  return Option::SOME(ForeignSnippet {
      fileIndex: fileIndex,
      location: file.lineCol(firstLabelStartIn(diagnostic, file)),
      annotations: labels,
    });
}

/// The smallest annotated line index strictly greater than `after`, or any
/// annotated line when `after` is `NONE`.
function nextAnnotatedLine(annotations: &Vector<Annotation>, after: Option<u32>): Option<u32> {
  let mut next: Option<u32> = Option::NONE;
  let mut index: u64 = 0;

  while (index < annotations.length()) {
    let Option::SOME(annotation) = annotations.get(index) else {
      index += 1;
      continue;
    };

    let candidate: u32 = annotation.lineIndex;
    let isAfter: boolean = match (after) {
      Option::SOME(previous) -> candidate > previous,
      Option::NONE -> true,
    };
    let isSmaller: boolean = match (next) {
      Option::SOME(current) -> candidate < current,
      Option::NONE -> true,
    };

    if (isAfter && isSmaller) {
      next = Option::SOME(candidate);
    }

    index += 1;
  }

  return next;
}

function gutterWidthFor(annotations: &Vector<Annotation>): u64 {
  let mut largestLine: u32 = 1;
  let mut index: u64 = 0;

  while (index < annotations.length()) {
    if (let Option::SOME(annotation) = annotations.get(index) && annotation.lineIndex + 1 > largestLine) {
      largestLine = annotation.lineIndex + 1;
    }

    index += 1;
  }

  return String::create(largestLine).length();
}

/// Writes a gutter: `lineNumber` right-aligned to the gutter width, or blanks
/// when it is `NONE`, followed by ` |`.
function appendGutter(output: &mut String, style: &SnippetStyle, lineNumber: Option<u32>): void {
  let mut outputRef: &mut String = output;

  let Option::SOME(number) = lineNumber else {
    outputRef.pushRepeated(" ", style.gutterWidth + 1);
    Terminal::appendStyled(output, "|", style.useAnsi, Terminal::TerminalColor::BLUE, true);
    return;
  };

  let numberText: String = String::create(number);

  outputRef.pushRepeated(" ", style.gutterWidth - numberText.length());

  let numbered: String = `${numberText.toStr()} |`;
  Terminal::appendStyled(output, numbered.toStr(), style.useAnsi, Terminal::TerminalColor::BLUE, true);
}

function appendEmptyGutterLine(output: &mut String, style: &SnippetStyle): void {
  appendGutter(output, style, Option::NONE);

  let mut outputRef: &mut String = output;
  outputRef.pushStr("\n");
}

function appendSourceLine(
  output: &mut String,
  style: &SnippetStyle,
  source: &SourceFile,
  lineIndex: u32
): void {
  let text: String = lineText(source, lineIndex);

  appendGutter(output, style, Option::SOME(lineIndex + 1));

  let mut outputRef: &mut String = output;

  if (text.length() > 0) {
    outputRef.pushStr(" ");
    outputRef.push(&text);
  }

  outputRef.pushStr("\n");
}

function appendUnderline(output: &mut String, style: &SnippetStyle, annotation: &Annotation): void {
  let mut color: Terminal::TerminalColor = Terminal::TerminalColor::BLUE;
  let mut marker: str = "-";

  if (annotation.primary) {
    color = style.severityColor;
    marker = "^";
  }

  let mut underline: String = String::new();
  underline.pushRepeated(marker, annotation.width as u64);

  if (!annotation.message.equals("")) {
    underline.pushStr(" ");
    underline.pushStr(annotation.message.toStr());
  }

  appendGutter(output, style, Option::NONE);

  let mut outputRef: &mut String = output;
  outputRef.pushStr(" ");
  outputRef.pushRepeated(" ", (annotation.column - 1) as u64);
  Terminal::appendStyled(output, underline.toStr(), style.useAnsi, color, true);
  outputRef.pushStr("\n");
}

/// Writes every annotated line in ascending order, each followed by the
/// underlines that start on it. A single line between two shown lines is
/// printed as context; a gap of two or more lines becomes a `...` row.
function appendSnippet(
  output: &mut String,
  style: &SnippetStyle,
  source: &SourceFile,
  annotations: &Vector<Annotation>
): void {
  let mut previousLine: Option<u32> = Option::NONE;

  while (let Option::SOME(lineIndex) = nextAnnotatedLine(annotations, previousLine)) {
    if (let Option::SOME(previous) = previousLine && lineIndex == previous + 2) {
      appendSourceLine(output, style, source, previous + 1);
    } else if (let Option::SOME(previous) = previousLine && lineIndex > previous + 2) {
      Terminal::appendStyled(output, "...", style.useAnsi, Terminal::TerminalColor::BLUE, true);

      let mut outputRef: &mut String = output;
      outputRef.pushStr("\n");
    }

    appendSourceLine(output, style, source, lineIndex);

    let mut index: u64 = 0;
    while (index < annotations.length()) {
      if (let Option::SOME(annotation) = annotations.get(index) && annotation.lineIndex == lineIndex) {
        appendUnderline(output, style, annotation);
      }

      index += 1;
    }

    previousLine = Option::SOME(lineIndex);
  }
}

/// Writes `marker` and `path:line:column`: `-->` for the primary location,
/// `:::` for a snippet of another file.
function appendLocation(
  output: &mut String,
  style: &SnippetStyle,
  source: &SourceFile,
  location: SourceLocation,
  marker: str
): void {
  let mut outputRef: &mut String = output;

  outputRef.pushRepeated(" ", style.gutterWidth);
  Terminal::appendStyled(output, marker, style.useAnsi, Terminal::TerminalColor::BLUE, true);
  outputRef.pushStr(" ");
  outputRef.pushStr(source.path.asStr());
  outputRef.pushChar(':');
  outputRef.pushStr(String::create(location.line).toStr());
  outputRef.pushChar(':');
  outputRef.pushStr(String::create(location.column).toStr());
  outputRef.pushStr("\n");
}

function appendSummaryLine(
  output: &mut String,
  style: &SnippetStyle,
  prefix: str,
  message: str,
  color: Terminal::TerminalColor
): void {
  let mut outputRef: &mut String = output;

  outputRef.pushRepeated(" ", style.gutterWidth + 1);
  outputRef.pushStr("= ");
  Terminal::appendStyled(output, prefix, style.useAnsi, color, true);
  outputRef.pushStr(" ");
  outputRef.pushStr(message);
  outputRef.pushStr("\n");
}

function appendHeader(output: &mut String, diagnostic: &Diagnostic, style: &SnippetStyle): void {
  let mut outputRef: &mut String = output;

  Terminal::appendStyled(output, diagnostic.severity.displayName(), style.useAnsi, style.severityColor, true);
  outputRef.pushChar('[');
  Terminal::appendStyled(output, diagnostic.code, style.useAnsi, style.severityColor, true);
  outputRef.pushStr("]: ");
  outputRef.pushStr(diagnostic.messageText());
  outputRef.pushStr("\n");
}

function appendNotes(output: &mut String, diagnostic: &Diagnostic, style: &SnippetStyle): void {
  let mut noteIndex: u64 = 0;

  while (noteIndex < diagnostic.notes.length()) {
    if (let Option::SOME(note) = diagnostic.notes.get(noteIndex)) {
      appendSummaryLine(output, style, "note:", note.messageText(), Terminal::TerminalColor::CYAN);
    }

    noteIndex += 1;
  }

  if (let Option::SOME(help) = diagnostic.helpText()) {
    appendSummaryLine(output, style, "help:", help, Terminal::TerminalColor::GREEN);
  }
}

@implements(Eq)
export enum RenderMode {
  PLAIN,
  ANSI,

  equals(&self, other: &RenderMode): boolean {
    return match (self) {
      RenderMode::PLAIN -> *other == RenderMode::PLAIN,
      RenderMode::ANSI -> *other == RenderMode::ANSI,
    };
  }
}

export record RenderOptions {
  public useAnsi: boolean;

  public static plain(): RenderOptions {
    return RenderOptions { useAnsi: false };
  }

  public static ansi(): RenderOptions {
    return RenderOptions { useAnsi: true };
  }
}

export namespace DiagnosticRenderer {
  /// Whether diagnostics and summaries written to stderr carry ANSI styling,
  /// which they do only when stderr is a terminal.
  function stderrUsesColor(): boolean {
    return Terminal::isErrorTerminal();
  }

  /// Renders `diagnostic` against `source`, every label included.
  function render(diagnostic: &Diagnostic, source: &SourceFile, useAnsi: boolean): String {
    let noOtherFiles: Vector<SourceFile> = Vector::new<SourceFile>();

    return DiagnosticRenderer::renderAcross(diagnostic, source, &noOtherFiles, useAnsi);
  }

  /// Renders `diagnostic` against `source`, the file of its primary span. A
  /// label that points into another file of `files` is shown in a snippet of
  /// that file after the primary one; a label whose file is not among `files`
  /// renders against `source`.
  function renderAcross(
    diagnostic: &Diagnostic,
    source: &SourceFile,
    files: &Vector<SourceFile>,
    useAnsi: boolean
  ): String {
    let mut rendered: String = String::new();
    let annotations: Vector<Annotation> = collectAnnotations(diagnostic, source, files);
    let mut foreignSnippets: Vector<ForeignSnippet> = Vector::new<ForeignSnippet>();
    let mut gutterWidth: u64 = gutterWidthFor(&annotations);
    let mut fileIndex: u64 = 0;

    while (fileIndex < files.length()) {
      if (let Option::SOME(snippet) = foreignSnippetFor(diagnostic, source, files, fileIndex)) {
        let width: u64 = gutterWidthFor(&snippet.annotations);

        if (width > gutterWidth) {
          gutterWidth = width;
        }

        foreignSnippets.push(snippet);
      }

      fileIndex += 1;
    }

    let style: SnippetStyle = SnippetStyle {
      useAnsi: useAnsi,
      severityColor: severityColor(diagnostic.severity),
      gutterWidth: gutterWidth,
    };

    appendHeader(&mut rendered, diagnostic, &style);
    appendLocation(&mut rendered, &style, source, source.lineCol(diagnostic.primarySpan.start), "-->");
    appendEmptyGutterLine(&mut rendered, &style);
    appendSnippet(&mut rendered, &style, source, &annotations);

    let mut snippetIndex: u64 = 0;

    while (snippetIndex < foreignSnippets.length()) {
      if (let Option::SOME(snippet) = foreignSnippets.get(snippetIndex) && let Option::SOME(file) = files.get(snippet.fileIndex)) {
        appendLocation(&mut rendered, &style, file, snippet.location, ":::");
        appendEmptyGutterLine(&mut rendered, &style);
        appendSnippet(&mut rendered, &style, file, &snippet.annotations);
      }

      snippetIndex += 1;
    }

    appendEmptyGutterLine(&mut rendered, &style);
    appendNotes(&mut rendered, diagnostic, &style);

    return rendered;
  }

  function writeTo(
    output: &mut String,
    diagnostic: &Diagnostic,
    source: &SourceFile,
    useAnsi: boolean
  ): void {
    let rendered: String = DiagnosticRenderer::render(diagnostic, source, useAnsi);
    let mut outputRef: &mut String = output;
    outputRef.pushStr(rendered.toStr());
  }

  function renderBag(bag: &DiagnosticBag, source: &SourceFile, useAnsi: boolean): String {
    let mut rendered: String = String::new();
    let mut index: u64 = 0;

    while (index < bag.length()) {
      let Option::SOME(diagnostic) = bag.get(index) else {
        index += 1;
        continue;
      };

      if (index > 0) {
        rendered.pushStr("\n");
      }

      let current: String = DiagnosticRenderer::render(diagnostic, source, useAnsi);
      rendered.push(&current);
      index += 1;
    }

    return rendered;
  }
}
