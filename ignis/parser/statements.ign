import Vector from "std::vector";

import Ast from "@compiler::ast";
import DiagnosticCode, SourceSpan from "@compiler::diagnostics";
import Keyword, Punctuation, Token from "@compiler::syntax";

import _ from "./shared";
import _ from "./expressions";
import _ from "./patterns";
import _ from "./recovery";
import _ from "./types";

export namespace ParserStatements {
  record ParsedCondition {
    public id: Ast::ExpressionId;
    public span: SourceSpan;
  }

  function parseForOfPattern(parser: &mut ParserShared::State): Option<Ast::PatternId> {
    let mut parserRef: &mut ParserShared::State = parser;
    let nameToken = parserRef.expectIdentifier("expected loop binding name")!;

    if (nameToken.lexemeString().equals("_")) {
      return Option::SOME(parserRef.module.addPattern(Ast::Pattern::Node::Wildcard(Ast::Pattern::Wildcard {
        span: nameToken.span,
      })));
    }

    let mut annotation: Option<Ast::TypeId> = Option::NONE;
    let mut span: SourceSpan = nameToken.span;

    if (parserRef.consumePunctuation(Punctuation::COLON).isSome()) {
      let typeId = ParserTypes::parseType(parserRef)!;
      annotation = Option::SOME(typeId);

      span = match (parserRef.module.types.get(typeId)) {
        Option::SOME(node) -> Ast::Serializer::typeSpan(node),
        Option::NONE -> span,
      };
    }

    return Option::SOME(parserRef.module.addPattern(Ast::Pattern::Node::Binding(Ast::Pattern::Binding {
      span: ParserShared::mergeSpans(nameToken.span, span),
      name: nameToken.lexemeString(),
      annotation: annotation,
      initializer: Option::NONE,
      metadata: Ast::emptyMetadata(),
    })));
  }

  /// Parses the condition of an `if` or a `while`.
  ///
  /// `let` is an ordinary prefix expression in both compilers — see
  /// `ParserExpressions::parseLetConditionExpression` — so a condition needs no
  /// shape of its own here: `let A = x`, `let A = x && let B = y` and
  /// `flag && let A = x` all fall out of the ordinary Pratt parse, left
  /// associated and spanned the way the host spans them. A `let` value stops
  /// before `&&`, so the conjuncts after it stay outside the scrutinee.
  function parseConditionExpression(parser: &mut ParserShared::State): Option<ParsedCondition> {
    let expressionResult: Option<ParserExpressions::ParsedExpression> = ParserExpressions::parseExpression(parser);
    let expression = expressionResult!;

    return Option::SOME(ParsedCondition {
      id: expression.id,
      span: expression.span,
    });
  }

  function parseLetStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;
    let keyword = parserRef.expectKeyword(Keyword::LET, "expected 'let'")!;
    let mutable: boolean = parserRef.consumeKeyword(Keyword::MUT).isSome();
    let patternResult: Option<Ast::PatternId> = ParserPatterns::parsePattern(parserRef);
    let pattern = patternResult!;

    let mut annotation: Option<Ast::TypeId> = Option::NONE;
    let mut value: Option<Ast::ExpressionId> = Option::NONE;

    if (parserRef.consumePunctuation(Punctuation::COLON).isSome()) {
      let typeId = ParserTypes::parseType(parserRef)!;
      annotation = Option::SOME(typeId);
    }

    if (parserRef.consumePunctuation(Punctuation::EQUAL).isSome()) {
      let expression = ParserExpressions::parseExpression(parserRef)!;
      value = Option::SOME(expression.id);

      if (parserRef.consumeKeyword(Keyword::ELSE).isSome()) {
        let elseBranchResult: Option<Ast::StatementId> = ParserStatements::parseBlockStatement(parserRef);
        let elseBranch = elseBranchResult!;
        let semicolon = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after let-else statement")!;
        let letValue: Ast::ExpressionId = match (value) {
          Option::SOME(expressionId) -> expressionId,
          Option::NONE -> @panic("missing let-else value"),
        };

        return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::LetElse(Ast::Statement::LetElse {
          span: ParserShared::mergeSpans(keyword.span, semicolon.span),
          mutable: mutable,
          pattern: pattern,
          annotation: annotation,
          value: letValue,
          elseBranch: elseBranch,
        })));
      }
    }

    let semicolon = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after let statement")!;
    let span: SourceSpan = ParserShared::mergeSpans(keyword.span, semicolon.span);

    if (mutable) {
      return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::Variable(Ast::Statement::Variable {
        span: span,
        mutable: true,
        pattern: pattern,
        annotation: annotation,
        value: value,
      })));
    }

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
      span: span,
      pattern: pattern,
      annotation: annotation,
      value: value,
    })));
  }

  function parseReturnStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;

    let keyword = parserRef.expectKeyword(Keyword::RETURN, "expected 'return'")!;

    let mut value: Option<Ast::ExpressionId> = Option::NONE;

    if (!parserRef.atPunctuation(Punctuation::SEMICOLON)) {
      let expression = ParserExpressions::parseExpression(parserRef)!;

      value = Option::SOME(expression.id);
    }

    let semicolon = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after return statement")!;

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::Return(Ast::Statement::Return {
      span: ParserShared::mergeSpans(keyword.span, semicolon.span),
      value: value,
    })));
  }

  function parseBreakStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;
    let keyword = parserRef.expectKeyword(Keyword::BREAK, "expected 'break'")!;
    let semicolon = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after break statement")!;

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::Break(Ast::Statement::Break {
      span: ParserShared::mergeSpans(keyword.span, semicolon.span),
      value: Option::NONE,
    })));
  }

  function parseContinueStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;
    let keyword = parserRef.expectKeyword(Keyword::CONTINUE, "expected 'continue'")!;
    let semicolon = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after continue statement")!;

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::Continue(Ast::Statement::Continue {
      span: ParserShared::mergeSpans(keyword.span, semicolon.span),
    })));
  }

  function parseDeferStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;
    let keyword = parserRef.expectKeyword(Keyword::DEFER, "expected 'defer'")!;
    let expressionResult: Option<ParserExpressions::ParsedExpression> = ParserExpressions::parseExpression(parserRef);
    let expression = expressionResult!;
    let semicolon = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after defer statement")!;

    let expressionId: Ast::ExpressionId = expression.id;
    let expressionSpan: SourceSpan = expression.span;

    let deferredExpression: Ast::StatementId = parserRef.module.addStatement(Ast::Statement::Node::Expression(Ast::Statement::Expression {
      span: expressionSpan,
      expression: expressionId,
    }));
    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::Defer(Ast::Statement::Defer {
      span: ParserShared::mergeSpans(keyword.span, semicolon.span),
      statement: deferredExpression,
    })));
  }

  function parseIfStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;
    let keyword = parserRef.expectKeyword(Keyword::IF, "expected 'if'")!;
    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::LEFT_PAREN, "expected '(' after 'if'") else {
      return Option::NONE;
    };
    let conditionResult: Option<ParsedCondition> = ParserStatements::parseConditionExpression(parserRef);
    let condition = conditionResult!;
    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::RIGHT_PAREN, "expected ')' after if condition") else {
      return Option::NONE;
    };
    let thenBranchResult: Option<Ast::StatementId> = ParserStatements::parseBlockStatement(parserRef);
    let thenBranch = thenBranchResult!;

    let mut elseBranch: Option<Ast::StatementId> = Option::NONE;
    let mut endSpan: SourceSpan = match (parserRef.module.statements.get(thenBranch)) {
      Option::SOME(node) -> Ast::Serializer::statementSpan(node),
      Option::NONE -> keyword.span,
    };

    if (parserRef.consumeKeyword(Keyword::ELSE).isSome()) {
      let mut elseStatementResult: Option<Ast::StatementId> = Option::NONE;

      if (parserRef.atKeyword(Keyword::IF)) {
        elseStatementResult = ParserStatements::parseIfStatement(parserRef);
      } else {
        elseStatementResult = ParserStatements::parseBlockStatement(parserRef);
      }

      let elseStatement = elseStatementResult!;
      elseBranch = Option::SOME(elseStatement);
      endSpan = match (parserRef.module.statements.get(elseStatement)) {
        Option::SOME(node) -> Ast::Serializer::statementSpan(node),
        Option::NONE -> endSpan,
      };
    }

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::If(Ast::Statement::If {
      span: ParserShared::mergeSpans(keyword.span, endSpan),
      condition: condition.id,
      thenBranch: thenBranch,
      elseBranch: elseBranch,
    })));
  }

  function parseWhileStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;
    let keyword = parserRef.expectKeyword(Keyword::WHILE, "expected 'while'")!;
    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::LEFT_PAREN, "expected '(' after 'while'") else {
      return Option::NONE;
    };
    let conditionResult: Option<ParsedCondition> = ParserStatements::parseConditionExpression(parserRef);
    let condition = conditionResult!;
    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::RIGHT_PAREN, "expected ')' after while condition") else {
      return Option::NONE;
    };
    let bodyResult: Option<Ast::StatementId> = ParserStatements::parseBlockStatement(parserRef);
    let body = bodyResult!;
    let endSpan: SourceSpan = match (parserRef.module.statements.get(body)) {
      Option::SOME(node) -> Ast::Serializer::statementSpan(node),
      Option::NONE -> keyword.span,
    };

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::While(Ast::Statement::While {
      span: ParserShared::mergeSpans(keyword.span, endSpan),
      condition: condition.id,
      body: body,
    })));
  }

  /// Parse everything after the binding of a C-style `for`, given the header
  /// tokens already consumed by `parseForStatement`.
  ///
  /// The initializer binds mutably even where the source writes no `mut`: the
  /// update clause assigns to it on every iteration, and the host parser marks
  /// the same binding mutable for that reason.
  function parseCStyleForRest(
    parser: &mut ParserShared::State,
    keyword: Token,
    pattern: Ast::PatternId,
  ): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;

    let mut annotation: Option<Ast::TypeId> = Option::NONE;
    if (parserRef.consumePunctuation(Punctuation::COLON).isSome()) {
      let typeId = ParserTypes::parseType(parserRef)!;
      annotation = Option::SOME(typeId);
    }

    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::EQUAL, "expected '=' in for initializer") else {
      return Option::NONE;
    };

    let initialValue = ParserExpressions::parseExpression(parserRef)!;
    let initializerSemicolon = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after for initializer")!;

    let initializer: Ast::StatementId = parserRef.module.addStatement(Ast::Statement::Node::Variable(Ast::Statement::Variable {
      span: ParserShared::mergeSpans(keyword.span, initializerSemicolon.span),
      mutable: true,
      pattern: pattern,
      annotation: annotation,
      value: Option::SOME(initialValue.id),
    }));

    let condition = ParserExpressions::parseExpression(parserRef)!;
    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after for condition") else {
      return Option::NONE;
    };

    let update = ParserExpressions::parseExpression(parserRef)!;
    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::RIGHT_PAREN, "expected ')' after for update") else {
      return Option::NONE;
    };

    let bodyResult: Option<Ast::StatementId> = ParserStatements::parseBlockStatement(parserRef);
    let body = bodyResult!;
    let endSpan: SourceSpan = match (parserRef.module.statements.get(body)) {
      Option::SOME(node) -> Ast::Serializer::statementSpan(node),
      Option::NONE -> keyword.span,
    };

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::For(Ast::Statement::For {
      span: ParserShared::mergeSpans(keyword.span, endSpan),
      initializer: Option::SOME(initializer),
      condition: Option::SOME(condition.id),
      update: Option::SOME(update.id),
      body: body,
    })));
  }

  function parseForStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;
    let keyword = parserRef.expectKeyword(Keyword::FOR, "expected 'for'")!;
    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::LEFT_PAREN, "expected '(' after 'for'") else {
      return Option::NONE;
    };
    let consumedLet: boolean = parserRef.consumeKeyword(Keyword::LET).isSome();
    let pattern = ParserStatements::parseForOfPattern(parserRef)!;

    if (!consumedLet) {
      parserRef.expectedToken(keyword.span, "Let", "selfhost parser currently supports 'for (let pattern of iterable)' syntax");
      return Option::NONE;
    }

    // `for (let i = 0; ...)` and `for (let i of xs)` share everything up to the
    // token after the binding, so the header is parsed once and the deciding
    // token picks the shape. An annotated binding reaches either one.
    if (parserRef.atPunctuation(Punctuation::COLON) || parserRef.atPunctuation(Punctuation::EQUAL)) {
      return ParserStatements::parseCStyleForRest(parserRef, keyword, pattern);
    }

    let Option::SOME(_) = parserRef.expectKeyword(Keyword::OF, "expected 'of' in for-of loop") else {
      return Option::NONE;
    };
    let iterableResult: Option<ParserExpressions::ParsedExpression> = ParserExpressions::parseExpression(parserRef);
    let iterable = iterableResult!;
    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::RIGHT_PAREN, "expected ')' after for-of iterable") else {
      return Option::NONE;
    };
    let bodyResult: Option<Ast::StatementId> = ParserStatements::parseBlockStatement(parserRef);
    let body = bodyResult!;
    let endSpan: SourceSpan = match (parserRef.module.statements.get(body)) {
      Option::SOME(node) -> Ast::Serializer::statementSpan(node),
      Option::NONE -> keyword.span,
    };

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::ForOf(Ast::Statement::ForOf {
      span: ParserShared::mergeSpans(keyword.span, endSpan),
      pattern: pattern,
      iterable: iterable.id,
      body: body,
    })));
  }

  function parseExpressionStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;

    let expression = ParserExpressions::parseExpression(parserRef)!;
    let semicolon = parserRef.expectPunctuation(Punctuation::SEMICOLON, "expected ';' after expression statement")!;

    let expressionId: Ast::ExpressionId = expression.id;
    let expressionSpan: SourceSpan = expression.span;

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::Expression(Ast::Statement::Expression {
      span: ParserShared::mergeSpans(expressionSpan, semicolon.span),
      expression: expressionId,
    })));
  }

  function parseStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;

    parserRef.skipTrivia();

    if (parserRef.atKeyword(Keyword::LET)) {
      return ParserStatements::parseLetStatement(parserRef);
    }

    if (parserRef.atKeyword(Keyword::CONST)) {
      return ParserExpressions::parseLocalConstStatement(parserRef);
    }

    if (parserRef.atKeyword(Keyword::IF)) {
      return ParserStatements::parseIfStatement(parserRef);
    }

    if (parserRef.atKeyword(Keyword::WHILE)) {
      return ParserStatements::parseWhileStatement(parserRef);
    }

    if (parserRef.atKeyword(Keyword::FOR)) {
      return ParserStatements::parseForStatement(parserRef);
    }

    if (parserRef.atKeyword(Keyword::RETURN)) {
      return ParserStatements::parseReturnStatement(parserRef);
    }

    if (parserRef.atKeyword(Keyword::DEFER)) {
      return ParserStatements::parseDeferStatement(parserRef);
    }

    if (parserRef.atKeyword(Keyword::BREAK)) {
      return ParserStatements::parseBreakStatement(parserRef);
    }

    if (parserRef.atKeyword(Keyword::CONTINUE)) {
      return ParserStatements::parseContinueStatement(parserRef);
    }

    if (parserRef.atPunctuation(Punctuation::LEFT_BRACE)) {
      return ParserStatements::parseBlockStatement(parserRef);
    }

    return ParserStatements::parseExpressionStatement(parserRef);
  }

  /// One branch of a compile-time directive in statement position. A discarded
  /// branch is skipped whole; the selected one splices its statements into the
  /// enclosing block.
  function parseCompileBranchStatements(
    parser: &mut ParserShared::State,
    selected: boolean,
    statements: &mut Vector<Ast::StatementId>
  ): boolean {
    let mut parserRef: &mut ParserShared::State = parser;

    if (!selected) {
      return ParserExpressions::skipCompileBranchBody(parserRef);
    }

    let Option::SOME(_) = parserRef.expectPunctuation(Punctuation::LEFT_BRACE, "expected '{' to open the compile-time directive branch") else {
      return false;
    };

    let mut statementsRef: &mut Vector<Ast::StatementId> = statements;

    while (!parserRef.atPunctuation(Punctuation::RIGHT_BRACE) && !parserRef.atEof()) {
      if (!ParserStatements::parseBlockEntry(parserRef, statementsRef)) {
        return false;
      }
    }

    return parserRef.expectPunctuation(Punctuation::RIGHT_BRACE, "expected '}' to close the compile-time directive branch").isSome();
  }

  /// `@if(<cond>) { ... } @else { ... }` and `@ifelse(<cond>) { ... } { ... }`
  /// in statement position: the condition folds while parsing, the discarded
  /// branch never reaches the AST, and the selected branch's statements take
  /// the directive's place. `@ifelse` requires the second branch, `@if` does
  /// not.
  function parseCompileDirectiveStatements(
    parser: &mut ParserShared::State,
    statements: &mut Vector<Ast::StatementId>
  ): boolean {
    let mut parserRef: &mut ParserShared::State = parser;

    let elseRequired: boolean = ParserExpressions::isCompileIfElseDirectiveStart(parserRef);
    let directiveSpan: SourceSpan = parserRef.current().span;

    let Option::SOME(condition) = ParserExpressions::parseCompileDirectiveHeader(parserRef) else {
      return false;
    };

    if (!ParserStatements::parseCompileBranchStatements(parserRef, condition, statements)) {
      return false;
    }

    if (ParserExpressions::isCompileElseDirectiveStart(parserRef)) {
      if (!ParserExpressions::consumeCompileElseDirective(parserRef)) {
        return false;
      }

      return ParserStatements::parseCompileBranchStatements(parserRef, !condition, statements);
    }

    if (!elseRequired) {
      return true;
    }

    if (parserRef.atPunctuation(Punctuation::LEFT_BRACE)) {
      return ParserStatements::parseCompileBranchStatements(parserRef, !condition, statements);
    }

    parserRef.expectedToken(directiveSpan, "At", "'@ifelse' requires an else branch");
    return false;
  }

  /// `@configFlag(<cond>) <statement>` in statement position: the condition
  /// folds while parsing, a true one keeps the single statement that follows,
  /// and a false one drops it whole.
  function parseConfigFlagStatement(
    parser: &mut ParserShared::State,
    statements: &mut Vector<Ast::StatementId>
  ): boolean {
    let mut parserRef: &mut ParserShared::State = parser;

    let Option::SOME(selected) = ParserExpressions::parseConfigFlagDirectiveHeader(parserRef) else {
      // The reference compiler reports the broken condition and then reads the
      // tokens it stopped at as a statement, which reports what they are
      // missing as well. Reading them here keeps that second diagnostic, and
      // with it the parse verdict the two compilers are compared on.
      ParserStatements::parseStatement(parserRef);
      return false;
    };

    if (!selected) {
      return ParserExpressions::skipGatedDeclaration(parserRef);
    }

    let mut statementsRef: &mut Vector<Ast::StatementId> = statements;

    let Option::SOME(statementId) = ParserStatements::parseStatement(parserRef) else {
      return false;
    };

    statementsRef.push(statementId);
    return true;
  }

  /// Collects one block entry: a compile-time directive expands to zero or more
  /// statements, anything else parses as a single statement.
  function parseBlockEntry(
    parser: &mut ParserShared::State,
    statements: &mut Vector<Ast::StatementId>
  ): boolean {
    let parserRef: &mut ParserShared::State = parser;

    if (ParserExpressions::isCompileIfDirectiveStart(parserRef)) {
      return ParserStatements::parseCompileDirectiveStatements(parserRef, statements);
    }

    if (ParserExpressions::isConfigFlagDirectiveStart(parserRef)) {
      return ParserStatements::parseConfigFlagStatement(parserRef, statements);
    }

    if (ParserExpressions::isCompileElseDirectiveStart(parserRef)) {
      ParserExpressions::rejectUnmatchedCompileElse(parserRef);
      return false;
    }

    let mut statementsRef: &mut Vector<Ast::StatementId> = statements;

    let Option::SOME(statementId) = ParserStatements::parseStatement(parserRef) else {
      return false;
    };

    statementsRef.push(statementId);
    return true;
  }
  function parseBlockStatement(parser: &mut ParserShared::State): Option<Ast::StatementId> {
    let mut parserRef: &mut ParserShared::State = parser;

    let openBrace = parserRef.expectPunctuation(Punctuation::LEFT_BRACE, "expected '{' to start block")!;
    let mut statements: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();

    while (!parserRef.atPunctuation(Punctuation::RIGHT_BRACE) && !parserRef.atEof()) {
      if (!ParserStatements::parseBlockEntry(parserRef, &mut statements)) {
        ParserRecovery::synchronizeBlockStatement(parserRef);
      }
    }

    if (parserRef.atEof()) {
      parserRef.emitDiagnostic(openBrace.span, DiagnosticCode::EXPECTED_DELIMITER, "Expected ',' or '}'", "block must close before end of file");
      return Option::NONE;
    }

    let closeBrace = parserRef.expectPunctuation(Punctuation::RIGHT_BRACE, "expected '}' after block")!;

    return Option::SOME(parserRef.module.addStatement(Ast::Statement::Node::Block(Ast::Statement::Block {
      span: ParserShared::mergeSpans(openBrace.span, closeBrace.span),
      statements: ParserExpressions::copyStatementIds(&statements),
      tail: Option::NONE,
    })));
  }
}
