import Ast from "@compiler::ast";
import SourceSpan, noFile from "@compiler::diagnostics";

import _ from "./declarations";
import _ from "./shared";

/// Copies every trait default method body onto the types that declare the
/// trait with `@implements` and do not declare the method themselves.
///
/// The pass runs once the module is fully parsed, so an implementing type can
/// appear before the trait it implements. The copy is a real method item on
/// the type, which is what lets binding, resolution, typechecking and lowering
/// treat an inherited default exactly like a hand-written method.
///
/// The copy owns its parameters and every statement, expression and pattern of
/// its body under fresh ids, so each implementing type resolves and types its
/// own body: name resolution records each body node once. Type syntax nodes and
/// nested item declarations stay shared with the trait declaration.
///
/// The parser cannot resolve names, but only a trait declared in this module
/// has a body it can copy, so each `@implements` path is read against the
/// traits of the module the way the resolver reads it: a bare name through the
/// namespaces the type is written in, innermost first, out to the top level; a
/// qualified path as the declaration whose path is it or ends with it.
/// Two traits sharing a name in different namespaces therefore hand their
/// defaults only to the types that implement each of them. A path that matches
/// no trait of the module copies nothing, and the analyzer reports it.
export namespace ParserTraitDefaults {
  /// One default method a trait declares with a body.
  record Entry {
    /// The trait's path inside the module, such as `Shapes::Measured`.
    public traitPath: String;
    public methodName: String;
    public methodItemId: Ast::ItemId;
    /// The body-less twin the trait lists among its methods, which the
    /// analyzer binds as the trait's own method.
    public signatureItemId: Option<Ast::ItemId>;
  }

  /// A default method that still has to be copied onto an implementing type.
  record Pending {
    public ownerItemId: Ast::ItemId;
    public traitName: String;
    public methodName: String;
    public methodItemId: Ast::ItemId;
  }

  /// The trimmed `::`-separated segments of an `@implements` argument,
  /// joined back with `::`, so `Ns :: Trait` reads as `Ns::Trait`.
  function normalizedPath(text: &String): String {
    let colon: u8 = 58;
    let mut path: String = String::create("");
    let mut start: u64 = 0;
    let mut index: u64 = 0;

    while (index <= text.length()) {
      let mut boundary: boolean = index == text.length();

      if (!boundary) {
        if (let Option::SOME(byte) = text.byteAt(index)) {
          boundary = byte == colon;
        }
      }

      if (boundary) {
        let segment: String = text.substring(start as i64, (index - start) as i64);
        let trimmed: String = segment.trimAsciiWhitespace();

        if (trimmed.length() > 0) {
          if (path.length() > 0) {
            path.pushStr("::");
          }

          path.pushStr(trimmed.toStr());
        }

        start = index + 1;
      }

      index += 1;
    }

    return path;
  }

  /// `namespaces[0..depth]` and `name` joined with `::`.
  function joinPath(namespaces: &Vector<String>, depth: u64, name: &String): String {
    let mut path: String = String::create("");
    let mut index: u64 = 0;

    while (index < depth) {
      if (let Option::SOME(segment) = namespaces.get(index)) {
        path.pushStr(segment.toStr());
        path.pushStr("::");
      }

      index += 1;
    }

    path.pushStr(name.toStr());
    return path;
  }

  /// Whether `path` is `written` or ends with `::written`.
  function pathMatches(path: &String, written: &String): boolean {
    if (path.equals(written.toStr())) {
      return true;
    }

    let suffix: String = `::${written.toStr()}`;
    return path.endsWith(suffix.toStr());
  }

  /// The path of the module trait the `@implements` argument `written` names,
  /// read from inside `namespaces`, when a trait of the module has defaults
  /// and answers.
  function resolveTraitPath(
    written: &String,
    namespaces: &Vector<String>,
    entries: &Vector<ParserTraitDefaults::Entry>,
  ): Option<String> {
    let colon: u8 = 58;
    let mut qualified: boolean = false;
    let mut index: u64 = 0;

    while (index < written.length()) {
      if (let Option::SOME(byte) = written.byteAt(index)) {
        if (byte == colon) {
          qualified = true;
        }
      }

      index += 1;
    }

    if (!qualified) {
      let mut depth: u64 = namespaces.length() + 1;

      while (depth > 0) {
        depth -= 1;
        let candidate: String = ParserTraitDefaults::joinPath(namespaces, depth, written);
        let mut entryIndex: u64 = 0;

        while (entryIndex < entries.length()) {
          if (let Option::SOME(entry) = entries.get(entryIndex)) {
            if (entry.traitPath.equals(candidate.toStr())) {
              return Option::SOME(candidate);
            }
          }

          entryIndex += 1;
        }
      }

      // A trait the enclosing namespaces do not reach by this name is an
      // analysis error (A0263) with the path to write. Its defaults are still
      // materialized, so the error is not followed by missing methods.
      let suffix: String = `::${written.toStr()}`;
      let mut fallbackIndex: u64 = 0;

      while (fallbackIndex < entries.length()) {
        if (let Option::SOME(entry) = entries.get(fallbackIndex)) {
          if (entry.traitPath.endsWith(suffix.toStr())) {
            return Option::SOME(entry.traitPath.clone());
          }
        }

        fallbackIndex += 1;
      }

      return Option::NONE;
    }

    let mut entryIndex: u64 = 0;

    while (entryIndex < entries.length()) {
      if (let Option::SOME(entry) = entries.get(entryIndex)) {
        if (ParserTraitDefaults::pathMatches(&entry.traitPath, written)) {
          return Option::SOME(entry.traitPath.clone());
        }
      }

      entryIndex += 1;
    }

    return Option::NONE;
  }

  /// Every trait path written in an `@implements(...)` attribute, in written
  /// order.
  function implementedTraitNames(metadata: &Ast::Metadata): Vector<String> {
    let mut names: Vector<String> = Vector::new<String>();
    let mut index: u64 = 0;

    while (index < metadata.attributes.length()) {
      let Option::SOME(attribute) = metadata.attributes.get(index) else {
        index += 1;
        continue;
      };

      if (!attribute.name.equals("implements")) {
        index += 1;
        continue;
      }

      let mut argumentIndex: u64 = 0;

      while (argumentIndex < attribute.arguments.length()) {
        if (let Option::SOME(argument) = attribute.arguments.get(argumentIndex)) {
          names.push(ParserTraitDefaults::normalizedPath(argument));
        }

        argumentIndex += 1;
      }

      index += 1;
    }

    return names;
  }

  /// The declared name of a method item, when the item is a function.
  function methodItemName(module: &Ast::Module, itemId: Ast::ItemId): Option<String> {
    let Option::SOME(item) = module.items.get(itemId) else {
      return Option::NONE;
    };

    let Ast::Item::Node::Function(method) = item else {
      return Option::NONE;
    };

    return Option::SOME(method.name.clone());
  }

  /// The method in `methods` called `name`, if there is one.
  function findMethod(
    module: &Ast::Module,
    methods: &Vector<Ast::ItemId>,
    name: &String,
  ): Option<Ast::ItemId> {
    let mut index: u64 = 0;

    while (index < methods.length()) {
      if (let Option::SOME(methodId) = methods.get(index)) {
        if (let Option::SOME(methodName) = ParserTraitDefaults::methodItemName(module, *methodId)) {
          if (methodName.equals(name.toStr())) {
            return Option::SOME(*methodId);
          }
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// Whether `methods` already declares a method called `name`.
  function declaresMethod(
    module: &Ast::Module,
    methods: &Vector<Ast::ItemId>,
    name: &String,
  ): boolean {
    let mut index: u64 = 0;

    while (index < methods.length()) {
      let Option::SOME(methodId) = methods.get(index) else {
        index += 1;
        continue;
      };

      if (let Option::SOME(methodName) = ParserTraitDefaults::methodItemName(module, *methodId)) {
        if (methodName.equals(name.toStr())) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// `namespaces` with `entered` appended, or a copy of `namespaces` when the
  /// nested items are not inside a new namespace.
  function innerNamespaces(namespaces: &Vector<String>, entered: &Option<String>): Vector<String> {
    let mut inner: Vector<String> = Vector::new<String>();
    let mut index: u64 = 0;

    while (index < namespaces.length()) {
      if (let Option::SOME(segment) = namespaces.get(index)) {
        inner.push(segment.clone());
      }

      index += 1;
    }

    if (let Option::SOME(name) = entered) {
      inner.push(name.clone());
    }

    return inner;
  }

  /// Collects every trait default in `itemIds`, written inside `namespaces`,
  /// descending through namespaces and exported declarations.
  function collectEntries(
    module: &Ast::Module,
    itemIds: &Vector<Ast::ItemId>,
    namespaces: &Vector<String>,
    entries: &mut Vector<ParserTraitDefaults::Entry>,
  ): void {
    let mut index: u64 = 0;

    while (index < itemIds.length()) {
      let Option::SOME(itemId) = itemIds.get(index) else {
        index += 1;
        continue;
      };

      let mut traitName: Option<String> = Option::NONE;
      let mut defaultMethods: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut signatures: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut nested: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut nestedNamespace: Option<String> = Option::NONE;

      if (let Option::SOME(item) = module.items.get(*itemId)) {
        match (item) {
          Ast::Item::Node::Trait(trait_) -> {
            traitName = Option::SOME(trait_.name.clone());
            defaultMethods = ParserDeclarations::copyItemIds(&trait_.defaultMethods);
            signatures = ParserDeclarations::copyItemIds(&trait_.methods);
          },
          Ast::Item::Node::Namespace(namespaceItem) -> {
            nested = ParserDeclarations::copyItemIds(&namespaceItem.items);
            nestedNamespace = Option::SOME(namespaceItem.name.clone());
          },
          Ast::Item::Node::Export(exportItem) -> {
            if (let Option::SOME(innerItemId) = exportItem.declaration) {
              nested.push(innerItemId);
            }
          },
          _ -> {},
        };
      }

      if (let Option::SOME(name) = traitName) {
        let traitPath: String = ParserTraitDefaults::joinPath(namespaces, namespaces.length(), &name);
        let mut methodIndex: u64 = 0;

        while (methodIndex < defaultMethods.length()) {
          let Option::SOME(methodItemId) = defaultMethods.get(methodIndex) else {
            methodIndex += 1;
            continue;
          };

          if (let Option::SOME(methodName) = ParserTraitDefaults::methodItemName(module, *methodItemId)) {
            let mut entriesRef: &mut Vector<ParserTraitDefaults::Entry> = entries;
            entriesRef.push(ParserTraitDefaults::Entry {
              traitPath: traitPath.clone(),
              methodName: methodName.clone(),
              methodItemId: *methodItemId,
              signatureItemId: ParserTraitDefaults::findMethod(module, &signatures, &methodName),
            });
          }

          methodIndex += 1;
        }
      }

      if (nested.length() > 0) {
        let inner: Vector<String> = ParserTraitDefaults::innerNamespaces(namespaces, &nestedNamespace);
        ParserTraitDefaults::collectEntries(module, &nested, &inner, entries);
      }

      index += 1;
    }
  }

  /// Records the defaults an implementing type, written inside `namespaces`,
  /// inherits but does not declare.
  function collectPendingForType(
    module: &Ast::Module,
    ownerItemId: Ast::ItemId,
    namespaces: &Vector<String>,
    implemented: &Vector<String>,
    methods: &Vector<Ast::ItemId>,
    entries: &Vector<ParserTraitDefaults::Entry>,
    pending: &mut Vector<ParserTraitDefaults::Pending>,
  ): void {
    let mut implementedIndex: u64 = 0;

    while (implementedIndex < implemented.length()) {
      let Option::SOME(written) = implemented.get(implementedIndex) else {
        implementedIndex += 1;
        continue;
      };

      let Option::SOME(traitPath) = ParserTraitDefaults::resolveTraitPath(written, namespaces, entries) else {
        implementedIndex += 1;
        continue;
      };

      let mut entryIndex: u64 = 0;

      while (entryIndex < entries.length()) {
        let Option::SOME(entry) = entries.get(entryIndex) else {
          entryIndex += 1;
          continue;
        };

        if (!entry.traitPath.equals(traitPath.toStr())) {
          entryIndex += 1;
          continue;
        }

        if (!ParserTraitDefaults::declaresMethod(module, methods, &entry.methodName)) {
          let mut pendingRef: &mut Vector<ParserTraitDefaults::Pending> = pending;
          pendingRef.push(ParserTraitDefaults::Pending {
            ownerItemId: ownerItemId,
            traitName: entry.traitPath.clone(),
            methodName: entry.methodName.clone(),
            methodItemId: entry.methodItemId,
          });
        }

        entryIndex += 1;
      }

      implementedIndex += 1;
    }
  }

  /// Walks `itemIds`, written inside `namespaces`, looking for records and
  /// enums that inherit a default.
  function collectPending(
    module: &Ast::Module,
    itemIds: &Vector<Ast::ItemId>,
    namespaces: &Vector<String>,
    entries: &Vector<ParserTraitDefaults::Entry>,
    pending: &mut Vector<ParserTraitDefaults::Pending>,
  ): void {
    let mut index: u64 = 0;

    while (index < itemIds.length()) {
      let Option::SOME(itemId) = itemIds.get(index) else {
        index += 1;
        continue;
      };

      let mut implemented: Vector<String> = Vector::new<String>();
      let mut methods: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut isType: boolean = false;
      let mut nested: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut nestedNamespace: Option<String> = Option::NONE;

      if (let Option::SOME(item) = module.items.get(*itemId)) {
        match (item) {
          Ast::Item::Node::Record(record_) -> {
            isType = true;
            implemented = ParserTraitDefaults::implementedTraitNames(&record_.metadata);
            methods = ParserDeclarations::copyItemIds(&record_.methods);
          },
          Ast::Item::Node::Enum(enum_) -> {
            isType = true;
            implemented = ParserTraitDefaults::implementedTraitNames(&enum_.metadata);
            methods = ParserDeclarations::copyItemIds(&enum_.methods);
          },
          Ast::Item::Node::Namespace(namespaceItem) -> {
            nested = ParserDeclarations::copyItemIds(&namespaceItem.items);
            nestedNamespace = Option::SOME(namespaceItem.name.clone());
          },
          Ast::Item::Node::Export(exportItem) -> {
            if (let Option::SOME(innerItemId) = exportItem.declaration) {
              nested.push(innerItemId);
            }
          },
          _ -> {},
        };
      }

      if (isType && implemented.length() > 0) {
        ParserTraitDefaults::collectPendingForType(
          module,
          *itemId,
          namespaces,
          &implemented,
          &methods,
          entries,
          pending,
        );
      }

      if (nested.length() > 0) {
        let inner: Vector<String> = ParserTraitDefaults::innerNamespaces(namespaces, &nestedNamespace);
        ParserTraitDefaults::collectPending(module, &nested, &inner, entries, pending);
      }

      index += 1;
    }
  }

  /// Copies a literal value, cloning its text.
  function copyLiteralValue(value: &Ast::Expression::LiteralValue): Ast::Expression::LiteralValue {
    return match (value) {
      Ast::Expression::LiteralValue::Int(number) -> Ast::Expression::LiteralValue::Int(number),
      Ast::Expression::LiteralValue::UInt(number) -> Ast::Expression::LiteralValue::UInt(number),
      Ast::Expression::LiteralValue::Float(number) -> Ast::Expression::LiteralValue::Float(number),
      Ast::Expression::LiteralValue::Boolean(flag) -> Ast::Expression::LiteralValue::Boolean(flag),
      Ast::Expression::LiteralValue::Character(character) -> Ast::Expression::LiteralValue::Character(character),
      Ast::Expression::LiteralValue::String(text) -> Ast::Expression::LiteralValue::String(text.clone()),
      Ast::Expression::LiteralValue::Atom(text) -> Ast::Expression::LiteralValue::Atom(text.clone()),
      Ast::Expression::LiteralValue::Null -> Ast::Expression::LiteralValue::Null,
    };
  }

  function copyAsmNames(
    names: &Vector<Ast::Expression::AsmName>
  ): Vector<Ast::Expression::AsmName> {
    let mut copied: Vector<Ast::Expression::AsmName> = Vector::new<Ast::Expression::AsmName>();
    let mut index: u64 = 0;

    while (index < names.length()) {
      if (let Option::SOME(name) = names.get(index)) {
        copied.push(Ast::Expression::AsmName { span: name.span, name: name.name.clone() });
      }

      index += 1;
    }

    return copied;
  }

  function cloneAsmOutputs(
    source: &Ast::Module,
    target: &mut Ast::Module,
    outputs: &Vector<Ast::Expression::AsmOutput>,
  ): Vector<Ast::Expression::AsmOutput> {
    let mut cloned: Vector<Ast::Expression::AsmOutput> = Vector::new<Ast::Expression::AsmOutput>();
    let mut index: u64 = 0;

    while (index < outputs.length()) {
      if (let Option::SOME(output) = outputs.get(index)) {
        cloned.push(Ast::Expression::AsmOutput {
          span: output.span,
          name: output.name.clone(),
          outputType: ParserTraitDefaults::cloneType(source, target, output.outputType),
          location: output.location.clone(),
          locationSpan: output.locationSpan,
        });
      }

      index += 1;
    }

    return cloned;
  }

  function cloneAsmInputs(
    source: &Ast::Module,
    target: &mut Ast::Module,
    inputs: &Vector<Ast::Expression::AsmInput>,
  ): Vector<Ast::Expression::AsmInput> {
    let mut cloned: Vector<Ast::Expression::AsmInput> = Vector::new<Ast::Expression::AsmInput>();
    let mut index: u64 = 0;

    while (index < inputs.length()) {
      if (let Option::SOME(input) = inputs.get(index)) {
        cloned.push(Ast::Expression::AsmInput {
          span: input.span,
          expression: ParserTraitDefaults::cloneExpression(source, target, input.expression),
          mode: input.mode,
          location: input.location.clone(),
          locationSpan: input.locationSpan,
        });
      }

      index += 1;
    }

    return cloned;
  }

  /// Copies an `asm` node, giving its input expressions and output types
  /// fresh ids.
  function cloneAsm(
    source: &Ast::Module,
    target: &mut Ast::Module,
    asmNode: &Ast::Expression::Asm
  ): Ast::Expression::Asm {
    return Ast::Expression::Asm {
      span: asmNode.span,
      isPure: asmNode.isPure,
      inputs: ParserTraitDefaults::cloneAsmInputs(source, target, &asmNode.inputs),
      outputs: ParserTraitDefaults::cloneAsmOutputs(source, target, &asmNode.outputs),
      clobbers: ParserTraitDefaults::copyAsmNames(&asmNode.clobbers),
      chunks: ParserShared::copyStrings(&asmNode.chunks),
      holes: ParserTraitDefaults::copyAsmNames(&asmNode.holes),
      bodySpan: asmNode.bodySpan,
    };
  }

  function cloneTypeList(
    source: &Ast::Module,
    target: &mut Ast::Module,
    typeIds: &Vector<Ast::TypeId>,
  ): Vector<Ast::TypeId> {
    let mut cloned: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
    let mut index: u64 = 0;

    while (index < typeIds.length()) {
      if (let Option::SOME(typeId) = typeIds.get(index)) {
        cloned.push(ParserTraitDefaults::cloneType(source, target, *typeId));
      }

      index += 1;
    }

    return cloned;
  }

  function cloneOptionalType(
    source: &Ast::Module,
    target: &mut Ast::Module,
    typeId: Option<Ast::TypeId>,
  ): Option<Ast::TypeId> {
    let Option::SOME(present) = typeId else {
      return Option::NONE;
    };

    return Option::SOME(ParserTraitDefaults::cloneType(source, target, present));
  }

  /// Copies a type syntax subtree of `source` into `target`.
  function cloneType(
    source: &Ast::Module,
    target: &mut Ast::Module,
    typeId: Ast::TypeId
  ): Ast::TypeId {
    let Option::SOME(node) = source.types.get(typeId) else {
      let mut emptyRef: &mut Ast::Module = target;
      return emptyRef.addType(Ast::Type::Node::Tuple(Ast::Type::Tuple {
        span: SourceSpan::new(noFile(), 0, 0),
        elements: Vector::new<Ast::TypeId>(),
      }));
    };

    let cloned: Ast::Type::Node = match (node) {
      Ast::Type::Node::Path(path) -> Ast::Type::Node::Path(Ast::Type::Path {
        span: path.span,
        segments: ParserShared::copyStrings(&path.segments),
      }),
      Ast::Type::Node::Pointer(pointer) -> Ast::Type::Node::Pointer(Ast::Type::Pointer {
        span: pointer.span,
        mutable: pointer.mutable,
        pointee: ParserTraitDefaults::cloneType(source, target, pointer.pointee),
      }),
      Ast::Type::Node::Reference(reference) -> Ast::Type::Node::Reference(Ast::Type::Reference {
        span: reference.span,
        mutable: reference.mutable,
        target: ParserTraitDefaults::cloneType(source, target, reference.target),
      }),
      Ast::Type::Node::Tuple(tuple) -> Ast::Type::Node::Tuple(Ast::Type::Tuple {
        span: tuple.span,
        elements: ParserTraitDefaults::cloneTypeList(source, target, &tuple.elements),
      }),
      Ast::Type::Node::Function(function_) -> Ast::Type::Node::Function(Ast::Type::Function {
        span: function_.span,
        parameters: ParserTraitDefaults::cloneTypeList(source, target, &function_.parameters),
        returnType: ParserTraitDefaults::cloneType(source, target, function_.returnType),
        pointer: function_.pointer,
      }),
      Ast::Type::Node::Slice(slice) -> Ast::Type::Node::Slice(Ast::Type::Slice {
        span: slice.span,
        element: ParserTraitDefaults::cloneType(source, target, slice.element),
      }),
      Ast::Type::Node::FixedArray(array) -> Ast::Type::Node::FixedArray(Ast::Type::FixedArray {
        span: array.span,
        element: ParserTraitDefaults::cloneType(source, target, array.element),
        size: array.size,
      }),
      Ast::Type::Node::Generic(generic) -> Ast::Type::Node::Generic(Ast::Type::Generic {
        span: generic.span,
        base: ParserTraitDefaults::cloneType(source, target, generic.base),
        arguments: ParserTraitDefaults::cloneTypeList(source, target, &generic.arguments),
      }),
    };

    let mut targetRef: &mut Ast::Module = target;
    return targetRef.addType(cloned);
  }

  function cloneExpressionList(
    source: &Ast::Module,
    target: &mut Ast::Module,
    expressionIds: &Vector<Ast::ExpressionId>,
  ): Vector<Ast::ExpressionId> {
    let mut cloned: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
    let mut index: u64 = 0;

    while (index < expressionIds.length()) {
      if (let Option::SOME(expressionId) = expressionIds.get(index)) {
        cloned.push(ParserTraitDefaults::cloneExpression(source, target, *expressionId));
      }

      index += 1;
    }

    return cloned;
  }

  function cloneOptionalExpression(
    source: &Ast::Module,
    target: &mut Ast::Module,
    expressionId: Option<Ast::ExpressionId>,
  ): Option<Ast::ExpressionId> {
    let Option::SOME(present) = expressionId else {
      return Option::NONE;
    };

    return Option::SOME(ParserTraitDefaults::cloneExpression(source, target, present));
  }

  function cloneStatementList(
    source: &Ast::Module,
    target: &mut Ast::Module,
    statementIds: &Vector<Ast::StatementId>,
  ): Vector<Ast::StatementId> {
    let mut cloned: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
    let mut index: u64 = 0;

    while (index < statementIds.length()) {
      if (let Option::SOME(statementId) = statementIds.get(index)) {
        cloned.push(ParserTraitDefaults::cloneStatement(source, target, *statementId));
      }

      index += 1;
    }

    return cloned;
  }

  function cloneOptionalStatement(
    source: &Ast::Module,
    target: &mut Ast::Module,
    statementId: Option<Ast::StatementId>,
  ): Option<Ast::StatementId> {
    let Option::SOME(present) = statementId else {
      return Option::NONE;
    };

    return Option::SOME(ParserTraitDefaults::cloneStatement(source, target, present));
  }

  function clonePatternList(
    source: &Ast::Module,
    target: &mut Ast::Module,
    patternIds: &Vector<Ast::PatternId>,
  ): Vector<Ast::PatternId> {
    let mut cloned: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
    let mut index: u64 = 0;

    while (index < patternIds.length()) {
      if (let Option::SOME(patternId) = patternIds.get(index)) {
        cloned.push(ParserTraitDefaults::clonePattern(source, target, *patternId));
      }

      index += 1;
    }

    return cloned;
  }

  /// Copies a pattern subtree of `source` into `target`, type annotations
  /// included.
  function clonePattern(
    source: &Ast::Module,
    target: &mut Ast::Module,
    patternId: Ast::PatternId
  ): Ast::PatternId {
    let Option::SOME(pattern) = source.patterns.get(patternId) else {
      let mut emptyRef: &mut Ast::Module = target;
      return emptyRef.addPattern(Ast::Pattern::Node::Wildcard(Ast::Pattern::Wildcard {
        span: SourceSpan::new(noFile(), 0, 0),
      }));
    };

    let cloned: Ast::Pattern::Node = match (pattern) {
      Ast::Pattern::Node::Wildcard(wildcard) -> Ast::Pattern::Node::Wildcard(Ast::Pattern::Wildcard {
        span: wildcard.span,
      }),
      Ast::Pattern::Node::Binding(binding) -> Ast::Pattern::Node::Binding(Ast::Pattern::Binding {
        span: binding.span,
        name: binding.name.clone(),
        annotation: ParserTraitDefaults::cloneOptionalType(source, target, binding.annotation),
        initializer: ParserTraitDefaults::cloneOptionalExpression(source, target, binding.initializer),
        metadata: Ast::copyMetadata(&binding.metadata),
      }),
      Ast::Pattern::Node::Literal(literal) -> Ast::Pattern::Node::Literal(Ast::Pattern::Literal {
        span: literal.span,
        expression: ParserTraitDefaults::cloneExpression(source, target, literal.expression),
      }),
      Ast::Pattern::Node::Path(path) -> Ast::Pattern::Node::Path(Ast::Pattern::Path {
        span: path.span,
        segments: ParserShared::copyStrings(&path.segments),
        arguments: ParserTraitDefaults::clonePatternList(source, target, &path.arguments),
      }),
      Ast::Pattern::Node::Tuple(tuple) -> Ast::Pattern::Node::Tuple(Ast::Pattern::Tuple {
        span: tuple.span,
        elements: ParserTraitDefaults::clonePatternList(source, target, &tuple.elements),
      }),
      Ast::Pattern::Node::Or(orPattern) -> Ast::Pattern::Node::Or(Ast::Pattern::Or {
        span: orPattern.span,
        alternatives: ParserTraitDefaults::clonePatternList(source, target, &orPattern.alternatives),
      }),
    };

    let mut targetRef: &mut Ast::Module = target;
    return targetRef.addPattern(cloned);
  }

  function cloneMatchArms(
    source: &Ast::Module,
    target: &mut Ast::Module,
    arms: &Vector<Ast::Expression::MatchArm>,
  ): Vector<Ast::Expression::MatchArm> {
    let mut cloned: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
    let mut index: u64 = 0;

    while (index < arms.length()) {
      if (let Option::SOME(arm) = arms.get(index)) {
        cloned.push(Ast::Expression::MatchArm {
          pattern: ParserTraitDefaults::clonePattern(source, target, arm.pattern),
          guard: ParserTraitDefaults::cloneOptionalExpression(source, target, arm.guard),
          body: ParserTraitDefaults::cloneExpression(source, target, arm.body),
        });
      }

      index += 1;
    }

    return cloned;
  }

  function cloneRecordInitFields(
    source: &Ast::Module,
    target: &mut Ast::Module,
    fields: &Vector<Ast::Expression::RecordInitField>,
  ): Vector<Ast::Expression::RecordInitField> {
    let mut cloned: Vector<Ast::Expression::RecordInitField> = Vector::new<Ast::Expression::RecordInitField>();
    let mut index: u64 = 0;

    while (index < fields.length()) {
      if (let Option::SOME(field) = fields.get(index)) {
        cloned.push(Ast::Expression::RecordInitField {
          name: field.name.clone(),
          value: ParserTraitDefaults::cloneExpression(source, target, field.value),
        });
      }

      index += 1;
    }

    return cloned;
  }

  /// Copies one expression node of `source` with every child copied into
  /// `target`.
  function rebuildExpression(
    source: &Ast::Module,
    target: &mut Ast::Module,
    expression: &Ast::Expression::Node,
  ): Ast::Expression::Node {
    return match (expression) {
      Ast::Expression::Node::Assignment(node) -> Ast::Expression::Node::Assignment(Ast::Expression::Assignment {
        span: node.span,
        target: ParserTraitDefaults::cloneExpression(source, target, node.target),
        value: ParserTraitDefaults::cloneExpression(source, target, node.value),
        operator: node.operator,
      }),
      Ast::Expression::Node::Ternary(node) -> Ast::Expression::Node::Ternary(Ast::Expression::Ternary {
        span: node.span,
        condition: ParserTraitDefaults::cloneExpression(source, target, node.condition),
        thenBranch: ParserTraitDefaults::cloneExpression(source, target, node.thenBranch),
        elseBranch: ParserTraitDefaults::cloneExpression(source, target, node.elseBranch),
      }),
      Ast::Expression::Node::Cast(node) -> Ast::Expression::Node::Cast(Ast::Expression::Cast {
        span: node.span,
        expression: ParserTraitDefaults::cloneExpression(source, target, node.expression),
        targetType: ParserTraitDefaults::cloneType(source, target, node.targetType),
      }),
      Ast::Expression::Node::Literal(node) -> Ast::Expression::Node::Literal(Ast::Expression::Literal {
        span: node.span,
        value: ParserTraitDefaults::copyLiteralValue(&node.value),
      }),
      Ast::Expression::Node::Path(node) -> Ast::Expression::Node::Path(Ast::Expression::Path {
        span: node.span,
        segments: ParserShared::copyStrings(&node.segments),
      }),
      Ast::Expression::Node::Call(node) -> Ast::Expression::Node::Call(Ast::Expression::Call {
        span: node.span,
        callee: ParserTraitDefaults::cloneExpression(source, target, node.callee),
        typeArguments: ParserTraitDefaults::cloneTypeList(source, target, &node.typeArguments),
        arguments: ParserTraitDefaults::cloneExpressionList(source, target, &node.arguments),
      }),
      Ast::Expression::Node::Binary(node) -> Ast::Expression::Node::Binary(Ast::Expression::Binary {
        span: node.span,
        operator: node.operator,
        left: ParserTraitDefaults::cloneExpression(source, target, node.left),
        right: ParserTraitDefaults::cloneExpression(source, target, node.right),
      }),
      Ast::Expression::Node::Dereference(node) -> Ast::Expression::Node::Dereference(Ast::Expression::Dereference {
        span: node.span,
        operand: ParserTraitDefaults::cloneExpression(source, target, node.operand),
      }),
      Ast::Expression::Node::Grouped(node) -> Ast::Expression::Node::Grouped(Ast::Expression::Grouped {
        span: node.span,
        expression: ParserTraitDefaults::cloneExpression(source, target, node.expression),
      }),
      Ast::Expression::Node::Tuple(node) -> Ast::Expression::Node::Tuple(Ast::Expression::Tuple {
        span: node.span,
        elements: ParserTraitDefaults::cloneExpressionList(source, target, &node.elements),
      }),
      Ast::Expression::Node::Unit(node) -> Ast::Expression::Node::Unit(Ast::Expression::Unit { span: node.span }),
      Ast::Expression::Node::LetCondition(node) -> Ast::Expression::Node::LetCondition(Ast::Expression::LetCondition {
        span: node.span,
        pattern: ParserTraitDefaults::clonePattern(source, target, node.pattern),
        value: ParserTraitDefaults::cloneExpression(source, target, node.value),
      }),
      Ast::Expression::Node::Reference(node) -> Ast::Expression::Node::Reference(Ast::Expression::Reference {
        span: node.span,
        mutable: node.mutable,
        target: ParserTraitDefaults::cloneExpression(source, target, node.target),
      }),
      Ast::Expression::Node::Unary(node) -> Ast::Expression::Node::Unary(Ast::Expression::Unary {
        span: node.span,
        operator: node.operator,
        operand: ParserTraitDefaults::cloneExpression(source, target, node.operand),
      }),
      Ast::Expression::Node::Block(node) -> Ast::Expression::Node::Block(Ast::Expression::Block {
        span: node.span,
        statements: ParserTraitDefaults::cloneStatementList(source, target, &node.statements),
        tail: ParserTraitDefaults::cloneOptionalExpression(source, target, node.tail),
      }),
      Ast::Expression::Node::If(node) -> Ast::Expression::Node::If(Ast::Expression::If {
        span: node.span,
        condition: ParserTraitDefaults::cloneExpression(source, target, node.condition),
        thenBranch: ParserTraitDefaults::cloneStatement(source, target, node.thenBranch),
        elseBranch: ParserTraitDefaults::cloneOptionalStatement(source, target, node.elseBranch),
      }),
      Ast::Expression::Node::Match(node) -> Ast::Expression::Node::Match(Ast::Expression::Match {
        span: node.span,
        scrutinee: ParserTraitDefaults::cloneExpression(source, target, node.scrutinee),
        arms: ParserTraitDefaults::cloneMatchArms(source, target, &node.arms),
      }),
      Ast::Expression::Node::Variable(node) -> Ast::Expression::Node::Variable(Ast::Expression::Variable {
        span: node.span,
        name: node.name.clone(),
      }),
      Ast::Expression::Node::Vector(node) -> Ast::Expression::Node::Vector(Ast::Expression::VectorLiteral {
        span: node.span,
        elements: ParserTraitDefaults::cloneExpressionList(source, target, &node.elements),
      }),
      Ast::Expression::Node::VectorAccess(node) -> Ast::Expression::Node::VectorAccess(Ast::Expression::VectorAccess {
        span: node.span,
        vector: ParserTraitDefaults::cloneExpression(source, target, node.vector),
        index: ParserTraitDefaults::cloneExpression(source, target, node.index),
      }),
      Ast::Expression::Node::PostfixIncrement(node) -> Ast::Expression::Node::PostfixIncrement(Ast::Expression::PostfixIncrement {
        span: node.span,
        operand: ParserTraitDefaults::cloneExpression(source, target, node.operand),
      }),
      Ast::Expression::Node::PostfixDecrement(node) -> Ast::Expression::Node::PostfixDecrement(Ast::Expression::PostfixDecrement {
        span: node.span,
        operand: ParserTraitDefaults::cloneExpression(source, target, node.operand),
      }),
      Ast::Expression::Node::MemberAccess(node) -> Ast::Expression::Node::MemberAccess(Ast::Expression::MemberAccess {
        span: node.span,
        object: ParserTraitDefaults::cloneExpression(source, target, node.object),
        operator: node.operator,
        member: node.member.clone(),
      }),
      Ast::Expression::Node::RecordInit(node) -> Ast::Expression::Node::RecordInit(Ast::Expression::RecordInit {
        span: node.span,
        path: ParserTraitDefaults::cloneExpression(source, target, node.path),
        typeArguments: ParserTraitDefaults::cloneTypeList(source, target, &node.typeArguments),
        fields: ParserTraitDefaults::cloneRecordInitFields(source, target, &node.fields),
      }),
      Ast::Expression::Node::BuiltinCall(node) -> Ast::Expression::Node::BuiltinCall(Ast::Expression::BuiltinCall {
        span: node.span,
        name: node.name.clone(),
        typeArguments: ParserTraitDefaults::cloneTypeList(source, target, &node.typeArguments),
        arguments: ParserTraitDefaults::cloneExpressionList(source, target, &node.arguments),
      }),
      Ast::Expression::Node::Lambda(node) -> Ast::Expression::Node::Lambda(Ast::Expression::Lambda {
        span: node.span,
        parameters: ParserTraitDefaults::clonePatternList(source, target, &node.parameters),
        returnType: ParserTraitDefaults::cloneOptionalType(source, target, node.returnType),
        body: ParserTraitDefaults::cloneStatement(source, target, node.body),
      }),
      Ast::Expression::Node::CaptureOverride(node) -> Ast::Expression::Node::CaptureOverride(Ast::Expression::CaptureOverride {
        span: node.span,
        kind: node.kind,
        expression: ParserTraitDefaults::cloneExpression(source, target, node.expression),
      }),
      Ast::Expression::Node::Pipe(node) -> Ast::Expression::Node::Pipe(Ast::Expression::Pipe {
        span: node.span,
        left: ParserTraitDefaults::cloneExpression(source, target, node.left),
        right: ParserTraitDefaults::cloneExpression(source, target, node.right),
      }),
      Ast::Expression::Node::PipePlaceholder(node) -> Ast::Expression::Node::PipePlaceholder(Ast::Expression::PipePlaceholder {
        span: node.span,
      }),
      Ast::Expression::Node::Try(node) -> Ast::Expression::Node::Try(Ast::Expression::Try {
        span: node.span,
        expression: ParserTraitDefaults::cloneExpression(source, target, node.expression),
      }),
      Ast::Expression::Node::Range(node) -> Ast::Expression::Node::Range(Ast::Expression::Range {
        span: node.span,
        start: ParserTraitDefaults::cloneOptionalExpression(source, target, node.start),
        end: ParserTraitDefaults::cloneOptionalExpression(source, target, node.end),
        inclusive: node.inclusive,
      }),
      Ast::Expression::Node::Asm(node) -> Ast::Expression::Node::Asm(ParserTraitDefaults::cloneAsm(source, target, &node)),
    };
  }

  /// Copies an expression subtree of `source` into `target`.
  function cloneExpression(
    source: &Ast::Module,
    target: &mut Ast::Module,
    expressionId: Ast::ExpressionId
  ): Ast::ExpressionId {
    let Option::SOME(expression) = source.expressions.get(expressionId) else {
      let mut emptyRef: &mut Ast::Module = target;
      return emptyRef.addExpression(Ast::Expression::Node::Unit(Ast::Expression::Unit {
        span: SourceSpan::new(noFile(), 0, 0),
      }));
    };

    let cloned: Ast::Expression::Node = ParserTraitDefaults::rebuildExpression(source, target, expression);
    let mut targetRef: &mut Ast::Module = target;
    return targetRef.addExpression(cloned);
  }

  /// Copies one statement node of `source` with every child copied into
  /// `target`. A nested item declaration keeps its id: the parser rejects one
  /// inside a method body, so a copied body never holds one.
  function rebuildStatement(
    source: &Ast::Module,
    target: &mut Ast::Module,
    statement: &Ast::Statement::Node,
  ): Ast::Statement::Node {
    return match (statement) {
      Ast::Statement::Node::Variable(node) -> Ast::Statement::Node::Variable(Ast::Statement::Variable {
        span: node.span,
        mutable: node.mutable,
        pattern: ParserTraitDefaults::clonePattern(source, target, node.pattern),
        annotation: ParserTraitDefaults::cloneOptionalType(source, target, node.annotation),
        value: ParserTraitDefaults::cloneOptionalExpression(source, target, node.value),
      }),
      Ast::Statement::Node::Let(node) -> Ast::Statement::Node::Let(Ast::Statement::Let {
        span: node.span,
        pattern: ParserTraitDefaults::clonePattern(source, target, node.pattern),
        annotation: ParserTraitDefaults::cloneOptionalType(source, target, node.annotation),
        value: ParserTraitDefaults::cloneOptionalExpression(source, target, node.value),
      }),
      Ast::Statement::Node::LetElse(node) -> Ast::Statement::Node::LetElse(Ast::Statement::LetElse {
        span: node.span,
        mutable: node.mutable,
        pattern: ParserTraitDefaults::clonePattern(source, target, node.pattern),
        annotation: ParserTraitDefaults::cloneOptionalType(source, target, node.annotation),
        value: ParserTraitDefaults::cloneExpression(source, target, node.value),
        elseBranch: ParserTraitDefaults::cloneStatement(source, target, node.elseBranch),
      }),
      Ast::Statement::Node::Expression(node) -> Ast::Statement::Node::Expression(Ast::Statement::Expression {
        span: node.span,
        expression: ParserTraitDefaults::cloneExpression(source, target, node.expression),
      }),
      Ast::Statement::Node::Block(node) -> Ast::Statement::Node::Block(Ast::Statement::Block {
        span: node.span,
        statements: ParserTraitDefaults::cloneStatementList(source, target, &node.statements),
        tail: ParserTraitDefaults::cloneOptionalExpression(source, target, node.tail),
      }),
      Ast::Statement::Node::If(node) -> Ast::Statement::Node::If(Ast::Statement::If {
        span: node.span,
        condition: ParserTraitDefaults::cloneExpression(source, target, node.condition),
        thenBranch: ParserTraitDefaults::cloneStatement(source, target, node.thenBranch),
        elseBranch: ParserTraitDefaults::cloneOptionalStatement(source, target, node.elseBranch),
      }),
      Ast::Statement::Node::While(node) -> Ast::Statement::Node::While(Ast::Statement::While {
        span: node.span,
        condition: ParserTraitDefaults::cloneExpression(source, target, node.condition),
        body: ParserTraitDefaults::cloneStatement(source, target, node.body),
      }),
      Ast::Statement::Node::For(node) -> Ast::Statement::Node::For(Ast::Statement::For {
        span: node.span,
        initializer: ParserTraitDefaults::cloneOptionalStatement(source, target, node.initializer),
        condition: ParserTraitDefaults::cloneOptionalExpression(source, target, node.condition),
        update: ParserTraitDefaults::cloneOptionalExpression(source, target, node.update),
        body: ParserTraitDefaults::cloneStatement(source, target, node.body),
      }),
      Ast::Statement::Node::ForOf(node) -> Ast::Statement::Node::ForOf(Ast::Statement::ForOf {
        span: node.span,
        pattern: ParserTraitDefaults::clonePattern(source, target, node.pattern),
        iterable: ParserTraitDefaults::cloneExpression(source, target, node.iterable),
        body: ParserTraitDefaults::cloneStatement(source, target, node.body),
      }),
      Ast::Statement::Node::Return(node) -> Ast::Statement::Node::Return(Ast::Statement::Return {
        span: node.span,
        value: ParserTraitDefaults::cloneOptionalExpression(source, target, node.value),
      }),
      Ast::Statement::Node::Break(node) -> Ast::Statement::Node::Break(Ast::Statement::Break {
        span: node.span,
        value: ParserTraitDefaults::cloneOptionalExpression(source, target, node.value),
      }),
      Ast::Statement::Node::Continue(node) -> Ast::Statement::Node::Continue(Ast::Statement::Continue {
        span: node.span,
      }),
      Ast::Statement::Node::Defer(node) -> Ast::Statement::Node::Defer(Ast::Statement::Defer {
        span: node.span,
        statement: ParserTraitDefaults::cloneStatement(source, target, node.statement),
      }),
      Ast::Statement::Node::Item(node) -> Ast::Statement::Node::Item(Ast::Statement::Item {
        span: node.span,
        item: node.item,
      }),
      Ast::Statement::Node::Comment(node) -> Ast::Statement::Node::Comment(Ast::Statement::Comment {
        span: node.span,
        text: node.text.clone(),
      }),
      Ast::Statement::Node::Asm(node) -> Ast::Statement::Node::Asm(ParserTraitDefaults::cloneAsm(source, target, &node)),
    };
  }

  /// Copies a statement subtree of `source` into `target`.
  function cloneStatement(
    source: &Ast::Module,
    target: &mut Ast::Module,
    statementId: Ast::StatementId
  ): Ast::StatementId {
    let Option::SOME(statement) = source.statements.get(statementId) else {
      let mut emptyRef: &mut Ast::Module = target;
      return emptyRef.addStatement(Ast::Statement::Node::Block(Ast::Statement::Block {
        span: SourceSpan::new(noFile(), 0, 0),
        statements: Vector::new<Ast::StatementId>(),
        tail: Option::NONE,
      }));
    };

    let cloned: Ast::Statement::Node = ParserTraitDefaults::rebuildStatement(source, target, statement);
    let mut targetRef: &mut Ast::Module = target;
    return targetRef.addStatement(cloned);
  }

  /// Copies a trait default method item of `source`, its signature and its
  /// whole body, into `target`.
  function cloneMethodItem(
    source: &Ast::Module,
    target: &mut Ast::Module,
    methodItemId: Ast::ItemId,
  ): Option<Ast::ItemId> {
    let Option::SOME(item) = source.items.get(methodItemId) else {
      return Option::NONE;
    };
    let Ast::Item::Node::Function(method) = item else {
      return Option::NONE;
    };

    let clonedParameters: Vector<Ast::PatternId> = ParserTraitDefaults::clonePatternList(source, target, &method.parameters);
    let clonedReturnType: Option<Ast::TypeId> = ParserTraitDefaults::cloneOptionalType(source, target, method.returnType);
    let clonedBody: Ast::StatementId = ParserTraitDefaults::cloneStatement(source, target, method.body);
    let mut targetRef: &mut Ast::Module = target;

    return Option::SOME(targetRef.addItem(Ast::Item::Node::Function(Ast::Item::Function {
      span: method.span,
      name: method.name.clone(),
      genericParameters: Ast::copyGenericParams(&method.genericParameters),
      parameters: clonedParameters,
      returnType: clonedReturnType,
      body: clonedBody,
      metadata: Ast::copyMetadata(&method.metadata),
    })));
  }

  /// Copies a default method item of `module` back into `module` under fresh
  /// ids. The copy goes through a scratch module, since one module cannot be
  /// read and appended to at once.
  function cloneMethodItemInPlace(
    module: &mut Ast::Module,
    methodItemId: Ast::ItemId
  ): Option<Ast::ItemId> {
    let mut scratch: Ast::Module = Ast::Module::init();
    let Option::SOME(scratchItemId) = ParserTraitDefaults::cloneMethodItem(&*module, &mut scratch, methodItemId) else {
      return Option::NONE;
    };

    return ParserTraitDefaults::cloneMethodItem(&scratch, module, scratchItemId);
  }

  /// The declared name of a record or enum item.
  function typeItemName(module: &Ast::Module, itemId: Ast::ItemId): String {
    return match (module.items.get(itemId)) {
      Option::SOME(Ast::Item::Node::Record(record_)) -> record_.name.clone(),
      Option::SOME(Ast::Item::Node::Enum(enum_)) -> enum_.name.clone(),
      _ -> String::create(""),
    };
  }

  /// Moves a default's body onto the body-less twin the trait lists among its
  /// methods, so the analyzer checks the default once against the trait.
  /// Every implementing type inherits a fresh copy, so the trait's own
  /// declaration is the only owner of these node ids.
  function giveSignatureTheDefaultBody(
    module: &mut Ast::Module,
    signatureItemId: Ast::ItemId,
    defaultItemId: Ast::ItemId,
  ): void {
    let mut body: Option<Ast::StatementId> = Option::NONE;

    if (let Option::SOME(Ast::Item::Node::Function(method)) = module.items.get(defaultItemId)) {
      body = Option::SOME(method.body);
    }

    let Option::SOME(defaultBody) = body else {
      return;
    };

    let Option::SOME(item) = module.items.getMut(signatureItemId) else {
      return;
    };

    if (let Ast::Item::Node::Function(signature) = item) {
      *item = Ast::Item::Node::Function(Ast::Item::Function {
        span: signature.span,
        name: signature.name.clone(),
        genericParameters: Ast::copyGenericParams(&signature.genericParameters),
        parameters: ParserDeclarations::copyPatternIds(&signature.parameters),
        returnType: signature.returnType,
        body: defaultBody,
        metadata: Ast::copyMetadata(&signature.metadata),
      });
    }
  }

  /// Appends a materialized method to the type that inherits it.
  function attachMethod(
    module: &mut Ast::Module,
    ownerItemId: Ast::ItemId,
    methodItemId: Ast::ItemId,
  ): void {
    let Option::SOME(item) = module.items.getMut(ownerItemId) else {
      return;
    };

    match (item) {
      Ast::Item::Node::Record(record_) -> {
        let mut methods: Vector<Ast::ItemId> = ParserDeclarations::copyItemIds(&record_.methods);
        methods.push(methodItemId);

        *item = Ast::Item::Node::Record(Ast::Item::Record {
          span: record_.span,
          name: record_.name.clone(),
          genericParameters: Ast::copyGenericParams(&record_.genericParameters),
          fields: ParserDeclarations::copyPatternIds(&record_.fields),
          methods: methods,
          metadata: Ast::copyMetadata(&record_.metadata),
        });
      },
      Ast::Item::Node::Enum(enum_) -> {
        let mut methods: Vector<Ast::ItemId> = ParserDeclarations::copyItemIds(&enum_.methods);
        methods.push(methodItemId);

        *item = Ast::Item::Node::Enum(Ast::Item::Enum {
          span: enum_.span,
          name: enum_.name.clone(),
          genericParameters: Ast::copyGenericParams(&enum_.genericParameters),
          variants: ParserDeclarations::copyPatternIds(&enum_.variants),
          methods: methods,
          metadata: Ast::copyMetadata(&enum_.metadata),
        });
      },
      _ -> {},
    };
  }

  /// The namespaces of a trait path, every segment but the last.
  function namespacesOf(traitPath: &String): Vector<String> {
    let colon: u8 = 58;
    let mut namespaces: Vector<String> = Vector::new<String>();
    let mut start: u64 = 0;
    let mut index: u64 = 0;

    while (index + 1 < traitPath.length()) {
      let mut separator: boolean = false;

      if (let Option::SOME(first) = traitPath.byteAt(index)) {
        if (let Option::SOME(second) = traitPath.byteAt(index + 1)) {
          separator = first == colon && second == colon;
        }
      }

      if (separator) {
        namespaces.push(traitPath.substring(start as i64, (index - start) as i64));
        start = index + 2;
        index += 2;
        continue;
      }

      index += 1;
    }

    return namespaces;
  }

  /// Materializes every inherited trait default in the parsed module.
  function materialize(module: &mut Ast::Module): void {
    let roots: Vector<Ast::ItemId> = ParserDeclarations::copyItemIds(&module.roots);
    let mut entries: Vector<ParserTraitDefaults::Entry> = Vector::new<ParserTraitDefaults::Entry>();

    let topLevel: Vector<String> = Vector::new<String>();
    ParserTraitDefaults::collectEntries(&*module, &roots, &topLevel, &mut entries);

    if (entries.length() == 0) {
      return;
    }

    let mut entryIndex: u64 = 0;

    while (entryIndex < entries.length()) {
      if (let Option::SOME(entry) = entries.get(entryIndex)) {
        if (let Option::SOME(signatureItemId) = entry.signatureItemId) {
          ParserTraitDefaults::giveSignatureTheDefaultBody(module, signatureItemId, entry.methodItemId);
        }
      }

      entryIndex += 1;
    }

    let mut pending: Vector<ParserTraitDefaults::Pending> = Vector::new<ParserTraitDefaults::Pending>();
    ParserTraitDefaults::collectPending(&*module, &roots, &topLevel, &entries, &mut pending);

    let mut index: u64 = 0;

    while (index < pending.length()) {
      let Option::SOME(entry) = pending.get(index) else {
        index += 1;
        continue;
      };

      let ownerItemId: Ast::ItemId = entry.ownerItemId;
      let methodItemId: Ast::ItemId = entry.methodItemId;
      if (let Option::SOME(clonedId) = ParserTraitDefaults::cloneMethodItemInPlace(module, methodItemId)) {
        ParserTraitDefaults::attachMethod(module, ownerItemId, clonedId);
        let typeName: String = ParserTraitDefaults::typeItemName(&*module, ownerItemId);
        let mut moduleRef: &mut Ast::Module = module;
        moduleRef.setInheritedMethod(clonedId, Ast::InheritedMethod {
          traitName: entry.traitName.clone(),
          typeName: typeName,
          methodName: entry.methodName.clone(),
          sourceModule: Option::NONE,
          traitNamespaces: ParserTraitDefaults::namespacesOf(&entry.traitName),
        });
      }

      index += 1;
    }
  }
}
