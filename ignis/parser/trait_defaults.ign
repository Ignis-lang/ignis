import Ast from "@compiler::ast";
import SourceSpan from "@compiler::diagnostics";
import Vector from "std::vector";

import _ from "./declarations";

/// Copies every trait default method body onto the types that declare the
/// trait with `@implements` and do not declare the method themselves.
///
/// The pass runs once the module is fully parsed, so an implementing type can
/// appear before the trait it implements. The copy is a real method item on
/// the type, which is what lets binding, resolution, typechecking and lowering
/// treat an inherited default exactly like a hand-written method.
///
/// Only the method item is copied. Its body statement is shared with the trait
/// declaration, mirroring the host, so two types inheriting the same body
/// resolve that body's names once. A body that reads `self` therefore belongs
/// to a single implementing type.
///
/// The parser cannot resolve names, but only a trait declared in this module
/// has a body it can copy, so each `@implements` path is read against the
/// traits of the module the way the resolver reads it: a bare name through the
/// namespaces the type is written in, innermost first, out to the top level; a
/// qualified path as the declaration whose path is it or ends with it.
/// Two traits sharing a name in different namespaces therefore hand their
/// defaults only to the types that implement each of them. A path that matches
/// no trait of the module copies nothing, and the analyzer reports it.
export namespace ParserTraitDefaults {
  /// One default method a trait declares with a body.
  record Entry {
    /// The trait's path inside the module, such as `Shapes::Measured`.
    public traitPath: String;
    public methodName: String;
    public methodItemId: Ast::ItemId;
  }

  /// A default method that still has to be copied onto an implementing type.
  record Pending {
    public ownerItemId: Ast::ItemId;
    public methodItemId: Ast::ItemId;
  }

  /// The trimmed `::`-separated segments of an `@implements` argument,
  /// joined back with `::`, so `Ns :: Trait` reads as `Ns::Trait`.
  function normalizedPath(text: &String): String {
    let colon: u8 = 58;
    let mut path: String = String::create("");
    let mut start: u64 = 0;
    let mut index: u64 = 0;

    while (index <= text.length()) {
      let mut boundary: boolean = index == text.length();

      if (!boundary) {
        if (let Option::SOME(byte) = text.byteAt(index)) {
          boundary = byte == colon;
        }
      }

      if (boundary) {
        let segment: String = text.substring(start as i64, (index - start) as i64);
        let trimmed: String = segment.trimAsciiWhitespace();

        if (trimmed.length() > 0) {
          if (path.length() > 0) {
            path.pushStr("::");
          }

          path.pushStr(trimmed.toStr());
        }

        start = index + 1;
      }

      index += 1;
    }

    return path;
  }

  /// `namespaces[0..depth]` and `name` joined with `::`.
  function joinPath(namespaces: &Vector<String>, depth: u64, name: &String): String {
    let mut path: String = String::create("");
    let mut index: u64 = 0;

    while (index < depth) {
      if (let Option::SOME(segment) = namespaces.get(index)) {
        path.pushStr(segment.toStr());
        path.pushStr("::");
      }

      index += 1;
    }

    path.pushStr(name.toStr());
    return path;
  }

  /// Whether `path` is `written` or ends with `::written`.
  function pathMatches(path: &String, written: &String): boolean {
    if (path.equals(written.toStr())) {
      return true;
    }

    let suffix: String = `::${written.toStr()}`;
    return path.endsWith(suffix.toStr());
  }

  /// The path of the module trait the `@implements` argument `written` names,
  /// read from inside `namespaces`, when a trait of the module has defaults
  /// and answers.
  function resolveTraitPath(
    written: &String,
    namespaces: &Vector<String>,
    entries: &Vector<ParserTraitDefaults::Entry>,
  ): Option<String> {
    let colon: u8 = 58;
    let mut qualified: boolean = false;
    let mut index: u64 = 0;

    while (index < written.length()) {
      if (let Option::SOME(byte) = written.byteAt(index)) {
        if (byte == colon) {
          qualified = true;
        }
      }

      index += 1;
    }

    if (!qualified) {
      let mut depth: u64 = namespaces.length() + 1;

      while (depth > 0) {
        depth -= 1;
        let candidate: String = ParserTraitDefaults::joinPath(namespaces, depth, written);
        let mut entryIndex: u64 = 0;

        while (entryIndex < entries.length()) {
          if (let Option::SOME(entry) = entries.get(entryIndex)) {
            if (entry.traitPath.equals(candidate.toStr())) {
              return Option::SOME(candidate);
            }
          }

          entryIndex += 1;
        }
      }

      // A trait the enclosing namespaces do not reach by this name is an
      // analysis error (A0263) with the path to write. Its defaults are still
      // materialized, so the error is not followed by missing methods.
      let suffix: String = `::${written.toStr()}`;
      let mut fallbackIndex: u64 = 0;

      while (fallbackIndex < entries.length()) {
        if (let Option::SOME(entry) = entries.get(fallbackIndex)) {
          if (entry.traitPath.endsWith(suffix.toStr())) {
            return Option::SOME(entry.traitPath.clone());
          }
        }

        fallbackIndex += 1;
      }

      return Option::NONE;
    }

    let mut entryIndex: u64 = 0;

    while (entryIndex < entries.length()) {
      if (let Option::SOME(entry) = entries.get(entryIndex)) {
        if (ParserTraitDefaults::pathMatches(&entry.traitPath, written)) {
          return Option::SOME(entry.traitPath.clone());
        }
      }

      entryIndex += 1;
    }

    return Option::NONE;
  }

  /// Every trait path written in an `@implements(...)` attribute, in written
  /// order.
  function implementedTraitNames(metadata: &Ast::Metadata): Vector<String> {
    let mut names: Vector<String> = Vector::new<String>();
    let mut index: u64 = 0;

    while (index < metadata.attributes.length()) {
      let Option::SOME(attribute) = metadata.attributes.get(index) else {
        index += 1;
        continue;
      };

      if (!attribute.name.equals("implements")) {
        index += 1;
        continue;
      }

      let mut argumentIndex: u64 = 0;

      while (argumentIndex < attribute.arguments.length()) {
        if (let Option::SOME(argument) = attribute.arguments.get(argumentIndex)) {
          names.push(ParserTraitDefaults::normalizedPath(argument));
        }

        argumentIndex += 1;
      }

      index += 1;
    }

    return names;
  }

  /// The declared name of a method item, when the item is a function.
  function methodItemName(module: &mut Ast::Module, itemId: Ast::ItemId): Option<String> {
    let Option::SOME(item) = module.items.get(itemId) else {
      return Option::NONE;
    };

    let Ast::Item::Node::Function(method) = item else {
      return Option::NONE;
    };

    return Option::SOME(method.name.clone());
  }

  /// Whether `methods` already declares a method called `name`.
  function declaresMethod(
    module: &mut Ast::Module,
    methods: &Vector<Ast::ItemId>,
    name: &String,
  ): boolean {
    let mut index: u64 = 0;

    while (index < methods.length()) {
      let Option::SOME(methodId) = methods.get(index) else {
        index += 1;
        continue;
      };

      if (let Option::SOME(methodName) = ParserTraitDefaults::methodItemName(module, *methodId)) {
        if (methodName.equals(name.toStr())) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// `namespaces` with `entered` appended, or a copy of `namespaces` when the
  /// nested items are not inside a new namespace.
  function innerNamespaces(namespaces: &Vector<String>, entered: &Option<String>): Vector<String> {
    let mut inner: Vector<String> = Vector::new<String>();
    let mut index: u64 = 0;

    while (index < namespaces.length()) {
      if (let Option::SOME(segment) = namespaces.get(index)) {
        inner.push(segment.clone());
      }

      index += 1;
    }

    if (let Option::SOME(name) = entered) {
      inner.push(name.clone());
    }

    return inner;
  }

  /// Collects every trait default in `itemIds`, written inside `namespaces`,
  /// descending through namespaces and exported declarations.
  function collectEntries(
    module: &mut Ast::Module,
    itemIds: &Vector<Ast::ItemId>,
    namespaces: &Vector<String>,
    entries: &mut Vector<ParserTraitDefaults::Entry>,
  ): void {
    let mut index: u64 = 0;

    while (index < itemIds.length()) {
      let Option::SOME(itemId) = itemIds.get(index) else {
        index += 1;
        continue;
      };

      let mut traitName: Option<String> = Option::NONE;
      let mut defaultMethods: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut nested: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut nestedNamespace: Option<String> = Option::NONE;

      if (let Option::SOME(item) = module.items.get(*itemId)) {
        match (item) {
          Ast::Item::Node::Trait(trait_) -> {
            traitName = Option::SOME(trait_.name.clone());
            defaultMethods = ParserDeclarations::copyItemIds(&trait_.defaultMethods);
          },
          Ast::Item::Node::Namespace(namespaceItem) -> {
            nested = ParserDeclarations::copyItemIds(&namespaceItem.items);
            nestedNamespace = Option::SOME(namespaceItem.name.clone());
          },
          Ast::Item::Node::Export(exportItem) -> {
            if (let Option::SOME(innerItemId) = exportItem.declaration) {
              nested.push(innerItemId);
            }
          },
          _ -> {},
        };
      }

      if (let Option::SOME(name) = traitName) {
        let traitPath: String = ParserTraitDefaults::joinPath(namespaces, namespaces.length(), &name);
        let mut methodIndex: u64 = 0;

        while (methodIndex < defaultMethods.length()) {
          let Option::SOME(methodItemId) = defaultMethods.get(methodIndex) else {
            methodIndex += 1;
            continue;
          };

          if (let Option::SOME(methodName) = ParserTraitDefaults::methodItemName(module, *methodItemId)) {
            let mut entriesRef: &mut Vector<ParserTraitDefaults::Entry> = entries;
            entriesRef.push(ParserTraitDefaults::Entry {
              traitPath: traitPath.clone(),
              methodName: methodName.clone(),
              methodItemId: *methodItemId,
            });
          }

          methodIndex += 1;
        }
      }

      if (nested.length() > 0) {
        let inner: Vector<String> = ParserTraitDefaults::innerNamespaces(namespaces, &nestedNamespace);
        ParserTraitDefaults::collectEntries(module, &nested, &inner, entries);
      }

      index += 1;
    }
  }

  /// Records the defaults an implementing type, written inside `namespaces`,
  /// inherits but does not declare.
  function collectPendingForType(
    module: &mut Ast::Module,
    ownerItemId: Ast::ItemId,
    namespaces: &Vector<String>,
    implemented: &Vector<String>,
    methods: &Vector<Ast::ItemId>,
    entries: &Vector<ParserTraitDefaults::Entry>,
    pending: &mut Vector<ParserTraitDefaults::Pending>,
  ): void {
    let mut implementedIndex: u64 = 0;

    while (implementedIndex < implemented.length()) {
      let Option::SOME(written) = implemented.get(implementedIndex) else {
        implementedIndex += 1;
        continue;
      };

      let Option::SOME(traitPath) = ParserTraitDefaults::resolveTraitPath(written, namespaces, entries) else {
        implementedIndex += 1;
        continue;
      };

      let mut entryIndex: u64 = 0;

      while (entryIndex < entries.length()) {
        let Option::SOME(entry) = entries.get(entryIndex) else {
          entryIndex += 1;
          continue;
        };

        if (!entry.traitPath.equals(traitPath.toStr())) {
          entryIndex += 1;
          continue;
        }

        if (!ParserTraitDefaults::declaresMethod(module, methods, &entry.methodName)) {
          let mut pendingRef: &mut Vector<ParserTraitDefaults::Pending> = pending;
          pendingRef.push(ParserTraitDefaults::Pending {
            ownerItemId: ownerItemId,
            methodItemId: entry.methodItemId,
          });
        }

        entryIndex += 1;
      }

      implementedIndex += 1;
    }
  }

  /// Walks `itemIds`, written inside `namespaces`, looking for records and
  /// enums that inherit a default.
  function collectPending(
    module: &mut Ast::Module,
    itemIds: &Vector<Ast::ItemId>,
    namespaces: &Vector<String>,
    entries: &Vector<ParserTraitDefaults::Entry>,
    pending: &mut Vector<ParserTraitDefaults::Pending>,
  ): void {
    let mut index: u64 = 0;

    while (index < itemIds.length()) {
      let Option::SOME(itemId) = itemIds.get(index) else {
        index += 1;
        continue;
      };

      let mut implemented: Vector<String> = Vector::new<String>();
      let mut methods: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut isType: boolean = false;
      let mut nested: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
      let mut nestedNamespace: Option<String> = Option::NONE;

      if (let Option::SOME(item) = module.items.get(*itemId)) {
        match (item) {
          Ast::Item::Node::Record(record_) -> {
            isType = true;
            implemented = ParserTraitDefaults::implementedTraitNames(&record_.metadata);
            methods = ParserDeclarations::copyItemIds(&record_.methods);
          },
          Ast::Item::Node::Enum(enum_) -> {
            isType = true;
            implemented = ParserTraitDefaults::implementedTraitNames(&enum_.metadata);
            methods = ParserDeclarations::copyItemIds(&enum_.methods);
          },
          Ast::Item::Node::Namespace(namespaceItem) -> {
            nested = ParserDeclarations::copyItemIds(&namespaceItem.items);
            nestedNamespace = Option::SOME(namespaceItem.name.clone());
          },
          Ast::Item::Node::Export(exportItem) -> {
            if (let Option::SOME(innerItemId) = exportItem.declaration) {
              nested.push(innerItemId);
            }
          },
          _ -> {},
        };
      }

      if (isType && implemented.length() > 0) {
        ParserTraitDefaults::collectPendingForType(
          module,
          *itemId,
          namespaces,
          &implemented,
          &methods,
          entries,
          pending,
        );
      }

      if (nested.length() > 0) {
        let inner: Vector<String> = ParserTraitDefaults::innerNamespaces(namespaces, &nestedNamespace);
        ParserTraitDefaults::collectPending(module, &nested, &inner, entries, pending);
      }

      index += 1;
    }
  }

  /// Copies a parameter pattern so the materialized method owns its bindings
  /// instead of sharing them with the trait declaration.
  function clonePattern(module: &mut Ast::Module, patternId: Ast::PatternId): Ast::PatternId {
    let mut cloned: Option<Ast::Pattern::Node> = Option::NONE;

    if (let Option::SOME(pattern) = module.patterns.get(patternId)) {
      match (pattern) {
        Ast::Pattern::Node::Binding(binding) -> {
          cloned = Option::SOME(Ast::Pattern::Node::Binding(Ast::Pattern::Binding {
            span: binding.span,
            name: binding.name.clone(),
            annotation: binding.annotation,
            initializer: Option::NONE,
            metadata: Ast::copyMetadata(&binding.metadata),
          }));
        },
        Ast::Pattern::Node::Wildcard(wildcard) -> {
          cloned = Option::SOME(Ast::Pattern::Node::Wildcard(Ast::Pattern::Wildcard {
            span: wildcard.span,
          }));
        },
        _ -> {},
      };
    }

    let Option::SOME(node) = cloned else {
      return patternId;
    };

    let mut moduleRef: &mut Ast::Module = module;
    return moduleRef.addPattern(node);
  }

  /// Copies a trait default method item, keeping its body statement.
  function cloneMethodItem(
    module: &mut Ast::Module,
    methodItemId: Ast::ItemId,
  ): Option<Ast::ItemId> {
    let mut span: Option<SourceSpan> = Option::NONE;
    let mut body: Option<Ast::StatementId> = Option::NONE;
    let mut name: String = String::create("");
    let mut genericParameters: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
    let mut parameters: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
    let mut returnType: Option<Ast::TypeId> = Option::NONE;
    let mut metadata: Ast::Metadata = Ast::emptyMetadata();

    if (let Option::SOME(item) = module.items.get(methodItemId)) {
      if (let Ast::Item::Node::Function(method) = item) {
        span = Option::SOME(method.span);
        body = Option::SOME(method.body);
        name = method.name.clone();
        genericParameters = Ast::copyGenericParams(&method.genericParameters);
        parameters = ParserDeclarations::copyPatternIds(&method.parameters);
        returnType = method.returnType;
        metadata = Ast::copyMetadata(&method.metadata);
      }
    }

    let Option::SOME(methodSpan) = span else {
      return Option::NONE;
    };

    let Option::SOME(methodBody) = body else {
      return Option::NONE;
    };

    let mut clonedParameters: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
    let mut index: u64 = 0;

    while (index < parameters.length()) {
      let Option::SOME(patternId) = parameters.get(index) else {
        index += 1;
        continue;
      };

      clonedParameters.push(ParserTraitDefaults::clonePattern(module, *patternId));
      index += 1;
    }

    let mut moduleRef: &mut Ast::Module = module;

    return Option::SOME(moduleRef.addItem(Ast::Item::Node::Function(Ast::Item::Function {
      span: methodSpan,
      name: name,
      genericParameters: genericParameters,
      parameters: clonedParameters,
      returnType: returnType,
      body: methodBody,
      metadata: metadata,
    })));
  }

  /// Appends a materialized method to the type that inherits it.
  function attachMethod(
    module: &mut Ast::Module,
    ownerItemId: Ast::ItemId,
    methodItemId: Ast::ItemId,
  ): void {
    let Option::SOME(item) = module.items.getMut(ownerItemId) else {
      return;
    };

    match (item) {
      Ast::Item::Node::Record(record_) -> {
        let mut methods: Vector<Ast::ItemId> = ParserDeclarations::copyItemIds(&record_.methods);
        methods.push(methodItemId);

        *item = Ast::Item::Node::Record(Ast::Item::Record {
          span: record_.span,
          name: record_.name.clone(),
          genericParameters: Ast::copyGenericParams(&record_.genericParameters),
          fields: ParserDeclarations::copyPatternIds(&record_.fields),
          methods: methods,
          metadata: Ast::copyMetadata(&record_.metadata),
        });
      },
      Ast::Item::Node::Enum(enum_) -> {
        let mut methods: Vector<Ast::ItemId> = ParserDeclarations::copyItemIds(&enum_.methods);
        methods.push(methodItemId);

        *item = Ast::Item::Node::Enum(Ast::Item::Enum {
          span: enum_.span,
          name: enum_.name.clone(),
          genericParameters: Ast::copyGenericParams(&enum_.genericParameters),
          variants: ParserDeclarations::copyPatternIds(&enum_.variants),
          methods: methods,
          metadata: Ast::copyMetadata(&enum_.metadata),
        });
      },
      _ -> {},
    };
  }

  /// Materializes every inherited trait default in the parsed module.
  function materialize(module: &mut Ast::Module): void {
    let roots: Vector<Ast::ItemId> = ParserDeclarations::copyItemIds(&module.roots);
    let mut entries: Vector<ParserTraitDefaults::Entry> = Vector::new<ParserTraitDefaults::Entry>();

    let topLevel: Vector<String> = Vector::new<String>();
    ParserTraitDefaults::collectEntries(module, &roots, &topLevel, &mut entries);

    if (entries.length() == 0) {
      return;
    }

    let mut pending: Vector<ParserTraitDefaults::Pending> = Vector::new<ParserTraitDefaults::Pending>();
    ParserTraitDefaults::collectPending(module, &roots, &topLevel, &entries, &mut pending);

    let mut index: u64 = 0;

    while (index < pending.length()) {
      let Option::SOME(entry) = pending.get(index) else {
        index += 1;
        continue;
      };

      let ownerItemId: Ast::ItemId = entry.ownerItemId;
      let methodItemId: Ast::ItemId = entry.methodItemId;

      if (let Option::SOME(clonedId) = ParserTraitDefaults::cloneMethodItem(module, methodItemId)) {
        ParserTraitDefaults::attachMethod(module, ownerItemId, clonedId);
      }

      index += 1;
    }
  }
}
