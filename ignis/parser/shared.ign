import Char from "std::char";
import LibC, CType from "std::libc";
import Vector from "std::vector";

import Ast from "@compiler::ast";
import
  Diagnostic,
  DiagnosticBag,
  DiagnosticCode,
  LabelKind,
  Severity,
  SourceSpan,
from "@compiler::diagnostics";
import Keyword, Punctuation, Token, TokenKind, TokenStream from "@compiler::syntax";

import CompileFlags from "./compile_flags";

export namespace ParserShared {
  function isTrivia(token: Token): boolean {
    return token.kindValue() == TokenKind::WHITESPACE || token.kindValue() == TokenKind::LINE_COMMENT || token.kindValue() == TokenKind::BLOCK_COMMENT || token.kindValue() == TokenKind::OUTER_DOC_COMMENT || token.kindValue() == TokenKind::INNER_DOC_COMMENT;
  }

  function nextSignificantToken(parser: &mut ParserShared::State, startOffset: u64): Token {
    let parserRef: &mut ParserShared::State = parser;
    let token: Token = parserRef.tokens.peekNth(startOffset).clone();
    let kind: TokenKind = token.kindValue();

    if (kind == TokenKind::WHITESPACE || kind == TokenKind::LINE_COMMENT || kind == TokenKind::BLOCK_COMMENT || kind == TokenKind::OUTER_DOC_COMMENT || kind == TokenKind::INNER_DOC_COMMENT) {
      return ParserShared::nextSignificantToken(parserRef, startOffset + 1);
    }

    return token;
  }

  function mergeSpans(start: SourceSpan, end: SourceSpan): SourceSpan {
    return SourceSpan::new(start.filePath, start.start, end.end);
  }

  function stripQuotes(lexeme: &String): String {
    if (lexeme.length() < 2) {
      return lexeme.clone();
    }

    return lexeme.substringBytes(1, lexeme.length() - 1);
  }

  /// Decodes the escape sequences of a string or template chunk, mirroring
  /// the host lexer's table: an unknown escape drops both the backslash and
  /// the character after it. Template-only escapes (`` \` `` and `\$`)
  /// decode the same way in a plain string, where they cannot occur.
  function decodeEscapes(text: String): String {
    let mut result: String = String::create("");
    let mut index: u64 = 0;

    while (index < text.length()) {
      let Option::SOME(byte) = text.byteAt(index) else {
        index += 1;
        continue;
      };

      if (byte != '\\' as u8) {
        result.pushByte(byte);
        index += 1;
        continue;
      }

      index += 1;

      let Option::SOME(escaped) = text.byteAt(index) else {
        break;
      };

      if (escaped == 'n' as u8) {
        result.pushByte(10);
      } else if (escaped == 'r' as u8) {
        result.pushByte(13);
      } else if (escaped == 't' as u8) {
        result.pushByte(9);
      } else if (escaped == '0' as u8) {
        result.pushByte(0);
      } else if (escaped == 'b' as u8) {
        result.pushByte(8);
      } else if (escaped == 'f' as u8) {
        result.pushByte(12);
      } else if (escaped == '"' as u8 || escaped == '\\' as u8 || escaped == '`' as u8 || escaped == '$' as u8) {
        result.pushByte(escaped);
      }

      index += 1;
    }

    return result;
  }

  /// Removes the delimiters around a template chunk.
  ///
  /// `leading` and `trailing` are byte counts: a head is `` `text${ `` and a tail
  /// is `` }text` ``, so the delimiter widths differ per chunk kind.
  function stripTemplateDelimiters(lexeme: &String, leading: u64, trailing: u64): String {
    let total: u64 = leading + trailing;

    if (lexeme.length() < total) {
      return String::new();
    }

    return lexeme.substringBytes(leading, lexeme.length() - trailing);
  }

  function parseUnsignedInteger(lexeme: &String): Option<u64> {
    return ParserShared::parseUnsignedIntegerWithRadix(lexeme, 0, 10);
  }

  function parseDigitForRadix(value: char, radix: u64): Option<u64> {
    if (let Option::SOME(digitValue) = Char::asciiDigitValue(value)) {
      if (digitValue < radix) {
        return Option::SOME(digitValue);
      }
    }

    if (value >= 'a' && value <= 'f') {
      let digitValue: u64 = 10 + ((value as u64) - ('a' as u64));
      if (digitValue < radix) {
        return Option::SOME(digitValue);
      }
    }

    if (value >= 'A' && value <= 'F') {
      let digitValue: u64 = 10 + ((value as u64) - ('A' as u64));
      if (digitValue < radix) {
        return Option::SOME(digitValue);
      }
    }

    return Option::NONE;
  }

  function parseUnsignedIntegerWithRadix(
    lexeme: &String,
    startIndex: u64,
    radix: u64
  ): Option<u64> {
    let mut value: u64 = 0;
    let mut index: u64 = startIndex;

    while (index < lexeme.length()) {
      let digit = lexeme.charAt(index)!;
      let digitValue = ParserShared::parseDigitForRadix(digit, radix)!;

      value = value * radix + digitValue;
      index += 1;
    }

    return Option::SOME(value);
  }

  function parseHexInteger(lexeme: &String): Option<u64> {
    if (lexeme.length() < 3) {
      return Option::NONE;
    }

    return ParserShared::parseUnsignedIntegerWithRadix(lexeme, 2, 16);
  }

  function parseBinaryInteger(lexeme: &String): Option<u64> {
    if (lexeme.length() < 3) {
      return Option::NONE;
    }

    return ParserShared::parseUnsignedIntegerWithRadix(lexeme, 2, 2);
  }

  function parseFloatLiteral(lexeme: &String): Option<f64> {
    return Option::SOME(LibC::Conversion::atof(lexeme.toStr() as CType::CConstStr) as f64);
  }

  /// The value of one hexadecimal digit, or `NONE` when the character is not one.
  function hexDigitValue(value: char): Option<u32> {
    if (value >= '0' && value <= '9') {
      return Option::SOME((value as u32) - ('0' as u32));
    }

    if (value >= 'a' && value <= 'f') {
      return Option::SOME(10 + ((value as u32) - ('a' as u32)));
    }

    if (value >= 'A' && value <= 'F') {
      return Option::SOME(10 + ((value as u32) - ('A' as u32)));
    }

    return Option::NONE;
  }

  /// Reads the `{HEX}` payload of a `\u` escape starting at `startByte`.
  ///
  /// `NONE` for a payload that is not a single braced run of one to six hex
  /// digits naming a Unicode scalar, which is what the lexer already accepted
  /// before the literal reached the parser.
  function parseUnicodeEscapeChar(inner: &String, startByte: u64): Option<char> {
    let mut cursor: u64 = startByte;

    if (cursor >= inner.length()) {
      return Option::NONE;
    }

    let open = inner.charAt(cursor, &mut cursor)!;
    if (open != '{') {
      return Option::NONE;
    }

    let mut value: u32 = 0;
    let mut digits: u64 = 0;

    while (cursor < inner.length()) {
      let next = inner.charAt(cursor, &mut cursor)!;

      if (next == '}') {
        if (digits == 0 || cursor != inner.length()) {
          return Option::NONE;
        }

        if (value > 1114111) {
          return Option::NONE;
        }

        if (value >= 55296 && value <= 57343) {
          return Option::NONE;
        }

        return Option::SOME(value as char);
      }

      let Option::SOME(digit) = ParserShared::hexDigitValue(next) else {
        return Option::NONE;
      };

      if (digits >= 6) {
        return Option::NONE;
      }

      value = value * 16 + digit;
      digits += 1;
    }

    return Option::NONE;
  }

  function parseCharacterLiteral(lexeme: &String): Option<char> {
    let inner: String = ParserShared::stripQuotes(lexeme);
    let mut endByte: u64 = 0;

    if (inner.length() == 0) {
      return Option::NONE;
    }

    let first = inner.charAt(0, &mut endByte)!;

    if (first != '\\') {
      if (endByte == inner.length()) {
        return Option::SOME(first);
      }

      return Option::NONE;
    }

    let escape = inner.charAt(endByte, &mut endByte)!;

    // `\u{...}` carries its own payload, so it is read before the
    // single-character escapes below rule out anything past the escape letter.
    if (escape == 'u') {
      return ParserShared::parseUnicodeEscapeChar(&inner, endByte);
    }

    if (endByte != inner.length()) {
      return Option::NONE;
    }

    if (escape == '0') {
      return Option::SOME('\0');
    }

    if (escape == 'b') {
      return Option::SOME('\b');
    }

    if (escape == 'f') {
      return Option::SOME('\f');
    }

    if (escape == 'n') {
      return Option::SOME('\n');
    }

    if (escape == 'r') {
      return Option::SOME('\r');
    }

    if (escape == 't') {
      return Option::SOME('\t');
    }

    if (escape == '\\') {
      return Option::SOME('\\');
    }

    if (escape == '\'') {
      return Option::SOME('\'');
    }

    if (escape == '"') {
      return Option::SOME('"');
    }

    return Option::NONE;
  }

  function copyTypeIds(source: &Vector<Ast::TypeId>): Vector<Ast::TypeId> {
    let mut copied: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      let Option::SOME(value) = source.get(index) else {
        index += 1;
        continue;
      };

      copied.push(*value);
      index += 1;
    }

    return copied;
  }

  function copyPatternIds(source: &Vector<Ast::PatternId>): Vector<Ast::PatternId> {
    let mut copied: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      let Option::SOME(value) = source.get(index) else {
        index += 1;
        continue;
      };

      copied.push(*value);
      index += 1;
    }

    return copied;
  }

  function copyItemIds(source: &Vector<Ast::ItemId>): Vector<Ast::ItemId> {
    let mut copied: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      let Option::SOME(value) = source.get(index) else {
        index += 1;
        continue;
      };

      copied.push(*value);
      index += 1;
    }

    return copied;
  }

  function copyStatementIds(source: &Vector<Ast::StatementId>): Vector<Ast::StatementId> {
    let mut copied: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      let Option::SOME(value) = source.get(index) else {
        index += 1;
        continue;
      };

      copied.push(*value);
      index += 1;
    }

    return copied;
  }

  function copyStrings(source: &Vector<String>): Vector<String> {
    let mut copied: Vector<String> = Vector::new<String>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      let Option::SOME(value) = source.get(index) else {
        index += 1;
        continue;
      };

      copied.push(value.clone());
      index += 1;
    }

    return copied;
  }

  record State {
    public tokens: &mut TokenStream;
    public diagnostics: &mut DiagnosticBag;
    public module: &mut Ast::Module;
    /// Compile-time configuration `@configFlag`, `@if` and `@ifelse` fold
    /// against while this file is parsed.
    public flags: CompileFlags;

    public current(&self): Token {
      return self.tokens.peek();
    }

    public bump(&mut self): Token {
      return self.tokens.bump();
    }

    public skipTrivia(&mut self): void {
      while (true) {
        let token: Token = self.current();

        if (token.kindValue() == TokenKind::LINE_COMMENT || token.kindValue() == TokenKind::BLOCK_COMMENT) {
          self.bump();
          continue;
        }

        if (token.kindValue() == TokenKind::OUTER_DOC_COMMENT || token.kindValue() == TokenKind::INNER_DOC_COMMENT) {
          self.bump();
          continue;
        }

        if (token.kindValue() == TokenKind::WHITESPACE) {
          self.bump();
          continue;
        }

        return;
      }
    }

    public atEof(&mut self): boolean {
      self.skipTrivia();
      return self.current().kindValue() == TokenKind::EOF;
    }

    public atKeyword(&mut self, keyword: Keyword): boolean {
      self.skipTrivia();
      let token: Token = self.current();
      return token.kindValue() == TokenKind::KEYWORD && token.keywordValue() == keyword;
    }

    public atPunctuation(&mut self, punctuation: Punctuation): boolean {
      self.skipTrivia();
      let token: Token = self.current();
      return token.kindValue() == TokenKind::PUNCTUATION && token.punctuationValue() == punctuation;
    }

    public consumeKeyword(&mut self, keyword: Keyword): Option<Token> {
      if (!self.atKeyword(keyword)) {
        return Option::NONE;
      }

      return Option::SOME(self.bump());
    }

    public consumePunctuation(&mut self, punctuation: Punctuation): Option<Token> {
      if (!self.atPunctuation(punctuation)) {
        return Option::NONE;
      }

      return Option::SOME(self.bump());
    }

    public emitDiagnostic(&mut self, span: SourceSpan, code: str, message: str, label: str): void {
      let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, code, message, span);
      diagnostic.addLabel(LabelKind::PRIMARY, span, label);
      self.diagnostics.push(diagnostic);
    }

    /// Reports a token the reference compiler names in the message itself.
    ///
    /// Its `expect` renders the awaited `TokenType`, so the message is
    /// `Expected <TokenTypeName>`; the caller's prose stays on the label,
    /// where it adds context the reference compiler does not print.
    public expectedToken(&mut self, span: SourceSpan, tokenName: str, label: str): void {
      let message: String = `Expected ${tokenName}`;
      self.emitDiagnostic(span, DiagnosticCode::EXPECTED_TOKEN, message.toStr(), label);
    }

    /// Consumes an identifier without reporting when there is none, for callers
    /// that word the failure differently from `Expected Identifier`.
    public consumeIdentifier(&mut self): Option<Token> {
      self.skipTrivia();

      if (self.current().kindValue() != TokenKind::IDENTIFIER) {
        return Option::NONE;
      }

      return Option::SOME(self.bump());
    }

    public expectIdentifier(&mut self, label: str): Option<Token> {
      self.skipTrivia();
      let token: Token = self.current();

      if (token.kindValue() == TokenKind::IDENTIFIER) {
        return Option::SOME(self.bump());
      }

      self.expectedToken(token.span, "Identifier", label);
      return Option::NONE;
    }

    public expectKeyword(&mut self, keyword: Keyword, label: str): Option<Token> {
      self.skipTrivia();
      let token: Token = self.current();

      if (token.kindValue() == TokenKind::KEYWORD && token.keywordValue() == keyword) {
        return Option::SOME(self.bump());
      }

      self.expectedToken(token.span, keyword.diagnosticName(), label);
      return Option::NONE;
    }

    public expectPunctuation(&mut self, punctuation: Punctuation, label: str): Option<Token> {
      self.skipTrivia();
      let token: Token = self.current();

      if (token.kindValue() == TokenKind::PUNCTUATION && token.punctuationValue() == punctuation) {
        return Option::SOME(self.bump());
      }

      self.expectedToken(token.span, punctuation.diagnosticName(), label);
      return Option::NONE;
    }

    public expectGreater(&mut self): Option<Token> {
      self.skipTrivia();
      let token: Token = self.current();
      let span: SourceSpan = token.span;

      if (self.tokens.expectGreater()) {
        return Option::SOME(token.clone());
      }

      self.expectedToken(span, "Greater", "expected '>' to close generic arguments");
      return Option::NONE;
    }
  }

  function createState(
    tokens: &mut TokenStream,
    diagnostics: &mut DiagnosticBag,
    module: &mut Ast::Module,
    flags: &CompileFlags,
  ): State {
    return State {
      tokens: tokens,
      diagnostics: diagnostics,
      module: module,
      flags: flags.clone(),
    };
  }
}
