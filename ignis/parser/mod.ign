import _ from "./shared";
import _ from "./declarations";
import _ from "./types";
import _ from "./expressions";
import _ from "./statements";
import _ from "./patterns";
import _ from "./recovery";
import _ from "./trait_defaults";

import Ast from "@compiler::ast";
import Diagnostic, DiagnosticBag, DiagnosticNote, SourceFile from "@compiler::diagnostics";
import LexResult, Lexer from "@compiler::lexer";

/// Result of parsing a full source file: the populated module plus the
/// diagnostics produced by lexing and parsing as separate bags so callers
/// can report them per phase.
export record ParseOutput {
  public module: Ast::Module;
  public lexDiagnostics: DiagnosticBag;
  public parseDiagnostics: DiagnosticBag;
}

/// Deep-copy a diagnostic (severity, code, message, primary span, labels,
/// notes, help) since `Diagnostic` does not implement `Clone`.
function cloneDiagnostic(diag: &Diagnostic): Diagnostic {
  let mut cloned: Diagnostic = Diagnostic::new(diag.severity, diag.code, diag.messageText(), diag.primarySpan);
  let mut labelIndex: u64 = 0;

  while (labelIndex < diag.labels.length()) {
    let Option::SOME(label) = diag.labels.get(labelIndex) else {
      labelIndex += 1;
      continue;
    };

    cloned.addLabel(label.kind, label.span, label.messageText());
    labelIndex += 1;
  }

  let mut noteIndex: u64 = 0;

  while (noteIndex < diag.notes.length()) {
    let Option::SOME(note) = diag.notes.get(noteIndex) else {
      noteIndex += 1;
      continue;
    };

    cloned.notes.push(DiagnosticNote {
      kind: note.kind,
      message: note.message.clone(),
    });
    noteIndex += 1;
  }

  if (let Option::SOME(help) = diag.helpText()) {
    cloned.setHelp(help);
  }

  return cloned;
}

/// Moves the parsed roots into the module. The parse loop collects them into a
/// local list first because the parser state owns the module reference, so the
/// list it appends to cannot live inside it.
function pushRoots(module: &mut Ast::Module, roots: &Vector<Ast::ItemId>): void {
  let mut moduleRef: &mut Ast::Module = module;
  let mut index: u64 = 0;

  while (index < roots.length()) {
    if (let Option::SOME(itemId) = roots.get(index)) {
      moduleRef.roots.push(*itemId);
    }

    index += 1;
  }
}

export namespace Parser {
  function parseInto(
    file: &SourceFile,
    module: &mut Ast::Module,
    diagnostics: &mut DiagnosticBag
  ): void {
    let mut lexResult: LexResult = Lexer::lex(file);
    let mut diagnosticsRef: &mut DiagnosticBag = diagnostics;
    let mut lexDiagIndex: u64 = 0;

    while (lexDiagIndex < lexResult.diagnostics.length()) {
      let Option::SOME(lexDiag) = lexResult.diagnostics.get(lexDiagIndex) else {
        lexDiagIndex += 1;
        continue;
      };

      diagnosticsRef.push(cloneDiagnostic(lexDiag));
      lexDiagIndex += 1;
    }

    let mut parser: ParserShared::State = ParserShared::createState(&mut lexResult.tokens, diagnosticsRef, module);

    let mut roots: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();

    while (!parser.atEof()) {
      if (!ParserDeclarations::parseItemListEntry(&mut parser, &mut roots)) {
        ParserRecovery::synchronizeTopLevel(&mut parser);
      }
    }

    pushRoots(parser.module, &roots);

    ParserTraitDefaults::materialize(parser.module);
  }

  /// Lex and parse `file` end-to-end, returning the populated module and the
  /// diagnostics from each phase. This is the high-level entry point for the
  /// driver and CLI: it owns the AST module so the caller does not need to
  /// pre-allocate one.
  function parseFile(file: &SourceFile): ParseOutput {
    let mut module: Ast::Module = Ast::Module::init();
    let mut parseDiagnostics: DiagnosticBag = DiagnosticBag::init();
    let mut lexResult: LexResult = Lexer::lex(file);

    let mut parser: ParserShared::State = ParserShared::createState(
      &mut lexResult.tokens,
      &mut parseDiagnostics,
      &mut module,
    );

    let mut roots: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();

    while (!parser.atEof()) {
      if (!ParserDeclarations::parseItemListEntry(&mut parser, &mut roots)) {
        ParserRecovery::synchronizeTopLevel(&mut parser);
      }
    }

    pushRoots(parser.module, &roots);

    ParserTraitDefaults::materialize(parser.module);

    return ParseOutput {
      module: module,
      lexDiagnostics: lexResult.diagnostics,
      parseDiagnostics: parseDiagnostics,
    };
  }
}
