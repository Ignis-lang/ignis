import Fs from "std::fs";
import Path from "std::path";
import Process from "std::process";
import String from "std::string";
import Test from "std::test";

import DiagnosticBag from "@compiler::diagnostics";
import BuildArtifacts from "./build/artifacts";

import Format from "./format/api";
import FormatterCliOverrides, FormatterConfig, FormatterConfigPaths from "./format/config";
import
  CompileOutcome,
  comparePathComponents,
  compileOutcome,
  fmtConfigErrorMessage,
  fmtConfigErrorMessageForPath,
  fmtStdinJsonValidateAndProcessLine,
  formatBuildDuration,
  formatFailureLine,
  formatSuccessLine,
  prepareTestBinaryDirectory,
  replayedReport,
  statusLine,
  stripAnsiEscapes,
  testBinaryPath,
  validateUtf8From,
from "./main";

function invalidIndentWidthBag(): DiagnosticBag {
  let paths: FormatterConfigPaths = FormatterConfigPaths {
    projectRoot: Path::PathBuf::create("."),
    ignisToml: Option::NONE,
    dedicatedConfig: Option::NONE,
    explicitConfig: Option::NONE,
  };

  let overrides: FormatterCliOverrides = FormatterCliOverrides {
    indentWidth: Option::SOME(0),
    lineWidth: Option::NONE,
    useTabs: Option::NONE,
    sortImports: Option::NONE,
  };

  let Result::ERROR(bag) = Format::Config::load(&paths, &overrides) else {
    Test::fail();
    @unreachable();
  };

  return bag;
}

/// The host CLI prefixes a formatter configuration failure with `formatter
/// configuration failed: `; `printFmtConfigError` used to drop that prefix
/// entirely.
@test
function fmtConfigErrorMessageAddsTheHostsPrefix(): void {
  let bag: DiagnosticBag = invalidIndentWidthBag();
  let message: String = fmtConfigErrorMessage(&bag);

  Test::assertEq<str>(
    message.toStr(),
    "formatter configuration failed: formatter config '<cli>' has invalid 'indent_width': expected 0 to be within 1..=8"
  );
}

/// The per-file variant additionally prefixes the file path, the way the
/// host CLI's per-file config resolution does.
@test
function fmtConfigErrorMessageForPathAddsThePathAndThePrefix(): void {
  let bag: DiagnosticBag = invalidIndentWidthBag();
  let path: Path::PathBuf = Path::PathBuf::create("src/main.ign");
  let message: String = fmtConfigErrorMessageForPath(&path, &bag);

  Test::assertEq<str>(
    message.toStr(),
    "src/main.ign: formatter configuration failed: formatter config '<cli>' has invalid 'indent_width': expected 0 to be within 1..=8"
  );
}

/// A raw control byte and an ASCII run are both valid UTF-8: the whole
/// buffer validates in one pass regardless of where `reachedEnd` sits.
@test
function validateUtf8FromAcceptsPlainAsciiBytes(): void {
  let text: String = String::create("hello");
  let Option::SOME(validatedUpTo) = validateUtf8From(&text, 0, true) else {
    Test::fail();
    return;
  };

  Test::assertEq<u64>(validatedUpTo, text.length());
}

/// A complete multi-byte scalar (`é`, `C3 A9`) validates fully once it is
/// entirely present, whether or not more input might still follow.
@test
function validateUtf8FromAcceptsACompleteMultiByteScalar(): void {
  let text: String = String::create("cafe\u{e9}");
  let Option::SOME(validatedUpTo) = validateUtf8From(&text, 0, false) else {
    Test::fail();
    return;
  };

  Test::assertEq<u64>(validatedUpTo, text.length());
}

/// A multi-byte sequence cut short by the end of the bytes read so far is
/// left unvalidated (not an error yet) while more input might still
/// complete it.
@test
function validateUtf8FromLeavesATruncatedSequenceForMoreInput(): void {
  let mut text: String = String::create("a");
  text.pushByte(0xC3);

  let Option::SOME(validatedUpTo) = validateUtf8From(&text, 0, false) else {
    Test::fail();
    return;
  };

  Test::assertEq<u64>(validatedUpTo, 1);
}

/// The same truncated sequence is a genuine error once no more input will
/// arrive (`reachedEnd` true).
@test
function validateUtf8FromRejectsATruncatedSequenceAtTrueEof(): void {
  let mut text: String = String::create("a");
  text.pushByte(0xC3);

  let Option::SOME(_) = validateUtf8From(&text, 0, true) else {
    return;
  };

  Test::fail();
}

/// `0xFF` cannot start any UTF-8 sequence: rejected immediately regardless
/// of `reachedEnd`.
@test
function validateUtf8FromRejectsAnInvalidLeadingByte(): void {
  let mut text: String = String::create("a");
  text.pushByte(0xFF);
  text.pushByte(0xFE);

  let Option::SOME(_) = validateUtf8From(&text, 0, false) else {
    return;
  };

  Test::fail();
}

/// A blank (whitespace-only) line is a valid line: it validates and is
/// skipped, not treated as an error.
@test
function fmtStdinJsonValidateAndProcessLineAcceptsABlankLine(): void {
  let line: String = String::create("   ");
  let config: FormatterConfig = FormatterConfig::default();

  let Option::SOME(result) = fmtStdinJsonValidateAndProcessLine(&line, &config, false) else {
    Test::fail();
    return;
  };

  Test::assertEq<boolean>(result.changed, false);
  Test::assertEq<boolean>(result.hadError, false);
}

/// A line carrying an invalid UTF-8 byte reports the fatal stream-level
/// failure (`Option::NONE`). Validation runs against this line's own bytes
/// only: this is the contract `runFmtStdinJson` relies on to finish printing
/// every earlier complete line's response before a later line's invalid
/// byte aborts the batch, instead of validating the whole growing buffer
/// (and discarding already-buffered valid lines) the moment any invalid
/// byte arrives.
@test
function fmtStdinJsonValidateAndProcessLineRejectsAnInvalidUtf8Byte(): void {
  let mut line: String = String::create("{\"path\":\"a\",\"text\":\"");
  line.pushByte(0xFF);
  line.pushStr("\"}");
  let config: FormatterConfig = FormatterConfig::default();

  let Option::SOME(_) = fmtStdinJsonValidateAndProcessLine(&line, &config, false) else {
    return;
  };

  Test::fail();
}

/// `a/b.ign` sorts before `a-b.ign`: the first path component `a` sorts
/// before the whole second component `a-b.ign`, even though `-` (0x2D)
/// sorts before `/` (0x2F) byte for byte. Matches Rust's `PathBuf`/`Path`
/// `Ord`, which project-mode `fmt` has to reproduce (host reference:
/// `crates/ignis_driver`'s file collection sorts `Vec<PathBuf>` directly).
@test
function comparePathComponentsOrdersASlashBeforeADash(): void {
  let slashPath: String = String::create("a/b.ign");
  let dashPath: String = String::create("a-b.ign");

  Test::assert(comparePathComponents(&slashPath, &dashPath) < 0);
  Test::assert(comparePathComponents(&dashPath, &slashPath) > 0);
}

/// At the second component, `b` (a whole component of `a/b/c.ign`) is a
/// prefix of `b.ign` (a whole component of `a/b.ign`), so the shorter
/// component sorts first — the same rule `comparePathComponentsOrdersASlashBeforeADash`
/// exercises one level up, applied within a single component.
@test
function comparePathComponentsOrdersAShorterComponentFirst(): void {
  let threeComponentPath: String = String::create("a/b/c.ign");
  let twoComponentPath: String = String::create("a/b.ign");

  Test::assert(comparePathComponents(&threeComponentPath, &twoComponentPath) < 0);
}

@test
function comparePathComponentsIsEqualForIdenticalPaths(): void {
  let left: String = String::create("a/b/c.ign");
  let right: String = String::create("a/b/c.ign");

  Test::assertEq<i32>(comparePathComponents(&left, &right), 0);
}

/// `ignis test` links its binary, and writes the C and object files named
/// after it, under the out directory rather than the current directory.
@test
function testBinaryGoesUnderTheOutDirectory(): void {
  let outDir: Path::PathBuf = Path::PathBuf::create("/work/project/build");
  let name: String = String::create("ignis");
  let noOutput: Option<String> = Option::NONE;

  let expected: String = outDir.join("bin").join("ignis-tests").toString();

  Test::assertEq<str>(testBinaryPath(&outDir, &name, &noOutput).toStr(), expected.toStr());
}

/// An explicit `-o` still names the test binary itself.
@test
function testBinaryFollowsAnExplicitOutput(): void {
  let outDir: Path::PathBuf = Path::PathBuf::create("/work/project/build");
  let name: String = String::create("ignis");
  let output: Option<String> = Option::SOME(String::create("build/bootstrap/stage1-tests/ignis-tests"));

  Test::assertEq<str>(testBinaryPath(&outDir, &name, &output).toStr(), "build/bootstrap/stage1-tests/ignis-tests");
}

/// A fresh scratch directory for one test-binary directory test.
function testBinaryScratch(label: str): Path::PathBuf {
  let Result::OK(root) = Fs::tempDir() else {
    Test::fail();
    return Path::PathBuf::new();
  };

  let name: String = `ignis-test-binary-${label}-${Process::id()}`;
  let scratch: Path::PathBuf = root.join(name.toStr());
  let _removed = Fs::removeDirAll(&scratch);

  let Result::OK(_) = Fs::createDirAll(&scratch) else {
    Test::fail();
    return Path::PathBuf::new();
  };

  return scratch;
}

/// A bare `-o name` has no directory to create and links in the current one.
@test
function testBinaryDirectoryAcceptsABareOutputName(): void {
  let bare: String = String::create("mytests");
  Test::assert(prepareTestBinaryDirectory(&bare));
}

/// The default `<out>/bin` does not exist before the first run.
@test
function testBinaryDirectoryIsCreatedUnderANewOutDirectory(): void {
  let scratch: Path::PathBuf = testBinaryScratch("new");
  let binaryPath: String = scratch.join("out").join("bin").join("ignis-tests").toString();

  Test::assert(prepareTestBinaryDirectory(&binaryPath));
  Test::assert(Fs::exists(scratch.join("out").join("bin").asStr()));

  let _removed = Fs::removeDirAll(&scratch);
}

/// A directory that cannot be created, here because a file is in the way,
/// fails the setup instead of failing later in the toolchain.
@test
function testBinaryDirectoryFailsUnderAFile(): void {
  let scratch: Path::PathBuf = testBinaryScratch("file");
  let blocker: Path::PathBuf = scratch.join("out");
  let content: String = String::create("not a directory");

  let Result::OK(_) = Fs::writeString(&blocker, &content) else {
    Test::fail();
    return;
  };

  let binaryPath: String = blocker.join("bin").join("ignis-tests").toString();
  Test::assert(!prepareTestBinaryDirectory(&binaryPath));

  let _removed = Fs::removeDirAll(&scratch);
}

/// Build durations read like the Rust compiler's: milliseconds below one
/// second, tenths of a second below one minute, then minutes and seconds.
@test
function formatBuildDurationPicksTheUnitByMagnitude(): void {
  Test::assertEq<str>(formatBuildDuration(0).toStr(), "0ms");
  Test::assertEq<str>(formatBuildDuration(75).toStr(), "75ms");
  Test::assertEq<str>(formatBuildDuration(999).toStr(), "999ms");
  Test::assertEq<str>(formatBuildDuration(1000).toStr(), "1.0s");
  Test::assertEq<str>(formatBuildDuration(1250).toStr(), "1.2s");
  Test::assertEq<str>(formatBuildDuration(59999).toStr(), "59.9s");
  Test::assertEq<str>(formatBuildDuration(60000).toStr(), "1m00s");
  Test::assertEq<str>(formatBuildDuration(123456).toStr(), "2m03s");
}

/// A failed run counts its errors and warnings with the right noun, and leaves
/// the warnings out when there are none.
@test
function formatFailureLineCountsWithSingularAndPlural(): void {
  Test::assertEq<str>(formatFailureLine("Build", 3, 1).toStr(), "Build failed: 3 errors, 1 warning");
  Test::assertEq<str>(formatFailureLine("Check", 1, 2).toStr(), "Check failed: 1 error, 2 warnings");
  Test::assertEq<str>(formatFailureLine("Build", 2, 0).toStr(), "Build failed: 2 errors");
}

/// A successful run names its warnings only when it has some.
@test
function formatSuccessLineMentionsWarningsOnlyWhenPresent(): void {
  let timing: String = String::create("2m03s");
  let cached: String = String::create("cached");

  Test::assertEq<str>(formatSuccessLine("Compiled", " with ", 0, &timing).toStr(), "Compiled (2m03s)");
  Test::assertEq<str>(formatSuccessLine("Compiled", " with ", 12, &timing).toStr(), "Compiled with 12 warnings (2m03s)");
  Test::assertEq<str>(formatSuccessLine("Compiled", " with ", 1, &cached).toStr(), "Compiled with 1 warning (cached)");
  Test::assertEq<str>(formatSuccessLine("No errors found", ", ", 2, &timing).toStr(), "No errors found, 2 warnings (2m03s)");
}

/// The escape character that starts every ANSI styling sequence.
const ESCAPE_BYTE: u8 = 27;

/// `text` with every `\x1b` replaced by the visible `<ESC>`, so a test can
/// build styled input from plain literals.
function withEscapes(text: str): String {
  let mut result: String = String::new();
  let source: String = String::create(text);
  let marker: String = String::create("<ESC>");
  let mut index: u64 = 0;

  while (index < source.length()) {
    if (source.substringBytes(index, source.length()).startsWith(marker.toStr())) {
      result.pushByte(ESCAPE_BYTE);
      index += marker.length();
      continue;
    }

    if (let Option::SOME(byte) = source.byteAt(index)) {
      result.pushByte(byte);
    }

    index += 1;
  }

  return result;
}

/// Styling sequences are removed and everything between them is kept,
/// multi-byte characters included.
@test
function stripAnsiEscapesKeepsOnlyTheText(): void {
  let styled: String = withEscapes("<ESC>[31m<ESC>[1mError<ESC>[0m[A0001]: café\n  <ESC>[34m<ESC>[1m|<ESC>[0m\n");
  let plain: String = stripAnsiEscapes(&styled);

  Test::assertEq<str>(plain.toStr(), "Error[A0001]: café\n  |\n");
}

/// A warm run replays its stored report with styling on a terminal and as
/// plain text anywhere else.
@test
function replayedReportIsPlainOffATerminal(): void {
  let stored: String = withEscapes("<ESC>[33m<ESC>[1mWarning<ESC>[0m[A0127]: unused\n");

  Test::assertEq<str>(replayedReport(&stored, false).toStr(), "Warning[A0127]: unused\n");
  Test::assertEq<str>(replayedReport(&stored, true).toStr(), stored.toStr());
}

function outcomeArtifacts(): BuildArtifacts {
  return BuildArtifacts {
    source: Path::PathBuf::create("out/demo.c"),
    object: Path::PathBuf::create("out/demo.o"),
    executable: Path::PathBuf::create("out/demo"),
  };
}

/// Asserts the closing lines `compileOutcome` picks.
function assertOutcome(
  outcome: CompileOutcome,
  succeeded: boolean,
  text: str,
  artifact: Option<str>
): void {
  Test::assertEq<boolean>(outcome.succeeded, succeeded);
  Test::assertEq<str>(outcome.text.toStr(), text);

  match (artifact) {
    Option::SOME(expected) -> {
      let Option::SOME(actual) = &outcome.artifact else {
        Test::fail();
        return;
      };

      Test::assertEq<str>(actual.toStr(), expected);
    },
    Option::NONE -> Test::assert(outcome.artifact.isNone()),
  };
}

/// A successful build reports how long it took and where its binary is.
@test
function compileOutcomeOfABuildNamesTheBinary(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let timing: String = String::create("1.2s");

  assertOutcome(compileOutcome(false, 0, 2, &timing, &artifacts, true, false), true, "Compiled with 2 warnings (1.2s)", Option::SOME("  Binary: out/demo"));
}

/// A check emits nothing, so it names no artifact.
@test
function compileOutcomeOfACheckNamesNoArtifact(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let timing: String = String::create("75ms");

  assertOutcome(compileOutcome(true, 0, 0, &timing, &artifacts, true, false), true, "No errors found (75ms)", Option::NONE);
}

/// A failed build or check counts what it reported and names no artifact.
@test
function compileOutcomeOfAFailureNamesNoArtifact(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let timing: String = String::create("2.0s");

  assertOutcome(compileOutcome(false, 3, 1, &timing, &artifacts, true, false), false, "Build failed: 3 errors, 1 warning", Option::NONE);
  assertOutcome(compileOutcome(true, 1, 0, &timing, &artifacts, true, false), false, "Check failed: 1 error", Option::NONE);
}

/// A reused build reports `cached` where the duration goes.
@test
function compileOutcomeOfACachedBuildSaysCached(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let cached: String = String::create("cached");

  assertOutcome(compileOutcome(false, 0, 0, &cached, &artifacts, true, false), true, "Compiled (cached)", Option::SOME("  Binary: out/demo"));
}

/// A freestanding library links nothing and names its object instead; a
/// hosted library that emits only C names nothing.
@test
function compileOutcomeOfALibraryNamesItsObject(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let timing: String = String::create("1.0s");

  assertOutcome(compileOutcome(false, 0, 0, &timing, &artifacts, false, true), true, "Compiled (1.0s)", Option::SOME("  Object: out/demo.o"));
  assertOutcome(compileOutcome(false, 0, 0, &timing, &artifacts, false, false), true, "Compiled (1.0s)", Option::NONE);
}

/// Phase lines are printed only under `-v` / `--verbose`.
@test
function statusLineIsShownOnlyWhenVerbose(): void {
  let Option::SOME(shown) = statusLine(String::create("  lex  : ok (0 errors, 0 warnings)"), true) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(shown.toStr(), "  lex  : ok (0 errors, 0 warnings)");
  Test::assert(statusLine(String::create("  lex  : ok (0 errors, 0 warnings)"), false).isNone());
}
