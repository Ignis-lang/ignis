function invalidIndentWidthBag(sourceMap: &mut SourceMap): DiagnosticBag {
  let paths: FormatterConfigPaths = FormatterConfigPaths {
    projectRoot: Path::PathBuf::create("."),
    ignisToml: Option::NONE,
    dedicatedConfig: Option::NONE,
    explicitConfig: Option::NONE,
  };

  let overrides: FormatterCliOverrides = FormatterCliOverrides {
    indentWidth: Option::SOME(0),
    lineWidth: Option::NONE,
    useTabs: Option::NONE,
    sortImports: Option::NONE,
  };

  let Result::ERROR(bag) = Format::Config::load(sourceMap, &paths, &overrides) else {
    Test::fail();
    @unreachable();
  };

  return bag;
}

/// The host CLI prefixes a formatter configuration failure with `formatter
/// configuration failed: `; `printFmtConfigError` used to drop that prefix
/// entirely.
@test
function fmtConfigErrorMessageAddsTheHostsPrefix(): void {
  let mut sourceMap: SourceMap = SourceMap::new();
  let bag: DiagnosticBag = invalidIndentWidthBag(&mut sourceMap);
  let message: String = fmtConfigErrorMessage(&bag);

  Test::assertEq<str>(
    message.toStr(),
    "formatter configuration failed: formatter config '<cli>' has invalid 'indent_width': expected 0 to be within 1..=8"
  );
}

/// The per-file variant additionally prefixes the file path, the way the
/// host CLI's per-file config resolution does.
@test
function fmtConfigErrorMessageForPathAddsThePathAndThePrefix(): void {
  let mut sourceMap: SourceMap = SourceMap::new();
  let bag: DiagnosticBag = invalidIndentWidthBag(&mut sourceMap);
  let path: Path::PathBuf = Path::PathBuf::create("src/main.ign");
  let message: String = fmtConfigErrorMessageForPath(&path, &bag);

  Test::assertEq<str>(
    message.toStr(),
    "src/main.ign: formatter configuration failed: formatter config '<cli>' has invalid 'indent_width': expected 0 to be within 1..=8"
  );
}

/// A raw control byte and an ASCII run are both valid UTF-8: the whole
/// buffer validates in one pass regardless of where `reachedEnd` sits.
@test
function validateUtf8FromAcceptsPlainAsciiBytes(): void {
  let text: String = String::create("hello");
  let Option::SOME(validatedUpTo) = validateUtf8From(&text, 0, true) else {
    Test::fail();
    return;
  };

  Test::assertEq<u64>(validatedUpTo, text.length());
}

/// A complete multi-byte scalar (`é`, `C3 A9`) validates fully once it is
/// entirely present, whether or not more input might still follow.
@test
function validateUtf8FromAcceptsACompleteMultiByteScalar(): void {
  let text: String = String::create("cafe\u{e9}");
  let Option::SOME(validatedUpTo) = validateUtf8From(&text, 0, false) else {
    Test::fail();
    return;
  };

  Test::assertEq<u64>(validatedUpTo, text.length());
}

/// A multi-byte sequence cut short by the end of the bytes read so far is
/// left unvalidated (not an error yet) while more input might still
/// complete it.
@test
function validateUtf8FromLeavesATruncatedSequenceForMoreInput(): void {
  let mut text: String = String::create("a");
  text.pushByte(0xC3);

  let Option::SOME(validatedUpTo) = validateUtf8From(&text, 0, false) else {
    Test::fail();
    return;
  };

  Test::assertEq<u64>(validatedUpTo, 1);
}

/// The same truncated sequence is a genuine error once no more input will
/// arrive (`reachedEnd` true).
@test
function validateUtf8FromRejectsATruncatedSequenceAtTrueEof(): void {
  let mut text: String = String::create("a");
  text.pushByte(0xC3);

  let Option::SOME(_) = validateUtf8From(&text, 0, true) else {
    return;
  };

  Test::fail();
}

/// `0xFF` cannot start any UTF-8 sequence: rejected immediately regardless
/// of `reachedEnd`.
@test
function validateUtf8FromRejectsAnInvalidLeadingByte(): void {
  let mut text: String = String::create("a");
  text.pushByte(0xFF);
  text.pushByte(0xFE);

  let Option::SOME(_) = validateUtf8From(&text, 0, false) else {
    return;
  };

  Test::fail();
}

/// A blank (whitespace-only) line is a valid line: it validates and is
/// skipped, not treated as an error.
@test
function fmtStdinJsonValidateAndProcessLineAcceptsABlankLine(): void {
  let line: String = String::create("   ");
  let config: FormatterConfig = FormatterConfig::default();

  let Option::SOME(result) = fmtStdinJsonValidateAndProcessLine(&line, &config, false) else {
    Test::fail();
    return;
  };

  Test::assertEq<boolean>(result.changed, false);
  Test::assertEq<boolean>(result.hadError, false);
}

/// A line carrying an invalid UTF-8 byte reports the fatal stream-level
/// failure (`Option::NONE`). Validation runs against this line's own bytes
/// only: this is the contract `runFmtStdinJson` relies on to finish printing
/// every earlier complete line's response before a later line's invalid
/// byte aborts the batch, instead of validating the whole growing buffer
/// (and discarding already-buffered valid lines) the moment any invalid
/// byte arrives.
@test
function fmtStdinJsonValidateAndProcessLineRejectsAnInvalidUtf8Byte(): void {
  let mut line: String = String::create("{\"path\":\"a\",\"text\":\"");
  line.pushByte(0xFF);
  line.pushStr("\"}");
  let config: FormatterConfig = FormatterConfig::default();

  let Option::SOME(_) = fmtStdinJsonValidateAndProcessLine(&line, &config, false) else {
    return;
  };

  Test::fail();
}

/// `a/b.ign` sorts before `a-b.ign`: the first path component `a` sorts
/// before the whole second component `a-b.ign`, even though `-` (0x2D)
/// sorts before `/` (0x2F) byte for byte. Matches Rust's `PathBuf`/`Path`
/// `Ord`, which project-mode `fmt` has to reproduce (host reference:
/// `crates/ignis_driver`'s file collection sorts `Vec<PathBuf>` directly).
@test
function comparePathComponentsOrdersASlashBeforeADash(): void {
  let slashPath: String = String::create("a/b.ign");
  let dashPath: String = String::create("a-b.ign");

  Test::assert(comparePathComponents(&slashPath, &dashPath) < 0);
  Test::assert(comparePathComponents(&dashPath, &slashPath) > 0);
}

/// At the second component, `b` (a whole component of `a/b/c.ign`) is a
/// prefix of `b.ign` (a whole component of `a/b.ign`), so the shorter
/// component sorts first — the same rule `comparePathComponentsOrdersASlashBeforeADash`
/// exercises one level up, applied within a single component.
@test
function comparePathComponentsOrdersAShorterComponentFirst(): void {
  let threeComponentPath: String = String::create("a/b/c.ign");
  let twoComponentPath: String = String::create("a/b.ign");

  Test::assert(comparePathComponents(&threeComponentPath, &twoComponentPath) < 0);
}

@test
function comparePathComponentsIsEqualForIdenticalPaths(): void {
  let left: String = String::create("a/b/c.ign");
  let right: String = String::create("a/b/c.ign");

  Test::assertEq<i32>(comparePathComponents(&left, &right), 0);
}

/// `ignis test` links its binary, and writes the C and object files named
/// after it, under the out directory rather than the current directory.
@test
function testBinaryGoesUnderTheOutDirectory(): void {
  let outDir: Path::PathBuf = Path::PathBuf::create("/work/project/build");
  let name: String = String::create("ignis");
  let noOutput: Option<String> = Option::NONE;

  let expected: String = outDir.join("bin").join("ignis-tests").toString();

  Test::assertEq<str>(testBinaryPath(&outDir, &name, &noOutput).toStr(), expected.toStr());
}

/// An explicit `-o` still names the test binary itself.
@test
function testBinaryFollowsAnExplicitOutput(): void {
  let outDir: Path::PathBuf = Path::PathBuf::create("/work/project/build");
  let name: String = String::create("ignis");
  let output: Option<String> = Option::SOME(String::create("build/bootstrap/stage1-tests/ignis-tests"));

  Test::assertEq<str>(testBinaryPath(&outDir, &name, &output).toStr(), "build/bootstrap/stage1-tests/ignis-tests");
}

/// A fresh scratch directory for one test-binary directory test.
function testBinaryScratch(label: str): Path::PathBuf {
  let Result::OK(root) = Fs::tempDir() else {
    Test::fail();
    return Path::PathBuf::new();
  };

  let name: String = `ignis-test-binary-${label}-${Process::id()}`;
  let scratch: Path::PathBuf = root.join(name.toStr());
  let _removed = Fs::removeDirAll(&scratch);

  let Result::OK(_) = Fs::createDirAll(&scratch) else {
    Test::fail();
    return Path::PathBuf::new();
  };

  return scratch;
}

/// A bare `-o name` has no directory to create and links in the current one.
@test
function testBinaryDirectoryAcceptsABareOutputName(): void {
  let bare: String = String::create("mytests");
  Test::assert(prepareTestBinaryDirectory(&bare));
}

/// The default `<out>/bin` does not exist before the first run.
@test
function testBinaryDirectoryIsCreatedUnderANewOutDirectory(): void {
  let scratch: Path::PathBuf = testBinaryScratch("new");
  let binaryPath: String = scratch.join("out").join("bin").join("ignis-tests").toString();

  Test::assert(prepareTestBinaryDirectory(&binaryPath));
  Test::assert(Fs::exists(scratch.join("out").join("bin").asStr()));

  let _removed = Fs::removeDirAll(&scratch);
}

/// A directory that cannot be created, here because a file is in the way,
/// fails the setup instead of failing later in the toolchain.
@test
function testBinaryDirectoryFailsUnderAFile(): void {
  let scratch: Path::PathBuf = testBinaryScratch("file");
  let blocker: Path::PathBuf = scratch.join("out");
  let content: String = String::create("not a directory");

  let Result::OK(_) = Fs::writeString(&blocker, &content) else {
    Test::fail();
    return;
  };

  let binaryPath: String = blocker.join("bin").join("ignis-tests").toString();
  Test::assert(!prepareTestBinaryDirectory(&binaryPath));

  let _removed = Fs::removeDirAll(&scratch);
}

/// Build durations read like the Rust compiler's: milliseconds below one
/// second, tenths of a second below one minute, then minutes and seconds.
@test
function formatBuildDurationPicksTheUnitByMagnitude(): void {
  Test::assertEq<str>(formatBuildDuration(0).toStr(), "0ms");
  Test::assertEq<str>(formatBuildDuration(75).toStr(), "75ms");
  Test::assertEq<str>(formatBuildDuration(999).toStr(), "999ms");
  Test::assertEq<str>(formatBuildDuration(1000).toStr(), "1.0s");
  Test::assertEq<str>(formatBuildDuration(1250).toStr(), "1.2s");
  Test::assertEq<str>(formatBuildDuration(59999).toStr(), "59.9s");
  Test::assertEq<str>(formatBuildDuration(60000).toStr(), "1m00s");
  Test::assertEq<str>(formatBuildDuration(123456).toStr(), "2m03s");
}

/// A failed run counts its errors and warnings with the right noun, and leaves
/// the warnings out when there are none.
@test
function formatFailureLineCountsWithSingularAndPlural(): void {
  Test::assertEq<str>(formatFailureLine("Build", 3, 1).toStr(), "Build failed: 3 errors, 1 warning");
  Test::assertEq<str>(formatFailureLine("Check", 1, 2).toStr(), "Check failed: 1 error, 2 warnings");
  Test::assertEq<str>(formatFailureLine("Build", 2, 0).toStr(), "Build failed: 2 errors");
}

/// A successful run names its warnings only when it has some.
@test
function formatSuccessLineMentionsWarningsOnlyWhenPresent(): void {
  let timing: String = String::create("2m03s");
  let cached: String = String::create("cached");

  Test::assertEq<str>(formatSuccessLine("Compiled", " with ", 0, &timing).toStr(), "Compiled (2m03s)");
  Test::assertEq<str>(formatSuccessLine("Compiled", " with ", 12, &timing).toStr(), "Compiled with 12 warnings (2m03s)");
  Test::assertEq<str>(formatSuccessLine("Compiled", " with ", 1, &cached).toStr(), "Compiled with 1 warning (cached)");
  Test::assertEq<str>(formatSuccessLine("No errors found", ", ", 2, &timing).toStr(), "No errors found, 2 warnings (2m03s)");
}

/// The escape character that starts every ANSI styling sequence.
const ESCAPE_BYTE: u8 = 27;

/// `text` with every `\x1b` replaced by the visible `<ESC>`, so a test can
/// build styled input from plain literals.
function withEscapes(text: str): String {
  let mut result: String = String::new();
  let source: String = String::create(text);
  let marker: String = String::create("<ESC>");
  let mut index: u64 = 0;

  while (index < source.length()) {
    if (source.substringBytes(index, source.length()).startsWith(marker.toStr())) {
      result.pushByte(ESCAPE_BYTE);
      index += marker.length();
      continue;
    }

    if (let Option::SOME(byte) = source.byteAt(index)) {
      result.pushByte(byte);
    }

    index += 1;
  }

  return result;
}

/// Styling sequences are removed and everything between them is kept,
/// multi-byte characters included.
@test
function stripAnsiEscapesKeepsOnlyTheText(): void {
  let styled: String = withEscapes("<ESC>[31m<ESC>[1mError<ESC>[0m[A0001]: café\n  <ESC>[34m<ESC>[1m|<ESC>[0m\n");
  let plain: String = stripAnsiEscapes(&styled);

  Test::assertEq<str>(plain.toStr(), "Error[A0001]: café\n  |\n");
}

/// A warm run replays its stored report with styling on a terminal and as
/// plain text anywhere else.
@test
function replayedReportIsPlainOffATerminal(): void {
  let stored: String = withEscapes("<ESC>[33m<ESC>[1mWarning<ESC>[0m[A0127]: unused\n");

  Test::assertEq<str>(replayedReport(&stored, false).toStr(), "Warning[A0127]: unused\n");
  Test::assertEq<str>(replayedReport(&stored, true).toStr(), stored.toStr());
}

function outcomeArtifacts(): BuildArtifacts {
  return BuildArtifacts {
    source: Path::PathBuf::create("out/demo.c"),
    object: Path::PathBuf::create("out/demo.o"),
    executable: Path::PathBuf::create("out/demo"),
  };
}

/// Asserts the closing lines `compileOutcome` picks.
function assertOutcome(
  outcome: CompileOutcome,
  succeeded: boolean,
  text: str,
  artifact: Option<str>
): void {
  Test::assertEq<boolean>(outcome.succeeded, succeeded);
  Test::assertEq<str>(outcome.text.toStr(), text);

  match (artifact) {
    Option::SOME(expected) -> {
      let Option::SOME(actual) = &outcome.artifact else {
        Test::fail();
        return;
      };

      Test::assertEq<str>(actual.toStr(), expected);
    },
    Option::NONE -> Test::assert(outcome.artifact.isNone()),
  };
}

/// A successful build reports how long it took and where its binary is.
@test
function compileOutcomeOfABuildNamesTheBinary(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let timing: String = String::create("1.2s");

  assertOutcome(compileOutcome(false, 0, 2, &timing, &artifacts, true, false), true, "Compiled with 2 warnings (1.2s)", Option::SOME("  Binary: out/demo"));
}

/// A check emits nothing, so it names no artifact.
@test
function compileOutcomeOfACheckNamesNoArtifact(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let timing: String = String::create("75ms");

  assertOutcome(compileOutcome(true, 0, 0, &timing, &artifacts, true, false), true, "No errors found (75ms)", Option::NONE);
}

/// A failed build or check counts what it reported and names no artifact.
@test
function compileOutcomeOfAFailureNamesNoArtifact(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let timing: String = String::create("2.0s");

  assertOutcome(compileOutcome(false, 3, 1, &timing, &artifacts, true, false), false, "Build failed: 3 errors, 1 warning", Option::NONE);
  assertOutcome(compileOutcome(true, 1, 0, &timing, &artifacts, true, false), false, "Check failed: 1 error", Option::NONE);
}

/// A reused build reports `cached` where the duration goes.
@test
function compileOutcomeOfACachedBuildSaysCached(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let cached: String = String::create("cached");

  assertOutcome(compileOutcome(false, 0, 0, &cached, &artifacts, true, false), true, "Compiled (cached)", Option::SOME("  Binary: out/demo"));
}

/// A freestanding library links nothing and names its object instead; a
/// hosted library that emits only C names nothing.
@test
function compileOutcomeOfALibraryNamesItsObject(): void {
  let artifacts: BuildArtifacts = outcomeArtifacts();
  let timing: String = String::create("1.0s");

  assertOutcome(compileOutcome(false, 0, 0, &timing, &artifacts, false, true), true, "Compiled (1.0s)", Option::SOME("  Object: out/demo.o"));
  assertOutcome(compileOutcome(false, 0, 0, &timing, &artifacts, false, false), true, "Compiled (1.0s)", Option::NONE);
}

/// Phase lines are printed only under `-v` / `--verbose`.
@test
function statusLineIsShownOnlyWhenVerbose(): void {
  let Option::SOME(shown) = statusLine(String::create("  lex  : ok (0 errors, 0 warnings)"), true) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(shown.toStr(), "  lex  : ok (0 errors, 0 warnings)");
  Test::assert(statusLine(String::create("  lex  : ok (0 errors, 0 warnings)"), false).isNone());
}

/// A `std = false` project whose entry and `helper.ign` the caller writes, in a
/// fresh scratch directory. Its `other.ign` exports `other()` for either of
/// them to import.
function parseErrorProject(label: str, entryText: str, helperText: str): Path::PathBuf {
  let root: Path::PathBuf = testBinaryScratch(label);
  let sourceDir: Path::PathBuf = root.join("src");
  let configText: String = String::create("[package]\nname = \"parse-error-location\"\nversion = \"0.1.0\"\n\n[ignis]\nstd = false\n\n[build]\nsource_dir = \"src\"\nentry = \"main.ign\"\n");
  let entry: String = String::create(entryText);
  let helper: String = String::create(helperText);

  let Result::OK(_) = Fs::createDirAll(&sourceDir) else {
    Test::fail();
    return root;
  };

  let configPath: Path::PathBuf = root.join("ignis.toml");
  let entryPath: Path::PathBuf = sourceDir.join("main.ign");
  let helperPath: Path::PathBuf = sourceDir.join("helper.ign");
  let otherPath: Path::PathBuf = sourceDir.join("other.ign");
  let other: String = String::create("export function other(): u64 {\n  return 1;\n}\n");

  let Result::OK(_) = Fs::writeString(&configPath, &configText) else {
    Test::fail();
    return root;
  };

  let Result::OK(_) = Fs::writeString(&entryPath, &entry) else {
    Test::fail();
    return root;
  };

  let Result::OK(_) = Fs::writeString(&helperPath, &helper) else {
    Test::fail();
    return root;
  };

  let Result::OK(_) = Fs::writeString(&otherPath, &other) else {
    Test::fail();
    return root;
  };

  return root;
}

/// What a check of the project at `root` renders, without its styling.
function parseErrorReport(sourceMap: &mut SourceMap, root: &Path::PathBuf): String {
  let overrides: BuildOverrides = BuildOverrides::none();
  let mut discovery: DiscoveryResult = match (Resolver::discover(sourceMap, root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return String::new();
    },
  };
  let file: SourceFile = SourceFile::create(sourceMap, "", "");
  let options: CompileOptions = CompileOptions::build(false);
  let compiled: CompiledProgram = compileDiscovered(sourceMap, &mut discovery, &file, &options);

  Test::assert(compiled.errors > 0);

  return stripAnsiEscapes(&compiled.report);
}

function reportContains(report: &String, needle: str): boolean {
  let marker: String = String::create(needle);
  return report.contains(&marker);
}

/// A parse error in an imported module names that module's file, line and
/// column and shows the offending line, instead of `<project>:1:1` with an
/// empty source line.
@test
function parseErrorInAnImportedModuleNamesItsFileLineAndColumn(): void {
  let mut sourceMap: SourceMap = SourceMap::new();
  let root: Path::PathBuf = parseErrorProject(
    "parse-error-imported",
    "import Helper from \"./helper\";\n\nfunction main(): i32 {\n  return Helper::value() as i32;\n}\n",
    "export namespace Helper {\n  function value(): u64 {\n    let from: u64 = 1;\n\n    return from;\n  }\n}\n",
  );
  let report: String = parseErrorReport(&mut sourceMap, &root);

  Test::assert(reportContains(&report, "src/helper.ign:3:9"));
  Test::assert(reportContains(&report, "let from: u64 = 1;"));
  Test::assert(!reportContains(&report, ":1:1"));

  let _removed = Fs::removeDirAll(&root);
}

/// A module that imports and does not parse reports its own parse errors,
/// and only those: the imports its parse keeps are the ones discovery
/// followed, so mapping them to the module graph cannot fail.
@test
function parseErrorInAnImportingModuleReportsOnlyItsParseErrors(): void {
  let mut sourceMap: SourceMap = SourceMap::new();
  let root: Path::PathBuf = parseErrorProject(
    "parse-error-importing",
    "import Helper from \"./helper\";\n\nfunction main(): i32 {\n  return Helper::value() as i32;\n}\n",
    "import other from \"./other\";\n\nexport namespace Helper {\n  function value(): u64 {\n    let from: u64 = other();\n\n    return from;\n  }\n}\n",
  );
  let overrides: BuildOverrides = BuildOverrides::none();
  let mut discovery: DiscoveryResult = match (Resolver::discover(&mut sourceMap, &root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };
  let file: SourceFile = SourceFile::create(&mut sourceMap, "", "");
  let options: CompileOptions = CompileOptions::build(false);
  let compiled: CompiledProgram = compileDiscovered(&mut sourceMap, &mut discovery, &file, &options);
  let report: String = stripAnsiEscapes(&compiled.report);

  Test::assertEq<u64>(compiled.errors, 2);
  Test::assert(reportContains(&report, "src/helper.ign:5:9"));
  Test::assert(reportContains(&report, "src/helper.ign:7:12"));

  let _removed = Fs::removeDirAll(&root);
}

/// A module that does not parse and imports a module that does not exist
/// reports its parse errors. The missing module is reported once the module
/// parses, since nothing past the parse phase runs before that.
@test
function parseErrorBesideAMissingImportStaysVisible(): void {
  let mut sourceMap: SourceMap = SourceMap::new();
  let root: Path::PathBuf = parseErrorProject(
    "parse-error-missing-import",
    "import Helper from \"./helper\";\n\nfunction main(): i32 {\n  return Helper::value() as i32;\n}\n",
    "import absent from \"./absent\";\n\nexport namespace Helper {\n  function value(): u64 {\n    let from: u64 = absent();\n\n    return from;\n  }\n}\n",
  );
  let overrides: BuildOverrides = BuildOverrides::none();
  let mut discovery: DiscoveryResult = match (Resolver::discover(&mut sourceMap, &root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };
  let file: SourceFile = SourceFile::create(&mut sourceMap, "", "");
  let options: CompileOptions = CompileOptions::build(false);
  let compiled: CompiledProgram = compileDiscovered(&mut sourceMap, &mut discovery, &file, &options);
  let report: String = stripAnsiEscapes(&compiled.report);

  Test::assertEq<u64>(compiled.errors, 2);
  Test::assert(reportContains(&report, "src/helper.ign:5:9"));
  Test::assert(reportContains(&report, "src/helper.ign:7:12"));

  let _removed = Fs::removeDirAll(&root);
}

/// An error in the copy of a trait default another module declares, which
/// only the inheriting type hits, names the trait's file and line, shows the
/// trait's line, and names the type in its note.
@test
function crossModuleDefaultErrorNamesTheTraitsFileAndLine(): void {
  let mut sourceMap: SourceMap = SourceMap::new();
  let root: Path::PathBuf = parseErrorProject(
    "cross-module-default-error",
    "import Shape from \"./helper\";\n\n@implements(Shape)\nrecord Flag {\n  public set: boolean;\n\n  area(&self): boolean {\n    return self.set;\n  }\n}\n\nfunction main(): i32 {\n  let flag: Flag = Flag { set: true };\n  return flag.doubled();\n}\n",
    "export trait Shape {\n  area(&self): i32;\n\n  doubled(&self): i32 {\n    let area: i32 = self.area();\n    return area * 2;\n  }\n}\n",
  );
  let report: String = parseErrorReport(&mut sourceMap, &root);

  Test::assert(reportContains(&report, "src/helper.ign:5:"));
  Test::assert(reportContains(&report, "let area: i32 = self.area();"));
  Test::assert(reportContains(&report, "as inherited by `Flag`"));
  Test::assert(!reportContains(&report, "src/main.ign:5:"));

  let _removed = Fs::removeDirAll(&root);
}

/// A parse error in the entry module names the entry file, line and column.
@test
function parseErrorInTheEntryModuleNamesItsFileLineAndColumn(): void {
  let mut sourceMap: SourceMap = SourceMap::new();
  let root: Path::PathBuf = parseErrorProject(
    "parse-error-entry",
    "function main(): i32 {\n  let from: i32 = 1;\n\n  return from;\n}\n",
    "export function unused(): i32 {\n  return 0;\n}\n",
  );
  let report: String = parseErrorReport(&mut sourceMap, &root);

  Test::assert(reportContains(&report, "src/main.ign:2:7"));
  Test::assert(reportContains(&report, "let from: i32 = 1;"));
  Test::assert(!reportContains(&report, ":1:1"));

  let _removed = Fs::removeDirAll(&root);
}

/// Ownership diagnostics are collected for the whole program, so an
/// inconsistent move in an imported module names that module's file, line and
/// column instead of the entry module's file at the imported module's line.
@test
function ownershipErrorInAnImportedModuleNamesItsFileLineAndColumn(): void {
  let root: Path::PathBuf = parseErrorProject(
    "ownership-error-imported",
    "import Paths from \"./helper\";\n\nfunction main(): i32 {\n  let resolver: Paths::Resolver = Paths::Resolver { depth: 1 };\n  return resolver.run(true) as i32;\n}\n",
    "export namespace Paths {\n  @implements(Drop)\n  record Token {\n    public value: u64;\n  }\n\n  function consume(token: Token): u64 {\n    return token.value;\n  }\n\n  export record Resolver {\n    public depth: u64;\n\n    public run(&self, flag: boolean): u64 {\n      let trimmed: Token = Token { value: 1 };\n      if (flag) {\n        consume(trimmed);\n      }\n      let mut total: u64 = trimmed.value;\n\n      let path: Token = Token { value: 2 };\n      let mut index: u64 = 0;\n      while (index < self.depth) {\n        match (index) {\n          0 -> {\n            total += consume(path);\n          },\n          _ -> {},\n        };\n        index += 1;\n      }\n\n      return total + path.value;\n    }\n  }\n}\n",
  );
  let mut sourceMap: SourceMap = SourceMap::new();
  let report: String = parseErrorReport(&mut sourceMap, &root);

  Test::assert(reportContains(&report, "Variable 'trimmed' is moved in one branch but not the other"));
  Test::assert(reportContains(&report, "src/helper.ign:16:7"));
  Test::assert(reportContains(&report, "src/helper.ign:19:28"));
  Test::assert(reportContains(&report, "Variable 'path' is moved in one branch but not the other"));
  Test::assert(reportContains(&report, "src/helper.ign:24:9"));
  Test::assert(reportContains(&report, "src/helper.ign:33:22"));
  Test::assert(!reportContains(&report, "src/main.ign"));

  let _removed = Fs::removeDirAll(&root);
}

/// The project fixture the target-resolution tests name files inside of.
const TARGET_PROJECT: str = "test_cases/selfhost/build/build_profile";

/// The target `ignis check [path]` resolves, from the repository root.
function checkTarget(path: Option<str>): CommandTarget {
  let mut arguments: Vector<String> = Vector::new<String>();
  arguments.push(String::create("ignis"));
  arguments.push(String::create("check"));

  if (let Option::SOME(text) = path) {
    arguments.push(String::create(text));
  }

  let Result::OK(options) = parseArguments(&arguments) else {
    Test::fail();
    @unreachable();
  };

  let Option::SOME(target) = resolveTarget(&options) else {
    Test::fail();
    @unreachable();
  };

  return target;
}

/// The module graph `target` discovers against this repository's std.
function discoverCheckTarget(target: &CommandTarget): DiscoveryResult {
  let Result::OK(root) = Env::currentDir() else {
    Test::fail();
    @unreachable();
  };

  let mut overrides: BuildOverrides = BuildOverrides::none();
  overrides.stdPath = Option::SOME(root.join("std").toString());

  let mut sourceMap: SourceMap = SourceMap::new();
  let Result::OK(discovery) = discoverTarget(&mut sourceMap, target, &overrides, false) else {
    Test::fail();
    @unreachable();
  };

  return discovery;
}

/// Asserts that `path` names a single-file build of the fixture's entry,
/// which ignores the ignis.toml above it.
function assertSingleFileTarget(path: &String): void {
  let target: CommandTarget = checkTarget(Option::SOME(path.toStr()));
  Test::assertEq<boolean>(target.projectMode, false);

  let discovery: DiscoveryResult = discoverCheckTarget(&target);
  Test::assertEq<boolean>(discovery.hasProjectFile, false);
  Test::assertEq<str>(discovery.name.toStr(), "main");
}

/// An absolute path to a file inside a project is a single-file build.
@test
function absoluteFileInsideAProjectIsASingleFileBuild(): void {
  let Result::OK(root) = Env::currentDir() else {
    Test::fail();
    return;
  };

  let path: String = root.join(TARGET_PROJECT).join("src/main.ign").toString();
  assertSingleFileTarget(&path);
}

/// A relative path to a file inside a project is a single-file build.
@test
function relativeFileInsideAProjectIsASingleFileBuild(): void {
  let path: String = `${TARGET_PROJECT}/src/main.ign`;
  assertSingleFileTarget(&path);
}

/// A relative path that climbs back through `..` is still a single-file build.
@test
function fileThroughParentSegmentIsASingleFileBuild(): void {
  let path: String = `${TARGET_PROJECT}/src/../src/main.ign`;
  assertSingleFileTarget(&path);
}

/// A directory is a build of the project its ignis.toml declares.
@test
function directoryIsAProjectBuild(): void {
  let target: CommandTarget = checkTarget(Option::SOME(TARGET_PROJECT));
  Test::assertEq<boolean>(target.projectMode, true);

  let discovery: DiscoveryResult = discoverCheckTarget(&target);
  Test::assertEq<boolean>(discovery.hasProjectFile, true);
  Test::assertEq<str>(discovery.name.toStr(), "resolver-build-profile");
}

/// No path is a project build of the current directory.
@test
function noPathIsAProjectBuildOfTheCurrentDirectory(): void {
  let Result::OK(root) = Env::currentDir() else {
    Test::fail();
    return;
  };

  let target: CommandTarget = checkTarget(Option::NONE);
  Test::assertEq<boolean>(target.projectMode, true);
  Test::assertEq<str>(target.path.asStr(), root.asStr());
}

// ---------------------------------------------------------------------------
// toolchainLinkLibrariesFor: builtin libraries first and unchanged, then the
// std manifest's [linking.<module>] lib entries for the modules the build's
// graph actually pulls in, deduplicated. A freestanding build links none.
// ---------------------------------------------------------------------------

function linkLibrariesEntry(module: str, name: str): StdManifestLib {
  return StdManifestLib {
    module: String::create(module),
    path: `${module}/mod.ign`,
    name: String::create(name),
  };
}

function linkLibrariesAssertList(actual: &Vector<String>, expected: &Vector<String>): void {
  Test::assertEq<u64>(actual.length(), expected.length());

  let mut index: u64 = 0;

  while (index < expected.length()) {
    let Option::SOME(expectedLib) = expected.get(index) else {
      break;
    };
    let Option::SOME(actualLib) = actual.get(index) else {
      break;
    };

    Test::assertEq<str>(actualLib.toStr(), expectedLib.toStr());
    index += 1;
  }
}

/// A hosted C build without manifest libraries links the two builtins.
@test
function linkLibrariesHostedCBuiltins(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  let mut used: Vector<String> = Vector::new<String>();
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, false);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));

  linkLibrariesAssertList(&libs, &expected);
}

/// QBE's units call libatomic, so the builtin list gains it, last.
@test
function linkLibrariesQbeAddsAtomic(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  let mut used: Vector<String> = Vector::new<String>();
  let backend: String = String::create("qbe");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, false);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));
  expected.push(String::create("atomic"));

  linkLibrariesAssertList(&libs, &expected);
}

/// A freestanding build links no library at all.
@test
function linkLibrariesFreestandingLinksNone(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  let mut used: Vector<String> = Vector::new<String>();
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(true, &backend, &manifestLibs, &used, false);

  Test::assertEq<u64>(libs.length(), 0);
}

/// A manifest module in use contributes its library after the builtins.
@test
function linkLibrariesManifestModuleInUse(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  manifestLibs.push(linkLibrariesEntry("sqlite3", "sqlite3"));

  let mut used: Vector<String> = Vector::new<String>();
  used.push(String::create("sqlite3/mod.ign"));
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, false);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));
  expected.push(String::create("sqlite3"));

  linkLibrariesAssertList(&libs, &expected);
}

/// A submodule of a manifest module counts as using it, so importing
/// `std::sqlite3::statement` alone still pulls the library.
@test
function linkLibrariesManifestSubmoduleInUse(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  manifestLibs.push(linkLibrariesEntry("sqlite3", "sqlite3"));

  let mut used: Vector<String> = Vector::new<String>();
  used.push(String::create("sqlite3/statement.ign"));
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, false);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));
  expected.push(String::create("sqlite3"));

  linkLibrariesAssertList(&libs, &expected);
}

/// A program that does not import the module gains no library.
@test
function linkLibrariesManifestModuleNotUsed(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  manifestLibs.push(linkLibrariesEntry("sqlite3", "sqlite3"));

  let mut used: Vector<String> = Vector::new<String>();
  used.push(String::create("net/tcp.ign"));
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, false);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));

  linkLibrariesAssertList(&libs, &expected);
}

/// Two manifest modules naming the same library link it once.
@test
function linkLibrariesDeduplicatesManifestLibs(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  manifestLibs.push(linkLibrariesEntry("sqlite3", "sqlite3"));
  manifestLibs.push(linkLibrariesEntry("orm", "sqlite3"));

  let mut used: Vector<String> = Vector::new<String>();
  used.push(String::create("sqlite3/mod.ign"));
  used.push(String::create("orm/mod.ign"));
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, false);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));
  expected.push(String::create("sqlite3"));

  linkLibrariesAssertList(&libs, &expected);
}

/// A manifest library the builtins already cover is not linked twice.
@test
function linkLibrariesDeduplicatesAgainstBuiltins(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  manifestLibs.push(linkLibrariesEntry("math", "m"));

  let mut used: Vector<String> = Vector::new<String>();
  used.push(String::create("math/mod.ign"));
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, false);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));

  linkLibrariesAssertList(&libs, &expected);
}

/// A linking section with a header but no lib contributes nothing.
@test
function linkLibrariesSkipsHeaderOnlyModules(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  manifestLibs.push(linkLibrariesEntry("libc", ""));

  let mut used: Vector<String> = Vector::new<String>();
  used.push(String::create("libc/mod.ign"));
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, false);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));

  linkLibrariesAssertList(&libs, &expected);
}

/// A std-archive build links from the monolithic `libignis_std.a`, which
/// defines every module in one object, so every manifest lib applies even
/// though the program's own graph imports none of them.
@test
function linkLibrariesStdArchiveLinksEveryManifestLib(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  manifestLibs.push(linkLibrariesEntry("sqlite3", "sqlite3"));
  manifestLibs.push(linkLibrariesEntry("libc", ""));

  let used: Vector<String> = Vector::new<String>();
  let backend: String = String::create("c");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, true);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));
  expected.push(String::create("sqlite3"));

  linkLibrariesAssertList(&libs, &expected);
}

/// Whole-program std-archive keeps the builtins-first order.
@test
function linkLibrariesStdArchiveKeepsBuiltinsFirst(): void {
  let mut manifestLibs: Vector<StdManifestLib> = Vector::new<StdManifestLib>();
  manifestLibs.push(linkLibrariesEntry("sqlite3", "sqlite3"));

  let mut used: Vector<String> = Vector::new<String>();
  used.push(String::create("sqlite3/mod.ign"));
  let backend: String = String::create("qbe");

  let libs: Vector<String> = toolchainLinkLibrariesFor(false, &backend, &manifestLibs, &used, true);

  let mut expected: Vector<String> = Vector::new<String>();
  expected.push(String::create("m"));
  expected.push(String::create("pthread"));
  expected.push(String::create("atomic"));
  expected.push(String::create("sqlite3"));

  linkLibrariesAssertList(&libs, &expected);
}
