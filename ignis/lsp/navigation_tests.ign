import Env from "std::env";
import Fs from "std::fs";
import Path from "std::path";
import Process from "std::process";
import String from "std::string";
import Test from "std::test";
import Vector from "std::vector";

import SourceOverrides from "../build/sources";

import LspAnalysis, analysisKeyOf, analyzeDocuments from "./analysis";
import definitionOfTarget, isLocalTarget, moduleOfTarget from "./hover_index";
import NameSite, NavigationIndex, SymbolKind from "./navigation";

const NAVIGATION_TEST_UTIL: str = "/// Doubles a value.\nexport function double(value: i32): i32 {\n  return value * 2;\n}\n";

const NAVIGATION_TEST_MAIN: str = "import double from \"./util\";\n\nnamespace Shapes {\n  const LIMIT: i32 = 4;\n\n  function area(side: i32): i32 {\n    return side * side;\n  }\n}\n\nrecord Point {\n  public x: i32;\n  public y: i32;\n\n  public length(&self): i32 {\n    return self.x + self.y;\n  }\n\n  public static origin(): Point {\n    return Point { x: 0, y: 0 };\n  }\n}\n\nenum Mode {\n  FAST,\n  SLOW,\n\n  public static pick(): Mode {\n    return Mode::FAST;\n  }\n\n  public isFast(&self): boolean {\n    return true;\n  }\n}\n\nfunction main(): i32 {\n  let point: Point = Point::origin();\n  let total: i32 = double(point.x) + point.length();\n  let mode: Mode = Mode::pick();\n\n  if (mode.isFast()) {\n    return total + Shapes::area(Shapes::LIMIT);\n  }\n\n  return total;\n}\n";

/// The analyzed fixture: both sources, the path of `main.ign`, and the
/// navigation data.
record NavigationFixture {
  public mainText: String;
  public utilText: String;
  public mainPath: String;
  public navigation: NavigationIndex;
}

/// Writes `main.ign` and `util.ign` into a scratch directory and analyzes
/// them with `main.ign` open.
function navigationFixture(tag: str): NavigationFixture {
  let directory: String = `/tmp/ignis_lsp_navigation_${tag}_${Process::id()}`;
  let root: Path::PathBuf = Path::PathBuf::fromString(&directory);

  if (let Result::ERROR(_) = Fs::createDirAll(&root)) {
    Test::fail();
  }

  let utilText: String = String::create(NAVIGATION_TEST_UTIL);
  let mainText: String = String::create(NAVIGATION_TEST_MAIN);
  let mainPath: Path::PathBuf = root.join("main.ign");
  let utilPath: Path::PathBuf = root.join("util.ign");

  if (let Result::ERROR(_) = Fs::writeString(&utilPath, &utilText)) {
    Test::fail();
  }

  if (let Result::ERROR(_) = Fs::writeString(&mainPath, &mainText)) {
    Test::fail();
  }

  let path: Path::PathBuf = match (Fs::canonicalize(&mainPath)) {
    Result::OK(canonical) -> canonical,
    Result::ERROR(_) -> mainPath,
  };

  let mut sources: SourceOverrides = SourceOverrides::none();
  sources.set(&path, &mainText);

  let Result::OK(workingDirectory) = Env::currentDir() else {
    Test::fail();
    @unreachable();
  };

  let stdPath: Option<String> = Option::SOME(workingDirectory.join("std").toString());
  let key: String = analysisKeyOf(&path);
  let analysis: LspAnalysis = analyzeDocuments(&path, &key, &stdPath, &sources);

  Test::assertEq<u64>(analysis.diagnostics.length(), 0);

  let Option::SOME(navigation) = analysis.navigation else {
    Test::fail();
    @unreachable();
  };

  return NavigationFixture {
    mainText: mainText,
    utilText: utilText,
    mainPath: path.toString(),
    navigation: navigation,
  };
}

/// The byte offset `delta` bytes into the first `needle` of `text`.
function offsetIn(text: &String, needle: str, delta: u64): u64 {
  let wanted: String = String::create(needle);

  let Option::SOME(offset) = text.indexOf(&wanted) else {
    Test::fail();
    return 0;
  };

  return offset + delta;
}

/// The target `delta` bytes into the first `needle` of `main.ign`, or 0.
function targetAt(fixture: &NavigationFixture, needle: str, delta: u64): u64 {
  let Option::SOME(file) = fixture.navigation.fileOf(&fixture.mainPath) else {
    Test::fail();
    return 0;
  };

  return file.targetAtIn(&fixture.mainText, offsetIn(&fixture.mainText, needle, delta)).unwrapOr(0);
}

/// The source text of `start..end` in module `module`.
function textIn(fixture: &NavigationFixture, module: u64, start: u64, end: u64): String {
  let Option::SOME(path) = fixture.navigation.paths.get(module) else {
    return String::create("<no module>");
  };

  if (path.equals(&fixture.mainPath)) {
    return fixture.mainText.substringBytes(start, end);
  }

  if (path.endsWith("util.ign")) {
    return fixture.utilText.substringBytes(start, end);
  }

  return path.clone();
}

/// The whole declaration of the definition at `needle`, as written.
function declarationTextAt(fixture: &NavigationFixture, needle: str, delta: u64): String {
  let Option::SOME(defId) = definitionOfTarget(targetAt(fixture, needle, delta)) else {
    return String::create("<not a definition>");
  };
  let Option::SOME(declaration) = fixture.navigation.declarationOf(defId) else {
    return String::create("<not declared>");
  };

  return textIn(fixture, declaration.module, declaration.start, declaration.end);
}

/// Each site as `text@module-kind`, `main` or `util`, and `*` for the
/// declaration, joined by spaces.
function sitesText(fixture: &NavigationFixture, sites: &Vector<NameSite>): String {
  let mut rendered: String = String::new();
  let mut index: u64 = 0;

  while (index < sites.length()) {
    if (let Option::SOME(site) = sites.get(index)) {
      let text: String = textIn(fixture, site.module, site.start, site.end);
      let isMain: boolean = match (fixture.navigation.paths.get(site.module)) {
        Option::SOME(path) -> path.equals(&fixture.mainPath),
        Option::NONE -> false,
      };

      if (index > 0) {
        rendered.pushStr(" ");
      }

      rendered.push(&text);
      rendered.pushStr(isMain ? "@main" : "@util");

      if (site.isDeclaration) {
        rendered.pushStr("*");
      }
    }

    index += 1;
  }

  return rendered;
}

/// The references to the target at `needle`.
function referencesAt(
  fixture: &NavigationFixture,
  needle: str,
  delta: u64,
  includeDeclaration: boolean
): String {
  let target: u64 = targetAt(fixture, needle, delta);

  let Option::SOME(file) = fixture.navigation.fileOf(&fixture.mainPath) else {
    return String::create("<no file>");
  };

  let sites: Vector<NameSite> = fixture.navigation.referenceSites(file, target, includeDeclaration);
  return sitesText(fixture, &sites);
}

/// A declaration, a member, a method, a qualified path and an imported name
/// each lead to where they are declared, the imported one in its module.
@test
function navigationFindsTheDeclarationOfEachName(): void {
  let fixture: NavigationFixture = navigationFixture("definitions");

  Test::assertEq<str>(declarationTextAt(&fixture, "point.x", 6).toStr(), "x: i32;");
  Test::assertEq<str>(
    declarationTextAt(&fixture, "point.length", 7).toStr(),
    "length(&self): i32 {\n    return self.x + self.y;\n  }",
  );
  Test::assertEq<str>(declarationTextAt(&fixture, "Shapes::LIMIT", 9).toStr(), "const LIMIT: i32 = 4;");
  Test::assertEq<str>(declarationTextAt(&fixture, "Mode::FAST", 7).toStr(), "FAST");
  Test::assertEq<str>(
    declarationTextAt(&fixture, "double(point", 1).toStr(),
    "function double(value: i32): i32 {\n  return value * 2;\n}",
  );
  Test::assertEq<str>(
    declarationTextAt(&fixture, "double from", 0).toStr(),
    "function double(value: i32): i32 {\n  return value * 2;\n}",
  );
}

/// A local leads to its `let` statement, and an import path to its module.
@test
function navigationFindsLocalsAndImportedModules(): void {
  let fixture: NavigationFixture = navigationFixture("locals");
  let local: u64 = targetAt(&fixture, "total +", 1);

  Test::assert(isLocalTarget(local));

  let Option::SOME(file) = fixture.navigation.fileOf(&fixture.mainPath) else {
    Test::fail();
    return;
  };
  let Option::SOME(declaration) = file.localDeclaration(local) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(
    fixture.mainText.substringBytes(declaration.start, declaration.end).toStr(),
    "let total: i32 = double(point.x) + point.length();",
  );

  let Option::SOME(module) = moduleOfTarget(targetAt(&fixture, "\"./util\"", 2)) else {
    Test::fail();
    return;
  };
  let Option::SOME(path) = fixture.navigation.paths.get(module) else {
    Test::fail();
    return;
  };

  Test::assert(path.endsWith("/util.ign"));
  Test::assertEq<u64>(targetAt(&fixture, "  let point", 1), 0);
}

/// References list every name of the target in the project, the
/// declaration first only when it is asked for, a field set by a record
/// literal included.
@test
function navigationListsReferencesAcrossFiles(): void {
  let fixture: NavigationFixture = navigationFixture("references");

  Test::assertEq<str>(
    referencesAt(&fixture, "double(point", 2, true).toStr(),
    "double@main double@main double@util*",
  );
  Test::assertEq<str>(referencesAt(&fixture, "double(point", 2, false).toStr(), "double@main double@main");
  Test::assertEq<str>(referencesAt(&fixture, "point.x", 6, true).toStr(), "x@main* x@main x@main x@main");
  Test::assertEq<str>(referencesAt(&fixture, "point.x", 6, false).toStr(), "x@main x@main x@main");
  Test::assertEq<str>(referencesAt(&fixture, "area(side", 0, true).toStr(), "area@main* area@main");
  Test::assertEq<str>(referencesAt(&fixture, "total: i32", 0, false).toStr(), "total@main total@main");
}

/// The names of the outline symbols of `main.ign` under `parent`, each with
/// its kind and, in brackets, its children.
function outlineText(fixture: &NavigationFixture, parent: u64): String {
  let Option::SOME(module) = fixture.navigation.moduleOf(&fixture.mainPath) else {
    return String::create("<no module>");
  };

  let outline: Vector<u64> = fixture.navigation.outlineOf(module);
  let positions: Vector<u64> = fixture.navigation.outlineChildren(&outline, parent);
  let mut rendered: String = String::new();
  let mut index: u64 = 0;

  while (index < positions.length()) {
    let Option::SOME(position) = positions.get(index) else {
      break;
    };
    let Option::SOME(declaration) = fixture.navigation.declarations.get(*position) else {
      break;
    };

    if (index > 0) {
      rendered.pushStr(" ");
    }

    let kind: u64 = declaration.kind;
    rendered.push(&declaration.name);
    let kindText: String = `:${kind}`;
    rendered.push(&kindText);

    let children: String = outlineText(fixture, *position + 1);

    if (children.length() > 0) {
      let nested: String = `[${children.toStr()}]`;
      rendered.push(&nested);
    }

    index += 1;
  }

  return rendered;
}

/// The outline nests members under their namespace, record or enum, leaves
/// out an enum's instance methods, and uses the host's symbol kinds.
@test
function navigationOutlinesTheDocument(): void {
  let fixture: NavigationFixture = navigationFixture("outline");

  Test::assertEq<str>(
    outlineText(&fixture, 0).toStr(),
    "Shapes:3[LIMIT:14 area:12] Point:23[x:8 y:8 length:6 origin:6] Mode:10[FAST:22 SLOW:22 pick:6] main:12",
  );
  Test::assertEq<u64>(SymbolKind::STRUCT, 23);
}
