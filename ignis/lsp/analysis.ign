//! Front-end analysis of a project or single file for the language server,
//! with open editor buffers standing in for the files on disk.
//!
//! Analysis stops after the analyzer (binding, resolution, typechecking,
//! constant evaluation, checks and lints). Monomorphization, ownership and
//! code generation never run. Every failure this module can see comes back
//! as a diagnostic, so the server loop survives it. A panic
//! inside the front end (`@panic`, `@unreachable` or a failed `unwrap` in the
//! binder, resolver or typechecker) still ends the process: the selfhost has
//! no way to catch one.

import Analyzer from "@compiler::analyzer";
import Ast from "@compiler::ast";
import Config, checkUnknownProjectKeys from "@compiler::config";
import DiagnosticBag, FileId, Severity, SourceFile, SourceMap from "@compiler::diagnostics";
import ParseOutput, Parser from "@compiler::parser";

import Path from "std::path";
import Text from "std::text";
import Toml from "std::toml";

import
  analyzerModuleKind,
  exportSourcesOf,
  mapImportSourcesToDiscoveryTargets,
  copyTraitDefaultsAcrossModules,
  restoreWrittenImportSources,
from "../build/import_targets";
import checkUnknownManifestKeys from "../build/manifest";
import BuildModuleKind, DiscoveredModule, ParseCache, compileFlagsKey from "../build/module_graph";
import BuildOverrides, DiscoveryResult, Resolver from "../build/resolver";
import SourceOverrides from "../build/sources";

import NavigationIndex, buildNavigationIndex from "./navigation";

/// One diagnostic in LSP terms: a UTF-16 range, an LSP severity
/// (1 error, 2 warning, 3 information, 4 hint), the code and the message.
export record LspDiagnostic {
  public start: Text::Position;
  public end: Text::Position;
  public severity: u64;
  public code: String;
  public message: String;
}

/// The diagnostics of one file, which is never empty.
export record FileDiagnostics {
  public path: String;
  public diagnostics: Vector<LspDiagnostic>;
}

/// What one analysis produced: the diagnostics to publish and what hovers
/// and navigation read.
export record LspAnalysis {
  public diagnostics: Vector<FileDiagnostics>;
  /// `NONE` when the analyzer did not run, because discovery or parsing
  /// failed: the server then keeps answering from the last analysis that
  /// did.
  public navigation: Option<NavigationIndex>;
  /// How many modules discovery took from the parse cache instead of parsing
  /// them.
  public reusedModules: u64;
}

/// The code of the diagnostic that reports an analysis stopped between
/// discovery and parsing: the resolver's code for an unreadable module source.
const ANALYSIS_STOPPED_CODE: str = "B2001";

/// A compiler diagnostic reduced to owned data and the index, in the analyzed
/// file list, of the file its byte offsets point into.
record PendingDiagnostic {
  public fileIndex: u64;
  public start: u64;
  public end: u64;
  public severity: u64;
  public code: String;
  public message: String;
}

/// The modules of one analysis, parsed. `files` owns the texts every span
/// points into, so it has to outlive the diagnostics taken from them.
/// `lexDiagnostics`, `parseDiagnostics` and `exportSources` run parallel to
/// `modules`, so that each parse can go back to the parse cache as the parser
/// left it.
record ParsedProgram {
  public files: Vector<SourceFile>;
  public modules: Vector<Ast::Module>;
  public lexDiagnostics: Vector<DiagnosticBag>;
  public parseDiagnostics: Vector<DiagnosticBag>;
  public exportSources: Vector<Vector<String>>;
  public infos: Vector<Analyzer::Imports::ModuleInfo>;
  public pending: Vector<PendingDiagnostic>;
  public frontendErrors: u64;
}

/// The LSP severity of a compiler severity.
export function lspSeverity(severity: Severity): u64 {
  return match (severity) {
    Severity::ERROR -> 1,
    Severity::WARNING -> 2,
    Severity::INFO -> 3,
    Severity::HINT -> 4,
  };
}

/// True when `path` names a project file, `ignis.toml`. Analysis starts from
/// one too, and reads its open buffer for the unknown-key warnings.
export function isProjectFilePath(path: &Path::PathBuf): boolean {
  return match (path.fileName()) {
    Option::SOME(name) -> name.equals("ignis.toml"),
    Option::NONE -> false,
  };
}

/// What identifies the analysis a file belongs to: the `ignis.toml` that
/// governs it, or the file itself when none does. Files with the same key are
/// analyzed together, once per batch of changes.
export function analysisKeyOf(path: &Path::PathBuf): String {
  return match (Config::findProjectFile(path)) {
    Option::SOME(projectFile) -> projectFile.toString(),
    Option::NONE -> path.toString(),
  };
}

/// The number of errors in `bag`.
function countErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    if (let Option::SOME(diagnostic) = bag.get(index)) {
      if (diagnostic.severity == Severity::ERROR) {
        count += 1;
      }
    }

    index += 1;
  }

  return count;
}

/// The index of the file `spanFile` names, or `fallback`.
function fileIndexForSpan(files: &Vector<SourceFile>, spanFile: FileId, fallback: u64): u64 {
  let mut index: u64 = 0;

  while (index < files.length()) {
    if (let Option::SOME(file) = files.get(index) && file.id.equals(&spanFile)) {
      return index;
    }

    index += 1;
  }

  return fallback;
}

/// Appends every diagnostic of `bag`. A diagnostic whose span names another
/// analyzed file is attributed to that file, any other to `fallback`.
function collectBag(
  bag: &DiagnosticBag,
  files: &Vector<SourceFile>,
  fallback: u64,
  pending: &mut Vector<PendingDiagnostic>,
): void {
  let mut pendingRef: &mut Vector<PendingDiagnostic> = pending;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    if (let Option::SOME(diagnostic) = bag.get(index)) {
      pendingRef.push(PendingDiagnostic {
        fileIndex: fileIndexForSpan(files, diagnostic.primarySpan.file, fallback),
        start: diagnostic.primarySpan.start,
        end: diagnostic.primarySpan.end,
        severity: lspSeverity(diagnostic.severity),
        code: String::create(diagnostic.code),
        message: diagnostic.message.clone(),
      });
    }

    index += 1;
  }
}

/// Appends every diagnostic of `bag` at the start of file `fileIndex`,
/// ignoring its spans.
///
/// Module discovery reports failures with spans whose file path it has
/// already freed, so those spans cannot be read.
function collectBagAtFileStart(
  bag: &DiagnosticBag,
  fileIndex: u64,
  pending: &mut Vector<PendingDiagnostic>
): void {
  let mut pendingRef: &mut Vector<PendingDiagnostic> = pending;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    if (let Option::SOME(diagnostic) = bag.get(index)) {
      pendingRef.push(PendingDiagnostic {
        fileIndex: fileIndex,
        start: 0,
        end: 0,
        severity: lspSeverity(diagnostic.severity),
        code: String::create(diagnostic.code),
        message: diagnostic.message.clone(),
      });
    }

    index += 1;
  }
}

function hasPendingFor(pending: &Vector<PendingDiagnostic>, fileIndex: u64): boolean {
  let mut index: u64 = 0;

  while (index < pending.length()) {
    if (let Option::SOME(entry) = pending.get(index)) {
      if (entry.fileIndex == fileIndex) {
        return true;
      }
    }

    index += 1;
  }

  return false;
}

/// Converts byte offsets to UTF-16 positions and groups the diagnostics by
/// file, in file order. Each file is indexed once.
function convertPending(
  pending: &Vector<PendingDiagnostic>,
  files: &Vector<SourceFile>
): Vector<FileDiagnostics> {
  let mut result: Vector<FileDiagnostics> = Vector::new<FileDiagnostics>();
  let mut fileIndex: u64 = 0;

  while (fileIndex < files.length()) {
    let Option::SOME(file) = files.get(fileIndex) else {
      break;
    };

    if (!hasPendingFor(pending, fileIndex)) {
      fileIndex += 1;
      continue;
    }

    let lineIndex: Text::LineIndex = Text::LineIndex::create(file.text.clone());
    let mut diagnostics: Vector<LspDiagnostic> = Vector::new<LspDiagnostic>();
    let mut pendingIndex: u64 = 0;

    while (pendingIndex < pending.length()) {
      if (let Option::SOME(entry) = pending.get(pendingIndex)) {
        if (entry.fileIndex == fileIndex) {
          diagnostics.push(LspDiagnostic {
            start: lineIndex.position(entry.start),
            end: lineIndex.position(entry.end),
            severity: entry.severity,
            code: entry.code.clone(),
            message: entry.message.clone(),
          });
        }
      }

      pendingIndex += 1;
    }

    result.push(FileDiagnostics { path: file.path.toString(), diagnostics: diagnostics });
    fileIndex += 1;
  }

  return result;
}

/// Takes discovery's parse of every module it ordered, which read open
/// buffers instead of the disk, and collects their lexer and parser
/// diagnostics. A module whose parse was already taken is read through
/// `sources` and parsed again.
///
/// Returns an error message when the modules no longer match what discovery
/// saw, which means a file changed on disk in between.
function parseDiscoveredModules(
  sourceMap: &mut SourceMap,
  discovery: &mut DiscoveryResult,
  sources: &SourceOverrides,
): Result<ParsedProgram, String> {
  let mut program: ParsedProgram = ParsedProgram {
    files: Vector::new<SourceFile>(),
    modules: Vector::new<Ast::Module>(),
    lexDiagnostics: Vector::new<DiagnosticBag>(),
    parseDiagnostics: Vector::new<DiagnosticBag>(),
    exportSources: Vector::new<Vector<String>>(),
    infos: Vector::new<Analyzer::Imports::ModuleInfo>(),
    pending: Vector::new<PendingDiagnostic>(),
    frontendErrors: 0,
  };
  let mut orderIndex: u64 = 0;

  while (orderIndex < discovery.order.length()) {
    let mut nodeIndex: u64 = 0;
    let mut nodePath: Path::PathBuf = Path::PathBuf::new();
    let mut nodeKind: BuildModuleKind = BuildModuleKind::PROJECT;

    // Scoped, so that no borrow of `discovery` is held when the parse is taken.
    {
      let Option::SOME(nodeIndexRef) = discovery.order.get(orderIndex) else {
        return Result::ERROR(String::create("discovery order is incomplete"));
      };
      let Option::SOME(node) = discovery.graph.nodes.get(*nodeIndexRef) else {
        return Result::ERROR(String::create("discovery order references a missing module"));
      };

      nodeIndex = *nodeIndexRef;
      nodePath = node.path.clone();
      nodeKind = node.kind;
    }

    let Option::SOME(parsed) = Resolver::takeParsedModule(sourceMap, discovery, nodeIndex, sources) else {
      return Result::ERROR(`cannot read source file: ${nodePath.toString().toStr()}`);
    };

    let fileIndex: u64 = program.files.length();
    program.files.push(parsed.file);

    let mut output: ParseOutput = parsed.output;

    program.frontendErrors += countErrors(&output.lexDiagnostics) + countErrors(&output.parseDiagnostics);
    collectBag(&output.lexDiagnostics, &program.files, fileIndex, &mut program.pending);
    collectBag(&output.parseDiagnostics, &program.files, fileIndex, &mut program.pending);

    let moduleParses: boolean = output.lexDiagnostics.isEmpty() && output.parseDiagnostics.isEmpty();
    program.exportSources.push(exportSourcesOf(&output.module));

    if (moduleParses && !mapImportSourcesToDiscoveryTargets(&mut output.module, &discovery.graph, nodeIndex)) {
      return Result::ERROR(`import mapping is incomplete for ${nodePath.toString().toStr()}`);
    }

    program.modules.push(output.module);
    program.lexDiagnostics.push(output.lexDiagnostics);
    program.parseDiagnostics.push(output.parseDiagnostics);
    program.infos.push(Analyzer::Imports::ModuleInfo {
      index: nodeIndex,
      pathText: nodePath.toString(),
      kind: analyzerModuleKind(nodeKind),
    });
    orderIndex += 1;
  }

  return Result::OK(program);
}

/// Runs the analyzer over parsed modules, collects its diagnostics, and
/// builds the navigation data, with hover texts for every module `sources`
/// holds an open buffer for.
function analyzeParsedModules(
  discovery: &DiscoveryResult,
  program: &mut ParsedProgram,
  sources: &SourceOverrides,
): NavigationIndex {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut preludePaths: Vector<String> = Vector::new<String>();
  let mut preludeIndex: u64 = 0;

  while (preludeIndex < discovery.preludePaths.length()) {
    if (let Option::SOME(preludePath) = discovery.preludePaths.get(preludeIndex)) {
      preludePaths.push(preludePath.toString());
    }

    preludeIndex += 1;
  }

  copyTraitDefaultsAcrossModules(&mut program.modules, &program.infos, &preludePaths);

  let records: Vector<Analyzer::ModuleAnalysisRecord> = Analyzer::analyzeProgram(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &program.modules,
    &program.infos,
    &preludePaths,
  );

  let mut recordIndex: u64 = 0;

  while (recordIndex < records.length()) {
    if (let Option::SOME(analysisRecord) = records.get(recordIndex)) {
      collectBag(&analysisRecord.output.diagnostics, &program.files, recordIndex, &mut program.pending);
    }

    recordIndex += 1;
  }

  let mut openPaths: Vector<String> = Vector::new<String>();
  let mut sourceIndex: u64 = 0;

  while (sourceIndex < sources.length()) {
    if (let Option::SOME(path) = sources.pathAt(sourceIndex)) {
      openPaths.push(path.toString());
    }

    sourceIndex += 1;
  }

  return buildNavigationIndex(&program.files, &program.modules, &records, &openPaths, &defStore, &typeStore, &symbols);
}

/// True when `candidate` holds exactly the diagnostics of `failure`, in the
/// same order: same code, message and byte range. The spans' file paths are
/// not compared, because discovery's may already be freed.
function sameDiagnostics(candidate: &DiagnosticBag, failure: &DiagnosticBag): boolean {
  if (failure.length() == 0 || candidate.length() != failure.length()) {
    return false;
  }

  let mut index: u64 = 0;

  while (index < failure.length()) {
    let Option::SOME(expected) = failure.get(index) else {
      return false;
    };
    let Option::SOME(actual) = candidate.get(index) else {
      return false;
    };

    let expectedCode: String = String::create(expected.code);

    if (!expectedCode.equals(actual.code) || !expected.message.equals(&actual.message)) {
      return false;
    }

    if (expected.primarySpan.start != actual.primarySpan.start || expected.primarySpan.end != actual.primarySpan.end) {
      return false;
    }

    index += 1;
  }

  return true;
}

/// Parses file `fileIndex` the way discovery does, appends its lexer and
/// parser diagnostics when `always` is set or when they are the ones
/// discovery failed with, and tells whether they are.
function collectIfDiscoveryFailure(
  files: &Vector<SourceFile>,
  fileIndex: u64,
  failure: &DiagnosticBag,
  always: boolean,
  pending: &mut Vector<PendingDiagnostic>,
): boolean {
  let Option::SOME(file) = files.get(fileIndex) else {
    return false;
  };

  let mut module: Ast::Module = Ast::Module::init();
  let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
  Parser::parseInto(file, &mut module, &mut diagnostics);

  let isFailure: boolean = sameDiagnostics(&diagnostics, failure);

  if (always || isFailure) {
    collectBag(&diagnostics, files, fileIndex, pending);
  }

  return isFailure;
}

/// The diagnostics to publish when module discovery failed.
///
/// Discovery stops at the first file it cannot parse, and its diagnostics
/// cannot be placed (see `collectBagAtFileStart`). So the start file and the
/// other open buffers of this analysis are parsed again here. The start
/// file's lexer and parser diagnostics are always reported. Another buffer's
/// are reported only when they are exactly what discovery failed with, which
/// means discovery reached that buffer. When no buffer accounts for the
/// failure (a missing module, an import cycle, an unreadable project file or
/// a file on disk that does not parse), discovery's diagnostics are reported
/// at the start of the start file.
function discoveryFailureDiagnostics(
  sourceMap: &mut SourceMap,
  failure: &DiagnosticBag,
  startPath: &Path::PathBuf,
  key: &String,
  sources: &SourceOverrides,
): Vector<FileDiagnostics> {
  let startText: String = match (sources.read(startPath)) {
    Result::OK(text) -> text,
    Result::ERROR(_) -> String::new(),
  };

  let mut files: Vector<SourceFile> = Vector::new<SourceFile>();
  let mut pending: Vector<PendingDiagnostic> = Vector::new<PendingDiagnostic>();
  files.push(SourceFile::fromPath(sourceMap, startPath.clone(), startText));

  // A project file is not Ignis source: parsing it would only add noise, so
  // discovery's diagnostics go to its start.
  let mut located: boolean = false;

  if (!isProjectFilePath(startPath)) {
    located = collectIfDiscoveryFailure(&files, 0, failure, true, &mut pending);
  }

  let startKey: String = startPath.toString();
  let mut sourceIndex: u64 = 0;

  while (!located && sourceIndex < sources.length()) {
    let Option::SOME(path) = sources.pathAt(sourceIndex) else {
      break;
    };

    sourceIndex += 1;

    let pathText: String = path.toString();
    let pathKey: String = analysisKeyOf(&path);

    if (pathText.equals(&startKey) || !pathKey.equals(key) || isProjectFilePath(&path)) {
      continue;
    }

    let Result::OK(text) = sources.read(&path) else {
      continue;
    };

    let fileIndex: u64 = files.length();
    files.push(SourceFile::fromPath(sourceMap, path, text));
    located = collectIfDiscoveryFailure(&files, fileIndex, failure, false, &mut pending);
  }

  if (!located) {
    collectBagAtFileStart(failure, 0, &mut pending);
  }

  return convertPending(&pending, &files);
}

/// The diagnostic published, on the start file, when the modules discovery
/// found could not be parsed as it found them.
function analysisStoppedDiagnostics(
  startPath: &Path::PathBuf,
  message: &String
): Vector<FileDiagnostics> {
  let mut diagnostics: Vector<LspDiagnostic> = Vector::new<LspDiagnostic>();
  diagnostics.push(LspDiagnostic {
    start: Text::Position { line: 0, character: 0 },
    end: Text::Position { line: 0, character: 0 },
    severity: 1,
    code: String::create(ANALYSIS_STOPPED_CODE),
    message: `analysis stopped: ${message.toStr()}`,
  });

  let mut result: Vector<FileDiagnostics> = Vector::new<FileDiagnostics>();
  result.push(FileDiagnostics { path: startPath.toString(), diagnostics: diagnostics });
  return result;
}

/// Analyzes the project or single file `startPath` belongs to and returns
/// the diagnostics of every file that has any.
///
/// `key` is `analysisKeyOf(startPath)`. `stdPath` overrides the standard
/// library root the way `--std-path` does. `sources` holds the open buffers.
export function analyzeForDiagnostics(
  startPath: &Path::PathBuf,
  key: &String,
  stdPath: &Option<String>,
  sources: &SourceOverrides,
): Vector<FileDiagnostics> {
  return analyzeDocuments(startPath, key, stdPath, sources).diagnostics;
}

/// Analyzes like `analyzeForDiagnostics` and also returns what hovers and
/// navigation read.
export function analyzeDocuments(
  startPath: &Path::PathBuf,
  key: &String,
  stdPath: &Option<String>,
  sources: &SourceOverrides,
): LspAnalysis {
  let mut sourceMap: SourceMap = SourceMap::new();
  let mut cache: ParseCache = ParseCache::empty();
  return analyzeDocumentsCached(&mut sourceMap, startPath, key, stdPath, sources, &mut cache);
}

/// Analyzes like `analyzeDocuments`, reusing the parse `cache` holds of every
/// module whose text and compile flags did not change. Afterwards `cache`
/// holds the parses of exactly the modules this analysis read, so a file it no
/// longer reaches drops out. `sourceMap` registers the paths the spans of
/// the parses name, so it has to be the map every earlier analysis that
/// filled `cache` used.
export function analyzeDocumentsCached(
  sourceMap: &mut SourceMap,
  startPath: &Path::PathBuf,
  key: &String,
  stdPath: &Option<String>,
  sources: &SourceOverrides,
  cache: &mut ParseCache,
): LspAnalysis {
  let mut overrides: BuildOverrides = BuildOverrides::none();
  overrides.sources = sources.clone();

  if (let Option::SOME(value) = stdPath) {
    overrides.stdPath = Option::SOME(value.clone());
  }

  let mut discovery: DiscoveryResult = match (Resolver::discoverCached(sourceMap, startPath, &overrides, false, cache)) {
    Result::OK(value) -> value,
    Result::ERROR(failure) -> {
      let mut diagnostics: Vector<FileDiagnostics> = discoveryFailureDiagnostics(sourceMap, &failure, startPath, key, sources);
      appendProjectFileWarnings(sourceMap, startPath, sources, &mut diagnostics);

      return LspAnalysis { diagnostics: diagnostics, navigation: Option::NONE, reusedModules: 0 };
    },
  };

  let mut analysis: LspAnalysis = analyzeDiscoveredDocuments(sourceMap, &mut discovery, startPath, sources, cache);
  appendProjectFileWarnings(sourceMap, startPath, sources, &mut analysis.diagnostics);
  appendStdManifestWarnings(sourceMap, &discovery.stdRoot, &mut analysis.diagnostics);

  return analysis;
}

/// Appends the unknown-key warnings of `manifest.toml` under `stdRoot`.
///
/// Every analysis that reaches the standard library loads this manifest, the
/// build prints its warnings to stderr the same way, so they appear in every
/// workspace, not only while the standard library itself is being edited. The
/// manifest is read from disk: editing it does not start an analysis, so an
/// open buffer of it would only be read when some Ignis file changes.
function appendStdManifestWarnings(
  sourceMap: &mut SourceMap,
  stdRoot: &Path::PathBuf,
  files: &mut Vector<FileDiagnostics>
): void {
  let manifestPath: Path::PathBuf = stdRoot.join("manifest.toml");

  let Result::OK(manifestText) = Fs::readToString(&manifestPath) else {
    return;
  };

  let warnings: DiagnosticBag = checkUnknownManifestKeys(sourceMap, &manifestText, &manifestPath);
  appendTextDiagnostics(&warnings, &manifestPath, &manifestText, files);
}

/// Appends the unknown-key warnings of the project file that governs
/// `startPath`, read from its open buffer when there is one. The build prints
/// them to stderr, which an editor never shows, so the language server
/// reports them on the project file itself. A project file that does not
/// parse has no warnings here: discovery already reports it as an error.
function appendProjectFileWarnings(
  sourceMap: &mut SourceMap,
  startPath: &Path::PathBuf,
  sources: &SourceOverrides,
  files: &mut Vector<FileDiagnostics>,
): void {
  let Option::SOME(projectFile) = Config::findProjectFile(startPath) else {
    return;
  };

  let Result::OK(text) = sources.read(&projectFile) else {
    return;
  };

  let Result::OK(document) = Toml::parse(&text) else {
    return;
  };

  let warnings: DiagnosticBag = checkUnknownProjectKeys(sourceMap, &document, &projectFile);
  appendTextDiagnostics(&warnings, &projectFile, &text, files);
}

/// Appends every diagnostic of `bag`, whose byte offsets point into `text`, to
/// the diagnostics of `path`, creating that entry when `files` has none yet.
function appendTextDiagnostics(
  bag: &DiagnosticBag,
  path: &Path::PathBuf,
  text: &String,
  files: &mut Vector<FileDiagnostics>,
): void {
  if (bag.isEmpty()) {
    return;
  }

  let mut filesRef: &mut Vector<FileDiagnostics> = files;
  let pathText: String = path.toString();
  let mut target: u64 = filesRef.length();
  let mut fileIndex: u64 = 0;

  while (fileIndex < filesRef.length()) {
    if (let Option::SOME(file) = filesRef.get(fileIndex)) {
      if (file.path.equals(&pathText)) {
        target = fileIndex;
        break;
      }
    }

    fileIndex += 1;
  }

  if (target == filesRef.length()) {
    filesRef.push(FileDiagnostics { path: pathText.clone(), diagnostics: Vector::new<LspDiagnostic>() });
  }

  let lineIndex: Text::LineIndex = Text::LineIndex::create(text.clone());
  let mut index: u64 = 0;

  while (index < bag.length()) {
    if (let Option::SOME(diagnostic) = bag.get(index)) {
      if (let Option::SOME(file) = filesRef.getMut(target)) {
        file.diagnostics.push(LspDiagnostic {
          start: lineIndex.position(diagnostic.primarySpan.start),
          end: lineIndex.position(diagnostic.primarySpan.end),
          severity: lspSeverity(diagnostic.severity),
          code: String::create(diagnostic.code),
          message: diagnostic.message.clone(),
        });
      }
    }

    index += 1;
  }
}

/// Parses and analyzes the modules `discovery` found, reading `sources`
/// instead of the disk, and returns the diagnostics of every file that has
/// any. When the modules no longer match what discovery saw, the result is
/// one error on `startPath` that says why. `sourceMap` is the map discovery
/// registered its paths in.
export function analyzeDiscovered(
  sourceMap: &mut SourceMap,
  discovery: &mut DiscoveryResult,
  startPath: &Path::PathBuf,
  sources: &SourceOverrides,
): Vector<FileDiagnostics> {
  let mut cache: ParseCache = ParseCache::empty();
  return analyzeDiscoveredDocuments(sourceMap, discovery, startPath, sources, &mut cache).diagnostics;
}

/// Analyzes the modules `discovery` found and moves their parses into
/// `cache`, with the import sources they were written with.
function analyzeDiscoveredDocuments(
  sourceMap: &mut SourceMap,
  discovery: &mut DiscoveryResult,
  startPath: &Path::PathBuf,
  sources: &SourceOverrides,
  cache: &mut ParseCache,
): LspAnalysis {
  let reusedModules: u64 = discovery.graph.reusedModules;
  let mut program: ParsedProgram = match (parseDiscoveredModules(sourceMap, discovery, sources)) {
    Result::OK(value) -> value,
    Result::ERROR(message) -> {
      return LspAnalysis {
        diagnostics: analysisStoppedDiagnostics(startPath, &message),
        navigation: Option::NONE,
        reusedModules: reusedModules,
      };
    },
  };

  let mut navigation: Option<NavigationIndex> = Option::NONE;

  if (program.frontendErrors == 0) {
    navigation = Option::SOME(analyzeParsedModules(&*discovery, &mut program, sources));
  }

  let diagnostics: Vector<FileDiagnostics> = convertPending(&program.pending, &program.files);
  let flagsKey: String = compileFlagsKey(&discovery.flags);
  returnParsesToCache(program, cache, &flagsKey);

  return LspAnalysis {
    diagnostics: diagnostics,
    navigation: navigation,
    reusedModules: reusedModules,
  };
}

/// Moves every parse of `program` into `cache`, each module's import sources
/// restored to the written ones. Nothing the analysis returns borrows from
/// `program`: its diagnostics and navigation data own their texts.
function returnParsesToCache(
  program: ParsedProgram,
  cache: &mut ParseCache,
  flagsKey: &String
): void {
  let mut cacheRef: &mut ParseCache = cache;
  let mut parsedProgram: ParsedProgram = program;

  while (let Option::SOME(file) = parsedProgram.files.pop()) {
    let Option::SOME(analyzedModule) = parsedProgram.modules.pop() else {
      return;
    };
    let Option::SOME(lexDiagnostics) = parsedProgram.lexDiagnostics.pop() else {
      return;
    };
    let Option::SOME(parseDiagnostics) = parsedProgram.parseDiagnostics.pop() else {
      return;
    };
    let Option::SOME(exportSources) = parsedProgram.exportSources.pop() else {
      return;
    };

    // A parse that holds copies of another module's trait defaults is not
    // what its own text alone parses to, so the next analysis parses it again.
    if (analyzedModule.crossModuleSources.length() > 0) {
      continue;
    }

    let mut module: Ast::Module = analyzedModule;
    restoreWrittenImportSources(&mut module, &exportSources);
    cacheRef.insert(
      DiscoveredModule {
        file: file,
        output: ParseOutput { module: module, lexDiagnostics: lexDiagnostics, parseDiagnostics: parseDiagnostics },
      },
      flagsKey,
    );
  }
}
