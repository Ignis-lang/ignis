//! `ignis lsp`: a sequential Language Server Protocol server over stdio that
//! publishes diagnostics and answers hovers, go-to-definition,
//! find-references and document symbols.
//!
//! Messages are handled one at a time, in arrival order. Document changes
//! only mark their analysis dirty. The analysis runs once no bytes of a
//! further message are buffered, so a burst of changes that arrived together
//! costs one analysis. Without `poll(2)` in the standard library the server
//! cannot see bytes the kernel holds but has not handed over yet, so a burst
//! split across two reads can cost two analyses.

import JsonObjectEntry, JsonValue, JsonValueKind from "std::json";
import Io, Stream from "std::io";
import LibC from "std::libc";
import Path from "std::path";
import String from "std::string";
import Text from "std::text";
import Vector from "std::vector";

import SourceOverrides from "../build/sources";

import
  FileDiagnostics,
  LspAnalysis,
  LspDiagnostic,
  analysisKeyOf,
  analyzeDocuments,
from "./analysis";
import Document, DocumentHandle, DocumentStore, isIgnisSourcePath from "./documents";
import
  ByteRange,
  FileHoverIndex,
  HoverHit,
  TextEdit,
  definitionOfTarget,
  isLocalTarget,
  moduleOfTarget,
from "./hover_index";
import DeclarationSite, NameSite, NavigationIndex from "./navigation";
import
  DecodeError,
  LspErrorCode,
  LspMessage,
  LspNotification,
  LspRequest,
  RequestId,
  decodeMessage,
  errorResponseBody,
  initializeResult,
  jsonIntegerMember,
  jsonMember,
  jsonStringMember,
  notificationBody,
  responseBody,
from "./protocol";
import uriFromFilePath from "./uri";

/// Largest message body the server reads, 64 MiB. A longer one is skipped
/// without being buffered and answered with an error.
export const LSP_MAX_MESSAGE_BYTES: u64 = 67108864;

/// Where the server is in the protocol lifecycle.
export enum LspPhase {
  /// Before `initialize`: every other request is refused.
  WAITING,
  /// Between `initialize` and `shutdown`.
  RUNNING,
  /// After `shutdown`: only `exit` has an effect.
  SHUT_DOWN,
}

/// The URIs one analysis last published non-empty diagnostics for, so the
/// next run of the same analysis can clear the ones that are clean now.
record PublishedSet {
  public key: String;
  public uris: Vector<String>;
}

/// The navigation data of the last analysis of `key` that reached the
/// analyzer.
record NavigationSet {
  public key: String;
  public index: NavigationIndex;
}

/// The document and position a request names.
record PositionRequest {
  public uri: String;
  public position: Text::Position;
}

/// A file's text as the client has it, to turn byte ranges of the text it
/// was analyzed from into LSP ranges.
record FileView {
  public uri: String;
  public current: String;
  public edit: TextEdit;
  public lineIndex: Text::LineIndex;
}

/// What handling one message asks the loop to do next.
export enum LspStep {
  CONTINUE,
  /// `exit` arrived: stop with this process exit code.
  EXIT(i32),
}

/// One diagnostic in its LSP JSON form.
function diagnosticJson(diagnostic: &LspDiagnostic): JsonValue {
  let mut start: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  start.push(JsonObjectEntry::create("line", JsonValue::unsignedValue(diagnostic.start.line)));
  start.push(JsonObjectEntry::create("character", JsonValue::unsignedValue(diagnostic.start.character)));

  let mut end: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  end.push(JsonObjectEntry::create("line", JsonValue::unsignedValue(diagnostic.end.line)));
  end.push(JsonObjectEntry::create("character", JsonValue::unsignedValue(diagnostic.end.character)));

  let mut range: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  range.push(JsonObjectEntry::create("start", JsonValue::object(start)));
  range.push(JsonObjectEntry::create("end", JsonValue::object(end)));

  let mut entries: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  entries.push(JsonObjectEntry::create("range", JsonValue::object(range)));
  entries.push(JsonObjectEntry::create("severity", JsonValue::unsignedValue(diagnostic.severity)));
  entries.push(JsonObjectEntry::create("code", JsonValue::fromString(diagnostic.code.clone())));
  entries.push(JsonObjectEntry::create("source", JsonValue::stringValue("ignis")));
  entries.push(JsonObjectEntry::create("message", JsonValue::fromString(diagnostic.message.clone())));
  return JsonValue::object(entries);
}

/// The params of a `textDocument/publishDiagnostics` notification.
export function publishDiagnosticsParams(
  uri: &String,
  diagnostics: &Vector<LspDiagnostic>,
  version: Option<i64>,
): JsonValue {
  let mut items: Vector<JsonValue> = Vector::new<JsonValue>();
  let mut index: u64 = 0;

  while (index < diagnostics.length()) {
    if (let Option::SOME(diagnostic) = diagnostics.get(index)) {
      items.push(diagnosticJson(diagnostic));
    }

    index += 1;
  }

  let mut entries: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  entries.push(JsonObjectEntry::create("uri", JsonValue::fromString(uri.clone())));
  entries.push(JsonObjectEntry::create("diagnostics", JsonValue::array(items)));

  if (let Option::SOME(value) = version) {
    entries.push(JsonObjectEntry::create("version", JsonValue::integerValue(value)));
  }

  return JsonValue::object(entries);
}

/// A position in its LSP JSON form.
function positionJson(position: Text::Position): JsonValue {
  let mut entries: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  entries.push(JsonObjectEntry::create("line", JsonValue::unsignedValue(position.line)));
  entries.push(JsonObjectEntry::create("character", JsonValue::unsignedValue(position.character)));
  return JsonValue::object(entries);
}

/// A range in its LSP JSON form.
function rangeJson(start: Text::Position, end: Text::Position): JsonValue {
  let mut range: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  range.push(JsonObjectEntry::create("start", positionJson(start)));
  range.push(JsonObjectEntry::create("end", positionJson(end)));
  return JsonValue::object(range);
}

/// A `Location`: a URI and a range in it.
function locationJson(uri: String, range: JsonValue): JsonValue {
  let mut entries: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  entries.push(JsonObjectEntry::create("uri", JsonValue::fromString(uri)));
  entries.push(JsonObjectEntry::create("range", range));
  return JsonValue::object(entries);
}

/// A `Hover` result: the markdown and the range it describes, the shape the
/// host answers with (crates/ignis_lsp/src/server.rs:2596).
export function hoverResult(hit: &HoverHit, lineIndex: &Text::LineIndex): JsonValue {
  let mut contents: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  contents.push(JsonObjectEntry::create("kind", JsonValue::stringValue("markdown")));
  contents.push(JsonObjectEntry::create("value", JsonValue::fromString(hit.text.clone())));

  let mut entries: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  entries.push(JsonObjectEntry::create("contents", JsonValue::object(contents)));
  entries.push(JsonObjectEntry::create("range", rangeJson(lineIndex.position(hit.start), lineIndex.position(hit.end))));
  return JsonValue::object(entries);
}

/// The document and position of a `TextDocumentPositionParams` request.
function positionRequestOf(message: &JsonValue): Option<PositionRequest> {
  let Option::SOME(params) = jsonMember(message, "params") else {
    return Option::NONE;
  };
  let Option::SOME(textDocument) = jsonMember(params, "textDocument") else {
    return Option::NONE;
  };
  let Option::SOME(uri) = jsonStringMember(textDocument, "uri") else {
    return Option::NONE;
  };
  let Option::SOME(position) = jsonMember(params, "position") else {
    return Option::NONE;
  };

  let line: i64 = jsonIntegerMember(position, "line").unwrapOr(-1);
  let character: i64 = jsonIntegerMember(position, "character").unwrapOr(-1);

  if (line < 0 || character < 0) {
    return Option::NONE;
  }

  return Option::SOME(PositionRequest {
    uri: uri,
    position: Text::Position { line: line as u64, character: character as u64 },
  });
}

/// `context.includeDeclaration` of a references request, false when absent.
function includesDeclaration(message: &JsonValue): boolean {
  let Option::SOME(params) = jsonMember(message, "params") else {
    return false;
  };
  let Option::SOME(context) = jsonMember(params, "context") else {
    return false;
  };
  let Option::SOME(flag) = jsonMember(context, "includeDeclaration") else {
    return false;
  };

  return match (&flag.kind) {
    JsonValueKind::BOOL(value) -> value,
    _ -> false,
  };
}

/// The LSP range of `start..end` in `view`. A name has to still read the same
/// there; any other range only has to keep both ends out of the edited
/// region.
function viewRange(
  view: &FileView,
  file: &FileHoverIndex,
  start: u64,
  end: u64,
  isName: boolean
): Option<JsonValue> {
  let mut current: Option<ByteRange> = Option::NONE;

  if (isName) {
    current = file.currentNameRange(&view.current, &view.edit, start, end);
  } else {
    current = view.edit.currentRangeOf(start, end);
  }

  return match (current) {
    Option::SOME(range) -> Option::SOME(rangeJson(view.lineIndex.position(range.start), view.lineIndex.position(range.end))),
    Option::NONE -> Option::NONE,
  };
}

/// The error text for a skipped message of `length` bytes.
function oversizedMessageText(length: u64): String {
  let limit: u64 = LSP_MAX_MESSAGE_BYTES;
  return `message of ${length} bytes exceeds the ${limit}-byte limit`;
}

/// A copy of every string in `values`.
function cloneTexts(values: &Vector<String>): Vector<String> {
  let mut copy: Vector<String> = Vector::new<String>();
  let mut index: u64 = 0;

  while (index < values.length()) {
    if (let Option::SOME(value) = values.get(index)) {
      copy.push(value.clone());
    }

    index += 1;
  }

  return copy;
}

/// True when `values` holds a string equal to `wanted`.
function containsText(values: &Vector<String>, wanted: &String): boolean {
  let mut index: u64 = 0;

  while (index < values.length()) {
    if (let Option::SOME(value) = values.get(index)) {
      if (value.equals(wanted)) {
        return true;
      }
    }

    index += 1;
  }

  return false;
}

function lspLog(message: String): void {
  let mut line: String = String::create("[ignis-lsp] ");
  line.push(&message);
  Io::eprintln(line);
}

/// The text of the last `contentChanges` entry of a `didChange` that has no
/// `range`: with full-document sync that entry is the whole new text. `NONE`
/// when there is none.
function fullTextOfChanges(params: &JsonValue): Option<String> {
  let Option::SOME(changes) = jsonMember(params, "contentChanges") else {
    return Option::NONE;
  };

  return lastFullTextChange(changes);
}

function lastFullTextChange(changes: &JsonValue): Option<String> {
  let JsonValueKind::ARRAY(items) = &changes.kind else {
    return Option::NONE;
  };

  let mut index: u64 = items.length();

  while (index > 0) {
    index -= 1;

    let Option::SOME(change) = items.get(index) else {
      break;
    };

    if (jsonMember(change, "range").isNone()) {
      return jsonStringMember(change, "text");
    }
  }

  return Option::NONE;
}

/// A sequential language server over one reader and one writer.
export record LspServer {
  reader: Stream::ByteReader;
  writer: Stream::ByteWriter;
  phase: LspPhase;
  documents: DocumentStore;
  /// Documents changed since the last analysis, as their paths.
  dirty: Vector<Path::PathBuf>;
  published: Vector<PublishedSet>;
  /// The navigation data of each analysis, from its last run that reached
  /// the analyzer: an edit that breaks parsing keeps the previous one, as the
  /// host keeps its last good analysis (crates/ignis_lsp/src/state.rs:59).
  navigations: Vector<NavigationSet>;
  /// `--std-path`, applied to every analysis.
  stdPath: Option<String>;

  public static create(
    reader: Stream::ByteReader,
    writer: Stream::ByteWriter,
    stdPath: Option<String>
  ): LspServer {
    return LspServer {
      reader: reader,
      writer: writer,
      phase: LspPhase::WAITING,
      documents: DocumentStore::create(),
      dirty: Vector::new<Path::PathBuf>(),
      published: Vector::new<PublishedSet>(),
      navigations: Vector::new<NavigationSet>(),
      stdPath: stdPath,
    };
  }

  /// Serves stdin and stdout until `exit` or the end of input, and returns
  /// the process exit code: 0 after `shutdown`, 1 otherwise.
  ///
  /// Standard output is moved to a duplicate descriptor first and descriptor
  /// 1 is pointed at stderr, so nothing the compiler prints while analyzing
  /// can corrupt the message stream.
  public static runStdio(stdPath: Option<String>): i32 {
    let mut protocolFd: i32 = LibC::File::dup(LibC::File::STDOUT_FILENO);

    if (protocolFd < 0) {
      protocolFd = LibC::File::STDOUT_FILENO;
    } else {
      LibC::File::dup2(LibC::File::STDERR_FILENO, LibC::File::STDOUT_FILENO);
    }

    let mut server: LspServer = LspServer::create(
      Stream::ByteReader::stdin(),
      Stream::ByteWriter::fromFd(protocolFd),
      stdPath,
    );

    return server.run();
  }

  public run(&mut self): i32 {
    while (true) {
      if (let LspStep::EXIT(code) = self.step()) {
        return code;
      }

      if (self.dirty.length() > 0 && self.reader.available() == 0) {
        self.analyzeDirty();
      }
    }

    return 1;
  }

  /// Reads and handles one message.
  step(&mut self): LspStep {
    match (self.reader.readFramedMessageWithin(LSP_MAX_MESSAGE_BYTES)) {
      Result::OK(body) -> {
        return self.handleMessage(&body);
      },
      Result::ERROR(Stream::FrameError::TOO_LARGE(length)) -> {
        self.sendError(Option::NONE, LspErrorCode::INVALID_REQUEST, oversizedMessageText(length));
        return LspStep::CONTINUE;
      },
      Result::ERROR(Stream::FrameError::END_OF_INPUT) -> {
        return LspStep::EXIT(self.exitCode());
      },
      Result::ERROR(_) -> {
        lspLog(String::create("the input stream is malformed or unreadable; stopping"));
        return LspStep::EXIT(1);
      },
    };

    return LspStep::EXIT(1);
  }

  /// 0 when `shutdown` was received, 1 otherwise, as the protocol asks of
  /// `exit`.
  exitCode(&self): i32 {
    return match (self.phase) {
      LspPhase::SHUT_DOWN -> 0,
      _ -> 1,
    };
  }

  send(&self, body: &String): void {
    if (let Result::ERROR(_) = self.writer.writeFramedMessage(body)) {
      lspLog(String::create("could not write a message to the client"));
    }
  }

  sendError(&self, id: Option<RequestId>, code: i64, message: String): void {
    let body: String = errorResponseBody(id, code, message);
    self.send(&body);
  }

  /// Handles one message body.
  public handleMessage(&mut self, body: &String): LspStep {
    match (decodeMessage(body)) {
      Result::OK(LspMessage::REQUEST(request)) -> {
        return self.handleRequest(request);
      },
      Result::OK(LspMessage::NOTIFICATION(notification)) -> {
        return self.handleNotification(notification);
      },
      Result::OK(LspMessage::RESPONSE) -> {
        return LspStep::CONTINUE;
      },
      Result::ERROR(DecodeError::PARSE(message)) -> {
        self.sendError(Option::NONE, LspErrorCode::PARSE_ERROR, message);
        return LspStep::CONTINUE;
      },
      Result::ERROR(DecodeError::INVALID(message)) -> {
        self.sendError(Option::NONE, LspErrorCode::INVALID_REQUEST, message);
        return LspStep::CONTINUE;
      },
    };

    return LspStep::CONTINUE;
  }

  /// The error a request gets in the current phase, or `NONE` when it may run.
  refusalOf(&self, isInitialize: boolean): Option<String> {
    return match (self.phase) {
      LspPhase::WAITING -> {
        if (isInitialize) {
          return Option::NONE;
        }

        return Option::SOME(String::create("server not initialized"));
      },
      LspPhase::RUNNING -> {
        if (isInitialize) {
          return Option::SOME(String::create("initialize was already received"));
        }

        return Option::NONE;
      },
      LspPhase::SHUT_DOWN -> Option::SOME(String::create("shutdown was already requested")),
    };
  }

  handleRequest(&mut self, request: LspRequest): LspStep {
    let isInitialize: boolean = request.method.equals("initialize");

    if (let Option::SOME(message) = self.refusalOf(isInitialize)) {
      let code: i64 = match (self.phase) {
        LspPhase::WAITING -> LspErrorCode::SERVER_NOT_INITIALIZED,
        _ -> LspErrorCode::INVALID_REQUEST,
      };

      self.sendError(Option::SOME(request.id), code, message);
      return LspStep::CONTINUE;
    }

    if (isInitialize) {
      self.phase = LspPhase::RUNNING;
      let body: String = responseBody(request.id, initializeResult());
      self.send(&body);
      return LspStep::CONTINUE;
    }

    if (request.method.equals("textDocument/hover")) {
      let result: JsonValue = self.hover(&request.message);
      let body: String = responseBody(request.id, result);
      self.send(&body);
      return LspStep::CONTINUE;
    }

    if (request.method.equals("textDocument/definition")) {
      let result: JsonValue = self.definition(&request.message);
      let body: String = responseBody(request.id, result);
      self.send(&body);
      return LspStep::CONTINUE;
    }

    if (request.method.equals("textDocument/references")) {
      let result: JsonValue = self.references(&request.message);
      let body: String = responseBody(request.id, result);
      self.send(&body);
      return LspStep::CONTINUE;
    }

    if (request.method.equals("textDocument/documentSymbol")) {
      let result: JsonValue = self.documentSymbols(&request.message);
      let body: String = responseBody(request.id, result);
      self.send(&body);
      return LspStep::CONTINUE;
    }

    if (request.method.equals("shutdown")) {
      self.phase = LspPhase::SHUT_DOWN;
      let body: String = responseBody(request.id, JsonValue::nullValue());
      self.send(&body);
      return LspStep::CONTINUE;
    }

    let message: String = `method not found: ${request.method.toStr()}`;
    self.sendError(Option::SOME(request.id), LspErrorCode::METHOD_NOT_FOUND, message);
    return LspStep::CONTINUE;
  }

  handleNotification(&mut self, notification: LspNotification): LspStep {
    if (notification.method.equals("exit")) {
      return LspStep::EXIT(self.exitCode());
    }

    let isRunning: boolean = match (self.phase) {
      LspPhase::RUNNING -> true,
      _ -> false,
    };

    if (!isRunning) {
      return LspStep::CONTINUE;
    }

    let Option::SOME(params) = jsonMember(&notification.message, "params") else {
      return LspStep::CONTINUE;
    };

    if (notification.method.equals("textDocument/didOpen")) {
      self.didOpen(params);
    } else if (notification.method.equals("textDocument/didChange")) {
      self.didChange(params);
    } else if (notification.method.equals("textDocument/didClose")) {
      self.didClose(params);
    }

    return LspStep::CONTINUE;
  }

  didOpen(&mut self, params: &JsonValue): void {
    let Option::SOME(document) = jsonMember(params, "textDocument") else {
      return;
    };
    let Option::SOME(uri) = jsonStringMember(document, "uri") else {
      return;
    };
    let Option::SOME(text) = jsonStringMember(document, "text") else {
      return;
    };

    let version: i64 = jsonIntegerMember(document, "version").unwrapOr(0);

    let Option::SOME(path) = self.documents.open(&uri, text, version) else {
      lspLog(`ignoring ${uri.toStr()}: not a file URI`);
      return;
    };

    self.markDirty(path);
  }

  didChange(&mut self, params: &JsonValue): void {
    let Option::SOME(document) = jsonMember(params, "textDocument") else {
      return;
    };
    let Option::SOME(uri) = jsonStringMember(document, "uri") else {
      return;
    };
    let Option::SOME(text) = fullTextOfChanges(params) else {
      lspLog(`ignoring a change to ${uri.toStr()} without a full-document text`);
      return;
    };

    let version: i64 = jsonIntegerMember(document, "version").unwrapOr(0);

    let Option::SOME(path) = self.documents.change(&uri, text, version) else {
      lspLog(`ignoring a change to ${uri.toStr()}: the document is not open`);
      return;
    };

    self.markDirty(path);
  }

  /// Forgets the document and clears its diagnostics, as the host server does.
  /// Other files are not re-analyzed until they change, and the navigation
  /// data keeps the closed file until the next analysis.
  didClose(&mut self, params: &JsonValue): void {
    let Option::SOME(document) = jsonMember(params, "textDocument") else {
      return;
    };
    let Option::SOME(uri) = jsonStringMember(document, "uri") else {
      return;
    };

    if (!self.documents.close(&uri)) {
      return;
    }

    self.forgetPublished(&uri);

    let empty: Vector<LspDiagnostic> = Vector::new<LspDiagnostic>();
    let body: String = notificationBody("textDocument/publishDiagnostics", publishDiagnosticsParams(&uri, &empty, Option::NONE));
    self.send(&body);
  }

  /// Queues the analysis of `path`. Only an Ignis source file starts one,
  /// as in the host server, which never analyzes `ignis.toml` and reads only
  /// `.ign` buffers.
  markDirty(&mut self, path: Path::PathBuf): void {
    if (!isIgnisSourcePath(&path)) {
      return;
    }

    self.dirty.push(path);
  }

  forgetPublished(&mut self, uri: &String): void {
    let mut setIndex: u64 = 0;

    while (setIndex < self.published.length()) {
      if (let Option::SOME(set) = self.published.getMut(setIndex)) {
        let mut kept: Vector<String> = Vector::new<String>();
        let mut uriIndex: u64 = 0;

        while (uriIndex < set.uris.length()) {
          if (let Option::SOME(candidate) = set.uris.get(uriIndex)) {
            if (!candidate.equals(uri)) {
              kept.push(candidate.clone());
            }
          }

          uriIndex += 1;
        }

        set.uris = kept;
      }

      setIndex += 1;
    }
  }

  /// Runs each distinct analysis the dirty documents belong to, once.
  analyzeDirty(&mut self): void {
    let mut keys: Vector<String> = Vector::new<String>();
    let mut starts: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
    let mut dirtyIndex: u64 = 0;

    while (dirtyIndex < self.dirty.length()) {
      if (let Option::SOME(path) = self.dirty.get(dirtyIndex)) {
        let key: String = analysisKeyOf(path);

        if (!containsText(&keys, &key)) {
          keys.push(key);
          starts.push(path.clone());
        } else {
          let _duplicate: String = key;
        }
      }

      dirtyIndex += 1;
    }

    self.dirty = Vector::new<Path::PathBuf>();

    let sources: SourceOverrides = self.documents.sourceOverrides();
    let mut keyIndex: u64 = 0;

    while (keyIndex < keys.length()) {
      let Option::SOME(key) = keys.get(keyIndex) else {
        break;
      };
      let Option::SOME(start) = starts.get(keyIndex) else {
        break;
      };

      let analysis: LspAnalysis = analyzeDocuments(start, key, &self.stdPath, &sources);
      self.publish(key, &analysis.diagnostics);
      self.keepNavigation(key, analysis.navigation);
      keyIndex += 1;
    }
  }

  /// Publishes one analysis: every file with diagnostics, then an empty list
  /// for each file the previous run of the same analysis reported and this
  /// one did not.
  publish(&mut self, key: &String, files: &Vector<FileDiagnostics>): void {
    let mut uris: Vector<String> = Vector::new<String>();
    let mut fileIndex: u64 = 0;

    while (fileIndex < files.length()) {
      if (let Option::SOME(file) = files.get(fileIndex)) {
        let handle: DocumentHandle = match (self.documents.findByPath(&file.path)) {
          Option::SOME(value) -> value,
          Option::NONE -> DocumentHandle { uri: uriFromFilePath(&file.path), version: -1 },
        };
        let mut version: Option<i64> = Option::NONE;

        if (handle.version >= 0) {
          version = Option::SOME(handle.version);
        }

        let params: JsonValue = publishDiagnosticsParams(&handle.uri, &file.diagnostics, version);
        let body: String = notificationBody("textDocument/publishDiagnostics", params);
        self.send(&body);
        uris.push(handle.uri);
      }

      fileIndex += 1;
    }

    let previous: Vector<String> = self.takePublished(key);
    let empty: Vector<LspDiagnostic> = Vector::new<LspDiagnostic>();
    let mut previousIndex: u64 = 0;

    while (previousIndex < previous.length()) {
      if (let Option::SOME(uri) = previous.get(previousIndex)) {
        if (!containsText(&uris, uri)) {
          let body: String = notificationBody("textDocument/publishDiagnostics", publishDiagnosticsParams(uri, &empty, Option::NONE));
          self.send(&body);
        }
      }

      previousIndex += 1;
    }

    self.published.push(PublishedSet { key: key.clone(), uris: uris });
  }

  /// Removes and returns the URIs the analysis `key` last published.
  takePublished(&mut self, key: &String): Vector<String> {
    let mut kept: Vector<PublishedSet> = Vector::new<PublishedSet>();
    let mut taken: Vector<String> = Vector::new<String>();

    while (self.published.length() > 0) {
      let Option::SOME(set) = self.published.pop() else {
        break;
      };

      if (set.key.equals(key)) {
        taken = cloneTexts(&set.uris);
        let _replaced: PublishedSet = set;
      } else {
        kept.push(set);
      }
    }

    self.published = kept;
    return taken;
  }

  /// Replaces the navigation data of the analysis `key` with `navigation`,
  /// unless the analyzer did not run.
  keepNavigation(&mut self, key: &String, navigation: Option<NavigationIndex>): void {
    let Option::SOME(index) = navigation else {
      return;
    };

    let mut kept: Vector<NavigationSet> = Vector::new<NavigationSet>();

    while (self.navigations.length() > 0) {
      let Option::SOME(set) = self.navigations.pop() else {
        break;
      };

      if (set.key.equals(key)) {
        let _replaced: NavigationSet = set;
      } else {
        kept.push(set);
      }
    }

    kept.push(NavigationSet { key: key.clone(), index: index });
    self.navigations = kept;
  }

  /// The navigation data of the analysis `document` belongs to.
  navigationOf(&self, document: &Document): Option<&NavigationIndex> {
    let key: String = analysisKeyOf(&document.path);
    let mut index: u64 = 0;

    while (index < self.navigations.length()) {
      let Option::SOME(set) = self.navigations.get(index) else {
        break;
      };

      if (set.key.equals(&key)) {
        return Option::SOME(&set.index);
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// Answers `textDocument/hover`: the innermost hover range at the
  /// position, or `null`. Pending changes are analyzed first, so a hover
  /// right after an edit sees it.
  hover(&mut self, message: &JsonValue): JsonValue {
    if (self.dirty.length() > 0) {
      self.analyzeDirty();
    }

    let Option::SOME(request) = positionRequestOf(message) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(document) = self.documents.find(&request.uri) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(navigation) = self.navigationOf(document) else {
      return JsonValue::nullValue();
    };
    let path: String = document.path.toString();

    let Option::SOME(file) = navigation.fileOf(&path) else {
      return JsonValue::nullValue();
    };

    let lineIndex: Text::LineIndex = Text::LineIndex::create(document.text.clone());

    return match (file.hoverAtIn(&document.text, lineIndex.offset(request.position))) {
      Option::SOME(hit) -> hoverResult(&hit, &lineIndex),
      Option::NONE -> JsonValue::nullValue(),
    };
  }

  /// The target key of what the position `request` names.
  targetOf(&self, request: &PositionRequest): Option<u64> {
    let Option::SOME(document) = self.documents.find(&request.uri) else {
      return Option::NONE;
    };
    let Option::SOME(navigation) = self.navigationOf(document) else {
      return Option::NONE;
    };
    let path: String = document.path.toString();

    let Option::SOME(file) = navigation.fileOf(&path) else {
      return Option::NONE;
    };

    let lineIndex: Text::LineIndex = Text::LineIndex::create(document.text.clone());
    return file.targetAtIn(&document.text, lineIndex.offset(request.position));
  }

  /// Answers `textDocument/definition` with the `Location` of what the
  /// position names, or `null`, as the host does
  /// (crates/ignis_lsp/src/server.rs:2264): an import path leads to the start
  /// of its module, a local to its `let` statement or binding, anything else
  /// to its whole declaration, in the project or the standard library.
  definition(&mut self, message: &JsonValue): JsonValue {
    if (self.dirty.length() > 0) {
      self.analyzeDirty();
    }

    let Option::SOME(request) = positionRequestOf(message) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(target) = self.targetOf(&request) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(document) = self.documents.find(&request.uri) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(navigation) = self.navigationOf(document) else {
      return JsonValue::nullValue();
    };
    let path: String = document.path.toString();

    let Option::SOME(file) = navigation.fileOf(&path) else {
      return JsonValue::nullValue();
    };

    let location: Option<JsonValue> = self.definitionLocation(navigation, file, target);

    return match (location) {
      Option::SOME(value) -> value,
      Option::NONE -> JsonValue::nullValue(),
    };
  }

  definitionLocation(
    &self,
    navigation: &NavigationIndex,
    file: &FileHoverIndex,
    target: u64
  ): Option<JsonValue> {
    if (let Option::SOME(moduleIndex) = moduleOfTarget(target)) {
      let Option::SOME(path) = navigation.paths.get(moduleIndex) else {
        return Option::NONE;
      };

      let origin: JsonValue = rangeJson(Text::Position { line: 0, character: 0 }, Text::Position { line: 0, character: 0 });
      return Option::SOME(locationJson(self.uriOfPath(path), origin));
    }

    if (isLocalTarget(target)) {
      let Option::SOME(local) = file.localDeclaration(target) else {
        return Option::NONE;
      };

      let view: FileView = self.fileView(file);

      return match (viewRange(&view, file, local.start, local.end, false)) {
        Option::SOME(range) -> Option::SOME(locationJson(view.uri.clone(), range)),
        Option::NONE -> Option::NONE,
      };
    }

    let Option::SOME(defId) = definitionOfTarget(target) else {
      return Option::NONE;
    };
    let Option::SOME(declaration) = navigation.declarationOf(defId) else {
      return Option::NONE;
    };

    return self.declarationLocation(navigation, declaration, false);
  }

  /// The `Location` of `declaration`, its name only with `nameOnly`.
  declarationLocation(
    &self,
    navigation: &NavigationIndex,
    declaration: &DeclarationSite,
    nameOnly: boolean
  ): Option<JsonValue> {
    let Option::SOME(path) = navigation.paths.get(declaration.module) else {
      return Option::NONE;
    };

    if (let Option::SOME(file) = navigation.fileOf(path)) {
      let view: FileView = self.fileView(file);
      let start: u64 = nameOnly ? declaration.nameStart : declaration.start;
      let end: u64 = nameOnly ? declaration.nameEnd : declaration.end;

      return match (viewRange(&view, file, start, end, nameOnly)) {
        Option::SOME(range) -> Option::SOME(locationJson(view.uri.clone(), range)),
        Option::NONE -> Option::NONE,
      };
    }

    if (nameOnly) {
      return Option::SOME(locationJson(self.uriOfPath(path), rangeJson(declaration.nameStartPosition, declaration.nameEndPosition)));
    }

    return Option::SOME(locationJson(self.uriOfPath(path), rangeJson(declaration.startPosition, declaration.endPosition)));
  }

  /// The URI of `path`: the client's own when the file is open.
  uriOfPath(&self, path: &String): String {
    return match (self.documents.findByPath(path)) {
      Option::SOME(handle) -> handle.uri,
      Option::NONE -> uriFromFilePath(path),
    };
  }

  /// The text the client has of `file`: the open document, or else the text
  /// it was analyzed from.
  fileView(&self, file: &FileHoverIndex): FileView {
    let mut uri: String = uriFromFilePath(&file.path);
    let mut current: String = file.source.clone();

    if (let Option::SOME(handle) = self.documents.findByPath(&file.path)) {
      if (let Option::SOME(document) = self.documents.find(&handle.uri)) {
        current = document.text.clone();
      }

      uri = handle.uri;
    }

    return FileView {
      uri: uri,
      current: current.clone(),
      edit: file.editTo(&current),
      lineIndex: Text::LineIndex::create(current),
    };
  }

  /// Answers `textDocument/references` with every `Location` that names what
  /// the position names, or `null` when it names nothing, as the host does
  /// (crates/ignis_lsp/src/server.rs:2786).
  references(&mut self, message: &JsonValue): JsonValue {
    if (self.dirty.length() > 0) {
      self.analyzeDirty();
    }

    let Option::SOME(request) = positionRequestOf(message) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(target) = self.targetOf(&request) else {
      return JsonValue::nullValue();
    };

    if (moduleOfTarget(target).isSome()) {
      return JsonValue::nullValue();
    }

    let Option::SOME(document) = self.documents.find(&request.uri) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(navigation) = self.navigationOf(document) else {
      return JsonValue::nullValue();
    };
    let path: String = document.path.toString();

    let Option::SOME(file) = navigation.fileOf(&path) else {
      return JsonValue::nullValue();
    };

    let sites: Vector<NameSite> = navigation.referenceSites(file, target, includesDeclaration(message));
    return JsonValue::array(self.siteLocations(navigation, target, &sites));
  }

  /// The `Location` of each site that is still where it was analyzed.
  siteLocations(
    &self,
    navigation: &NavigationIndex,
    target: u64,
    sites: &Vector<NameSite>
  ): Vector<JsonValue> {
    let mut locations: Vector<JsonValue> = Vector::new<JsonValue>();
    let mut views: Vector<FileView> = Vector::new<FileView>();
    let mut viewModule: u64 = 0;
    let mut index: u64 = 0;

    while (index < sites.length()) {
      let Option::SOME(site) = sites.get(index) else {
        break;
      };

      index += 1;

      let Option::SOME(path) = navigation.paths.get(site.module) else {
        continue;
      };

      let indexed: Option<&FileHoverIndex> = navigation.fileOf(path);

      if (indexed.isNone()) {
        if (let Option::SOME(location) = self.declarationSiteLocation(navigation, target, site)) {
          locations.push(location);
        }

        continue;
      }

      let Option::SOME(file) = indexed else {
        continue;
      };

      if (views.length() == 0 || viewModule != site.module) {
        views = Vector::new<FileView>();
        views.push(self.fileView(file));
        viewModule = site.module;
      }

      let Option::SOME(current) = views.get(0) else {
        continue;
      };

      if (let Option::SOME(range) = viewRange(current, file, site.start, site.end, true)) {
        locations.push(locationJson(current.uri.clone(), range));
      }
    }

    return locations;
  }

  /// The location of a declaration site in a file without an index.
  declarationSiteLocation(
    &self,
    navigation: &NavigationIndex,
    target: u64,
    site: &NameSite
  ): Option<JsonValue> {
    if (!site.isDeclaration) {
      return Option::NONE;
    }

    let Option::SOME(defId) = definitionOfTarget(target) else {
      return Option::NONE;
    };
    let Option::SOME(declaration) = navigation.declarationOf(defId) else {
      return Option::NONE;
    };

    return self.declarationLocation(navigation, declaration, true);
  }

  /// Answers `textDocument/documentSymbol` with the outline of the document:
  /// namespaces with their declarations, records with their fields, methods
  /// and static fields, enums with their variants, static methods and static
  /// fields, as the host nests them (crates/ignis_lsp/src/server.rs:3300).
  /// `null` when the document has not been analyzed.
  documentSymbols(&mut self, message: &JsonValue): JsonValue {
    if (self.dirty.length() > 0) {
      self.analyzeDirty();
    }

    let Option::SOME(params) = jsonMember(message, "params") else {
      return JsonValue::nullValue();
    };
    let Option::SOME(textDocument) = jsonMember(params, "textDocument") else {
      return JsonValue::nullValue();
    };
    let Option::SOME(uri) = jsonStringMember(textDocument, "uri") else {
      return JsonValue::nullValue();
    };
    let Option::SOME(document) = self.documents.find(&uri) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(navigation) = self.navigationOf(document) else {
      return JsonValue::nullValue();
    };

    let path: String = document.path.toString();

    let Option::SOME(file) = navigation.fileOf(&path) else {
      return JsonValue::nullValue();
    };
    let Option::SOME(moduleIndex) = navigation.moduleOf(&path) else {
      return JsonValue::nullValue();
    };

    let view: FileView = self.fileView(file);
    let outline: Vector<u64> = navigation.outlineOf(moduleIndex);
    return JsonValue::array(symbolsJson(navigation, file, &view, &outline, 0));
  }
}

/// The symbols among the declarations at `outline` whose parent is `parent`.
/// A symbol the edit since the analysis reaches into is left out with its
/// children.
function symbolsJson(
  navigation: &NavigationIndex,
  file: &FileHoverIndex,
  view: &FileView,
  outline: &Vector<u64>,
  parent: u64,
): Vector<JsonValue> {
  let mut symbols: Vector<JsonValue> = Vector::new<JsonValue>();
  let positions: Vector<u64> = navigation.outlineChildren(outline, parent);
  let mut index: u64 = 0;

  while (index < positions.length()) {
    let Option::SOME(position) = positions.get(index) else {
      break;
    };

    index += 1;

    let Option::SOME(declaration) = navigation.declarations.get(*position) else {
      continue;
    };
    let Option::SOME(range) = viewRange(view, file, declaration.start, declaration.end, false) else {
      continue;
    };
    let Option::SOME(selection) = viewRange(view, file, declaration.nameStart, declaration.nameEnd, false) else {
      continue;
    };

    let children: Vector<JsonValue> = symbolsJson(navigation, file, view, outline, *position + 1);
    let mut entries: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
    entries.push(JsonObjectEntry::create("name", JsonValue::fromString(declaration.name.clone())));
    entries.push(JsonObjectEntry::create("kind", JsonValue::unsignedValue(declaration.kind)));
    entries.push(JsonObjectEntry::create("range", range));
    entries.push(JsonObjectEntry::create("selectionRange", selection));

    if (children.length() > 0) {
      entries.push(JsonObjectEntry::create("children", JsonValue::array(children)));
    } else {
      let _none: Vector<JsonValue> = children;
    }

    symbols.push(JsonValue::object(entries));
  }

  return symbols;
}
