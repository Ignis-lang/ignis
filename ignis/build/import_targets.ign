import Ast from "@compiler::ast";
import Analyzer from "@compiler::analyzer";
import Parser from "@compiler::parser";

import String from "std::string";
import Vector from "std::vector";

import BuildGraph, BuildModuleKind from "./module_graph";

/// The analyzer's module kind for a module discovery classified as `kind`.
export function analyzerModuleKind(kind: BuildModuleKind): Analyzer::Imports::ModuleKind {
  return match (kind) {
    BuildModuleKind::PROJECT -> Analyzer::Imports::ModuleKind::PROJECT,
    BuildModuleKind::STD -> Analyzer::Imports::ModuleKind::STD,
  };
}

/// Rewrites every `import` and `export ... from` source in `module` to the
/// path discovery resolved it to, following the edges of node `nodeIndex`.
///
/// Returns false when an import has no matching edge, which means `module`
/// was not parsed from the text discovery read. Callers skip a module whose
/// parse reported anything: nothing analyzes it, and discovery leaves an
/// import of such a module unfollowed when it cannot resolve it.
export function mapImportSourcesToDiscoveryTargets(
  module: &mut Ast::Module,
  graph: &BuildGraph,
  nodeIndex: u64,
): boolean {
  let Option::SOME(node) = graph.nodes.get(nodeIndex) else {
    return false;
  };
  let mut rootIndex: u64 = 0;

  while (rootIndex < module.roots.length()) {
    let Option::SOME(rootId) = module.roots.get(rootIndex) else {
      return false;
    };
    let Option::SOME(item) = module.items.getMut(*rootId) else {
      return false;
    };
    if (let Ast::Item::Node::Export(exportItem) = item) {
      // `export Name from "path"` carries a source too; it maps to its
      // discovery target the same way an import does.
      let Option::SOME(exportSource) = Ast::copyOptionalString(&exportItem.source) else {
        rootIndex += 1;
        continue;
      };

      let mut exportEdgeIndex: u64 = 0;
      let mut exportMatched: boolean = false;

      while (exportEdgeIndex < node.edges.length()) {
        let Option::SOME(edge) = node.edges.get(exportEdgeIndex) else {
          return false;
        };

        if (edge.source.equals(exportSource.toStr())) {
          let Option::SOME(target) = graph.nodes.get(edge.targetIndex) else {
            return false;
          };

          *item = Ast::Item::Node::Export(Ast::Item::Export {
            span: exportItem.span,
            declaration: exportItem.declaration,
            items: Ast::copyImportBindings(&exportItem.items),
            source: Option::SOME(target.path.toString()),
            sourceSpan: exportItem.sourceSpan,
            metadata: Ast::emptyMetadata(),
          });
          exportMatched = true;
          break;
        }

        exportEdgeIndex += 1;
      }

      if (!exportMatched) {
        return false;
      }

      rootIndex += 1;
      continue;
    }

    let Ast::Item::Node::Import(importItem) = item else {
      rootIndex += 1;
      continue;
    };
    let mut edgeIndex: u64 = 0;
    let mut matched: boolean = false;

    while (edgeIndex < node.edges.length()) {
      let Option::SOME(edge) = node.edges.get(edgeIndex) else {
        return false;
      };

      if (edge.source.equals(importItem.source.toStr())) {
        let Option::SOME(target) = graph.nodes.get(edge.targetIndex) else {
          return false;
        };

        *item = Ast::Item::Node::Import(Ast::Item::Import {
          span: importItem.span,
          items: Ast::copyImportBindings(&importItem.items),
          source: target.path.toString(),
          writtenSource: importItem.writtenSource.clone(),
          sourceSpan: importItem.sourceSpan,
          metadata: Ast::emptyMetadata(),
        });
        matched = true;
        break;
      }

      edgeIndex += 1;
    }

    if (!matched) {
      return false;
    }

    rootIndex += 1;
  }

  return true;
}

/// The source every `export ... from` in `module` names, in root order, which
/// `restoreWrittenImportSources` puts back after the module was mapped.
export function exportSourcesOf(module: &Ast::Module): Vector<String> {
  let mut sources: Vector<String> = Vector::new<String>();
  let mut rootIndex: u64 = 0;

  while (rootIndex < module.roots.length()) {
    let Option::SOME(rootId) = module.roots.get(rootIndex) else {
      break;
    };

    rootIndex += 1;

    let Option::SOME(item) = module.items.get(*rootId) else {
      continue;
    };

    if (let Ast::Item::Node::Export(exportItem) = item) {
      if (let Option::SOME(source) = &exportItem.source) {
        sources.push(source.clone());
      }
    }
  }

  return sources;
}

/// Undoes `mapImportSourcesToDiscoveryTargets`: every import source becomes
/// the written one again, and every `export ... from` source the one
/// `exportSources` (from `exportSourcesOf` before mapping) holds for it, so
/// that `module` can be mapped again against another discovery.
export function restoreWrittenImportSources(
  module: &mut Ast::Module,
  exportSources: &Vector<String>
): void {
  let mut exportIndex: u64 = 0;
  let mut rootIndex: u64 = 0;

  while (rootIndex < module.roots.length()) {
    let Option::SOME(rootId) = module.roots.get(rootIndex) else {
      break;
    };

    rootIndex += 1;

    let Option::SOME(item) = module.items.getMut(*rootId) else {
      continue;
    };

    if (let Ast::Item::Node::Export(exportItem) = item) {
      if (exportItem.source.isNone()) {
        continue;
      }

      let Option::SOME(written) = exportSources.get(exportIndex) else {
        continue;
      };

      exportIndex += 1;
      *item = Ast::Item::Node::Export(Ast::Item::Export {
        span: exportItem.span,
        declaration: exportItem.declaration,
        items: Ast::copyImportBindings(&exportItem.items),
        source: Option::SOME(written.clone()),
        sourceSpan: exportItem.sourceSpan,
        metadata: Ast::copyMetadata(&exportItem.metadata),
      });
      continue;
    }

    let Ast::Item::Node::Import(importItem) = item else {
      continue;
    };

    *item = Ast::Item::Node::Import(Ast::Item::Import {
      span: importItem.span,
      items: Ast::copyImportBindings(&importItem.items),
      source: importItem.writtenSource.clone(),
      writtenSource: importItem.writtenSource.clone(),
      sourceSpan: importItem.sourceSpan,
      metadata: Ast::copyMetadata(&importItem.metadata),
    });
  }
}

/// Copies the default methods of traits one module declares onto the types
/// of other modules that implement them. `modules[i]` is the module `infos[i]`
/// describes, with its imports already mapped to discovery targets.
export function copyTraitDefaultsAcrossModules(
  modules: &mut Vector<Ast::Module>,
  infos: &Vector<Analyzer::Imports::ModuleInfo>,
  preludePaths: &Vector<String>,
): void {
  let mut moduleSources: Vector<String> = Vector::new<String>();
  let mut index: u64 = 0;

  while (index < infos.length()) {
    if (let Option::SOME(info) = infos.get(index)) {
      moduleSources.push(info.pathText.clone());
    }

    index += 1;
  }

  Parser::materializeCrossModuleDefaults(modules, &moduleSources, preludePaths);
}
