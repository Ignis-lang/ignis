import Ast from "@compiler::ast";
import Analyzer from "@compiler::analyzer";

import Env from "std::env";
import Fs from "std::fs";
import Io from "std::io";
import LibC from "std::libc";
import Memory from "std::memory";
import Path from "std::path";
import Process from "std::process";
import String from "std::string";
import Test from "std::test";
import Time from "std::time";
import Vector from "std::vector";

import CodegenC from "../codegen/mod";
import FixtureCase, FixtureMode, FixtureTests from "./fixture_tests";
import BuildGraph from "./module_graph";

/// One `@test` function selected for execution.
///
/// `fqName` is the name the harness dispatches on and the runner reports;
/// `symbolName` is the C symbol the emitted translation unit defines for it.
export record TestCase {
  public fqName: String;
  public symbolName: String;
  /// Raw definition id of the test function. The harness is its own
  /// translation unit, so the emitter has to keep this symbol externally
  /// visible instead of giving it the internal linkage every other definition
  /// in the program unit gets.
  public defIdRaw: u32;
  /// `<module directory>/__snapshots__`, the directory `std::test` snapshot
  /// helpers read and write through `IGNIS_TEST_SNAPSHOT_DIR`.
  public snapshotDir: String;

  public clone(&self): TestCase {
    return TestCase {
      fqName: self.fqName.clone(),
      symbolName: self.symbolName.clone(),
      defIdRaw: self.defIdRaw,
      snapshotDir: self.snapshotDir.clone(),
    };
  }
}

/// What one harness process reported.
export record TestOutcome {
  public fqName: String;
  public success: boolean;
  public exitCode: i32;
  public stdout: String;
  public stderr: String;
}

/// Longest failure stream excerpt reported per stream, in characters.
const FAILED_TEST_OUTPUT_LIMIT: u64 = 240;

/// Environment variable consulted when no explicit `--test-timeout` was given.
const TEST_TIMEOUT_ENV: str = "IGNIS_TEST_TIMEOUT";

/// Wall-clock budget applied to one test process when nothing else selects one.
const DEFAULT_TEST_TIMEOUT_SECONDS: u64 = 300;

/// Exit code reported for a process the runner had to kill.
const TIMEOUT_EXIT_CODE: i32 = 124;

/// Interval between liveness checks while waiting for a child, in microseconds.
const PROCESS_POLL_INTERVAL_MICROS: u32 = 5000;

/// POSIX `WNOHANG`, which `std::libc` does not name yet. It is `1` on every
/// platform this compiler targets.
const PROCESS_WAIT_NO_HANG: i32 = 1;

/// Bits of a POSIX wait status that carry the terminating signal.
const PROCESS_SIGNAL_MASK: i32 = 127;

/// Bits of a POSIX wait status that identify a stopped child.
const PROCESS_STOPPED_MASK: i32 = 255;

/// Value those bits carry for a stopped child.
const PROCESS_STOPPED_VALUE: i32 = 127;

/// `k/n` shard selection, disabled when no command line named one.
export record TestPartition {
  public enabled: boolean;
  public index: u64;
  public count: u64;

  public static none(): TestPartition {
    return TestPartition {
      enabled: false,
      index: 0,
      count: 0,
    };
  }

  public static create(index: u64, count: u64): TestPartition {
    return TestPartition {
      enabled: true,
      index: index,
      count: count,
    };
  }
}

/// Everything one test run will execute, in report order: the `@test` entries
/// first and the program fixtures after them.
export record TestPlan {
  public tests: Vector<TestCase>;
  public fixtures: Vector<FixtureCase>;
}

/// What one bounded child process produced.
///
/// `spawnFailed` marks a child the runner could not observe at all, which the
/// caller reports the way a failed spawn has always been reported.
export record ProcessOutcome {
  public success: boolean;
  public exitCode: i32;
  public stdout: String;
  public stderr: String;
  public timedOut: boolean;
  public spawnFailed: boolean;
}

/// Converts a POSIX wait status into a shell-like status code.
function testRunnerWaitStatusCode(rawStatus: i32): i32 {
  let exited: boolean = (rawStatus & PROCESS_SIGNAL_MASK) == 0;
  let stopped: boolean = (rawStatus & PROCESS_STOPPED_MASK) == PROCESS_STOPPED_VALUE;

  if (exited || stopped) {
    return (rawStatus >> 8) & 255;
  }

  return 128 + (rawStatus & PROCESS_SIGNAL_MASK);
}

/// True only for a normal exit with status code 0.
function testRunnerWaitStatusSuccess(rawStatus: i32): boolean {
  return (rawStatus & PROCESS_SIGNAL_MASK) == 0 && testRunnerWaitStatusCode(rawStatus) == 0;
}

/// Reads a seekable capture file into an owned string and leaves `fd` open.
///
/// `std::process` keeps its own reader private and only exposes it through the
/// blocking `Child::wait`, so a bounded wait has to read the descriptors the
/// spawned child handed over itself.
function testRunnerReadCapture(fd: i32): String {
  let length: i64 = LibC::File::lseek(fd, 0, LibC::File::SEEK_END);

  if (length <= 0) {
    return String::new();
  }

  if (LibC::File::lseek(fd, 0, LibC::File::SEEK_SET) == -1) {
    return String::new();
  }

  let buffer: *mut u8 = Memory::allocateVector<u8>(length as u64);
  let mut offset: u64 = 0;

  while (offset < length as u64) {
    let chunk: i64 = LibC::File::read(fd, (buffer + offset) as *mut void, (length as u64) - offset);

    if (chunk == -1) {
      if (LibC::Errno::get() == LibC::Errno::EINTR) {
        continue;
      }

      break;
    }

    if (chunk == 0) {
      break;
    }

    offset += chunk as u64;
  }

  let text: String = String::create(buffer, offset);
  Memory::free(buffer);

  return text;
}

/// Drains the child's exec-status pipe and closes it.
///
/// The pipe is close-on-exec, so EOF means `execvp` succeeded while bytes on it
/// carry the setup errno. Returns that errno, or 0 when the child reached its
/// program.
function testRunnerDrainExecPipe(errorReadFd: i32): i32 {
  let mut childErrno: i32 = 0;
  let mut bytesRead: i64 = -1;

  while (true) {
    bytesRead = LibC::File::read(errorReadFd, (&mut childErrno) as *mut void, @sizeOf<i32>());

    if (bytesRead == -1 && LibC::Errno::get() == LibC::Errno::EINTR) {
      continue;
    }

    break;
  }

  let readErrno: i32 = bytesRead == -1 ? LibC::Errno::get() : 0;
  LibC::File::close(errorReadFd);

  if (bytesRead > 0) {
    return childErrno == 0 ? LibC::Errno::EIO : childErrno;
  }

  if (bytesRead == -1) {
    return readErrno == 0 ? LibC::Errno::EIO : readErrno;
  }

  return 0;
}

/// Seconds elapsed since `started`, or 0 when the clock could not be read.
function testRunnerElapsedSeconds(started: &Time::MonotonicInstant): u64 {
  return match (started.elapsed()) {
    Result::OK(duration) -> duration.secs,
    Result::ERROR(_) -> 0,
  };
}

function testRunnerEndsWith(value: &String, suffix: str): boolean {
  let suffixText: String = String::create(suffix);

  if (value.length() < suffixText.length()) {
    return false;
  }

  let actual: String = value.substringBytes(value.length() - suffixText.length(), value.length());
  return actual.equals(&suffixText);
}

function testRunnerRelativePathText(path: &Path::PathBuf, root: &Path::PathBuf): String {
  let pathText: String = path.toString();
  let rootText: String = root.toString();

  if (!pathText.startsWith(rootText.toStr())) {
    return pathText;
  }

  let mut start: u64 = rootText.length();

  if (pathText.length() > start) {
    if (let Option::SOME(separator) = pathText.charAt(start) && separator == '/') {
      start += 1;
    }
  }

  return pathText.substringBytes(start, pathText.length());
}

/// Drop trailing ASCII whitespace, leaving the leading bytes untouched.
function testRunnerTrimEnd(value: &String): String {
  let mut end: u64 = value.length();

  while (end > 0) {
    let Option::SOME(byte) = value.byteAt(end - 1) else {
      break;
    };

    if (byte != 32 && byte != 9 && byte != 10 && byte != 13) {
      break;
    }

    end -= 1;
  }

  return value.substringBytes(0, end);
}

export namespace TestRunner {
  /// A section header, `U+2022 BULLET` then the title.
  function sectionHeader(title: str): String {
    let mut header: String = String::create("• ");
    header.pushStr(title);

    return header;
  }

  /// `path` made absolute against the current directory, so a bare relative
  /// program name is executed rather than looked up on `PATH`.
  function resolveAgainstCurrentDir(path: &Path::PathBuf): Path::PathBuf {
    if (path.isAbsolute()) {
      return path.clone();
    }

    let Result::OK(currentDir) = Env::currentDir() else {
      return path.clone();
    };

    return currentDir.join(path.asStr()).normalize();
  }

  /// The `::`-joined module part of a test name, mirroring the host's
  /// `module_segments`: the module path relative to the source root, without
  /// the `.ign` extension and without a trailing `mod` segment.
  function moduleSegments(path: &Path::PathBuf, sourceRoot: &Path::PathBuf): String {
    let relative: String = testRunnerRelativePathText(path, sourceRoot);
    let mut stem: String = relative.clone();

    if (testRunnerEndsWith(&stem, ".ign")) {
      stem = stem.substringBytes(0, stem.length() - 4);
    }

    if (stem.equals("mod")) {
      stem = String::new();
    } else if (testRunnerEndsWith(&stem, "/mod")) {
      stem = stem.substringBytes(0, stem.length() - 4);
    }

    let mut segments: String = String::new();
    let mut index: u64 = 0;

    while (index < stem.length()) {
      let Option::SOME(byte) = stem.byteAt(index) else {
        break;
      };

      if (byte == 47) {
        segments.pushStr("::");
      } else {
        segments.pushByte(byte);
      }

      index += 1;
    }

    return segments;
  }

  /// Append `name` to a `::`-separated prefix, skipping the separator when the
  /// prefix is empty.
  function joinName(prefix: &String, name: &String): String {
    if (prefix.length() == 0) {
      return name.clone();
    }

    let mut joined: String = prefix.clone();
    joined.pushStr("::");
    joined.push(name);
    return joined;
  }

  function collectItem(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    pass2: &Analyzer::Binder::BinderOutput,
    itemId: Ast::ItemId,
    prefix: &String,
    snapshotDir: &String,
    out: &mut Vector<TestCase>,
  ): void {
    let Option::SOME(node) = module.items.get(itemId) else {
      return;
    };

    match (node) {
      Ast::Item::Node::Function(functionItem) -> {
        if (!Analyzer::Binder::hasAttribute(&functionItem.metadata, "test")) {
          return;
        }

        // A function the binder skipped (an unmet `@configFlag`, a duplicate)
        // has no definition, so it has no symbol to dispatch to either.
        let Option::SOME(defId) = Analyzer::Binder::findDef(pass2, itemId.raw()) else {
          return;
        };

        let mut outRef: &mut Vector<TestCase> = out;
        outRef.push(TestCase {
          fqName: TestRunner::joinName(prefix, &functionItem.name),
          symbolName: CodegenC::mangledName(defStore, symbols, defId),
          defIdRaw: defId.raw(),
          snapshotDir: snapshotDir.clone(),
        });
      },
      Ast::Item::Node::Namespace(namespaceItem) -> {
        let childPrefix: String = TestRunner::joinName(prefix, &namespaceItem.name);
        let mut childIndex: u64 = 0;

        while (childIndex < namespaceItem.items.length()) {
          if (let Option::SOME(childId) = namespaceItem.items.get(childIndex)) {
            TestRunner::collectItem(
              defStore,
              symbols,
              module,
              pass2,
              *childId,
              &childPrefix,
              snapshotDir,
              out,
            );
          }

          childIndex += 1;
        }
      },
      Ast::Item::Node::Export(exportItem) -> {
        if (let Option::SOME(innerId) = exportItem.declaration) {
          TestRunner::collectItem(defStore, symbols, module, pass2, innerId, prefix, snapshotDir, out);
        }
      },
      _ -> {},
    };
  }

  /// Every `@test` function declared by one project module, named the way the
  /// host names it: module segments, then the enclosing namespaces, then the
  /// function.
  function collectModuleTests(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    pass2: &Analyzer::Binder::BinderOutput,
    modulePath: &Path::PathBuf,
    sourceRoot: &Path::PathBuf,
    out: &mut Vector<TestCase>,
  ): void {
    let prefix: String = TestRunner::moduleSegments(modulePath, sourceRoot);
    let mut snapshotDir: String = String::new();

    if (let Option::SOME(parent) = modulePath.parent()) {
      snapshotDir = parent.join("__snapshots__").toString();
    }

    let mut rootIndex: u64 = 0;

    while (rootIndex < module.roots.length()) {
      if (let Option::SOME(rootId) = module.roots.get(rootIndex)) {
        TestRunner::collectItem(defStore, symbols, module, pass2, *rootId, &prefix, &snapshotDir, out);
      }

      rootIndex += 1;
    }
  }

  /// The source root a project's test names are relative to: the directory
  /// holding the entry module the discovery graph is rooted at.
  function sourceRootOf(graph: &BuildGraph): Path::PathBuf {
    let Option::SOME(rootIndex) = graph.rootIndex else {
      return Path::PathBuf::new();
    };
    let Option::SOME(node) = graph.nodes.get(rootIndex) else {
      return Path::PathBuf::new();
    };
    let Option::SOME(parent) = node.path.parent() else {
      return Path::PathBuf::new();
    };

    return parent;
  }

  /// Sort by name and keep only the names containing `filter`, as the host's
  /// `build_test_harness_plan` does. An empty filter keeps everything.
  function plan(cases: &Vector<TestCase>, filter: &String): Vector<TestCase> {
    let mut selected: Vector<TestCase> = Vector::new<TestCase>();
    let mut index: u64 = 0;

    while (index < cases.length()) {
      let Option::SOME(testCase) = cases.get(index) else {
        break;
      };

      if (filter.length() == 0 || testCase.fqName.contains(filter)) {
        selected.push(testCase.clone());
      }

      index += 1;
    }

    TestRunner::sortByName(&mut selected);
    return selected;
  }

  /// Stable insertion sort by `fqName`, cloning through `get`/`set` the way
  /// `Sort::stableStrings` does for owned values.
  function sortByName(cases: &mut Vector<TestCase>): void {
    let mut casesRef: &mut Vector<TestCase> = cases;
    let mut index: u64 = 1;

    while (index < casesRef.length()) {
      let Option::SOME(currentRef) = casesRef.get(index) else {
        break;
      };
      let current: TestCase = currentRef.clone();
      let mut scan: i64 = index as i64 - 1;

      while (scan >= 0) {
        let Option::SOME(existing) = casesRef.get(scan as u64) else {
          break;
        };

        if (existing.fqName.compare(&current.fqName) <= 0) {
          break;
        }

        let shifted: TestCase = existing.clone();

        if (!casesRef.set((scan + 1) as u64, shifted)) {
          break;
        }

        scan -= 1;
      }

      let _inserted: boolean = casesRef.set((scan + 1) as u64, current);
      index += 1;
    }
  }

  /// The harness translation unit: one `extern` declaration per selected test
  /// and a `main` that dispatches on `--ignis-test <name>`.
  ///
  /// It owns the program's `main`, so the emitted program unit is built
  /// without its entry wrapper.
  function harnessSource(cases: &Vector<TestCase>): String {
    let mut source: String = String::create("#include <stdio.h>\n");
    source.pushStr("#include <stdlib.h>\n");
    source.pushStr("#include <string.h>\n");
    source.pushStr("#include \"ignis_rt.h\"\n\n");

    let mut declarationIndex: u64 = 0;

    while (declarationIndex < cases.length()) {
      let Option::SOME(testCase) = cases.get(declarationIndex) else {
        break;
      };

      source.pushStr(`extern void ${testCase.symbolName.toStr()}(void);\n`.toStr());
      declarationIndex += 1;
    }

    source.pushStr("\nint main(int argc, char** argv) {\n");
    source.pushStr("    ignis_runtime_init((i32)argc, argv);\n");
    source.pushStr("    if (argc != 3 || strcmp(argv[1], \"--ignis-test\") != 0) {\n");
    source.pushStr("        fprintf(stderr, \"Error: expected --ignis-test <name>\\n\");\n");
    source.pushStr("        return 2;\n");
    source.pushStr("    }\n");

    let mut dispatchIndex: u64 = 0;

    while (dispatchIndex < cases.length()) {
      let Option::SOME(testCase) = cases.get(dispatchIndex) else {
        break;
      };

      source.pushStr(`    if (strcmp(argv[2], "${testCase.fqName.toStr()}") == 0) {\n`.toStr());
      source.pushStr(`        ${testCase.symbolName.toStr()}();\n`.toStr());
      source.pushStr("        return 0;\n");
      source.pushStr("    }\n");
      dispatchIndex += 1;
    }

    source.pushStr("    fprintf(stderr, \"Error: unknown test %s\\n\", argv[2]);\n");
    source.pushStr("    return 2;\n");
    source.pushStr("}\n");

    return source;
  }

  /// Run the harness binary once per selected test, with the snapshot context
  /// the `std::test` helpers read out of the environment.
  ///
  /// Up to `jobs` harness processes run at once. Children are started and
  /// awaited in plan order, so the returned outcomes match the plan regardless
  /// of which child finishes first and the report stays byte-identical to a
  /// serial run.
  function execute(
    binaryPath: &Path::PathBuf,
    cases: &Vector<TestCase>,
    updateSnapshots: boolean,
    jobs: u64,
    timeoutSeconds: u64,
  ): Vector<TestOutcome> {
    let mut outcomes: Vector<TestOutcome> = Vector::new<TestOutcome>();
    let program: Path::PathBuf = TestRunner::resolveAgainstCurrentDir(binaryPath);
    let updateFlag: str = updateSnapshots ? "1" : "0";
    let window: u64 = jobs == 0 ? 1 : jobs;

    if (updateSnapshots) {
      TestRunner::prepareSnapshotDirectories(cases);
    }

    // Slot `i` holds the child for case `i`. A slot with `pid == -1` records a
    // spawn that never happened, so slot indices stay aligned with plan order.
    let mut children: Vector<Process::Child> = Vector::new<Process::Child>();
    let mut spawnCursor: u64 = 0;
    let mut waitCursor: u64 = 0;

    while (waitCursor < cases.length()) {
      while (spawnCursor < cases.length() && (spawnCursor - waitCursor) < window) {
        let Option::SOME(testCase) = cases.get(spawnCursor) else {
          break;
        };

        let mut command: Process::Command = Process::Command::new(program.asStr());
        command.arg("--ignis-test");
        command.arg(testCase.fqName.toStr());
        command.env("IGNIS_TEST_NAME", testCase.fqName.toStr());
        command.env("IGNIS_TEST_SNAPSHOT_DIR", testCase.snapshotDir.toStr());
        command.env("IGNIS_TEST_UPDATE_SNAPSHOTS", updateFlag);

        match (command.spawnCapturing()) {
          Result::OK(child) -> children.push(child),
          Result::ERROR(_) -> children.push(Process::Child {
            pid: -1,
            errorReadFd: -1,
            stdoutFd: -1,
            stderrFd: -1,
          }),
        };

        spawnCursor += 1;
      }

      let Option::SOME(testCase) = cases.get(waitCursor) else {
        break;
      };

      let mut failed: boolean = true;

      if (waitCursor < children.length()) {
        let child: &mut Process::Child = match (children.getMut(waitCursor)) {
          Option::SOME(value) -> value,
          Option::NONE -> @panic("unreachable: TestRunner::execute lost a child slot"),
        };

        if (child.pid != -1) {
          let outcome: ProcessOutcome = TestRunner::waitWithTimeout(child, timeoutSeconds);

          if (!outcome.spawnFailed) {
            let reportedError: String = outcome.timedOut ? TestRunner::formatTimeoutFailure(timeoutSeconds) : outcome.stderr.clone();

            outcomes.push(TestOutcome {
              fqName: testCase.fqName.clone(),
              success: outcome.success,
              exitCode: outcome.exitCode,
              stdout: outcome.stdout.clone(),
              stderr: reportedError,
            });

            failed = false;
          }
        }
      }

      if (failed) {
        outcomes.push(TestOutcome {
          fqName: testCase.fqName.clone(),
          success: false,
          exitCode: 1,
          stdout: String::new(),
          stderr: `failed to run test '${testCase.fqName.toStr()}'`,
        });
      }

      waitCursor += 1;
    }

    return outcomes;
  }

  /// Create every snapshot directory the selected tests may write into.
  ///
  /// `std::test` creates the directory lazily with a check-then-act `mkdir`, so
  /// two concurrent tests sharing a module directory would otherwise race and
  /// fail the loser. Creating them up front removes the race without changing
  /// what the tests themselves do. A failure here is left to the test that
  /// actually needs the directory to report.
  function prepareSnapshotDirectories(cases: &Vector<TestCase>): void {
    let mut prepared: Vector<String> = Vector::new<String>();
    let mut index: u64 = 0;

    while (index < cases.length()) {
      let Option::SOME(testCase) = cases.get(index) else {
        break;
      };

      let mut seen: boolean = false;
      let mut preparedIndex: u64 = 0;

      while (preparedIndex < prepared.length()) {
        let Option::SOME(existing) = prepared.get(preparedIndex) else {
          break;
        };

        if (existing.equals(&testCase.snapshotDir)) {
          seen = true;
          break;
        }

        preparedIndex += 1;
      }

      if (!seen) {
        let _ = Fs::createDirAll(testCase.snapshotDir.toStr());
        prepared.push(testCase.snapshotDir.clone());
      }

      index += 1;
    }
  }

  /// Number of harness processes and `gcc -c` invocations to keep in flight.
  ///
  /// `IGNIS_TEST_JOBS` wins when it parses to a positive decimal number.
  /// Anything else falls back to the host processor count, which is the same
  /// default the host compiler uses.
  function jobLimit(): u64 {
    let Option::SOME(raw) = Env::get("IGNIS_TEST_JOBS") else {
      return Process::availableParallelism();
    };

    let trimmed: String = raw.trimAsciiWhitespace();

    if (trimmed.length() == 0) {
      return Process::availableParallelism();
    }

    let mut parsed: u64 = 0;
    let mut index: u64 = 0;

    while (index < trimmed.length()) {
      let Option::SOME(digit) = trimmed.byteAt(index) else {
        return Process::availableParallelism();
      };

      if (digit < 48 || digit > 57) {
        return Process::availableParallelism();
      }

      parsed = parsed * 10 + ((digit - 48) as u64);
      index += 1;
    }

    if (parsed == 0) {
      return Process::availableParallelism();
    }

    return parsed;
  }

  /// The wall-clock budget one test process is given.
  ///
  /// `--test-timeout` wins, then `IGNIS_TEST_TIMEOUT` when it parses to a
  /// positive decimal number, and the built-in default otherwise.
  function resolvedTimeoutSeconds(explicit: Option<u64>): u64 {
    if (let Option::SOME(seconds) = explicit) {
      return seconds;
    }

    let Option::SOME(raw) = Env::get(TEST_TIMEOUT_ENV) else {
      return DEFAULT_TEST_TIMEOUT_SECONDS;
    };

    let trimmed: String = raw.trimAsciiWhitespace();

    if (trimmed.length() == 0) {
      return DEFAULT_TEST_TIMEOUT_SECONDS;
    }

    let mut parsed: u64 = 0;
    let mut index: u64 = 0;

    while (index < trimmed.length()) {
      let Option::SOME(digit) = trimmed.byteAt(index) else {
        return DEFAULT_TEST_TIMEOUT_SECONDS;
      };

      if (digit < 48 || digit > 57) {
        return DEFAULT_TEST_TIMEOUT_SECONDS;
      }

      parsed = parsed * 10 + ((digit - 48) as u64);
      index += 1;
    }

    if (parsed == 0) {
      return DEFAULT_TEST_TIMEOUT_SECONDS;
    }

    return parsed;
  }

  /// Failure text for a test process the runner had to kill.
  function formatTimeoutFailure(seconds: u64): String {
    return `timed out after ${seconds}s`;
  }

  /// Describes the entry a test run targets, naming the shard when one is
  /// selected.
  function runHeader(entryPath: &Path::PathBuf, partition: &TestPartition): String {
    if (!partition.enabled) {
      return entryPath.toString();
    }

    return `${entryPath.asStr()} (partition ${partition.index}/${partition.count})`;
  }

  /// Builds the full plan: `@test` functions sorted by name first, then the
  /// fixtures in discovery order, with the filter applied to both kinds and the
  /// shard selected across the two of them.
  function buildPlan(
    cases: &Vector<TestCase>,
    fixtures: &Vector<FixtureCase>,
    filter: &String,
    partition: &TestPartition,
  ): TestPlan {
    let plan: TestPlan = TestPlan {
      tests: TestRunner::plan(cases, filter),
      fixtures: FixtureTests::filterCases(fixtures, filter),
    };

    return TestRunner::applyPartition(&plan, partition);
  }

  /// Keeps only the entries this shard owns, counting across the whole plan.
  ///
  /// The plan is built in full first, so every shard agrees on which entry sits
  /// at which index no matter how many of them a shard ends up running.
  function applyPartition(plan: &TestPlan, partition: &TestPartition): TestPlan {
    if (!partition.enabled) {
      let mut everyTest: Vector<TestCase> = Vector::new<TestCase>();
      let mut testIndex: u64 = 0;

      while (testIndex < plan.tests.length()) {
        if (let Option::SOME(testCase) = plan.tests.get(testIndex)) {
          everyTest.push(testCase.clone());
        }

        testIndex += 1;
      }

      let mut everyFixture: Vector<FixtureCase> = Vector::new<FixtureCase>();
      let mut fixtureIndex: u64 = 0;

      while (fixtureIndex < plan.fixtures.length()) {
        if (let Option::SOME(fixture) = plan.fixtures.get(fixtureIndex)) {
          everyFixture.push(fixture.clone());
        }

        fixtureIndex += 1;
      }

      return TestPlan {
        tests: everyTest,
        fixtures: everyFixture,
      };
    }

    let mut selectedTests: Vector<TestCase> = Vector::new<TestCase>();
    let mut selectedFixtures: Vector<FixtureCase> = Vector::new<FixtureCase>();
    let mut position: u64 = 0;
    let mut testIndex: u64 = 0;

    while (testIndex < plan.tests.length()) {
      let Option::SOME(testCase) = plan.tests.get(testIndex) else {
        break;
      };

      if (position % partition.count == partition.index - 1) {
        selectedTests.push(testCase.clone());
      }

      position += 1;
      testIndex += 1;
    }

    let mut fixtureIndex: u64 = 0;

    while (fixtureIndex < plan.fixtures.length()) {
      let Option::SOME(fixture) = plan.fixtures.get(fixtureIndex) else {
        break;
      };

      if (position % partition.count == partition.index - 1) {
        selectedFixtures.push(fixture.clone());
      }

      position += 1;
      fixtureIndex += 1;
    }

    return TestPlan {
      tests: selectedTests,
      fixtures: selectedFixtures,
    };
  }

  /// Waits for `child` to exit, killing it once `timeoutSeconds` elapses.
  ///
  /// `std::process` only offers an unbounded `Child::wait`, so the deadline is
  /// driven here: the exec-status pipe is drained first, then `waitpid` is
  /// polled without blocking until the child is reaped or the budget runs out.
  function waitWithTimeout(child: &mut Process::Child, timeoutSeconds: u64): ProcessOutcome {
    let mut childRef: &mut Process::Child = child;
    let execErrno: i32 = testRunnerDrainExecPipe(childRef.errorReadFd);
    childRef.errorReadFd = -1;

    let Result::OK(started) = Time::MonotonicInstant::now() else {
      return TestRunner::failedProcessOutcome(childRef);
    };

    let mut rawStatus: i32 = 0;
    let mut timedOut: boolean = false;
    let mut reaped: boolean = false;

    while (!reaped) {
      let waitResult: i32 = LibC::Wait::waitpid(
        childRef.pid,
        (&mut rawStatus) as *mut i32,
        PROCESS_WAIT_NO_HANG,
      );

      if (waitResult == childRef.pid) {
        reaped = true;
        break;
      }

      if (waitResult == -1) {
        if (LibC::Errno::get() == LibC::Errno::EINTR) {
          continue;
        }

        return TestRunner::failedProcessOutcome(childRef);
      }

      if (testRunnerElapsedSeconds(&started) >= timeoutSeconds) {
        timedOut = true;
        let _killed: i32 = LibC::Signals::kill(childRef.pid, LibC::Signals::SIGKILL);

        while (true) {
          let finalResult: i32 = LibC::Wait::waitpid(childRef.pid, (&mut rawStatus) as *mut i32, 0);

          if (finalResult == -1 && LibC::Errno::get() == LibC::Errno::EINTR) {
            continue;
          }

          break;
        }

        reaped = true;
        break;
      }

      let _slept: i32 = LibC::Process::usleep(PROCESS_POLL_INTERVAL_MICROS);
    }

    let stdout: String = testRunnerReadCapture(childRef.stdoutFd);
    LibC::File::close(childRef.stdoutFd);
    childRef.stdoutFd = -1;

    let stderr: String = testRunnerReadCapture(childRef.stderrFd);
    LibC::File::close(childRef.stderrFd);
    childRef.stderrFd = -1;

    childRef.pid = -1;

    if (execErrno != 0) {
      return ProcessOutcome {
        success: false,
        exitCode: 1,
        stdout: String::new(),
        stderr: String::new(),
        timedOut: false,
        spawnFailed: true,
      };
    }

    let exitCode: i32 = timedOut ? TIMEOUT_EXIT_CODE : testRunnerWaitStatusCode(rawStatus);

    return ProcessOutcome {
      success: !timedOut && testRunnerWaitStatusSuccess(rawStatus),
      exitCode: exitCode,
      stdout: stdout,
      stderr: stderr,
      timedOut: timedOut,
      spawnFailed: false,
    };
  }

  /// Releases whatever `child` still owns and reports a child the runner could
  /// not observe.
  function failedProcessOutcome(child: &mut Process::Child): ProcessOutcome {
    let mut childRef: &mut Process::Child = child;

    if (childRef.stdoutFd != -1) {
      LibC::File::close(childRef.stdoutFd);
      childRef.stdoutFd = -1;
    }

    if (childRef.stderrFd != -1) {
      LibC::File::close(childRef.stderrFd);
      childRef.stderrFd = -1;
    }

    childRef.pid = -1;

    return ProcessOutcome {
      success: false,
      exitCode: 1,
      stdout: String::new(),
      stderr: String::new(),
      timedOut: false,
      spawnFailed: true,
    };
  }

  /// One failure stream, indented under its label and cut at
  /// `FAILED_TEST_OUTPUT_LIMIT` characters. An all-whitespace stream is
  /// omitted entirely.
  function appendFailedStream(lines: &mut Vector<String>, label: str, output: &String): void {
    let trimmed: String = testRunnerTrimEnd(output).trimAsciiWhitespace();

    if (trimmed.length() == 0) {
      return;
    }

    let display: String = testRunnerTrimEnd(output);
    let characters: u64 = display.toChars().length();
    let mut shown: String = display.clone();
    let mut truncated: boolean = false;

    if (characters > FAILED_TEST_OUTPUT_LIMIT) {
      shown = display.substring(0, FAILED_TEST_OUTPUT_LIMIT as i64);
      truncated = true;
    }

    let mut linesRef: &mut Vector<String> = lines;
    linesRef.push(`  ${label}:`);

    let streamLines: Vector<String> = shown.lines();
    let mut index: u64 = 0;

    while (index < streamLines.length()) {
      let Option::SOME(line) = streamLines.get(index) else {
        break;
      };

      linesRef.push(`    ${line.toStr()}`);
      index += 1;
    }

    if (truncated) {
      linesRef.push(String::create("    [truncated]"));
    }
  }

  /// The host's failure block for one test, one entry per output line.
  function formatFailedTestDetails(outcome: &TestOutcome): Vector<String> {
    let mut lines: Vector<String> = Vector::new<String>();
    lines.push(`- ${outcome.fqName.toStr()} (exit code ${outcome.exitCode})`);

    TestRunner::appendFailedStream(&mut lines, "stderr", &outcome.stderr);
    TestRunner::appendFailedStream(&mut lines, "stdout", &outcome.stdout);

    return lines;
  }

  function countPassed(outcomes: &Vector<TestOutcome>): u64 {
    let mut passed: u64 = 0;
    let mut index: u64 = 0;

    while (index < outcomes.length()) {
      if (let Option::SOME(outcome) = outcomes.get(index) && outcome.success) {
        passed += 1;
      }

      index += 1;
    }

    return passed;
  }

  /// Print the run in the host's shape: one line per test, a failure section,
  /// then the totals. Returns the number of failures.
  function report(outcomes: &Vector<TestOutcome>, binaryPath: &Path::PathBuf): u64 {
    let total: u64 = outcomes.length();
    let passed: u64 = TestRunner::countPassed(outcomes);
    let failed: u64 = total - passed;
    let mut index: u64 = 0;

    while (index < outcomes.length()) {
      let Option::SOME(outcome) = outcomes.get(index) else {
        break;
      };
      let status: str = outcome.success ? "ok" : "FAILED";

      Io::eprintln(`  - ${outcome.fqName.toStr()} ... ${status}`);
      index += 1;
    }

    if (failed > 0) {
      Io::eprintln(TestRunner::sectionHeader("Failures"));

      let mut failureIndex: u64 = 0;

      while (failureIndex < outcomes.length()) {
        let Option::SOME(outcome) = outcomes.get(failureIndex) else {
          break;
        };

        if (outcome.success) {
          failureIndex += 1;
          continue;
        }

        let detailLines: Vector<String> = TestRunner::formatFailedTestDetails(outcome);
        let mut lineIndex: u64 = 0;

        while (lineIndex < detailLines.length()) {
          let Option::SOME(line) = detailLines.get(lineIndex) else {
            break;
          };

          Io::println(`  ${line.toStr()}`);
          lineIndex += 1;
        }

        Io::println(String::new());
        failureIndex += 1;
      }
    }

    Io::eprintln(TestRunner::sectionHeader("Summary"));
    Io::eprintln(`  - ${total} total`);
    Io::eprintln(`  - ${passed} passed`);
    Io::eprintln(`  - ${failed} failed`);
    Io::eprintln(`  Test binary: ${binaryPath.asStr()}`);

    return failed;
  }
}

function testRunnerFixtureNamed(name: str): FixtureCase {
  return FixtureCase {
    name: String::create(name),
    path: Path::PathBuf::create("/corpus/ok/case.ign"),
    mode: FixtureMode::program(),
    modeError: String::new(),
  };
}

function testRunnerCaseNamed(name: str, defIdRaw: u32): TestCase {
  return TestCase {
    fqName: String::create(name),
    symbolName: String::create("symbol"),
    defIdRaw: defIdRaw,
    snapshotDir: String::new(),
  };
}

function testRunnerPlanNames(plan: &TestPlan): String {
  let mut names: String = String::new();
  let mut index: u64 = 0;

  while (index < plan.tests.length()) {
    let Option::SOME(testCase) = plan.tests.get(index) else {
      break;
    };

    if (names.length() > 0) {
      names.pushStr(",");
    }

    names.push(&testCase.fqName);
    index += 1;
  }

  let mut fixtureIndex: u64 = 0;

  while (fixtureIndex < plan.fixtures.length()) {
    let Option::SOME(fixture) = plan.fixtures.get(fixtureIndex) else {
      break;
    };

    if (names.length() > 0) {
      names.pushStr(",");
    }

    names.push(&fixture.name);
    fixtureIndex += 1;
  }

  return names;
}

function testRunnerSamplePlanInput(
  cases: &mut Vector<TestCase>,
  fixtures: &mut Vector<FixtureCase>
): void {
  let mut casesRef: &mut Vector<TestCase> = cases;
  casesRef.push(testRunnerCaseNamed("a::one", 1));
  casesRef.push(testRunnerCaseNamed("a::two", 2));
  casesRef.push(testRunnerCaseNamed("a::three", 3));

  let mut fixturesRef: &mut Vector<FixtureCase> = fixtures;
  fixturesRef.push(testRunnerFixtureNamed("e2e::alpha"));
  fixturesRef.push(testRunnerFixtureNamed("e2e::beta"));
}

/// The plan is the `@test` entries sorted by name, then the fixtures in
/// discovery order.
@test
function testRunnerPlanPutsSortedTestsBeforeFixtures(): void {
  let mut cases: Vector<TestCase> = Vector::new<TestCase>();
  let mut fixtures: Vector<FixtureCase> = Vector::new<FixtureCase>();
  testRunnerSamplePlanInput(&mut cases, &mut fixtures);

  let filter: String = String::new();
  let partition: TestPartition = TestPartition::none();
  let plan: TestPlan = TestRunner::buildPlan(&cases, &fixtures, &filter, &partition);

  Test::assertEq<str>(testRunnerPlanNames(&plan).toStr(), "a::one,a::three,a::two,e2e::alpha,e2e::beta");
}

/// The shard is counted continuously across both kinds of entry, so no entry
/// belongs to two shards and none belongs to none of them.
@test
function testRunnerPartitionKeepsEveryThirdEntryAcrossBothKinds(): void {
  let mut cases: Vector<TestCase> = Vector::new<TestCase>();
  let mut fixtures: Vector<FixtureCase> = Vector::new<FixtureCase>();
  testRunnerSamplePlanInput(&mut cases, &mut fixtures);

  let filter: String = String::new();
  let first: TestPartition = TestPartition::create(1, 3);
  let second: TestPartition = TestPartition::create(2, 3);
  let third: TestPartition = TestPartition::create(3, 3);

  let firstPlan: TestPlan = TestRunner::buildPlan(&cases, &fixtures, &filter, &first);
  let secondPlan: TestPlan = TestRunner::buildPlan(&cases, &fixtures, &filter, &second);
  let thirdPlan: TestPlan = TestRunner::buildPlan(&cases, &fixtures, &filter, &third);

  Test::assertEq<str>(testRunnerPlanNames(&firstPlan).toStr(), "a::one,e2e::alpha");
  Test::assertEq<str>(testRunnerPlanNames(&secondPlan).toStr(), "a::three,e2e::beta");
  Test::assertEq<str>(testRunnerPlanNames(&thirdPlan).toStr(), "a::two");
}

/// The filter runs before the shard, so both halves of a sharded run agree on
/// which entry sits at which position.
@test
function testRunnerPartitionCountsPositionsAfterTheFilter(): void {
  let mut cases: Vector<TestCase> = Vector::new<TestCase>();
  let mut fixtures: Vector<FixtureCase> = Vector::new<FixtureCase>();
  testRunnerSamplePlanInput(&mut cases, &mut fixtures);

  let filter: String = String::create("e2e::");
  let partition: TestPartition = TestPartition::create(2, 2);
  let plan: TestPlan = TestRunner::buildPlan(&cases, &fixtures, &filter, &partition);

  Test::assertEq<str>(testRunnerPlanNames(&plan).toStr(), "e2e::beta");
}

@test
function testRunnerHeaderNamesTheShardOnlyWhenOneWasSelected(): void {
  let entry: Path::PathBuf = Path::PathBuf::create("/project/ignis/main.ign");
  let none: TestPartition = TestPartition::none();
  let shard: TestPartition = TestPartition::create(2, 4);

  Test::assertEq<str>(TestRunner::runHeader(&entry, &none).toStr(), "/project/ignis/main.ign");
  Test::assertEq<str>(
    TestRunner::runHeader(&entry, &shard).toStr(),
    "/project/ignis/main.ign (partition 2/4)",
  );
}

@test
function testRunnerTimeoutPrefersTheExplicitBudget(): void {
  Test::assertEq<u64>(TestRunner::resolvedTimeoutSeconds(Option::SOME(45)), 45);
}

@test
function testRunnerTimeoutFailureNamesWholeSeconds(): void {
  Test::assertEq<str>(TestRunner::formatTimeoutFailure(300).toStr(), "timed out after 300s");
}

@test
function testRunnerNamesModuleSegmentsRelativeToTheSourceRoot(): void {
  let sourceRoot: Path::PathBuf = Path::PathBuf::create("/project/ignis");
  let modulePath: Path::PathBuf = Path::PathBuf::create("/project/ignis/syntax/cursor_tests.ign");
  let segments: String = TestRunner::moduleSegments(&modulePath, &sourceRoot);

  Test::assertEq<str>(segments.toStr(), "syntax::cursor_tests");
}

@test
function testRunnerDropsTheTrailingModSegmentFromAModuleName(): void {
  let sourceRoot: Path::PathBuf = Path::PathBuf::create("/project/ignis");
  let modulePath: Path::PathBuf = Path::PathBuf::create("/project/ignis/build/mod.ign");
  let segments: String = TestRunner::moduleSegments(&modulePath, &sourceRoot);

  Test::assertEq<str>(segments.toStr(), "build");
}

@test
function testRunnerJoinsNamespacesAndTheFunctionIntoOneTestName(): void {
  let sourceRoot: Path::PathBuf = Path::PathBuf::create("/project/ignis");
  let modulePath: Path::PathBuf = Path::PathBuf::create("/project/ignis/analyzer/binder_tests.ign");
  let moduleName: String = TestRunner::moduleSegments(&modulePath, &sourceRoot);
  let namespaceName: String = String::create("Inner");
  let functionName: String = String::create("binderBindConstant");
  let namespaced: String = TestRunner::joinName(&moduleName, &namespaceName);
  let fqName: String = TestRunner::joinName(&namespaced, &functionName);

  Test::assertEq<str>(fqName.toStr(), "analyzer::binder_tests::Inner::binderBindConstant");
}

@test
function testRunnerPlanSortsByNameAndKeepsOnlyFilterMatches(): void {
  let mut cases: Vector<TestCase> = Vector::new<TestCase>();
  cases.push(TestCase {
    fqName: String::create("b::second"),
    symbolName: String::create("second_2"),
    defIdRaw: 2,
    snapshotDir: String::new(),
  });
  cases.push(TestCase {
    fqName: String::create("a::first"),
    symbolName: String::create("first_1"),
    defIdRaw: 1,
    snapshotDir: String::new(),
  });
  cases.push(TestCase {
    fqName: String::create("a::third"),
    symbolName: String::create("third_3"),
    defIdRaw: 3,
    snapshotDir: String::new(),
  });

  let filter: String = String::create("a::");
  let selected: Vector<TestCase> = TestRunner::plan(&cases, &filter);
  let mut names: String = String::new();
  let mut index: u64 = 0;

  while (index < selected.length()) {
    let Option::SOME(testCase) = selected.get(index) else {
      break;
    };

    if (index > 0) {
      names.pushStr(",");
    }

    names.push(&testCase.fqName);
    index += 1;
  }

  Test::assertEq<str>(names.toStr(), "a::first,a::third");
}

@test
function testRunnerHarnessDispatchesEveryTestByName(): void {
  let mut cases: Vector<TestCase> = Vector::new<TestCase>();
  cases.push(TestCase {
    fqName: String::create("syntax::token_tests::keywordLookup"),
    symbolName: String::create("keywordLookup_42"),
    defIdRaw: 42,
    snapshotDir: String::new(),
  });

  let source: String = TestRunner::harnessSource(&cases);

  let expected: String = String::create("#include <stdio.h>\n")
    .concat("#include <stdlib.h>\n")
    .concat("#include <string.h>\n")
    .concat("#include \"ignis_rt.h\"\n\n")
    .concat("extern void keywordLookup_42(void);\n")
    .concat("\nint main(int argc, char** argv) {\n")
    .concat("    ignis_runtime_init((i32)argc, argv);\n")
    .concat("    if (argc != 3 || strcmp(argv[1], \"--ignis-test\") != 0) {\n")
    .concat("        fprintf(stderr, \"Error: expected --ignis-test <name>\\n\");\n")
    .concat("        return 2;\n")
    .concat("    }\n")
    .concat("    if (strcmp(argv[2], \"syntax::token_tests::keywordLookup\") == 0) {\n")
    .concat("        keywordLookup_42();\n")
    .concat("        return 0;\n")
    .concat("    }\n")
    .concat("    fprintf(stderr, \"Error: unknown test %s\\n\", argv[2]);\n")
    .concat("    return 2;\n")
    .concat("}\n");

  Test::assertEq<str>(source.toStr(), expected.toStr());
}

@test
function testRunnerSectionHeaderCarriesTheBulletAsUtf8Bytes(): void {
  let header: String = TestRunner::sectionHeader("Summary");
  let mut prefix: String = String::new();
  let mut index: u64 = 0;

  while (index < 3) {
    if (let Option::SOME(byte) = header.byteAt(index)) {
      let value: String = `${byte}.`;
      prefix.push(&value);
    }

    index += 1;
  }

  let title: String = header.substringBytes(3, header.length());

  Test::assertEq<str>(prefix.toStr(), "226.128.162.");
  Test::assertEq<str>(title.toStr(), " Summary");
}

@test
function testRunnerFailureDetailsIndentEachStreamUnderItsLabel(): void {
  let outcome: TestOutcome = TestOutcome {
    fqName: String::create("a::failing"),
    success: false,
    exitCode: 101,
    stdout: String::new(),
    stderr: String::create("panic: boom\nat line 3\n"),
  };

  let detailLines: Vector<String> = TestRunner::formatFailedTestDetails(&outcome);
  let mut joined: String = String::new();
  let mut index: u64 = 0;

  while (index < detailLines.length()) {
    let Option::SOME(line) = detailLines.get(index) else {
      break;
    };

    if (index > 0) {
      joined.pushStr("\n");
    }

    joined.push(line);
    index += 1;
  }

  let expected: String = String::create("- a::failing (exit code 101)\n")
    .concat("  stderr:\n")
    .concat("    panic: boom\n")
    .concat("    at line 3");

  Test::assertEq<str>(joined.toStr(), expected.toStr());
}
