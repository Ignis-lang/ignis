import Diagnostic, DiagnosticBag, Severity, SourceSpan from "@compiler::diagnostics";

import Env from "std::env";
import Fs from "std::fs";
import Path from "std::path";
import Process from "std::process";
import String from "std::string";
import Test from "std::test";
import Vector from "std::vector";

/// Diagnostic codes for toolchain failures.
export namespace ToolchainDiagnosticCode {
  const COMPILE_FAILED: str = "B4001";
  const ARCHIVE_FAILED: str = "B4002";
  const LINK_FAILED: str = "B4003";
  const UNSUPPORTED_BACKEND: str = "B4004";
}

/// A structured toolchain error with the failing tool name, action, and stderr output.
export record ToolchainError {
  public tool: String;
  public action: String;
  public stderr: String;

  public static new(tool: str, action: str, stderr: str): ToolchainError {
    return ToolchainError {
      tool: String::create(tool),
      action: String::create(action),
      stderr: String::create(stderr),
    };
  }

  /// Format the error for display.
  public format(&self): String {
    let mut out: String = String::create(self.tool.toStr());
    out.pushStr(" ");
    out.push(&self.action);
    out.pushStr(" failed: ");
    out.push(&self.stderr);
    return out;
  }
}

/// Build a synthetic DiagnosticBag for a toolchain failure.
function toolchainErrorDiag(code: str, error: &ToolchainError): DiagnosticBag {
  let message: String = error.format();
  let span: SourceSpan = SourceSpan::new("", 0, 0);

  let mut diagnostic: Diagnostic = Diagnostic::new(
    Severity::ERROR,
    code,
    message.toStr(),
    span,
  );

  diagnostic.addNote(error.stderr.toStr());

  let mut bag: DiagnosticBag = DiagnosticBag::init();
  bag.push(diagnostic);
  return bag;
}

/// GCC-backed C-to-object compiler.
///
/// Invokes `gcc -c <source> -o <output>` with optional include directories and
/// extra compiler flags.  Returns `Result::OK` on zero exit code; returns
/// `Result::ERROR` containing a `DiagnosticBag` with a `B4001` error on failure.
///
/// Mirrors the Rust oracle `compile_to_object` in `crates/ignis_driver/src/link.rs`.
export namespace CCompiler {
  /// The optimization and debug flags a build profile asks the C toolchain for,
  /// followed by the project's own `[build] cflags`.
  ///
  /// The level is always stated, including `-O0`. Leaving it out would hand the
  /// decision to the C driver's own default, which differs between toolchains, so
  /// the same project would be built at levels an order of magnitude apart. The
  /// project flags come last so a project can override what the profile asked for.
  function profileFlags(optLevel: u64, debug: boolean, cflags: &Vector<String>): Vector<String> {
    let mut flags: Vector<String> = Vector::new<String>();
    let level: String = `-O${optLevel}`;
    flags.push(level);

    if (debug) {
      flags.push(String::create("-g"));
    }

    let mut index: u64 = 0;

    while (index < cflags.length()) {
      let Option::SOME(flag) = cflags.get(index) else {
        break;
      };

      flags.push(flag.clone());
      index += 1;
    }

    return flags;
  }

  /// Compile one C source file to an object file.
  ///
  /// - `cc`: compiler executable name (e.g. `"gcc"`); defaults to `"gcc"` when empty.
  /// - `srcPath`: path to the `.c` source file.
  /// - `objPath`: desired output path for the `.o` object.
  /// - `includeDirs`: list of `-I` directories passed to the compiler.
  /// - `extraFlags`: additional flags forwarded verbatim to the compiler.
  function compileObject(
    cc: str,
    srcPath: &Path::PathBuf,
    objPath: &Path::PathBuf,
    includeDirs: &Vector<String>,
    extraFlags: &Vector<String>,
  ): Result<boolean, DiagnosticBag> {
    let compiler: str = cCompilerResolve(cc);

    let mut cmd: Process::Command = Process::Command::new(compiler);
    cmd.arg("-c");
    cmd.arg(srcPath.asStr());
    cmd.arg("-o");
    cmd.arg(objPath.asStr());

    let mut flagIdx: u64 = 0;
    while (flagIdx < extraFlags.length()) {
      let Option::SOME(flag) = extraFlags.get(flagIdx) else {
        break;
      };
      cmd.arg(flag.toStr());
      flagIdx += 1;
    }

    let mut incIdx: u64 = 0;
    while (incIdx < includeDirs.length()) {
      let Option::SOME(dir) = includeDirs.get(incIdx) else {
        break;
      };
      cmd.arg("-I");
      cmd.arg(dir.toStr());
      incIdx += 1;
    }

    match (cmd.output()) {
      Result::OK(out) -> {
        let status: Process::ExitStatus = out.status();

        if (status.success) {
          return Result::OK(true);
        }

        let stderrText: String = out.stderr();
        let error: ToolchainError = ToolchainError::new(compiler, "compilation", stderrText.toStr());
        return Result::ERROR(toolchainErrorDiag(ToolchainDiagnosticCode::COMPILE_FAILED, &error));
      },
      Result::ERROR(ioErr) -> {
        let error: ToolchainError = ToolchainError::new(compiler, "compilation", ioErr.errorMessage());
        return Result::ERROR(toolchainErrorDiag(ToolchainDiagnosticCode::COMPILE_FAILED, &error));
      },
    };

    @panic("unreachable: CCompiler::compileObject match did not return");
  }

  /// Compile every source/object pair, keeping up to `jobs` compilers running.
  ///
  /// Each `gcc -c` writes its own object file, so the units are independent and
  /// only the archive or link step that follows needs all of them present.
  /// Failures are reported in unit order, which keeps the reported diagnostic
  /// independent of which compiler happened to fail first.
  ///
  /// - `sourcePaths` and `objectPaths` are matched by index; trailing entries of
  ///   the longer vector are ignored.
  function compileObjects(
    cc: str,
    sourcePaths: &Vector<Path::PathBuf>,
    objectPaths: &Vector<Path::PathBuf>,
    includeDirs: &Vector<String>,
    extraFlags: &Vector<String>,
    jobs: u64,
  ): Result<boolean, DiagnosticBag> {
    let compiler: str = cCompilerResolve(cc);
    let window: u64 = jobs == 0 ? 1 : jobs;

    let mut unitCount: u64 = sourcePaths.length();
    if (objectPaths.length() < unitCount) {
      unitCount = objectPaths.length();
    }

    // Slot `i` holds the compiler for unit `i`. A slot with `pid == -1` records
    // a spawn that never happened, so slot indices stay aligned with unit order.
    let mut children: Vector<Process::Child> = Vector::new<Process::Child>();
    let mut spawnCursor: u64 = 0;
    let mut waitCursor: u64 = 0;

    while (waitCursor < unitCount) {
      while (spawnCursor < unitCount && (spawnCursor - waitCursor) < window) {
        let Option::SOME(sourcePath) = sourcePaths.get(spawnCursor) else {
          break;
        };
        let Option::SOME(objectPath) = objectPaths.get(spawnCursor) else {
          break;
        };

        let mut cmd: Process::Command = Process::Command::new(compiler);
        cmd.arg("-c");
        cmd.arg(sourcePath.asStr());
        cmd.arg("-o");
        cmd.arg(objectPath.asStr());

        let mut flagIdx: u64 = 0;
        while (flagIdx < extraFlags.length()) {
          let Option::SOME(flag) = extraFlags.get(flagIdx) else {
            break;
          };
          cmd.arg(flag.toStr());
          flagIdx += 1;
        }

        let mut incIdx: u64 = 0;
        while (incIdx < includeDirs.length()) {
          let Option::SOME(dir) = includeDirs.get(incIdx) else {
            break;
          };
          cmd.arg("-I");
          cmd.arg(dir.toStr());
          incIdx += 1;
        }

        match (cmd.spawnCapturing()) {
          Result::OK(child) -> children.push(child),
          Result::ERROR(_) -> children.push(Process::Child {
            pid: -1,
            errorReadFd: -1,
            stdoutFd: -1,
            stderrFd: -1,
          }),
        };

        spawnCursor += 1;
      }

      let mut failure: Option<String> = Option::NONE;

      if (waitCursor < children.length()) {
        let mut child: &mut Process::Child = match (children.getMut(waitCursor)) {
          Option::SOME(value) -> value,
          Option::NONE -> @panic("unreachable: CCompiler::compileObjects lost a compiler slot"),
        };

        if (child.pid == -1) {
          failure = Option::SOME(String::create("could not start the C compiler"));
        } else {
          match (child.wait()) {
            Result::OK(out) -> {
              let status: Process::ExitStatus = out.status();

              if (!status.success) {
                failure = Option::SOME(out.stderr());
              }
            },
            Result::ERROR(ioErr) -> failure = Option::SOME(String::create(ioErr.errorMessage())),
          };
        }
      } else {
        failure = Option::SOME(String::create("could not start the C compiler"));
      }

      if (let Option::SOME(detail) = failure) {
        // Drain the children still in flight so the failing build leaves no
        // zombie compilers and no leaked descriptors behind.
        let mut pending: u64 = waitCursor + 1;

        while (pending < spawnCursor) {
          let mut pendingChild: &mut Process::Child = match (children.getMut(pending)) {
            Option::SOME(value) -> value,
            Option::NONE -> @panic("unreachable: CCompiler::compileObjects lost a compiler slot"),
          };

          if (pendingChild.pid != -1) {
            let _ = pendingChild.wait();
          }

          pending += 1;
        }

        let error: ToolchainError = ToolchainError::new(compiler, "compilation", detail.toStr());
        return Result::ERROR(toolchainErrorDiag(ToolchainDiagnosticCode::COMPILE_FAILED, &error));
      }

      waitCursor += 1;
    }

    return Result::OK(true);
  }
}

/// Resolve the compiler name: use `cc` when non-empty; fall back to `"gcc"`.
function cCompilerResolve(cc: str): str {
  let s: String = String::create(cc);
  let trimmed: String = s.trimAsciiWhitespace();
  if (trimmed.length() == 0) {
    return "gcc";
  }
  return cc;
}

// ---- Test helpers ----

function cCompilerFixtureDir(): Path::PathBuf {
  return match (Env::currentDir()) {
    Result::OK(root) -> root.join("test_cases/selfhost/build/c_compiler").normalize(),
    Result::ERROR(_) -> {
      Test::fail();
      return Path::PathBuf::create("/nonexistent");
    },
  };
}

function cCompilerReadExpected(filename: str): String {
  let path: Path::PathBuf = cCompilerFixtureDir().join(filename);
  return match (Fs::readToString(&path)) {
    Result::OK(text) -> text.trimAsciiWhitespace(),
    Result::ERROR(_) -> {
      Test::fail();
      return String::new();
    },
  };
}

@test
function cCompilerSuccessfulCompile(): void {
  let fixtureDir: Path::PathBuf = cCompilerFixtureDir();
  let srcPath: Path::PathBuf = fixtureDir.join("valid.c");
  let objPath: Path::PathBuf = Path::PathBuf::create("/tmp/ignis_test_compile_valid.o");

  let includes: Vector<String> = Vector::new<String>();
  let flags: Vector<String> = Vector::new<String>();

  let result: Result<boolean, DiagnosticBag> = CCompiler::compileObject(
    "gcc",
    &srcPath,
    &objPath,
    &includes,
    &flags,
  );

  let expected: String = cCompilerReadExpected("expected_compile_ok.txt");
  let mut actual: String = String::create("compile_fail");
  if (let Result::OK(_) = result) {
    actual = String::create("compile_ok");
  }
  Test::assertEq<str>(actual.toStr(), expected.toStr());
}

@test
function cCompilerFailsOnInvalidSource(): void {
  let fixtureDir: Path::PathBuf = cCompilerFixtureDir();
  let srcPath: Path::PathBuf = fixtureDir.join("invalid.c");
  let objPath: Path::PathBuf = Path::PathBuf::create("/tmp/ignis_test_compile_invalid.o");

  let includes: Vector<String> = Vector::new<String>();
  let flags: Vector<String> = Vector::new<String>();

  let result: Result<boolean, DiagnosticBag> = CCompiler::compileObject(
    "gcc",
    &srcPath,
    &objPath,
    &includes,
    &flags,
  );

  let expected: String = cCompilerReadExpected("expected_compile_fail.txt");
  let mut actual: String = String::create("compile_ok");
  if (let Result::ERROR(_) = result) {
    actual = String::create("compile_fail");
  }
  Test::assertEq<str>(actual.toStr(), expected.toStr());
}

@test
function cCompilerDefaultsToGccWhenCcEmpty(): void {
  let fixtureDir: Path::PathBuf = cCompilerFixtureDir();
  let srcPath: Path::PathBuf = fixtureDir.join("valid.c");
  let objPath: Path::PathBuf = Path::PathBuf::create("/tmp/ignis_test_compile_default_cc.o");

  let includes: Vector<String> = Vector::new<String>();
  let flags: Vector<String> = Vector::new<String>();

  // Empty cc string should resolve to gcc and succeed.
  let result: Result<boolean, DiagnosticBag> = CCompiler::compileObject(
    "",
    &srcPath,
    &objPath,
    &includes,
    &flags,
  );

  let expected: String = cCompilerReadExpected("expected_compile_ok.txt");
  let mut actual: String = String::create("compile_fail");
  if (let Result::OK(_) = result) {
    actual = String::create("compile_ok");
  }
  Test::assertEq<str>(actual.toStr(), expected.toStr());
}

function cCompilerFlagsText(flags: &Vector<String>): String {
  let mut text: String = String::new();
  let mut index: u64 = 0;

  while (index < flags.length()) {
    let Option::SOME(flag) = flags.get(index) else {
      break;
    };

    if (index > 0) {
      text.pushStr(" ");
    }

    text.push(flag);
    index += 1;
  }

  return text;
}

function cCompilerNoCflags(): Vector<String> {
  return Vector::new<String>();
}

@test
function cCompilerProfileFlagsStateTheOptimizationLevel(): void {
  let cflags: Vector<String> = cCompilerNoCflags();
  let flags: Vector<String> = CCompiler::profileFlags(2, false, &cflags);
  let text: String = cCompilerFlagsText(&flags);
  Test::assertEq<str>(text.toStr(), "-O2");
}

@test
function cCompilerProfileFlagsStateLevelZeroInsteadOfOmittingIt(): void {
  let cflags: Vector<String> = cCompilerNoCflags();
  let flags: Vector<String> = CCompiler::profileFlags(0, false, &cflags);
  let text: String = cCompilerFlagsText(&flags);
  Test::assertEq<str>(text.toStr(), "-O0");
}

@test
function cCompilerProfileFlagsRequestDebugInfoOnlyWhenAsked(): void {
  let cflags: Vector<String> = cCompilerNoCflags();
  let flags: Vector<String> = CCompiler::profileFlags(2, true, &cflags);
  let text: String = cCompilerFlagsText(&flags);
  Test::assertEq<str>(text.toStr(), "-O2 -g");
}

/// A project's `[build] cflags` reach the C toolchain after the profile flags,
/// which is what lets a project override the level the profile asked for.
@test
function cCompilerProfileFlagsAppendProjectCflags(): void {
  let mut cflags: Vector<String> = Vector::new<String>();
  cflags.push(String::create("-fsanitize=leak"));
  cflags.push(String::create("-fno-omit-frame-pointer"));

  let flags: Vector<String> = CCompiler::profileFlags(1, false, &cflags);
  let text: String = cCompilerFlagsText(&flags);
  Test::assertEq<str>(text.toStr(), "-O1 -fsanitize=leak -fno-omit-frame-pointer");
}

/// Project flags are appended after `-g`, so debug info and the project's own
/// flags never trade places depending on which the profile asked for.
@test
function cCompilerProfileFlagsAppendProjectCflagsAfterDebugInfo(): void {
  let mut cflags: Vector<String> = Vector::new<String>();
  cflags.push(String::create("-Wall"));

  let flags: Vector<String> = CCompiler::profileFlags(0, true, &cflags);
  let text: String = cCompilerFlagsText(&flags);
  Test::assertEq<str>(text.toStr(), "-O0 -g -Wall");
}

@test
function cCompilerErrorDiagHasCode(): void {
  let error: ToolchainError = ToolchainError::new("gcc", "compilation", "error: expected ';'");
  let bag: DiagnosticBag = toolchainErrorDiag(ToolchainDiagnosticCode::COMPILE_FAILED, &error);

  // Bag must be non-empty.
  Test::assert(bag.length() > 0);
}
