import Fs from "std::fs";
import Path from "std::path";
import Process from "std::process";
import String from "std::string";
import Test from "std::test";
import Vector from "std::vector";

import DiagnosticBag, SourceFile from "@compiler::diagnostics";
import ParseOutput, Parser from "@compiler::parser";

import
  BuildArtifacts,
  artifactsAssemblyPath,
  artifactsEmitObject,
  projectArtifacts,
  singleFileArtifacts,
from "./artifacts";
import BuildFingerprint, fingerprintEquals, fingerprintSerialize from "./fingerprint";
import DiscoveredModule from "./module_graph";
import BuildOverrides, DiscoveryResult, Resolver from "./resolver";
import SourceOverrides from "./sources";
import stampProgramFingerprint from "./stamp";
import Backends from "./backend";

/// Unique scratch root for one test process, so parallel runs never share a
/// fixture project.
function driverTestRoot(tag: str): Path::PathBuf {
  let name: String = `ignis_driver_tests_${tag}_${Process::id()}`;
  return Path::PathBuf::create("/tmp").join(name.toStr());
}

function driverContains(text: str, needle: str): boolean {
  let haystack: String = String::create(text);
  let marker: String = String::create(needle);
  return haystack.contains(&marker);
}

function driverWriteText(path: &Path::PathBuf, text: str): void {
  let value: String = String::create(text);
  match (Fs::writeString(path, &value)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> {
      Test::fail();
    },
  };
}

function driverEnsureDir(path: &Path::PathBuf): void {
  match (Fs::createDirAll(path)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> {
      Test::fail();
    },
  };
}

/// A minimal project on disk whose `[build] target` line the caller picks.
///
/// `std = false` keeps discovery self-contained: no std root or manifest is
/// read, which is all a target-selection test needs.
function driverWriteTargetProject(root: &Path::PathBuf, targetLine: str): void {
  let srcDir: Path::PathBuf = root.join("src");
  driverEnsureDir(&srcDir);

  let mut tomlText: String = String::create("[package]\nname = \"qbe-target-test\"\nversion = \"0.1.0\"\n\n[ignis]\nstd = false\n\n[build]\nsource_dir = \"src\"\nentry = \"main.ign\"\n");
  tomlText.pushStr(targetLine);
  let configPath: Path::PathBuf = root.join("ignis.toml");
  let entryPath: Path::PathBuf = srcDir.join("main.ign");
  driverWriteText(&configPath, tomlText.toStr());
  driverWriteText(&entryPath, "function main(): i32 {\n\treturn 0;\n}\n");
}

function driverOverridesWithTarget(target: str): BuildOverrides {
  let mut overrides: BuildOverrides = BuildOverrides::none();
  overrides.target = Option::SOME(String::create(target));
  return overrides;
}

/// Without a declared target or a command-line override, a build targets the
/// C backend.
@test
function driverDefaultsTargetToC(): void {
  let root: Path::PathBuf = driverTestRoot("target_default");
  driverWriteTargetProject(&root, "");

  let overrides: BuildOverrides = BuildOverrides::none();
  let discovery: DiscoveryResult = match (Resolver::discover(&root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<str>(discovery.target.toStr(), "c");
}

/// `target = "qbe"` in `ignis.toml` selects the QBE backend.
@test
function driverReadsQbeTargetFromProjectFile(): void {
  let root: Path::PathBuf = driverTestRoot("target_toml");
  driverWriteTargetProject(&root, "target = \"qbe\"\n");

  let overrides: BuildOverrides = BuildOverrides::none();
  let discovery: DiscoveryResult = match (Resolver::discover(&root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<str>(discovery.target.toStr(), "qbe");
}

/// `--target qbe` on the command line wins over the project file's own value.
@test
function driverCommandLineTargetOverridesProjectFile(): void {
  let root: Path::PathBuf = driverTestRoot("target_override");
  driverWriteTargetProject(&root, "target = \"c\"\n");

  let overrides: BuildOverrides = driverOverridesWithTarget("qbe");
  let discovery: DiscoveryResult = match (Resolver::discover(&root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<str>(discovery.target.toStr(), "qbe");
}

/// Scratch root for one target-selection test, kept inside the repository's
/// `build/qbe-f25/` directory instead of the system temp directory.
function driverF25TestRoot(tag: str): Path::PathBuf {
  let name: String = `f25_target_${tag}_${Process::id()}`;
  let root: Path::PathBuf = Path::PathBuf::create("build/qbe-f25").join(name.toStr());
  driverEnsureDir(&root);

  return root;
}

/// A legacy `target = "iir"` stored in `ignis.toml` still builds with the C
/// backend: pre-qbe compilers accepted every stored value and built it with
/// C, and `ignis init` still emits this value.
@test
function driverReadsLegacyIirTargetAsC(): void {
  let root: Path::PathBuf = driverF25TestRoot("iir");
  driverWriteTargetProject(&root, "target = \"iir\"\n");

  let overrides: BuildOverrides = BuildOverrides::none();
  let discovery: DiscoveryResult = match (Resolver::discover(&root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<str>(discovery.target.toStr(), "c");
}

/// A legacy `target = "none"` stored in `ignis.toml` still builds with the C
/// backend, the same way the pre-qbe compilers treated it.
@test
function driverReadsLegacyNoneTargetAsC(): void {
  let root: Path::PathBuf = driverF25TestRoot("none");
  driverWriteTargetProject(&root, "target = \"none\"\n");

  let overrides: BuildOverrides = BuildOverrides::none();
  let discovery: DiscoveryResult = match (Resolver::discover(&root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<str>(discovery.target.toStr(), "c");
}

/// Any stored target other than `qbe` falls back to the C backend, matching
/// the pre-qbe behavior that accepted every stored value and built it with C.
@test
function driverStoredNonQbeTargetFallsBackToC(): void {
  let root: Path::PathBuf = driverF25TestRoot("wasm");
  driverWriteTargetProject(&root, "target = \"wasm\"\n");

  let overrides: BuildOverrides = BuildOverrides::none();
  let discovery: DiscoveryResult = match (Resolver::discover(&root, &overrides, false)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<str>(discovery.target.toStr(), "c");
}

/// An unknown `--target` value from the command line is rejected the same way.
@test
function driverRejectsUnknownCommandLineTarget(): void {
  let root: Path::PathBuf = driverTestRoot("target_cli_bad");
  driverWriteTargetProject(&root, "");

  let overrides: BuildOverrides = driverOverridesWithTarget("wasm");
  let bag: DiagnosticBag = match (Resolver::discover(&root, &overrides, false)) {
    Result::OK(_) -> {
      Test::fail();
      return;
    },
    Result::ERROR(value) -> value,
  };

  let Option::SOME(diagnostic) = bag.get(0) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(diagnostic.code, "B2004");
  Test::assertEq<boolean>(driverContains(diagnostic.messageText(), "unknown build target"), true);
}

/// A qbe project build emits its translation unit as QBE IL (`.ssa`) with the
/// intermediate assembly beside it, and keeps the object and binary layout.
@test
function driverQbeProjectArtifactsWriteSsaUnit(): void {
  let name: String = String::create("myapp");
  let outDir: Path::PathBuf = Path::PathBuf::create("/tmp/ignis_driver_tests_artifacts/build");
  let outputPath: Option<String> = Option::NONE;

  let artifacts: BuildArtifacts = projectArtifacts("qbe", &name, &outDir, &outputPath);

  Test::assertEq<str>(artifacts.source.toString().toStr(), "/tmp/ignis_driver_tests_artifacts/build/user/src/myapp.ssa");
  Test::assertEq<str>(artifacts.object.toString().toStr(), "/tmp/ignis_driver_tests_artifacts/build/user/obj/myapp.o");
  Test::assertEq<str>(artifacts.executable.toString().toStr(), "/tmp/ignis_driver_tests_artifacts/build/bin/myapp");

  let assembly: Path::PathBuf = artifactsAssemblyPath(&artifacts.object);
  Test::assertEq<str>(assembly.toString().toStr(), "/tmp/ignis_driver_tests_artifacts/build/user/obj/myapp.s");
}

/// A qbe single-file build writes `selfhost_emit.ssa` instead of the C
/// translation unit the bootstrap ladder expects; the C layout is unchanged.
@test
function driverQbeSingleFileArtifactsWriteSsaUnit(): void {
  let none: Option<String> = Option::NONE;
  let qbeArtifacts: BuildArtifacts = singleFileArtifacts("qbe", &none);

  Test::assertEq<str>(qbeArtifacts.source.toString().toStr(), "selfhost_emit.ssa");
  Test::assertEq<str>(qbeArtifacts.object.toString().toStr(), "selfhost_emit.o");

  let cArtifacts: BuildArtifacts = singleFileArtifacts("c", &none);
  Test::assertEq<str>(cArtifacts.source.toString().toStr(), "selfhost_emit.c");
  Test::assertEq<str>(cArtifacts.object.toString().toStr(), "selfhost_emit.o");
}

/// Two builds that differ only in backend must not share a cache stamp.
@test
function driverFingerprintSeparatesBackends(): void {
  let features: Vector<String> = Vector::new<String>();
  let sources: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();

  let cFingerprint: BuildFingerprint = stampProgramFingerprint(
    "0.1.0",
    "x86_64-linux",
    "c",
    "gcc",
    "",
    "profile-hash",
    "manifest-hash",
    &features,
    &sources,
  );
  let qbeFingerprint: BuildFingerprint = stampProgramFingerprint(
    "0.1.0",
    "x86_64-linux",
    "qbe",
    "gcc",
    "",
    "profile-hash",
    "manifest-hash",
    &features,
    &sources,
  );

  Test::assertEq<boolean>(fingerprintEquals(&cFingerprint, &qbeFingerprint), false);

  let serialized: String = fingerprintSerialize(&qbeFingerprint);
  Test::assert(driverContains(serialized.toStr(), "backend=qbe"));
}

/// The qbe backend is admitted only for hosted builds: freestanding stays a
/// C-only mode for now and is rejected with a clear driver diagnostic.
@test
function driverQbeTargetRejectsFreestandingBuilds(): void {
  match (Backends::checkAllowed("c", true)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  match (Backends::checkAllowed("qbe", false)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  let bag: DiagnosticBag = match (Backends::checkAllowed("qbe", true)) {
    Result::OK(_) -> {
      Test::fail();
      return;
    },
    Result::ERROR(value) -> value,
  };

  Test::assertEq<u64>(bag.length(), 1);

  let Option::SOME(diagnostic) = bag.get(0) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(diagnostic.code, "B4004");
  Test::assert(driverContains(diagnostic.messageText(), "freestanding"));
  Test::assert(driverContains(diagnostic.messageText(), "qbe"));
}

/// With `--emit-object` the object takes the `-o` path, because nothing is
/// linked to it; without the flag `-o` keeps naming the binary.
@test
function driverEmitObjectTakesTheOutputPath(): void {
  let none: Option<String> = Option::NONE;
  let outputPath: Option<String> = Option::SOME(String::create("sample.o"));

  let linkedArtifacts: BuildArtifacts = singleFileArtifacts("c", &outputPath);
  let linked: BuildArtifacts = artifactsEmitObject(&linkedArtifacts, &outputPath, false);
  Test::assertEq<str>(linked.object.toString().toStr(), "selfhost_emit.o");
  Test::assertEq<str>(linked.executable.toString().toStr(), "sample.o");

  let emitted: BuildArtifacts = artifactsEmitObject(&linkedArtifacts, &outputPath, true);
  Test::assertEq<str>(emitted.object.toString().toStr(), "sample.o");

  // Without `-o` the object keeps the layout path the build already chose.
  let noOutput: BuildArtifacts = singleFileArtifacts("c", &none);
  let defaulted: BuildArtifacts = artifactsEmitObject(&noOutput, &none, true);
  Test::assertEq<str>(defaulted.object.toString().toStr(), "selfhost_emit.o");
}

/// Two builds that differ only in the resolved linker must not share a cache
/// stamp, and a build with no linker flag keeps the toolchain text it always had.
@test
function driverFingerprintSeparatesLinkers(): void {
  let features: Vector<String> = Vector::new<String>();
  let sources: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();

  let systemFingerprint: BuildFingerprint = stampProgramFingerprint(
    "0.1.0",
    "x86_64-linux",
    "c",
    "gcc",
    "",
    "profile-hash",
    "manifest-hash",
    &features,
    &sources,
  );
  let moldFingerprint: BuildFingerprint = stampProgramFingerprint(
    "0.1.0",
    "x86_64-linux",
    "c",
    "gcc",
    "-fuse-ld=mold",
    "profile-hash",
    "manifest-hash",
    &features,
    &sources,
  );
  let bfdFingerprint: BuildFingerprint = stampProgramFingerprint(
    "0.1.0",
    "x86_64-linux",
    "c",
    "gcc",
    "-fuse-ld=bfd",
    "profile-hash",
    "manifest-hash",
    &features,
    &sources,
  );

  Test::assertEq<boolean>(fingerprintEquals(&systemFingerprint, &moldFingerprint), false);
  Test::assertEq<boolean>(fingerprintEquals(&moldFingerprint, &bfdFingerprint), false);
  Test::assert(!driverContains(systemFingerprint.cc.toStr(), "fuse-ld"));
  Test::assert(driverContains(moldFingerprint.cc.toStr(), "-fuse-ld=mold"));
}

/// A `std = false` project whose entry imports `./helper`, with the two
/// sources the caller picks.
function driverWriteImportProject(root: &Path::PathBuf, mainText: str, helperText: str): void {
  let srcDir: Path::PathBuf = root.join("src");
  driverEnsureDir(&srcDir);

  let configPath: Path::PathBuf = root.join("ignis.toml");
  let mainPath: Path::PathBuf = srcDir.join("main.ign");
  let helperPath: Path::PathBuf = srcDir.join("helper.ign");
  driverWriteText(
    &configPath,
    "[package]\nname = \"discovery-parse-test\"\nversion = \"0.1.0\"\n\n[ignis]\nstd = false\n\n[build]\nsource_dir = \"src\"\nentry = \"main.ign\"\n",
  );
  driverWriteText(&mainPath, mainText);
  driverWriteText(&helperPath, helperText);
}

/// The diagnostics of both bags of `output`, each checked to point at
/// `file`'s own path, counted.
function driverCountDiagnosticsAgainst(output: &ParseOutput, file: &SourceFile): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < output.lexDiagnostics.length()) {
    if (let Option::SOME(diagnostic) = output.lexDiagnostics.get(index)) {
      Test::assertEq<str>(diagnostic.primarySpan.filePath, file.path.asStr());
      count += 1;
    }

    index += 1;
  }

  index = 0;

  while (index < output.parseDiagnostics.length()) {
    if (let Option::SOME(diagnostic) = output.parseDiagnostics.get(index)) {
      Test::assertEq<str>(diagnostic.primarySpan.filePath, file.path.asStr());
      count += 1;
    }

    index += 1;
  }

  return count;
}

/// Discovery hands every module over already parsed, with diagnostics that
/// point at the module's own file, as many as a fresh parse of it reports,
/// and without parsing any module again.
@test
function driverDiscoveryHandsOverEachModuleParsedAgainstItsOwnPath(): void {
  let root: Path::PathBuf = driverTestRoot("discovery_parse");
  driverWriteImportProject(
    &root,
    "import value from \"./helper\";\n\nfunction main(): i32 {\n  return value()\n}\n",
    "export function value(): i32 {\n  return 1 +;\n}\n",
  );

  let overrides: BuildOverrides = BuildOverrides::none();
  let Result::OK(discovered) = Resolver::discover(&root, &overrides, false) else {
    Test::fail();
    return;
  };
  let mut discovery: DiscoveryResult = discovered;
  let sources: SourceOverrides = SourceOverrides::none();
  let mut modulesWithDiagnostics: u64 = 0;
  let mut orderIndex: u64 = 0;

  Test::assertEq<u64>(discovery.order.length(), 2);

  while (orderIndex < discovery.order.length()) {
    let mut nodeIndex: u64 = 0;
    let mut nodePath: String = String::new();

    {
      let Option::SOME(nodeIndexRef) = discovery.order.get(orderIndex) else {
        Test::fail();
        return;
      };
      let Option::SOME(pathText) = discovery.graph.nodePathText(*nodeIndexRef) else {
        Test::fail();
        return;
      };

      nodeIndex = *nodeIndexRef;
      nodePath = pathText;
    }

    let Option::SOME(parsed) = Resolver::takeParsedModule(&mut discovery, nodeIndex, &sources) else {
      Test::fail();
      return;
    };

    Test::assertEq<str>(parsed.file.path.asStr(), nodePath.toStr());

    let handedOver: u64 = driverCountDiagnosticsAgainst(&parsed.output, &parsed.file);
    let fresh: ParseOutput = Parser::parseFileWithFlags(&parsed.file, &discovery.flags);
    Test::assertEq<u64>(handedOver, fresh.lexDiagnostics.length() + fresh.parseDiagnostics.length());

    if (handedOver > 0) {
      modulesWithDiagnostics += 1;
    }

    orderIndex += 1;
  }

  Test::assertEq<u64>(modulesWithDiagnostics, 2);
  Test::assertEq<u64>(discovery.graph.reparsedModules, 0);
}

/// A module whose parse was already taken is read and parsed again, and
/// counted as such.
@test
function driverDiscoveryParsesATakenModuleAgain(): void {
  let root: Path::PathBuf = driverTestRoot("discovery_reparse");
  driverWriteImportProject(
    &root,
    "import value from \"./helper\";\n\nfunction main(): i32 {\n  return value();\n}\n",
    "export function value(): i32 {\n  return 1;\n}\n",
  );

  let overrides: BuildOverrides = BuildOverrides::none();
  let Result::OK(discovered) = Resolver::discover(&root, &overrides, false) else {
    Test::fail();
    return;
  };
  let mut discovery: DiscoveryResult = discovered;
  let sources: SourceOverrides = SourceOverrides::none();

  let first: Option<DiscoveredModule> = Resolver::takeParsedModule(&mut discovery, 0, &sources);
  Test::assertEq<u64>(discovery.graph.reparsedModules, 0);

  let second: Option<DiscoveredModule> = Resolver::takeParsedModule(&mut discovery, 0, &sources);
  Test::assertEq<u64>(discovery.graph.reparsedModules, 1);

  let Option::SOME(firstModule) = first else {
    Test::fail();
    return;
  };
  let Option::SOME(secondModule) = second else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(secondModule.file.path.asStr(), firstModule.file.path.asStr());
  Test::assertEq<u64>(secondModule.output.module.roots.length(), firstModule.output.module.roots.length());
}

/// A module that resolves but cannot be read still fails discovery.
@test
function driverDiscoveryReportsAnUnreadableModule(): void {
  let root: Path::PathBuf = driverTestRoot("discovery_unreadable");
  let srcDir: Path::PathBuf = root.join("src");
  driverWriteImportProject(
    &root,
    "import value from \"./other\";\n\nfunction main(): i32 {\n  return value();\n}\n",
    "export function value(): i32 {\n  return 1;\n}\n",
  );
  let unreadable: Path::PathBuf = srcDir.join("other.ign");
  driverEnsureDir(&unreadable);

  let overrides: BuildOverrides = BuildOverrides::none();
  let Result::ERROR(diagnostics) = Resolver::discover(&root, &overrides, false) else {
    Test::fail();
    return;
  };
  let Option::SOME(diagnostic) = diagnostics.get(0) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(diagnostic.code, "B2001");
  Test::assertEq<str>(diagnostic.messageText(), "module source could not be read");
}
