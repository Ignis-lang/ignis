import Ast from "@compiler::ast";
import
  Diagnostic,
  DiagnosticBag,
  LabelKind,
  Severity,
  SourceFile,
  SourceSpan,
from "@compiler::diagnostics";
import CompileFlags, Parser from "@compiler::parser";
import AliasBinding, Config, ResolvedProject from "@compiler::config";

import Env from "std::env";
import Fs from "std::fs";
import Path from "std::path";
import Sort from "std::sort";
import String from "std::string";
import Test from "std::test";
import Vector from "std::vector";

import BuildGraph, BuildModuleKind, ModuleGraph from "./module_graph";
import Manifest, StdManifest from "./manifest";

const MISSING_MODULE: str = "B2001";
const AMBIGUOUS_IMPORT: str = "B2002";
const CYCLIC_IMPORT: str = "B2003";
const INVALID_BUILD_PROFILE: str = "B2004";

/// Highest optimization level the C toolchain is asked for, matching the host
/// driver's own bound.
const MAX_OPT_LEVEL: u64 = 3;

record ResolvedImportTarget {
  public path: Path::PathBuf;
  public kind: BuildModuleKind;
}

record ParsedImport {
  public source: String;
  public span: SourceSpan;
}

record ResolverAlias {
  public name: String;
  public path: Path::PathBuf;
}

record ResolverProject {
  public root: Path::PathBuf;
  public sourceRoot: Path::PathBuf;
  public entry: Path::PathBuf;
  public stdRoot: Path::PathBuf;
  public stdManifestPath: Path::PathBuf;
  public aliases: Vector<ResolverAlias>;
  public flags: CompileFlags;
  public optLevel: u64;
  public cflags: Vector<String>;
  public outDir: Path::PathBuf;
  public name: String;
  public cc: String;
  public bin: boolean;
  public emitC: boolean;
  /// False when discovery ran without an `ignis.toml`, which is what a
  /// single-file build does.
  public hasProjectFile: boolean;
  /// `[ignis] std`, which a fixture that forces the standard library on has to
  /// find enabled.
  public stdEnabled: boolean;
  /// `[test] fixtures`, already resolved against the project root.
  public testFixtures: Vector<Path::PathBuf>;
}

/// Command-line values a build applies on top of what the project file declares.
export record BuildOverrides {
  public debug: Option<boolean>;
  public features: Vector<String>;
  public stdPath: Option<String>;
  public targetTriple: Option<String>;
  public cc: Option<String>;
  public outDir: Option<String>;

  public static none(): BuildOverrides {
    return BuildOverrides {
      debug: Option::NONE,
      features: Vector::new<String>(),
      stdPath: Option::NONE,
      targetTriple: Option::NONE,
      cc: Option::NONE,
      outDir: Option::NONE,
    };
  }

  public static withOptions(debug: Option<boolean>, features: &Vector<String>): BuildOverrides {
    let mut overrides: BuildOverrides = BuildOverrides::none();
    overrides.debug = debug;
    overrides.features = resolverCloneStrings(features);
    return overrides;
  }
}

record AliasResolution {
  public basePath: Path::PathBuf;
  public remainder: String;
}

export record DiscoveryResult {
  public graph: BuildGraph;
  public order: Vector<u64>;
  /// Absolute paths of the std modules the manifest auto-loads. Every module
  /// sees their declarations without importing them, which is what makes
  /// `Option`, `String` and the rest usable anywhere.
  public preludePaths: Vector<Path::PathBuf>;
  /// Absolute std root the project resolved to, so later build stages can
  /// locate the runtime headers and archive without re-reading the config.
  public stdRoot: Path::PathBuf;
  /// Compile-time configuration discovery parsed the project with. The build
  /// has to parse every module again with the same one, or the two passes
  /// would disagree on which branches exist.
  public flags: CompileFlags;
  /// `[build] opt_level` from the project file, handed to the C toolchain as
  /// `-O<level>` so the level never depends on the host driver's own default.
  public optLevel: u64;
  /// `[build] cflags` from the project file, forwarded verbatim to the C
  /// toolchain after the profile flags so a project can override them.
  public cflags: Vector<String>;
  /// Absolute `[build] out_dir`, the root every build artifact is written under
  /// in project mode.
  public outDir: Path::PathBuf;
  /// `[package] name`, which names the binary a project build links.
  public name: String;
  /// `[build] cc`, the C toolchain driver every toolchain step is invoked with.
  public cc: String;
  /// `[build] bin`: whether a project build links an executable.
  public bin: boolean;
  /// True when `[build] emit` asks for the generated C to be kept.
  public emitC: boolean;
  /// The entry module the build starts from.
  public entry: Path::PathBuf;
  /// False when discovery ran without an `ignis.toml`.
  public hasProjectFile: boolean;
  /// The project root every relative fixture directory is resolved against.
  public root: Path::PathBuf;
  /// `[ignis] std`, which a fixture forcing the standard library on consults.
  public stdEnabled: boolean;
  /// `[test] fixtures`, already resolved against the project root.
  public testFixtures: Vector<Path::PathBuf>;

  public orderCount(&self): u64 {
    return self.order.length();
  }
}

function resolverFixturePath(relativePath: str): Path::PathBuf {
  match (Env::currentDir()) {
    Result::OK(root) -> {
      return root.join(relativePath).normalize();
    },
    Result::ERROR(_) -> {
      Test::fail();
      return Path::PathBuf::new();
    },
  };

  return Path::PathBuf::new();
}

function resolverReadText(path: &Path::PathBuf): String {
  match (Fs::readToString(path)) {
    Result::OK(text) -> {
      return text;
    },
    Result::ERROR(_) -> {
      Test::fail();
      return String::new();
    },
  };

  return String::new();
}

function resolverPathEquals(left: &Path::PathBuf, right: &Path::PathBuf): boolean {
  let leftText: String = left.toString();
  let rightText: String = right.toString();
  return leftText.equals(&rightText);
}

function resolverPathInStack(stack: &mut Vector<Path::PathBuf>, path: &Path::PathBuf): boolean {
  let mut index: u64 = 0;

  while (index < stack.length()) {
    let Option::SOME(candidate) = stack.get(index) else {
      break;
    };

    if (resolverPathEquals(candidate, path)) {
      return true;
    }

    index += 1;
  }

  return false;
}

function resolverClonePathStack(stack: &mut Vector<Path::PathBuf>): Vector<Path::PathBuf> {
  let mut copy: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  let mut index: u64 = 0;

  while (index < stack.length()) {
    let Option::SOME(path) = stack.get(index) else {
      break;
    };

    copy.push(path.clone());
    index += 1;
  }

  return copy;
}

function resolverPathSpan(path: &Path::PathBuf, start: u64, end: u64): SourceSpan {
  let pathText: String = path.toString();
  return SourceSpan::new(pathText.toStr(), start, end);
}

function resolverSingleDiagnostic(diagnostic: Diagnostic): DiagnosticBag {
  let mut bag: DiagnosticBag = DiagnosticBag::init();
  bag.push(diagnostic);
  return bag;
}

function resolverSimpleDiagnostic(path: &Path::PathBuf, code: str, message: str): DiagnosticBag {
  let diagnostic: Diagnostic = Diagnostic::new(
    Severity::ERROR,
    code,
    message,
    resolverPathSpan(path, 0, 0),
  );
  return resolverSingleDiagnostic(diagnostic);
}

function resolverClonePaths(source: &Vector<Path::PathBuf>): Vector<Path::PathBuf> {
  let mut result: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  let mut index: u64 = 0;

  while (index < source.length()) {
    let Option::SOME(value) = source.get(index) else {
      break;
    };

    result.push(value.clone());
    index += 1;
  }

  return result;
}

function resolverCloneStrings(source: &Vector<String>): Vector<String> {
  let mut result: Vector<String> = Vector::new<String>();
  let mut index: u64 = 0;

  while (index < source.length()) {
    let Option::SOME(value) = source.get(index) else {
      break;
    };

    result.push(value.clone());
    index += 1;
  }

  return result;
}

function resolverPushMissingStrings(target: &mut Vector<String>, source: &Vector<String>): void {
  let mut targetRef: &mut Vector<String> = target;
  let mut index: u64 = 0;

  while (index < source.length()) {
    let Option::SOME(value) = source.get(index) else {
      break;
    };

    let mut existingIndex: u64 = 0;
    let mut alreadyPresent: boolean = false;

    while (existingIndex < targetRef.length()) {
      let Option::SOME(existing) = targetRef.get(existingIndex) else {
        break;
      };

      if (existing.equals(value)) {
        alreadyPresent = true;
        break;
      }

      existingIndex += 1;
    }

    if (!alreadyPresent) {
      targetRef.push(value.clone());
    }

    index += 1;
  }
}

function resolverFindProjectFile(startPath: &Path::PathBuf): Option<Path::PathBuf> {
  let mut current: Path::PathBuf = startPath.clone();

  if (let Result::OK(metadata) = Fs::metadata(startPath)) {
    if (metadata.isFile()) {
      let Option::SOME(parent) = startPath.parent() else {
        return Option::NONE;
      };
      current = parent;
    }
  }

  while (true) {
    let candidate: Path::PathBuf = current.join("ignis.toml");
    if (Fs::exists(candidate.asStr())) {
      return Option::SOME(candidate.clone());
    }

    let Option::SOME(parent) = current.parent() else {
      return Option::NONE;
    };
    current = parent;
  }

  return Option::NONE;
}

function resolverCanonicalPath(
  path: &Path::PathBuf,
  message: str
): Result<Path::PathBuf, DiagnosticBag> {
  if (!Fs::exists(path.asStr())) {
    return Result::ERROR(resolverSimpleDiagnostic(path, MISSING_MODULE, message));
  }

  let Result::OK(canonical) = Fs::canonicalize(path) else {
    return Result::ERROR(resolverSimpleDiagnostic(path, MISSING_MODULE, message));
  };

  return Result::OK(canonical);
}

/// Maps the aliases the project file declared onto the resolver's own form.
function resolverAliasesFrom(bindings: &Vector<AliasBinding>): Vector<ResolverAlias> {
  let mut aliases: Vector<ResolverAlias> = Vector::new<ResolverAlias>();
  let mut index: u64 = 0;

  while (index < bindings.length()) {
    let Option::SOME(binding) = bindings.get(index) else {
      break;
    };

    aliases.push(ResolverAlias {
      name: binding.name.clone(),
      path: binding.path.clone(),
    });
    index += 1;
  }

  return aliases;
}

/// True when `[build] emit` asks for the generated C to be kept on disk.
function resolverEmitsC(emit: &Vector<String>): boolean {
  let mut index: u64 = 0;

  while (index < emit.length()) {
    let Option::SOME(value) = emit.get(index) else {
      break;
    };

    if (value.equals("c")) {
      return true;
    }

    index += 1;
  }

  return false;
}

/// Resolve the std root a build reads its modules from.
///
/// `--std-path` wins over what the project file resolved, which is what the
/// host driver does with the same flag.
function resolverStdRoot(
  configPath: &Path::PathBuf,
  declared: &Option<Path::PathBuf>,
  overrides: &BuildOverrides,
): Result<Path::PathBuf, DiagnosticBag> {
  if (let Option::SOME(stdPath) = &overrides.stdPath) {
    let candidate: Path::PathBuf = Path::PathBuf::fromString(&stdPath).normalize();
    return resolverCanonicalPath(&candidate, "std root could not be resolved");
  }

  return match (declared) {
    Option::SOME(path) -> Result::OK(path.clone()),
    Option::NONE -> Result::ERROR(
      resolverSimpleDiagnostic(configPath, MISSING_MODULE, "std root could not be resolved"),
    ),
  };
}

/// The target triple the compile-time predicates are answered with.
function resolverTargetTriple(declared: &Option<String>, overrides: &BuildOverrides): String {
  if (let Option::SOME(triple) = &overrides.targetTriple) {
    return triple.clone();
  }

  return match (declared) {
    Option::SOME(triple) -> triple.clone(),
    Option::NONE -> CompileFlags::defaultTargetTriple(),
  };
}

/// The name a project build gives the binary it links.
function resolverProjectName(declared: &Option<String>, root: &Path::PathBuf): String {
  if (let Option::SOME(name) = declared) {
    return name.clone();
  }

  return match (root.fileName()) {
    Option::SOME(name) -> name,
    Option::NONE -> String::create("out"),
  };
}

/// Drops a file name's extension, so `main.ign` names the binary `main`.
function resolverStemOf(fileName: &String): String {
  let Option::SOME(dotIndex) = fileName.findLastByte((byte: u8): boolean -> {
    return byte == '.' as u8;
  }) else {
    return fileName.clone();
  };

  if (dotIndex == 0) {
    return fileName.clone();
  }

  return fileName.substringBytes(0, dotIndex);
}

/// Loads the project the compile-time predicates are answered from.
///
/// The project file is read by the shared TOML loader in `@compiler::config`,
/// so a build and `ignis check` see exactly the same fields, including the ones
/// a line-based reader cannot see, such as an array spread over several lines.
///
/// `overrides` comes from the command line. A CLI override wins over the
/// project file's own value; with neither set, the project file's defaults
/// apply.
function resolverLoadProject(
  startPath: &Path::PathBuf,
  overrides: &BuildOverrides,
): Result<ResolverProject, DiagnosticBag> {
  let Option::SOME(configPath) = Config::findProjectFile(startPath) else {
    return Result::ERROR(resolverSimpleDiagnostic(startPath, MISSING_MODULE, "ignis.toml could not be found"));
  };

  let resolved: ResolvedProject = Config::loadProjectFile(&configPath)!;

  let Option::SOME(root) = &resolved.root else {
    return Result::ERROR(resolverSimpleDiagnostic(&configPath, MISSING_MODULE, "project root could not be resolved"));
  };
  let Option::SOME(sourceRoot) = &resolved.sourceDir else {
    return Result::ERROR(
      resolverSimpleDiagnostic(&configPath, MISSING_MODULE, "source directory could not be resolved"),
    );
  };

  if (resolved.optLevel > MAX_OPT_LEVEL) {
    return Result::ERROR(resolverSimpleDiagnostic(
      &configPath,
      INVALID_BUILD_PROFILE,
      "build.opt_level must be an integer between 0 and 3",
    ));
  }

  let stdRoot: Path::PathBuf = resolverStdRoot(&configPath, &resolved.stdRoot, overrides)!;
  let manifestCandidate: Path::PathBuf = stdRoot.join("manifest.toml");
  let stdManifestPath: Path::PathBuf = resolverCanonicalPath(&manifestCandidate, "std manifest could not be resolved")!;

  let mut features: Vector<String> = Vector::new<String>();
  resolverPushMissingStrings(&mut features, &overrides.features);
  resolverPushMissingStrings(&mut features, &resolved.defaultFeatures);

  let targetTriple: String = resolverTargetTriple(&resolved.targetTriple, overrides);
  let debug: boolean = overrides.debug.unwrapOr(resolved.debug);

  let mut outDir: Path::PathBuf = match (&resolved.outDir) {
    Option::SOME(path) -> path.clone(),
    Option::NONE -> root.join("build"),
  };

  if (let Option::SOME(value) = &overrides.outDir) {
    outDir = Path::PathBuf::fromString(&value).normalize();
  }

  let mut cc: String = resolved.cc.clone();

  if (let Option::SOME(value) = &overrides.cc) {
    cc = value.clone();
  }

  return Result::OK(ResolverProject {
    root: root.clone(),
    sourceRoot: sourceRoot.clone(),
    entry: resolved.entry.clone(),
    stdRoot: stdRoot,
    stdManifestPath: stdManifestPath,
    aliases: resolverAliasesFrom(&resolved.aliases),
    flags: CompileFlags::create(&targetTriple, debug, &features, &resolved.knownFeatures),
    optLevel: resolved.optLevel,
    cflags: resolverCloneStrings(&resolved.cflags),
    outDir: outDir,
    name: resolverProjectName(&resolved.packageName, &root),
    cc: cc,
    bin: resolved.bin,
    emitC: resolverEmitsC(&resolved.emit),
    hasProjectFile: true,
    stdEnabled: resolved.stdEnabled,
    testFixtures: resolverClonePaths(&resolved.testFixtures),
  });
}

/// Resolves the std root when no project file declares one.
///
/// `--std-path` wins over `IGNIS_STD_PATH`, which is the order the host driver
/// resolves the same two inputs in.
function resolverEnvironmentStdRoot(
  reportPath: &Path::PathBuf,
  overrides: &BuildOverrides,
): Result<Path::PathBuf, DiagnosticBag> {
  let mut stdPathText: Option<String> = Option::NONE;

  match (&overrides.stdPath) {
    Option::SOME(value) -> {
      stdPathText = Option::SOME(value.clone());
    },
    Option::NONE -> {
      if (let Result::OK(value) = Env::var("IGNIS_STD_PATH")) {
        stdPathText = Option::SOME(value.clone());
      }
    },
  };

  let Option::SOME(stdPath) = stdPathText else {
    return Result::ERROR(resolverSimpleDiagnostic(
      reportPath,
      MISSING_MODULE,
      "std_path not set. Use --std-path or set IGNIS_STD_PATH env var",
    ));
  };

  let stdCandidate: Path::PathBuf = Path::PathBuf::fromString(&stdPath).normalize();
  return resolverCanonicalPath(&stdCandidate, "std root could not be resolved");
}

/// Builds the project a single source file is compiled under when no
/// `ignis.toml` governs it.
///
/// The std root comes from `--std-path` or `IGNIS_STD_PATH`, the way the host
/// driver resolves it in single-file mode, and the entry's own directory is the
/// source root. No aliases exist, because only a project file declares them.
function resolverSingleFileProject(
  entryPath: &Path::PathBuf,
  overrides: &BuildOverrides,
): Result<ResolverProject, DiagnosticBag> {
  let entry: Path::PathBuf = resolverCanonicalPath(entryPath, "entry file could not be resolved")!;
  let Option::SOME(sourceRoot) = entry.parent() else {
    return Result::ERROR(resolverSimpleDiagnostic(&entry, MISSING_MODULE, "source directory could not be resolved"));
  };

  let stdRoot: Path::PathBuf = resolverEnvironmentStdRoot(&entry, overrides)!;
  let manifestCandidate: Path::PathBuf = stdRoot.join("manifest.toml");
  let stdManifestPath: Path::PathBuf = resolverCanonicalPath(&manifestCandidate, "std manifest could not be resolved")!;

  let mut features: Vector<String> = Vector::new<String>();
  resolverPushMissingStrings(&mut features, &overrides.features);

  let knownFeatures: Vector<String> = Vector::new<String>();
  let declaredTriple: Option<String> = Option::NONE;
  let targetTriple: String = resolverTargetTriple(&declaredTriple, overrides);
  let debug: boolean = overrides.debug.unwrapOr(false);

  let mut outDir: Path::PathBuf = sourceRoot.join("build");

  if (let Option::SOME(value) = &overrides.outDir) {
    outDir = Path::PathBuf::fromString(&value).normalize();
  }

  let mut cc: String = String::create("cc");

  if (let Option::SOME(value) = &overrides.cc) {
    cc = value.clone();
  }

  let name: String = match (entry.fileName()) {
    Option::SOME(fileName) -> resolverStemOf(&fileName),
    Option::NONE -> String::create("out"),
  };

  return Result::OK(ResolverProject {
    root: sourceRoot.clone(),
    sourceRoot: sourceRoot.clone(),
    entry: entry.clone(),
    stdRoot: stdRoot,
    stdManifestPath: stdManifestPath,
    aliases: Vector::new<ResolverAlias>(),
    flags: CompileFlags::create(&targetTriple, debug, &features, &knownFeatures),
    optLevel: 0,
    cflags: Vector::new<String>(),
    outDir: outDir,
    name: name,
    cc: cc,
    bin: true,
    emitC: false,
    hasProjectFile: false,
    stdEnabled: true,
    testFixtures: Vector::new<Path::PathBuf>(),
  });
}

/// Builds the project a standard-library build runs under when no `ignis.toml`
/// governs the directory it started from.
///
/// Only the std root matters here: nothing else is compiled, so the entry and
/// the source root are the directory the command ran against.
function resolverStdOnlyProject(
  startPath: &Path::PathBuf,
  overrides: &BuildOverrides,
): Result<ResolverProject, DiagnosticBag> {
  let stdRoot: Path::PathBuf = resolverEnvironmentStdRoot(startPath, overrides)!;
  let manifestCandidate: Path::PathBuf = stdRoot.join("manifest.toml");
  let stdManifestPath: Path::PathBuf = resolverCanonicalPath(&manifestCandidate, "std manifest could not be resolved")!;

  let mut features: Vector<String> = Vector::new<String>();
  resolverPushMissingStrings(&mut features, &overrides.features);

  let knownFeatures: Vector<String> = Vector::new<String>();
  let declaredTriple: Option<String> = Option::NONE;
  let targetTriple: String = resolverTargetTriple(&declaredTriple, overrides);
  let debug: boolean = overrides.debug.unwrapOr(false);

  let mut outDir: Path::PathBuf = startPath.join("build");

  if (let Option::SOME(value) = &overrides.outDir) {
    outDir = Path::PathBuf::fromString(&value).normalize();
  }

  let mut cc: String = String::create("cc");

  if (let Option::SOME(value) = &overrides.cc) {
    cc = value.clone();
  }

  return Result::OK(ResolverProject {
    root: startPath.clone(),
    sourceRoot: startPath.clone(),
    entry: startPath.clone(),
    stdRoot: stdRoot,
    stdManifestPath: stdManifestPath,
    aliases: Vector::new<ResolverAlias>(),
    flags: CompileFlags::create(&targetTriple, debug, &features, &knownFeatures),
    optLevel: 0,
    cflags: Vector::new<String>(),
    outDir: outDir,
    name: String::create("std"),
    cc: cc,
    bin: false,
    emitC: false,
    hasProjectFile: false,
    stdEnabled: true,
    testFixtures: Vector::new<Path::PathBuf>(),
  });
}

function resolverMissingModuleDiagnostic(
  currentFile: &Path::PathBuf,
  importSource: &String,
  span: SourceSpan
): DiagnosticBag {
  let mut diagnostic: Diagnostic = Diagnostic::new(
    Severity::ERROR,
    MISSING_MODULE,
    String::create("module '").concat(importSource).concat("' could not be resolved").toStr(),
    span,
  );
  diagnostic.addLabel(LabelKind::PRIMARY, span, "unresolved import");

  let fileText: String = currentFile.toString();
  diagnostic.addNote(String::create("while resolving imports for ").concat(&fileText).toStr());

  return resolverSingleDiagnostic(diagnostic);
}

function resolverAmbiguousImportDiagnostic(
  currentFile: &Path::PathBuf,
  importSource: &String,
  span: SourceSpan,
  firstCandidate: &Path::PathBuf,
  secondCandidate: &Path::PathBuf,
): DiagnosticBag {
  let mut diagnostic: Diagnostic = Diagnostic::new(
    Severity::ERROR,
    AMBIGUOUS_IMPORT,
    String::create("import '").concat(importSource).concat("' resolves to multiple modules").toStr(),
    span,
  );
  diagnostic.addLabel(LabelKind::PRIMARY, span, "ambiguous import");

  let fileText: String = currentFile.toString();
  let firstText: String = firstCandidate.toString();
  let secondText: String = secondCandidate.toString();
  diagnostic.addNote(String::create("while resolving imports for ").concat(&fileText).toStr());
  diagnostic.addNote(String::create("candidate: ").concat(&firstText).toStr());
  diagnostic.addNote(String::create("candidate: ").concat(&secondText).toStr());

  return resolverSingleDiagnostic(diagnostic);
}

function resolverCycleDiagnostic(cycle: &Vector<Path::PathBuf>): DiagnosticBag {
  let Option::SOME(firstPath) = cycle.get(0) else {
    let fallback: Path::PathBuf = Path::PathBuf::create("<cycle>");
    let diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      CYCLIC_IMPORT,
      "cyclic module import detected",
      resolverPathSpan(&fallback, 0, 0),
    );
    return resolverSingleDiagnostic(diagnostic);
  };

  let mut diagnostic: Diagnostic = Diagnostic::new(
    Severity::ERROR,
    CYCLIC_IMPORT,
    "cyclic module import detected",
    resolverPathSpan(firstPath, 0, 0),
  );

  let cycleText: String = resolverCycleText(cycle);
  diagnostic.addNote(String::create("cycle: ").concat(&cycleText).toStr());

  return resolverSingleDiagnostic(diagnostic);
}

function resolverCycleText(cycle: &Vector<Path::PathBuf>): String {
  let mut text: String = String::new();
  let mut index: u64 = 0;

  while (index < cycle.length()) {
    let Option::SOME(path) = cycle.get(index) else {
      break;
    };

    if (index > 0) {
      text.pushStr(" -> ");
    }

    let pathText: String = path.toString();
    text.push(&pathText);
    index += 1;
  }

  return text;
}

function resolverFirstSegment(source: &String): String {
  let separator: String = String::create("::");
  return match (source.indexOf(&separator)) {
    Option::SOME(index) -> source.substringBytes(0, index),
    Option::NONE -> source.clone(),
  };
}

function resolverRestSegments(source: &String): Option<String> {
  let separator: String = String::create("::");
  return match (source.indexOf(&separator)) {
    Option::SOME(index) -> Option::SOME(source.substringBytes(index + separator.length(), source.length())),
    Option::NONE -> Option::NONE,
  };
}

function resolverReplaceModuleSeparators(text: &String): String {
  let mut result: String = String::new();
  let mut index: u64 = 0;

  while (index < text.length()) {
    let Option::SOME(current) = text.charAt(index) else {
      break;
    };

    if (current == ':' && index + 1 < text.length()) {
      let Option::SOME(next) = text.charAt(index + 1) else {
        break;
      };

      if (next == ':') {
        result.pushChar('/');
        index += 2;
        continue;
      }
    }

    result.pushChar(current);
    index += 1;
  }

  return result;
}

function resolverMergeAliasSegments(remainder: &String, rest: &String): String {
  let mergedPrefix: String = remainder.concat("::");
  let merged: String = mergedPrefix.concat(rest);
  return resolverReplaceModuleSeparators(&merged);
}

function resolverJoinAliasRemainder(remainder: &String, rest: &Option<String>): String {
  if (remainder.length() == 0) {
    return match (rest) {
      Option::SOME(value) -> resolverReplaceModuleSeparators(&value),
      Option::NONE -> String::new(),
    };
  }

  return match (rest) {
    Option::SOME(value) -> resolverMergeAliasSegments(remainder, &value),
    Option::NONE -> resolverReplaceModuleSeparators(remainder),
  };
}

function resolverPathWithIgnExtension(basePath: &Path::PathBuf): Path::PathBuf {
  let pathText: String = basePath.toString().concat(".ign");
  return Path::PathBuf::fromString(&pathText).normalize();
}

function resolverCanonicalizeExisting(path: &Path::PathBuf): Result<Path::PathBuf, DiagnosticBag> {
  let Result::OK(canonical) = Fs::canonicalize(path) else {
    let span: SourceSpan = resolverPathSpan(path, 0, 0);
    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      MISSING_MODULE,
      "module path could not be canonicalized",
      span,
    );
    diagnostic.addLabel(LabelKind::PRIMARY, span, "filesystem resolution failed");
    return Result::ERROR(resolverSingleDiagnostic(diagnostic));
  };

  return Result::OK(canonical);
}

function resolverResolveFsPath(
  currentFile: &Path::PathBuf,
  importSource: &String,
  span: SourceSpan,
  basePath: &Path::PathBuf,
): Result<Path::PathBuf, DiagnosticBag> {
  match (basePath.extension()) {
    Option::SOME(_) -> {
      if (!Fs::exists(basePath.asStr())) {
        return Result::ERROR(resolverMissingModuleDiagnostic(currentFile, importSource, span));
      }

      return resolverCanonicalizeExisting(basePath);
    },
    Option::NONE -> {},
  };

  let fileCandidate: Path::PathBuf = resolverPathWithIgnExtension(basePath);
  let modCandidate: Path::PathBuf = basePath.join("mod.ign");
  let hasFileCandidate: boolean = Fs::exists(fileCandidate.asStr());
  let hasModCandidate: boolean = Fs::exists(modCandidate.asStr());

  if (hasFileCandidate && hasModCandidate) {
    return Result::ERROR(resolverAmbiguousImportDiagnostic(currentFile, importSource, span, &fileCandidate, &modCandidate));
  }

  if (hasFileCandidate) {
    return resolverCanonicalizeExisting(&fileCandidate);
  }

  if (hasModCandidate) {
    return resolverCanonicalizeExisting(&modCandidate);
  }

  return Result::ERROR(resolverMissingModuleDiagnostic(currentFile, importSource, span));
}

function resolverAliasMatch(
  project: &ResolverProject,
  importSource: &String
): Option<AliasResolution> {
  let firstSegment: String = resolverFirstSegment(importSource);
  let rest: Option<String> = resolverRestSegments(importSource);

  let mut exactIndex: u64 = 0;
  while (exactIndex < project.aliases.length()) {
    let Option::SOME(alias) = project.aliases.get(exactIndex) else {
      break;
    };

    if (alias.name.equals(&firstSegment)) {
      let emptyRemainder: String = String::new();
      return Option::SOME(AliasResolution {
        basePath: alias.path.clone(),
        remainder: resolverJoinAliasRemainder(&emptyRemainder, &rest),
      });
    }

    exactIndex += 1;
  }

  let mut bestMatchLength: u64 = 0;
  let mut bestMatch: Option<AliasResolution> = Option::NONE;
  let mut prefixIndex: u64 = 0;

  while (prefixIndex < project.aliases.length()) {
    let Option::SOME(alias) = project.aliases.get(prefixIndex) else {
      break;
    };

    // Require a "::" boundary after the alias name so that an alias "comp" does not
    // shadow an import "compiler::foo".  The import source must start with exactly
    // "<alias.name>::" to qualify as a prefix match.
    let aliasWithSep: String = alias.name.concat("::");
    if (importSource.startsWith(aliasWithSep.toStr()) && alias.name.length() > bestMatchLength) {
      let subPath: String = importSource.substringBytes(aliasWithSep.length(), importSource.length());
      let subPathOpt: Option<String> = Option::SOME(subPath);
      let emptyRemainder: String = String::new();
      bestMatchLength = alias.name.length();
      bestMatch = Option::SOME(AliasResolution {
        basePath: alias.path.clone(),
        remainder: resolverJoinAliasRemainder(&emptyRemainder, &subPathOpt),
      });
    }

    prefixIndex += 1;
  }

  return bestMatch;
}

function resolverResolveImport(
  project: &ResolverProject,
  manifest: &StdManifest,
  currentFile: &Path::PathBuf,
  importSource: &String,
  span: SourceSpan,
): Result<ResolvedImportTarget, DiagnosticBag> {
  if (importSource.startsWith("std::")) {
    let moduleName: String = importSource.substringBytes(5, importSource.length());
    let stdRoot: Path::PathBuf = project.stdRoot.clone();

    let mut candidateBase: Path::PathBuf = Path::PathBuf::new();
    match (manifest.modulePathText(moduleName.toStr())) {
      Option::SOME(relativePath) -> {
        candidateBase = stdRoot.join(relativePath.toStr()).normalize();
      },
      Option::NONE -> {
        let relativePath: String = resolverReplaceModuleSeparators(&moduleName);
        candidateBase = stdRoot.join(relativePath.toStr()).normalize();
      },
    };

    let resolved: Path::PathBuf = resolverResolveFsPath(currentFile, importSource, span, &candidateBase)!;
    return Result::OK(ResolvedImportTarget {
      path: resolved,
      kind: BuildModuleKind::STD,
    });
  }

  if (let Option::SOME(aliasMatch) = resolverAliasMatch(project, importSource)) {
    let mut candidateBase: Path::PathBuf = aliasMatch.basePath.clone();
    if (aliasMatch.remainder.length() > 0) {
      candidateBase = aliasMatch.basePath.join(aliasMatch.remainder.toStr()).normalize();
    }

    let resolved: Path::PathBuf = resolverResolveFsPath(currentFile, importSource, span, &candidateBase)!;
    return Result::OK(ResolvedImportTarget {
      path: resolved,
      kind: BuildModuleKind::PROJECT,
    });
  }

  if (importSource.startsWith("./") || importSource.startsWith("../")) {
    let Option::SOME(parent) = currentFile.parent() else {
      return Result::ERROR(resolverMissingModuleDiagnostic(currentFile, importSource, span));
    };

    let candidateBase: Path::PathBuf = parent.join(importSource.toStr()).normalize();
    let resolved: Path::PathBuf = resolverResolveFsPath(currentFile, importSource, span, &candidateBase)!;
    return Result::OK(ResolvedImportTarget {
      path: resolved,
      kind: BuildModuleKind::PROJECT,
    });
  }

  let projectRoot: Path::PathBuf = project.root.clone();

  let candidateBase: Path::PathBuf = projectRoot.join(importSource.toStr()).normalize();
  let resolved: Path::PathBuf = resolverResolveFsPath(currentFile, importSource, span, &candidateBase)!;
  return Result::OK(ResolvedImportTarget {
    path: resolved,
    kind: BuildModuleKind::PROJECT,
  });
}

function resolverExtractImports(
  path: &Path::PathBuf,
  flags: &CompileFlags,
): Result<Vector<ParsedImport>, DiagnosticBag> {
  let Result::OK(sourceText) = Fs::readToString(path) else {
    return Result::ERROR(resolverSingleDiagnostic(Diagnostic::new(
      Severity::ERROR,
      MISSING_MODULE,
      "module source could not be read",
      resolverPathSpan(path, 0, 0),
    )));
  };

  let sourceFile: SourceFile = SourceFile {
    path: path.clone(),
    text: sourceText.clone(),
  };
  let mut module: Ast::Module = Ast::Module::init();
  let mut diagnostics: DiagnosticBag = DiagnosticBag::init();

  Parser::parseIntoWithFlags(&sourceFile, &mut module, &mut diagnostics, flags);
  if (!diagnostics.isEmpty()) {
    return Result::ERROR(diagnostics);
  }

  let mut imports: Vector<ParsedImport> = Vector::new<ParsedImport>();
  let mut rootIndex: u64 = 0;

  while (rootIndex < module.roots.length()) {
    let Option::SOME(itemId) = module.roots.get(rootIndex) else {
      break;
    };
    let Option::SOME(item) = module.items.get(*itemId) else {
      rootIndex += 1;
      continue;
    };

    match (item) {
      Ast::Item::Node::Import(importItem) -> {
        imports.push(ParsedImport {
          source: importItem.source.clone(),
          span: importItem.sourceSpan,
        });
      },
      Ast::Item::Node::Export(exportItem) -> {
        match (&exportItem.source) {
          Option::SOME(source) -> {
            let spanValue: SourceSpan = match (exportItem.sourceSpan) {
              Option::SOME(value) -> value,
              Option::NONE -> resolverPathSpan(path, 0, 0),
            };

            imports.push(ParsedImport {
              source: source.clone(),
              span: spanValue,
            });
          },
          Option::NONE -> {},
        };
      },
      _ -> {},
    };

    rootIndex += 1;
  }

  return Result::OK(imports);
}

function resolverDiscoverModule(
  project: &ResolverProject,
  manifest: &StdManifest,
  graph: &mut BuildGraph,
  currentPath: &Path::PathBuf,
  kind: BuildModuleKind,
  stack: &mut Vector<Path::PathBuf>,
): Result<u64, DiagnosticBag> {
  let mut existingIndex: u64 = 0;
  while (existingIndex < graph.nodes.length()) {
    let Option::SOME(existingNode) = graph.nodes.get(existingIndex) else {
      break;
    };

    if (resolverPathEquals(&existingNode.path, currentPath)) {
      return Result::OK(existingIndex);
    }

    existingIndex += 1;
  }

  let currentIndex: u64 = ModuleGraph::addNode(graph, currentPath, kind);
  let mut stackRef: &mut Vector<Path::PathBuf> = stack;
  stackRef.push(currentPath.clone());

  let imports: Vector<ParsedImport> = resolverExtractImports(currentPath, &project.flags)!;
  let mut importIndex: u64 = 0;

  while (importIndex < imports.length()) {
    let Option::SOME(importItem) = imports.get(importIndex) else {
      break;
    };

    let target: ResolvedImportTarget = resolverResolveImport(project, manifest, currentPath, &importItem.source, importItem.span)!;
    if (resolverPathInStack(stack, &target.path)) {
      let mut cycle: Vector<Path::PathBuf> = resolverClonePathStack(stack);
      cycle.push(target.path.clone());
      return Result::ERROR(resolverCycleDiagnostic(&cycle));
    }

    let targetIndex: u64 = resolverDiscoverModule(project, manifest, graph, &target.path, target.kind, stack)!;
    ModuleGraph::addEdge(graph, currentIndex, targetIndex, &importItem.source, importItem.span);
    importIndex += 1;
  }

  let Option::SOME(lastPath) = stack.get(stack.length() - 1) else {
    return Result::OK(currentIndex);
  };

  if (resolverPathEquals(lastPath, currentPath)) {
    let mut stackWrite: &mut Vector<Path::PathBuf> = stack;
    stackWrite.pop();
  }

  return Result::OK(currentIndex);
}

function resolverRelativePathText(path: &Path::PathBuf, root: &Path::PathBuf): String {
  let pathText: String = path.toString();
  let rootText: String = root.toString();

  if (!pathText.startsWith(rootText.toStr())) {
    return pathText;
  }

  let mut start: u64 = rootText.length();
  if (pathText.length() > start) {
    if (let Option::SOME(separator) = pathText.charAt(start) && separator == '/') {
      start += 1;
    }
  }

  return pathText.substringBytes(start, pathText.length());
}

function resolverStringEndsWith(value: &String, suffix: str): boolean {
  let suffixText: String = String::create(suffix);
  if (value.length() < suffixText.length()) {
    return false;
  }

  let actualSuffix: String = value.substringBytes(value.length() - suffixText.length(), value.length());
  return actualSuffix.equals(&suffixText);
}

function resolverIsProjectTestFileName(fileName: &String): boolean {
  return fileName.equals("tests.ign") || resolverStringEndsWith(fileName, ".test.ign") || resolverStringEndsWith(fileName, ".tests.ign") || resolverStringEndsWith(fileName, "-test.ign") || resolverStringEndsWith(fileName, "-tests.ign") || resolverStringEndsWith(fileName, "_test.ign") || resolverStringEndsWith(fileName, "_tests.ign");
}

function resolverCollectProjectTestSources(
  sourceRoot: &Path::PathBuf,
  entryPath: &Path::PathBuf,
): Result<Vector<Path::PathBuf>, DiagnosticBag> {
  let sourceRootText: String = sourceRoot.toString();
  let entries: Vector<String> = match (Fs::collectWalk(sourceRootText.toStr())) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      return Result::ERROR(resolverSimpleDiagnostic(sourceRoot, MISSING_MODULE, "project test sources could not be discovered"));
    },
  };

  let entryText: String = entryPath.toString();
  let mut matched: Vector<String> = Vector::new<String>();
  let mut index: u64 = 0;

  while (index < entries.length()) {
    let Option::SOME(entry) = entries.get(index) else {
      break;
    };

    if (!entry.equals(&entryText)) {
      let path: Path::PathBuf = Path::PathBuf::fromString(entry).normalize();
      if (let Option::SOME(fileName) = path.fileName() && resolverIsProjectTestFileName(&fileName)) {
        matched.push(entry.clone());
      }
    }

    index += 1;
  }

  Sort::stableLexicalStrings(&mut matched);

  let mut discovered: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  let mut matchedIndex: u64 = 0;
  while (matchedIndex < matched.length()) {
    let Option::SOME(pathText) = matched.get(matchedIndex) else {
      break;
    };

    discovered.push(Path::PathBuf::fromString(pathText).normalize());
    matchedIndex += 1;
  }

  return Result::OK(discovered);
}

function resolverDiscoverProjectRoots(
  project: &ResolverProject,
  manifest: &StdManifest,
  includeTestSources: boolean,
): Result<DiscoveryResult, DiagnosticBag> {
  let mut graph: BuildGraph = BuildGraph::init();
  let mut stack: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();

  // The auto-loaded modules are roots of their own: nothing imports them, and
  // every other module needs their declarations in scope.
  let mut preludePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  let mut preludeIndex: u64 = 0;

  while (preludeIndex < manifest.autoLoadCount()) {
    let Option::SOME(moduleName) = manifest.autoLoadText(preludeIndex) else {
      preludeIndex += 1;
      continue;
    };

    let mut candidateBase: Path::PathBuf = project.stdRoot.join(moduleName.toStr()).normalize();
    if (let Option::SOME(relativePath) = manifest.modulePathText(moduleName.toStr())) {
      candidateBase = project.stdRoot.join(relativePath.toStr()).normalize();
    }

    let mut preludeStack: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
    resolverDiscoverModule(project, manifest, &mut graph, &candidateBase, BuildModuleKind::STD, &mut preludeStack)!;
    preludePaths.push(candidateBase.clone());
    preludeIndex += 1;
  }

  let rootIndex: u64 = resolverDiscoverModule(project, manifest, &mut graph, &project.entry, BuildModuleKind::PROJECT, &mut stack)!;
  ModuleGraph::setRoot(&mut graph, rootIndex);

  if (includeTestSources) {
    let testSources: Vector<Path::PathBuf> = resolverCollectProjectTestSources(&project.sourceRoot, &project.entry)!;
    let mut testIndex: u64 = 0;

    while (testIndex < testSources.length()) {
      let Option::SOME(testSource) = testSources.get(testIndex) else {
        break;
      };

      let mut testStack: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
      resolverDiscoverModule(project, manifest, &mut graph, testSource, BuildModuleKind::PROJECT, &mut testStack)!;
      testIndex += 1;
    }
  }

  // Every node is ordered, not only what the entry reaches: the prelude roots
  // are reachable from nothing and still have to be analyzed, and before the
  // modules that rely on them.
  let order: Vector<u64> = ModuleGraph::allModulesTopologicalOrder(&graph);

  return Result::OK(DiscoveryResult {
    graph: graph,
    order: order,
    preludePaths: preludePaths,
    stdRoot: project.stdRoot.clone(),
    flags: project.flags.clone(),
    optLevel: project.optLevel,
    cflags: resolverCloneStrings(&project.cflags),
    outDir: project.outDir.clone(),
    name: project.name.clone(),
    cc: project.cc.clone(),
    bin: project.bin,
    emitC: project.emitC,
    entry: project.entry.clone(),
    hasProjectFile: project.hasProjectFile,
    root: project.root.clone(),
    stdEnabled: project.stdEnabled,
    testFixtures: resolverClonePaths(&project.testFixtures),
  });
}

/// True when the manifest declares `name` as compile-only, which means the
/// module is C the runtime already builds rather than Ignis source.
function resolverIsCompileOnly(manifest: &StdManifest, name: &String): boolean {
  let mut index: u64 = 0;

  while (index < manifest.compileOnlyCount()) {
    let Option::SOME(compileOnly) = manifest.compileOnlyText(index) else {
      break;
    };

    if (compileOnly.equals(name)) {
      return true;
    }

    index += 1;
  }

  return false;
}

/// Discovers every module the std manifest declares, which is the graph a
/// standard-library build compiles.
///
/// Each manifest module is a root of its own: nothing outside the std imports
/// them here, and every one of them has to be compiled.
function resolverDiscoverStdRoots(
  project: &ResolverProject,
  manifest: &StdManifest,
): Result<DiscoveryResult, DiagnosticBag> {
  let mut graph: BuildGraph = BuildGraph::init();
  let mut preludePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  let mut preludeIndex: u64 = 0;

  while (preludeIndex < manifest.autoLoadCount()) {
    let Option::SOME(moduleName) = manifest.autoLoadText(preludeIndex) else {
      preludeIndex += 1;
      continue;
    };

    let mut candidateBase: Path::PathBuf = project.stdRoot.join(moduleName.toStr()).normalize();
    if (let Option::SOME(relativePath) = manifest.modulePathText(moduleName.toStr())) {
      candidateBase = project.stdRoot.join(relativePath.toStr()).normalize();
    }

    let mut preludeStack: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
    resolverDiscoverModule(project, manifest, &mut graph, &candidateBase, BuildModuleKind::STD, &mut preludeStack)!;
    preludePaths.push(candidateBase.clone());
    preludeIndex += 1;
  }

  let mut moduleIndex: u64 = 0;

  while (moduleIndex < manifest.modules.length()) {
    let Option::SOME(module) = manifest.modules.get(moduleIndex) else {
      break;
    };

    if (resolverIsCompileOnly(manifest, &module.name)) {
      moduleIndex += 1;
      continue;
    }

    let candidateBase: Path::PathBuf = project.stdRoot.join(module.path.toStr()).normalize();
    let mut stack: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
    resolverDiscoverModule(project, manifest, &mut graph, &candidateBase, BuildModuleKind::STD, &mut stack)!;
    moduleIndex += 1;
  }

  let order: Vector<u64> = ModuleGraph::allModulesTopologicalOrder(&graph);

  return Result::OK(DiscoveryResult {
    graph: graph,
    order: order,
    preludePaths: preludePaths,
    stdRoot: project.stdRoot.clone(),
    flags: project.flags.clone(),
    optLevel: project.optLevel,
    cflags: resolverCloneStrings(&project.cflags),
    outDir: project.outDir.clone(),
    name: String::create("std"),
    cc: project.cc.clone(),
    bin: false,
    emitC: project.emitC,
    entry: project.entry.clone(),
    hasProjectFile: project.hasProjectFile,
    root: project.root.clone(),
    stdEnabled: project.stdEnabled,
    testFixtures: resolverClonePaths(&project.testFixtures),
  });
}

function resolverDiagnosticSummary(bag: &DiagnosticBag): String {
  let Option::SOME(diagnostic) = bag.get(0) else {
    Test::fail();
    return String::new();
  };

  return String::create(diagnostic.code).concat("|").concat(diagnostic.messageText());
}

export namespace Resolver {
  /// Discovers with the compile-time configuration of the machine this
  /// compiler runs on. A build uses the `WithOptions` entry points, whose
  /// configuration the project file and the command line decide.
  function discoverProject(startPath: &Path::PathBuf): Result<DiscoveryResult, DiagnosticBag> {
    let features: Vector<String> = Vector::new<String>();
    return Resolver::discoverProjectWithOptions(startPath, Option::NONE, &features);
  }

  function discoverProjectTests(startPath: &Path::PathBuf): Result<DiscoveryResult, DiagnosticBag> {
    let features: Vector<String> = Vector::new<String>();
    return Resolver::discoverProjectTestsWithOptions(startPath, Option::NONE, &features);
  }

  function discoverProjectWithOptions(
    startPath: &Path::PathBuf,
    debug: Option<boolean>,
    features: &Vector<String>,
  ): Result<DiscoveryResult, DiagnosticBag> {
    let overrides: BuildOverrides = BuildOverrides::withOptions(debug, features);
    return Resolver::discover(startPath, &overrides, false);
  }

  function discoverProjectTestsWithOptions(
    startPath: &Path::PathBuf,
    debug: Option<boolean>,
    features: &Vector<String>,
  ): Result<DiscoveryResult, DiagnosticBag> {
    let overrides: BuildOverrides = BuildOverrides::withOptions(debug, features);
    return Resolver::discover(startPath, &overrides, true);
  }

  /// Discovers the module graph a build compiles, starting from a project
  /// directory, a source file inside a project, or a source file no project
  /// file governs.
  ///
  /// `includeTests` adds the project's test modules to the graph, which is what
  /// a test run needs and a build must not have.
  function discover(
    startPath: &Path::PathBuf,
    overrides: &BuildOverrides,
    includeTests: boolean,
  ): Result<DiscoveryResult, DiagnosticBag> {
    let project: ResolverProject = match (Config::findProjectFile(startPath)) {
      Option::SOME(_) -> resolverLoadProject(startPath, overrides)!,
      Option::NONE -> resolverSingleFileProject(startPath, overrides)!,
    };
    let manifestPath: Path::PathBuf = project.stdManifestPath.clone();
    let manifest: StdManifest = Manifest::loadFile(&manifestPath)!;

    return resolverDiscoverProjectRoots(&project, &manifest, includeTests);
  }

  /// Discovers the module graph a program fixture compiles as: the fixture on
  /// its own, under the settings of the project that governs `projectStart`.
  ///
  /// A fixture observes what a project build observes — the same standard
  /// library, aliases, features and C profile — rather than a private
  /// toolchain, so the project is loaded first and only the entry and the
  /// source root are replaced. A fixture no project file governs falls back to
  /// the single-file settings.
  function discoverFixture(
    fixturePath: &Path::PathBuf,
    projectStart: &Path::PathBuf,
    overrides: &BuildOverrides,
  ): Result<DiscoveryResult, DiagnosticBag> {
    let mut project: ResolverProject = match (Config::findProjectFile(projectStart)) {
      Option::SOME(_) -> resolverLoadProject(projectStart, overrides)!,
      Option::NONE -> resolverSingleFileProject(fixturePath, overrides)!,
    };

    let entry: Path::PathBuf = resolverCanonicalPath(fixturePath, "fixture file could not be resolved")!;

    if (let Option::SOME(parent) = entry.parent()) {
      project.sourceRoot = parent.clone();
    }

    project.entry = entry.clone();

    let manifestPath: Path::PathBuf = project.stdManifestPath.clone();
    let manifest: StdManifest = Manifest::loadFile(&manifestPath)!;

    return resolverDiscoverProjectRoots(&project, &manifest, false);
  }

  /// Discovers the standard library's own module graph, which is what
  /// `ignis build-std` compiles. The std root comes from the project file when
  /// one governs `startPath`, and from `--std-path` or `IGNIS_STD_PATH`
  /// otherwise.
  function discoverStd(
    startPath: &Path::PathBuf,
    overrides: &BuildOverrides,
  ): Result<DiscoveryResult, DiagnosticBag> {
    let project: ResolverProject = match (Config::findProjectFile(startPath)) {
      Option::SOME(_) -> resolverLoadProject(startPath, overrides)!,
      Option::NONE -> resolverStdOnlyProject(startPath, overrides)!,
    };
    let manifestPath: Path::PathBuf = project.stdManifestPath.clone();
    let manifest: StdManifest = Manifest::loadFile(&manifestPath)!;

    return resolverDiscoverStdRoots(&project, &manifest);
  }

  function orderSummaryRelativeTo(discovery: &DiscoveryResult, root: &Path::PathBuf): String {
    let mut summary: String = String::new();
    let mut index: u64 = 0;

    while (index < discovery.order.length()) {
      let Option::SOME(nodeIndex) = discovery.order.get(index) else {
        break;
      };
      let Option::SOME(node) = discovery.graph.nodes.get(*nodeIndex) else {
        index += 1;
        continue;
      };

      if (index > 0) {
        summary.pushChar('\n');
      }

      let relative: String = resolverRelativePathText(&node.path, root);
      summary.push(&relative);
      index += 1;
    }

    return summary;
  }

  function firstDiagnosticSummary(startPath: &Path::PathBuf): String {
    let Result::ERROR(bag) = Resolver::discoverProject(startPath) else {
      Test::fail();
      return String::new();
    };

    return resolverDiagnosticSummary(&bag);
  }
}

/// `[build] debug = true` in the project's `ignis.toml` is the base value of
/// `CompileFlags.debug` when the command line supplies no override.
@test
function resolverReadsDebugTrueFromProjectFile(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/debug_flag_enabled");
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&fixtureRoot)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<boolean>(discovery.flags.debug, true);
}

/// `[build] opt_level` in the project's `ignis.toml` is the level the C
/// toolchain is invoked with.
@test
function resolverReadsOptLevelFromProjectFile(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/build_profile");
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&fixtureRoot)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<u64>(discovery.optLevel, 2);
}

/// `[build] cflags` in the project's `ignis.toml` are the flags the C toolchain
/// is invoked with on top of the profile's own.
@test
function resolverReadsCflagsFromProjectFile(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/build_profile");
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&fixtureRoot)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<u64>(discovery.cflags.length(), 2);

  let Option::SOME(first) = discovery.cflags.get(0) else {
    Test::fail();
    return;
  };
  let Option::SOME(second) = discovery.cflags.get(1) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(first.toStr(), "-Wall");
  Test::assertEq<str>(second.toStr(), "-fno-omit-frame-pointer");
}

/// `[build] cflags` spread over several lines reads the same as a single-line
/// array: the project file is parsed as TOML, not scanned line by line.
@test
function resolverReadsMultilineCflagsFromProjectFile(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/multiline_cflags");
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&fixtureRoot)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<u64>(discovery.cflags.length(), 3);

  let Option::SOME(first) = discovery.cflags.get(0) else {
    Test::fail();
    return;
  };
  let Option::SOME(second) = discovery.cflags.get(1) else {
    Test::fail();
    return;
  };
  let Option::SOME(third) = discovery.cflags.get(2) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(first.toStr(), "-Wall");
  Test::assertEq<str>(second.toStr(), "-Wextra");
  Test::assertEq<str>(third.toStr(), "-fno-omit-frame-pointer");
}

/// Discovery starting inside a project finds the same project the root does:
/// the project file is looked up by walking the directories above it.
@test
function resolverDiscoversTheProjectFromASubdirectory(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/acyclic");
  let sourceDir: Path::PathBuf = fixtureRoot.join("src");
  let expectedPath: Path::PathBuf = fixtureRoot.join("expected_order.txt");
  let expected: String = resolverReadText(&expectedPath).trimAsciiWhitespace();
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&sourceDir)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };
  let actual: String = Resolver::orderSummaryRelativeTo(&discovery, &fixtureRoot).trimAsciiWhitespace();
  Test::assertEq<str>(actual.toStr(), expected.toStr());
}

/// `[package] name`, `[build] out_dir`, `[build] cc` and `[build] bin` reach the
/// build, which lays its artifacts out from them.
@test
function resolverReadsBuildOutputFieldsFromProjectFile(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/build_profile");
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&fixtureRoot)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let outDirText: String = discovery.outDir.toString();
  let expectedOutDir: String = fixtureRoot.join("build/out").toString();

  Test::assertEq<str>(discovery.name.toStr(), "resolver-build-profile");
  Test::assertEq<str>(outDirText.toStr(), expectedOutDir.toStr());
  Test::assertEq<str>(discovery.cc.toStr(), "cc");
  Test::assertEq<boolean>(discovery.bin, true);
  Test::assertEq<boolean>(discovery.hasProjectFile, true);
}

/// A project file without `[build] cflags` hands the toolchain nothing beyond
/// the profile flags.
@test
function resolverDefaultsCflagsToEmptyWithoutProjectSetting(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/acyclic");
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&fixtureRoot)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<u64>(discovery.cflags.length(), 0);
}

/// A project file without `[build] opt_level` resolves to level 0, which the
/// toolchain is still told explicitly.
@test
function resolverDefaultsOptLevelToZeroWithoutProjectSetting(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/acyclic");
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&fixtureRoot)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<u64>(discovery.optLevel, 0);
}

/// An `[build] opt_level` value the toolchain would not accept is rejected
/// instead of silently falling back to an unoptimized build.
@test
function resolverReportsInvalidOptLevel(): void {
  let fixtureRoot: Path::PathBuf = resolverFixturePath("test_cases/selfhost/build/invalid_opt_level");
  let expectedPath: Path::PathBuf = fixtureRoot.join("expected_diagnostic.txt");
  let expected: String = resolverReadText(&expectedPath).trimAsciiWhitespace();
  let actual: String = Resolver::firstDiagnosticSummary(&fixtureRoot).trimAsciiWhitespace();
  Test::assertEq<str>(actual.toStr(), expected.toStr());
}

/// A project file without `[build] debug` resolves to `debug = false`.
