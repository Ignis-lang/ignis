import Path from "std::path";

import SourceFile, SourceSpan from "@compiler::diagnostics";
import CompileFlags, ParseOutput from "@compiler::parser";

function moduleGraphPathEquals(left: &Path::PathBuf, right: &Path::PathBuf): boolean {
  let leftText: String = left.toString();
  let rightText: String = right.toString();
  return leftText.equals(&rightText);
}

function moduleGraphContainsIndex(values: &Vector<u64>, target: u64): boolean {
  let mut index: u64 = 0;

  while (index < values.length()) {
    let Option::SOME(value) = values.get(index) else {
      break;
    };

    if (*value == target) {
      return true;
    }

    index += 1;
  }

  return false;
}

export enum BuildModuleKind {
  PROJECT,
  STD,
}

export record BuildGraphEdge {
  public targetIndex: u64;
  public source: String;
  public span: SourceSpan;
}

/// A module's source as discovery read it, and discovery's parse of it.
///
/// Every span in `output` borrows the text of `file.path`, so whoever takes
/// the two has to keep this `file`, not a clone of it, alive for as long as it
/// uses the module or its diagnostics. Moving the record keeps them valid.
export record DiscoveredModule {
  public file: SourceFile;
  public output: ParseOutput;
}

/// A text that identifies `flags`: two parses of the same text agree when
/// their flags have the same key.
export function compileFlagsKey(flags: &CompileFlags): String {
  let mut key: String = `${flags.os.toStr()}|${flags.arch.toStr()}|${flags.abi.toStr()}|${flags.targetTriple.toStr()}|`;

  if (flags.debug) {
    key.pushStr("debug");
  }

  key.pushStr("|");
  appendKeyNames(&mut key, &flags.features);
  key.pushStr("|");
  appendKeyNames(&mut key, &flags.knownFeatures);
  return key;
}

function appendKeyNames(key: &mut String, names: &Vector<String>): void {
  let mut keyRef: &mut String = key;
  let mut index: u64 = 0;

  while (index < names.length()) {
    if (let Option::SOME(name) = names.get(index)) {
      keyRef.pushStr(name.toStr());
      keyRef.pushStr(",");
    }

    index += 1;
  }
}

/// One cached parse: the module at `pathText`, parsed with the flags whose key
/// is `flagsKey`. `parsed` holds at most one entry, empty once taken.
export record ParseCacheEntry {
  public pathText: String;
  public flagsKey: String;
  public parsed: Vector<DiscoveredModule>;
}

/// Parses kept between discoveries, so that a module whose text and flags did
/// not change is not lexed and parsed again. Every cached module is in the
/// state the parser left it: its import sources are the written ones.
export record ParseCache {
  public entries: Vector<ParseCacheEntry>;

  public static empty(): ParseCache {
    return ParseCache { entries: Vector::new<ParseCacheEntry>() };
  }

  /// The number of modules the cache holds.
  public length(&self): u64 {
    let mut count: u64 = 0;
    let mut index: u64 = 0;

    while (index < self.entries.length()) {
      if (let Option::SOME(entry) = self.entries.get(index)) {
        count += entry.parsed.length();
      }

      index += 1;
    }

    return count;
  }

  /// Keeps `parsed`, parsed with the flags whose key is `flagsKey`.
  public insert(&mut self, parsed: DiscoveredModule, flagsKey: &String): void {
    let mut slot: Vector<DiscoveredModule> = Vector::new<DiscoveredModule>();
    let pathText: String = parsed.file.path.toString();
    slot.push(parsed);
    self.entries.push(ParseCacheEntry { pathText: pathText, flagsKey: flagsKey.clone(), parsed: slot });
  }

  /// Hands over the parse of `path` when it was parsed from `text` with the
  /// flags whose key is `flagsKey`, and `NONE` otherwise.
  public take(
    &mut self,
    path: &Path::PathBuf,
    text: &String,
    flagsKey: &String
  ): Option<DiscoveredModule> {
    let pathText: String = path.toString();
    let mut index: u64 = 0;

    while (index < self.entries.length()) {
      let Option::SOME(entry) = self.entries.getMut(index) else {
        break;
      };

      index += 1;

      if (!entry.pathText.equals(&pathText) || entry.parsed.isEmpty()) {
        continue;
      }

      if (!entry.flagsKey.equals(flagsKey)) {
        return Option::NONE;
      }

      let Option::SOME(cached) = entry.parsed.get(0) else {
        return Option::NONE;
      };

      if (!cached.file.text.equals(text)) {
        return Option::NONE;
      }

      return entry.parsed.pop();
    }

    return Option::NONE;
  }
}

export record BuildGraphNode {
  public path: Path::PathBuf;
  public kind: BuildModuleKind;
  public edges: Vector<BuildGraphEdge>;
  /// Discovery's parse of the module until `ModuleGraph::takeParsed` hands it
  /// over. It holds at most one entry: a vector, so that taking it can pop it
  /// through a mutable borrow.
  public parsed: Vector<DiscoveredModule>;
}

export record BuildGraph {
  public nodes: Vector<BuildGraphNode>;
  public rootIndex: Option<u64>;
  /// How many modules a consumer had to read and parse again because their
  /// parse had already been taken.
  public reparsedModules: u64;
  /// Parses discovery may reuse instead of parsing a module, and how many it
  /// reused. Empty unless the caller handed discovery a cache.
  public parseCache: ParseCache;
  public reusedModules: u64;

  public static init(): BuildGraph {
    return BuildGraph {
      nodes: Vector::new<BuildGraphNode>(),
      rootIndex: Option::NONE,
      reparsedModules: 0,
      parseCache: ParseCache::empty(),
      reusedModules: 0,
    };
  }

  public nodeCount(&self): u64 {
    return self.nodes.length();
  }

  public nodePathText(&self, index: u64): Option<String> {
    let Option::SOME(node) = self.nodes.get(index) else {
      return Option::NONE;
    };

    return Option::SOME(node.path.toString());
  }
}

export namespace ModuleGraph {
  function findNodeIndex(graph: &BuildGraph, path: &Path::PathBuf): Option<u64> {
    let mut index: u64 = 0;

    while (index < graph.nodes.length()) {
      let Option::SOME(node) = graph.nodes.get(index) else {
        break;
      };

      if (moduleGraphPathEquals(&node.path, path)) {
        return Option::SOME(index);
      }

      index += 1;
    }

    return Option::NONE;
  }

  function addNode(graph: &mut BuildGraph, path: &Path::PathBuf, kind: BuildModuleKind): u64 {
    let mut existingIndex: u64 = 0;
    while (existingIndex < graph.nodes.length()) {
      let Option::SOME(existingNode) = graph.nodes.get(existingIndex) else {
        break;
      };

      if (moduleGraphPathEquals(&existingNode.path, path)) {
        return existingIndex;
      }

      existingIndex += 1;
    }

    {
      let mut nodesRef: &mut Vector<BuildGraphNode> = &mut graph.nodes;
      nodesRef.push(BuildGraphNode {
        path: path.clone(),
        kind: kind,
        edges: Vector::new<BuildGraphEdge>(),
        parsed: Vector::new<DiscoveredModule>(),
      });
    }

    let index: u64 = graph.nodes.length() - 1;
    match (graph.rootIndex) {
      Option::SOME(_) -> {},
      Option::NONE -> {
        graph.rootIndex = Option::SOME(index);
      },
    };

    return index;
  }

  function setRoot(graph: &mut BuildGraph, index: u64): void {
    graph.rootIndex = Option::SOME(index);
  }

  /// Stores discovery's parse of the module at `index`, replacing any earlier
  /// one.
  function setParsed(graph: &mut BuildGraph, index: u64, parsed: DiscoveredModule): void {
    let Option::SOME(node) = graph.nodes.getMut(index) else {
      return;
    };

    node.parsed.clear();
    node.parsed.push(parsed);
  }

  /// Hands over discovery's parse of the module at `index`, leaving the node
  /// without one. `NONE` once it has been taken.
  function takeParsed(graph: &mut BuildGraph, index: u64): Option<DiscoveredModule> {
    let Option::SOME(node) = graph.nodes.getMut(index) else {
      return Option::NONE;
    };

    return node.parsed.pop();
  }

  function addEdge(
    graph: &mut BuildGraph,
    fromIndex: u64,
    toIndex: u64,
    source: &String,
    span: SourceSpan
  ): void {
    let Option::SOME(node) = graph.nodes.getMut(fromIndex) else {
      return;
    };

    let mut edgeIndex: u64 = 0;
    while (edgeIndex < node.edges.length()) {
      let Option::SOME(edge) = node.edges.get(edgeIndex) else {
        break;
      };

      if (edge.targetIndex == toIndex && edge.source.equals(source.toStr())) {
        return;
      }

      edgeIndex += 1;
    }

    node.edges.push(BuildGraphEdge {
      targetIndex: toIndex,
      source: source.clone(),
      span: span,
    });
  }

  function topologicalOrder(graph: &BuildGraph): Vector<u64> {
    let mut visited: Vector<u64> = Vector::new<u64>();
    let mut visiting: Vector<u64> = Vector::new<u64>();
    let mut order: Vector<u64> = Vector::new<u64>();

    match (graph.rootIndex) {
      Option::SOME(rootIndex) -> ModuleGraph::visit(graph, rootIndex, &mut visited, &mut visiting, &mut order),
      Option::NONE -> {},
    };

    return order;
  }

  function allModulesTopologicalOrder(graph: &BuildGraph): Vector<u64> {
    let mut visited: Vector<u64> = Vector::new<u64>();
    let mut visiting: Vector<u64> = Vector::new<u64>();
    let mut order: Vector<u64> = Vector::new<u64>();
    let mut index: u64 = 0;

    while (index < graph.nodes.length()) {
      ModuleGraph::visit(graph, index, &mut visited, &mut visiting, &mut order);
      index += 1;
    }

    return order;
  }

  function visit(
    graph: &BuildGraph,
    nodeIndex: u64,
    visited: &mut Vector<u64>,
    visiting: &mut Vector<u64>,
    order: &mut Vector<u64>
  ): void {
    // `visited` is the "black" (fully processed) set.  A node is added to `visited`
    // only after all its transitive dependencies have been emitted (post-order DFS).
    // `visiting` is the "gray" (on the current DFS call stack) set, used only to
    // detect a back-edge that would otherwise recurse forever if a cycle slipped
    // past the resolver's upstream cycle rejection.
    let mut visitedIndex: u64 = 0;
    while (visitedIndex < visited.length()) {
      let Option::SOME(value) = visited.get(visitedIndex) else {
        break;
      };

      if (*value == nodeIndex) {
        return;
      }

      visitedIndex += 1;
    }

    let mut visitingIndex: u64 = 0;
    while (visitingIndex < visiting.length()) {
      let Option::SOME(value) = visiting.get(visitingIndex) else {
        break;
      };

      if (*value == nodeIndex) {
        @panic("ModuleGraph::visit: cycle detected in module graph during topological traversal");
      }

      visitingIndex += 1;
    }

    let Option::SOME(node) = graph.nodes.get(nodeIndex) else {
      return;
    };

    {
      let mut visitingRef: &mut Vector<u64> = visiting;
      visitingRef.push(nodeIndex);
    }

    let mut edgeIndex: u64 = 0;
    while (edgeIndex < node.edges.length()) {
      let Option::SOME(edge) = node.edges.get(edgeIndex) else {
        break;
      };

      ModuleGraph::visit(graph, edge.targetIndex, visited, visiting, order);
      edgeIndex += 1;
    }

    {
      let mut visitingRef: &mut Vector<u64> = visiting;
      visitingRef.pop();
    }

    // Mark black and emit in post-order (dependencies before dependents).
    let mut visitedRef: &mut Vector<u64> = visited;
    visitedRef.push(nodeIndex);

    let mut orderRef: &mut Vector<u64> = order;
    orderRef.push(nodeIndex);
  }
}
