import
  SourceSpan,
  Diagnostic,
  DiagnosticBag,
  Severity,
  DiagnosticCode,
  LabelKind,
from "@compiler::diagnostics";

import Id from "@compiler::ids";
import Output from "@compiler::output";
import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import HashMap from "std::collections";

import _ from "./ownership_report";

/// HIR borrow and move checking for the Ignis selfhost compiler (IGN-38,
/// slice A).
///
/// Port of the core rules of two Rust oracles, both of which walk the HIR
/// after lowering:
///   - `crates/ignis_analyzer/src/borrowck_hir.rs` contributes the borrow
///     state machine (shared counts vs. one mutable borrow), the named-borrow
///     lifetime bound to a `let`, the transient borrows of call arguments and
///     method receivers, and the assign-while-borrowed rule (A0036, A0037,
///     A0038, A0047),
///   - `crates/ignis_analyzer/src/ownership_hir.rs` contributes the move
///     state machine (`Valid`/`Returned`/`Moved`/`Dropped`), the consumption
///     sites, manual `.drop()`, the branch join that reports an inconsistent
///     move or drop, and the two-pass loop body walk (O0001, O0003, O0006,
///     O0007, O0008, O0010).
///
/// The same walk also produces the drop schedules (IGN-39) that
/// `ownership_hir.rs` records alongside its diagnostics: which locals a scope
/// end, an early exit, a match arm end, or an overwrite must drop, and in what
/// order. That output is `BorrowckOutput::dropSchedules`, and it is what LIR
/// lowering reads on the Rust side to place drop emissions.
///
/// Both oracles run over the same HIR in the Rust pipeline and share the same
/// walk shape, so they are fused into one traversal here instead of two.
/// Where the two disagree on how to treat a node, each rule keeps its own
/// oracle's behaviour: an `if` restores and merges both maps, while a `match`
/// resets only the move map per arm (borrow state flows through arms exactly
/// as `borrowck_hir.rs` lets it).
///
/// Entry point: `Borrowck::checkModule`. Not wired into
/// `Analyzer::analyzeModule` — callers run it explicitly after
/// `Lowering::lowerModule`, the same way lowering itself is driven today.
///
/// Deliberate scope limits of this slice, each of them an oracle rule that is
/// not ported yet rather than a rule that is weakened:
///   - Closure capture borrows: the by-value captures an environment takes are
///     consumed, and a closure local is owned so its environment is torn down,
///     but `try_record_closure_capture_borrows` is not ported, so a by-ref
///     capture takes no borrow of its source.
///   - `deallocate` and the pointer alias sets behind it, together with the
///     `Freed` state and the diagnostics that depend on it (double free, use
///     after free, FFI leak). `MOVE_FREED` exists for the state ranking alone
///     and is never produced.
///   - The interprocedural `&mut`-parameter drop summaries, which let the
///     oracle see that a callee dropped through a reference it was handed.
///   - Synthetic temporaries are not tracked as values: no move or drop state
///     follows them. They matter only as the owner of a view (below).
///   - Slices built by `MakeSlice` from a local fixed array: the conversion is
///     not a method call, so it produces no tracked view.
///   - Assignment to an immutable local: the Rust oracle emits that from the
///     typechecker (A0013), not from either HIR checker; the selfhost
///     typechecker already emits its own equivalent (A0067), so duplicating
///     it here would report the same program twice.
///
/// Views (A0202, A0043, A0258), beyond the oracles: a method taking `&self`
/// or `&mut self` whose result is a `str`, a `&T`, a `&mut T` or a slice
/// returns a view of its receiver; a `str` result counts only when the
/// receiver's type needs a drop, because a receiver owning no heap storage
/// can only hand out a `str` that lives elsewhere. `pointeeOwnerOf` and
/// `storageOwnerOf` follow the owner through method chains, field access,
/// indexing, references, dereferences and view locals (the
/// variable-initializer chain). Rejected: a `let`, an assignment to a local
/// or a `return` that keeps a view of a temporary; a `let` or assignment that
/// keeps a view of a local declared deeper than the binding; a `return` of a
/// view of any local of the function. A kept view of a live local holds a
/// borrow of it until the scope of the store ends, so the existing borrow
/// rules report mutating the owner and A0258 reports moving it.
///
/// The same rules reach views kept less directly: an aggregate holding a
/// reference (`Option<&T>`) a `&self` method returned, passed on by a
/// by-value method (`unwrap`); the fields, payloads and elements of a record,
/// enum, tuple or vector built in place; an assignment into a field or an
/// element of a local; the value a block tail, an `if` or a `match` arm
/// produces; and pattern bindings. An owned pattern binding is a local of its
/// arm. A binding destructured by reference, or a reference copied out of a
/// by-value scrutinee, lives in the scrutinee's storage: a local it views, or
/// a temporary scrutinee that lives through the arms (`temporaryStorageOf`),
/// which a `let ... else` binding would outlive. Limits:
///   - The borrow ends at the binding's last use at statement granularity
///     (`holderLastStatement`), and lasts to the end of the scope in a
///     function that uses raw pointers or inline assembly. A view stored by
///     an assignment is released when the scope the assignment sits in ends,
///     which can be earlier than the binding's own.
///   - The borrow is shared even for a `&mut T` view, because
///     monomorphization drops reference mutability (see
///     `bindingIsMutableReference`).
///   - A0258 is limited to owners of method and aggregate views: moving a
///     local after the last use of a plain `let r = &x` stays accepted.
///   - Views a callee stores out of its arguments (`values.push(make().toStr())`)
///     are not tracked.
///   - A free function, extern function or static method returning a view is
///     read as a view of all its `&T`/`str`/slice arguments
///     (`callArgumentsViewOwner`). One that returns a literal or a fresh
///     allocation is a false positive; the fix is to bind the argument.
///   - A pattern binding that needs no drop and is destructured by reference
///     out of a referenced scrutinee is not tracked.
///
/// Known divergences from the oracles, as opposed to unported rules:
///   - Granularity is whole-local, exactly like both oracles: a borrow or a
///     move of `value.field` is recorded against `value`. Neither oracle is
///     path-precise, so this is parity rather than a simplification.
///   - Move tracking keys on "needs drop" (the oracle's `get_moved_var`
///     predicate) rather than on "not Copy". The two agree on every type the
///     selfhost analyzer can build today, because a drop-needing record or
///     enum is never Copy, and the oracle's consumption sites test
///     `needs_drop && !is_copy` anyway.
///   - `needsDropType` resolves `Type::Alias` through its aliased type. The
///     Rust type model has no alias variant at this point, so there is nothing
///     to mirror; leaving aliases opaque would silently stop tracking an
///     aliased owned record.
///   - Drop schedules cover every construct the selfhost HIR lowers today, but
///     two oracle inputs to them are still missing: the field-owner drop
///     suppression (`drop_suppressed_vars`), which needs the move-out-of-field
///     bookkeeping, and the `Freed` state, whose locals the oracle also leaves
///     out of a drop list. Either one can only add a drop that should have been
///     suppressed, never drop something the oracle keeps.
///   - `match` consumes a moved scrutinee variable unconditionally. The
///     oracle first asks whether an arm pattern moves an owned payload out and
///     splits into a borrowed-base rejection, a field-owner drop suppression,
///     and this consumption; only the consumption is ported.
export namespace Borrowck {
  /// Move state of one local, ordered by restrictiveness so that a plain
  /// numeric maximum implements the oracle's `most_restrictive`, whose
  /// ranking is `Valid < Returned < Freed < Moved < Dropped`.
  ///
  /// `MOVE_FREED` is never produced here: it belongs to `deallocate`, which is
  /// not ported. It keeps its rank so the ordering of the states around it
  /// matches the oracle and so a later port needs no renumbering.
  const MOVE_VALID: u32 = 0;
  const MOVE_RETURNED: u32 = 1;
  const MOVE_FREED: u32 = 2;
  const MOVE_MOVED: u32 = 3;
  const MOVE_DROPPED: u32 = 4;

  /// Borrow state encoding for one local, mirroring `BorrowState`:
  /// `0` is unborrowed, `1` is the single mutable borrow, and any value `n`
  /// above 1 is `n - 1` live shared borrows.
  const BORROW_NONE: u32 = 0;
  const BORROW_MUT: u32 = 1;
  const BORROW_SHARED_BASE: u32 = 1;

  /// `heldHolders` entry of a borrow held to the end of its scope.
  const NO_HOLDER: u32 = 4294967295;

  /// `heldHolders` entry of a borrow its holder already released.
  const RELEASED_HOLDER: u32 = 4294967294;

  /// `heldRecorded` value of a granted borrow whose release is not reported.
  const HELD_UNREPORTED: u32 = 2;

  /// Planned last statement of a holder whose borrows stay to scope end.
  const NO_LAST_STATEMENT: u64 = 18446744073709551615;

  /// What one module walk produces: the diagnostics in emission order, the
  /// drop schedules the same walk recorded, and — only when the walk was asked
  /// for it — the ownership events `--dump-ownership-report` renders.
  record BorrowckOutput {
    public diagnostics: DiagnosticBag;
    public dropSchedules: Hir::DropSchedules;
    public ownershipEvents: Vector<Borrowck::OwnershipEvent>;
  }

  /// Copy of the move map, taken around branches and loop bodies.
  record MoveSnapshot {
    public defs: Vector<u32>;
    public values: Vector<u32>;
  }

  /// Copy of the borrow map plus the scope-held borrows, taken around the
  /// branches of an `if` so the else side starts from the same borrow state
  /// the then side did.
  record BorrowSnapshot {
    public defs: Vector<u32>;
    public values: Vector<u32>;
    public heldTargets: Vector<u32>;
    public heldMutable: Vector<u32>;
    public heldRecorded: Vector<u32>;
    public heldHolders: Vector<u32>;
  }

  /// Per-function checker state.
  ///
  /// All maps are parallel vectors keyed by the raw `DefinitionId`, following
  /// the selfhost convention of avoiding hashing for small maps. Mutation
  /// lives in methods rather than in free functions because a direct field
  /// write from outside the record is currently miscompiled for owning
  /// fields.
  record State {
    /// Borrow map: `borrowDefs[i]` has state `borrowValues[i]`.
    borrowDefs: Vector<u32>;
    borrowValues: Vector<u32>;

    /// Move map: only locals that were declared owned or that transitioned
    /// appear here, which is what makes an absent key mean "not tracked"
    /// during a branch join.
    moveDefs: Vector<u32>;
    moveValues: Vector<u32>;

    /// Borrows held until their scope exits, as a flat stack. `scopeStarts`
    /// holds the index each open scope begins at.
    heldTargets: Vector<u32>;
    heldMutable: Vector<u32>;

    /// Whether each held borrow was granted and reported as opened: 1 granted
    /// and reported, `HELD_UNREPORTED` granted but not reported (a `&x`
    /// argument inside a `defer` body), 0 refused. A borrow the walk takes
    /// twice for one `&x` in the source is one logical borrow, so only the
    /// visit that reported the open reports the release; every granted
    /// borrow is released.
    heldRecorded: Vector<u32>;

    /// The binding each held borrow is kept for, or `NO_HOLDER` when no
    /// single binding holds it. A borrow a `let` takes for its binding is
    /// released after the last statement of the binding's block that uses
    /// the binding or anything carrying its view (`holderLastStatement`).
    heldHolders: Vector<u32>;

    /// The binding a `let` is recording held borrows for, `NO_HOLDER`
    /// outside one.
    currentHolder: u32;

    /// The raw definition id of the standard library `String`, the owned
    /// buffer whose own pointer `Analyzer::ViewType::canHoldDerived` does
    /// not count (`stdStringDefinition`).
    public ownedBuffer: u32;

    /// Last statement each holder was planned to be used in, by holder;
    /// `NO_LAST_STATEMENT` keeps its borrows to the end of the scope. The
    /// plan is computed once per holder, right after the statement that
    /// declared it, and reused for every later statement.
    plannedHolders: Vector<u32>;
    plannedLastStatements: Vector<u64>;

    /// Per-block last-use plan memo, one entry per block whose statements
    /// were planned against: `planBlocks[i]` is the raw `HirId` of the
    /// block, `planStatementNodes[i]` every node of its statements and tail
    /// in walk order, `planStatementOfNode[i]` the statement each node
    /// belongs to (the statement count plans the tail) and
    /// `planNodeInDefer[i]` whether the node sits inside a `defer` body. A
    /// use in a `defer` body is not a use at statement granularity: the body
    /// runs at scope end, so it keeps the borrow to the end of the scope
    /// instead. Memoized so planning several holders of a block walks the
    /// block once. `planStatementStarts[i]` is the index of each statement's
    /// first node (one more entry closes the tail), and `planUses[i]` maps a
    /// binding's raw id to the nodes that name it, so planning a holder only
    /// visits the statements that use it or its carriers.
    planBlocks: Vector<u32>;
    planStatementNodes: Vector<Vector<u32>>;
    planStatementOfNode: Vector<Vector<u64>>;
    planNodeInDefer: Vector<Vector<u32>>;
    planStatementStarts: Vector<Vector<u64>>;
    planUses: Vector<HashMap<u64, Vector<u64>>>;

    /// The bindings declared anywhere inside each planned block, closure
    /// parameters and bodies included, by raw id. A carrier declared outside
    /// the block outlives it, so its later uses are not in the plan.
    planDeclared: Vector<HashMap<u64, u32>>;

    /// The bindings whose address a `&x` or `&mut x` anywhere in each planned
    /// block takes, by raw id. An alias of a carrier is not tracked, so a
    /// carrier whose address is taken keeps the borrow to the end of the
    /// scope.
    planAddressTaken: Vector<HashMap<u64, u32>>;

    scopeStarts: Vector<u64>;

    /// Owned-local scope stack, mirroring the ownership oracle's `ScopeEntry`
    /// and pushed at exactly the same three places: the function root, every
    /// block, and the marker scope of every loop.
    ///
    /// `scopeBlocks[i]` is the raw `HirId` of the block that opened scope `i`,
    /// meaningful only when `scopeHasBlock[i]` is set; the root and loop marker
    /// scopes have none and therefore never receive a scope-end schedule.
    /// `ownedStarts[i]` is where scope `i` begins inside the flat `ownedVars`
    /// stack, which holds every owned local in declaration order.
    scopeBlocks: Vector<u32>;
    scopeHasBlock: Vector<u32>;
    scopeIsLoop: Vector<u32>;

    /// Where each open scope ends, so a borrow the scope releases is reported
    /// at the brace that released it rather than at no position at all. A
    /// scope with no block of its own — the function root's marker, a loop's,
    /// a match arm's — carries a synthetic span.
    scopeEndSpans: Vector<SourceSpan>;
    ownedStarts: Vector<u64>;
    ownedVars: Vector<u32>;

    /// Deferred bodies registered per scope, laid out like `ownedVars`.
    deferStarts: Vector<u64>;
    deferBodies: Vector<u32>;

    /// One entry per enclosing loop, set when a `continue` was seen in it.
    loopContinue: Vector<u32>;

    /// The places the enclosing loops' `let` conditions consume, laid out like
    /// `ownedVars`: `loopScrutineeStarts[i]` is where loop `i` begins inside the
    /// flat `loopScrutinees` stack. A loop condition takes its scrutinee apart on
    /// every round, so the place is only refilled by a body that assigns to it,
    /// and the condition that ends the loop is what frees whatever the last round
    /// put there. A `break` never reaches that condition, so it owes the drop; one
    /// frame per loop keeps a `break` out of an inner loop off an outer
    /// condition's place. Mirrors `loop_condition_scrutinees`.
    loopScrutineeStarts: Vector<u64>;
    loopScrutinees: Vector<u32>;

    /// Pattern bindings whose bytes live in borrowed storage, because the
    /// scrutinee they were destructured from is a reference. Moving one of
    /// these is what the oracle reports as a move out of a borrowed value.
    borrowedBindings: Vector<u32>;

    /// While a closure's thunk is walked, the owning values its environment
    /// holds by value. They are borrowed bindings too, and this list only
    /// selects the diagnostic that explains why.
    environmentCaptures: Vector<u32>;

    /// One frame per match currently being checked, holding the values its
    /// arms handed to the match result. A match nested in an arm of another
    /// drains its frame into the enclosing one when it finishes, because a
    /// nested match's result *is* the enclosing arm's value. Mirrors
    /// `arm_result_move_frames`.
    armResultMoveFrames: Vector<Vector<u32>>;

    /// Raw `HirId`s of the blocks whose tail value leaves them: a used match
    /// arm, a body producing its function's result, and every block that is
    /// the tail of one of those. A binding such a block declares and names as
    /// its tail is handed to that value before the block's scope ends.
    tailHandoverBlocks: Vector<u32>;

    /// Raw `HirId`s of every node sitting directly in a block's statement
    /// list, whose value is therefore discarded. Computed once for the whole
    /// module and installed before each function is walked. Mirrors
    /// `statement_position_nodes`.
    statementPositionNodes: Vector<u32>;

    /// Owning bindings a `let`-condition match introduced, as a flat map:
    /// `letConditionMatches[i]` is the raw `HirId` of the match and
    /// `letConditionOwned[i]` the raw definition it owes. The arm bodies of
    /// such a match are literals, so the arm cannot own the drop; the branch
    /// the condition guards takes it instead. Mirrors
    /// `let_condition_bindings`.
    letConditionMatches: Vector<u32>;
    letConditionOwned: Vector<u32>;

    /// The place each `let`-condition match consumed, as a flat map:
    /// `letConditionScrutineeMatches[i]` is the raw `HirId` of the match and
    /// `letConditionScrutineeDefs[i]` the raw definition it took. A `let`
    /// behind a `&&` only runs when everything to its left was true, so
    /// `takeConditionBindings` reads this map to give the short-circuit's false
    /// path the drop the skipped move left owing. Mirrors
    /// `let_condition_scrutinees`.
    letConditionScrutineeMatches: Vector<u32>;
    letConditionScrutineeDefs: Vector<u32>;

    /// Maps every binding that names a heap closure environment to the binding
    /// that owns it, as a flat map: `closureEnvBindings[i]` is the raw
    /// definition of the binding and `closureEnvOwners[i]` the raw definition
    /// of its owner. An owner maps to itself; `let alias = owner` adds the
    /// alias.
    ///
    /// A closure value is copied bitwise, so an alias does not take the
    /// environment over — but returning either one hands it to the caller, and
    /// the owner's drop has to be cancelled or the caller receives a freed
    /// environment. The type itself needs no drop, so `movedVariable` does not
    /// see these bindings and the ordinary move path never fires for them.
    /// Mirrors `closure_env_owner_of`.
    closureEnvBindings: Vector<u32>;
    closureEnvOwners: Vector<u32>;

    /// Bindings whose closure value is captured by value into an escaping
    /// closure's environment. That environment outlives the frame, so the
    /// binding must not free the captured closure's own environment at scope
    /// exit. Nothing frees it instead: the outer environment holds the only
    /// copy, and a closure drop function does not tear down closure-typed
    /// captures. Mirrors `envs_captured_by_escaping_closures`.
    envsCapturedByEscapingClosures: Vector<u32>;

    /// Bindings that are handed a closure environment by an assignment rather
    /// than by their initializer. They own it exactly like an initialized one,
    /// and the drop belongs to the scope the binding lives in, so the `Let` arm
    /// reads this and declares them owned there. Mirrors
    /// `bindings_assigned_closure_env`.
    bindingsAssignedClosureEnv: Vector<u32>;

    /// Owners of a closure environment whose value cannot be copied: the
    /// environment has a drop function, so a second copy would either free it
    /// twice or outlive the free. Handing such a binding on by value moves it,
    /// exactly like a value whose type needs a drop. An owner whose closure has
    /// no drop function stays copyable.
    moveOnlyClosureOwners: Vector<u32>;

    /// The scope depth each parameter and `let`-declared local was declared at,
    /// as a flat map. A view stored into a binding is rejected when its owner
    /// was declared deeper than the binding, because the owner is dropped
    /// first. Locals introduced any other way (pattern bindings, loop
    /// variables) have no entry, and no depth comparison is made for them.
    localDepthDefs: Vector<u32>;
    localDepths: Vector<u64>;

    /// Locals that hold a view, mapped to the local whose storage the view
    /// points into, as a flat map: `viewDefs[i]` views `viewOwners[i]`. This
    /// is the variable-initializer chain: a view taken from a view local
    /// borrows from the original owner, not from the view local.
    viewDefs: Vector<u32>;
    viewOwners: Vector<u32>;

    /// Parallel to `viewDefs`: set when the view came from a method call, so
    /// the binding holds a borrow of the owner taken for the view itself.
    /// `let r = &x` maps `r` to `x` for the chain but leaves this clear.
    viewFromMethod: Vector<u32>;

    /// Locals whose storage is a temporary that lives only to a given scope
    /// depth: a pattern binding destructured by reference out of a temporary
    /// scrutinee lives in that temporary, which dies when the `match` (or the
    /// `if let`, the `while let` condition) ends, and so does any view local
    /// taken from such a binding inside the arm. `temporaryStorageNodes[i]` is
    /// the raw `HirId` of the temporary, for the diagnostic. Entries are
    /// switched off by `temporaryStorageActive` when the local is reassigned.
    temporaryStorageDefs: Vector<u32>;
    temporaryStorageDepths: Vector<u64>;
    temporaryStorageNodes: Vector<u32>;
    temporaryStorageActive: Vector<u32>;

    /// Locals some aggregate stored into a binding holds a view of, such as
    /// `owned` in `let holder = Holder { name: owned.toStr() };`. Like a method
    /// view, the binding holds a borrow of them, so moving them is reported.
    aggregateViewOwners: Vector<u32>;

    /// Moves of a local that was borrowed at the time, in walk order. The
    /// consumption sites hold no diagnostic bag, so `checkFunction` reports
    /// these once the walk ends. A loop body walked twice records the same
    /// move twice; `recordMovedWhileBorrowed` keeps one.
    movedWhileBorrowedDefs: Vector<u32>;
    movedWhileBorrowedSpans: Vector<SourceSpan>;

    /// False after a terminator, until a join restores it.
    public reachable: boolean;

    /// True while walking a deferred body, where a temporary borrow outlives
    /// the expression that took it because the body runs at scope exit.
    public inDefer: boolean;

    /// Whether the function uses raw pointers or inline assembly
    /// (`functionUsesRawPointers`): every borrow a binding holds then lasts
    /// to the end of its scope.
    public keepsBorrowsToScopeEnd: boolean;

    /// True while walking the body of an instance `drop` method of a `Drop`
    /// type, where `self.field.drop()` is the recursive teardown the type
    /// owes rather than an untracked manual drop. Mirrors
    /// `is_inside_drop_method`.
    public inDropMethod: boolean;

    /// Function whose body is currently being walked, mirroring the
    /// ownership oracle's `current_fn`. Used only to attribute a recorded
    /// move site to its owning function for `--dump-drop-schedule`; nothing
    /// else in this checker reads it.
    currentFunction: Analyzer::DefinitionId;

    /// Whether `--dump-ownership-report` asked for the events below. Every
    /// recording site tests `isRecordingReport` before it builds anything, so
    /// a run without the flag allocates nothing and takes one boolean test per
    /// site.
    reportEnabled: boolean;

    /// True while walking a repeat of a body that was already walked, which is
    /// the second pass `checkLoop` makes. The walk has to happen — it is what
    /// finds a value moved on the second iteration — but the events it would
    /// record are the same ones the first pass already recorded. Drop
    /// schedules are not suppressed here: a duplicate the schedule really
    /// holds is what this report exists to show.
    reportSuppressed: boolean;

    /// Events recorded for the function currently being walked, drained by
    /// `checkFunction`.
    reportEvents: Vector<Borrowck::OwnershipEvent>;

    public static init(): State {
      return State {
        borrowDefs: Vector::new<u32>(),
        borrowValues: Vector::new<u32>(),
        moveDefs: Vector::new<u32>(),
        moveValues: Vector::new<u32>(),
        heldTargets: Vector::new<u32>(),
        heldMutable: Vector::new<u32>(),
        heldRecorded: Vector::new<u32>(),
        heldHolders: Vector::new<u32>(),
        currentHolder: Borrowck::NO_HOLDER,
        ownedBuffer: 4294967295,
        plannedHolders: Vector::new<u32>(),
        plannedLastStatements: Vector::new<u64>(),
        planBlocks: Vector::new<u32>(),
        planStatementNodes: Vector::new<Vector<u32>>(),
        planStatementOfNode: Vector::new<Vector<u64>>(),
        planNodeInDefer: Vector::new<Vector<u32>>(),
        planStatementStarts: Vector::new<Vector<u64>>(),
        planUses: Vector::new<HashMap<u64, Vector<u64>>>(),
        planDeclared: Vector::new<HashMap<u64, u32>>(),
        planAddressTaken: Vector::new<HashMap<u64, u32>>(),
        scopeStarts: Vector::new<u64>(),
        scopeBlocks: Vector::new<u32>(),
        scopeHasBlock: Vector::new<u32>(),
        scopeIsLoop: Vector::new<u32>(),
        scopeEndSpans: Vector::new<SourceSpan>(),
        ownedStarts: Vector::new<u64>(),
        ownedVars: Vector::new<u32>(),
        deferStarts: Vector::new<u64>(),
        deferBodies: Vector::new<u32>(),
        loopContinue: Vector::new<u32>(),
        loopScrutineeStarts: Vector::new<u64>(),
        loopScrutinees: Vector::new<u32>(),
        borrowedBindings: Vector::new<u32>(),
        environmentCaptures: Vector::new<u32>(),
        armResultMoveFrames: Vector::new<Vector<u32>>(),
        tailHandoverBlocks: Vector::new<u32>(),
        statementPositionNodes: Vector::new<u32>(),
        letConditionMatches: Vector::new<u32>(),
        letConditionOwned: Vector::new<u32>(),
        letConditionScrutineeMatches: Vector::new<u32>(),
        letConditionScrutineeDefs: Vector::new<u32>(),
        closureEnvBindings: Vector::new<u32>(),
        closureEnvOwners: Vector::new<u32>(),
        envsCapturedByEscapingClosures: Vector::new<u32>(),
        bindingsAssignedClosureEnv: Vector::new<u32>(),
        moveOnlyClosureOwners: Vector::new<u32>(),
        localDepthDefs: Vector::new<u32>(),
        localDepths: Vector::new<u64>(),
        viewDefs: Vector::new<u32>(),
        viewOwners: Vector::new<u32>(),
        viewFromMethod: Vector::new<u32>(),
        temporaryStorageDefs: Vector::new<u32>(),
        temporaryStorageDepths: Vector::new<u64>(),
        temporaryStorageNodes: Vector::new<u32>(),
        temporaryStorageActive: Vector::new<u32>(),
        aggregateViewOwners: Vector::new<u32>(),
        movedWhileBorrowedDefs: Vector::new<u32>(),
        movedWhileBorrowedSpans: Vector::new<SourceSpan>(),
        reachable: true,
        inDefer: false,
        keepsBorrowsToScopeEnd: false,
        inDropMethod: false,
        currentFunction: Id::fromRaw<Analyzer::DefinitionTag>(0),
        reportEnabled: false,
        reportSuppressed: false,
        reportEvents: Vector::new<Borrowck::OwnershipEvent>(),
      };
    }

    public setReportEnabled(&mut self, value: boolean): void {
      self.reportEnabled = value;
    }

    public recordLocalDepth(&mut self, defRaw: u32, depth: u64): void {
      self.localDepthDefs.push(defRaw);
      self.localDepths.push(depth);
    }

    /// The depth `defRaw` was declared at, or `NONE` when it was not
    /// declared by a `let` or as a parameter.
    public localDepth(&self, defRaw: u32): Option<u64> {
      let mut index: u64 = 0;

      while (index < self.localDepthDefs.length()) {
        if (let Option::SOME(candidate) = self.localDepthDefs.get(index)) {
          if (*candidate == defRaw) {
            if (let Option::SOME(depth) = self.localDepths.get(index)) {
              return Option::SOME(*depth);
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// Records that `viewRaw` now holds a view of `ownerRaw`, replacing
    /// whatever it viewed before. `fromMethod` is set for a view a method call
    /// produced.
    public setViewOwner(&mut self, viewRaw: u32, ownerRaw: u32, fromMethod: boolean): void {
      let mut index: u64 = 0;

      while (index < self.viewDefs.length()) {
        let mut found: boolean = false;

        if (let Option::SOME(candidate) = self.viewDefs.get(index)) {
          found = *candidate == viewRaw;
        }

        if (found) {
          self.viewOwners.set(index, ownerRaw);
          self.viewFromMethod.set(index, Borrowck::boolAsFlag(fromMethod));
          return;
        }

        index += 1;
      }

      self.viewDefs.push(viewRaw);
      self.viewOwners.push(ownerRaw);
      self.viewFromMethod.push(Borrowck::boolAsFlag(fromMethod));
    }

    /// Records that `viewRaw` no longer views any local. A view of storage
    /// this function does not own is not tracked, so it maps to itself, which
    /// `viewOwnerOf` reads as no owner.
    public clearViewOwner(&mut self, viewRaw: u32): void {
      if (self.viewOwnerOf(viewRaw).isSome()) {
        self.setViewOwner(viewRaw, viewRaw, false);
      }
    }

    public viewOwnerOf(&self, viewRaw: u32): Option<u32> {
      let mut index: u64 = 0;

      while (index < self.viewDefs.length()) {
        if (let Option::SOME(candidate) = self.viewDefs.get(index)) {
          if (*candidate == viewRaw) {
            if (let Option::SOME(owner) = self.viewOwners.get(index)) {
              if (*owner == viewRaw) {
                return Option::NONE;
              }

              return Option::SOME(*owner);
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// Whether `viewRaw` is a view local that holds a borrow of its owner,
    /// taken when a method call produced the view.
    public viewHoldsBorrow(&self, viewRaw: u32): boolean {
      let mut index: u64 = 0;

      while (index < self.viewDefs.length()) {
        if (let Option::SOME(candidate) = self.viewDefs.get(index)) {
          if (*candidate == viewRaw) {
            if (let Option::SOME(owner) = self.viewOwners.get(index)) {
              if (let Option::SOME(fromMethod) = self.viewFromMethod.get(index)) {
                return *owner != viewRaw && *fromMethod == 1;
              }
            }
          }
        }

        index += 1;
      }

      return false;
    }

    /// Records that the storage of `defRaw` is the temporary `nodeRaw`, alive
    /// down to scope depth `depth`.
    public setTemporaryStorage(&mut self, defRaw: u32, depth: u64, nodeRaw: u32): void {
      self.temporaryStorageDefs.push(defRaw);
      self.temporaryStorageDepths.push(depth);
      self.temporaryStorageNodes.push(nodeRaw);
      self.temporaryStorageActive.push(1);
    }

    public clearTemporaryStorage(&mut self, defRaw: u32): void {
      let mut index: u64 = 0;

      while (index < self.temporaryStorageDefs.length()) {
        let mut found: boolean = false;

        if (let Option::SOME(candidate) = self.temporaryStorageDefs.get(index)) {
          found = *candidate == defRaw;
        }

        if (found) {
          self.temporaryStorageActive.set(index, 0);
        }

        index += 1;
      }
    }

    /// The temporary `defRaw` lives in, as a scoped temporary owner, when it
    /// is one.
    public temporaryStorageOf(&self, defRaw: u32): Option<Borrowck::ViewOwner> {
      let mut index: u64 = self.temporaryStorageDefs.length();

      while (index > 0) {
        index -= 1;

        if (let Option::SOME(candidate) = self.temporaryStorageDefs.get(index)) {
          if (*candidate == defRaw) {
            if (let Option::SOME(active) = self.temporaryStorageActive.get(index)) {
              if (*active == 0) {
                return Option::NONE;
              }
            }

            let mut depth: u64 = 0;
            let mut nodeRaw: u32 = 0;

            if (let Option::SOME(entry) = self.temporaryStorageDepths.get(index)) {
              depth = *entry;
            }

            if (let Option::SOME(entry) = self.temporaryStorageNodes.get(index)) {
              nodeRaw = *entry;
            }

            return Option::SOME(Borrowck::scopedTemporaryViewOwner(Id::fromRaw<Hir::NodeTag>(nodeRaw), depth));
          }
        }
      }

      return Option::NONE;
    }

    public markAggregateViewOwner(&mut self, ownerRaw: u32): void {
      self.aggregateViewOwners.push(ownerRaw);
    }

    /// Whether some local holds a view a method call produced of `ownerRaw`.
    /// Read only together with the borrow map: a view whose scope ended
    /// released its borrow.
    public isViewOwner(&self, ownerRaw: u32): boolean {
      let mut index: u64 = 0;

      while (index < self.aggregateViewOwners.length()) {
        if (let Option::SOME(owner) = self.aggregateViewOwners.get(index)) {
          if (*owner == ownerRaw) {
            return true;
          }
        }

        index += 1;
      }

      index = 0;

      while (index < self.viewOwners.length()) {
        if (let Option::SOME(owner) = self.viewOwners.get(index)) {
          if (let Option::SOME(fromMethod) = self.viewFromMethod.get(index)) {
            if (*owner == ownerRaw && *fromMethod == 1) {
              return true;
            }
          }
        }

        index += 1;
      }

      return false;
    }

    public recordMovedWhileBorrowed(&mut self, defRaw: u32, span: SourceSpan): void {
      let mut index: u64 = 0;

      while (index < self.movedWhileBorrowedDefs.length()) {
        let mut seen: boolean = false;

        if (let Option::SOME(candidate) = self.movedWhileBorrowedDefs.get(index)) {
          if (let Option::SOME(seenSpan) = self.movedWhileBorrowedSpans.get(index)) {
            seen = *candidate == defRaw && seenSpan.start == span.start && seenSpan.end == span.end;
          }
        }

        if (seen) {
          return;
        }

        index += 1;
      }

      self.movedWhileBorrowedDefs.push(defRaw);
      self.movedWhileBorrowedSpans.push(span);
    }

    public movedWhileBorrowedCount(&self): u64 {
      return self.movedWhileBorrowedDefs.length();
    }

    public movedWhileBorrowedDefAt(&self, index: u64): Option<u32> {
      return match (self.movedWhileBorrowedDefs.get(index)) {
        Option::SOME(defRaw) -> Option::SOME(*defRaw),
        Option::NONE -> Option::NONE,
      };
    }

    public movedWhileBorrowedSpanAt(&self, index: u64): Option<SourceSpan> {
      return match (self.movedWhileBorrowedSpans.get(index)) {
        Option::SOME(span) -> Option::SOME(*span),
        Option::NONE -> Option::NONE,
      };
    }

    public setReportSuppressed(&mut self, value: boolean): void {
      self.reportSuppressed = value;
    }

    public reportIsSuppressed(&self): boolean {
      return self.reportSuppressed;
    }

    /// The one test every recording site makes before building an event.
    public isRecordingReport(&self): boolean {
      return self.reportEnabled && !self.reportSuppressed;
    }

    public pushReportEvent(&mut self, event: Borrowck::OwnershipEvent): void {
      self.reportEvents.push(event);
    }

    public reportEventCount(&self): u64 {
      return self.reportEvents.length();
    }

    public reportEventAt(&self, index: u64): Option<&Borrowck::OwnershipEvent> {
      return self.reportEvents.get(index);
    }

    /// Hands over what this function recorded and starts the next one empty.
    public takeReportEvents(&mut self): Vector<Borrowck::OwnershipEvent> {
      let mut taken: Vector<Borrowck::OwnershipEvent> = Vector::new<Borrowck::OwnershipEvent>();
      let mut index: u64 = 0;

      while (index < self.reportEvents.length()) {
        if (let Option::SOME(event) = self.reportEvents.get(index)) {
          taken.push(Borrowck::copyOwnershipEvent(event));
        }

        index += 1;
      }

      self.reportEvents = Vector::new<Borrowck::OwnershipEvent>();

      return taken;
    }

    public setKeepsBorrowsToScopeEnd(&mut self, value: boolean): void {
      self.keepsBorrowsToScopeEnd = value;
    }

    public setOwnedBuffer(&mut self, definition: u32): void {
      self.ownedBuffer = definition;
    }

    public setCurrentFunction(&mut self, defId: Analyzer::DefinitionId): void {
      self.currentFunction = defId;
    }

    public currentFunctionId(&self): Analyzer::DefinitionId {
      return self.currentFunction;
    }

    public setReachable(&mut self, value: boolean): void {
      self.reachable = value;
    }

    public setEnvsCapturedByEscapingClosures(&mut self, values: Vector<u32>): void {
      self.envsCapturedByEscapingClosures = values;
    }

    public setBindingsAssignedClosureEnv(&mut self, values: Vector<u32>): void {
      self.bindingsAssignedClosureEnv = values;
    }

    public isAssignedClosureEnv(&self, bindingRaw: u32): boolean {
      let mut index: u64 = 0;

      while (index < self.bindingsAssignedClosureEnv.length()) {
        if (let Option::SOME(existing) = self.bindingsAssignedClosureEnv.get(index)) {
          if (*existing == bindingRaw) {
            return true;
          }
        }

        index += 1;
      }

      return false;
    }

    public envIsCapturedByEscapingClosure(&self, bindingRaw: u32): boolean {
      let mut index: u64 = 0;

      while (index < self.envsCapturedByEscapingClosures.length()) {
        if (let Option::SOME(existing) = self.envsCapturedByEscapingClosures.get(index)) {
          if (*existing == bindingRaw) {
            return true;
          }
        }

        index += 1;
      }

      return false;
    }

    /// Note that binding `bindingRaw` names the closure environment owned by
    /// `ownerRaw`.
    public recordClosureEnvOwner(&mut self, bindingRaw: u32, ownerRaw: u32): void {
      self.closureEnvBindings.push(bindingRaw);
      self.closureEnvOwners.push(ownerRaw);
    }

    /// Note that the closure environment owner `bindingRaw` is moved, not
    /// copied, when it is handed on by value.
    public markMoveOnlyClosureOwner(&mut self, bindingRaw: u32): void {
      if (!Borrowck::containsRaw(&mut self.moveOnlyClosureOwners, bindingRaw)) {
        self.moveOnlyClosureOwners.push(bindingRaw);
      }
    }

    public isMoveOnlyClosureOwner(&mut self, bindingRaw: u32): boolean {
      return Borrowck::containsRaw(&mut self.moveOnlyClosureOwners, bindingRaw);
    }

    /// The binding that owns the closure environment `bindingRaw` names.
    public closureEnvOwnerOf(&self, bindingRaw: u32): Option<u32> {
      let mut index: u64 = 0;

      while (index < self.closureEnvBindings.length()) {
        if (let Option::SOME(raw) = self.closureEnvBindings.get(index)) {
          if (*raw == bindingRaw) {
            if (let Option::SOME(owner) = self.closureEnvOwners.get(index)) {
              return Option::SOME(*owner);
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// Note that `defRaw` is owed a drop by whatever branch the condition of
    /// match `matchRaw` guards.
    public recordLetConditionBinding(&mut self, matchRaw: u32, defRaw: u32): void {
      self.letConditionMatches.push(matchRaw);
      self.letConditionOwned.push(defRaw);
    }

    /// Note that match `matchRaw` consumed the place `defRaw`. Replacing rather
    /// than appending mirrors the oracle's `HashMap::insert`, so a condition
    /// walked twice records one place, not two.
    public recordLetConditionScrutinee(&mut self, matchRaw: u32, defRaw: u32): void {
      let mut index: u64 = 0;

      while (index < self.letConditionScrutineeMatches.length()) {
        if (let Option::SOME(raw) = self.letConditionScrutineeMatches.get(index)) {
          if (*raw == matchRaw) {
            self.letConditionScrutineeDefs.set(index, defRaw);
            return;
          }
        }

        index += 1;
      }

      self.letConditionScrutineeMatches.push(matchRaw);
      self.letConditionScrutineeDefs.push(defRaw);
    }

    /// The place match `matchRaw` consumed, if it is a `let` condition that took
    /// one. Reading rather than taking mirrors the oracle: the same entry is
    /// read once per `&&` that stands in front of that `let`.
    public letConditionScrutinee(&self, matchRaw: u32): Option<u32> {
      let mut index: u64 = 0;

      while (index < self.letConditionScrutineeMatches.length()) {
        if (let Option::SOME(raw) = self.letConditionScrutineeMatches.get(index)) {
          if (*raw == matchRaw) {
            if (let Option::SOME(defRaw) = self.letConditionScrutineeDefs.get(index)) {
              return Option::SOME(*defRaw);
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// Hand over the bindings recorded for `matchRaw`, in declaration order,
    /// and forget them. Taking rather than reading keeps a match that is walked
    /// twice — a loop body re-checks its statements — from handing the same
    /// binding to two drop sites.
    public takeLetConditionBindings(&mut self, matchRaw: u32): Vector<u32> {
      let mut taken: Vector<u32> = Vector::new<u32>();
      let mut keptMatches: Vector<u32> = Vector::new<u32>();
      let mut keptOwned: Vector<u32> = Vector::new<u32>();
      let mut index: u64 = 0;

      while (index < self.letConditionMatches.length()) {
        let mut entryMatch: u32 = 0;
        let mut entryOwned: u32 = 0;

        if (let Option::SOME(raw) = self.letConditionMatches.get(index)) {
          entryMatch = *raw;
        }

        if (let Option::SOME(raw) = self.letConditionOwned.get(index)) {
          entryOwned = *raw;
        }

        if (entryMatch == matchRaw) {
          taken.push(entryOwned);
        } else {
          keptMatches.push(entryMatch);
          keptOwned.push(entryOwned);
        }

        index += 1;
      }

      self.letConditionMatches = keptMatches;
      self.letConditionOwned = keptOwned;

      return taken;
    }

    /// Mark `defRaw` as living in borrowed storage for as long as the arm that
    /// bound it is being walked.
    public markBorrowedBinding(&mut self, defRaw: u32): void {
      self.borrowedBindings.push(defRaw);
    }

    /// Mark `defRaw` as a value the environment of the closure being walked
    /// owns: the body may read it and borrow it, never move it out.
    public markEnvironmentCapture(&mut self, defRaw: u32): void {
      self.borrowedBindings.push(defRaw);
      self.environmentCaptures.push(defRaw);
    }

    public isEnvironmentCapture(&self, defRaw: u32): boolean {
      let mut index: u64 = 0;

      while (index < self.environmentCaptures.length()) {
        if (let Option::SOME(entry) = self.environmentCaptures.get(index)) {
          if (*entry == defRaw) {
            return true;
          }
        }

        index += 1;
      }

      return false;
    }

    public borrowedBindingCount(&self): u64 {
      return self.borrowedBindings.length();
    }

    public isBorrowedBinding(&self, defRaw: u32): boolean {
      let mut index: u64 = 0;

      while (index < self.borrowedBindings.length()) {
        if (let Option::SOME(entry) = self.borrowedBindings.get(index)) {
          if (*entry == defRaw) {
            return true;
          }
        }

        index += 1;
      }

      return false;
    }

    /// Drop every borrowed binding registered past `mark`, which is the length
    /// the vector had before the arm was walked.
    public truncateBorrowedBindings(&mut self, mark: u64): void {
      while (self.borrowedBindings.length() > mark) {
        self.borrowedBindings.pop();
      }
    }

    public markTailHandover(&mut self, blockRaw: u32): void {
      Borrowck::pushUniqueRaw(&mut self.tailHandoverBlocks, blockRaw);
    }

    public handsOverTail(&self, blockRaw: u32): boolean {
      let mut index: u64 = 0;

      while (index < self.tailHandoverBlocks.length()) {
        if (let Option::SOME(existing) = self.tailHandoverBlocks.get(index)) {
          if (*existing == blockRaw) {
            return true;
          }
        }

        index += 1;
      }

      return false;
    }

    /// Push a fresh frame for a match that is about to be checked.
    public pushArmResultMoveFrame(&mut self): void {
      self.armResultMoveFrames.push(Vector::new<u32>());
    }

    /// Record that this match's arm handed `defRaw` to the match result.
    /// Recorded in the top frame, which belongs to the match currently being
    /// checked.
    public recordArmResultMove(&mut self, defRaw: u32): void {
      let topIndex: u64 = self.armResultMoveFrames.length();

      if (topIndex == 0) {
        return;
      }

      if (let Option::SOME(frame) = self.armResultMoveFrames.getMut(topIndex - 1)) {
        Borrowck::pushUniqueRaw(frame, defRaw);
      }
    }

    /// Pop the top frame, draining its contents into the frame beneath it (if
    /// any) without duplicates — a nested match's result is the enclosing
    /// arm's value, so whatever it moved the enclosing match moved too.
    /// Returns the popped frame for the compensation pass.
    public popArmResultMoveFrame(&mut self): Vector<u32> {
      let Option::SOME(popped) = self.armResultMoveFrames.pop() else {
        return Vector::new<u32>();
      };

      let parentIndex: u64 = self.armResultMoveFrames.length();

      if (parentIndex > 0) {
        if (let Option::SOME(parent) = self.armResultMoveFrames.getMut(parentIndex - 1)) {
          let mut index: u64 = 0;

          while (index < popped.length()) {
            if (let Option::SOME(defRaw) = popped.get(index)) {
              Borrowck::pushUniqueRaw(parent, *defRaw);
            }

            index += 1;
          }
        }
      }

      return popped;
    }

    public setStatementPositionNodes(&mut self, nodes: Vector<u32>): void {
      self.statementPositionNodes = nodes;
    }

    /// Whether `raw` names a node sitting directly in a block's statement
    /// list — a position whose value is discarded rather than handed to
    /// anything.
    public isStatementPosition(&mut self, raw: u32): boolean {
      return Borrowck::containsRaw(&mut self.statementPositionNodes, raw);
    }

    public setInDefer(&mut self, value: boolean): void {
      self.inDefer = value;
    }

    public setInDropMethod(&mut self, value: boolean): void {
      self.inDropMethod = value;
    }

    public borrowValue(&self, defRaw: u32): u32 {
      let mut index: u64 = 0;

      while (index < self.borrowDefs.length()) {
        if (let Option::SOME(candidate) = self.borrowDefs.get(index)) {
          if (*candidate == defRaw) {
            if (let Option::SOME(value) = self.borrowValues.get(index)) {
              return *value;
            }
          }
        }

        index += 1;
      }

      return Borrowck::BORROW_NONE;
    }

    public setBorrowValue(&mut self, defRaw: u32, value: u32): void {
      let mut index: u64 = 0;

      while (index < self.borrowDefs.length()) {
        let mut found: boolean = false;

        if (let Option::SOME(candidate) = self.borrowDefs.get(index)) {
          if (*candidate == defRaw) {
            found = true;
          }
        }

        if (found) {
          self.borrowValues.set(index, value);
          return;
        }

        index += 1;
      }

      self.borrowDefs.push(defRaw);
      self.borrowValues.push(value);
    }

    public moveValue(&self, defRaw: u32): Option<u32> {
      let mut index: u64 = 0;

      while (index < self.moveDefs.length()) {
        if (let Option::SOME(candidate) = self.moveDefs.get(index)) {
          if (*candidate == defRaw) {
            if (let Option::SOME(value) = self.moveValues.get(index)) {
              return Option::SOME(*value);
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    public setMoveValue(&mut self, defRaw: u32, value: u32): void {
      let mut index: u64 = 0;

      while (index < self.moveDefs.length()) {
        let mut found: boolean = false;

        if (let Option::SOME(candidate) = self.moveDefs.get(index)) {
          if (*candidate == defRaw) {
            found = true;
          }
        }

        if (found) {
          self.moveValues.set(index, value);
          return;
        }

        index += 1;
      }

      self.moveDefs.push(defRaw);
      self.moveValues.push(value);
    }

    /// Drops one local from the move map. Match arms use it to keep their own
    /// pattern bindings out of the cross-arm join, exactly like the oracle
    /// removes them before merging.
    public removeMoveValue(&mut self, defRaw: u32): void {
      let mut defs: Vector<u32> = Vector::new<u32>();
      let mut values: Vector<u32> = Vector::new<u32>();
      let mut index: u64 = 0;

      while (index < self.moveDefs.length()) {
        if (let Option::SOME(candidate) = self.moveDefs.get(index)) {
          if (let Option::SOME(value) = self.moveValues.get(index)) {
            if (*candidate != defRaw) {
              defs.push(*candidate);
              values.push(*value);
            }
          }
        }

        index += 1;
      }

      self.moveDefs = defs;
      self.moveValues = values;
    }

    public snapshotMoves(&self): Borrowck::MoveSnapshot {
      let mut defs: Vector<u32> = Vector::new<u32>();
      let mut values: Vector<u32> = Vector::new<u32>();
      let mut index: u64 = 0;

      while (index < self.moveDefs.length()) {
        if (let Option::SOME(defRaw) = self.moveDefs.get(index)) {
          if (let Option::SOME(value) = self.moveValues.get(index)) {
            defs.push(*defRaw);
            values.push(*value);
          }
        }

        index += 1;
      }

      return Borrowck::MoveSnapshot { defs: defs, values: values };
    }

    public restoreMoves(&mut self, snapshot: &Borrowck::MoveSnapshot): void {
      self.moveDefs = Borrowck::copyU32Vector(&snapshot.defs);
      self.moveValues = Borrowck::copyU32Vector(&snapshot.values);
    }

    public snapshotBorrows(&self): Borrowck::BorrowSnapshot {
      return Borrowck::BorrowSnapshot {
        defs: Borrowck::copyU32Vector(&self.borrowDefs),
        values: Borrowck::copyU32Vector(&self.borrowValues),
        heldTargets: Borrowck::copyU32Vector(&self.heldTargets),
        heldMutable: Borrowck::copyU32Vector(&self.heldMutable),
        heldRecorded: Borrowck::copyU32Vector(&self.heldRecorded),
        heldHolders: Borrowck::copyU32Vector(&self.heldHolders),
      };
    }

    public restoreBorrows(&mut self, snapshot: &Borrowck::BorrowSnapshot): void {
      self.borrowDefs = Borrowck::copyU32Vector(&snapshot.defs);
      self.borrowValues = Borrowck::copyU32Vector(&snapshot.values);
      self.heldTargets = Borrowck::copyU32Vector(&snapshot.heldTargets);
      self.heldMutable = Borrowck::copyU32Vector(&snapshot.heldMutable);
      self.heldRecorded = Borrowck::copyU32Vector(&snapshot.heldRecorded);
      self.heldHolders = Borrowck::copyU32Vector(&snapshot.heldHolders);
    }

    /// Joins the current borrow map with `snapshot`, keeping the more
    /// restrictive state per local: mutable wins over shared, and shared
    /// counts take the maximum. Mirrors `BorrowState::merge`.
    public mergeBorrowsWith(&mut self, snapshot: &Borrowck::BorrowSnapshot): void {
      let mut index: u64 = 0;

      while (index < snapshot.defs.length()) {
        if (let Option::SOME(defRaw) = snapshot.defs.get(index)) {
          if (let Option::SOME(other) = snapshot.values.get(index)) {
            let current: u32 = self.borrowValue(*defRaw);
            self.setBorrowValue(*defRaw, Borrowck::mergeBorrowValues(current, *other));
          }
        }

        index += 1;
      }
    }

    /// Opens a scope. `blockRaw` is only read when `hasBlock` is true, and
    /// `isLoop` marks the loop marker scope that `break` and `continue`
    /// unwind to.
    public pushScope(&mut self, blockRaw: u32, hasBlock: boolean, isLoop: boolean): void {
      self.pushScopeEnding(blockRaw, hasBlock, isLoop, SourceSpan::detached(0, 0));
    }

    /// `pushScope` with the span the scope closes at, which only the callers
    /// holding a block node can supply.
    public pushScopeEnding(
      &mut self,
      blockRaw: u32,
      hasBlock: boolean,
      isLoop: boolean,
      endSpan: SourceSpan,
    ): void {
      self.scopeEndSpans.push(endSpan);
      self.scopeStarts.push(self.heldTargets.length());
      self.scopeBlocks.push(blockRaw);
      self.scopeHasBlock.push(Borrowck::boolAsFlag(hasBlock));
      self.scopeIsLoop.push(Borrowck::boolAsFlag(isLoop));
      self.ownedStarts.push(self.ownedVars.length());
      self.deferStarts.push(self.deferBodies.length());
    }

    /// Registers a local as owned by the innermost scope, which is what makes
    /// it a drop candidate when that scope exits.
    public pushOwned(&mut self, defRaw: u32): void {
      self.ownedVars.push(defRaw);
    }

    public pushDeferBody(&mut self, bodyRaw: u32): void {
      self.deferBodies.push(bodyRaw);
    }

    public scopeDepth(&self): u64 {
      return self.ownedStarts.length();
    }

    /// Block that opened the innermost scope, or `NONE` for the function root
    /// and the loop marker scopes.
    public currentScopeBlock(&self): Option<u32> {
      if (self.ownedStarts.isEmpty()) {
        return Option::NONE;
      }

      let last: u64 = self.ownedStarts.length() - 1;

      if (let Option::SOME(flag) = self.scopeHasBlock.get(last)) {
        if (*flag == 0) {
          return Option::NONE;
        }
      }

      if (let Option::SOME(blockRaw) = self.scopeBlocks.get(last)) {
        return Option::SOME(*blockRaw);
      }

      return Option::NONE;
    }

    /// Index of the innermost loop marker scope, mirroring
    /// `find_loop_scope_idx`.
    public loopScopeIndex(&self): Option<u64> {
      let mut index: u64 = self.scopeIsLoop.length();

      while (index > 0) {
        index -= 1;

        if (let Option::SOME(flag) = self.scopeIsLoop.get(index)) {
          if (*flag == 1) {
            return Option::SOME(index);
          }
        }
      }

      return Option::NONE;
    }

    /// A local is a drop candidate while its move state is `Valid`, which the
    /// oracle spells as `Some(Valid) | None`: a local it never tracked is live.
    public isMoveValid(&self, defRaw: u32): boolean {
      return match (self.moveValue(defRaw)) {
        Option::SOME(value) -> value == Borrowck::MOVE_VALID,
        Option::NONE -> true,
      };
    }

    /// Where the owned locals of scope `scopeIndex` end inside `ownedVars`.
    public ownedEnd(&self, scopeIndex: u64): u64 {
      if (scopeIndex + 1 < self.ownedStarts.length()) {
        if (let Option::SOME(next) = self.ownedStarts.get(scopeIndex + 1)) {
          return *next;
        }
      }

      return self.ownedVars.length();
    }

    public deferEnd(&self, scopeIndex: u64): u64 {
      if (scopeIndex + 1 < self.deferStarts.length()) {
        if (let Option::SOME(next) = self.deferStarts.get(scopeIndex + 1)) {
          return *next;
        }
      }

      return self.deferBodies.length();
    }

    /// Locals to drop when unwinding every scope from the innermost down to
    /// `toScopeIndex`, inclusive. Inner scopes come first, and within one scope
    /// the order is reverse declaration. Mirrors `calculate_exit_drops`.
    public exitDrops(&self, toScopeIndex: u64): Vector<u32> {
      let mut drops: Vector<u32> = Vector::new<u32>();
      let mut scopeIndex: u64 = self.ownedStarts.length();

      while (scopeIndex > toScopeIndex) {
        scopeIndex -= 1;

        let Option::SOME(startValue) = self.ownedStarts.get(scopeIndex) else {
          continue;
        };

        let start: u64 = *startValue;
        let mut position: u64 = self.ownedEnd(scopeIndex);

        while (position > start) {
          position -= 1;

          if (let Option::SOME(defRaw) = self.ownedVars.get(position)) {
            if (self.isMoveValid(*defRaw)) {
              drops.push(*defRaw);
            }
          }
        }
      }

      return drops;
    }

    /// Deferred bodies to run when unwinding to `toScopeIndex`, in LIFO order.
    /// Mirrors `calculate_exit_defers`.
    public exitDefers(&self, toScopeIndex: u64): Vector<u32> {
      let mut defers: Vector<u32> = Vector::new<u32>();
      let mut scopeIndex: u64 = self.deferStarts.length();

      while (scopeIndex > toScopeIndex) {
        scopeIndex -= 1;

        let Option::SOME(startValue) = self.deferStarts.get(scopeIndex) else {
          continue;
        };

        let start: u64 = *startValue;
        let mut position: u64 = self.deferEnd(scopeIndex);

        while (position > start) {
          position -= 1;

          if (let Option::SOME(bodyRaw) = self.deferBodies.get(position)) {
            defers.push(*bodyRaw);
          }
        }
      }

      return defers;
    }

    /// Drops owed by the innermost scope alone, mirroring `exit_block_scope`.
    public currentScopeDrops(&self): Vector<u32> {
      if (self.ownedStarts.isEmpty()) {
        return Vector::new<u32>();
      }

      return self.exitDrops(self.ownedStarts.length() - 1);
    }

    public currentScopeDefers(&self): Vector<u32> {
      if (self.deferStarts.isEmpty()) {
        return Vector::new<u32>();
      }

      return self.exitDefers(self.deferStarts.length() - 1);
    }

    public recordHeldBorrow(&mut self, target: u32, mutable: boolean, recorded: boolean): void {
      self.pushHeldEntry(target, mutable, Borrowck::boolAsFlag(recorded));
    }

    /// Holds a granted borrow to the end of the scope without reporting its
    /// release; a refused one is held as refused.
    public recordUnreportedHeldBorrow(
      &mut self,
      target: u32,
      mutable: boolean,
      granted: boolean
    ): void {
      if (granted) {
        self.pushHeldEntry(target, mutable, Borrowck::HELD_UNREPORTED);
      } else {
        self.pushHeldEntry(target, mutable, 0);
      }
    }

    public pushHeldEntry(&mut self, target: u32, mutable: boolean, recorded: u32): void {
      self.heldTargets.push(target);
      self.heldMutable.push(Borrowck::boolAsFlag(mutable));
      self.heldRecorded.push(recorded);
      self.heldHolders.push(self.currentHolder);
    }

    public setCurrentHolder(&mut self, holder: u32): void {
      self.currentHolder = holder;
    }

    /// The holders of the borrows the innermost scope holds, each once.
    public currentScopeHolders(&self): Vector<u32> {
      let mut holders: Vector<u32> = Vector::new<u32>();

      if (self.scopeStarts.isEmpty()) {
        return holders;
      }

      let Option::SOME(start) = self.scopeStarts.get(self.scopeStarts.length() - 1) else {
        return holders;
      };

      let mut index: u64 = *start;

      while (index < self.heldHolders.length()) {
        if (let Option::SOME(holder) = self.heldHolders.get(index)) {
          if (*holder != Borrowck::NO_HOLDER && *holder != Borrowck::RELEASED_HOLDER) {
            Borrowck::pushUniqueRaw(&mut holders, *holder);
          }
        }

        index += 1;
      }

      return holders;
    }

    public plannedLastStatement(&self, holder: u32): Option<u64> {
      let mut index: u64 = 0;

      while (index < self.plannedHolders.length()) {
        if (let Option::SOME(candidate) = self.plannedHolders.get(index)) {
          if (*candidate == holder) {
            if (let Option::SOME(last) = self.plannedLastStatements.get(index)) {
              return Option::SOME(*last);
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    public recordPlannedLastStatement(&mut self, holder: u32, last: u64): void {
      self.plannedHolders.push(holder);
      self.plannedLastStatements.push(last);
    }

    /// Releases the borrows the innermost scope holds for `holder` and marks
    /// their entries `RELEASED_HOLDER`, so the scope end skips them. Only an
    /// entry the holder was granted is released: releasing a refused borrow
    /// would clear a borrow someone else still holds.
    public releaseHolder(&mut self, holder: u32, span: SourceSpan): void {
      if (self.scopeStarts.isEmpty()) {
        return;
      }

      let Option::SOME(start) = self.scopeStarts.get(self.scopeStarts.length() - 1) else {
        return;
      };

      let mut index: u64 = *start;

      while (index < self.heldHolders.length()) {
        let mut matches: boolean = false;

        if (let Option::SOME(entryHolder) = self.heldHolders.get(index)) {
          matches = *entryHolder == holder;
        }

        if (matches) {
          let mut target: u32 = 0;
          let mut flag: u32 = 0;
          let mut recorded: u32 = 0;

          if (let Option::SOME(value) = self.heldTargets.get(index)) {
            target = *value;
          }

          if (let Option::SOME(value) = self.heldMutable.get(index)) {
            flag = *value;
          }

          if (let Option::SOME(value) = self.heldRecorded.get(index)) {
            recorded = *value;
          }

          self.releaseHeldEntry(target, flag == 1, recorded, self.ownedStarts.length(), span);
          let _marked: boolean = self.heldHolders.set(index, Borrowck::RELEASED_HOLDER);
        }

        index += 1;
      }
    }

    /// Releases one scope-held borrow. The release event the ownership
    /// report shows is emitted here, so the scope-end path and the early
    /// last-use release report the same shape. A borrow that was never
    /// granted — a refused borrow, already reported when it was attempted —
    /// is neither released nor reported: releasing it would clear a borrow
    /// someone else still holds. A granted borrow held unreported
    /// (`HELD_UNREPORTED`) is released without an event.
    public releaseHeldEntry(
      &mut self,
      target: u32,
      mutable: boolean,
      recorded: u32,
      depth: u64,
      span: SourceSpan
    ): void {
      if (recorded == 0) {
        return;
      }

      if (recorded == 1 && self.isRecordingReport()) {
        self.reportEvents.push(Borrowck::OwnershipEvent {
          kind: Borrowck::OwnershipReport::EVENT_BORROW_RELEASE,
          functionRaw: self.currentFunction.raw(),
          variableRaw: target,
          hasVariable: true,
          relatedRaw: 0,
          hasRelated: false,
          detail: 0,
          flag: mutable,
          envKind: Borrowck::OwnershipReport::ENV_UNKNOWN,
          scopeDepth: depth,
          code: "",
          span: span,
        });
      }

      self.releaseBorrow(target, mutable);
    }

    /// The index of `blockRaw`'s last-use plan memo, computing it the first
    /// time: every node of each statement and the tail in walk order, the
    /// statement each node belongs to (the statement count plans the tail),
    /// and the bindings each statement names — outside `defer` bodies in
    /// `planStatementUses`, inside them in `planStatementDeferUses`. A use in
    /// a `defer` body is not a use at statement granularity: the body runs
    /// at scope end, so it keeps the borrow to the end of the scope instead.
    public blockPlanIndex(
      &mut self,
      hir: &Hir::HirStore,
      blockRaw: u32,
      statements: &Vector<Hir::HirId>,
      tail: Option<Hir::HirId>,
    ): u64 {
      let mut index: u64 = 0;

      while (index < self.planBlocks.length()) {
        if (let Option::SOME(entry) = self.planBlocks.get(index)) {
          if (*entry == blockRaw) {
            return index;
          }
        }

        index += 1;
      }

      let statementCount: u64 = statements.length();
      let mut nodes: Vector<u32> = Vector::new<u32>();
      let mut nodeStatements: Vector<u64> = Vector::new<u64>();
      let mut nodeInDefer: Vector<u32> = Vector::new<u32>();
      let mut starts: Vector<u64> = Vector::new<u64>();
      let mut uses: HashMap<u64, Vector<u64>> = HashMap::new<u64, Vector<u64>>();
      let mut declared: HashMap<u64, u32> = HashMap::new<u64, u32>();
      let mut addressTaken: HashMap<u64, u32> = HashMap::new<u64, u32>();

      let mut statementIndex: u64 = 0;

      while (statementIndex <= statementCount) {
        starts.push(nodes.length());

        let mut root: Option<Hir::HirId> = Option::NONE;

        if (statementIndex < statementCount) {
          if (let Option::SOME(statement) = statements.get(statementIndex)) {
            root = Option::SOME(*statement);
          }
        } else if (let Option::SOME(tailId) = tail) {
          root = Option::SOME(tailId);
        }

        if (let Option::SOME(rootId) = root) {
          let mut pendingNodes: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
          let mut pendingInDefer: Vector<u32> = Vector::new<u32>();
          pendingNodes.push(rootId);
          pendingInDefer.push(0);

          while (let Option::SOME(current) = pendingNodes.pop()) {
            let mut inDefer: u32 = 0;

            if (let Option::SOME(flag) = pendingInDefer.pop()) {
              inDefer = flag;
            }

            let nodeIndex: u64 = nodes.length();
            nodes.push(current.raw());
            nodeStatements.push(statementIndex);
            nodeInDefer.push(inDefer);

            if (let Option::SOME(node) = hir.get(current)) {
              let mut childInDefer: u32 = inDefer;

              match (&node.kind) {
                Hir::HirKind::Defer(_) -> {
                  childInDefer = 1;
                },
                Hir::HirKind::Variable(defId) -> {
                  Borrowck::addPlanUse(&mut uses, defId.raw() as u64, nodeIndex);
                },
                Hir::HirKind::Reference(reference) -> {
                  if (let Option::SOME(root) = Borrowck::extractRootVariable(hir, reference.expression)) {
                    addressTaken.insert(root.raw() as u64, 1);
                  }
                },
                Hir::HirKind::Closure(closureNode) -> {
                  let mut captureIndex: u64 = 0;

                  while (captureIndex < closureNode.captures.length()) {
                    if (let Option::SOME(capture) = closureNode.captures.get(captureIndex)) {
                      Borrowck::addPlanUse(&mut uses, capture.sourceDef.raw() as u64, nodeIndex);
                    }

                    captureIndex += 1;
                  }

                  let mut paramIndex: u64 = 0;

                  while (paramIndex < closureNode.params.length()) {
                    if (let Option::SOME(param) = closureNode.params.get(paramIndex)) {
                      declared.insert(param.raw() as u64, 1);
                    }

                    paramIndex += 1;
                  }
                },
                _ -> {},
              };

              let mut bound: Vector<u32> = Vector::new<u32>();

              if (Borrowck::bindingsReachedBy(hir, current, &mut bound)) {
                let mut boundIndex: u64 = 0;

                while (boundIndex < bound.length()) {
                  if (let Option::SOME(binding) = bound.get(boundIndex)) {
                    declared.insert(*binding as u64, 1);
                  }

                  boundIndex += 1;
                }
              }

              let children: Vector<Hir::HirId> = Hir::childIds(&node.kind);
              let mut childIndex: u64 = 0;

              while (childIndex < children.length()) {
                if (let Option::SOME(child) = children.get(childIndex)) {
                  pendingNodes.push(*child);
                  pendingInDefer.push(childInDefer);
                }

                childIndex += 1;
              }
            }
          }
        }

        statementIndex += 1;
      }

      starts.push(nodes.length());

      self.planBlocks.push(blockRaw);
      self.planStatementStarts.push(starts);
      self.planUses.push(uses);
      self.planDeclared.push(declared);
      self.planAddressTaken.push(addressTaken);
      self.planStatementNodes.push(nodes);
      self.planStatementOfNode.push(nodeStatements);
      self.planNodeInDefer.push(nodeInDefer);

      return self.planBlocks.length() - 1;
    }

    /// The index of the first node of `statement` in plan `plan`; the entry
    /// past the tail is the node count.
    public planStatementStart(&self, plan: u64, statement: u64): u64 {
      let Option::SOME(starts) = self.planStatementStarts.get(plan) else {
        return 0;
      };

      let Option::SOME(entry) = starts.get(statement) else {
        return 0;
      };

      return *entry;
    }

    /// The nodes of plan `plan` that name the binding `binding`, in walk
    /// order.
    public planUsesOf(&self, plan: u64, binding: u32): Vector<u64> {
      let mut result: Vector<u64> = Vector::new<u64>();

      let Option::SOME(uses) = self.planUses.get(plan) else {
        return result;
      };

      let key: u64 = binding as u64;

      if (let Option::SOME(list) = uses.get(&key)) {
        let mut index: u64 = 0;

        while (index < list.length()) {
          if (let Option::SOME(entry) = list.get(index)) {
            result.push(*entry);
          }

          index += 1;
        }
      }

      return result;
    }

    public planStatementOfNodeAt(&self, plan: u64, nodeIndex: u64): u64 {
      let Option::SOME(ofNode) = self.planStatementOfNode.get(plan) else {
        return 0;
      };

      let Option::SOME(entry) = ofNode.get(nodeIndex) else {
        return 0;
      };

      return *entry;
    }

    /// Whether the binding `binding` is declared inside the block of plan
    /// `plan`.
    public planDeclares(&self, plan: u64, binding: u32): boolean {
      let Option::SOME(declared) = self.planDeclared.get(plan) else {
        return false;
      };

      let key: u64 = binding as u64;
      return declared.containsKey(&key);
    }

    /// Whether a `&` or `&mut` in the block of plan `plan` takes the address
    /// of `binding`.
    public planTakesAddressOf(&self, plan: u64, binding: u32): boolean {
      let Option::SOME(taken) = self.planAddressTaken.get(plan) else {
        return false;
      };

      let key: u64 = binding as u64;
      return taken.containsKey(&key);
    }

    public planNodeRawAt(&self, plan: u64, nodeIndex: u64): u32 {
      let Option::SOME(nodes) = self.planStatementNodes.get(plan) else {
        return 0;
      };

      let Option::SOME(entry) = nodes.get(nodeIndex) else {
        return 0;
      };

      return *entry;
    }

    /// Whether the node `nodeIndex` of plan `plan` sits inside a `defer`
    /// body.
    public planNodeInDeferAt(&self, plan: u64, nodeIndex: u64): boolean {
      let Option::SOME(flags) = self.planNodeInDefer.get(plan) else {
        return false;
      };

      let Option::SOME(flag) = flags.get(nodeIndex) else {
        return false;
      };

      return *flag == 1;
    }

    /// Pops the innermost scope, releasing every borrow registered in it and
    /// discarding the owned locals and deferred bodies it declared.
    ///
    /// The drops those locals owe are read out by `Borrowck::exitScope` before
    /// this runs, exactly as the oracle computes them inside `exit_block_scope`
    /// before popping.
    public popScopeReleasing(&mut self): void {
      let closingDepth: u64 = self.ownedStarts.length();
      let mut closingSpan: SourceSpan = SourceSpan::detached(0, 0);

      if (let Option::SOME(endSpan) = self.scopeEndSpans.pop()) {
        closingSpan = endSpan;
      }

      let _discardedBlock: Option<u32> = self.scopeBlocks.pop();
      let _discardedHasBlock: Option<u32> = self.scopeHasBlock.pop();
      let _discardedIsLoop: Option<u32> = self.scopeIsLoop.pop();

      if (let Option::SOME(ownedStart) = self.ownedStarts.pop()) {
        while (self.ownedVars.length() > ownedStart) {
          let _discardedOwned: Option<u32> = self.ownedVars.pop();
        }
      }

      if (let Option::SOME(deferStart) = self.deferStarts.pop()) {
        while (self.deferBodies.length() > deferStart) {
          let _discardedDefer: Option<u32> = self.deferBodies.pop();
        }
      }

      let Option::SOME(start) = self.scopeStarts.pop() else {
        return;
      };

      while (self.heldTargets.length() > start) {
        let Option::SOME(target) = self.heldTargets.pop() else {
          return;
        };
        let Option::SOME(flag) = self.heldMutable.pop() else {
          return;
        };
        let Option::SOME(recorded) = self.heldRecorded.pop() else {
          return;
        };
        let Option::SOME(holder) = self.heldHolders.pop() else {
          return;
        };

        // A borrow its holder already released at the holder's last use is
        // skipped here.
        if (holder == Borrowck::RELEASED_HOLDER) {
          continue;
        }

        // A scope-held borrow is released by the scope, not by an expression,
        // so it is reported at the brace that closes the scope; the scope
        // depth is what pairs it with its open.
        self.releaseHeldEntry(target, flag == 1, recorded, closingDepth, closingSpan);
      }
    }

    /// Releases one borrow: a mutable borrow clears the state, a shared borrow
    /// decrements the live count. Mirrors `release_borrow`.
    public releaseBorrow(&mut self, target: u32, mutable: boolean): void {
      let current: u32 = self.borrowValue(target);

      if (mutable) {
        self.setBorrowValue(target, Borrowck::BORROW_NONE);
        return;
      }

      // The encoding leaves no room between the mutable state and one live
      // shared borrow, so releasing the last shared borrow clears the state
      // instead of decrementing into it.
      if (current == Borrowck::BORROW_SHARED_BASE + 1) {
        self.setBorrowValue(target, Borrowck::BORROW_NONE);
        return;
      }

      if (current > Borrowck::BORROW_MUT) {
        self.setBorrowValue(target, current - 1);
      }
    }

    public pushLoop(&mut self, scrutinees: &Vector<u32>): void {
      self.loopContinue.push(0);
      self.loopScrutineeStarts.push(self.loopScrutinees.length());

      let mut index: u64 = 0;

      while (index < scrutinees.length()) {
        if (let Option::SOME(defRaw) = scrutinees.get(index)) {
          self.loopScrutinees.push(*defRaw);
        }

        index += 1;
      }
    }

    public popLoop(&mut self): void {
      let _discarded: Option<u32> = self.loopContinue.pop();

      let Option::SOME(startValue) = self.loopScrutineeStarts.pop() else {
        return;
      };

      while (self.loopScrutinees.length() > startValue) {
        let _released: Option<u32> = self.loopScrutinees.pop();
      }
    }

    /// The places the innermost enclosing loop's `let` condition consumes, in
    /// declaration order. Empty outside a loop, and empty for a loop whose
    /// condition holds no `let` over a place.
    public innermostLoopScrutinees(&self): Vector<u32> {
      let mut places: Vector<u32> = Vector::new<u32>();

      if (self.loopScrutineeStarts.isEmpty()) {
        return places;
      }

      let last: u64 = self.loopScrutineeStarts.length() - 1;

      let Option::SOME(startValue) = self.loopScrutineeStarts.get(last) else {
        return places;
      };

      let mut index: u64 = *startValue;

      while (index < self.loopScrutinees.length()) {
        if (let Option::SOME(defRaw) = self.loopScrutinees.get(index)) {
          places.push(*defRaw);
        }

        index += 1;
      }

      return places;
    }

    public markContinue(&mut self): void {
      if (self.loopContinue.isEmpty()) {
        return;
      }

      let last: u64 = self.loopContinue.length() - 1;
      self.loopContinue.set(last, 1);
    }

    public continueSeen(&self): boolean {
      if (self.loopContinue.isEmpty()) {
        return false;
      }

      if (let Option::SOME(flag) = self.loopContinue.get(self.loopContinue.length() - 1)) {
        return *flag == 1;
      }

      return false;
    }
  }

  /// Every ownership or borrow diagnostic this checker can emit.
  ///
  /// Hand-maintained, and only a coverage checklist: it is the list
  /// `ownership_report_tests.ign` walks, one provoking program per entry, so a
  /// code added here without a program fails that test. What keeps a code from
  /// reaching the diagnostic bag without also reaching the report is
  /// `emitOwnershipError`/`emitOwnershipWarning` below, which do both in one
  /// call; this list does not enforce that and cannot.
  function ownershipDiagnosticCodes(): Vector<static str> {
    let mut codes: Vector<static str> = Vector::new<static str>();
    codes.push(DiagnosticCode::USE_AFTER_MOVE);
    codes.push(DiagnosticCode::USE_AFTER_DROP);
    codes.push(DiagnosticCode::DOUBLE_DROP);
    codes.push(DiagnosticCode::CANNOT_MOVE_OUT_OF_BORROW);
    codes.push(DiagnosticCode::BORROW_MUTABLE_WHILE_MUTABLE);
    codes.push(DiagnosticCode::BORROW_MUTABLE_WHILE_IMMUTABLE);
    codes.push(DiagnosticCode::BORROW_IMMUTABLE_WHILE_MUTABLE);
    codes.push(DiagnosticCode::INCONSISTENT_MOVE_IN_BRANCHES);
    codes.push(DiagnosticCode::INCONSISTENT_DROP_IN_BRANCHES);
    codes.push(DiagnosticCode::MUTATED_WHILE_BORROWED);
    codes.push(DiagnosticCode::MOVED_WHILE_BORROWED);
    codes.push(DiagnosticCode::VIEW_OUTLIVES_OWNER);
    codes.push(DiagnosticCode::RETURN_OF_LOCAL_VIEW);
    codes.push(DiagnosticCode::DROP_ON_COMPLEX_RECEIVER);
    return codes;
  }

  function copyOwnershipEvent(event: &Borrowck::OwnershipEvent): Borrowck::OwnershipEvent {
    return Borrowck::OwnershipEvent {
      kind: event.kind,
      functionRaw: event.functionRaw,
      variableRaw: event.variableRaw,
      hasVariable: event.hasVariable,
      relatedRaw: event.relatedRaw,
      hasRelated: event.hasRelated,
      detail: event.detail,
      flag: event.flag,
      envKind: event.envKind,
      scopeDepth: event.scopeDepth,
      code: event.code,
      span: event.span,
    };
  }

  /// One event about `defRaw`, attributed to the function being walked.
  /// Every `note*` helper below funnels through here after its own guard.
  function pushOwnershipEvent(
    state: &mut Borrowck::State,
    kind: u32,
    defRaw: u32,
    hasVariable: boolean,
    detail: u32,
    flag: boolean,
    scopeDepth: u64,
    code: static str,
    span: SourceSpan,
  ): void {
    let functionRaw: u32 = state.currentFunctionId().raw();

    let mut stateRef: &mut Borrowck::State = state;
    stateRef.pushReportEvent(Borrowck::OwnershipEvent {
      kind: kind,
      functionRaw: functionRaw,
      variableRaw: defRaw,
      hasVariable: hasVariable,
      relatedRaw: 0,
      hasRelated: false,
      detail: detail,
      flag: flag,
      envKind: Borrowck::OwnershipReport::ENV_UNKNOWN,
      scopeDepth: scopeDepth,
      code: code,
      span: span,
    });
  }

  function noteMove(
    state: &mut Borrowck::State,
    defId: Analyzer::DefinitionId,
    consumer: u32,
    span: SourceSpan,
  ): void {
    if (!state.isRecordingReport()) {
      return;
    }

    Borrowck::pushOwnershipEvent(
      state,
      Borrowck::OwnershipReport::EVENT_MOVE,
      defId.raw(),
      true,
      consumer,
      false,
      0,
      "",
      span,
    );
  }

  /// Records a borrow the checker refused, with the state that refused it.
  /// `heldState` is the borrow map's value for the target, which is all the
  /// checker knows about the holder: one mutable borrow, or a shared count.
  function noteBorrowRejected(
    state: &mut Borrowck::State,
    defRaw: u32,
    mutable: boolean,
    heldState: u32,
    span: SourceSpan,
  ): void {
    if (!state.isRecordingReport()) {
      return;
    }

    let mut held: u32 = Borrowck::OwnershipReport::HELD_SHARED;

    if (heldState == Borrowck::BORROW_MUT) {
      held = Borrowck::OwnershipReport::HELD_MUTABLE;
    }

    let depth: u64 = state.scopeDepth();

    Borrowck::pushOwnershipEvent(
      state,
      Borrowck::OwnershipReport::EVENT_BORROW_REJECTED,
      defRaw,
      true,
      held,
      mutable,
      depth,
      "",
      span,
    );
  }

  function noteBorrow(
    state: &mut Borrowck::State,
    defRaw: u32,
    mutable: boolean,
    opened: boolean,
    span: SourceSpan,
  ): void {
    if (!state.isRecordingReport()) {
      return;
    }

    let mut kind: u32 = Borrowck::OwnershipReport::EVENT_BORROW_RELEASE;

    if (opened) {
      kind = Borrowck::OwnershipReport::EVENT_BORROW_OPEN;
    }

    let depth: u64 = state.scopeDepth();

    Borrowck::pushOwnershipEvent(state, kind, defRaw, true, 0, mutable, depth, "", span);
  }

  /// Where the closure environment `bindingRaw` names already lives, read back
  /// from the event this walk recorded for it. An alias is only ever recorded
  /// after its owner, because the owner's `let` is what put the binding in
  /// `closureEnvOwners` in the first place.
  function recordedEnvKind(state: &Borrowck::State, bindingRaw: u32): u32 {
    let mut index: u64 = state.reportEventCount();

    while (index > 0) {
      index -= 1;

      if (let Option::SOME(event) = state.reportEventAt(index)) {
        if (event.kind == Borrowck::OwnershipReport::EVENT_CLOSURE_ENV && event.variableRaw == bindingRaw) {
          return event.envKind;
        }
      }
    }

    return Borrowck::OwnershipReport::ENV_UNKNOWN;
  }

  /// Where the environment a binding is handed by `value` lives.
  ///
  /// A closure literal answers from its own escape flag. A binding that names
  /// another binding's environment answers with that owner's environment,
  /// because a closure value is copied bitwise and the copy points at the same
  /// bytes. A call whose result is a function type returns an environment
  /// built in the callee's frame, which escape analysis has already forced
  /// onto the heap. Anything else has no honest answer and says so.
  function closureEnvKind(
    hir: &Hir::HirStore,
    state: &Borrowck::State,
    value: Hir::HirId,
    ownsClosureEnv: boolean,
  ): u32 {
    let Option::SOME(node) = hir.get(value) else {
      return Borrowck::OwnershipReport::ENV_UNKNOWN;
    };

    if (let Hir::HirKind::Closure(closure) = &node.kind) {
      if (closure.escapes) {
        return Borrowck::OwnershipReport::ENV_HEAP;
      }

      return Borrowck::OwnershipReport::ENV_STACK;
    }

    if (let Hir::HirKind::Variable(defId) = &node.kind) {
      let Option::SOME(owner) = state.closureEnvOwnerOf(defId.raw()) else {
        return Borrowck::OwnershipReport::ENV_UNKNOWN;
      };

      return Borrowck::recordedEnvKind(state, owner);
    }

    if (!ownsClosureEnv) {
      return Borrowck::OwnershipReport::ENV_UNKNOWN;
    }

    if (let Hir::HirKind::Call(_) = &node.kind) {
      return Borrowck::OwnershipReport::ENV_HEAP;
    }

    if (let Hir::HirKind::MethodCall(_) = &node.kind) {
      return Borrowck::OwnershipReport::ENV_HEAP;
    }

    return Borrowck::OwnershipReport::ENV_UNKNOWN;
  }

  /// Records which binding owns a closure environment and which only names it,
  /// together with where that environment lives.
  ///
  /// The environment is resolved here rather than by the caller so that a run
  /// without the report pays nothing for it.
  function noteClosureEnv(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    bindingRaw: u32,
    ownerRaw: u32,
    value: Option<Hir::HirId>,
    initializerOwns: boolean,
    span: SourceSpan,
  ): void {
    if (!state.isRecordingReport()) {
      return;
    }

    let functionRaw: u32 = state.currentFunctionId().raw();
    let mut role: u32 = Borrowck::OwnershipReport::ROLE_ALIAS;

    if (bindingRaw == ownerRaw) {
      role = Borrowck::OwnershipReport::ROLE_OWNER;
    }

    let mut envKind: u32 = Borrowck::OwnershipReport::ENV_UNKNOWN;

    // A binding that owns an environment only because a later assignment hands
    // it one has no answer here: the initializer describes a value the binding
    // is about to stop holding. Reading the initializer anyway is the mistake
    // the `escapes` field made.
    if (role == Borrowck::OwnershipReport::ROLE_ALIAS || initializerOwns) {
      if (let Option::SOME(valueId) = value) {
        envKind = Borrowck::closureEnvKind(hir, &*state, valueId, initializerOwns);
      }
    }

    let mut stateRef: &mut Borrowck::State = state;
    stateRef.pushReportEvent(Borrowck::OwnershipEvent {
      kind: Borrowck::OwnershipReport::EVENT_CLOSURE_ENV,
      functionRaw: functionRaw,
      variableRaw: bindingRaw,
      hasVariable: true,
      relatedRaw: ownerRaw,
      hasRelated: true,
      detail: role,
      flag: false,
      envKind: envKind,
      scopeDepth: 0,
      code: "",
      span: span,
    });
  }

  function notePatternBinding(state: &mut Borrowck::State, defRaw: u32, span: SourceSpan): void {
    if (!state.isRecordingReport()) {
      return;
    }

    Borrowck::pushOwnershipEvent(
      state,
      Borrowck::OwnershipReport::EVENT_PATTERN_BINDING,
      defRaw,
      true,
      0,
      false,
      0,
      "",
      span,
    );
  }

  /// Records a diagnostic together with the move state the checker held for
  /// the variable it is about, which is the pair a reader of the report needs
  /// to tell a real error from a state the walk arrived at wrongly.
  ///
  /// `defId` is absent for a diagnostic about an expression that names no
  /// local, such as a move out of a field reached through a reference; the
  /// event then carries the code and the position alone.
  function noteDiagnostic(
    state: &mut Borrowck::State,
    code: static str,
    defId: Option<Analyzer::DefinitionId>,
    span: SourceSpan,
  ): void {
    if (!state.isRecordingReport()) {
      return;
    }

    let Option::SOME(variable) = defId else {
      Borrowck::pushOwnershipEvent(
        state,
        Borrowck::OwnershipReport::EVENT_DIAGNOSTIC,
        0,
        false,
        Borrowck::OwnershipReport::STATE_UNTRACKED,
        false,
        0,
        code,
        span,
      );

      return;
    };

    let observed: u32 = match (state.moveValue(variable.raw())) {
      Option::SOME(value) -> value,
      Option::NONE -> Borrowck::OwnershipReport::STATE_UNTRACKED,
    };

    Borrowck::pushOwnershipEvent(
      state,
      Borrowck::OwnershipReport::EVENT_DIAGNOSTIC,
      variable.raw(),
      true,
      observed,
      false,
      0,
      code,
      span,
    );
  }

  function boolAsFlag(value: boolean): u32 {
    return match (value) {
      true -> 1,
      false -> 0,
    };
  }

  function copyU32Vector(source: &Vector<u32>): Vector<u32> {
    let mut result: Vector<u32> = Vector::new<u32>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(value) = source.get(index)) {
        result.push(*value);
      }

      index += 1;
    }

    return result;
  }

  /// Restrictiveness join of two borrow states, mirroring `BorrowState::merge`.
  function mergeBorrowValues(left: u32, right: u32): u32 {
    if (left == Borrowck::BORROW_MUT || right == Borrowck::BORROW_MUT) {
      return Borrowck::BORROW_MUT;
    }

    if (left > right) {
      return left;
    }

    return right;
  }

  /// Restrictiveness join of two move states, mirroring `most_restrictive`
  /// over the subset of states this slice models.
  function mostRestrictiveMove(left: u32, right: u32): u32 {
    if (left > right) {
      return left;
    }

    return right;
  }

  /// Takes its haystack mutably so the same helper serves both owned locals
  /// and the `&mut Vector<u32>` accumulators threaded through the walk; a
  /// `&mut` cannot be narrowed to a `&` at a call site today (IGN-128).
  function containsRaw(values: &mut Vector<u32>, raw: u32): boolean {
    let mut index: u64 = 0;

    while (index < values.length()) {
      if (let Option::SOME(value) = values.get(index)) {
        if (*value == raw) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function pushUniqueRaw(values: &mut Vector<u32>, raw: u32): void {
    if (Borrowck::containsRaw(values, raw)) {
      return;
    }

    let mut target: &mut Vector<u32> = values;
    target.push(raw);
  }

  // --- definition and type queries -------------------------------------------------

  /// Declared type of a `Variable` definition (a local or a parameter), or
  /// `NONE` for every other definition kind.
  function variableTypeOf(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
  ): Option<Analyzer::TypeId> {
    let Option::SOME(definition) = defStore.get(defId) else {
      return Option::NONE;
    };

    return match (definition) {
      Analyzer::Definition::Variable(variable) -> Option::SOME(variable.declaredType),
      _ -> Option::NONE,
    };
  }

  function definitionName(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): String {
    let Option::SOME(definition) = defStore.get(defId) else {
      return String::create("<unknown>");
    };

    let name: Analyzer::SymbolId = definition.name();

    return match (symbols.resolve(name)) {
      Option::SOME(text) -> String::create(text),
      Option::NONE -> String::create("<unknown>"),
    };
  }

  /// Whether `methodDefId` takes its receiver by value, so the call moves it.
  function methodSelfByValue(
    defStore: &mut Analyzer::DefinitionStore,
    methodDefId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(methodDefId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Method(method) -> method.selfByValue,
      _ -> false,
    };
  }

  /// Whether the receiver of `methodDefId` is bound mutably. Static methods
  /// and non-methods answer `false`, matching the oracle's early return.
  function methodSelfMutable(
    defStore: &mut Analyzer::DefinitionStore,
    methodDefId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(methodDefId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Method(method) -> method.selfMutable,
      _ -> false,
    };
  }

  /// Field types of a record definition, copied out so the caller can keep
  /// using the definition store.
  function recordFieldTypes(
    defStore: &mut Analyzer::DefinitionStore,
    recordDefId: Analyzer::DefinitionId,
  ): Vector<Analyzer::TypeId> {
    let mut fieldIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(recordDefId)) {
      match (definition) {
        Analyzer::Definition::Record(recordDef) -> {
          let mut index: u64 = 0;

          while (index < recordDef.fields.length()) {
            if (let Option::SOME(fieldId) = recordDef.fields.get(index)) {
              fieldIds.push(*fieldId);
            }

            index += 1;
          }
        },
        _ -> {},
      };
    }

    let mut types: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut fieldIndex: u64 = 0;

    while (fieldIndex < fieldIds.length()) {
      if (let Option::SOME(fieldId) = fieldIds.get(fieldIndex)) {
        if (let Option::SOME(definition) = defStore.get(*fieldId)) {
          match (definition) {
            Analyzer::Definition::Field(fieldDef) -> {
              types.push(fieldDef.fieldType);
            },
            _ -> {},
          };
        }
      }

      fieldIndex += 1;
    }

    return types;
  }

  /// Every payload type of every variant of an enum definition.
  function enumPayloadTypes(
    defStore: &mut Analyzer::DefinitionStore,
    enumDefId: Analyzer::DefinitionId,
  ): Vector<Analyzer::TypeId> {
    let mut variantIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(enumDefId)) {
      match (definition) {
        Analyzer::Definition::Enum(enumDef) -> {
          let mut index: u64 = 0;

          while (index < enumDef.variants.length()) {
            if (let Option::SOME(variantId) = enumDef.variants.get(index)) {
              variantIds.push(*variantId);
            }

            index += 1;
          }
        },
        _ -> {},
      };
    }

    let mut types: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut variantIndex: u64 = 0;

    while (variantIndex < variantIds.length()) {
      if (let Option::SOME(variantId) = variantIds.get(variantIndex)) {
        if (let Option::SOME(definition) = defStore.get(*variantId)) {
          match (definition) {
            Analyzer::Definition::Variant(variantDef) -> {
              let mut payloadIndex: u64 = 0;

              while (payloadIndex < variantDef.payload.length()) {
                if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
                  types.push(*payloadType);
                }

                payloadIndex += 1;
              }
            },
            _ -> {},
          };
        }
      }

      variantIndex += 1;
    }

    return types;
  }

  function recordImplementsDrop(
    defStore: &mut Analyzer::DefinitionStore,
    recordDefId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(recordDefId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Record(recordDef) -> recordDef.implementsDrop,
      _ -> false,
    };
  }

  function enumImplementsDrop(
    defStore: &mut Analyzer::DefinitionStore,
    enumDefId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(enumDefId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Enum(enumDef) -> enumDef.implementsDrop,
      _ -> false,
    };
  }

  function aliasedTypeOf(
    defStore: &mut Analyzer::DefinitionStore,
    aliasDefId: Analyzer::DefinitionId,
  ): Option<Analyzer::TypeId> {
    let Option::SOME(definition) = defStore.get(aliasDefId) else {
      return Option::NONE;
    };

    return match (definition) {
      Analyzer::Definition::TypeAlias(aliasDef) -> Option::SOME(aliasDef.aliasedType),
      _ -> Option::NONE,
    };
  }

  /// Whether values of this type own resources that must be dropped, mirroring
  /// `TypeStore::needs_drop_with_defs`. This is the predicate both oracles use
  /// to decide whether a local participates in move tracking at all.
  function needsDropType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let mut visiting: Vector<u32> = Vector::new<u32>();
    return Borrowck::needsDropTypeInner(defStore, typeStore, typeId, &mut visiting);
  }

  /// Recursive worker for `needsDropType`. `visiting` holds the raw ids of the
  /// nominal types currently on the stack so a recursive type answers `false`
  /// on revisit instead of looping, like the Rust `visiting` set.
  function needsDropTypeInner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
    visiting: &mut Vector<u32>,
  ): boolean {
    if (Borrowck::containsRaw(visiting, typeId.raw())) {
      return false;
    }

    let Option::SOME(type_) = typeStore.get(typeId) else {
      return false;
    };

    let mut recordDefId: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut enumDefId: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut aliasDefId: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut instanceDefId: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut components: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    match (type_) {
      Analyzer::Type::I8
      | Analyzer::Type::I16
      | Analyzer::Type::I32
      | Analyzer::Type::I64
      | Analyzer::Type::U8
      | Analyzer::Type::U16
      | Analyzer::Type::U32
      | Analyzer::Type::U64
      | Analyzer::Type::F32
      | Analyzer::Type::F64
      | Analyzer::Type::BOOLEAN
      | Analyzer::Type::CHAR
      | Analyzer::Type::STR
      | Analyzer::Type::STATIC_STR
      | Analyzer::Type::VOID
      | Analyzer::Type::NEVER
      | Analyzer::Type::ATOM -> {},
      Analyzer::Type::Pointer(_) -> {},
      Analyzer::Type::Reference(_) -> {},
      Analyzer::Type::Slice(_) -> {},
      Analyzer::Type::Range(_) -> {},
      Analyzer::Type::Function(_) -> {},
      Analyzer::Type::RawFunction(_) -> {},
      Analyzer::Type::Param(_) -> {},
      Analyzer::Type::FixedArray(element, _) -> {
        components.push(element);
      },
      Analyzer::Type::Tuple(tuple) -> {
        let mut elementIndex: u64 = 0;

        while (elementIndex < tuple.elements.length()) {
          if (let Option::SOME(elementType) = tuple.elements.get(elementIndex)) {
            components.push(*elementType);
          }

          elementIndex += 1;
        }
      },
      Analyzer::Type::Record(defId) -> {
        recordDefId = Option::SOME(defId);
      },
      Analyzer::Type::Enum(defId) -> {
        enumDefId = Option::SOME(defId);
      },
      Analyzer::Type::Alias(defId) -> {
        aliasDefId = Option::SOME(defId);
      },
      Analyzer::Type::Instance(instance) -> {
        instanceDefId = Option::SOME(instance.definition);

        let mut argumentIndex: u64 = 0;

        while (argumentIndex < instance.typeArguments.length()) {
          if (let Option::SOME(argument) = instance.typeArguments.get(argumentIndex)) {
            components.push(*argument);
          }

          argumentIndex += 1;
        }
      },
    };

    if (let Option::SOME(defId) = aliasDefId) {
      let Option::SOME(aliased) = Borrowck::aliasedTypeOf(defStore, defId) else {
        return false;
      };

      let mut visitingRef: &mut Vector<u32> = visiting;
      visitingRef.push(typeId.raw());

      let answer: boolean = Borrowck::needsDropTypeInner(defStore, typeStore, aliased, visiting);

      let mut popRef: &mut Vector<u32> = visiting;
      let _discarded: Option<u32> = popRef.pop();

      return answer;
    }

    if (let Option::SOME(defId) = recordDefId) {
      if (Borrowck::recordImplementsDrop(defStore, defId)) {
        return true;
      }

      components = Borrowck::recordFieldTypes(defStore, defId);

      if (Borrowck::anyFunctionType(typeStore, &components)) {
        return true;
      }
    }

    if (let Option::SOME(defId) = enumDefId) {
      if (Borrowck::enumImplementsDrop(defStore, defId)) {
        return true;
      }

      components = Borrowck::enumPayloadTypes(defStore, defId);

      if (Borrowck::anyFunctionType(typeStore, &components)) {
        return true;
      }
    }

    if (let Option::SOME(defId) = instanceDefId) {
      if (Borrowck::recordImplementsDrop(defStore, defId) || Borrowck::enumImplementsDrop(defStore, defId)) {
        return true;
      }
    }

    let mut visitingRef: &mut Vector<u32> = visiting;
    visitingRef.push(typeId.raw());

    let mut answer: boolean = false;
    let mut componentIndex: u64 = 0;

    while (componentIndex < components.length()) {
      if (let Option::SOME(component) = components.get(componentIndex)) {
        if (Borrowck::needsDropTypeInner(defStore, typeStore, *component, visiting)) {
          answer = true;
        }
      }

      componentIndex += 1;
    }

    let mut popRef: &mut Vector<u32> = visiting;
    let _discarded: Option<u32> = popRef.pop();

    return answer;
  }

  /// Whether any of `types` is a closure type. A record field or enum payload
  /// holding a closure owns the closure's environment, so the aggregate needs
  /// a drop even though a closure binding on its own is tracked by the closure
  /// environment owners instead.
  function anyFunctionType(
    typeStore: &mut Analyzer::TypeStore,
    types: &Vector<Analyzer::TypeId>
  ): boolean {
    let mut index: u64 = 0;

    while (index < types.length()) {
      if (let Option::SOME(typeId) = types.get(index)) {
        if (Hir::typeIsFunction(typeStore, *typeId)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function definitionNeedsDrop(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    defId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(typeId) = Borrowck::variableTypeOf(defStore, defId) else {
      return false;
    };

    return Borrowck::needsDropType(defStore, typeStore, typeId);
  }

  /// Whether `defId` is a variable of function type, a closure value.
  function definitionIsClosure(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    defId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(typeId) = Borrowck::variableTypeOf(defStore, defId) else {
      return false;
    };

    return Hir::typeIsFunction(typeStore, typeId);
  }

  /// Makes a closure pattern binding that takes its payload out of an owned
  /// scrutinee the owner of the closure's environment, like a payload that
  /// needs a drop: it is moved when handed on and dropped at the end of its
  /// scope. A binding through a reference stays a borrow and never gets here.
  function declarePatternClosureOwner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    state: &mut Borrowck::State,
    defRaw: u32,
  ): void {
    if (!Borrowck::definitionIsClosure(defStore, typeStore, Id::fromRaw<Analyzer::DefinitionTag>(defRaw))) {
      return;
    }

    let mut ownerRef: &mut Borrowck::State = state;
    ownerRef.recordClosureEnvOwner(defRaw, defRaw);
    ownerRef.markMoveOnlyClosureOwner(defRaw);
  }

  // --- HIR place queries ------------------------------------------------------------

  /// Root local of a place expression, following field, index, reference, and
  /// dereference chains back to the variable they start from. Mirrors
  /// `extract_root_variable`, and with it the whole-local granularity both
  /// oracles work at.
  function extractRootVariable(
    hir: &Hir::HirStore,
    nodeId: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Option::NONE;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(defId) -> Option::SOME(defId),
      Hir::HirKind::FieldAccess(access) -> Borrowck::extractRootVariable(hir, access.base),
      Hir::HirKind::Reference(reference) -> Borrowck::extractRootVariable(hir, reference.expression),
      Hir::HirKind::Dereference(inner) -> Borrowck::extractRootVariable(hir, inner),
      Hir::HirKind::Index(indexNode) -> Borrowck::extractRootVariable(hir, indexNode.base),
      _ -> Option::NONE,
    };
  }

  /// The `@threadLocal` static whose own storage the place `nodeId` names, if
  /// any: the static itself, or a field or element of it. A projection through
  /// a dereference, or an index or field access through a pointer, reference
  /// or slice, addresses the pointee instead, so `(*Scheduler::CURRENT).field`
  /// names no thread-local storage.
  function threadLocalPlaceRoot(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    nodeId: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Option::NONE;
    };

    let mut base: Option<Hir::HirId> = Option::NONE;

    let mut named: Option<Analyzer::DefinitionId> = Option::NONE;

    match (&node.kind) {
      Hir::HirKind::Variable(defId) -> {
        named = Option::SOME(defId);
      },
      Hir::HirKind::StaticAccess(defId) -> {
        named = Option::SOME(defId);
      },
      Hir::HirKind::FieldAccess(access) -> {
        base = Option::SOME(access.base);
      },
      Hir::HirKind::Index(indexNode) -> {
        base = Option::SOME(indexNode.base);
      },
      _ -> {},
    };

    // A static field read inside a function lowers to a `Variable` of its
    // definition, like a local; only the definition says it is thread-local.
    if (let Option::SOME(defId) = named) {
      if (let Option::SOME(Analyzer::Definition::Variable(variable)) = defStore.get(defId)) {
        if (variable.threadLocal) {
          return Option::SOME(defId);
        }
      }

      return Option::NONE;
    }

    let Option::SOME(baseId) = base else {
      return Option::NONE;
    };

    let Option::SOME(baseNode) = hir.get(baseId) else {
      return Option::NONE;
    };

    let Option::SOME(baseType) = typeStore.get(baseNode.typeId) else {
      return Option::NONE;
    };

    let throughIndirection: boolean = match (baseType) {
      Analyzer::Type::Pointer(_) -> true,
      Analyzer::Type::Reference(_) -> true,
      Analyzer::Type::Slice(_) -> true,
      Analyzer::Type::STR -> true,
      Analyzer::Type::STATIC_STR -> true,
      _ -> false,
    };

    if (throughIndirection) {
      return Option::NONE;
    }

    return Borrowck::threadLocalPlaceRoot(defStore, typeStore, hir, baseId);
  }

  /// Whether `nodeId` is a written or inserted `&` / `&mut`.
  function isReferenceNode(hir: &Hir::HirStore, nodeId: Hir::HirId): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    return match (&node.kind) {
      Hir::HirKind::Reference(_) -> true,
      _ -> false,
    };
  }

  /// The return type of the function or method `callable`, if it is one.
  function callableReturnType(
    defStore: &mut Analyzer::DefinitionStore,
    callable: Analyzer::DefinitionId,
  ): Option<Analyzer::TypeId> {
    let Option::SOME(definition) = defStore.get(callable) else {
      return Option::NONE;
    };

    return match (definition) {
      Analyzer::Definition::Function(functionDef) -> Option::SOME(functionDef.returnType),
      Analyzer::Definition::Method(methodDef) -> Option::SOME(methodDef.returnType),
      _ -> Option::NONE,
    };
  }

  /// A0261 when the place `place` names a thread-local's storage and `borrow`
  /// takes a reference to it: the reference would dangle once the thread that
  /// owns the storage exits.
  function rejectThreadLocalBorrow(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    diagnostics: &mut DiagnosticBag,
    place: Hir::HirId,
    span: SourceSpan,
    borrow: str,
  ): void {
    let Option::SOME(threadLocal) = Borrowck::threadLocalPlaceRoot(defStore, typeStore, hir, place) else {
      return;
    };

    let name: String = Borrowck::definitionName(defStore, symbols, threadLocal);
    let message: String = `cannot borrow thread-local '${name.toStr()}'`;
    let label: String = `${borrow} would dangle once the thread that owns '${name.toStr()}' exits; read or write it by value`;

    Borrowck::emitError(diagnostics, span, DiagnosticCode::THREAD_LOCAL_BORROWED, message.toStr(), label.toStr());
  }

  /// A0261 when a fixed array stored in a thread-local flows where a slice of
  /// it is expected: the slice the array becomes points into its storage.
  function rejectThreadLocalSlice(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    diagnostics: &mut DiagnosticBag,
    value: Hir::HirId,
    targetType: Analyzer::TypeId,
  ): void {
    let Option::SOME(Analyzer::Type::Slice(_)) = typeStore.get(targetType) else {
      return;
    };

    let Option::SOME(valueNode) = hir.get(value) else {
      return;
    };

    let Option::SOME(Analyzer::Type::FixedArray(_, _)) = typeStore.get(valueNode.typeId) else {
      return;
    };

    Borrowck::rejectThreadLocalBorrow(defStore, typeStore, symbols, hir, diagnostics, value, valueNode.span, "a slice");
  }

  /// The local an expression moves out of, if any: a bare variable reference
  /// whose type owns resources. Mirrors `get_moved_var`, which is why a field
  /// read or an index is not a move here.
  function movedVariable(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    nodeId: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    let mut variableDef: Option<Analyzer::DefinitionId> = Option::NONE;

    if (let Option::SOME(node) = hir.get(nodeId)) {
      variableDef = match (&node.kind) {
        Hir::HirKind::Variable(defId) -> Option::SOME(defId),
        _ -> Option::NONE,
      };
    }

    let Option::SOME(defId) = variableDef else {
      return Option::NONE;
    };

    if (!Borrowck::definitionNeedsDrop(defStore, typeStore, defId)) {
      return Option::NONE;
    }

    return Option::SOME(defId);
  }

  /// The local that handing `nodeId` on by value moves: a `movedVariable`, or
  /// a binding that owns a closure environment that cannot be copied. A copy
  /// of such a closure would share the environment with its owner, and either
  /// one going out of scope would free it under the other.
  function movedValue(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    if (let Option::SOME(defId) = Borrowck::movedVariable(defStore, typeStore, hir, nodeId)) {
      return Option::SOME(defId);
    }

    return Borrowck::movedClosureOwner(hir, state, nodeId);
  }

  /// The move-only closure environment owner `nodeId` names, when it is a
  /// variable naming one.
  function movedClosureOwner(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Option::NONE;
    };

    let Hir::HirKind::Variable(defId) = &node.kind else {
      return Option::NONE;
    };

    if (!state.isMoveOnlyClosureOwner(defId.raw())) {
      return Option::NONE;
    }

    return Option::SOME(defId);
  }

  /// The owning local a field access reads out of, walking nested fields down
  /// to their base. Unlike `extractRootVariable` it stops at anything that is
  /// not a field, so a place reached through a reference or an index never
  /// names an owner. Mirrors `get_moved_field_owner`.
  function movedFieldOwner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    nodeId: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    let mut baseId: Option<Hir::HirId> = Option::NONE;

    if (let Option::SOME(node) = hir.get(nodeId)) {
      baseId = match (&node.kind) {
        Hir::HirKind::FieldAccess(access) -> Option::SOME(access.base),
        _ -> Option::NONE,
      };
    }

    let Option::SOME(base) = baseId else {
      return Option::NONE;
    };

    if (let Option::SOME(owner) = Borrowck::movedVariable(defStore, typeStore, hir, base)) {
      return Option::SOME(owner);
    }

    return Borrowck::movedFieldOwner(defStore, typeStore, hir, base);
  }

  /// The reference expression an initializer is, if it is one directly.
  /// Returns the borrowed expression and whether the borrow is mutable.
  function referenceParts(hir: &Hir::HirStore, nodeId: Hir::HirId): Option<Hir::HirReference> {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Option::NONE;
    };

    return match (&node.kind) {
      Hir::HirKind::Reference(reference) -> Option::SOME(Hir::HirReference {
        expression: reference.expression,
        mutable: reference.mutable,
      }),
      _ -> Option::NONE,
    };
  }

  // --- views ------------------------------------------------------------------------

  /// How a value refers to storage, for the view rules: not at all (an owned
  /// value, or a type no view rule covers), as a `&T` or `&mut T`, as a `str`,
  /// as a slice, or as a raw pointer.
  const VIEW_TYPE_NONE: u32 = 0;
  const VIEW_TYPE_REFERENCE: u32 = 1;
  const VIEW_TYPE_STR: u32 = 2;
  const VIEW_TYPE_SLICE: u32 = 3;
  const VIEW_TYPE_POINTER: u32 = 4;

  /// Where a view points: storage this function does not own (a parameter's
  /// referent, a static, a literal, a closure environment), a local of the
  /// function, or a temporary of the statement.
  const VIEW_OWNER_EXTERNAL: u32 = 0;
  const VIEW_OWNER_LOCAL: u32 = 1;
  const VIEW_OWNER_TEMPORARY: u32 = 2;

  /// The owner of a view. `local` is meaningful for `VIEW_OWNER_LOCAL` and
  /// `node` (the temporary's expression) for `VIEW_OWNER_TEMPORARY`. A
  /// temporary is `scoped` when it outlives its own statement's end only in
  /// the sense that matters here: it is the scrutinee of a `match` and lives
  /// through the arms, which sit at scope depth `depth` and deeper.
  record ViewOwner {
    public kind: u32;
    public local: Analyzer::DefinitionId;
    public node: Hir::HirId;
    public scoped: boolean;
    public depth: u64;
  }

  function externalViewOwner(): Borrowck::ViewOwner {
    return Borrowck::ViewOwner {
      kind: Borrowck::VIEW_OWNER_EXTERNAL,
      local: Id::fromRaw<Analyzer::DefinitionTag>(0),
      node: Id::fromRaw<Hir::NodeTag>(0),
      scoped: false,
      depth: 0,
    };
  }

  function localViewOwner(local: Analyzer::DefinitionId, node: Hir::HirId): Borrowck::ViewOwner {
    return Borrowck::ViewOwner {
      kind: Borrowck::VIEW_OWNER_LOCAL,
      local: local,
      node: node,
      scoped: false,
      depth: 0,
    };
  }

  function temporaryViewOwner(node: Hir::HirId): Borrowck::ViewOwner {
    return Borrowck::ViewOwner {
      kind: Borrowck::VIEW_OWNER_TEMPORARY,
      local: Id::fromRaw<Analyzer::DefinitionTag>(0),
      node: node,
      scoped: false,
      depth: 0,
    };
  }

  function scopedTemporaryViewOwner(node: Hir::HirId, depth: u64): Borrowck::ViewOwner {
    return Borrowck::ViewOwner {
      kind: Borrowck::VIEW_OWNER_TEMPORARY,
      local: Id::fromRaw<Analyzer::DefinitionTag>(0),
      node: node,
      scoped: true,
      depth: depth,
    };
  }

  function viewTypeKind(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): u32 {
    let Option::SOME(type_) = typeStore.get(typeId) else {
      return Borrowck::VIEW_TYPE_NONE;
    };

    let mut aliased: Option<Analyzer::TypeId> = Option::NONE;

    let kind: u32 = match (type_) {
      Analyzer::Type::STR -> Borrowck::VIEW_TYPE_STR,
      Analyzer::Type::Reference(_) -> Borrowck::VIEW_TYPE_REFERENCE,
      Analyzer::Type::Slice(_) -> Borrowck::VIEW_TYPE_SLICE,
      Analyzer::Type::Pointer(_) -> Borrowck::VIEW_TYPE_POINTER,
      Analyzer::Type::Alias(aliasDefId) -> {
        aliased = Borrowck::aliasedTypeOf(defStore, aliasDefId);
        Borrowck::VIEW_TYPE_NONE
      },
      _ -> Borrowck::VIEW_TYPE_NONE,
    };

    if (let Option::SOME(target) = aliased) {
      return Borrowck::viewTypeKind(defStore, typeStore, target);
    }

    return kind;
  }

  /// `typeId` with every outer reference removed.
  function referentTypeOf(
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId
  ): Analyzer::TypeId {
    let Option::SOME(type_) = typeStore.get(typeId) else {
      return typeId;
    };

    let referent: Option<Analyzer::TypeId> = match (type_) {
      Analyzer::Type::Reference(reference) -> Option::SOME(reference.referent),
      _ -> Option::NONE,
    };

    if (let Option::SOME(inner) = referent) {
      return Borrowck::referentTypeOf(typeStore, inner);
    }

    return typeId;
  }

  function nodeTypeOf(hir: &Hir::HirStore, nodeId: Hir::HirId): Option<Analyzer::TypeId> {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Option::NONE;
    };

    return Option::SOME(node.typeId);
  }

  /// Whether a method call returns a view of its receiver: an instance method
  /// taking `&self` or `&mut self` whose result is a `&T`, a `&mut T`, a slice
  /// or a `str`. A `str` result is a view only when the receiver owns heap
  /// storage (its type needs a drop): a receiver that owns nothing can only
  /// hand out a `str` that lives elsewhere, such as a literal it holds.
  function methodCallIsView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    call: &Hir::HirMethodCall,
    resultType: Analyzer::TypeId,
  ): boolean {
    let Option::SOME(receiver) = call.receiver else {
      return false;
    };

    let Option::SOME(definition) = defStore.get(call.method) else {
      return false;
    };

    let takesSelfByReference: boolean = match (definition) {
      Analyzer::Definition::Method(method) -> !method.isStatic && !method.selfByValue,
      _ -> false,
    };

    if (!takesSelfByReference) {
      return false;
    }

    let resultKind: u32 = Borrowck::viewTypeKind(defStore, typeStore, resultType);

    if (resultKind == Borrowck::VIEW_TYPE_REFERENCE || resultKind == Borrowck::VIEW_TYPE_SLICE) {
      return true;
    }

    if (resultKind != Borrowck::VIEW_TYPE_STR) {
      return Borrowck::typeHoldsReference(defStore, typeStore, resultType);
    }

    let Option::SOME(receiverType) = Borrowck::nodeTypeOf(hir, receiver) else {
      return false;
    };

    return Borrowck::needsDropType(defStore, typeStore, Borrowck::referentTypeOf(typeStore, receiverType));
  }

  /// Whether a method taking its receiver by value hands on the references
  /// the receiver holds, such as `unwrap` on an `Option<&T>`: both the
  /// receiver's type and the result's hold a reference, so the result points
  /// wherever the receiver did.
  function methodCallPassesViewThrough(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    call: &Hir::HirMethodCall,
    resultType: Analyzer::TypeId,
  ): boolean {
    let Option::SOME(receiver) = call.receiver else {
      return false;
    };

    if (!Borrowck::methodSelfByValue(defStore, call.method)) {
      return false;
    }

    let Option::SOME(receiverType) = Borrowck::nodeTypeOf(hir, receiver) else {
      return false;
    };

    if (!Borrowck::typeHoldsReference(defStore, typeStore, receiverType)) {
      return false;
    }

    let resultKind: u32 = Borrowck::viewTypeKind(defStore, typeStore, resultType);

    return resultKind == Borrowck::VIEW_TYPE_REFERENCE || resultKind == Borrowck::VIEW_TYPE_SLICE || Borrowck::typeHoldsReference(defStore, typeStore, resultType);
  }

  /// Whether a value of this type holds a `&T`, a `&mut T` or a slice, as
  /// itself or inside a tuple, a fixed array, a record field or an enum
  /// payload (`Option<&T>`). Raw pointers and `str` are not followed: a `str`
  /// kept inside an aggregate is too often a literal or a static to count.
  function typeHoldsReference(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let mut visiting: Vector<u32> = Vector::new<u32>();
    return Borrowck::typeHoldsReferenceInner(defStore, typeStore, typeId, &mut visiting);
  }

  function typeHoldsReferenceInner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
    visiting: &mut Vector<u32>,
  ): boolean {
    let Option::SOME(type_) = typeStore.get(typeId) else {
      return false;
    };

    let mut components: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut nominal: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut isEnum: boolean = false;
    let mut aliased: Option<Analyzer::TypeId> = Option::NONE;
    let mut holds: boolean = false;

    match (type_) {
      Analyzer::Type::Reference(_) -> {
        holds = true;
      },
      Analyzer::Type::Slice(_) -> {
        holds = true;
      },
      Analyzer::Type::FixedArray(element, _) -> {
        components.push(element);
      },
      Analyzer::Type::Tuple(tuple) -> {
        components = Borrowck::copyTypeIds(&tuple.elements);
      },
      Analyzer::Type::Record(defId) -> {
        nominal = Option::SOME(defId);
      },
      Analyzer::Type::Enum(defId) -> {
        nominal = Option::SOME(defId);
        isEnum = true;
      },
      Analyzer::Type::Alias(aliasDefId) -> {
        aliased = Borrowck::aliasedTypeOf(defStore, aliasDefId);
      },
      _ -> {},
    };

    if (holds) {
      return true;
    }

    if (let Option::SOME(target) = aliased) {
      return Borrowck::typeHoldsReferenceInner(defStore, typeStore, target, visiting);
    }

    if (let Option::SOME(defId) = nominal) {
      if (Borrowck::containsRaw(visiting, defId.raw())) {
        return false;
      }

      let mut visitingRef: &mut Vector<u32> = visiting;
      visitingRef.push(defId.raw());

      if (isEnum) {
        components = Borrowck::enumPayloadTypes(defStore, defId);
      } else {
        components = Borrowck::recordFieldTypes(defStore, defId);
      }
    }

    let mut index: u64 = 0;

    while (index < components.length()) {
      if (let Option::SOME(component) = components.get(index)) {
        if (Borrowck::typeHoldsReferenceInner(defStore, typeStore, *component, visiting)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function copyTypeIds(source: &Vector<Analyzer::TypeId>): Vector<Analyzer::TypeId> {
    let mut copied: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(entry) = source.get(index)) {
        copied.push(*entry);
      }

      index += 1;
    }

    return copied;
  }

  /// Whether `binding` is declared as a `&mut T`. A view method stored into
  /// such a binding hands out write access to its owner, so the binding holds
  /// a mutable borrow; every other view holds a shared one.
  function bindingIsMutableReference(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    binding: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(bindingType) = Borrowck::variableTypeOf(defStore, binding) else {
      return false;
    };

    let Option::SOME(type_) = typeStore.get(bindingType) else {
      return false;
    };

    if (let Analyzer::Type::Reference(reference) = type_) {
      return reference.mutable;
    }

    return false;
  }

  /// Where the storage of the place or value `nodeId` lives: the local it is
  /// part of, following field access and indexing; whatever a dereference or
  /// a value of a view type points to; storage this function does not own
  /// for a static, a pattern binding destructured out of a reference, or a
  /// closure environment capture; and a temporary for any other expression.
  function storageOwnerOf(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId,
  ): Borrowck::ViewOwner {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Borrowck::externalViewOwner();
    };

    // A receiver that already is a reference (or a `str`, a slice) names the
    // storage it points to, not its own bytes.
    if (Borrowck::viewTypeKind(defStore, typeStore, node.typeId) != Borrowck::VIEW_TYPE_NONE) {
      return Borrowck::pointeeOwnerOf(defStore, typeStore, hir, state, nodeId);
    }

    let mut base: Option<Hir::HirId> = Option::NONE;
    let mut pointer: Option<Hir::HirId> = Option::NONE;
    let mut variable: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut external: boolean = false;
    let mut elements: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut isTuple: boolean = false;

    match (&node.kind) {
      // A tuple built in place, as a `match` scrutinee: what a pattern binds
      // out of it lives wherever its elements do.
      Hir::HirKind::TupleLiteral(tupleElements) -> {
        elements = Borrowck::copyHirIds(&tupleElements);
        isTuple = true;
      },
      Hir::HirKind::Variable(defId) -> {
        variable = Option::SOME(defId);
      },
      Hir::HirKind::StaticAccess(_) -> {
        external = true;
      },
      Hir::HirKind::FieldAccess(access) -> {
        base = Option::SOME(access.base);
      },
      Hir::HirKind::Index(indexNode) -> {
        base = Option::SOME(indexNode.base);
      },
      Hir::HirKind::Dereference(inner) -> {
        pointer = Option::SOME(inner);
      },
      _ -> {},
    };

    if (external) {
      return Borrowck::externalViewOwner();
    }

    if (isTuple) {
      let mut elementIndex: u64 = 0;

      while (elementIndex < elements.length()) {
        // Only a referenced element or a nested tuple can be borrowed from;
        // a pattern takes any other element out by value.
        if (let Option::SOME(element) = elements.get(elementIndex)) {
          let mut bindsByReference: boolean = false;

          if (let Option::SOME(elementNode) = hir.get(*element)) {
            bindsByReference = Borrowck::viewTypeKind(defStore, typeStore, elementNode.typeId) != Borrowck::VIEW_TYPE_NONE;

            if (let Hir::HirKind::TupleLiteral(_) = &elementNode.kind) {
              bindsByReference = true;
            }
          }

          if (bindsByReference) {
            let owner: Borrowck::ViewOwner = Borrowck::storageOwnerOf(defStore, typeStore, hir, state, *element);

            if (owner.kind != Borrowck::VIEW_OWNER_EXTERNAL) {
              return owner;
            }
          }
        }

        elementIndex += 1;
      }

      return Borrowck::externalViewOwner();
    }

    if (let Option::SOME(baseId) = base) {
      return Borrowck::storageOwnerOf(defStore, typeStore, hir, state, baseId);
    }

    if (let Option::SOME(pointerId) = pointer) {
      return Borrowck::pointeeOwnerOf(defStore, typeStore, hir, state, pointerId);
    }

    if (let Option::SOME(defId) = variable) {
      // A binding destructured out of a reference names the storage the
      // reference pointed to: a local, a temporary scrutinee, or storage this
      // function does not own.
      if (state.isBorrowedBinding(defId.raw())) {
        if (let Option::SOME(ownerRaw) = state.viewOwnerOf(defId.raw())) {
          return Borrowck::localViewOwner(Id::fromRaw<Analyzer::DefinitionTag>(ownerRaw), nodeId);
        }

        if (let Option::SOME(temporary) = state.temporaryStorageOf(defId.raw())) {
          return temporary;
        }

        return Borrowck::externalViewOwner();
      }

      return Borrowck::localViewOwner(defId, nodeId);
    }

    return Borrowck::temporaryViewOwner(nodeId);
  }

  /// Where the view value `nodeId` points: the storage a reference expression
  /// or a view method's receiver lives in (so `a.b().c()` points into `a`),
  /// or, for a view local, the owner recorded when it was initialized (the
  /// variable-initializer chain). Any other view value, such as a `str` field
  /// read out of a record, points to
  /// storage that is not tracked.
  function pointeeOwnerOf(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId,
  ): Borrowck::ViewOwner {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Borrowck::externalViewOwner();
    };

    let mut storage: Option<Hir::HirId> = Option::NONE;
    let mut passedThrough: Option<Hir::HirId> = Option::NONE;
    let mut variable: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut callArguments: Vector<Hir::HirId> = Vector::new<Hir::HirId>();

    // A value-producing block, `if` or `match` points wherever the value it
    // produces on some path does; the first tracked owner found decides.
    let mut results: Vector<Hir::HirId> = Vector::new<Hir::HirId>();

    match (&node.kind) {
      Hir::HirKind::Block(block) -> {
        if (let Option::SOME(tail) = block.expression) {
          results.push(tail);
        }
      },
      Hir::HirKind::If(ifNode) -> {
        results.push(ifNode.thenBranch);

        if (let Option::SOME(elseBranch) = ifNode.elseBranch) {
          results.push(elseBranch);
        }
      },
      Hir::HirKind::TupleLiteral(tupleElements) -> {
        results = Borrowck::copyHirIds(&tupleElements);
      },
      Hir::HirKind::Match(matchNode) -> {
        let mut armIndex: u64 = 0;

        while (armIndex < matchNode.arms.length()) {
          if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
            results.push(arm.body);
          }

          armIndex += 1;
        }
      },
      Hir::HirKind::Variable(defId) -> {
        variable = Option::SOME(defId);
      },
      Hir::HirKind::Reference(reference) -> {
        storage = Option::SOME(reference.expression);
      },
      Hir::HirKind::MethodCall(call) -> {
        if (call.receiver.isNone()) {
          callArguments = Borrowck::copyHirIds(&call.args);
        } else if (Borrowck::methodCallIsView(defStore, typeStore, hir, &call, node.typeId)) {
          storage = call.receiver;
        } else if (Borrowck::methodCallPassesViewThrough(defStore, typeStore, hir, &call, node.typeId)) {
          passedThrough = call.receiver;
        }
      },
      Hir::HirKind::Call(call) -> {
        callArguments = Borrowck::copyHirIds(&call.args);
      },
      _ -> {},
    };

    if (callArguments.length() > 0 && Borrowck::typeHoldsView(defStore, typeStore, node.typeId)) {
      return Borrowck::callArgumentsViewOwner(defStore, typeStore, hir, state, &callArguments);
    }

    if (let Option::SOME(storageId) = storage) {
      return Borrowck::storageOwnerOf(defStore, typeStore, hir, state, storageId);
    }

    if (let Option::SOME(receiverId) = passedThrough) {
      return Borrowck::pointeeOwnerOf(defStore, typeStore, hir, state, receiverId);
    }

    let mut resultIndex: u64 = 0;

    while (resultIndex < results.length()) {
      if (let Option::SOME(result) = results.get(resultIndex)) {
        let owner: Borrowck::ViewOwner = Borrowck::pointeeOwnerOf(defStore, typeStore, hir, state, *result);

        if (owner.kind != Borrowck::VIEW_OWNER_EXTERNAL) {
          return owner;
        }
      }

      resultIndex += 1;
    }

    if (let Option::SOME(defId) = variable) {
      if (let Option::SOME(ownerRaw) = state.viewOwnerOf(defId.raw())) {
        return Borrowck::localViewOwner(Id::fromRaw<Analyzer::DefinitionTag>(ownerRaw), nodeId);
      }

      if (let Option::SOME(temporary) = state.temporaryStorageOf(defId.raw())) {
        return temporary;
      }
    }

    return Borrowck::externalViewOwner();
  }

  /// Where the view a free function or a static method returns points: into
  /// any of its arguments of a view type (`&T`, `&mut T`, `str`, a slice),
  /// since nothing in its signature says which one. The shortest-lived owner
  /// decides: a temporary before any local, a local declared deeper before
  /// one declared shallower. Arguments of any other type create no
  /// dependency. Extern functions follow the same rule.
  function callArgumentsViewOwner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    arguments: &Vector<Hir::HirId>,
  ): Borrowck::ViewOwner {
    let mut chosen: Borrowck::ViewOwner = Borrowck::externalViewOwner();
    let mut chosenDepth: u64 = 0;
    let mut index: u64 = 0;

    while (index < arguments.length()) {
      if (let Option::SOME(argument) = arguments.get(index)) {
        let mut argumentKind: u32 = Borrowck::VIEW_TYPE_NONE;

        if (let Option::SOME(argumentType) = Borrowck::nodeTypeOf(hir, *argument)) {
          argumentKind = Borrowck::viewTypeKind(defStore, typeStore, argumentType);
        }

        if (argumentKind == Borrowck::VIEW_TYPE_REFERENCE || argumentKind == Borrowck::VIEW_TYPE_STR || argumentKind == Borrowck::VIEW_TYPE_SLICE) {
          let owner: Borrowck::ViewOwner = Borrowck::pointeeOwnerOf(defStore, typeStore, hir, state, *argument);

          if (owner.kind == Borrowck::VIEW_OWNER_TEMPORARY && !owner.scoped) {
            return owner;
          }

          if (owner.kind != Borrowck::VIEW_OWNER_EXTERNAL) {
            let mut depth: u64 = owner.depth;

            if (owner.kind == Borrowck::VIEW_OWNER_LOCAL) {
              depth = match (state.localDepth(owner.local.raw())) {
                Option::SOME(value) -> value,
                Option::NONE -> 0,
              };
            }

            if (chosen.kind == Borrowck::VIEW_OWNER_EXTERNAL || depth > chosenDepth) {
              chosen = owner;
              chosenDepth = depth;
            }
          }
        }
      }

      index += 1;
    }

    return chosen;
  }

  /// The owner of the view a binding keeps when it stores `value`: the value
  /// has to be a `&T`, `&mut T`, slice or `str` for there to be a view at
  /// all. Raw pointers are not tracked.
  function keptViewOwner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    value: Hir::HirId,
  ): Borrowck::ViewOwner {
    let Option::SOME(valueType) = Borrowck::nodeTypeOf(hir, value) else {
      return Borrowck::externalViewOwner();
    };

    if (!Borrowck::typeHoldsView(defStore, typeStore, valueType)) {
      return Borrowck::externalViewOwner();
    }

    return Borrowck::pointeeOwnerOf(defStore, typeStore, hir, state, value);
  }

  /// Whether a value of this type can be a view: a `&T`, a `&mut T`, a slice,
  /// a `str`, or an aggregate holding a reference (`Option<&T>`). Raw
  /// pointers are not tracked.
  function typeHoldsView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let kind: u32 = Borrowck::viewTypeKind(defStore, typeStore, typeId);

    if (kind == Borrowck::VIEW_TYPE_POINTER) {
      return false;
    }

    if (kind != Borrowck::VIEW_TYPE_NONE) {
      return true;
    }

    return Borrowck::typeHoldsReference(defStore, typeStore, typeId);
  }

  /// How a diagnostic names the owner of a view: `'name'` for a local, the
  /// call for a call or method result, and a generic phrase otherwise.
  function describeViewOwner(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    owner: &Borrowck::ViewOwner,
  ): String {
    if (owner.kind == Borrowck::VIEW_OWNER_LOCAL) {
      let name: String = Borrowck::definitionName(defStore, symbols, owner.local);

      // The local a `for ... of` desugars its iterated value into.
      if (name.startsWith("__for_of_tmp")) {
        return String::create("the value a 'for ... of' loop iterates");
      }

      return `'${name}'`;
    }

    let Option::SOME(node) = hir.get(owner.node) else {
      return String::create("a temporary value");
    };

    let mut callee: Option<Analyzer::DefinitionId> = Option::NONE;

    match (&node.kind) {
      Hir::HirKind::Call(call) -> {
        callee = Option::SOME(call.callee);
      },
      Hir::HirKind::MethodCall(call) -> {
        callee = Option::SOME(call.method);
      },
      _ -> {},
    };

    if (let Option::SOME(calleeId) = callee) {
      let name: String = Borrowck::definitionName(defStore, symbols, calleeId);
      return `the temporary result of '${name}(...)'`;
    }

    return String::create("a temporary value");
  }

  /// Reports a binding or a return that keeps a view past its owner. The
  /// primary label sits on the statement, a secondary one on the owner when
  /// it is a temporary, whose span is the expression to bind first.
  function emitViewOutlivesOwner(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    owner: &Borrowck::ViewOwner,
    isReturn: boolean,
    span: SourceSpan,
  ): void {
    let description: String = Borrowck::describeViewOwner(defStore, symbols, hir, owner);
    let isTemporary: boolean = owner.kind == Borrowck::VIEW_OWNER_TEMPORARY;
    let mut code: static str = DiagnosticCode::VIEW_OUTLIVES_OWNER;
    let mut message: String = String::create("");
    let mut label: str = "";
    let mut help: String = String::create("");

    if (isReturn) {
      code = DiagnosticCode::RETURN_OF_LOCAL_VIEW;

      if (isTemporary) {
        message = `Cannot return a view of ${description}, which is dropped when the function returns`;
      } else {
        message = `Cannot return a view of local ${description}, which is dropped when the function returns`;
      }

      label = "the returned view points into storage this function drops";
      help = String::create("return an owned value instead of a view");
    } else if (isTemporary) {
      message = `Cannot keep a view of ${description}, which is dropped at the end of the statement`;
      label = "the view is kept past the statement";
      help = String::create("bind the value to a local first, then take the view from that local");
    } else {
      message = `Cannot keep a view of ${description} in a binding that outlives it`;
      label = "the binding outlives the scope of the view's owner";
      help = `declare ${description} in the scope of the binding, or store an owned copy`;
    }

    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, code, message.toStr(), span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, label);

    if (isTemporary) {
      if (let Option::SOME(node) = hir.get(owner.node)) {
        diagnostic.addLabel(LabelKind::SECONDARY, node.span, "temporary created here");
      }
    }

    diagnostic.setHelp(help.toStr());

    let mut bag: &mut DiagnosticBag = diagnostics;
    bag.push(diagnostic);

    let mut ownerId: Option<Analyzer::DefinitionId> = Option::NONE;

    if (owner.kind == Borrowck::VIEW_OWNER_LOCAL) {
      ownerId = Option::SOME(owner.local);
    }

    Borrowck::noteDiagnostic(state, code, ownerId, span);
  }

  /// Checks a `let` or an assignment that stores `value` into `binding`,
  /// declared at `bindingDepth` (`NONE` when unknown), and records the view
  /// the binding now holds. A kept view of a temporary is rejected; so is a
  /// view of a local declared deeper than the binding. A kept view of a live
  /// local holds a borrow of that local until the scope the store happens in
  /// ends, so moving or mutating the owner meanwhile is reported.
  ///
  /// A view copied from another view local (`let b: str = a;`) takes no
  /// borrow of its own: `a` already holds it, and a second mutable borrow
  /// would conflict with the first.
  function recordKeptView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    binding: Analyzer::DefinitionId,
    bindingDepth: Option<u64>,
    value: Hir::HirId,
    forOfIterable: boolean,
    span: SourceSpan,
  ): void {
    let owner: Borrowck::ViewOwner = Borrowck::keptViewOwner(defStore, typeStore, hir, state, value);

    let mut clearRef: &mut Borrowck::State = state;
    clearRef.clearViewOwner(binding.raw());
    clearRef.clearTemporaryStorage(binding.raw());

    if (forOfIterable) {
      if (Borrowck::recordForOfDataPointer(defStore, typeStore, hir, state, binding, bindingDepth, value)) {
        return;
      }
    }

    Borrowck::checkAggregateViews(defStore, typeStore, symbols, hir, state, diagnostics, bindingDepth, value, span);
    Borrowck::checkStoredClosureCaptures(defStore, typeStore, symbols, hir, state, diagnostics, bindingDepth, value, span);

    if (owner.kind == Borrowck::VIEW_OWNER_EXTERNAL) {
      return;
    }

    if (owner.kind == Borrowck::VIEW_OWNER_TEMPORARY) {
      // A view of a scrutinee taken inside an arm may be kept by a binding of
      // that arm: the scrutinee outlives it. The binding then lives in the
      // scrutinee too.
      if (owner.scoped) {
        if (let Option::SOME(depth) = bindingDepth) {
          if (depth >= owner.depth) {
            let mut storageRef: &mut Borrowck::State = state;
            storageRef.setTemporaryStorage(binding.raw(), owner.depth, owner.node.raw());
            return;
          }
        }
      }

      // The binding a `for ... of` loop reads its iterable from keeps the
      // iterable's temporaries alive until the loop ends, which is the end of
      // the binding's own scope: views taken from it are views of a temporary
      // that lives at the binding's depth.
      if (forOfIterable) {
        if (let Option::SOME(depth) = bindingDepth) {
          let mut loopStorageRef: &mut Borrowck::State = state;
          loopStorageRef.setTemporaryStorage(binding.raw(), depth, owner.node.raw());
          return;
        }
      }

      Borrowck::emitViewOutlivesOwner(defStore, symbols, hir, state, diagnostics, &owner, false, span);
      return;
    }

    if (let Option::SOME(depth) = bindingDepth) {
      if (let Option::SOME(ownerDepth) = state.localDepth(owner.local.raw())) {
        if (ownerDepth > depth) {
          Borrowck::emitViewOutlivesOwner(defStore, symbols, hir, state, diagnostics, &owner, false, span);
          return;
        }
      }
    }

    let Option::SOME(node) = hir.get(value) else {
      return;
    };

    let mut takesBorrow: boolean = true;
    let mut mutable: boolean = false;

    match (&node.kind) {
      // `recordLetBorrow` already holds the borrow a `let x = &y` takes.
      Hir::HirKind::Reference(_) -> {
        takesBorrow = false;
      },
      Hir::HirKind::Variable(_) -> {
        takesBorrow = false;
      },
      Hir::HirKind::MethodCall(_) -> {
        mutable = Borrowck::bindingIsMutableReference(defStore, typeStore, binding);
      },
      _ -> {},
    };

    let mut viewRef: &mut Borrowck::State = state;
    viewRef.setViewOwner(binding.raw(), owner.local.raw(), takesBorrow);

    if (!takesBorrow) {
      return;
    }

    // A view taken through a live view local that holds its own borrow of the
    // owner reborrows that local: the owner is already borrowed on its behalf,
    // so a second borrow of the owner would conflict with the first.
    let mut borrowTarget: Analyzer::DefinitionId = owner.local;

    if (let Option::SOME(view) = Borrowck::reborrowedViewLocal(hir, state, value, owner.local.raw())) {
      borrowTarget = view;
    }

    let granted: boolean = Borrowck::tryBorrow(defStore, symbols, state, diagnostics, borrowTarget, mutable, span, true);

    let mut heldRef: &mut Borrowck::State = state;
    heldRef.recordHeldBorrow(borrowTarget.raw(), mutable, granted);
  }

  /// The view local `value` is derived from through receivers, fields,
  /// elements, references and dereferences, when that local views `ownerRaw`
  /// and holds a borrow of it (`let store: &mut Store = guard.get();` for
  /// `store.tasks.get(index).unwrap()`).
  function reborrowedViewLocal(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    value: Hir::HirId,
    ownerRaw: u32,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(value) else {
      return Option::NONE;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(defId) -> {
        let viewOwner: Option<u32> = state.viewOwnerOf(defId.raw());

        if (let Option::SOME(owner) = viewOwner) {
          if (owner == ownerRaw && state.viewHoldsBorrow(defId.raw())) {
            return Option::SOME(defId);
          }
        }

        return Option::NONE;
      },
      Hir::HirKind::MethodCall(call) -> match (call.receiver) {
        Option::SOME(receiver) -> Borrowck::reborrowedViewLocal(hir, state, receiver, ownerRaw),
        Option::NONE -> Option::NONE,
      },
      Hir::HirKind::FieldAccess(access) -> Borrowck::reborrowedViewLocal(hir, state, access.base, ownerRaw),
      Hir::HirKind::Index(indexNode) -> Borrowck::reborrowedViewLocal(hir, state, indexNode.base, ownerRaw),
      Hir::HirKind::Reference(reference) -> Borrowck::reborrowedViewLocal(hir, state, reference.expression, ownerRaw),
      Hir::HirKind::Dereference(inner) -> Borrowck::reborrowedViewLocal(hir, state, inner, ownerRaw),
      _ -> Option::NONE,
    };
  }

  /// Raw pointers are not tracked as views, except the data pointer a `for
  /// ... of` loop indexes a record or slice iterable through: the element a
  /// by-reference loop binding points to lives wherever the iterable's
  /// storage does, a local or a temporary that lives through the loop.
  /// Returns whether `value` was such a pointer.
  function recordForOfDataPointer(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    binding: Analyzer::DefinitionId,
    bindingDepth: Option<u64>,
    value: Hir::HirId,
  ): boolean {
    let Option::SOME(node) = hir.get(value) else {
      return false;
    };

    if (Borrowck::viewTypeKind(defStore, typeStore, node.typeId) != Borrowck::VIEW_TYPE_POINTER) {
      return false;
    }

    let Hir::HirKind::FieldAccess(access) = &node.kind else {
      return false;
    };

    let owner: Borrowck::ViewOwner = Borrowck::storageOwnerOf(defStore, typeStore, hir, state, access.base);

    if (owner.kind == Borrowck::VIEW_OWNER_LOCAL) {
      let mut viewRef: &mut Borrowck::State = state;
      viewRef.setViewOwner(binding.raw(), owner.local.raw(), false);
    } else if (owner.kind == Borrowck::VIEW_OWNER_TEMPORARY) {
      let mut depth: u64 = owner.depth;

      if (!owner.scoped) {
        if (let Option::SOME(bindingDepthValue) = bindingDepth) {
          depth = bindingDepthValue;
        }
      }

      let mut storageRef: &mut Borrowck::State = state;
      storageRef.setTemporaryStorage(binding.raw(), depth, owner.node.raw());
    }

    return true;
  }

  /// Checks the views an aggregate built in place keeps: the fields of a record
  /// initializer, the payload of an enum variant, the elements of a tuple or
  /// vector literal, recursively. Each one is stored into whatever `value` is
  /// stored into, so each obeys the rules `recordKeptView` applies to a view
  /// stored directly; a view of a live local holds a shared borrow of it for
  /// the rest of the scope. `bindingDepth` is `NONE` for a `return`.
  function checkAggregateViews(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    bindingDepth: Option<u64>,
    value: Hir::HirId,
    span: SourceSpan,
  ): void {
    let mut elements: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    Borrowck::collectAggregateElements(hir, value, &mut elements);

    let mut index: u64 = 0;

    while (index < elements.length()) {
      if (let Option::SOME(element) = elements.get(index)) {
        let owner: Borrowck::ViewOwner = Borrowck::keptViewOwner(defStore, typeStore, hir, state, *element);
        Borrowck::checkKeptElementView(defStore, symbols, hir, state, diagnostics, bindingDepth, &owner, span);
      }

      index += 1;
    }
  }

  /// The operands of the aggregate literals `value` is built from, flattened:
  /// nested aggregates contribute their own operands instead of themselves.
  function collectAggregateElements(
    hir: &Hir::HirStore,
    value: Hir::HirId,
    output: &mut Vector<Hir::HirId>
  ): void {
    let Option::SOME(node) = hir.get(value) else {
      return;
    };

    let mut operands: Vector<Hir::HirId> = Vector::new<Hir::HirId>();

    match (&node.kind) {
      Hir::HirKind::RecordInit(init) -> {
        let mut fieldIndex: u64 = 0;

        while (fieldIndex < init.fields.length()) {
          if (let Option::SOME(field) = init.fields.get(fieldIndex)) {
            operands.push(field.value);
          }

          fieldIndex += 1;
        }
      },
      Hir::HirKind::EnumVariant(variant) -> {
        operands = Borrowck::copyHirIds(&variant.payload);
      },
      Hir::HirKind::TupleLiteral(elements) -> {
        operands = Borrowck::copyHirIds(&elements);
      },
      Hir::HirKind::VectorLiteral(elements) -> {
        operands = Borrowck::copyHirIds(&elements);
      },
      _ -> {},
    };

    let mut index: u64 = 0;

    while (index < operands.length()) {
      if (let Option::SOME(operand) = operands.get(index)) {
        let mut outputRef: &mut Vector<Hir::HirId> = output;
        outputRef.push(*operand);
        Borrowck::collectAggregateElements(hir, *operand, output);
      }

      index += 1;
    }
  }

  /// Checks the closures stored with `value` — the value itself, or one held
  /// by a record initializer, enum payload, tuple or vector literal built in
  /// place — whose captures are views. A closure that captures by reference,
  /// or by value a view type, is itself a view: its environment borrows (or
  /// points into) storage it does not own, so storing it obeys the same
  /// storage depth rule as a view. A capture taken from a local declared
  /// deeper than the place the closure is stored into outlives that local;
  /// each offending capture is reported naming it. `bindingDepth` is `NONE`
  /// for a `return`, which outlives every local of the function.
  function checkStoredClosureCaptures(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    bindingDepth: Option<u64>,
    value: Hir::HirId,
    span: SourceSpan,
  ): void {
    let mut closures: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    Borrowck::collectStoredClosures(hir, value, &mut closures);

    let mut index: u64 = 0;

    while (index < closures.length()) {
      if (let Option::SOME(closureId) = closures.get(index)) {
        if (let Option::SOME(node) = hir.get(*closureId)) {
          if (let Hir::HirKind::Closure(closure) = &node.kind) {
            if (Analyzer::ViewType::closureIsView(defStore, typeStore, &closure)) {
              let mut captureIndex: u64 = 0;

              while (captureIndex < closure.captures.length()) {
                if (let Option::SOME(capture) = closure.captures.get(captureIndex)) {
                  Borrowck::checkStoredClosureCapture(defStore, typeStore, symbols, state, diagnostics, bindingDepth, capture, span);
                }

                captureIndex += 1;
              }
            }
          }
        }
      }

      index += 1;
    }
  }

  /// One view capture of a stored closure, judged against the depth of the
  /// place the closure is stored into.
  function checkStoredClosureCapture(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    bindingDepth: Option<u64>,
    capture: &Hir::HirCapture,
    span: SourceSpan,
  ): void {
    let mut byReference: boolean = false;

    match (&capture.mode) {
      Hir::CaptureMode::ByRef -> {
        byReference = true;
      },
      Hir::CaptureMode::ByMutRef -> {
        byReference = true;
      },
      _ -> {},
    };

    if (!byReference && !Analyzer::ViewType::isView(defStore, typeStore, capture.typeInEnv)) {
      return;
    }

    let Option::SOME(captureDepth) = state.localDepth(capture.sourceDef.raw()) else {
      return;
    };

    if (let Option::SOME(depth) = bindingDepth) {
      if (captureDepth <= depth) {
        return;
      }
    }

    Borrowck::emitClosureCaptureOutlivesOwner(defStore, symbols, state, diagnostics, capture, bindingDepth.isNone(), span);
  }

  /// Reports a stored closure whose view capture does not live where the
  /// closure is kept: the environment would point into storage dropped before
  /// the closure could run. The primary label sits on the store, naming the
  /// capture.
  function emitClosureCaptureOutlivesOwner(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    capture: &Hir::HirCapture,
    isReturn: boolean,
    span: SourceSpan,
  ): void {
    let name: String = Borrowck::definitionName(defStore, symbols, capture.sourceDef);
    let mut code: static str = DiagnosticCode::VIEW_OUTLIVES_OWNER;
    let mut message: String = String::create("");
    let mut label: str = "";
    let mut help: String = String::create("");

    if (isReturn) {
      code = DiagnosticCode::RETURN_OF_LOCAL_VIEW;
      message = `Cannot return a closure that captures '${name.toStr()}', which is dropped when the function returns`;
      label = "the returned closure points into storage this function drops";
      help = String::create("return a closure that owns what it captures instead");
    } else {
      message = `Cannot keep a closure that captures '${name.toStr()}' in a binding that outlives it: the capture is dropped before the closure`;
      label = "the binding outlives the scope of the captured view";
      help = String::create("store the closure where the captured value lives, or capture an owned copy");
    }

    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, code, message.toStr(), span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, label);
    diagnostic.setHelp(help.toStr());

    let mut bag: &mut DiagnosticBag = diagnostics;
    bag.push(diagnostic);

    Borrowck::noteDiagnostic(state, code, Option::SOME(capture.sourceDef), span);
  }

  /// The closures `value` stores: the value itself when it is a closure, plus
  /// every closure held by a record initializer, enum payload, tuple or
  /// vector literal built in place, flattened. Closure bodies are not
  /// entered: a closure written inside another closure's body is stored where
  /// that inner closure runs, not here.
  function collectStoredClosures(
    hir: &Hir::HirStore,
    value: Hir::HirId,
    output: &mut Vector<Hir::HirId>
  ): void {
    let Option::SOME(node) = hir.get(value) else {
      return;
    };

    if (let Hir::HirKind::Closure(_) = &node.kind) {
      let mut outputRef: &mut Vector<Hir::HirId> = output;
      outputRef.push(value);
      return;
    }

    let mut operands: Vector<Hir::HirId> = Vector::new<Hir::HirId>();

    match (&node.kind) {
      Hir::HirKind::RecordInit(init) -> {
        let mut fieldIndex: u64 = 0;

        while (fieldIndex < init.fields.length()) {
          if (let Option::SOME(field) = init.fields.get(fieldIndex)) {
            operands.push(field.value);
          }

          fieldIndex += 1;
        }
      },
      Hir::HirKind::EnumVariant(variant) -> {
        operands = Borrowck::copyHirIds(&variant.payload);
      },
      Hir::HirKind::TupleLiteral(elements) -> {
        operands = Borrowck::copyHirIds(&elements);
      },
      Hir::HirKind::VectorLiteral(elements) -> {
        operands = Borrowck::copyHirIds(&elements);
      },
      _ -> {},
    };

    let mut index: u64 = 0;

    while (index < operands.length()) {
      if (let Option::SOME(operand) = operands.get(index)) {
        Borrowck::collectStoredClosures(hir, *operand, output);
      }

      index += 1;
    }
  }

  function copyHirIds(source: &Vector<Hir::HirId>): Vector<Hir::HirId> {
    let mut copied: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(entry) = source.get(index)) {
        copied.push(*entry);
      }

      index += 1;
    }

    return copied;
  }

  /// Applies the kept-view rules to one view an aggregate or a field
  /// assignment stores. `bindingDepth` is `NONE` for a `return`, which keeps
  /// nothing of the function alive.
  function checkKeptElementView(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    bindingDepth: Option<u64>,
    owner: &Borrowck::ViewOwner,
    span: SourceSpan,
  ): void {
    if (owner.kind == Borrowck::VIEW_OWNER_EXTERNAL) {
      return;
    }

    let Option::SOME(depth) = bindingDepth else {
      Borrowck::emitViewOutlivesOwner(defStore, symbols, hir, state, diagnostics, owner, true, span);
      return;
    };

    if (owner.kind == Borrowck::VIEW_OWNER_TEMPORARY) {
      if (owner.scoped && depth >= owner.depth) {
        return;
      }

      Borrowck::emitViewOutlivesOwner(defStore, symbols, hir, state, diagnostics, owner, false, span);
      return;
    }

    if (let Option::SOME(ownerDepth) = state.localDepth(owner.local.raw())) {
      if (ownerDepth > depth) {
        Borrowck::emitViewOutlivesOwner(defStore, symbols, hir, state, diagnostics, owner, false, span);
        return;
      }
    }

    let granted: boolean = Borrowck::tryBorrow(defStore, symbols, state, diagnostics, owner.local, false, span, true);

    let mut heldRef: &mut Borrowck::State = state;
    heldRef.recordHeldBorrow(owner.local.raw(), false, granted);
    heldRef.markAggregateViewOwner(owner.local.raw());
  }

  /// Records where a pattern binding's value lives, for the view rules. An
  /// owned binding is a local declared at `depth`. A binding destructured by
  /// reference lives in the scrutinee's storage: a local it then views, or a
  /// temporary scrutinee that stays alive down to `depth` (the arms of a
  /// `match`) and no further. A `let ... else` binding outlives its statement,
  /// so binding it by reference into a temporary is rejected outright.
  function recordPatternBindingStorage(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    defRaw: u32,
    borrowed: boolean,
    scrutineeOwner: &Borrowck::ViewOwner,
    depth: u64,
    isLetElse: boolean,
    span: SourceSpan,
  ): void {
    let mut stateRef: &mut Borrowck::State = state;

    if (!borrowed) {
      stateRef.recordLocalDepth(defRaw, depth);
      return;
    }

    if (scrutineeOwner.kind == Borrowck::VIEW_OWNER_LOCAL) {
      stateRef.setViewOwner(defRaw, scrutineeOwner.local.raw(), false);
      return;
    }

    if (scrutineeOwner.kind != Borrowck::VIEW_OWNER_TEMPORARY) {
      return;
    }

    let mut ownerDepth: u64 = depth;

    if (scrutineeOwner.scoped && scrutineeOwner.depth < depth) {
      ownerDepth = scrutineeOwner.depth;
    }

    if (isLetElse && !(scrutineeOwner.scoped && scrutineeOwner.depth <= depth)) {
      Borrowck::emitViewOutlivesOwner(defStore, symbols, hir, state, diagnostics, scrutineeOwner, false, span);
      return;
    }

    stateRef.setTemporaryStorage(defRaw, ownerDepth, scrutineeOwner.node.raw());
  }

  /// Gives every binding of `pattern` that copies a view out of a by-value
  /// scrutinee holding references (`Option::SOME(item)` against
  /// `vector.get(index)`) the storage the scrutinee points into. Bindings that
  /// need a drop are handled by the caller; a reference-typed scrutinee is
  /// skipped, because what a reference copied out of a referent points to is
  /// not known.
  function recordCopiedViewBindings(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    pattern: &Hir::HirPattern,
    scrutinee: Hir::HirId,
    depth: u64,
    isLetElse: boolean,
    span: SourceSpan,
  ): void {
    let Option::SOME(scrutineeType) = Borrowck::nodeTypeOf(hir, scrutinee) else {
      return;
    };

    if (Borrowck::isReferenceType(typeStore, scrutineeType) || !Borrowck::typeHoldsReference(defStore, typeStore, scrutineeType)) {
      return;
    }

    let mut bindings: Vector<u32> = Vector::new<u32>();
    Borrowck::collectAllBindings(pattern, &mut bindings);

    let mut owner: Borrowck::ViewOwner = Borrowck::externalViewOwner();
    let mut ownerKnown: boolean = false;
    let mut index: u64 = 0;

    while (index < bindings.length()) {
      if (let Option::SOME(defRaw) = bindings.get(index)) {
        let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*defRaw);
        let mut holdsView: boolean = false;

        if (let Option::SOME(bindingType) = Borrowck::variableTypeOf(defStore, defId)) {
          holdsView = !Borrowck::needsDropType(defStore, typeStore, bindingType) && Borrowck::typeHoldsView(defStore, typeStore, bindingType);
        }

        if (holdsView) {
          if (!ownerKnown) {
            owner = Borrowck::pointeeOwnerOf(defStore, typeStore, hir, state, scrutinee);
            ownerKnown = true;
          }

          Borrowck::recordPatternBindingStorage(defStore, symbols, hir, state, diagnostics, *defRaw, true, &owner, depth, isLetElse, span);
        }
      }

      index += 1;
    }
  }

  function collectAllBindings(pattern: &Hir::HirPattern, output: &mut Vector<u32>): void {
    match (pattern) {
      Hir::HirPattern::Binding(defId) -> {
        Borrowck::pushUniqueRaw(output, defId.raw());
      },
      Hir::HirPattern::Variant(variant) -> {
        let mut index: u64 = 0;

        while (index < variant.args.length()) {
          if (let Option::SOME(argument) = variant.args.get(index)) {
            Borrowck::collectAllBindings(argument, output);
          }

          index += 1;
        }
      },
      Hir::HirPattern::Tuple(elements) -> {
        let mut index: u64 = 0;

        while (index < elements.length()) {
          if (let Option::SOME(element) = elements.get(index)) {
            Borrowck::collectAllBindings(element, output);
          }

          index += 1;
        }
      },
      Hir::HirPattern::Or(patterns) -> {
        let mut index: u64 = 0;

        while (index < patterns.length()) {
          if (let Option::SOME(alternative) = patterns.get(index)) {
            Borrowck::collectAllBindings(alternative, output);
          }

          index += 1;
        }
      },
      _ -> {},
    };
  }

  /// The local whose own storage the place `nodeId` is part of, following
  /// field access and indexing only: a place reached through a dereference
  /// lives wherever the reference points.
  function placeRootLocal(hir: &Hir::HirStore, nodeId: Hir::HirId): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Option::NONE;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(defId) -> Option::SOME(defId),
      Hir::HirKind::FieldAccess(access) -> Borrowck::placeRootLocal(hir, access.base),
      Hir::HirKind::Index(indexNode) -> Borrowck::placeRootLocal(hir, indexNode.base),
      _ -> Option::NONE,
    };
  }

  /// Checks an assignment into a field or an element of a local, such as
  /// `holder.name = owned.toStr();`: the view lives as long as that local.
  function checkPlaceAssignedView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    target: Hir::HirId,
    value: Hir::HirId,
    span: SourceSpan,
  ): void {
    // Only a place inside a local's own storage: a write through a reference
    // reaches storage whose lifetime this function does not know.
    let Option::SOME(root) = Borrowck::placeRootLocal(hir, target) else {
      return;
    };

    let rootDepth: Option<u64> = state.localDepth(root.raw());

    if (rootDepth.isNone()) {
      return;
    }

    let owner: Borrowck::ViewOwner = Borrowck::keptViewOwner(defStore, typeStore, hir, state, value);
    Borrowck::checkKeptElementView(defStore, symbols, hir, state, diagnostics, rootDepth, &owner, span);
    Borrowck::checkAggregateViews(defStore, typeStore, symbols, hir, state, diagnostics, rootDepth, value, span);
    Borrowck::checkStoredClosureCaptures(defStore, typeStore, symbols, hir, state, diagnostics, rootDepth, value, span);
  }

  /// Rejects a `return` (or a returned body tail) whose value is a view of a
  /// temporary or of a local of the function: both are dropped before the
  /// caller could read through it.
  function rejectReturnedView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    value: Hir::HirId,
    span: SourceSpan,
  ): void {
    Borrowck::checkAggregateViews(defStore, typeStore, symbols, hir, state, diagnostics, Option::NONE, value, span);
    Borrowck::checkStoredClosureCaptures(defStore, typeStore, symbols, hir, state, diagnostics, Option::NONE, value, span);

    let owner: Borrowck::ViewOwner = Borrowck::keptViewOwner(defStore, typeStore, hir, state, value);

    if (owner.kind == Borrowck::VIEW_OWNER_EXTERNAL) {
      return;
    }

    Borrowck::emitViewOutlivesOwner(defStore, symbols, hir, state, diagnostics, &owner, true, span);
  }

  /// Reports every move `tryConsume` saw of a local that was borrowed at the
  /// time, such as moving the owner of a view while the view is alive.
  function reportMovesWhileBorrowed(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
  ): void {
    let mut index: u64 = 0;

    while (index < state.movedWhileBorrowedCount()) {
      if (let Option::SOME(defRaw) = state.movedWhileBorrowedDefAt(index)) {
        if (let Option::SOME(span) = state.movedWhileBorrowedSpanAt(index)) {
          let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(defRaw);
          let name: String = Borrowck::definitionName(defStore, symbols, defId);
          let message: String = `Cannot move '${name}' because it is borrowed`;

          Borrowck::emitOwnershipError(
            state,
            diagnostics,
            span,
            DiagnosticCode::MOVED_WHILE_BORROWED,
            message.toStr(),
            "move happens while a borrow is live",
            Option::SOME(defId),
          );
        }
      }

      index += 1;
    }
  }

  // --- manual drop queries -----------------------------------------------------------

  /// Whether `methodDefId` is the `drop` method of a type that declares
  /// `@implements(Drop)`. Mirrors `is_drop_method`, including its allowance for
  /// the monomorphized spelling of the name: both compilers mangle the method
  /// as `Owner__args__drop`, so both test a `__drop` suffix. Without it a
  /// `.drop()` on any generic receiver reads as an ordinary call and the
  /// receiver stays scheduled for a second, automatic teardown.
  function isDropMethod(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    methodDefId: Analyzer::DefinitionId,
  ): boolean {
    let mut owner: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut nameSymbol: Option<Analyzer::SymbolId> = Option::NONE;

    if (let Option::SOME(definition) = defStore.get(methodDefId)) {
      match (definition) {
        Analyzer::Definition::Method(methodDef) -> {
          owner = Option::SOME(methodDef.owner);
          nameSymbol = Option::SOME(methodDef.name);
        },
        _ -> {},
      };
    }

    let Option::SOME(ownerDefId) = owner else {
      return false;
    };
    let Option::SOME(name) = nameSymbol else {
      return false;
    };

    let mut named: boolean = false;

    if (let Option::SOME(text) = symbols.resolve(name)) {
      let spelled: String = String::create(text);

      // A specialization is named after its owner first (`Rc__i32__drop`), so
      // the mangled form is recognised by its suffix — the same test
      // `ownership_hir` makes.
      named = spelled.equals("drop") || spelled.endsWith("__drop");
    }

    if (!named) {
      return false;
    }

    return Borrowck::recordImplementsDrop(defStore, ownerDefId) || Borrowck::enumImplementsDrop(defStore, ownerDefId);
  }

  /// Whether `methodDefId` is a `drop` method bound to a receiver, which is
  /// what makes its body the recursive teardown of the type. Mirrors
  /// `is_inside_drop_method`, evaluated once per body instead of per call.
  function isInstanceDropMethod(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    methodDefId: Analyzer::DefinitionId,
  ): boolean {
    let mut isStatic: boolean = true;

    if (let Option::SOME(definition) = defStore.get(methodDefId)) {
      match (definition) {
        Analyzer::Definition::Method(methodDef) -> {
          isStatic = methodDef.isStatic;
        },
        _ -> {},
      };
    }

    if (isStatic) {
      return false;
    }

    return Borrowck::isDropMethod(defStore, symbols, methodDefId);
  }

  /// Whether a place expression bottoms out at a local. Mirrors
  /// `hir_roots_at_variable`.
  function hirRootsAtVariable(hir: &Hir::HirStore, nodeId: Hir::HirId): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(_) -> true,
      Hir::HirKind::Reference(reference) -> Borrowck::hirRootsAtVariable(hir, reference.expression),
      Hir::HirKind::Dereference(inner) -> Borrowck::hirRootsAtVariable(hir, inner),
      Hir::HirKind::FieldAccess(access) -> Borrowck::hirRootsAtVariable(hir, access.base),
      _ -> false,
    };
  }

  /// Whether a `.drop()` receiver is a field of a local, which is the shape a
  /// `Drop` type's own teardown takes. Mirrors `is_field_drop_on_variable`.
  function isFieldDropOnVariable(hir: &Hir::HirStore, receiver: Hir::HirId): boolean {
    let Option::SOME(node) = hir.get(receiver) else {
      return false;
    };

    return match (&node.kind) {
      Hir::HirKind::Reference(reference) -> Borrowck::isFieldDropOnVariable(hir, reference.expression),
      Hir::HirKind::FieldAccess(access) -> Borrowck::hirRootsAtVariable(hir, access.base),
      _ -> false,
    };
  }

  /// The local a `.drop()` receiver names, when it names one directly. Mirrors
  /// `extract_receiver_variable`, which deliberately stops at one level of
  /// reference so that a field, an index, or a call result stays untracked.
  function extractReceiverVariable(
    hir: &Hir::HirStore,
    receiver: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(receiver) else {
      return Option::NONE;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(defId) -> Option::SOME(defId),
      Hir::HirKind::Reference(reference) -> Borrowck::variableOf(hir, reference.expression),
      _ -> Option::NONE,
    };
  }

  /// Writing a field replaces the value that field holds, which leaks unless the
  /// old one is dropped first. Only that field is dropped: the record around it
  /// keeps every other field it still owes a drop for, and it is itself still
  /// live afterwards, so scheduling the owner here would tear down live fields
  /// and free a moved-away record twice. Mirrors `schedule_field_overwrite_drop`.
  ///
  /// A Copy-typed field owns nothing and schedules nothing. A field that was
  /// moved out of holds nothing either, but the compile-time state machine
  /// tracks locals rather than fields; the runtime drop flag carries that answer
  /// instead, and the field drop this schedules honours it exactly as a
  /// scope-end drop of the owner would.
  function scheduleFieldOverwriteDrop(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    target: Hir::HirId,
    nodeId: Hir::HirId,
  ): void {
    let Option::SOME(node) = hir.get(target) else {
      return;
    };

    let mut baseOpt: Option<Hir::HirId> = Option::NONE;
    let mut fieldIndex: u32 = 0;

    match (&node.kind) {
      Hir::HirKind::FieldAccess(access) -> {
        baseOpt = Option::SOME(access.base);
        fieldIndex = access.fieldIndex;
      },
      _ -> {},
    };

    let Option::SOME(base) = baseOpt else {
      return;
    };

    if (!Borrowck::needsDropType(defStore, typeStore, node.typeId)) {
      return;
    }

    // A root local that no longer holds a value has nothing to overwrite, and
    // writing into one is reported elsewhere; scheduling a drop for it would
    // free what the move or the earlier drop already freed.
    if (let Option::SOME(root) = Borrowck::assignTargetRootLocal(hir, target)) {
      if (!state.isMoveValid(root.raw())) {
        return;
      }
    }

    let Option::SOME(fieldDef) = Borrowck::fieldDefinitionAt(defStore, typeStore, hir, base, fieldIndex) else {
      return;
    };

    let mut schedulesRef: &mut Hir::DropSchedules = schedules;
    schedulesRef.appendFieldOverwrite(nodeId, fieldDef);
  }

  /// The field a `base.field` place names, as its own definition. Mirrors
  /// `field_definition`, including its walk through references and pointers.
  function fieldDefinitionAt(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    base: Hir::HirId,
    fieldIndex: u32,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(baseNode) = hir.get(base) else {
      return Option::NONE;
    };

    let mut baseType: Analyzer::TypeId = baseNode.typeId;

    while (true) {
      let Option::SOME(type_) = typeStore.get(baseType) else {
        return Option::NONE;
      };

      let mut inner: Option<Analyzer::TypeId> = Option::NONE;

      match (type_) {
        Analyzer::Type::Reference(reference) -> {
          inner = Option::SOME(reference.referent);
        },
        Analyzer::Type::Pointer(pointer) -> {
          inner = Option::SOME(pointer.pointee);
        },
        _ -> {},
      };

      let Option::SOME(next) = inner else {
        break;
      };

      baseType = next;
    }

    let Option::SOME(resolved) = typeStore.get(baseType) else {
      return Option::NONE;
    };

    let Analyzer::Type::Record(recordDefId) = resolved else {
      return Option::NONE;
    };

    let Option::SOME(definition) = defStore.get(recordDefId) else {
      return Option::NONE;
    };

    let Analyzer::Definition::Record(recordDef) = definition else {
      return Option::NONE;
    };

    let Option::SOME(fieldDefId) = recordDef.fields.get(fieldIndex as u64) else {
      return Option::NONE;
    };

    return Option::SOME(*fieldDefId);
  }

  /// The local an assignment target bottoms out at, when it bottoms out at one
  /// at all. Mirrors `assign_target_root_local`: a dereference reaches storage
  /// this function does not own, so it names no local.
  function assignTargetRootLocal(
    hir: &Hir::HirStore,
    target: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(target) else {
      return Option::NONE;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(defId) -> Option::SOME(defId),
      Hir::HirKind::FieldAccess(access) -> Borrowck::assignTargetRootLocal(hir, access.base),
      Hir::HirKind::Index(indexNode) -> Borrowck::assignTargetRootLocal(hir, indexNode.base),
      _ -> Option::NONE,
    };
  }

  /// The local a node names when it is a bare variable, without following any
  /// place chain.
  function variableOf(hir: &Hir::HirStore, nodeId: Hir::HirId): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Option::NONE;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(defId) -> Option::SOME(defId),
      _ -> Option::NONE,
    };
  }

  /// Whether `id` evaluates to a value LIR lowering materializes: anything but
  /// `void` and `never`. Mirrors `LirLowering::producesNoValue`.
  function nodeProducesValue(
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    id: Hir::HirId,
  ): boolean {
    let Option::SOME(node) = hir.get(id) else {
      return false;
    };

    let Option::SOME(type_) = typeStore.get(node.typeId) else {
      return true;
    };

    return match (type_) {
      Analyzer::Type::VOID | Analyzer::Type::NEVER -> false,
      _ -> true,
    };
  }

  /// The binding a match arm hands to the match result, if its value is one
  /// directly. Mirrors `arm_result_binding`, including the walk through
  /// block tails.
  function armResultBinding(
    hir: &Hir::HirStore,
    bodyId: Hir::HirId,
  ): Option<Analyzer::DefinitionId> {
    let Option::SOME(node) = hir.get(bodyId) else {
      return Option::NONE;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(defId) -> Option::SOME(defId),
      Hir::HirKind::Block(block) -> match (block.expression) {
        Option::SOME(tail) -> Borrowck::armResultBinding(hir, tail),
        Option::NONE -> Option::NONE,
      },
      _ -> Option::NONE,
    };
  }

  /// Every binding of a pattern whose type owns resources, in pattern order.
  /// Mirrors `collect_droppable_pattern_def_ids`.
  function collectDroppableBindings(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    pattern: &Hir::HirPattern,
    output: &mut Vector<u32>,
  ): void {
    match (pattern) {
      Hir::HirPattern::Wildcard -> {},
      Hir::HirPattern::Literal(_) -> {},
      Hir::HirPattern::Constant(_) -> {},
      Hir::HirPattern::Binding(defId) -> {
        if (Borrowck::definitionNeedsDrop(defStore, typeStore, defId) || Borrowck::definitionIsClosure(defStore, typeStore, defId)) {
          Borrowck::pushUniqueRaw(output, defId.raw());
        }
      },
      Hir::HirPattern::Variant(variant) -> {
        let mut index: u64 = 0;

        while (index < variant.args.length()) {
          if (let Option::SOME(argument) = variant.args.get(index)) {
            Borrowck::collectDroppableBindings(defStore, typeStore, argument, output);
          }

          index += 1;
        }
      },
      Hir::HirPattern::Tuple(elements) -> {
        let mut index: u64 = 0;

        while (index < elements.length()) {
          if (let Option::SOME(element) = elements.get(index)) {
            Borrowck::collectDroppableBindings(defStore, typeStore, element, output);
          }

          index += 1;
        }
      },
      Hir::HirPattern::Or(patterns) -> {
        let mut index: u64 = 0;

        while (index < patterns.length()) {
          if (let Option::SOME(alternative) = patterns.get(index)) {
            Borrowck::collectDroppableBindings(defStore, typeStore, alternative, output);
          }

          index += 1;
        }
      },
    };
  }

  // --- diagnostics -------------------------------------------------------------------

  function emitError(
    diagnostics: &mut DiagnosticBag,
    span: SourceSpan,
    code: static str,
    message: str,
    labelMessage: str,
  ): void {
    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, code, message, span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, labelMessage);

    let mut bag: &mut DiagnosticBag = diagnostics;
    bag.push(diagnostic);
  }

  /// Emits an ownership or borrow diagnostic and records it in the report in
  /// one call, so the two cannot drift apart. `defId` is the local the
  /// diagnostic is about, absent when it is about an expression that names
  /// none.
  function emitOwnershipError(
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    span: SourceSpan,
    code: static str,
    message: str,
    labelMessage: str,
    defId: Option<Analyzer::DefinitionId>,
  ): void {
    Borrowck::emitError(diagnostics, span, code, message, labelMessage);
    Borrowck::noteDiagnostic(state, code, defId, span);
  }

  function emitOwnershipWarning(
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    span: SourceSpan,
    code: static str,
    message: str,
    labelMessage: str,
    defId: Option<Analyzer::DefinitionId>,
  ): void {
    Borrowck::emitWarning(diagnostics, span, code, message, labelMessage);
    Borrowck::noteDiagnostic(state, code, defId, span);
  }

  function emitWarning(
    diagnostics: &mut DiagnosticBag,
    span: SourceSpan,
    code: static str,
    message: str,
    labelMessage: str,
  ): void {
    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::WARNING, code, message, span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, labelMessage);

    let mut bag: &mut DiagnosticBag = diagnostics;
    bag.push(diagnostic);
  }

  /// Emits `Use of moved value 'name'` carrying the same trailing notes the
  /// Rust oracle attaches in `build_use_after_move_diagnostic`: why the value's
  /// type is non-Copy, and which trait would give the program a way out.
  function emitUseAfterMove(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    defId: Analyzer::DefinitionId,
    span: SourceSpan,
  ): void {
    Borrowck::noteDiagnostic(state, DiagnosticCode::USE_AFTER_MOVE, Option::SOME(defId), span);

    let name: String = Borrowck::definitionName(defStore, symbols, defId);
    let message: String = `Use of moved value '${name}'`;

    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      DiagnosticCode::USE_AFTER_MOVE,
      message.toStr(),
      span,
    );
    diagnostic.addLabel(LabelKind::PRIMARY, span, "value used here after it was moved");

    if (let Option::SOME(typeId) = Borrowck::variableTypeOf(defStore, defId)) {
      Borrowck::appendNonCopyNotes(defStore, typeStore, symbols, &mut diagnostic, typeId);
    }

    let mut bag: &mut DiagnosticBag = diagnostics;
    bag.push(diagnostic);
  }

  /// Nominal name of a type as the move diagnostics spell it: `record Name`
  /// and `enum Name` carry their keyword, every other type reads as the
  /// type store already renders it. Mirrors `format_type_name`.
  function nominalTypeName(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    typeId: Analyzer::TypeId,
  ): String {
    let plain: String = typeStore.nameOfResolved(typeId, &*defStore, &*symbols);

    let Option::SOME(type_) = typeStore.get(typeId) else {
      return plain;
    };

    return match (type_) {
      Analyzer::Type::Record(_) -> `record ${plain.toStr()}`,
      Analyzer::Type::Enum(_) -> `enum ${plain.toStr()}`,
      _ -> plain,
    };
  }

  /// Appends the two notes the oracle's `append_non_copy_notes` produces for a
  /// record type: what makes it non-Copy, then the remedy that fits the traits
  /// it already carries. Non-record types get no notes, like the oracle.
  function appendNonCopyNotes(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    diagnostic: &mut Diagnostic,
    typeId: Analyzer::TypeId,
  ): void {
    let Option::SOME(type_) = typeStore.get(typeId) else {
      return;
    };

    let Analyzer::Type::Record(recordDefId) = type_ else {
      return;
    };

    let Option::SOME(definition) = defStore.get(recordDefId) else {
      return;
    };

    let Analyzer::Definition::Record(recordDef) = definition else {
      return;
    };

    let implementsDrop: boolean = recordDef.implementsDrop;
    let implementsClone: boolean = Borrowck::declaresTrait(&recordDef.implementedTraits, "Clone");
    let mut fieldIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut fieldIndex: u64 = 0;

    while (fieldIndex < recordDef.fields.length()) {
      if (let Option::SOME(fieldId) = recordDef.fields.get(fieldIndex)) {
        fieldIds.push(*fieldId);
      }

      fieldIndex += 1;
    }

    let typeName: String = Borrowck::nominalTypeName(defStore, typeStore, symbols, typeId);
    let nonCopyField: Option<Analyzer::DefinitionId> = Borrowck::firstNonCopyField(defStore, typeStore, &fieldIds);

    let mut target: &mut Diagnostic = diagnostic;

    if (implementsDrop) {
      let note: String = `'${typeName.toStr()}' implements Drop, which makes it non-Copy`;
      target.addNote(note.toStr());
    } else if (let Option::SOME(fieldId) = nonCopyField) {
      let fieldName: String = Borrowck::definitionName(defStore, symbols, fieldId);
      let fieldTypeName: String = match (Borrowck::fieldTypeOf(defStore, fieldId)) {
        Option::SOME(fieldType) -> Borrowck::nominalTypeName(defStore, typeStore, symbols, fieldType),
        Option::NONE -> String::create("<unknown>"),
      };

      let note: String = `'${typeName.toStr()}' is non-Copy because field '${fieldName.toStr()}' has type '${fieldTypeName.toStr()}' which is non-Copy`;
      target.addNote(note.toStr());
    } else {
      let note: String = `'${typeName.toStr()}' is non-Copy; consider adding '@implements(Copy)'`;
      target.addNote(note.toStr());
    }

    if (implementsClone) {
      target.addNote("help: consider using '.clone()' to create an explicit copy");
      return;
    }

    if (!implementsDrop && nonCopyField.isNone()) {
      let note: String = `help: consider adding '@implements(Copy)' to '${typeName.toStr()}' since all its fields are Copy`;
      target.addNote(note.toStr());
      return;
    }

    let note: String = `help: consider adding '@implements(Clone)' to '${typeName.toStr()}' and implementing a 'clone' method`;
    target.addNote(note.toStr());
  }

  function declaresTrait(traits: &Vector<String>, name: str): boolean {
    let mut index: u64 = 0;

    while (index < traits.length()) {
      if (let Option::SOME(declared) = traits.get(index)) {
        if (declared.equals(name)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function firstNonCopyField(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    fieldIds: &Vector<Analyzer::DefinitionId>,
  ): Option<Analyzer::DefinitionId> {
    let mut index: u64 = 0;

    while (index < fieldIds.length()) {
      let Option::SOME(fieldId) = fieldIds.get(index) else {
        index += 1;
        continue;
      };

      if (let Option::SOME(fieldType) = Borrowck::fieldTypeOf(defStore, *fieldId)) {
        if (!Analyzer::Typecheck::isCopyType(defStore, typeStore, fieldType)) {
          return Option::SOME(*fieldId);
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  function fieldTypeOf(
    defStore: &mut Analyzer::DefinitionStore,
    fieldId: Analyzer::DefinitionId,
  ): Option<Analyzer::TypeId> {
    let Option::SOME(definition) = defStore.get(fieldId) else {
      return Option::NONE;
    };

    return match (definition) {
      Analyzer::Definition::Field(field) -> Option::SOME(field.fieldType),
      _ -> Option::NONE,
    };
  }

  function copyDiagnostic(source: &Diagnostic): Diagnostic {
    let mut copy: Diagnostic = Diagnostic::new(
      source.severity,
      source.code,
      source.messageText(),
      source.primarySpan,
    );

    let mut index: u64 = 0;

    while (index < source.labels.length()) {
      if (let Option::SOME(label) = source.labels.get(index)) {
        copy.addLabel(label.kind, label.span, label.messageText());
      }

      index += 1;
    }

    return copy;
  }

  function bagContainsMessage(bag: &mut DiagnosticBag, message: str): boolean {
    let mut index: u64 = 0;

    while (index < bag.length()) {
      if (let Option::SOME(diagnostic) = bag.get(index)) {
        if (String::create(diagnostic.messageText()).equals(message)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// Appends the diagnostics of a loop's second body pass that say something
  /// the first pass did not already say. Mirrors
  /// `deduplicate_second_pass_diagnostics`, which compares rendered messages.
  function appendNewDiagnostics(target: &mut DiagnosticBag, source: &DiagnosticBag): void {
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(diagnostic) = source.get(index)) {
        if (!Borrowck::bagContainsMessage(target, diagnostic.messageText())) {
          let mut bag: &mut DiagnosticBag = target;
          bag.push(Borrowck::copyDiagnostic(diagnostic));
        }
      }

      index += 1;
    }
  }

  // --- borrow and move transitions ---------------------------------------------------

  /// Takes a borrow of `target`, reporting the conflicting-borrow diagnostics
  /// on a state that cannot accept it. Mirrors `try_borrow`, including its
  /// choice to leave the state untouched when the borrow is rejected.
  /// `recordBorrow` is false for the one call that re-takes a borrow the walk
  /// already reported: an argument spelled `&x` is opened and released by the
  /// `Reference` arm and then again by `checkTemporaryBorrow`, and the report
  /// counts logical borrows rather than checker visits. The conflict
  /// diagnostics below are recorded either way, because the second visit is
  /// where some of them fire.
  ///
  /// Returns whether the borrow was granted. A caller that releases has to ask,
  /// or the report ends up with a release the refused borrow never opened; a
  /// refusal is recorded as its own event instead, which is what a reader
  /// looking for a conflict wants to see.
  function tryBorrow(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    target: Analyzer::DefinitionId,
    mutable: boolean,
    span: SourceSpan,
    recordBorrow: boolean,
  ): boolean {
    let current: u32 = state.borrowValue(target.raw());

    if (mutable) {
      if (current == Borrowck::BORROW_NONE) {
        if (recordBorrow) {
          Borrowck::noteBorrow(state, target.raw(), true, true, span);
        }

        let mut stateRef: &mut Borrowck::State = state;
        stateRef.setBorrowValue(target.raw(), Borrowck::BORROW_MUT);
        return true;
      }

      let name: String = Borrowck::definitionName(defStore, symbols, target);

      if (current == Borrowck::BORROW_MUT) {
        let message: String = `Cannot borrow '${name}' as mutable because it is already borrowed as mutable`;
        Borrowck::emitOwnershipError(
          state,
          diagnostics,
          span,
          DiagnosticCode::BORROW_MUTABLE_WHILE_MUTABLE,
          message.toStr(),
          "second mutable borrow taken here",
          Option::SOME(target),
        );
        Borrowck::noteBorrowRejected(state, target.raw(), true, current, span);
        return false;
      }

      let message: String = `Cannot borrow '${name}' as mutable because it is already borrowed as immutable`;
      Borrowck::emitOwnershipError(
        state,
        diagnostics,
        span,
        DiagnosticCode::BORROW_MUTABLE_WHILE_IMMUTABLE,
        message.toStr(),
        "mutable borrow taken here",
        Option::SOME(target),
      );
      Borrowck::noteBorrowRejected(state, target.raw(), true, current, span);
      return false;
    }

    if (current == Borrowck::BORROW_MUT) {
      let name: String = Borrowck::definitionName(defStore, symbols, target);
      let message: String = `Cannot borrow '${name}' as immutable because it is already borrowed as mutable`;
      Borrowck::emitOwnershipError(
        state,
        diagnostics,
        span,
        DiagnosticCode::BORROW_IMMUTABLE_WHILE_MUTABLE,
        message.toStr(),
        "shared borrow taken here",
        Option::SOME(target),
      );
      Borrowck::noteBorrowRejected(state, target.raw(), false, current, span);
      return false;
    }

    if (recordBorrow) {
      Borrowck::noteBorrow(state, target.raw(), false, true, span);
    }

    let mut stateRef: &mut Borrowck::State = state;

    if (current == Borrowck::BORROW_NONE) {
      stateRef.setBorrowValue(target.raw(), Borrowck::BORROW_SHARED_BASE + 1);
      return true;
    }

    stateRef.setBorrowValue(target.raw(), current + 1);

    return true;
  }

  /// Reports a read of a local whose value was moved away. Mirrors
  /// `check_use`, restricted to the states this slice models.
  function checkUse(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    defId: Analyzer::DefinitionId,
    span: SourceSpan,
  ): void {
    let Option::SOME(value) = state.moveValue(defId.raw()) else {
      return;
    };

    if (value == Borrowck::MOVE_DROPPED) {
      let droppedName: String = Borrowck::definitionName(defStore, symbols, defId);
      let droppedMessage: String = `Use of dropped value '${droppedName}'`;

      Borrowck::emitOwnershipError(
        state,
        diagnostics,
        span,
        DiagnosticCode::USE_AFTER_DROP,
        droppedMessage.toStr(),
        "value used here after it was dropped",
        Option::SOME(defId),
      );

      return;
    }

    if (value != Borrowck::MOVE_MOVED) {
      return;
    }

    Borrowck::emitUseAfterMove(defStore, typeStore, symbols, state, diagnostics, defId, span);
  }

  /// Reports handing on a value that lives in borrowed storage. Mirrors the
  /// oracle's `CannotMoveOutOfBorrowedValue`, which the selfhost code space
  /// numbers `O0002`.
  function emitCannotMoveOutOfBorrow(
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    defId: Option<Analyzer::DefinitionId>,
    span: SourceSpan,
  ): void {
    // A closure can be called any number of times, and every call reads the
    // same environment, so a value moved out by one call would be missing, or
    // freed a second time, on the next.
    if (let Option::SOME(captured) = defId) {
      if (state.isEnvironmentCapture(captured.raw())) {
        Borrowck::emitOwnershipError(
          state,
          diagnostics,
          span,
          DiagnosticCode::CANNOT_MOVE_OUT_OF_BORROW,
          "cannot move a captured value out of its closure's environment",
          "the closure can be called again, so its environment keeps this value",
          defId,
        );

        return;
      }
    }

    Borrowck::emitOwnershipError(
      state,
      diagnostics,
      span,
      DiagnosticCode::CANNOT_MOVE_OUT_OF_BORROW,
      "cannot move out of borrowed value",
      "this value is borrowed, so it cannot be handed on by value",
      defId,
    );
  }

  /// Transitions a local to `Moved`. An already invalid state is left as it
  /// is, because `checkUse` has already reported it. Mirrors `try_consume`.
  ///
  /// Records a move site on the `Valid -> Moved` transition only, mirroring
  /// `record_move`: pure debugging metadata for `--dump-drop-schedule` that
  /// never influences what is dropped.
  function tryConsume(
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    defId: Analyzer::DefinitionId,
    span: SourceSpan,
    consumer: u32,
  ): void {
    // A move out of a closure's environment is rejected where it happens, and
    // the environment keeps the value, so there is no transition to record.
    // Recording one would report every later use as a use after move.
    if (state.isEnvironmentCapture(defId.raw())) {
      return;
    }

    if (let Option::SOME(value) = state.moveValue(defId.raw())) {
      if (value == Borrowck::MOVE_MOVED || value == Borrowck::MOVE_DROPPED || value == Borrowck::MOVE_FREED) {
        return;
      }
    }

    let functionId: Analyzer::DefinitionId = state.currentFunctionId();

    // Only a view local's borrow counts here. A `let r = &x` borrow is held to
    // the end of its scope however early `r` is last used, and moving `x` after
    // that last use is common enough that reporting it would reject valid code.
    let borrowed: boolean = state.borrowValue(defId.raw()) != Borrowck::BORROW_NONE && state.isViewOwner(defId.raw());

    let mut stateRef: &mut Borrowck::State = state;

    if (borrowed) {
      stateRef.recordMovedWhileBorrowed(defId.raw(), span);
    }

    stateRef.setMoveValue(defId.raw(), Borrowck::MOVE_MOVED);

    let mut schedulesRef: &mut Hir::DropSchedules = schedules;
    schedulesRef.recordMove(defId, functionId, span);

    Borrowck::noteMove(state, defId, consumer, span);
  }

  /// Applies a manual `.drop()` to the local its receiver names. A live local
  /// becomes `Dropped`, which takes it out of every later drop list and makes a
  /// later read a use after drop; an already invalid state is reported instead.
  /// Mirrors `handle_manual_drop`, minus the `Freed` arm that `deallocate`
  /// would produce.
  function handleManualDrop(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    defId: Analyzer::DefinitionId,
    span: SourceSpan,
  ): void {
    let current: u32 = match (state.moveValue(defId.raw())) {
      Option::SOME(value) -> value,
      Option::NONE -> Borrowck::MOVE_VALID,
    };

    if (current == Borrowck::MOVE_DROPPED) {
      let droppedName: String = Borrowck::definitionName(defStore, symbols, defId);
      let droppedMessage: String = `Value '${droppedName}' has already been dropped`;

      Borrowck::emitOwnershipError(
        state,
        diagnostics,
        span,
        DiagnosticCode::DOUBLE_DROP,
        droppedMessage.toStr(),
        "this value was already dropped",
        Option::SOME(defId),
      );

      return;
    }

    // A returned local left this scope, so dropping it here tears down storage
    // the caller owns: the oracle models that as a use after move.
    if (current == Borrowck::MOVE_MOVED || current == Borrowck::MOVE_RETURNED) {
      Borrowck::emitUseAfterMove(defStore, typeStore, symbols, state, diagnostics, defId, span);

      return;
    }

    let mut stateRef: &mut Borrowck::State = state;
    stateRef.setMoveValue(defId.raw(), Borrowck::MOVE_DROPPED);
  }

  /// Declares a local as owned by the innermost scope. Mirrors
  /// `declare_owned`: the local becomes live and joins the scope's drop list.
  function declareOwned(state: &mut Borrowck::State, defId: Analyzer::DefinitionId): void {
    let mut stateRef: &mut Borrowck::State = state;
    stateRef.setMoveValue(defId.raw(), Borrowck::MOVE_VALID);
    stateRef.pushOwned(defId.raw());
  }

  // --- drop schedule production ------------------------------------------------------

  function definitionIdsFromRaw(raws: &Vector<u32>): Vector<Analyzer::DefinitionId> {
    let mut result: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut index: u64 = 0;

    while (index < raws.length()) {
      if (let Option::SOME(raw) = raws.get(index)) {
        result.push(Id::fromRaw<Analyzer::DefinitionTag>(*raw));
      }

      index += 1;
    }

    return result;
  }

  function hirIdsFromRaw(raws: &Vector<u32>): Vector<Hir::HirId> {
    let mut result: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < raws.length()) {
      if (let Option::SOME(raw) = raws.get(index)) {
        result.push(Id::fromRaw<Hir::NodeTag>(*raw));
      }

      index += 1;
    }

    return result;
  }

  /// Records the drops and deferred bodies the innermost scope owes, then pops
  /// it. Mirrors `exit_block_scope`, including its choice to write nothing for
  /// a scope with no block of its own: the function root and the loop marker
  /// scope are unwound by the exits that leave them, not by a block end.
  function exitScope(state: &mut Borrowck::State, schedules: &mut Hir::DropSchedules): void {
    let drops: Vector<u32> = state.currentScopeDrops();
    let defers: Vector<u32> = state.currentScopeDefers();

    if (let Option::SOME(blockRaw) = state.currentScopeBlock()) {
      let block: Hir::HirId = Id::fromRaw<Hir::NodeTag>(blockRaw);

      if (!drops.isEmpty()) {
        let mut scheduleRef: &mut Hir::DropSchedules = schedules;
        scheduleRef.setScopeEnd(block, Borrowck::definitionIdsFromRaw(&drops));
      }

      if (!defers.isEmpty()) {
        let mut deferRef: &mut Hir::DropSchedules = schedules;
        deferRef.setScopeEndDefers(block, Borrowck::hirIdsFromRaw(&defers));
      }
    }

    let mut stateRef: &mut Borrowck::State = state;
    stateRef.popScopeReleasing();
  }

  /// Records the drops and deferred bodies an early exit owes when it unwinds
  /// every scope down to `toScopeIndex`. Mirrors the shared body of
  /// `check_return`, `check_break`, and `check_continue`.
  function recordExitSchedule(
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    key: &Hir::ExitKey,
    toScopeIndex: u64,
  ): void {
    let extra: Vector<u32> = Vector::new<u32>();

    Borrowck::recordExitScheduleWith(state, schedules, key, toScopeIndex, &extra);
  }

  /// The same schedule, plus places that belong to no unwound scope.
  ///
  /// `extra` holds them in declaration order and is appended in the reverse, after
  /// the scope drops: a loop condition's scrutinee lives outside the loop, so it is
  /// freed last. A place that is already moved owes nothing, and the membership
  /// guard keeps the one shape that could appear in both lists from dropping twice.
  function recordExitScheduleWith(
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    key: &Hir::ExitKey,
    toScopeIndex: u64,
    extra: &Vector<u32>,
  ): void {
    let mut drops: Vector<u32> = state.exitDrops(toScopeIndex);
    let defers: Vector<u32> = state.exitDefers(toScopeIndex);

    let mut index: u64 = extra.length();

    while (index > 0) {
      index -= 1;

      if (let Option::SOME(defRaw) = extra.get(index)) {
        if (state.isMoveValid(*defRaw)) {
          Borrowck::pushUniqueRaw(&mut drops, *defRaw);
        }
      }
    }

    if (!drops.isEmpty()) {
      let mut scheduleRef: &mut Hir::DropSchedules = schedules;
      scheduleRef.setExit(Hir::copyExitKey(key), Borrowck::definitionIdsFromRaw(&drops));
    }

    if (!defers.isEmpty()) {
      let mut deferRef: &mut Hir::DropSchedules = schedules;
      deferRef.setExitDefers(Hir::copyExitKey(key), Borrowck::hirIdsFromRaw(&defers));
    }
  }

  /// Records what a `break` or a `continue` owes: everything between here and
  /// the loop marker scope, which itself stays open. A jump with no enclosing
  /// loop schedules nothing, exactly as the oracle leaves it to the earlier
  /// semantic check to report.
  ///
  /// `paysConditionScrutinees` separates the two jumps. A `break` also owes the
  /// place its loop's `let` condition consumes: that condition is the place's only
  /// other drop site, and a `break` leaves without reaching it, so a body that
  /// refilled the place before breaking would otherwise leak what it put there. A
  /// `continue` jumps back to the condition, which is the drop site itself, and
  /// owes nothing for it. Mirrors `check_break` and `check_continue`.
  function recordLoopExitSchedule(
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    key: Hir::ExitKey,
    paysConditionScrutinees: boolean,
  ): void {
    let Option::SOME(loopIndex) = state.loopScopeIndex() else {
      return;
    };

    let mut extra: Vector<u32> = Vector::new<u32>();

    if (paysConditionScrutinees) {
      extra = state.innermostLoopScrutinees();
    }

    Borrowck::recordExitScheduleWith(state, schedules, &key, loopIndex + 1, &extra);
  }

  /// Whether a match scrutinee names storage that belongs to something else: a
  /// field, an element, a dereference, a static. Its payload bindings borrow
  /// those bytes instead of owning them, so the base's own schedule frees them.
  /// This does not hold once the base's drop was suppressed for a payload that
  /// left it, which `armBindingsOwnPayload` reports. Mirrors
  /// `scrutinee_aliases_external_storage`.
  function aliasesExternalStorage(hir: &Hir::HirStore, scrutinee: Hir::HirId): boolean {
    let Option::SOME(node) = hir.get(scrutinee) else {
      return false;
    };

    return match (&node.kind) {
      Hir::HirKind::FieldAccess(_) -> true,
      Hir::HirKind::Index(_) -> true,
      Hir::HirKind::Dereference(_) -> true,
      Hir::HirKind::StaticAccess(_) -> true,
      _ -> false,
    };
  }

  /// Whether a field access reads through borrowed storage: its base chain
  /// reaches a dereferenced reference or a borrowed pattern binding. Mirrors
  /// `field_base_is_borrowed`.
  function fieldBaseIsBorrowed(
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId,
  ): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    let mut baseOpt: Option<Hir::HirId> = Option::NONE;

    match (&node.kind) {
      Hir::HirKind::FieldAccess(access) -> {
        baseOpt = Option::SOME(access.base);
      },
      _ -> {},
    };

    let Option::SOME(baseId) = baseOpt else {
      return false;
    };

    let Option::SOME(baseNode) = hir.get(baseId) else {
      return false;
    };

    let mut derefInner: Option<Hir::HirId> = Option::NONE;
    let mut variableRaw: Option<u32> = Option::NONE;

    match (&baseNode.kind) {
      Hir::HirKind::Dereference(inner) -> {
        derefInner = Option::SOME(inner);
      },
      Hir::HirKind::Variable(defId) -> {
        variableRaw = Option::SOME(defId.raw());
      },
      _ -> {},
    };

    if (let Option::SOME(innerId) = derefInner) {
      if (let Option::SOME(innerNode) = hir.get(innerId)) {
        if (Borrowck::isReferenceType(typeStore, innerNode.typeId)) {
          return true;
        }
      }

      return Borrowck::fieldBaseIsBorrowed(typeStore, hir, state, innerId);
    }

    if (let Option::SOME(raw) = variableRaw) {
      return state.isBorrowedBinding(raw);
    }

    return Borrowck::fieldBaseIsBorrowed(typeStore, hir, state, baseId);
  }

  /// Whether destructuring this scrutinee binds payloads that still live in
  /// borrowed storage: a reference-typed scrutinee, a dereference of a
  /// reference, a binding an earlier destructure through a reference produced,
  /// or a field reached through one. Mirrors `scrutinee_binds_borrowed_payloads`.
  function bindsBorrowedPayloads(
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    scrutinee: Hir::HirId,
  ): boolean {
    let Option::SOME(node) = hir.get(scrutinee) else {
      return false;
    };

    if (Borrowck::isReferenceType(typeStore, node.typeId)) {
      return true;
    }

    let mut inner: Option<Hir::HirId> = Option::NONE;
    let mut variableRaw: Option<u32> = Option::NONE;
    let mut isFieldAccess: boolean = false;

    match (&node.kind) {
      Hir::HirKind::Dereference(target) -> {
        inner = Option::SOME(target);
      },
      Hir::HirKind::Variable(defId) -> {
        variableRaw = Option::SOME(defId.raw());
      },
      Hir::HirKind::FieldAccess(_) -> {
        isFieldAccess = true;
      },
      _ -> {},
    };

    if (let Option::SOME(raw) = variableRaw) {
      return state.isBorrowedBinding(raw);
    }

    if (isFieldAccess) {
      return Borrowck::fieldBaseIsBorrowed(typeStore, hir, state, scrutinee);
    }

    let Option::SOME(innerId) = inner else {
      return false;
    };

    let Option::SOME(innerNode) = hir.get(innerId) else {
      return false;
    };

    return Borrowck::isReferenceType(typeStore, innerNode.typeId);
  }

  /// The droppable bindings `pattern` takes out of the borrowed elements of a tuple
  /// literal scrutinee, one level of tuple at a time. `bindsBorrowedPayloads` sees
  /// the tuple itself, which is an owned temporary even when every element is a
  /// reference, so without this each element's payload would be scheduled for a drop
  /// its referent still owes.
  function collectBorrowedTupleElementBindings(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    scrutinee: Hir::HirId,
    pattern: &Hir::HirPattern,
    output: &mut Vector<u32>,
  ): void {
    let Option::SOME(node) = hir.get(scrutinee) else {
      return;
    };

    let Hir::HirKind::TupleLiteral(elements) = &node.kind else {
      return;
    };

    match (pattern) {
      Hir::HirPattern::Tuple(subpatterns) -> {
        let mut index: u64 = 0;

        while (index < subpatterns.length() && index < elements.length()) {
          if (let Option::SOME(subpattern) = subpatterns.get(index)) {
            if (let Option::SOME(element) = elements.get(index)) {
              if (Borrowck::bindsBorrowedPayloads(typeStore, hir, state, *element)) {
                Borrowck::collectDroppableBindings(defStore, typeStore, subpattern, output);
              } else {
                Borrowck::collectBorrowedTupleElementBindings(defStore, typeStore, hir, state, *element, subpattern, output);
              }
            }
          }

          index += 1;
        }
      },
      Hir::HirPattern::Or(alternatives) -> {
        let mut index: u64 = 0;

        while (index < alternatives.length()) {
          if (let Option::SOME(alternative) = alternatives.get(index)) {
            Borrowck::collectBorrowedTupleElementBindings(defStore, typeStore, hir, state, scrutinee, alternative, output);
          }

          index += 1;
        }
      },
      _ -> {},
    };
  }

  function isReferenceType(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): boolean {
    let Option::SOME(type_) = typeStore.get(typeId) else {
      return false;
    };

    return match (type_) {
      Analyzer::Type::Reference(_) -> true,
      _ -> false,
    };
  }

  /// Whether the node is itself a binding whose bytes live in borrowed storage.
  /// `fieldBaseIsBorrowed` covers places reached through a reference; this
  /// covers the binding a destructure of one produced, which can be handed on
  /// whole. Mirrors `is_borrowed_binding`.
  function isBorrowedBindingNode(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId,
  ): boolean {
    let Option::SOME(defId) = Borrowck::variableOf(hir, nodeId) else {
      return false;
    };

    return state.isBorrowedBinding(defId.raw());
  }

  /// Rejects an `@eq<T>` whose comparison strategy monomorphization could not
  /// pick: `T` is neither an integer primitive, `boolean`, `char` nor `str`,
  /// and does not declare `@implements(Eq)` with an `equals` method. Code
  /// generation has no comparison to emit for it and would leave the result
  /// unset. The check lives here because this walk is the first analysis that
  /// sees every `T` substituted; the driver only runs it over monomorphized HIR.
  function rejectUnsupportedEquality(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    diagnostics: &mut DiagnosticBag,
    eqNode: &Hir::HirBuiltinEq,
    span: SourceSpan,
  ): void {
    let unresolved: boolean = match (&eqNode.kind) {
      Hir::BuiltinEqKind::Pending -> true,
      _ -> false,
    };

    if (!unresolved) {
      return;
    }

    let typeName: String = typeStore.nameOfResolved(eqNode.ty, &*defStore, &*symbols);
    let message: String = `type '${typeName.toStr()}' does not support \`@eq\``;
    let label: String = `declare \`@implements(Eq)\` with \`equals(&self, other: &${typeName.toStr()}): boolean\`, or compare its fields`;

    Borrowck::emitError(diagnostics, span, DiagnosticCode::UNSUPPORTED_EQUALITY, message.toStr(), label.toStr());
  }

  /// Rejects an atomic builtin whose `T` was a type parameter at typecheck
  /// and was substituted with a type the operation does not support: one that
  /// is not an integer primitive, `boolean` or a raw pointer, or a non-integer
  /// under an arithmetic or bitwise `@atomicRmw`. Typecheck rejects every
  /// concrete `T` itself, so this only fires for generic code.
  function rejectUnsupportedAtomic(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    diagnostics: &mut DiagnosticBag,
    atomicNode: &Hir::HirBuiltinAtomic,
    span: SourceSpan,
  ): void {
    if (let Hir::AtomicOperation::FENCE = atomicNode.operation) {
      return;
    }

    let valueClass: Analyzer::Typecheck::AtomicValueClass = Analyzer::Typecheck::atomicValueClass(defStore, typeStore, atomicNode.ty);
    let supported: boolean = match (valueClass) {
      Analyzer::Typecheck::AtomicValueClass::INTEGER -> true,
      Analyzer::Typecheck::AtomicValueClass::SCALAR -> !Hir::atomicOperationNeedsInteger(atomicNode.operation),
      _ -> false,
    };

    if (supported) {
      return;
    }

    let typeName: String = typeStore.nameOfResolved(atomicNode.ty, &*defStore, &*symbols);
    let message: String = `\`@${Hir::atomicBuiltinName(atomicNode.operation)}\` does not support type '${typeName.toStr()}' substituted for its type parameter`;
    let label: String = String::create("atomic builtins take an integer primitive, `boolean` or a raw pointer; arithmetic and bitwise `@atomicRmw` operations take an integer primitive");

    Borrowck::emitError(diagnostics, span, DiagnosticCode::ATOMIC_UNSUPPORTED_TYPE, message.toStr(), label.toStr());
  }

  /// Whether the node dereferences a reference by value: `*reference` copies
  /// the referent's bytes out of storage the reference does not own. A raw
  /// pointer is not a borrow, so dereferencing one is the caller's contract.
  function dereferencesReference(
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    nodeId: Hir::HirId,
  ): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    let mut innerOpt: Option<Hir::HirId> = Option::NONE;

    match (&node.kind) {
      Hir::HirKind::Dereference(inner) -> {
        innerOpt = Option::SOME(inner);
      },
      _ -> {},
    };

    let Option::SOME(innerId) = innerOpt else {
      return false;
    };

    let Option::SOME(innerNode) = hir.get(innerId) else {
      return false;
    };

    return Borrowck::isReferenceType(typeStore, innerNode.typeId);
  }

  /// Reports a move whose source is borrowed storage: a field read through a
  /// reference, a reference dereferenced by value, or a pattern binding that
  /// carries a borrow forward. Only owning values matter, because reading a
  /// `Copy` value leaves the borrow intact. Mirrors `reject_move_out_of_borrow`.
  function rejectMoveOutOfBorrow(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    nodeId: Hir::HirId,
  ): void {
    let Option::SOME(node) = hir.get(nodeId) else {
      return;
    };

    let span: SourceSpan = node.span;
    let typeId: Analyzer::TypeId = node.typeId;

    let throughReference: boolean = Borrowck::fieldBaseIsBorrowed(typeStore, hir, state, nodeId) || Borrowck::dereferencesReference(typeStore, hir, nodeId);
    let borrowedBinding: boolean = Borrowck::isBorrowedBindingNode(hir, state, nodeId);

    if (!throughReference && !borrowedBinding) {
      return;
    }

    if (!Borrowck::needsDropType(defStore, typeStore, typeId)) {
      return;
    }

    Borrowck::emitCannotMoveOutOfBorrow(state, diagnostics, Borrowck::extractRootVariable(hir, nodeId), span);
  }

  /// Rejects handing a closure read out of borrowed storage to a parameter that
  /// takes its environment over. The parameter would free an environment the
  /// referent still owns, the same move out of a borrow `rejectMoveOutOfBorrow`
  /// reports for values whose type needs a drop.
  function rejectClosureMoveOutOfBorrow(
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    nodeId: Hir::HirId,
  ): void {
    let mut results: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    Hir::collectValueResults(hir, nodeId, &mut results);

    let mut index: u64 = 0;

    while (index < results.length()) {
      if (let Option::SOME(resultId) = results.get(index)) {
        if (let Option::SOME(node) = hir.get(*resultId)) {
          let throughReference: boolean = Borrowck::fieldBaseIsBorrowed(typeStore, hir, state, *resultId) || Borrowck::isBorrowedBindingNode(hir, state, *resultId);

          if (Hir::typeIsFunction(typeStore, node.typeId) && throughReference) {
            Borrowck::emitCannotMoveOutOfBorrow(state, diagnostics, Borrowck::extractRootVariable(hir, *resultId), node.span);
          }
        }
      }

      index += 1;
    }
  }

  /// The payload types variant `variantTag` carries at `valueType`, or `NONE`
  /// when the value is not that enum. Mirrors `variant_payload_types`: the
  /// value's own enum answers, because after monomorphization the pattern still
  /// names the generic definition while the value names the specialization.
  function variantPayloadTypes(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    valueType: Analyzer::TypeId,
    enumDef: Analyzer::DefinitionId,
    variantTag: u32,
  ): Option<Vector<Analyzer::TypeId>> {
    let mut ownerOpt: Option<Analyzer::DefinitionId> = Option::NONE;

    if (let Option::SOME(typeNode) = typeStore.get(valueType)) {
      match (typeNode) {
        Analyzer::Type::Enum(defId) -> {
          ownerOpt = Option::SOME(defId);
        },
        Analyzer::Type::Instance(instance) -> {
          if (instance.definition.raw() == enumDef.raw()) {
            ownerOpt = Option::SOME(enumDef);
          }
        },
        _ -> {},
      };
    }

    let Option::SOME(owner) = ownerOpt else {
      return Option::NONE;
    };

    let mut variantOpt: Option<Analyzer::DefinitionId> = Option::NONE;

    if (let Option::SOME(definition) = defStore.get(owner)) {
      if (let Analyzer::Definition::Enum(enumDefinition) = definition) {
        if (let Option::SOME(variantId) = enumDefinition.variants.get(variantTag as u64)) {
          variantOpt = Option::SOME(*variantId);
        }
      }
    }

    let Option::SOME(variantId) = variantOpt else {
      return Option::NONE;
    };

    if (let Option::SOME(variantNode) = defStore.get(variantId)) {
      if (let Analyzer::Definition::Variant(variantDef) = variantNode) {
        let mut payload: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
        let mut index: u64 = 0;

        while (index < variantDef.payload.length()) {
          if (let Option::SOME(payloadType) = variantDef.payload.get(index)) {
            payload.push(*payloadType);
          }

          index += 1;
        }

        return Option::SOME(payload);
      }
    }

    return Option::NONE;
  }

  /// The element types of a tuple value, or `NONE` when the value is not one.
  function tupleElementTypes(
    typeStore: &mut Analyzer::TypeStore,
    valueType: Analyzer::TypeId,
  ): Option<Vector<Analyzer::TypeId>> {
    let Option::SOME(typeNode) = typeStore.get(valueType) else {
      return Option::NONE;
    };

    let Analyzer::Type::Tuple(tuple) = typeNode else {
      return Option::NONE;
    };

    let mut elements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut index: u64 = 0;

    while (index < tuple.elements.length()) {
      if (let Option::SOME(fieldType) = tuple.elements.get(index)) {
        elements.push(*fieldType);
      }

      index += 1;
    }

    return Option::SOME(elements);
  }

  /// Whether `pattern` takes an owning payload out of a value of `valueType`.
  /// Mirrors `pattern_moves_owned_value`.
  ///
  /// The answer comes from the scrutinee's payload types, never from what the
  /// bindings were declared as. `Option<&T>` hands out the pointee: the binding
  /// may well be typed as something that owns resources, but the match never
  /// owned them, and treating it as a move is what makes a later drop free
  /// storage a second time.
  function patternMovesOwnedValue(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    valueType: Analyzer::TypeId,
    pattern: &Hir::HirPattern,
  ): boolean {
    match (pattern) {
      Hir::HirPattern::Wildcard -> {},
      Hir::HirPattern::Literal(_) -> {},
      Hir::HirPattern::Constant(_) -> {},
      Hir::HirPattern::Binding(_) -> {
        // A closure payload is copyable by type, but the binding that takes it
        // owns its environment, so the scrutinee gives the payload up.
        if (Hir::typeIsFunction(typeStore, valueType)) {
          return true;
        }

        let owns: boolean = Borrowck::needsDropType(defStore, typeStore, valueType);
        let copies: boolean = Analyzer::Typecheck::isCopyType(defStore, typeStore, valueType);

        return owns && !copies;
      },
      Hir::HirPattern::Variant(variant) -> {
        let Option::SOME(payload) = Borrowck::variantPayloadTypes(
          defStore,
          typeStore,
          valueType,
          variant.enumDef,
          variant.variantTag,
        ) else {
          return false;
        };

        let mut index: u64 = 0;

        while (index < variant.args.length() && index < payload.length()) {
          let mut moves: boolean = false;

          if (let Option::SOME(argument) = variant.args.get(index)) {
            if (let Option::SOME(argumentType) = payload.get(index)) {
              moves = Borrowck::patternMovesOwnedValue(defStore, typeStore, *argumentType, argument);
            }
          }

          if (moves) {
            return true;
          }

          index += 1;
        }
      },
      Hir::HirPattern::Tuple(elements) -> {
        let Option::SOME(elementTypes) = Borrowck::tupleElementTypes(typeStore, valueType) else {
          return false;
        };

        let mut index: u64 = 0;

        while (index < elements.length() && index < elementTypes.length()) {
          let mut moves: boolean = false;

          if (let Option::SOME(element) = elements.get(index)) {
            if (let Option::SOME(elementType) = elementTypes.get(index)) {
              moves = Borrowck::patternMovesOwnedValue(defStore, typeStore, *elementType, element);
            }
          }

          if (moves) {
            return true;
          }

          index += 1;
        }
      },
      Hir::HirPattern::Or(patterns) -> {
        let mut index: u64 = 0;

        while (index < patterns.length()) {
          let mut moves: boolean = false;

          if (let Option::SOME(nested) = patterns.get(index)) {
            moves = Borrowck::patternMovesOwnedValue(defStore, typeStore, valueType, nested);
          }

          if (moves) {
            return true;
          }

          index += 1;
        }
      },
    };

    return false;
  }

  /// Whether any arm of a match takes an owning payload out of the scrutinee.
  /// Mirrors the `pattern_moves_owned_value` fold of `check_match`.
  function armsMoveScrutineePayload(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    scrutineeType: Analyzer::TypeId,
    arms: &Vector<Hir::HirMatchArm>,
  ): boolean {
    let mut index: u64 = 0;

    while (index < arms.length()) {
      let mut moves: boolean = false;

      if (let Option::SOME(arm) = arms.get(index)) {
        moves = Borrowck::patternMovesOwnedValue(defStore, typeStore, scrutineeType, &arm.pattern);
      }

      if (moves) {
        return true;
      }

      index += 1;
    }

    return false;
  }

  /// Whether these arms are the shape `lowering.rs` emits for
  /// `if (let P = value)` and `while (let P = value)`: the pattern arm yields
  /// the literal `true`, and a trailing wildcard arm yields the literal
  /// `false`. Nothing else in the language produces a match whose only two arm
  /// bodies are those two literals in that order, so an ordinary arm with a
  /// literal body is not mistaken for a condition. Mirrors
  /// `arms_are_let_condition_desugaring`.
  function armsAreLetConditionDesugaring(
    hir: &Hir::HirStore,
    arms: &Vector<Hir::HirMatchArm>
  ): boolean {
    if (arms.length() != 2) {
      return false;
    }

    let Option::SOME(patternArm) = arms.get(0) else {
      return false;
    };

    let Option::SOME(wildcardArm) = arms.get(1) else {
      return false;
    };

    if (patternArm.guard.isSome() || wildcardArm.guard.isSome()) {
      return false;
    }

    let wildcardTrailing: boolean = match (&wildcardArm.pattern) {
      Hir::HirPattern::Wildcard -> true,
      _ -> false,
    };

    if (!wildcardTrailing) {
      return false;
    }

    return Borrowck::bodyIsBooleanLiteral(hir, patternArm.body, true) && Borrowck::bodyIsBooleanLiteral(hir, wildcardArm.body, false);
  }

  function bodyIsBooleanLiteral(hir: &Hir::HirStore, body: Hir::HirId, expected: boolean): boolean {
    let Option::SOME(node) = hir.get(body) else {
      return false;
    };

    return match (&node.kind) {
      Hir::HirKind::Literal(value) -> match (value) {
        Hir::LiteralValue::Boolean(flag) -> flag == expected,
        _ -> false,
      },
      _ -> false,
    };
  }

  /// Schedules the drops a match arm owes for its own pattern bindings, keyed
  /// by the arm body so that the body's block schedule and this one stay
  /// distinct. Mirrors the `on_match_arm_end` block of `check_match`, including
  /// its two suppressions: a scrutinee that aliases storage it does not own,
  /// and bindings that borrow their payloads. The external storage suppression
  /// lifts when `armBindingsOwnPayload` is set, because the field the payload
  /// came out of is marked moved, so the base's schedule skips it and nothing
  /// else frees it.
  ///
  /// A `let`-condition match keeps its binding live in the branch the condition
  /// guards, which runs after the arm, so its drop goes to that branch rather
  /// than to the arm. An ordinary arm whose body happens to be a literal is not
  /// that shape and owes its drop here like any other.
  function recordMatchArmDrops(
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    hir: &Hir::HirStore,
    bindings: &Vector<u32>,
    matchId: Hir::HirId,
    body: Hir::HirId,
    aliasesExternalStorage: boolean,
    armBindingsOwnPayload: boolean,
    bindsBorrowedPayloads: boolean,
    scrutineeOwnsMovedPayload: boolean,
    isLetConditionMatch: boolean,
  ): void {
    if ((aliasesExternalStorage && !armBindingsOwnPayload) || bindsBorrowedPayloads) {
      return;
    }

    if (isLetConditionMatch) {
      // Only a pattern that takes an owning payload out of an owning scrutinee makes its
      // bindings owners. `Option<&T>` hands out the pointee instead: the binding names
      // storage the match never owned, and freeing it here frees it again when the real
      // owner's schedule runs.
      if (!scrutineeOwnsMovedPayload) {
        return;
      }

      let mut forward: u64 = 0;

      while (forward < bindings.length()) {
        if (let Option::SOME(defRaw) = bindings.get(forward)) {
          if (state.isMoveValid(*defRaw)) {
            let mut recordRef: &mut Borrowck::State = state;
            recordRef.recordLetConditionBinding(matchId.raw(), *defRaw);
          }
        }

        forward += 1;
      }

      return;
    }

    let mut drops: Vector<u32> = Vector::new<u32>();
    let mut position: u64 = bindings.length();

    while (position > 0) {
      position -= 1;

      if (let Option::SOME(defRaw) = bindings.get(position)) {
        if (state.isMoveValid(*defRaw)) {
          drops.push(*defRaw);
        }
      }
    }

    if (drops.isEmpty()) {
      return;
    }

    let mut scheduleRef: &mut Hir::DropSchedules = schedules;
    scheduleRef.appendMatchArmEnd(body, Borrowck::definitionIdsFromRaw(&drops));
  }

  function bodyIsLiteral(hir: &Hir::HirStore, body: Hir::HirId): boolean {
    let Option::SOME(node) = hir.get(body) else {
      return false;
    };

    return match (&node.kind) {
      Hir::HirKind::Literal(_) -> true,
      _ -> false,
    };
  }

  /// Joins the move states of several branches, reporting a local that some
  /// branch moved and another left live. Mirrors `merge_branch_states`: the
  /// join only writes back when some branch moved, so a local no branch
  /// touched keeps the state the last branch left behind.
  function mergeMoveBranches(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    branches: &Vector<Borrowck::MoveSnapshot>,
    span: SourceSpan,
  ): void {
    let mut variables: Vector<u32> = Vector::new<u32>();
    let mut branchIndex: u64 = 0;

    while (branchIndex < branches.length()) {
      if (let Option::SOME(branch) = branches.get(branchIndex)) {
        let mut entryIndex: u64 = 0;

        while (entryIndex < branch.defs.length()) {
          if (let Option::SOME(defRaw) = branch.defs.get(entryIndex)) {
            Borrowck::pushUniqueRaw(&mut variables, *defRaw);
          }

          entryIndex += 1;
        }
      }

      branchIndex += 1;
    }

    let mut variableIndex: u64 = 0;

    while (variableIndex < variables.length()) {
      let Option::SOME(defRaw) = variables.get(variableIndex) else {
        variableIndex += 1;
        continue;
      };

      let mut observed: Vector<u32> = Vector::new<u32>();
      let mut readIndex: u64 = 0;

      while (readIndex < branches.length()) {
        if (let Option::SOME(branch) = branches.get(readIndex)) {
          if (let Option::SOME(value) = Borrowck::snapshotValue(branch, *defRaw)) {
            observed.push(value);
          }
        }

        readIndex += 1;
      }

      if (observed.isEmpty()) {
        variableIndex += 1;
        continue;
      }

      let Option::SOME(firstValue) = observed.get(0) else {
        variableIndex += 1;
        continue;
      };
      let first: u32 = *firstValue;

      if (Borrowck::allValuesEqual(&observed, first)) {
        let mut sameRef: &mut Borrowck::State = state;
        sameRef.setMoveValue(*defRaw, first);
        variableIndex += 1;
        continue;
      }

      let hasMoved: boolean = Borrowck::containsRaw(&mut observed, Borrowck::MOVE_MOVED);
      let hasDropped: boolean = Borrowck::containsRaw(&mut observed, Borrowck::MOVE_DROPPED);
      let hasValid: boolean = Borrowck::containsRaw(&mut observed, Borrowck::MOVE_VALID);

      if (hasMoved && hasValid) {
        let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*defRaw);
        let name: String = Borrowck::definitionName(defStore, symbols, defId);
        let message: String = `Variable '${name}' is moved in one branch but not the other`;

        Borrowck::emitOwnershipError(
          state,
          diagnostics,
          span,
          DiagnosticCode::INCONSISTENT_MOVE_IN_BRANCHES,
          message.toStr(),
          "branches disagree on whether this value was moved",
          Option::SOME(defId),
        );
      }

      if (hasDropped && hasValid) {
        let droppedDefId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(*defRaw);
        let droppedName: String = Borrowck::definitionName(defStore, symbols, droppedDefId);
        let droppedMessage: String = `Variable '${droppedName}' is dropped in one branch but not the other`;

        Borrowck::emitOwnershipError(
          state,
          diagnostics,
          span,
          DiagnosticCode::INCONSISTENT_DROP_IN_BRANCHES,
          droppedMessage.toStr(),
          "branches disagree on whether this value was dropped",
          Option::SOME(droppedDefId),
        );
      }

      if (hasDropped) {
        let mut droppedRef: &mut Borrowck::State = state;
        droppedRef.setMoveValue(*defRaw, Borrowck::MOVE_DROPPED);
      } else if (hasMoved) {
        let mut movedRef: &mut Borrowck::State = state;
        movedRef.setMoveValue(*defRaw, Borrowck::MOVE_MOVED);
      }

      variableIndex += 1;
    }
  }

  function snapshotValue(snapshot: &Borrowck::MoveSnapshot, defRaw: u32): Option<u32> {
    let mut index: u64 = 0;

    while (index < snapshot.defs.length()) {
      if (let Option::SOME(candidate) = snapshot.defs.get(index)) {
        if (*candidate == defRaw) {
          if (let Option::SOME(value) = snapshot.values.get(index)) {
            return Option::SOME(*value);
          }
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// Overwrites `defRaw`'s value in `snapshot`, adding the entry when the
  /// snapshot never tracked it. Used by the arm-result move compensation pass
  /// in `checkMatch`, which forces a value handed to the match result to
  /// `MOVE_MOVED` in every arm's snapshot so the cross-arm merge reads a real
  /// one-sided transfer as consistent rather than an inconsistent move.
  function setSnapshotValue(snapshot: &mut Borrowck::MoveSnapshot, defRaw: u32, value: u32): void {
    let mut index: u64 = 0;

    while (index < snapshot.defs.length()) {
      if (let Option::SOME(candidate) = snapshot.defs.get(index)) {
        if (*candidate == defRaw) {
          snapshot.values.set(index, value);
          return;
        }
      }

      index += 1;
    }

    snapshot.defs.push(defRaw);
    snapshot.values.push(value);
  }

  function allValuesEqual(values: &Vector<u32>, expected: u32): boolean {
    let mut index: u64 = 0;

    while (index < values.length()) {
      if (let Option::SOME(value) = values.get(index)) {
        if (*value != expected) {
          return false;
        }
      }

      index += 1;
    }

    return true;
  }

  /// Back-edge join for a loop: every local takes the more restrictive of its
  /// pre-loop state and the state the body left behind. Mirrors
  /// `conservative_merge`, whose default for an untracked local is `Valid`.
  function conservativeMergeMoves(
    state: &mut Borrowck::State,
    preLoop: &Borrowck::MoveSnapshot,
  ): void {
    let current: Borrowck::MoveSnapshot = state.snapshotMoves();

    let mut stateRef: &mut Borrowck::State = state;
    stateRef.restoreMoves(preLoop);

    let mut index: u64 = 0;

    while (index < current.defs.length()) {
      if (let Option::SOME(defRaw) = current.defs.get(index)) {
        if (let Option::SOME(value) = current.values.get(index)) {
          let previous: u32 = match (Borrowck::snapshotValue(preLoop, *defRaw)) {
            Option::SOME(found) -> found,
            Option::NONE -> Borrowck::MOVE_VALID,
          };

          let mut mergeRef: &mut Borrowck::State = state;
          mergeRef.setMoveValue(*defRaw, Borrowck::mostRestrictiveMove(previous, *value));
        }
      }

      index += 1;
    }
  }

  // --- traversal ----------------------------------------------------------------------

  /// Walks one HIR node, updating both maps and reporting what the walk finds.
  ///
  /// Exhaustive over `HirKind` on purpose: a new variant must state whether it
  /// borrows, moves, or only recurses, instead of falling into a silent
  /// catch-all.
  function checkNode(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    nodeId: Hir::HirId,
  ): void {
    let Option::SOME(node) = hir.get(nodeId) else {
      return;
    };

    let span: SourceSpan = node.span;

    match (&node.kind) {
      Hir::HirKind::Literal(_) -> {},
      Hir::HirKind::Unit -> {},
      Hir::HirKind::Error -> {},
      Hir::HirKind::SizeOf(_) -> {},
      Hir::HirKind::AlignOf(_) -> {},
      Hir::HirKind::MaxOf(_) -> {},
      Hir::HirKind::TypeName(_) -> {},
      Hir::HirKind::MinOf(_) -> {},
      Hir::HirKind::BuiltinDropGlue(_) -> {},
      Hir::HirKind::BuiltinZeroed(_) -> {},

      Hir::HirKind::Variable(defId) -> {
        Borrowck::checkUse(defStore, typeStore, symbols, state, diagnostics, defId, span);
      },
      Hir::HirKind::StaticAccess(defId) -> {
        Borrowck::checkUse(defStore, typeStore, symbols, state, diagnostics, defId, span);
      },

      Hir::HirKind::Binary(binaryNode) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, binaryNode.left);
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, binaryNode.right);
      },
      Hir::HirKind::Unary(unaryNode) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, unaryNode.operand);
      },
      Hir::HirKind::Cast(cast) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, cast.expression);
      },
      Hir::HirKind::BitCast(cast) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, cast.expression);
      },
      Hir::HirKind::ToRawFunction(inner) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, inner);
      },
      Hir::HirKind::FromRawFunction(inner) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, inner);
      },
      Hir::HirKind::InlineAsm(asmNode) -> {
        Borrowck::checkInlineAsm(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &asmNode, span);
      },
      Hir::HirKind::TypeOf(inner) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, inner);
      },
      Hir::HirKind::Dereference(inner) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, inner);
      },
      Hir::HirKind::FieldAccess(access) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, access.base);
      },
      Hir::HirKind::Index(indexNode) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, indexNode.base);
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, indexNode.index);
      },
      Hir::HirKind::MakeSlice(makeSlice) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, makeSlice.data);
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, makeSlice.len);
      },
      Hir::HirKind::MakeRange(makeRange) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, makeRange.start);
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, makeRange.end);
      },
      Hir::HirKind::BuiltinLoad(load) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, load.ptr);
      },
      Hir::HirKind::BuiltinSplat(splatNode) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, splatNode.value);
      },
      Hir::HirKind::BuiltinDropInPlace(dropNode) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, dropNode.ptr);
      },
      Hir::HirKind::BuiltinAtomic(atomicNode) -> {
        let mut operandIndex: u64 = 0;

        while (operandIndex < atomicNode.operands.length()) {
          if (let Option::SOME(operand) = atomicNode.operands.get(operandIndex)) {
            Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, *operand);
          }

          operandIndex += 1;
        }

        Borrowck::rejectUnsupportedAtomic(defStore, typeStore, symbols, diagnostics, &atomicNode, span);
      },
      Hir::HirKind::BuiltinStore(storeNode) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, storeNode.ptr);
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, storeNode.value);
      },
      Hir::HirKind::BuiltinHash(hashNode) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, hashNode.value);
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, hashNode.hasher);
      },
      Hir::HirKind::BuiltinEq(eqNode) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, eqNode.left);
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, eqNode.right);
        Borrowck::rejectUnsupportedEquality(defStore, typeStore, symbols, diagnostics, &eqNode, span);
      },
      // Also the shape a discard takes: `let _ = value;` lowers to the
      // expression statement `value;`, so it declares no owned binding, owes no
      // scheduled drop and moves nothing out of a place it read. LIR lowering
      // drops the value the statement produced at the end of that statement.
      Hir::HirKind::ExpressionStatement(expression) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, expression);
      },

      Hir::HirKind::VectorLiteral(elements) -> {
        Borrowck::checkMovingOperands(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &elements, span);
      },
      Hir::HirKind::TupleLiteral(elements) -> {
        Borrowck::checkMovingOperands(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &elements, span);
      },
      Hir::HirKind::EnumVariant(variant) -> {
        Borrowck::checkMovingOperands(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &variant.payload, span);
      },
      Hir::HirKind::RecordInit(init) -> {
        let mut index: u64 = 0;

        while (index < init.fields.length()) {
          if (let Option::SOME(field) = init.fields.get(index)) {
            Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, field.value);
            Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, field.value);
            Borrowck::rejectClosureMoveOutOfBorrow(typeStore, hir, state, diagnostics, field.value);

            if (let Option::SOME(source) = Borrowck::movedValue(defStore, typeStore, hir, state, field.value)) {
              Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_AGGREGATE);
            }
          }

          index += 1;
        }
      },

      Hir::HirKind::Reference(reference) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, reference.expression);
        Borrowck::rejectThreadLocalBorrow(defStore, typeStore, symbols, hir, diagnostics, reference.expression, span, "a reference");

        if (let Option::SOME(target) = Borrowck::extractRootVariable(hir, reference.expression)) {
          let granted: boolean = Borrowck::tryBorrow(defStore, symbols, state, diagnostics, target, reference.mutable, span, true);

          if (state.inDefer) {
            let mut heldRef: &mut Borrowck::State = state;
            heldRef.recordHeldBorrow(target.raw(), reference.mutable, granted);
          } else {
            if (granted) {
              Borrowck::noteBorrow(state, target.raw(), reference.mutable, false, span);
            }

            let mut releaseRef: &mut Borrowck::State = state;
            releaseRef.releaseBorrow(target.raw(), reference.mutable);
          }
        }
      },

      Hir::HirKind::Call(call) -> {
        let callParams: Vector<Analyzer::DefinitionId> = Borrowck::callParamsOrEmpty(defStore, call.callee);
        Borrowck::checkCallArguments(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &call.args, &callParams, 0, span);
      },
      Hir::HirKind::CallClosure(call) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, call.callee);

        let noParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
        Borrowck::checkCallArguments(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &call.args, &noParams, 0, span);
      },
      // The body is checked on its own as the thunk function, so walking into it
      // here would check it twice against the wrong scope. Mirrors the reference
      // borrow checker's empty `Closure` arm; the ownership oracle still
      // consumes what the environment takes by value.
      Hir::HirKind::Closure(closure) -> {
        Borrowck::checkClosureCaptures(defStore, typeStore, state, diagnostics, schedules, &closure.captures, span);
      },
      Hir::HirKind::MethodCall(call) -> {
        Borrowck::checkMethodCall(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &call, span);
      },

      Hir::HirKind::Let(letNode) -> {
        Borrowck::checkLet(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &letNode, span);
      },
      Hir::HirKind::Assign(assign) -> {
        Borrowck::checkAssign(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &assign, nodeId, span);
      },
      Hir::HirKind::Block(block) -> {
        Borrowck::checkBlock(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &block, nodeId);
      },
      Hir::HirKind::If(ifNode) -> {
        Borrowck::checkIf(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &ifNode, nodeId, span);
      },
      Hir::HirKind::LetElse(letElse) -> {
        Borrowck::checkLetElse(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &letElse, span);
      },
      Hir::HirKind::Loop(loopNode) -> {
        Borrowck::checkLoop(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &loopNode);
      },
      Hir::HirKind::Match(matchNode) -> {
        Borrowck::checkMatch(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &matchNode, nodeId, span);
      },

      Hir::HirKind::Return(value) -> {
        if (let Option::SOME(returned) = value) {
          Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, returned);

          if (let Option::SOME(returnType) = Borrowck::callableReturnType(defStore, state.currentFunctionId())) {
            Borrowck::rejectThreadLocalSlice(defStore, typeStore, symbols, hir, diagnostics, returned, returnType);
          }

          if (let Option::SOME(source) = Borrowck::movedValue(defStore, typeStore, hir, state, returned)) {
            if (!state.isEnvironmentCapture(source.raw())) {
              Borrowck::noteMove(state, source, Borrowck::OwnershipReport::CONSUMER_RETURN, span);

              let mut returnRef: &mut Borrowck::State = state;
              returnRef.setMoveValue(source.raw(), Borrowck::MOVE_RETURNED);
            }
          }

          // Returning a closure value hands its environment to the caller,
          // whether the returned binding is the one that owns it, an alias of
          // it, or a record or other aggregate carrying it out. The owner's
          // drop is cancelled, or the caller would receive a freed
          // environment.
          let mut closureEnvOwners: Vector<u32> = Vector::new<u32>();
          Borrowck::collectClosureEnvOwners(hir, state, returned, &mut closureEnvOwners);

          let mut ownerIndex: u64 = 0;

          while (ownerIndex < closureEnvOwners.length()) {
            if (let Option::SOME(owner) = closureEnvOwners.get(ownerIndex)) {
              let mut closureRef: &mut Borrowck::State = state;
              closureRef.setMoveValue(*owner, Borrowck::MOVE_RETURNED);
            }

            ownerIndex += 1;
          }

          Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, returned);
          Borrowck::rejectClosureMoveOutOfBorrow(typeStore, hir, state, diagnostics, returned);
          Borrowck::rejectReturnedView(defStore, typeStore, symbols, hir, state, diagnostics, returned, span);
        }

        // A return unwinds every open scope back to the function root, so it
        // owes the drops of all of them. Mirrors `check_return`.
        let returnKey: Hir::ExitKey = Hir::ExitKey::Return(nodeId);
        Borrowck::recordExitSchedule(state, schedules, &returnKey, 0);

        let mut stateRef: &mut Borrowck::State = state;
        stateRef.setReachable(false);
      },
      Hir::HirKind::Break -> {
        Borrowck::recordLoopExitSchedule(state, schedules, Hir::ExitKey::Break(nodeId), true);

        let mut stateRef: &mut Borrowck::State = state;
        stateRef.setReachable(false);
      },
      Hir::HirKind::Continue -> {
        Borrowck::recordLoopExitSchedule(state, schedules, Hir::ExitKey::Continue(nodeId), false);

        let mut stateRef: &mut Borrowck::State = state;
        stateRef.markContinue();
        stateRef.setReachable(false);
      },
      Hir::HirKind::Panic(message) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, message);

        let mut stateRef: &mut Borrowck::State = state;
        stateRef.setReachable(false);
      },
      Hir::HirKind::Trap -> {
        let mut stateRef: &mut Borrowck::State = state;
        stateRef.setReachable(false);
      },
      Hir::HirKind::BuiltinUnreachable -> {
        let mut stateRef: &mut Borrowck::State = state;
        stateRef.setReachable(false);
      },

      Hir::HirKind::Defer(body) -> {
        let saved: boolean = state.inDefer;

        let mut enterRef: &mut Borrowck::State = state;
        enterRef.pushDeferBody(body.raw());
        enterRef.setInDefer(true);

        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, body);

        let mut leaveRef: &mut Borrowck::State = state;
        leaveRef.setInDefer(saved);
      },
    };
  }

  /// Consumes what a closure environment takes by value. Mirrors the
  /// ownership oracle's `Closure` arm: a by-value capture of an owning local
  /// moves it into the environment, and a binding that lives in borrowed
  /// storage cannot be moved there any more than it can be moved into a `let`.
  function checkClosureCaptures(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    captures: &Vector<Hir::HirCapture>,
    span: SourceSpan,
  ): void {
    let mut index: u64 = 0;

    while (index < captures.length()) {
      if (let Option::SOME(capture) = captures.get(index)) {
        if (Borrowck::captureIsByValue(&capture.mode)) {
          if (Borrowck::definitionNeedsDrop(defStore, typeStore, capture.sourceDef)) {
            if (state.isBorrowedBinding(capture.sourceDef.raw())) {
              Borrowck::emitCannotMoveOutOfBorrow(state, diagnostics, Option::SOME(capture.sourceDef), span);
            }

            Borrowck::tryConsume(state, schedules, capture.sourceDef, span, Borrowck::OwnershipReport::CONSUMER_CLOSURE_CAPTURE);
          }
        }
      }

      index += 1;
    }
  }

  function captureIsByValue(mode: &Hir::CaptureMode): boolean {
    return match (mode) {
      Hir::CaptureMode::ByValue -> true,
      Hir::CaptureMode::ByRef -> false,
      Hir::CaptureMode::ByMutRef -> false,
    };
  }

  function captureIsByMutRef(mode: &Hir::CaptureMode): boolean {
    return match (mode) {
      Hir::CaptureMode::ByValue -> false,
      Hir::CaptureMode::ByRef -> false,
      Hir::CaptureMode::ByMutRef -> true,
    };
  }

  /// Walks a method call. A `.drop()` on a `Drop` type is the manual teardown
  /// of its receiver rather than an ordinary call: the ownership oracle routes
  /// the receiver through `handle_manual_drop` and consumes no argument.
  ///
  /// The receiver of such a call is not walked as a use, because
  /// `handleManualDrop` reports its invalid states itself and walking it would
  /// report the same local twice. Its borrow is still taken and released, which
  /// is what the borrow oracle does for every receiver including this one.
  function checkMethodCall(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    call: &Hir::HirMethodCall,
    span: SourceSpan,
  ): void {
    let mut isDrop: boolean = false;

    if (let Option::SOME(receiver) = call.receiver) {
      isDrop = Borrowck::isDropMethod(defStore, symbols, call.method);

      let mut droppedTarget: Option<Analyzer::DefinitionId> = Option::NONE;

      if (isDrop) {
        droppedTarget = Borrowck::extractReceiverVariable(hir, receiver);
      }

      if (let Option::SOME(target) = droppedTarget) {
        Borrowck::handleManualDrop(defStore, typeStore, symbols, state, diagnostics, target, span);
      } else {
        if (isDrop && !(state.inDropMethod && Borrowck::isFieldDropOnVariable(hir, receiver))) {
          Borrowck::emitOwnershipWarning(
            state,
            diagnostics,
            span,
            DiagnosticCode::DROP_ON_COMPLEX_RECEIVER,
            ".drop() on complex receiver is not tracked at compile time; relies on runtime guard",
            "no compile-time state follows this receiver",
            Borrowck::extractRootVariable(hir, receiver),
          );
        }

        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, receiver);

        if (Borrowck::methodSelfByValue(defStore, call.method)) {
          Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, receiver);

          if (let Option::SOME(source) = Borrowck::movedVariable(defStore, typeStore, hir, receiver)) {
            Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_METHOD_RECEIVER);
          }
        }
      }

      if (!Borrowck::methodSelfByValue(defStore, call.method) && !Borrowck::isReferenceNode(hir, receiver)) {
        Borrowck::rejectThreadLocalBorrow(defStore, typeStore, symbols, hir, diagnostics, receiver, span, "a method call that borrows its receiver");
      }

      Borrowck::checkReceiverBorrow(defStore, symbols, hir, state, diagnostics, receiver, call.method, span);
    }

    if (isDrop) {
      Borrowck::checkDropArguments(defStore, typeStore, symbols, hir, state, diagnostics, schedules, &call.args, span);
      return;
    }

    let methodParams: Vector<Analyzer::DefinitionId> = Borrowck::callParamsOrEmpty(defStore, call.method);
    let mut paramOffset: u64 = 0;

    // `self` occupies the first parameter slot of an instance method.
    if (call.receiver.isSome()) {
      paramOffset = 1;
    }

    Borrowck::checkCallArguments(
      defStore,
      typeStore,
      symbols,
      hir,
      state,
      diagnostics,
      schedules,
      &call.args,
      &methodParams,
      paramOffset,
      span,
    );
  }

  /// Walks the arguments of a manual `.drop()`: checked and borrow-checked like
  /// any other call, but never consumed, because the call takes ownership of
  /// nothing beyond the receiver it tears down.
  function checkDropArguments(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    args: &Vector<Hir::HirId>,
    span: SourceSpan,
  ): void {
    let mut index: u64 = 0;

    while (index < args.length()) {
      if (let Option::SOME(argument) = args.get(index)) {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, *argument);
        Borrowck::checkTemporaryBorrow(defStore, symbols, hir, state, diagnostics, *argument, span);
      }

      index += 1;
    }
  }

  /// Walks operands that a composite value takes ownership of: vector and
  /// tuple elements, and enum variant payloads.
  function checkMovingOperands(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    operands: &Vector<Hir::HirId>,
    span: SourceSpan,
  ): void {
    let mut index: u64 = 0;

    while (index < operands.length()) {
      if (let Option::SOME(operand) = operands.get(index)) {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, *operand);
        Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, *operand);
        Borrowck::rejectClosureMoveOutOfBorrow(typeStore, hir, state, diagnostics, *operand);

        if (let Option::SOME(source) = Borrowck::movedValue(defStore, typeStore, hir, state, *operand)) {
          Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_AGGREGATE);
        }
      }

      index += 1;
    }
  }

  /// Walks call arguments: each one is checked, its transient borrow is
  /// conflict-checked and released, and an argument passed by value out of an
  /// owning local consumes it.
  ///
  /// `params` are the callee's parameters when it is known, the argument at
  /// `index` matching the parameter at `index + paramOffset`. A closure handed to a `@noescape` parameter is only lent for the
  /// call, so it does not move its owner; every other closure parameter takes
  /// the environment over.
  function checkCallArguments(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    args: &Vector<Hir::HirId>,
    params: &Vector<Analyzer::DefinitionId>,
    paramOffset: u64,
    span: SourceSpan,
  ): void {
    let mut index: u64 = 0;

    while (index < args.length()) {
      if (let Option::SOME(argument) = args.get(index)) {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, *argument);
        Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, *argument);
        Borrowck::checkTemporaryBorrow(defStore, symbols, hir, state, diagnostics, *argument, span);

        if (let Option::SOME(paramId) = params.get(index + paramOffset)) {
          if (let Option::SOME(paramType) = Borrowck::variableTypeOf(defStore, *paramId)) {
            Borrowck::rejectThreadLocalSlice(defStore, typeStore, symbols, hir, diagnostics, *argument, paramType);
          }
        }

        if (let Option::SOME(source) = Borrowck::movedVariable(defStore, typeStore, hir, *argument)) {
          Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_CALL_ARGUMENT);
        } else if (!Borrowck::paramIsNoEscape(defStore, params, index + paramOffset)) {
          if (let Option::SOME(owner) = Borrowck::movedClosureOwner(hir, state, *argument)) {
            Borrowck::tryConsume(state, schedules, owner, span, Borrowck::OwnershipReport::CONSUMER_CALL_ARGUMENT);
          } else {
            Borrowck::rejectClosureMoveOutOfBorrow(typeStore, hir, state, diagnostics, *argument);
          }
        }
      }

      index += 1;
    }
  }

  /// The parameters of `callable`, or none when it is not a function or method.
  function callParamsOrEmpty(
    defStore: &mut Analyzer::DefinitionStore,
    callable: Analyzer::DefinitionId,
  ): Vector<Analyzer::DefinitionId> {
    return match (Borrowck::callableParams(defStore, callable)) {
      Option::SOME(params) -> params,
      Option::NONE -> Vector::new<Analyzer::DefinitionId>(),
    };
  }

  /// Whether the parameter at `index` carries `@noescape`.
  function paramIsNoEscape(
    defStore: &mut Analyzer::DefinitionStore,
    params: &Vector<Analyzer::DefinitionId>,
    index: u64,
  ): boolean {
    let Option::SOME(paramId) = params.get(index) else {
      return false;
    };

    let Option::SOME(definition) = defStore.get(*paramId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Variable(variableDef) -> variableDef.noEscape,
      _ -> false,
    };
  }

  /// Conflict-checks the borrow an argument spelled `&x` / `&mut x` takes for
  /// the duration of the call, then releases it. Mirrors
  /// `check_temporary_borrow`, including its deferred-body exception.
  function checkTemporaryBorrow(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    argument: Hir::HirId,
    span: SourceSpan,
  ): void {
    let Option::SOME(reference) = Borrowck::referenceParts(hir, argument) else {
      return;
    };

    let Option::SOME(target) = Borrowck::extractRootVariable(hir, reference.expression) else {
      return;
    };

    let granted: boolean = Borrowck::tryBorrow(defStore, symbols, state, diagnostics, target, reference.mutable, span, false);

    if (state.inDefer) {
      let mut heldRef: &mut Borrowck::State = state;
      heldRef.recordUnreportedHeldBorrow(target.raw(), reference.mutable, granted);
      return;
    }

    let mut releaseRef: &mut Borrowck::State = state;
    releaseRef.releaseBorrow(target.raw(), reference.mutable);
  }

  /// Conflict-checks the borrow a method call takes of its receiver, mutable
  /// exactly when the method binds `&mut self`. Mirrors
  /// `check_temporary_receiver_borrow`.
  function checkReceiverBorrow(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    receiver: Hir::HirId,
    method: Analyzer::DefinitionId,
    span: SourceSpan,
  ): void {
    let Option::SOME(target) = Borrowck::extractRootVariable(hir, receiver) else {
      return;
    };

    let mutable: boolean = Borrowck::methodSelfMutable(defStore, method);

    let granted: boolean = Borrowck::tryBorrow(defStore, symbols, state, diagnostics, target, mutable, span, true);

    if (granted) {
      Borrowck::noteBorrow(state, target.raw(), mutable, false, span);
    }

    let mut releaseRef: &mut Borrowck::State = state;
    releaseRef.releaseBorrow(target.raw(), mutable);
  }

  function checkLet(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    letNode: &Hir::HirLet,
    span: SourceSpan,
  ): void {
    if (let Option::SOME(value) = letNode.value) {
      Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, value);

      if (let Option::SOME(declaredType) = Borrowck::variableTypeOf(defStore, letNode.name)) {
        Borrowck::rejectThreadLocalSlice(defStore, typeStore, symbols, hir, diagnostics, value, declaredType);
      }

      if (let Option::SOME(source) = Borrowck::movedValue(defStore, typeStore, hir, state, value)) {
        Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_LET_INITIALIZER);
      }

      Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, value);
      Borrowck::rejectClosureMoveOutOfBorrow(typeStore, hir, state, diagnostics, value);

      let mut holderRef: &mut Borrowck::State = state;
      holderRef.setCurrentHolder(letNode.name.raw());
      Borrowck::recordLetBorrow(defStore, symbols, hir, state, diagnostics, value, span);
      Borrowck::recordClosureCaptureBorrows(defStore, symbols, hir, state, diagnostics, value, span);

      let mut clearHolderRef: &mut Borrowck::State = state;
      clearHolderRef.setCurrentHolder(Borrowck::NO_HOLDER);
    }

    let depth: u64 = state.scopeDepth();

    let mut depthRef: &mut Borrowck::State = state;
    depthRef.recordLocalDepth(letNode.name.raw(), depth);

    if (let Option::SOME(value) = letNode.value) {
      let mut holderRef: &mut Borrowck::State = state;
      holderRef.setCurrentHolder(letNode.name.raw());

      Borrowck::recordKeptView(defStore, typeStore, symbols, hir, state, diagnostics, letNode.name, Option::SOME(depth), value, letNode.forOfIterable, span);

      let mut clearHolderRef: &mut Borrowck::State = state;
      clearHolderRef.setCurrentHolder(Borrowck::NO_HOLDER);
    }

    // A closure local owns its environment even when its type needs no drop of
    // its own, and LIR lowering tears that environment down from the same drop
    // schedule. Mirrors the `binding_owns_closure_env` disjunct of the
    // oracle's `Let` arm: the initializer may be a closure literal, or a call
    // whose result type is a function (escape analysis marks every closure
    // that can reach a return as escaping, so the binding is always the one
    // responsible for releasing it).
    let mut ownsClosureEnv: boolean = false;
    let mut moveOnly: boolean = false;

    if (let Option::SOME(value) = letNode.value) {
      if (let Option::SOME(valueType) = Borrowck::variableTypeOf(defStore, letNode.name)) {
        ownsClosureEnv = Hir::bindingOwnsClosureEnv(hir, value, valueType, typeStore, defStore);
        let copyable: boolean = Hir::valueIsOnlyClosureLiterals(hir, value, typeStore) && Hir::valueClosureLiteralsDropNothing(hir, value);
        moveOnly = ownsClosureEnv && !copyable;
      }

      // A move-only owner or a closure field handed over here, directly or as
      // the result of a branch, gives this binding its environment.
      if (!ownsClosureEnv && Borrowck::valueTakesClosureOwners(hir, state, typeStore, value)) {
        ownsClosureEnv = true;
        moveOnly = true;
      }
    }

    let assignedClosureEnv: boolean = state.isAssignedClosureEnv(letNode.name.raw());

    // Whether the initializer describes the environment this binding ends up
    // holding: it has to have established ownership, and no assignment may be
    // about to hand the binding a different environment. Read by the report
    // only; the ownership decision below is unaffected.
    let initializerOwns: boolean = ownsClosureEnv && !assignedClosureEnv;

    // A later `f = <closure>` hands this binding an environment too, and the
    // drop belongs in the scope the binding lives in rather than wherever the
    // assignment happens to sit, so the decision is made here.
    if (assignedClosureEnv) {
      ownsClosureEnv = true;
      moveOnly = true;
    }

    // A closure value moved into an escaping closure's environment leaves this
    // frame with it, so this binding no longer owns the environment and must
    // not free it. Nothing frees it instead; see the field's comment.
    if (state.envIsCapturedByEscapingClosure(letNode.name.raw())) {
      ownsClosureEnv = false;
    }

    if (ownsClosureEnv) {
      Borrowck::noteClosureEnv(hir, state, letNode.name.raw(), letNode.name.raw(), letNode.value, initializerOwns, span);

      let mut ownerRef: &mut Borrowck::State = state;
      ownerRef.recordClosureEnvOwner(letNode.name.raw(), letNode.name.raw());

      if (moveOnly) {
        ownerRef.markMoveOnlyClosureOwner(letNode.name.raw());
      }
    } else {
      if (let Option::SOME(value) = letNode.value) {
        if (let Option::SOME(owner) = Borrowck::closureEnvOwner(hir, state, value)) {
          Borrowck::noteClosureEnv(hir, state, letNode.name.raw(), owner, letNode.value, false, span);

          let mut aliasRef: &mut Borrowck::State = state;
          aliasRef.recordClosureEnvOwner(letNode.name.raw(), owner);
        }
      }
    }

    if (ownsClosureEnv || Borrowck::definitionNeedsDrop(defStore, typeStore, letNode.name)) {
      Borrowck::declareOwned(state, letNode.name);
    }
  }

  /// Whether every value `value` can evaluate to is a closure literal, a
  /// move-only closure owner or a closure field, with at least one owner or
  /// field among them. Each owner is moved into the result on its own path
  /// (see `consumeBranchResultOwner`) and each field is moved out of its
  /// record, so the binding that receives the result owns whichever
  /// environment arrives.
  function valueTakesClosureOwners(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    typeStore: &mut Analyzer::TypeStore,
    value: Hir::HirId,
  ): boolean {
    let mut results: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    Hir::collectValueResults(hir, value, &mut results);

    let mut ownerCount: u64 = 0;
    let mut index: u64 = 0;

    while (index < results.length()) {
      if (let Option::SOME(resultId) = results.get(index)) {
        let Option::SOME(resultNode) = hir.get(*resultId) else {
          return false;
        };

        let isLiteral: boolean = match (&resultNode.kind) {
          Hir::HirKind::Closure(_) -> true,
          _ -> false,
        };

        let isClosureField: boolean = Borrowck::isFieldAccessNode(hir, *resultId) && Hir::typeIsFunction(typeStore, resultNode.typeId);

        if (isClosureField || Borrowck::movedClosureOwner(hir, state, *resultId).isSome()) {
          ownerCount += 1;
        } else if (!isLiteral && !Hir::typeIsNever(typeStore, resultNode.typeId)) {
          return false;
        }
      }

      index += 1;
    }

    return ownerCount > 0;
  }

  /// The binding that owns the heap closure environment `nodeId` evaluates to,
  /// when it is a variable naming one. Mirrors `closure_env_owner`.
  function closureEnvOwner(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId,
  ): Option<u32> {
    let Option::SOME(node) = hir.get(nodeId) else {
      return Option::NONE;
    };

    if (let Hir::HirKind::Variable(defId) = &node.kind) {
      return state.closureEnvOwnerOf(defId.raw());
    }

    return Option::NONE;
  }

  /// Every binding whose heap closure environment leaves the frame inside
  /// `nodeId`, following the same shapes escape analysis treats as result
  /// position: branches and match arms, and aggregates built in place.
  ///
  /// A closure stored into a record that is then returned leaves with that
  /// record, so the binding that built it must not free it on the way out.
  /// Mirrors `collect_closure_env_owners`.
  function collectClosureEnvOwners(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId,
    owners: &mut Vector<u32>,
  ): void {
    if (let Option::SOME(owner) = Borrowck::closureEnvOwner(hir, state, nodeId)) {
      let mut ownersRef: &mut Vector<u32> = owners;
      ownersRef.push(owner);
      return;
    }

    let Option::SOME(node) = hir.get(nodeId) else {
      return;
    };

    match (&node.kind) {
      Hir::HirKind::Block(blockNode) -> {
        if (let Option::SOME(tailId) = blockNode.expression) {
          Borrowck::collectClosureEnvOwners(hir, state, tailId, owners);
        }
      },
      Hir::HirKind::If(ifNode) -> {
        Borrowck::collectClosureEnvOwners(hir, state, ifNode.thenBranch, owners);

        if (let Option::SOME(elseId) = ifNode.elseBranch) {
          Borrowck::collectClosureEnvOwners(hir, state, elseId, owners);
        }
      },
      Hir::HirKind::Match(matchNode) -> {
        let mut armIndex: u64 = 0;

        while (armIndex < matchNode.arms.length()) {
          if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
            Borrowck::collectClosureEnvOwners(hir, state, arm.body, owners);
          }

          armIndex += 1;
        }
      },
      Hir::HirKind::RecordInit(recordNode) -> {
        let mut fieldIndex: u64 = 0;

        while (fieldIndex < recordNode.fields.length()) {
          if (let Option::SOME(field) = recordNode.fields.get(fieldIndex)) {
            Borrowck::collectClosureEnvOwners(hir, state, field.value, owners);
          }

          fieldIndex += 1;
        }
      },
      Hir::HirKind::EnumVariant(variantNode) -> {
        Borrowck::collectClosureEnvOwnersList(hir, state, &variantNode.payload, owners);
      },
      Hir::HirKind::VectorLiteral(elements) -> {
        Borrowck::collectClosureEnvOwnersList(hir, state, &elements, owners);
      },
      Hir::HirKind::TupleLiteral(elements) -> {
        Borrowck::collectClosureEnvOwnersList(hir, state, &elements, owners);
      },
      _ -> {},
    };
  }

  /// Calls `collectClosureEnvOwners` on every id in `ids`.
  function collectClosureEnvOwnersList(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    ids: &Vector<Hir::HirId>,
    owners: &mut Vector<u32>,
  ): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        Borrowck::collectClosureEnvOwners(hir, state, *id, owners);
      }

      index += 1;
    }
  }

  /// A binding initialized with a reference expression keeps that borrow alive
  /// until its scope exits. Mirrors `try_record_let_borrow`.
  function recordLetBorrow(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    value: Hir::HirId,
    span: SourceSpan,
  ): void {
    let Option::SOME(reference) = Borrowck::referenceParts(hir, value) else {
      return;
    };

    let Option::SOME(target) = Borrowck::extractRootVariable(hir, reference.expression) else {
      return;
    };

    let granted: boolean = Borrowck::tryBorrow(defStore, symbols, state, diagnostics, target, reference.mutable, span, true);

    let mut stateRef: &mut Borrowck::State = state;
    stateRef.recordHeldBorrow(target.raw(), reference.mutable, granted);
  }

  /// A binding holding a closure keeps a mutable borrow of every variable the
  /// closure captured by mutable reference, for as long as the binding lives.
  /// Mirrors `try_record_closure_capture_borrows`.
  ///
  /// `ByRef` captures are excluded: the closure only reads through a pointer at
  /// call time, which is allowed to observe later writes to the original.
  function recordClosureCaptureBorrows(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    value: Hir::HirId,
    span: SourceSpan,
  ): void {
    let Option::SOME(node) = hir.get(value) else {
      return;
    };

    match (&node.kind) {
      Hir::HirKind::Closure(closure) -> {
        Borrowck::recordCaptureBorrows(defStore, symbols, state, diagnostics, &closure.captures, span);
      },
      _ -> {},
    };
  }

  function recordCaptureBorrows(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    captures: &Vector<Hir::HirCapture>,
    span: SourceSpan,
  ): void {
    let mut index: u64 = 0;

    while (index < captures.length()) {
      if (let Option::SOME(capture) = captures.get(index)) {
        if (Borrowck::captureIsByMutRef(&capture.mode)) {
          let granted: boolean = Borrowck::tryBorrow(defStore, symbols, state, diagnostics, capture.sourceDef, true, span, true);

          let mut stateRef: &mut Borrowck::State = state;
          stateRef.recordHeldBorrow(capture.sourceDef.raw(), true, granted);
        }
      }

      index += 1;
    }
  }

  /// Assignment: the value is walked first, the target is reported when it is
  /// borrowed, and assigning into a moved local revives it. The target place
  /// itself is not walked as a use, mirroring the ownership oracle, which
  /// would otherwise report a write to a moved local as a read of it.
  /// Checks an `asm`. Every input is read. An `inout` or `mem` input hands
  /// the asm its place to write, and a statement `asm` writes its outputs
  /// into their locals, so none of those places may be borrowed. The output
  /// locals hold integers and pointers, which need no drop, so writing them
  /// is all their initialization takes.
  function checkInlineAsm(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    asmNode: &Hir::HirInlineAsm,
    span: SourceSpan,
  ): void {
    let mut index: u64 = 0;

    while (index < asmNode.inputs.length()) {
      if (let Option::SOME(input) = asmNode.inputs.get(index)) {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, input.value);

        if (input.isPlace) {
          Borrowck::rejectWriteWhileBorrowed(defStore, symbols, hir, state, diagnostics, input.value, span);
        }
      }

      index += 1;
    }

    index = 0;

    while (index < asmNode.outputs.length()) {
      if (let Option::SOME(output) = asmNode.outputs.get(index)) {
        if (let Option::SOME(place) = output.place) {
          Borrowck::rejectWriteWhileBorrowed(defStore, symbols, hir, state, diagnostics, place, span);
        }
      }

      index += 1;
    }
  }

  /// Reports a write to a place rooted at a borrowed local, the way an
  /// assignment does.
  function rejectWriteWhileBorrowed(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    placeId: Hir::HirId,
    span: SourceSpan,
  ): void {
    let Option::SOME(target) = Borrowck::extractRootVariable(hir, placeId) else {
      return;
    };

    if (state.borrowValue(target.raw()) == Borrowck::BORROW_NONE) {
      return;
    }

    let name: String = Borrowck::definitionName(defStore, symbols, target);
    let message: String = `Cannot assign to '${name}' because it is borrowed`;

    Borrowck::emitOwnershipError(
      state,
      diagnostics,
      span,
      DiagnosticCode::MUTATED_WHILE_BORROWED,
      message.toStr(),
      "the asm writes it while a borrow is live",
      Option::SOME(target),
    );
  }

  function checkAssign(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    assign: &Hir::HirAssign,
    nodeId: Hir::HirId,
    span: SourceSpan,
  ): void {
    Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, assign.value);

    if (let Option::SOME(target) = Borrowck::extractRootVariable(hir, assign.target)) {
      if (state.borrowValue(target.raw()) != Borrowck::BORROW_NONE) {
        let name: String = Borrowck::definitionName(defStore, symbols, target);
        let message: String = `Cannot assign to '${name}' because it is borrowed`;

        Borrowck::emitOwnershipError(
          state,
          diagnostics,
          span,
          DiagnosticCode::MUTATED_WHILE_BORROWED,
          message.toStr(),
          "assignment happens while a borrow is live",
          Option::SOME(target),
        );
      }
    }

    // Ownership, unlike borrowing, follows no place chain into the target: only
    // a bare local names a value this assignment replaces. `holder.entry = 5`
    // overwrites one field, so scheduling a drop of `holder` there would tear
    // down the whole record — a double free once `holder` is moved, and a drop
    // of live fields even when it is not. Mirrors `get_assign_target_def`,
    // which answers for a `Variable` target and nothing else; dropping the old
    // field value is not scheduled by either compiler.
    if (let Option::SOME(target) = Borrowck::variableOf(hir, assign.target)) {
      // A binding that owns a closure environment counts even though its type
      // needs no drop of its own: overwriting it drops the last reference to
      // that environment, and nothing would free it afterwards. Mirrors the
      // `owns_closure_env` disjunct of the oracle's `check_assign`.
      let mut ownsClosureEnv: boolean = false;

      if (let Option::SOME(owner) = state.closureEnvOwnerOf(target.raw())) {
        ownsClosureEnv = owner == target.raw();
      }

      if (ownsClosureEnv || Borrowck::definitionNeedsDrop(defStore, typeStore, target)) {
        // Overwriting a local that still holds a value leaks it unless the old
        // value is dropped first. Mirrors the `on_overwrite` arm of
        // `check_assign`, which reads the state before the revival below.
        if (state.isMoveValid(target.raw())) {
          let mut overwriteRef: &mut Hir::DropSchedules = schedules;
          overwriteRef.appendOverwrite(nodeId, target);
        }

        // Re-initialization revives a moved or manually dropped local, and
        // the overwrite drop above was already skipped for both, because
        // neither still holds a value. Mirrors `check_assign`.
        if (let Option::SOME(value) = state.moveValue(target.raw())) {
          if (value == Borrowck::MOVE_MOVED || value == Borrowck::MOVE_DROPPED) {
            let mut reviveRef: &mut Borrowck::State = state;
            reviveRef.setMoveValue(target.raw(), Borrowck::MOVE_VALID);
          }
        }
      }
    }

    Borrowck::scheduleFieldOverwriteDrop(defStore, typeStore, hir, state, schedules, assign.target, nodeId);

    Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, assign.value);

    if (let Option::SOME(source) = Borrowck::movedValue(defStore, typeStore, hir, state, assign.value)) {
      Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_ASSIGNMENT);
    }

    Borrowck::rejectClosureMoveOutOfBorrow(typeStore, hir, state, diagnostics, assign.value);

    if (let Option::SOME(target) = Borrowck::variableOf(hir, assign.target)) {
      let targetDepth: Option<u64> = state.localDepth(target.raw());
      Borrowck::recordKeptView(defStore, typeStore, symbols, hir, state, diagnostics, target, targetDepth, assign.value, false, span);
    } else {
      Borrowck::checkPlaceAssignedView(defStore, typeStore, symbols, hir, state, diagnostics, assign.target, assign.value, span);
    }
  }

  function checkBlock(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    block: &Hir::HirBlock,
    blockId: Hir::HirId,
  ): void {
    let empty: Vector<u32> = Vector::new<u32>();

    Borrowck::checkBlockOwning(defStore, typeStore, symbols, hir, state, diagnostics, schedules, block, blockId, &empty);
  }

  /// Checks a block that additionally owns `extraOwned`, locals declared
  /// outside it. The branch a `let` condition guards is the scope of that
  /// condition's bindings: they hold a value only on the path that reaches the
  /// branch and leave scope when it ends. Declaring them here gives them the
  /// treatment the block's own locals get — a move inside consumes them, an
  /// early exit drops them, and whatever is still live at the end is dropped
  /// there. Mirrors `check_block_owning`.
  /// The position a node's closing brace sits at: the last byte of its span,
  /// which is what a scope-end event is attributed to.
  function closingSpanOf(hir: &Hir::HirStore, nodeId: Hir::HirId): SourceSpan {
    let Option::SOME(node) = hir.get(nodeId) else {
      return SourceSpan::detached(0, 0);
    };

    let span: SourceSpan = node.span;

    if (span.end > span.start) {
      return SourceSpan::new(span.file, span.end - 1, span.end);
    }

    return span;
  }

  /// Releases, after `statement` (the `index`-th of `block`), the borrows
  /// held for every binding of the innermost scope whose last use it is.
  function releaseEndedHolders(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    block: &Hir::HirBlock,
    blockId: Hir::HirId,
    index: u64,
    statement: Hir::HirId,
  ): void {
    let holders: Vector<u32> = state.currentScopeHolders();
    let mut holderIndex: u64 = 0;

    while (holderIndex < holders.length()) {
      if (let Option::SOME(holder) = holders.get(holderIndex)) {
        let mut last: u64 = Borrowck::NO_LAST_STATEMENT;

        if (let Option::SOME(planned) = state.plannedLastStatement(*holder)) {
          last = planned;
        } else {
          last = Borrowck::holderLastStatement(defStore, typeStore, hir, state, block, blockId, index, *holder);

          let mut planRef: &mut Borrowck::State = state;
          planRef.recordPlannedLastStatement(*holder, last);
        }

        if (last == index) {
          let mut releaseRef: &mut Borrowck::State = state;
          releaseRef.releaseHolder(*holder, Borrowck::closingSpanOf(hir, statement));
        }
      }

      holderIndex += 1;
    }
  }

  /// The last statement of `block` that uses `holder` — the binding the
  /// `declaredAt`-th statement declares — or anything carrying its view: a
  /// binding initialized from it, a pattern binding destructured from it, a
  /// closure capturing it. Granularity is the whole statement, so a use in a
  /// loop body lasts for every round. `NO_LAST_STATEMENT` keeps the borrows
  /// to the end of the scope, which is what a use in the tail or in a
  /// `defer` body needs, a carrier that needs a drop, and a view handed to a
  /// sink it can outlive the statement through (`nodeStoresView`).
  function holderLastStatement(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    block: &Hir::HirBlock,
    blockId: Hir::HirId,
    declaredAt: u64,
    holder: u32,
  ): u64 {
    let Option::SOME(declaration) = block.statements.get(declaredAt) else {
      return Borrowck::NO_LAST_STATEMENT;
    };

    let Option::SOME(declarationNode) = hir.get(*declaration) else {
      return Borrowck::NO_LAST_STATEMENT;
    };

    let Hir::HirKind::Let(declarationLet) = &declarationNode.kind else {
      return Borrowck::NO_LAST_STATEMENT;
    };

    if (declarationLet.name.raw() != holder) {
      return Borrowck::NO_LAST_STATEMENT;
    }

    let statementCount: u64 = block.statements.length();
    let plan: u64 = state.blockPlanIndex(hir, blockId.raw(), &block.statements, block.expression);
    let mut carriers: Vector<u32> = Vector::new<u32>();
    let mut carrierSet: HashMap<u64, u32> = HashMap::new<u64, u32>();
    carriers.push(holder);
    carrierSet.insert(holder as u64, 1);

    // The statements, from the declaration on, that use a carrier outside a
    // `defer` body, each once.
    let mut usedStatements: Vector<u64> = Vector::new<u64>();
    let mut usedSet: HashMap<u64, u32> = HashMap::new<u64, u32>();
    let mut usedInDefer: boolean = false;

    // Transitive carriers, as a worklist over the use index: when a statement
    // uses a carrier, every binding it declares and every place it writes,
    // nested blocks included, joins the carriers if its type can hold
    // something derived from the view (`Analyzer::ViewType::canHoldDerived`):
    // a copy, an aggregate, a pattern binding, a closure, a raw pointer cast
    // from the view or returned inside a call result. This over-approximates
    // the source and errs toward keeping the borrow.
    let mut carrierIndex: u64 = 0;

    while (carrierIndex < carriers.length()) {
      let mut carrier: u32 = 0;

      if (let Option::SOME(entry) = carriers.get(carrierIndex)) {
        carrier = *entry;
      }

      carrierIndex += 1;

      let uses: Vector<u64> = state.planUsesOf(plan, carrier);
      let mut useIndex: u64 = 0;

      while (useIndex < uses.length()) {
        let mut nodeIndex: u64 = 0;

        if (let Option::SOME(entry) = uses.get(useIndex)) {
          nodeIndex = *entry;
        }

        useIndex += 1;

        let statementOfNode: u64 = state.planStatementOfNodeAt(plan, nodeIndex);

        // A `defer` body runs at scope end whatever statement registered it,
        // so a carrier it names keeps the borrow even when the `defer` is
        // written before the view.
        if (state.planNodeInDeferAt(plan, nodeIndex)) {
          usedInDefer = true;
          continue;
        }

        if (statementOfNode < declaredAt) {
          continue;
        }

        if (usedSet.containsKey(&statementOfNode)) {
          continue;
        }

        usedSet.insert(statementOfNode, 1);
        usedStatements.push(statementOfNode);

        let start: u64 = state.planStatementStart(plan, statementOfNode);
        let end: u64 = state.planStatementStart(plan, statementOfNode + 1);
        let mut targets: Vector<u32> = Vector::new<u32>();

        if (!Borrowck::collectDerivedTargets(defStore, typeStore, hir, state, block, plan, start, end, &mut targets)) {
          // A written place whose root binding cannot be resolved keeps the
          // view's borrow to the end of the scope.
          return Borrowck::NO_LAST_STATEMENT;
        }

        let mut targetIndex: u64 = 0;

        while (targetIndex < targets.length()) {
          if (let Option::SOME(target) = targets.get(targetIndex)) {
            let key: u64 = *target as u64;

            // A carrier declared outside the block outlives it: its later
            // uses are not in this plan, so the borrow lasts to scope end.
            if (!state.planDeclares(plan, *target)) {
              return Borrowck::NO_LAST_STATEMENT;
            }

            if (!carrierSet.containsKey(&key)) {
              carriers.push(*target);
              carrierSet.insert(key, 1);
            }
          }

          targetIndex += 1;
        }
      }
    }

    // A carrier that needs a drop lives to the end of its scope, and the
    // view it carries with it; so does one whose address the block takes,
    // since the alias is not tracked.
    let mut dropIndex: u64 = 0;

    while (dropIndex < carriers.length()) {
      if (let Option::SOME(carrier) = carriers.get(dropIndex)) {
        if (*carrier != holder && state.planTakesAddressOf(plan, *carrier)) {
          return Borrowck::NO_LAST_STATEMENT;
        }

        if (Borrowck::definitionNeedsDrop(defStore, typeStore, Id::fromRaw<Analyzer::DefinitionTag>(*carrier))) {
          return Borrowck::NO_LAST_STATEMENT;
        }
      }

      dropIndex += 1;
    }

    // A use in a `defer` body runs at scope end, so it keeps the borrow to
    // the end of the scope.
    if (usedInDefer) {
      return Borrowck::NO_LAST_STATEMENT;
    }

    let mut last: u64 = declaredAt;
    let mut statementIndex: u64 = 0;

    while (statementIndex < usedStatements.length()) {
      if (let Option::SOME(used) = usedStatements.get(statementIndex)) {
        if (*used == statementCount) {
          // A use in the block's tail keeps the borrow to block end.
          return Borrowck::NO_LAST_STATEMENT;
        }

        if (*used > last) {
          last = *used;
        }

        // The sink rule: a view handed somewhere it can outlive the
        // statement keeps its borrow to the end of the scope. A sink names a
        // carrier, so only the statements that use one can hold it.
        let start: u64 = state.planStatementStart(plan, *used);
        let end: u64 = state.planStatementStart(plan, *used + 1);
        let mut sinkIndex: u64 = start;

        while (sinkIndex < end) {
          let nodeId: Hir::HirId = Id::fromRaw<Hir::NodeTag>(state.planNodeRawAt(plan, sinkIndex));

          if (Borrowck::nodeStoresView(defStore, typeStore, hir, nodeId, &carriers)) {
            return Borrowck::NO_LAST_STATEMENT;
          }

          sinkIndex += 1;
        }
      }

      statementIndex += 1;
    }

    return last;
  }

  /// Collects into `output` the carriers a statement — the nodes `start` to
  /// `end` of plan `plan`, outside `defer` bodies — makes: each binding it
  /// declares and the root binding of each place it assigns, when that
  /// binding's or place's type can hold something derived from a view. A
  /// place reached through a `&mut` binding resolves to the binding the
  /// reference was taken from (`slot.name` with `slot = &mut holder` makes
  /// `holder` a carrier). Returns false when such a place's root cannot be
  /// resolved, which keeps the borrow to the end of the scope.
  function collectDerivedTargets(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    block: &Hir::HirBlock,
    plan: u64,
    start: u64,
    end: u64,
    output: &mut Vector<u32>,
  ): boolean {
    let mut index: u64 = start;

    while (index < end) {
      if (state.planNodeInDeferAt(plan, index)) {
        index += 1;
        continue;
      }

      let nodeId: Hir::HirId = Id::fromRaw<Hir::NodeTag>(state.planNodeRawAt(plan, index));
      let mut reached: Vector<u32> = Vector::new<u32>();

      if (Borrowck::bindingsReachedBy(hir, nodeId, &mut reached)) {
        let mut bindingIndex: u64 = 0;

        while (bindingIndex < reached.length()) {
          if (let Option::SOME(binding) = reached.get(bindingIndex)) {
            if (Borrowck::bindingCanHoldDerived(defStore, typeStore, state.ownedBuffer, *binding)) {
              Borrowck::pushRaw(output, *binding);
            }
          }

          bindingIndex += 1;
        }
      }

      if (let Option::SOME(node) = hir.get(nodeId)) {
        if (let Hir::HirKind::Assign(assignNode) = &node.kind) {
          let mut qualifies: boolean = true;

          if (let Option::SOME(targetType) = Borrowck::nodeTypeOf(hir, assignNode.target)) {
            qualifies = Analyzer::ViewType::canHoldDerived(defStore, typeStore, targetType, state.ownedBuffer);
          }

          if (qualifies && !Borrowck::pushPlaceRoot(defStore, typeStore, hir, block, assignNode.target, 0, output)) {
            return false;
          }
        }
      }

      index += 1;
    }

    return true;
  }

  /// Pushes the bindings that own the storage the place `target` writes:
  /// the variable a direct place names, and through a dereference — explicit
  /// (`*slot`) or implied by projecting through a reference or raw pointer
  /// (`slot.name`) — the binding the reference was taken from by a `let` of
  /// this block (`let slot = &mut holder`), following reborrows
  /// (`&mut *slot`, `&mut holder.inner`) to the owner. Returns false when
  /// the storage cannot be resolved to a local: a static, a reference or
  /// pointer held inside another value (`wrapper.r.p`), a parameter, or a
  /// pointer not taken by a `let` of this block.
  function pushPlaceRoot(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    block: &Hir::HirBlock,
    target: Hir::HirId,
    depth: u32,
    output: &mut Vector<u32>,
  ): boolean {
    if (depth > 32) {
      return false;
    }

    let Option::SOME(node) = hir.get(target) else {
      return false;
    };

    match (&node.kind) {
      Hir::HirKind::Variable(defId) -> {
        Borrowck::pushRaw(output, defId.raw());
        return true;
      },
      Hir::HirKind::FieldAccess(access) -> {
        return Borrowck::pushProjectionBase(defStore, typeStore, hir, block, access.base, depth, output);
      },
      Hir::HirKind::Index(indexNode) -> {
        return Borrowck::pushProjectionBase(defStore, typeStore, hir, block, indexNode.base, depth, output);
      },
      Hir::HirKind::Dereference(inner) -> {
        return Borrowck::pushReferenceOwner(defStore, typeStore, hir, block, inner, depth + 1, output);
      },
      _ -> {
        return false;
      },
    };
  }

  /// The owner of a projection's base: the base place itself, or, when the
  /// base is a reference, raw pointer or slice the projection reads through,
  /// the owner of what it points to.
  function pushProjectionBase(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    block: &Hir::HirBlock,
    base: Hir::HirId,
    depth: u32,
    output: &mut Vector<u32>,
  ): boolean {
    let Option::SOME(baseType) = Borrowck::nodeTypeOf(hir, base) else {
      return false;
    };

    if (Borrowck::typePointsElsewhere(defStore, typeStore, baseType)) {
      return Borrowck::pushReferenceOwner(defStore, typeStore, hir, block, base, depth + 1, output);
    }

    return Borrowck::pushPlaceRoot(defStore, typeStore, hir, block, base, depth + 1, output);
  }

  /// The owner of the storage the reference or pointer `reference` points
  /// to: only a local whose `let` in this block takes it as `&place` or
  /// `&mut place` resolves, to the owner of that place.
  function pushReferenceOwner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    block: &Hir::HirBlock,
    reference: Hir::HirId,
    depth: u32,
    output: &mut Vector<u32>,
  ): boolean {
    if (depth > 32) {
      return false;
    }

    let Option::SOME(node) = hir.get(reference) else {
      return false;
    };

    let Hir::HirKind::Variable(defId) = &node.kind else {
      return false;
    };

    let Option::SOME(source) = Borrowck::referenceSourceOf(hir, block, defId.raw()) else {
      return false;
    };

    Borrowck::pushRaw(output, defId.raw());
    return Borrowck::pushPlaceRoot(defStore, typeStore, hir, block, source, depth + 1, output);
  }

  /// Whether a value of `typeId` addresses storage it does not hold: a
  /// reference, a raw pointer or a slice, through aliases.
  function typePointsElsewhere(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let mut current: Analyzer::TypeId = typeId;
    let mut depth: u32 = 0;

    while (depth < 64) {
      let Option::SOME(type_) = typeStore.get(current) else {
        return true;
      };

      match (type_) {
        Analyzer::Type::Reference(_) | Analyzer::Type::Pointer(_) | Analyzer::Type::Slice(_) -> {
          return true;
        },
        Analyzer::Type::Alias(aliasDefId) -> {
          let Option::SOME(aliased) = Borrowck::aliasedTypeOf(defStore, aliasDefId) else {
            return true;
          };

          current = aliased;
        },
        _ -> {
          return false;
        },
      };

      depth += 1;
    }

    return true;
  }

  /// The place a top-level `let binding = &place;` or `&mut place` of
  /// `block` takes its reference from.
  function referenceSourceOf(
    hir: &Hir::HirStore,
    block: &Hir::HirBlock,
    binding: u32
  ): Option<Hir::HirId> {
    let mut index: u64 = 0;

    while (index < block.statements.length()) {
      if (let Option::SOME(statement) = block.statements.get(index)) {
        if (let Option::SOME(node) = hir.get(*statement)) {
          if (let Hir::HirKind::Let(letNode) = &node.kind) {
            if (letNode.name.raw() == binding) {
              let Option::SOME(value) = letNode.value else {
                return Option::NONE;
              };

              let Option::SOME(reference) = Borrowck::referenceParts(hir, value) else {
                return Option::NONE;
              };

              return Option::SOME(reference.expression);
            }
          }
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// How a cast operand or target is classified by `castReinterprets`.
  const CAST_KIND_OTHER: u8 = 0;
  const CAST_KIND_NUMERIC: u8 = 1;
  const CAST_KIND_INTEGER: u8 = 2;
  const CAST_KIND_POINTER: u8 = 3;
  const CAST_KIND_REFERENCE: u8 = 4;
  const CAST_KIND_STR: u8 = 5;

  /// Whether a cast from `source` to `target` reinterprets storage instead
  /// of converting a value: either side is a reference, a `str` or a raw
  /// pointer and the types differ (a `&mut T` to `&T` and a `static str` to
  /// `str` are conversions), an integer becomes anything but a number, a
  /// boolean or a `char`, or a value that can carry a view becomes an
  /// integer.
  public function castReinterprets(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    source: Analyzer::TypeId,
    target: Analyzer::TypeId,
  ): boolean {
    let sourceType: Analyzer::TypeId = Borrowck::withoutAliases(defStore, typeStore, source);
    let targetType: Analyzer::TypeId = Borrowck::withoutAliases(defStore, typeStore, target);

    if (sourceType.raw() == targetType.raw()) {
      return false;
    }

    let fromKind: u8 = Borrowck::castKindOf(defStore, typeStore, sourceType);
    let toKind: u8 = Borrowck::castKindOf(defStore, typeStore, targetType);

    if (fromKind == Borrowck::CAST_KIND_STR && toKind == Borrowck::CAST_KIND_STR) {
      return false;
    }

    if (fromKind == Borrowck::CAST_KIND_REFERENCE && toKind == Borrowck::CAST_KIND_REFERENCE) {
      return Borrowck::referentOf(typeStore, sourceType).raw() != Borrowck::referentOf(typeStore, targetType).raw();
    }

    if (Borrowck::isAddressKind(fromKind) || Borrowck::isAddressKind(toKind)) {
      return true;
    }

    if (fromKind == Borrowck::CAST_KIND_INTEGER) {
      return toKind != Borrowck::CAST_KIND_INTEGER && toKind != Borrowck::CAST_KIND_NUMERIC;
    }

    if (toKind == Borrowck::CAST_KIND_INTEGER) {
      return Analyzer::ViewType::canCarryView(defStore, typeStore, sourceType);
    }

    return false;
  }

  function isAddressKind(kind: u8): boolean {
    return kind == Borrowck::CAST_KIND_POINTER || kind == Borrowck::CAST_KIND_REFERENCE || kind == Borrowck::CAST_KIND_STR;
  }

  function castKindOf(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId
  ): u8 {
    let resolved: Analyzer::TypeId = Borrowck::withoutAliases(defStore, typeStore, typeId);

    return match (typeStore.get(resolved)) {
      Option::SOME(Analyzer::Type::I8) -> Borrowck::CAST_KIND_INTEGER,
      Option::SOME(Analyzer::Type::I16) -> Borrowck::CAST_KIND_INTEGER,
      Option::SOME(Analyzer::Type::I32) -> Borrowck::CAST_KIND_INTEGER,
      Option::SOME(Analyzer::Type::I64) -> Borrowck::CAST_KIND_INTEGER,
      Option::SOME(Analyzer::Type::U8) -> Borrowck::CAST_KIND_INTEGER,
      Option::SOME(Analyzer::Type::U16) -> Borrowck::CAST_KIND_INTEGER,
      Option::SOME(Analyzer::Type::U32) -> Borrowck::CAST_KIND_INTEGER,
      Option::SOME(Analyzer::Type::U64) -> Borrowck::CAST_KIND_INTEGER,
      Option::SOME(Analyzer::Type::F32) -> Borrowck::CAST_KIND_NUMERIC,
      Option::SOME(Analyzer::Type::F64) -> Borrowck::CAST_KIND_NUMERIC,
      Option::SOME(Analyzer::Type::BOOLEAN) -> Borrowck::CAST_KIND_NUMERIC,
      Option::SOME(Analyzer::Type::CHAR) -> Borrowck::CAST_KIND_NUMERIC,
      Option::SOME(Analyzer::Type::Pointer(_)) -> Borrowck::CAST_KIND_POINTER,
      Option::SOME(Analyzer::Type::Reference(_)) -> Borrowck::CAST_KIND_REFERENCE,
      Option::SOME(Analyzer::Type::STR) -> Borrowck::CAST_KIND_STR,
      Option::SOME(Analyzer::Type::STATIC_STR) -> Borrowck::CAST_KIND_STR,
      _ -> Borrowck::CAST_KIND_OTHER,
    };
  }

  function referentOf(
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId
  ): Analyzer::TypeId {
    return match (typeStore.get(typeId)) {
      Option::SOME(Analyzer::Type::Reference(reference)) -> reference.referent,
      _ -> typeId,
    };
  }

  /// `typeId` with every alias followed to the aliased type.
  function withoutAliases(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId
  ): Analyzer::TypeId {
    let mut current: Analyzer::TypeId = typeId;
    let mut depth: u32 = 0;

    while (depth < 64) {
      let Option::SOME(Analyzer::Type::Alias(aliasDefId)) = typeStore.get(current) else {
        return current;
      };

      let Option::SOME(aliased) = Borrowck::aliasedTypeOf(defStore, aliasDefId) else {
        return current;
      };

      current = aliased;
      depth += 1;
    }

    return current;
  }

  /// Whether `callee` is a function declared in an `extern` block.
  function isExternFunction(
    defStore: &mut Analyzer::DefinitionStore,
    callee: Analyzer::DefinitionId
  ): boolean {
    return match (defStore.get(callee)) {
      Option::SOME(Analyzer::Definition::Function(functionDef)) -> functionDef.isExtern,
      _ -> false,
    };
  }

  /// Whether the function body at `bodyId`, nested blocks and closure bodies
  /// included, uses raw pointers or inline assembly: an `asm`, any
  /// `@bitCast`, `@read`, `@write` (volatile included) or atomic builtin, or
  /// any node whose type holds a raw pointer at any depth
  /// (`Analyzer::ViewType::holdsRawPointer`, so the buffers of `String` and
  /// the standard `@owns` storage do not count), any cast that is not a value
  /// conversion (`castReinterprets`), or a `@sliceFromParts` whose data is
  /// not a raw pointer. The pointer builtins lower to casts that need not
  /// show a pointer-typed node: `@integerFromPointer(text)` is a cast of a
  /// `str` to `u64`, `@pointerFromInteger<str>(bits)` a cast of `u64` to
  /// `str`, and `(&text) as &u64` a cast between references.
  /// Such a function keeps every borrow a binding holds to the end of its
  /// scope: the last-use rule cannot follow a view through raw pointers.
  public function functionUsesRawPointers(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    bodyId: Hir::HirId,
    ownedBuffer: u32,
  ): boolean {
    let nodes: Vector<Hir::HirId> = Borrowck::subtreeNodes(hir, bodyId);
    let mut checked: HashMap<u64, boolean> = HashMap::new<u64, boolean>();
    let mut index: u64 = 0;

    while (index < nodes.length()) {
      if (let Option::SOME(nodeId) = nodes.get(index)) {
        if (let Option::SOME(node) = hir.get(*nodeId)) {
          // These read or write through, or launder, a pointer whatever the
          // types they show: `@bitCast<u64[2]>(text)` turns a view into
          // integers that `@bitCast<str>` turns back.
          let rawAccess: boolean = match (&node.kind) {
            Hir::HirKind::InlineAsm(_) -> true,
            Hir::HirKind::BitCast(_) -> true,
            Hir::HirKind::BuiltinLoad(_) -> true,
            Hir::HirKind::BuiltinStore(_) -> true,
            Hir::HirKind::BuiltinAtomic(_) -> true,
            _ -> false,
          };

          if (rawAccess) {
            return true;
          }

          if (let Hir::HirKind::Cast(cast) = &node.kind) {
            if (let Option::SOME(operandType) = Borrowck::nodeTypeOf(hir, cast.expression)) {
              if (Borrowck::castReinterprets(defStore, typeStore, operandType, cast.target)) {
                return true;
              }
            }
          }

          // `@sliceFromParts` over anything but a raw pointer reads the
          // storage of whatever it was handed (`@sliceFromParts<u64>(&text, 1)`).
          if (let Hir::HirKind::MakeSlice(slice) = &node.kind) {
            let mut pointerData: boolean = false;

            if (let Option::SOME(dataType) = Borrowck::nodeTypeOf(hir, slice.data)) {
              pointerData = Borrowck::castKindOf(defStore, typeStore, dataType) == Borrowck::CAST_KIND_POINTER;
            }

            if (!pointerData) {
              return true;
            }
          }

          let key: u64 = node.typeId.raw() as u64;
          let mut holds: boolean = false;

          if (let Option::SOME(known) = checked.get(&key)) {
            holds = *known;
          } else {
            holds = Analyzer::ViewType::holdsRawPointer(defStore, typeStore, node.typeId, ownedBuffer);
            checked.insert(key, holds);
          }

          if (holds) {
            return true;
          }
        }
      }

      index += 1;
    }

    return false;
  }

  /// The module symbol path of `std/string/mod.ign`, which declares `String`.
  const STD_STRING_MODULE: str = "L3std6string3modE";

  /// The raw definition id of the standard library `String`: the
  /// non-generic record named `String` that the standard library module
  /// `std/string/mod.ign` publishes, identified by its module's kind and
  /// symbol path, so neither a user record named `String` nor one in a user
  /// package named `std` is mistaken for it. `u32::MAX`, which matches no definition,
  /// when the standard library is not loaded.
  public function stdStringDefinition(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable
  ): u32 {
    let name: Analyzer::SymbolId = symbols.intern("String");
    let mut raw: u64 = 0;

    while (raw < defStore.length()) {
      let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(raw as u32);
      let mut candidate: boolean = false;

      if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(defId)) {
        candidate = recordDef.name.raw() == name.raw() && recordDef.typeParams.isEmpty();
      }

      if (candidate) {
        if (let Option::SOME(moduleIndex) = defStore.defModuleOf(defId) && defStore.isStdModule(moduleIndex)) {
          if (let Option::SOME(path) = defStore.moduleSymbolPathOf(moduleIndex)) {
            if (path.equals(Borrowck::STD_STRING_MODULE)) {
              return raw as u32;
            }
          }
        }
      }

      raw += 1;
    }

    return 4294967295;
  }

  /// Whether the local `defRaw` can hold something derived from a view
  /// (`Analyzer::ViewType::canHoldDerived`); an untyped one can.
  function bindingCanHoldDerived(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    ownedBuffer: u32,
    defRaw: u32,
  ): boolean {
    let Option::SOME(typeId) = Borrowck::variableTypeOf(defStore, Id::fromRaw<Analyzer::DefinitionTag>(defRaw)) else {
      return true;
    };

    return Analyzer::ViewType::canHoldDerived(defStore, typeStore, typeId, ownedBuffer);
  }

  /// Appends `nodeIndex` to the uses of the binding `key`.
  function addPlanUse(uses: &mut HashMap<u64, Vector<u64>>, key: u64, nodeIndex: u64): void {
    let mut usesRef: &mut HashMap<u64, Vector<u64>> = uses;

    if (let Option::SOME(list) = usesRef.getMut(&key)) {
      let mut listRef: &mut Vector<u64> = list;
      listRef.push(nodeIndex);
      return;
    }

    let mut list: Vector<u64> = Vector::new<u64>();
    list.push(nodeIndex);
    usesRef.insert(key, list);
  }

  /// The bindings a `let`, `let else` or `match` statement at `nodeId`
  /// declares from the value it binds, when it is one of them.
  function bindingsReachedBy(
    hir: &Hir::HirStore,
    nodeId: Hir::HirId,
    output: &mut Vector<u32>,
  ): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    let mut source: Option<Hir::HirId> = Option::NONE;

    match (&node.kind) {
      Hir::HirKind::Let(letNode) -> {
        Borrowck::pushRaw(output, letNode.name.raw());
        source = letNode.value;
      },
      Hir::HirKind::LetElse(letElse) -> {
        Borrowck::collectAllBindings(&letElse.pattern, output);
        source = Option::SOME(letElse.value);
      },
      Hir::HirKind::Match(matchNode) -> {
        let mut armIndex: u64 = 0;

        while (armIndex < matchNode.arms.length()) {
          if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
            Borrowck::collectAllBindings(&arm.pattern, output);
          }

          armIndex += 1;
        }

        source = Option::SOME(matchNode.scrutinee);
      },
      _ -> {},
    };

    return source.isSome();
  }

  /// Whether `nodeId` itself names one of `carriers`: a variable, or a
  /// closure capturing one.
  function nodeUsesAny(hir: &Hir::HirStore, nodeId: Hir::HirId, carriers: &Vector<u32>): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    match (&node.kind) {
      Hir::HirKind::Variable(defId) -> {
        return Borrowck::vectorHasRaw(carriers, defId.raw());
      },
      Hir::HirKind::Closure(closureNode) -> {
        let mut index: u64 = 0;

        while (index < closureNode.captures.length()) {
          if (let Option::SOME(capture) = closureNode.captures.get(index)) {
            if (Borrowck::vectorHasRaw(carriers, capture.sourceDef.raw())) {
              return true;
            }
          }

          index += 1;
        }
      },
      _ -> {},
    };

    return false;
  }

  /// Whether any node of the subtree at `nodeId` names one of `carriers`.
  function mentionsAny(hir: &Hir::HirStore, nodeId: Hir::HirId, carriers: &Vector<u32>): boolean {
    let subtree: Vector<Hir::HirId> = Borrowck::subtreeNodes(hir, nodeId);
    let mut index: u64 = 0;

    while (index < subtree.length()) {
      if (let Option::SOME(child) = subtree.get(index)) {
        if (Borrowck::nodeUsesAny(hir, *child, carriers)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function anyMentions(
    hir: &Hir::HirStore,
    nodes: &Vector<Hir::HirId>,
    carriers: &Vector<u32>
  ): boolean {
    let mut index: u64 = 0;

    while (index < nodes.length()) {
      if (let Option::SOME(nodeId) = nodes.get(index)) {
        if (Borrowck::mentionsAny(hir, *nodeId, carriers)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function vectorHasRaw(values: &Vector<u32>, raw: u32): boolean {
    let mut index: u64 = 0;

    while (index < values.length()) {
      if (let Option::SOME(value) = values.get(index)) {
        if (*value == raw) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// Appends `raw` unconditionally; `pushUniqueRaw` is the deduplicating
  /// variant.
  function pushRaw(output: &mut Vector<u32>, raw: u32): void {
    let mut outputRef: &mut Vector<u32> = output;
    outputRef.push(raw);
  }

  /// Every node of the subtree at `nodeId`, closure bodies included.
  public function subtreeNodes(hir: &Hir::HirStore, nodeId: Hir::HirId): Vector<Hir::HirId> {
    let mut result: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut pending: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    pending.push(nodeId);

    while (let Option::SOME(current) = pending.pop()) {
      result.push(current);

      if (let Option::SOME(node) = hir.get(current)) {
        let children: Vector<Hir::HirId> = Hir::childIds(&node.kind);
        let mut index: u64 = 0;

        while (index < children.length()) {
          if (let Option::SOME(child) = children.get(index)) {
            pending.push(*child);
          }

          index += 1;
        }
      }
    }

    return result;
  }

  /// Whether `nodeId` hands a view one of `carriers` holds somewhere it can
  /// outlive the statement — the sink rule. The borrow stays to the end of
  /// the scope when the view is assigned into a place whose type can carry
  /// it, handed to a call (function, method or closure call) any other
  /// operand of which can reach a mutable place — a `&mut`, a raw pointer, a
  /// closure value, or an aggregate or `&T` holding one — handed through a
  /// raw pointer, or handed to a volatile, `@write` or atomic sink. A view
  /// consumed where the view rules already follow it — a binding, a call
  /// whose other operands reach nothing mutable — does not keep the borrow
  /// here; the
  /// view rules reject every container, static and thread boundary a view
  /// could dangle out of.
  function nodeStoresView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    nodeId: Hir::HirId,
    carriers: &Vector<u32>,
  ): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    match (&node.kind) {
      Hir::HirKind::Assign(assignNode) -> {
        if (!Borrowck::mentionsAny(hir, assignNode.value, carriers)) {
          return false;
        }

        let Option::SOME(slotType) = Borrowck::nodeTypeOf(hir, assignNode.target) else {
          return true;
        };

        return Borrowck::typeCanCarryView(defStore, typeStore, slotType);
      },
      Hir::HirKind::CallClosure(callNode) -> {
        let mut operands: Vector<Hir::HirId> = Borrowck::copyHirIds(&callNode.args);
        operands.push(callNode.callee);
        return Borrowck::callHandsViewToSink(defStore, typeStore, hir, &operands, Option::SOME(callNode.callee), carriers);
      },
      Hir::HirKind::Call(callNode) -> {
        // An `extern` function can keep what it receives where the borrow
        // check cannot see, so a carrier handed to one directly is a sink.
        if (Borrowck::isExternFunction(defStore, callNode.callee) && Borrowck::anyMentions(hir, &callNode.args, carriers)) {
          return true;
        }

        return Borrowck::callHandsViewToSink(defStore, typeStore, hir, &callNode.args, Option::NONE, carriers);
      },
      Hir::HirKind::MethodCall(callNode) -> {
        let mut operands: Vector<Hir::HirId> = Borrowck::copyHirIds(&callNode.args);

        if (let Option::SOME(receiver) = callNode.receiver) {
          operands.push(receiver);
        }

        return Borrowck::callHandsViewToSink(defStore, typeStore, hir, &operands, Option::NONE, carriers);
      },
      Hir::HirKind::BuiltinStore(storeNode) -> {
        return Borrowck::mentionsAny(hir, storeNode.value, carriers);
      },
      Hir::HirKind::BuiltinAtomic(atomicNode) -> {
        return Borrowck::anyMentions(hir, &atomicNode.operands, carriers);
      },
      _ -> {
        return false;
      },
    };
  }

  /// The call-level sink test: one operand mentions a carrier, and some
  /// operand gives the callee a place the view could be stored in. An
  /// operand that does not carry the view counts when it can reach any
  /// mutable place (`Analyzer::ViewType::canReachMutablePlace`): the
  /// receiver, a closure callee, a `&mut` or raw pointer argument. An operand
  /// that carries the view counts only when it reaches a place that can hold
  /// one (`Analyzer::ViewType::canReachViewHoldingPlace`), so the view and a
  /// `&mut str` travelling in one value (`Pair { text: text, slot: &mut
  /// slot }`, or two fields of one holder) keep the borrow while a `&mut
  /// String` view used as a receiver does not. A closure callee that carries
  /// the view is skipped only when no argument carries it too: capture
  /// analysis tracks what its body stores from its captures, but not what it
  /// stores from its parameters, so a callee also handed the view counts as
  /// any other operand (`canReachMutablePlace`, true for a closure type).
  function callHandsViewToSink(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    operands: &Vector<Hir::HirId>,
    closureCallee: Option<Hir::HirId>,
    carriers: &Vector<u32>,
  ): boolean {
    if (!Borrowck::anyMentions(hir, operands, carriers)) {
      return false;
    }

    let mut exemptCallee: Option<Hir::HirId> = Option::NONE;

    if (let Option::SOME(callee) = closureCallee) {
      let mut argumentCarries: boolean = false;
      let mut argumentIndex: u64 = 0;

      while (argumentIndex < operands.length()) {
        if (let Option::SOME(operand) = operands.get(argumentIndex)) {
          if (operand.raw() != callee.raw() && Borrowck::mentionsAny(hir, *operand, carriers)) {
            argumentCarries = true;
          }
        }

        argumentIndex += 1;
      }

      if (!argumentCarries) {
        exemptCallee = Option::SOME(callee);
      }
    }

    let mut index: u64 = 0;

    while (index < operands.length()) {
      if (let Option::SOME(operand) = operands.get(index)) {
        let Option::SOME(operandType) = Borrowck::nodeTypeOf(hir, *operand) else {
          return true;
        };

        let mut isCallee: boolean = false;

        if (let Option::SOME(callee) = closureCallee) {
          isCallee = callee.raw() == operand.raw();
        }

        let mut isExempt: boolean = false;

        if (let Option::SOME(callee) = exemptCallee) {
          isExempt = callee.raw() == operand.raw();
        }

        if (isCallee && !isExempt) {
          if (Analyzer::ViewType::canReachMutablePlace(defStore, typeStore, operandType)) {
            return true;
          }
        } else if (Borrowck::mentionsAny(hir, *operand, carriers)) {
          if (!isCallee && Analyzer::ViewType::canReachViewHoldingPlace(defStore, typeStore, operandType)) {
            return true;
          }
        } else if (Analyzer::ViewType::canReachMutablePlace(defStore, typeStore, operandType)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// Whether the local `defRaw` can hold a view taken from another binding.
  function bindingCanCarryView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    defRaw: u32,
  ): boolean {
    let Option::SOME(typeId) = Borrowck::variableTypeOf(defStore, Id::fromRaw<Analyzer::DefinitionTag>(defRaw)) else {
      return true;
    };

    return Borrowck::typeCanCarryView(defStore, typeStore, typeId);
  }

  /// Whether a value of `typeId` can carry a view another binding holds
  /// (`Analyzer::ViewType::canCarryView`).
  function typeCanCarryView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    return Analyzer::ViewType::canCarryView(defStore, typeStore, typeId);
  }

  function checkBlockOwning(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    block: &Hir::HirBlock,
    blockId: Hir::HirId,
    extraOwned: &Vector<u32>,
  ): void {
    let mut enterRef: &mut Borrowck::State = state;
    enterRef.pushScopeEnding(blockId.raw(), true, false, Borrowck::closingSpanOf(hir, blockId));

    let mut ownedIndex: u64 = 0;

    while (ownedIndex < extraOwned.length()) {
      if (let Option::SOME(defRaw) = extraOwned.get(ownedIndex)) {
        Borrowck::declareOwned(state, Id::fromRaw<Analyzer::DefinitionTag>(*defRaw));
      }

      ownedIndex += 1;
    }

    let mut index: u64 = 0;

    while (index < block.statements.length()) {
      if (!state.reachable) {
        break;
      }

      if (let Option::SOME(statement) = block.statements.get(index)) {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, *statement);

        if (state.reachable && !state.keepsBorrowsToScopeEnd) {
          Borrowck::releaseEndedHolders(defStore, typeStore, hir, state, block, blockId, index, *statement);
        }
      }

      index += 1;
    }

    if (let Option::SOME(tail) = block.expression) {
      if (state.reachable) {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, tail);

        if (state.handsOverTail(blockId.raw())) {
          Borrowck::handOverTailBinding(defStore, typeStore, hir, state, schedules, tail, Borrowck::closingSpanOf(hir, blockId));
        }
      }
    }

    Borrowck::exitScope(state, schedules);
  }

  /// Marks `nodeId` and every block on its chain of tails as handing its tail
  /// value out, when `nodeId` is a block.
  function markTailHandoverChain(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    nodeId: Hir::HirId
  ): void {
    let Option::SOME(node) = hir.get(nodeId) else {
      return;
    };

    let Hir::HirKind::Block(block) = &node.kind else {
      return;
    };

    let mut stateRef: &mut Borrowck::State = state;
    stateRef.markTailHandover(nodeId.raw());

    if (let Option::SOME(tail) = block.expression) {
      Borrowck::markTailHandoverChain(hir, state, tail);
    }
  }

  /// Moves the binding a handing-over block names as its tail into the
  /// block's value, when the block itself declared it. Its scope ends right
  /// after, and without the move the scope end would drop the value the tail
  /// just handed out. A binding declared outside the block outlives it and is
  /// left to whoever receives the block's value.
  function handOverTailBinding(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    tail: Hir::HirId,
    span: SourceSpan,
  ): void {
    let Option::SOME(result) = Borrowck::armResultBinding(hir, tail) else {
      return;
    };

    let mut declaredHere: Vector<u32> = state.currentScopeDrops();

    if (!Borrowck::containsRaw(&mut declaredHere, result.raw())) {
      return;
    }

    let ownsValue: boolean = Borrowck::definitionNeedsDrop(defStore, typeStore, result) || state.isMoveOnlyClosureOwner(result.raw());

    if (!ownsValue || state.isBorrowedBinding(result.raw()) || !state.isMoveValid(result.raw())) {
      return;
    }

    Borrowck::tryConsume(state, schedules, result, span, Borrowck::OwnershipReport::CONSUMER_ARM_RESULT);
  }

  /// Checks the branch a `let` condition guards, handing it ownership of that
  /// condition's bindings. A branch that is not a block has no scope to hold
  /// them, so they keep the treatment they had before: no drop site, and the
  /// value outlives the branch. Mirrors `check_guarded_branch`.
  function checkGuardedBranch(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    branch: Hir::HirId,
    conditionBindings: &Vector<u32>,
  ): void {
    if (conditionBindings.isEmpty()) {
      Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, branch);
      return;
    }

    let Option::SOME(node) = hir.get(branch) else {
      Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, branch);
      return;
    };

    let Hir::HirKind::Block(block) = &node.kind else {
      Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, branch);
      return;
    };

    Borrowck::checkBlockOwning(
      defStore,
      typeStore,
      symbols,
      hir,
      state,
      diagnostics,
      schedules,
      &block,
      branch,
      conditionBindings,
    );
  }

  /// Forgets the move state of bindings that only exist on one path, so a
  /// later join does not compare a state the other paths have no notion of.
  function forgetConditionBindings(
    state: &mut Borrowck::State,
    conditionBindings: &Vector<u32>
  ): void {
    let mut index: u64 = 0;

    while (index < conditionBindings.length()) {
      if (let Option::SOME(defRaw) = conditionBindings.get(index)) {
        let mut stateRef: &mut Borrowck::State = state;
        stateRef.removeMoveValue(*defRaw);
      }

      index += 1;
    }
  }

  /// Remembers the place a `let` condition is about to consume, so a
  /// short-circuit in front of it can pay for the move that never happened.
  /// Mirrors `record_let_condition_scrutinee`.
  ///
  /// Only a value this function would otherwise free is worth recording: a
  /// place whose type needs no drop owes nothing, a place that is not live was
  /// not this condition's to take, and a binding that names borrowed storage
  /// belongs to its referent, whose own schedule frees it.
  function recordLetConditionScrutinee(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    state: &mut Borrowck::State,
    matchId: Hir::HirId,
    scrutinee: Analyzer::DefinitionId,
    isLetConditionMatch: boolean,
  ): void {
    if (!isLetConditionMatch) {
      return;
    }

    if (!state.isMoveValid(scrutinee.raw()) || state.isBorrowedBinding(scrutinee.raw())) {
      return;
    }

    let Option::SOME(scrutineeType) = Borrowck::variableTypeOf(defStore, scrutinee) else {
      return;
    };

    if (!Borrowck::needsDropType(defStore, typeStore, scrutineeType)) {
      return;
    }

    let mut stateRef: &mut Borrowck::State = state;
    stateRef.recordLetConditionScrutinee(matchId.raw(), scrutinee.raw());
  }

  /// The places the `let` conditions inside a condition subexpression consume,
  /// in declaration order. Mirrors `condition_scrutinee_places`.
  ///
  /// Walks the same `&&` chain `takeConditionBindings` walks, so a
  /// parenthesized `a && (b && let X = place)` reports `place` for the outer
  /// `&&` too: its right operand holds that `let`, and a false `a` skips all of
  /// it.
  function conditionScrutineePlaces(
    hir: &Hir::HirStore,
    state: &Borrowck::State,
    condition: Hir::HirId,
  ): Vector<u32> {
    let mut places: Vector<u32> = Vector::new<u32>();

    if (let Option::SOME(node) = hir.get(condition)) {
      if (let Hir::HirKind::Binary(binaryNode) = &node.kind) {
        if (let Hir::BinaryOperation::And = binaryNode.operation) {
          places = Borrowck::conditionScrutineePlaces(hir, state, binaryNode.left);

          let rightPlaces: Vector<u32> = Borrowck::conditionScrutineePlaces(hir, state, binaryNode.right);
          let mut index: u64 = 0;

          while (index < rightPlaces.length()) {
            if (let Option::SOME(defRaw) = rightPlaces.get(index)) {
              places.push(*defRaw);
            }

            index += 1;
          }

          return places;
        }
      }
    }

    if (let Option::SOME(defRaw) = state.letConditionScrutinee(condition.raw())) {
      places.push(defRaw);
    }

    return places;
  }

  /// Every `&&` node in a condition expression, outermost first. Mirrors
  /// `condition_and_nodes`.
  function conditionAndNodes(hir: &Hir::HirStore, condition: Hir::HirId): Vector<Hir::HirId> {
    let mut nodes: Vector<Hir::HirId> = Vector::new<Hir::HirId>();

    let Option::SOME(node) = hir.get(condition) else {
      return nodes;
    };

    let Hir::HirKind::Binary(binaryNode) = &node.kind else {
      return nodes;
    };

    let Hir::BinaryOperation::And = binaryNode.operation else {
      return nodes;
    };

    nodes.push(condition);

    let leftNodes: Vector<Hir::HirId> = Borrowck::conditionAndNodes(hir, binaryNode.left);
    let mut leftIndex: u64 = 0;

    while (leftIndex < leftNodes.length()) {
      if (let Option::SOME(nodeId) = leftNodes.get(leftIndex)) {
        nodes.push(*nodeId);
      }

      leftIndex += 1;
    }

    let rightNodes: Vector<Hir::HirId> = Borrowck::conditionAndNodes(hir, binaryNode.right);
    let mut rightIndex: u64 = 0;

    while (rightIndex < rightNodes.length()) {
      if (let Option::SOME(nodeId) = rightNodes.get(rightIndex)) {
        nodes.push(*nodeId);
      }

      rightIndex += 1;
    }

    return nodes;
  }

  /// Collects the bindings every `let` condition in a condition expression
  /// produced, in declaration order, and schedules the drops a short-circuited
  /// `&&` owes. Mirrors `take_condition_bindings`.
  ///
  /// A single `let` condition *is* the match node the bindings were registered
  /// under, but `let A = f() && let B = g()` is a `&&` whose operands are those
  /// match nodes, so the enclosing `if`/`while` has to walk the chain to find
  /// them. Each `&&` also gets an `onConditionFail` entry for whatever its left
  /// side bound: when its right operand evaluates to false the guarded branch
  /// never runs, and that branch is the only other place those bindings are
  /// dropped.
  ///
  /// Only `&&` is walked. A `let` condition inside `||` is rejected in
  /// typechecking, so no other operator can hold one, and a chain is
  /// left-associated: the left side of a `&&` being true means every `let` in it
  /// succeeded and every binding it names is live.
  function takeConditionBindings(
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    condition: Hir::HirId,
  ): Vector<u32> {
    let Option::SOME(node) = hir.get(condition) else {
      let mut plainRef: &mut Borrowck::State = state;
      return plainRef.takeLetConditionBindings(condition.raw());
    };

    let Hir::HirKind::Binary(binaryNode) = &node.kind else {
      let mut plainRef: &mut Borrowck::State = state;
      return plainRef.takeLetConditionBindings(condition.raw());
    };

    let isAnd: boolean = match (binaryNode.operation) {
      Hir::BinaryOperation::And -> true,
      _ -> false,
    };

    if (!isAnd) {
      let mut plainRef: &mut Borrowck::State = state;
      return plainRef.takeLetConditionBindings(condition.raw());
    }

    let leftId: Hir::HirId = binaryNode.left;
    let rightId: Hir::HirId = binaryNode.right;

    let mut bindings: Vector<u32> = Borrowck::takeConditionBindings(hir, state, schedules, leftId);

    if (!bindings.isEmpty()) {
      // Drop order is the reverse of declaration order, like any other scope.
      let mut owed: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut owedIndex: u64 = bindings.length();

      while (owedIndex > 0) {
        owedIndex -= 1;

        if (let Option::SOME(defRaw) = bindings.get(owedIndex)) {
          owed.push(Id::fromRaw<Analyzer::DefinitionTag>(*defRaw));
        }
      }

      let mut scheduleRef: &mut Hir::DropSchedules = schedules;
      scheduleRef.setConditionFail(condition, owed);
    }

    // The mirror image of the entry above. A false left operand skips the right
    // one whole, so every `let` in it binds nothing and moves nothing: the
    // places those `let`s were recorded against are still live, and scope end
    // already wrote them off as moved. This path is where they are freed.
    let skipped: Vector<u32> = Borrowck::conditionScrutineePlaces(hir, &*state, rightId);

    if (!skipped.isEmpty()) {
      let mut skippedOwed: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut skippedIndex: u64 = skipped.length();

      while (skippedIndex > 0) {
        skippedIndex -= 1;

        if (let Option::SOME(defRaw) = skipped.get(skippedIndex)) {
          skippedOwed.push(Id::fromRaw<Analyzer::DefinitionTag>(*defRaw));
        }
      }

      let mut skipRef: &mut Hir::DropSchedules = schedules;
      skipRef.setConditionSkip(condition, skippedOwed);
    }

    let rightBindings: Vector<u32> = Borrowck::takeConditionBindings(hir, state, schedules, rightId);
    let mut rightIndex: u64 = 0;

    while (rightIndex < rightBindings.length()) {
      if (let Option::SOME(defRaw) = rightBindings.get(rightIndex)) {
        bindings.push(*defRaw);
      }

      rightIndex += 1;
    }

    return bindings;
  }

  function checkIf(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    ifNode: &Hir::HirIf,
    ifId: Hir::HirId,
    span: SourceSpan,
  ): void {
    Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, ifNode.condition);

    let mut statementPositionRef: &mut Borrowck::State = state;
    let ifValueIsUsed: boolean = !statementPositionRef.isStatementPosition(ifId.raw()) && Borrowck::nodeProducesValue(typeStore, hir, ifId);

    let conditionBindings: Vector<u32> = Borrowck::takeConditionBindings(hir, state, schedules, ifNode.condition);

    let preReachable: boolean = state.reachable;
    let preMoves: Borrowck::MoveSnapshot = state.snapshotMoves();
    let preBorrows: Borrowck::BorrowSnapshot = state.snapshotBorrows();

    let mut thenRef: &mut Borrowck::State = state;
    thenRef.setReachable(preReachable);

    Borrowck::checkGuardedBranch(
      defStore,
      typeStore,
      symbols,
      hir,
      state,
      diagnostics,
      schedules,
      ifNode.thenBranch,
      &conditionBindings,
    );

    Borrowck::forgetConditionBindings(state, &conditionBindings);

    let mut thenOwner: Option<u32> = Option::NONE;

    if (ifValueIsUsed) {
      Borrowck::rejectBranchMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, ifNode.thenBranch, span);
      thenOwner = Borrowck::consumeBranchResultOwner(defStore, typeStore, hir, state, schedules, ifNode.thenBranch, span);
    }

    let mut thenMoves: Borrowck::MoveSnapshot = state.snapshotMoves();
    let thenBorrows: Borrowck::BorrowSnapshot = state.snapshotBorrows();
    let thenReachable: boolean = state.reachable;

    // The no-else join returns from here rather than sharing a tail with the
    // else-branch path below: both paths consume `preMoves` and `thenMoves`,
    // and each snapshot may only be moved once per path.
    if (ifNode.elseBranch.isNone()) {
      let mut mergeRef: &mut Borrowck::State = state;
      mergeRef.mergeBorrowsWith(&preBorrows);
      mergeRef.setReachable(thenReachable || preReachable);

      if (!thenReachable) {
        let mut restoreRef: &mut Borrowck::State = state;
        restoreRef.restoreMoves(&preMoves);
        return;
      }

      let mut noElseBranches: Vector<Borrowck::MoveSnapshot> = Vector::new<Borrowck::MoveSnapshot>();
      noElseBranches.push(thenMoves);
      noElseBranches.push(preMoves);
      Borrowck::mergeMoveBranches(defStore, symbols, state, diagnostics, &noElseBranches, span);
      return;
    }

    let Option::SOME(elseBranch) = ifNode.elseBranch else {
      return;
    };

    let mut elseRef: &mut Borrowck::State = state;
    elseRef.restoreMoves(&preMoves);
    elseRef.restoreBorrows(&preBorrows);
    elseRef.setReachable(preReachable);

    Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, elseBranch);

    let mut elseOwner: Option<u32> = Option::NONE;

    if (ifValueIsUsed) {
      Borrowck::rejectBranchMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, elseBranch, span);
      elseOwner = Borrowck::consumeBranchResultOwner(defStore, typeStore, hir, state, schedules, elseBranch, span);
    }

    let mut elseMoves: Borrowck::MoveSnapshot = state.snapshotMoves();
    let elseReachable: boolean = state.reachable;

    let mut borrowRef: &mut Borrowck::State = state;
    borrowRef.mergeBorrowsWith(&thenBorrows);
    borrowRef.setReachable(thenReachable || elseReachable);

    // An owner one branch hands to the result is still owned on the
    // other branch, which is the last point where it is live: it is dropped
    // at the end of that branch, and moved on every path afterwards.
    if (let Option::SOME(owner) = thenOwner) {
      Borrowck::dropUntakenBranchOwner(schedules, &mut elseMoves, elseBranch, elseReachable, owner);
    }

    if (let Option::SOME(owner) = elseOwner) {
      Borrowck::dropUntakenBranchOwner(schedules, &mut thenMoves, ifNode.thenBranch, thenReachable, owner);
    }

    if (thenReachable && elseReachable) {
      let mut branches: Vector<Borrowck::MoveSnapshot> = Vector::new<Borrowck::MoveSnapshot>();
      branches.push(thenMoves);
      branches.push(elseMoves);
      Borrowck::mergeMoveBranches(defStore, symbols, state, diagnostics, &branches, span);
      return;
    }

    if (thenReachable) {
      let mut takeThenRef: &mut Borrowck::State = state;
      takeThenRef.restoreMoves(&thenMoves);
      return;
    }

    if (elseReachable) {
      return;
    }

    // Neither branch reaches the join, so nothing downstream observes the
    // state; the oracle still keeps the most restrictive of the two.
    Borrowck::conservativeMergeMoves(state, &thenMoves);
  }

  /// The value a branch of a used `if` produces flows out of it, so producing
  /// it from borrowed storage moves out of a borrow just as a `let` or a
  /// `return` would. A block-bodied branch hides a borrowed binding behind its
  /// block node, so its tail binding is checked too, as match arms do.
  function rejectBranchMoveOutOfBorrow(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    branch: Hir::HirId,
    span: SourceSpan,
  ): void {
    if (!state.reachable) {
      return;
    }

    Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, branch);

    let Option::SOME(result) = Borrowck::armResultBinding(hir, branch) else {
      return;
    };

    let handedOnDirectly: boolean = Borrowck::isBorrowedBindingNode(hir, state, branch);
    let resultOwnsValue: boolean = Borrowck::definitionNeedsDrop(defStore, typeStore, result) || state.isMoveOnlyClosureOwner(result.raw());

    if (!handedOnDirectly && state.isBorrowedBinding(result.raw()) && resultOwnsValue) {
      Borrowck::emitCannotMoveOutOfBorrow(state, diagnostics, Option::SOME(result), span);
    }
  }

  /// Moves the owned binding a branch of a used `if` (a conditional
  /// expression included) produces as its value into that value, returning
  /// the owner it moved. The binding is either a value whose type needs a
  /// drop or a move-only closure owner; without the move, the binding would
  /// still be dropped at its scope end after the result took its bytes. A
  /// borrowed binding names storage the `if` never owned, so it is left alone,
  /// exactly as a match arm leaves it.
  function consumeBranchResultOwner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    schedules: &mut Hir::DropSchedules,
    branch: Hir::HirId,
    span: SourceSpan,
  ): Option<u32> {
    if (!state.reachable) {
      return Option::NONE;
    }

    let Option::SOME(result) = Borrowck::armResultBinding(hir, branch) else {
      return Option::NONE;
    };

    let ownsValue: boolean = Borrowck::definitionNeedsDrop(defStore, typeStore, result) || state.isMoveOnlyClosureOwner(result.raw());

    if (!ownsValue || state.isBorrowedBinding(result.raw()) || !state.isMoveValid(result.raw())) {
      return Option::NONE;
    }

    Borrowck::tryConsume(state, schedules, result, span, Borrowck::OwnershipReport::CONSUMER_ARM_RESULT);

    return Option::SOME(result.raw());
  }

  /// Schedules the drop of `owner` at the end of `branch` when the other
  /// branch moved it but this one still holds it.
  function dropUntakenBranchOwner(
    schedules: &mut Hir::DropSchedules,
    branchMoves: &mut Borrowck::MoveSnapshot,
    branch: Hir::HirId,
    branchReachable: boolean,
    owner: u32,
  ): void {
    let Option::SOME(value) = Borrowck::snapshotValue(&*branchMoves, owner) else {
      return;
    };

    if (value != Borrowck::MOVE_VALID) {
      return;
    }

    if (branchReachable) {
      let mut dropped: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      dropped.push(Id::fromRaw<Analyzer::DefinitionTag>(owner));

      let mut schedulesRef: &mut Hir::DropSchedules = schedules;
      schedulesRef.appendMatchArmEnd(branch, dropped);
    }

    Borrowck::setSnapshotValue(branchMoves, owner, Borrowck::MOVE_MOVED);
  }

  function checkLetElse(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    letElse: &Hir::HirLetElse,
    span: SourceSpan,
  ): void {
    Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, letElse.value);

    // The else block always diverges, so nothing it does reaches the code that
    // follows the binding: like a diverging `if` branch, its moves and borrows
    // must not survive it. The diagnostics it produced are already recorded.
    let savedReachable: boolean = state.reachable;
    let savedMoves: Borrowck::MoveSnapshot = state.snapshotMoves();
    let savedBorrows: Borrowck::BorrowSnapshot = state.snapshotBorrows();

    Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, letElse.elseBlock);

    let mut restoreRef: &mut Borrowck::State = state;
    restoreRef.restoreMoves(&savedMoves);
    restoreRef.restoreBorrows(&savedBorrows);
    restoreRef.setReachable(savedReachable);

    let mut bindings: Vector<u32> = Vector::new<u32>();
    Borrowck::collectDroppableBindings(defStore, typeStore, &letElse.pattern, &mut bindings);

    // A let-else destructures the same way a match arm does, so a binding taken
    // out of a reference-typed value names borrowed storage for as long as it
    // lives — which here is the enclosing scope, not one arm.
    let bindsBorrowedPayloads: boolean = Borrowck::bindsBorrowedPayloads(typeStore, hir, state, letElse.value);

    // A binding that takes an owned payload out of the scrutinee leaves the
    // scrutinee variable without it: the variable is consumed here so its
    // scope-end drop does not free the payload a second time. Mirrors the
    // scrutinee consumption in the oracle's `LetElse` arm.
    if (bindings.length() > 0 && !bindsBorrowedPayloads) {
      if (let Option::SOME(source) = Borrowck::movedVariable(defStore, typeStore, hir, letElse.value)) {
        Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_PATTERN);
      }
    }

    // A tuple literal borrows element by element, as a tuple `match` scrutinee does.
    let mut borrowedElementBindings: Vector<u32> = Vector::new<u32>();

    if (!bindsBorrowedPayloads) {
      Borrowck::collectBorrowedTupleElementBindings(
        defStore,
        typeStore,
        hir,
        state,
        letElse.value,
        &letElse.pattern,
        &mut borrowedElementBindings,
      );
    }

    let scrutineeOwner: Borrowck::ViewOwner = Borrowck::storageOwnerOf(defStore, typeStore, hir, state, letElse.value);
    let bindingDepth: u64 = state.scopeDepth();

    Borrowck::recordCopiedViewBindings(defStore, typeStore, symbols, hir, state, diagnostics, &letElse.pattern, letElse.value, bindingDepth, true, span);
    let mut index: u64 = 0;

    while (index < bindings.length()) {
      if (let Option::SOME(defRaw) = bindings.get(index)) {
        let bindingIsBorrowed: boolean = bindsBorrowedPayloads || Borrowck::containsRaw(&mut borrowedElementBindings, *defRaw);
        Borrowck::recordPatternBindingStorage(defStore, symbols, hir, state, diagnostics, *defRaw, bindingIsBorrowed, &scrutineeOwner, bindingDepth, true, span);

        if (bindingIsBorrowed) {
          // The payload stays in the referenced storage: the binding is live
          // but owns nothing, so it gets no drop of its own.
          Borrowck::notePatternBinding(state, *defRaw, span);

          let mut borrowedRef: &mut Borrowck::State = state;
          borrowedRef.setMoveValue(*defRaw, Borrowck::MOVE_VALID);
          borrowedRef.markBorrowedBinding(*defRaw);
          let mut schedulesRef: &mut Hir::DropSchedules = schedules;
          schedulesRef.addBorrowedPatternBinding(Id::fromRaw<Analyzer::DefinitionTag>(*defRaw));
        } else {
          // Unlike a match arm binding, a let-else binding outlives the
          // construct and belongs to the enclosing scope, so it is declared
          // owned there and dropped at that scope's end. Mirrors
          // `declare_owned_pattern_bindings`.
          Borrowck::declarePatternClosureOwner(defStore, typeStore, state, *defRaw);
          Borrowck::declareOwned(state, Id::fromRaw<Analyzer::DefinitionTag>(*defRaw));
        }
      }

      index += 1;
    }
  }

  function checkMatch(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    matchNode: &Hir::HirMatch,
    matchId: Hir::HirId,
    span: SourceSpan,
  ): void {
    Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, matchNode.scrutinee);

    let mut scrutineeType: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(0);

    if (let Option::SOME(scrutineeNode) = hir.get(matchNode.scrutinee)) {
      scrutineeType = scrutineeNode.typeId;
    }

    // A binding destructured out of a reference names a place in the referent, so
    // matching it again moves nothing: its own bindings borrow the same storage.
    // Mirrors `scrutinee_is_borrowed_binding`.
    let scrutineeIsBorrowedBinding: boolean = Borrowck::isBorrowedBindingNode(hir, state, matchNode.scrutinee);
    let movesScrutineePayload: boolean = !scrutineeIsBorrowedBinding && Borrowck::armsMoveScrutineePayload(
      defStore,
      typeStore,
      scrutineeType,
      &matchNode.arms,
    );
    let scrutineeIsBorrowed: boolean = Borrowck::fieldBaseIsBorrowed(typeStore, hir, state, matchNode.scrutinee);

    // Mirrors the `moves_scrutinee_payload` branch of `check_match`. A borrowed
    // base wins over consuming the scrutinee's owner: taking the payload out of
    // storage reached through a reference moves out of a borrow, and the
    // referent still drops the field the match would take.

    // Set when the payload was moved out of a field of a value we own. Reading
    // that field by value is a partial move: LIR lowering marks the field moved,
    // so the owner's own drop skips it and the match is the only holder of those
    // bytes. Ownership of the payload then rests with the arm's pattern bindings
    // and nowhere else. The owner keeps every other drop it owed.
    let mut armBindingsOwnPayload: boolean = false;

    let isLetConditionMatch: boolean = Borrowck::armsAreLetConditionDesugaring(hir, &matchNode.arms);

    if (movesScrutineePayload) {
      if (scrutineeIsBorrowed) {
        Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, matchNode.scrutinee);
      } else if (let Option::SOME(source) = Borrowck::movedVariable(defStore, typeStore, hir, matchNode.scrutinee)) {
        Borrowck::recordLetConditionScrutinee(defStore, typeStore, state, matchId, source, isLetConditionMatch);
        Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_PATTERN);
      } else if (let Option::SOME(_owner) = Borrowck::movedFieldOwner(defStore, typeStore, hir, matchNode.scrutinee)) {
        armBindingsOwnPayload = true;
      } else {
        // Neither a local nor a field of one we own, so the payload sits behind
        // a reference and cannot be moved out at all.
        Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, matchNode.scrutinee);
      }
    } else if (!scrutineeIsBorrowedBinding) {
      if (let Option::SOME(source) = Borrowck::movedVariable(defStore, typeStore, hir, matchNode.scrutinee)) {
        Borrowck::recordLetConditionScrutinee(defStore, typeStore, state, matchId, source, isLetConditionMatch);
        Borrowck::tryConsume(state, schedules, source, span, Borrowck::OwnershipReport::CONSUMER_PATTERN);
      }
    }
    let aliasesExternalStorage: boolean = Borrowck::aliasesExternalStorage(hir, matchNode.scrutinee);
    let bindsBorrowedPayloads: boolean = Borrowck::bindsBorrowedPayloads(typeStore, hir, state, matchNode.scrutinee);
    let scrutineeOwner: Borrowck::ViewOwner = Borrowck::storageOwnerOf(defStore, typeStore, hir, state, matchNode.scrutinee);

    // Whether the match owns what a pattern takes out of it: the scrutinee is an owning
    // value and some pattern moves an owning payload out of it.
    let scrutineeOwnsMovedPayload: boolean = movesScrutineePayload && Borrowck::needsDropType(defStore, typeStore, scrutineeType);

    // Whether an arm's bindings are this match's to free — the same test
    // `recordMatchArmDrops` applies. A borrowed payload still belongs to the
    // referent, and a `let` condition's binding belongs to the branch that
    // condition guards. Mirrors `arms_own_their_bindings`.
    let armsOwnTheirBindings: boolean = (!aliasesExternalStorage || armBindingsOwnPayload) && !bindsBorrowedPayloads && !isLetConditionMatch;

    let preReachable: boolean = state.reachable;
    let preMoves: Borrowck::MoveSnapshot = state.snapshotMoves();

    let mut branches: Vector<Borrowck::MoveSnapshot> = Vector::new<Borrowck::MoveSnapshot>();
    let mut anyReachable: boolean = false;
    let mut armIndex: u64 = 0;

    // Values outside the match that one arm hands to the match result. The move is real
    // on that arm's path and only there, so the arms that did not make it still own the
    // value and owe its drop — see the compensation pass after the loop. Mirrors the
    // Rust `arm_result_moves`.
    //
    // A match nested in an arm of this one hands its own result straight through to
    // this match's result, so whatever it moved this match moved too: the frame it
    // pushes here is drained into this one when it finishes, and the compensation below
    // pays for it in the arms of *this* match that never took that path.
    let mut frameRef: &mut Borrowck::State = state;
    frameRef.pushArmResultMoveFrame();

    // Only a match whose value is used hands anything over. In statement position the
    // value is discarded, so an arm naming an owning value has given it to nobody and
    // the name still owes its drop.
    let mut statementPositionRef: &mut Borrowck::State = state;
    let matchValueIsUsed: boolean = !statementPositionRef.isStatementPosition(matchId.raw());
    let matchProducesValue: boolean = Borrowck::nodeProducesValue(typeStore, hir, matchId);

    // This arm's own reachability, parallel to `branches`, so the compensation pass
    // below can tell which arms actually reach their end and owe the compensating drop.
    let mut armReachableByIndex: Vector<boolean> = Vector::new<boolean>();

    while (armIndex < matchNode.arms.length()) {
      let Option::SOME(arm) = matchNode.arms.get(armIndex) else {
        armIndex += 1;
        continue;
      };

      let mut armRef: &mut Borrowck::State = state;
      armRef.restoreMoves(&preMoves);
      armRef.setReachable(preReachable);

      let mut bindings: Vector<u32> = Vector::new<u32>();
      Borrowck::collectDroppableBindings(defStore, typeStore, &arm.pattern, &mut bindings);

      // A tuple scrutinee borrows element by element: the bindings a pattern takes
      // out of a borrowed element are borrowed, the others are owned as usual.
      let mut borrowedElementBindings: Vector<u32> = Vector::new<u32>();

      if (!bindsBorrowedPayloads) {
        Borrowck::collectBorrowedTupleElementBindings(
          defStore,
          typeStore,
          hir,
          state,
          matchNode.scrutinee,
          &arm.pattern,
          &mut borrowedElementBindings,
        );
      }

      let mut ownedBindings: Vector<u32> = Vector::new<u32>();
      let borrowedMark: u64 = state.borrowedBindingCount();
      let mut bindingIndex: u64 = 0;

      // Arm bindings live in the scope the arm opens, one deeper than the
      // match; a `let` condition's bindings live in the branch it guards, which
      // sits at the same depth.
      let armDepth: u64 = state.scopeDepth() + 1;

      Borrowck::recordCopiedViewBindings(defStore, typeStore, symbols, hir, state, diagnostics, &arm.pattern, matchNode.scrutinee, armDepth, false, span);

      while (bindingIndex < bindings.length()) {
        if (let Option::SOME(defRaw) = bindings.get(bindingIndex)) {
          let bindingIsBorrowed: boolean = bindsBorrowedPayloads || Borrowck::containsRaw(&mut borrowedElementBindings, *defRaw);
          Borrowck::recordPatternBindingStorage(defStore, symbols, hir, state, diagnostics, *defRaw, bindingIsBorrowed, &scrutineeOwner, armDepth, false, span);

          if (!bindingIsBorrowed) {
            ownedBindings.push(*defRaw);
            Borrowck::declarePatternClosureOwner(defStore, typeStore, state, *defRaw);
          }

          if (bindingIsBorrowed) {
            Borrowck::notePatternBinding(state, *defRaw, span);
          }

          let mut declareRef: &mut Borrowck::State = state;
          declareRef.setMoveValue(*defRaw, Borrowck::MOVE_VALID);

          // Destructuring a reference leaves the payload where it was: the
          // binding names borrowed storage, and handing it on moves out of it.
          if (bindingIsBorrowed) {
            declareRef.markBorrowedBinding(*defRaw);
            let mut schedulesRef: &mut Hir::DropSchedules = schedules;
            schedulesRef.addBorrowedPatternBinding(Id::fromRaw<Analyzer::DefinitionTag>(*defRaw));
          }
        }

        bindingIndex += 1;
      }

      // An arm binding is live for the whole arm, including the paths that leave
      // it early. Opening a scope that owns those bindings is what puts them in
      // front of `exitDrops`, so a `return`, `break` or `continue` inside the arm
      // body frees them like any other local in scope. The scope carries no block,
      // so `exitScope` writes no schedule of its own and the fall-through path
      // keeps the match-arm-end schedule `recordMatchArmDrops` writes below.
      // Mirrors the arm scope `check_match` pushes.
      if (armsOwnTheirBindings) {
        let mut armScopeRef: &mut Borrowck::State = state;
        armScopeRef.pushScope(0, false, false);

        let mut ownedIndex: u64 = 0;

        while (ownedIndex < ownedBindings.length()) {
          if (let Option::SOME(defRaw) = ownedBindings.get(ownedIndex)) {
            armScopeRef.pushOwned(*defRaw);
          }

          ownedIndex += 1;
        }
      }

      if (let Option::SOME(guard) = arm.guard) {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, guard);
      }

      if (state.reachable) {
        if (matchValueIsUsed) {
          Borrowck::markTailHandoverChain(hir, state, arm.body);
        }

        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, arm.body);

        // The arm's value flows out of the match, so producing it from borrowed
        // storage moves out of a borrow just as a `let` or a `return` would. A
        // match in statement position discards a dereferenced reference without
        // taking it: the referent's owner still frees it, so nothing moved.
        if (matchValueIsUsed || !Borrowck::dereferencesReference(typeStore, hir, arm.body)) {
          Borrowck::rejectMoveOutOfBorrow(defStore, typeStore, hir, state, diagnostics, arm.body);
        }

        if (let Option::SOME(result) = Borrowck::armResultBinding(hir, arm.body)) {
          // A block-bodied arm hides the binding behind its block node, so the
          // rejection above never sees it; this walk does.
          let handedOnDirectly: boolean = Borrowck::isBorrowedBindingNode(hir, state, arm.body);
          let resultIsBorrowed: boolean = state.isBorrowedBinding(result.raw());
          let resultOwnsValue: boolean = Borrowck::definitionNeedsDrop(defStore, typeStore, result) || state.isMoveOnlyClosureOwner(result.raw());

          if (!handedOnDirectly && resultIsBorrowed && resultOwnsValue) {
            Borrowck::emitCannotMoveOutOfBorrow(state, diagnostics, Option::SOME(result), span);
          }

          // A borrowed pattern binding names storage the match never owned; the
          // rejection above already reported it and consuming it would schedule a
          // drop for the referent.
          //
          // The arm's own binding is handed over only when LIR lowering stores the
          // arm's value into the match result, which it does when the match
          // produces a value that is used. A match typed `void` stores nothing, and
          // neither does one whose value is discarded (`Hir::DropSchedules::
          // discardedResults`), so the binding stays owned and the arm-end schedule
          // frees it.
          if (Borrowck::containsRaw(&mut bindings, result.raw())) {
            if (matchProducesValue && matchValueIsUsed) {
              Borrowck::tryConsume(state, schedules, result, span, Borrowck::OwnershipReport::CONSUMER_ARM_RESULT);
            }
          } else if (matchValueIsUsed && !resultIsBorrowed && state.isMoveValid(result.raw()) && resultOwnsValue) {
            Borrowck::tryConsume(state, schedules, result, span, Borrowck::OwnershipReport::CONSUMER_ARM_RESULT);
            let mut recordRef: &mut Borrowck::State = state;
            recordRef.recordArmResultMove(result.raw());
          }
        }
      }

      if (armsOwnTheirBindings) {
        Borrowck::exitScope(state, schedules);
      }

      Borrowck::recordMatchArmDrops(
        state,
        schedules,
        hir,
        &ownedBindings,
        matchId,
        arm.body,
        aliasesExternalStorage,
        armBindingsOwnPayload,
        bindsBorrowedPayloads,
        scrutineeOwnsMovedPayload,
        isLetConditionMatch,
      );

      let mut removeIndex: u64 = 0;

      while (removeIndex < bindings.length()) {
        if (let Option::SOME(defRaw) = bindings.get(removeIndex)) {
          let mut removeRef: &mut Borrowck::State = state;
          removeRef.removeMoveValue(*defRaw);
        }

        removeIndex += 1;
      }

      // An arm-scoped binding stops being borrowed when the arm ends. A `let`
      // condition's binding does not: its arm body is a literal and the value is
      // still live in the branch the condition guards, which has to see it as
      // borrowed for the same reason the arm did. The oracle never drops these
      // marks at all, so keeping them here is what matches it.
      if (!Borrowck::bodyIsLiteral(hir, arm.body)) {
        let mut borrowedRef: &mut Borrowck::State = state;
        borrowedRef.truncateBorrowedBindings(borrowedMark);
      }

      branches.push(state.snapshotMoves());
      armReachableByIndex.push(state.reachable);

      if (state.reachable) {
        anyReachable = true;
      }

      armIndex += 1;
    }

    // A value handed to the match result by one arm leaves the match owned by the
    // result on that path alone. Every other arm still holds it and is the last point
    // where it is live and unowned, so its drop goes at the end of those arms. Marking
    // it moved in all of them is then the truth on every path — and is what keeps the
    // cross-arm merge from reading a real one-sided transfer as an inconsistent move.
    //
    // Popping also drains this frame into the enclosing match's frame, if any: whatever
    // this match handed over, the match that encloses it handed over too, and its own
    // arms have to pay for it the same way.
    let mut popFrameRef: &mut Borrowck::State = state;
    let armResultMoves: Vector<u32> = popFrameRef.popArmResultMoveFrame();

    let mut resultMoveIndex: u64 = 0;

    while (resultMoveIndex < armResultMoves.length()) {
      let Option::SOME(defRaw) = armResultMoves.get(resultMoveIndex) else {
        resultMoveIndex += 1;
        continue;
      };
      let movedDefRaw: u32 = *defRaw;

      let mut branchIndex: u64 = 0;

      while (branchIndex < branches.length()) {
        let mut isValidHere: boolean = false;

        if (let Option::SOME(branch) = branches.get(branchIndex)) {
          if (let Option::SOME(value) = Borrowck::snapshotValue(branch, movedDefRaw)) {
            isValidHere = value == Borrowck::MOVE_VALID;
          }
        }

        if (isValidHere) {
          let mut reachableHere: boolean = false;

          if (let Option::SOME(flag) = armReachableByIndex.get(branchIndex)) {
            reachableHere = *flag;
          }

          if (reachableHere) {
            if (let Option::SOME(arm) = matchNode.arms.get(branchIndex)) {
              let mut compensated: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
              compensated.push(Id::fromRaw<Analyzer::DefinitionTag>(movedDefRaw));
              let mut schedulesRef: &mut Hir::DropSchedules = schedules;
              schedulesRef.appendMatchArmEnd(arm.body, compensated);
            }
          }

          if (let Option::SOME(branch) = branches.getMut(branchIndex)) {
            Borrowck::setSnapshotValue(branch, movedDefRaw, Borrowck::MOVE_MOVED);
          }
        }

        branchIndex += 1;
      }

      resultMoveIndex += 1;
    }

    if (branches.isEmpty()) {
      return;
    }

    Borrowck::mergeMoveBranches(defStore, symbols, state, diagnostics, &branches, span);

    let mut reachRef: &mut Borrowck::State = state;
    reachRef.setReachable(anyReachable);
  }

  /// Drops a loop condition's skip drops when a second iteration could reach
  /// them with the place already moved, and reports that second read as the use
  /// of a moved value it is. Mirrors `reject_repeated_condition_skip`.
  function rejectRepeatedConditionSkip(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    condition: Hir::HirId,
  ): void {
    let nodes: Vector<Hir::HirId> = Borrowck::conditionAndNodes(hir, condition);
    let mut index: u64 = 0;

    while (index < nodes.length()) {
      let Option::SOME(nodeId) = nodes.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(node) = hir.get(*nodeId) else {
        index += 1;
        continue;
      };

      let span: SourceSpan = node.span;
      let places: Vector<Analyzer::DefinitionId> = schedules.conditionSkipDrops(*nodeId);
      let mut stale: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut placeIndex: u64 = 0;

      while (placeIndex < places.length()) {
        if (let Option::SOME(defId) = places.get(placeIndex)) {
          if (!state.isMoveValid(defId.raw())) {
            stale.push(*defId);
          }
        }

        placeIndex += 1;
      }

      if (stale.isEmpty()) {
        index += 1;
        continue;
      }

      let mut clearRef: &mut Hir::DropSchedules = schedules;
      clearRef.clearConditionSkip(*nodeId);

      let mut staleIndex: u64 = 0;

      while (staleIndex < stale.length()) {
        if (let Option::SOME(defId) = stale.get(staleIndex)) {
          Borrowck::emitUseAfterMove(defStore, typeStore, symbols, state, diagnostics, *defId, span);
        }

        staleIndex += 1;
      }

      index += 1;
    }
  }

  /// Loop bodies are walked twice: once for the first iteration, then once
  /// more from the back-edge state so a value moved in the body is reported on
  /// the second iteration. The second pass collects into its own bag so that
  /// only genuinely new messages survive. Mirrors `check_loop`.
  function checkLoop(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    loopNode: &Hir::HirLoop,
  ): void {
    let mut update: Option<Hir::HirId> = Option::NONE;
    let mut whileCondition: Option<Hir::HirId> = Option::NONE;
    let mut conditionBindings: Vector<u32> = Vector::new<u32>();
    let mut conditionScrutinees: Vector<u32> = Vector::new<u32>();

    match (&loopNode.condition) {
      Hir::LoopKind::Infinite -> {},
      Hir::LoopKind::While(condition) -> {
        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, condition);

        conditionScrutinees = Borrowck::conditionScrutineePlaces(hir, &*state, condition);
        conditionBindings = Borrowck::takeConditionBindings(hir, state, schedules, condition);
        whileCondition = Option::SOME(condition);
      },
      Hir::LoopKind::For(forLoop) -> {
        if (let Option::SOME(init) = forLoop.init) {
          Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, init);
        }

        if (let Option::SOME(condition) = forLoop.condition) {
          Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, condition);

          conditionScrutinees = Borrowck::conditionScrutineePlaces(hir, &*state, condition);
        }

        update = forLoop.update;
      },
    };

    let preLoopMoves: Borrowck::MoveSnapshot = state.snapshotMoves();
    let preLoopBorrows: Borrowck::BorrowSnapshot = state.snapshotBorrows();
    let preBodyReachable: boolean = state.reachable;

    // The loop marker scope carries no block of its own, so it never receives
    // a scope-end schedule; it exists so `break` and `continue` know how far
    // to unwind. Mirrors the oracle's loop `ScopeEntry`.
    let mut enterRef: &mut Borrowck::State = state;
    enterRef.pushScope(0, false, true);
    enterRef.pushLoop(&conditionScrutinees);

    Borrowck::checkGuardedBranch(
      defStore,
      typeStore,
      symbols,
      hir,
      state,
      diagnostics,
      schedules,
      loopNode.body,
      &conditionBindings,
    );

    let bodyFallsThrough: boolean = state.reachable;
    let continueSeen: boolean = state.continueSeen();

    if (let Option::SOME(updateId) = update) {
      if (bodyFallsThrough || continueSeen) {
        let mut updateRef: &mut Borrowck::State = state;
        updateRef.setReachable(true);

        Borrowck::checkNode(defStore, typeStore, symbols, hir, state, diagnostics, schedules, updateId);
      }
    }

    // A skip drop in a loop condition fires on the iteration that ends the loop,
    // so the place it names has to still hold a value then. If an earlier
    // iteration already let the `let` take that place apart and the body never
    // put a value back, the drop would free what the binding already owns — and
    // the condition itself reads a place it moved out of. Reporting that read is
    // what keeps the skip path honest; the shape stays available with a body
    // that reassigns the place. Mirrors `reject_repeated_condition_skip`.
    if (let Option::SOME(conditionId) = whileCondition) {
      if (bodyFallsThrough || continueSeen) {
        Borrowck::rejectRepeatedConditionSkip(
          defStore,
          typeStore,
          symbols,
          hir,
          state,
          diagnostics,
          schedules,
          conditionId,
        );
      }
    }

    if (bodyFallsThrough || continueSeen) {
      Borrowck::conservativeMergeMoves(state, &preLoopMoves);

      let mut secondRef: &mut Borrowck::State = state;
      secondRef.setReachable(preBodyReachable);

      let mut secondPass: DiagnosticBag = DiagnosticBag::init();

      // Everything from here to the end of the second pass is a re-walk of
      // nodes the first pass already reported on, so its events would be
      // duplicates of events already recorded. Nesting is handled by restoring
      // the previous value rather than clearing it, because an inner loop's
      // first pass inside an outer loop's second pass is still a re-walk.
      let suppressedBefore: boolean = state.reportIsSuppressed();
      let mut suppressRef: &mut Borrowck::State = state;
      suppressRef.setReportSuppressed(true);

      Borrowck::checkGuardedBranch(
        defStore,
        typeStore,
        symbols,
        hir,
        state,
        &mut secondPass,
        schedules,
        loopNode.body,
        &conditionBindings,
      );

      let secondFallsThrough: boolean = state.reachable;
      let secondContinueSeen: boolean = state.continueSeen();

      if (let Option::SOME(updateId) = update) {
        if (secondFallsThrough || secondContinueSeen) {
          let mut updateRef: &mut Borrowck::State = state;
          updateRef.setReachable(true);

          Borrowck::checkNode(defStore, typeStore, symbols, hir, state, &mut secondPass, schedules, updateId);
        }
      }

      let mut restoreRef: &mut Borrowck::State = state;
      restoreRef.setReportSuppressed(suppressedBefore);

      Borrowck::appendNewDiagnostics(diagnostics, &secondPass);
    }

    let mut exitRef: &mut Borrowck::State = state;
    exitRef.popLoop();

    Borrowck::exitScope(state, schedules);

    Borrowck::forgetConditionBindings(state, &conditionBindings);

    Borrowck::conservativeMergeMoves(state, &preLoopMoves);

    let mut finalRef: &mut Borrowck::State = state;
    finalRef.mergeBorrowsWith(&preLoopBorrows);
    finalRef.setReachable(preBodyReachable);
  }

  // --- entry points ---------------------------------------------------------------------

  /// Parameter definitions of a callable, copied out so the caller can keep
  /// mutating the definition store. `NONE` for every other definition kind.
  function callableParams(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
  ): Option<Vector<Analyzer::DefinitionId>> {
    let Option::SOME(definition) = defStore.get(defId) else {
      return Option::NONE;
    };

    let mut params: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut isCallable: boolean = false;

    match (definition) {
      Analyzer::Definition::Function(functionDef) -> {
        isCallable = true;

        let mut index: u64 = 0;

        while (index < functionDef.params.length()) {
          if (let Option::SOME(paramId) = functionDef.params.get(index)) {
            params.push(*paramId);
          }

          index += 1;
        }
      },
      Analyzer::Definition::Method(methodDef) -> {
        isCallable = true;

        let mut index: u64 = 0;

        while (index < methodDef.params.length()) {
          if (let Option::SOME(paramId) = methodDef.params.get(index)) {
            params.push(*paramId);
          }

          index += 1;
        }
      },
      _ -> {},
    };

    if (!isCallable) {
      return Option::NONE;
    }

    return Option::SOME(params);
  }

  /// The owning values each closure's environment holds by value, keyed by the
  /// closure's thunk: `values[i]` lists the raw definitions for `thunks[i]`.
  record ThunkCaptures {
    public thunks: Vector<u32>;
    public values: Vector<Vector<u32>>;
  }

  /// Collects, for every closure in the store, the by-value captures whose type
  /// needs a drop. The thunk walks its body with these as borrowed bindings,
  /// because the environment keeps owning them between calls.
  function collectThunkCaptures(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
  ): Borrowck::ThunkCaptures {
    let mut result: Borrowck::ThunkCaptures = Borrowck::ThunkCaptures {
      thunks: Vector::new<u32>(),
      values: Vector::new<Vector<u32>>(),
    };
    let mut nodeIndex: u64 = 0;

    while (nodeIndex < hir.nodes.length()) {
      if (let Option::SOME(node) = hir.nodes.get(nodeIndex)) {
        if (let Hir::HirKind::Closure(closureNode) = &node.kind) {
          if (let Option::SOME(thunk) = closureNode.thunkDef) {
            let mut owned: Vector<u32> = Vector::new<u32>();
            let mut captureIndex: u64 = 0;

            while (captureIndex < closureNode.captures.length()) {
              if (let Option::SOME(capture) = closureNode.captures.get(captureIndex)) {
                if (Borrowck::captureIsByValue(&capture.mode) && Borrowck::needsDropType(defStore, typeStore, capture.typeInEnv)) {
                  owned.push(capture.sourceDef.raw());
                }
              }

              captureIndex += 1;
            }

            result.thunks.push(thunk.raw());
            result.values.push(owned);
          }
        }
      }

      nodeIndex += 1;
    }

    return result;
  }

  /// The by-value captures the thunk `functionId` walks as borrowed, or none
  /// when the function is not a closure thunk.
  function environmentCapturesOf(
    captures: &Borrowck::ThunkCaptures,
    functionId: Analyzer::DefinitionId,
  ): Vector<u32> {
    let mut index: u64 = 0;

    while (index < captures.thunks.length()) {
      if (let Option::SOME(thunk) = captures.thunks.get(index)) {
        if (*thunk == functionId.raw()) {
          if (let Option::SOME(values) = captures.values.get(index)) {
            return Borrowck::copyU32Vector(values);
          }
        }
      }

      index += 1;
    }

    return Vector::new<u32>();
  }

  /// Every node that appears directly in a block's statement list, and
  /// therefore in a position whose value is discarded.
  ///
  /// A match in value position hands its arm's value to whatever consumes
  /// the match, so an arm naming an owning value gives it away. A match in
  /// statement position gives it to nobody: the value is dropped as a
  /// temporary and the name still owns what it named, so consuming it there
  /// would leave nothing to free it. Mirrors `collect_statement_position_nodes`.
  ///
  /// Being discarded travels inward. An arm's body *is* the match's result,
  /// and a block's trailing expression is the block's, so a match written in
  /// one of those positions hands its own result to the same nobody.
  /// The bindings an assignment hands a closure environment to. Mirrors
  /// `collect_bindings_assigned_closure_env`.
  function collectBindingsAssignedClosureEnv(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
  ): Vector<u32> {
    let mut result: Vector<u32> = Vector::new<u32>();
    let mut index: u64 = 0;

    while (index < hir.nodes.length()) {
      if (let Option::SOME(node) = hir.nodes.get(index)) {
        if (let Hir::HirKind::Assign(assignNode) = &node.kind) {
          if (let Option::SOME(targetNode) = hir.get(assignNode.target)) {
            if (let Hir::HirKind::Variable(defId) = &targetNode.kind) {
              if (let Option::SOME(targetType) = Borrowck::variableTypeOf(defStore, defId)) {
                // Assigning another closure binding moves that binding's
                // environment into this one.
                let takesBinding: boolean = Hir::typeIsFunction(typeStore, targetType) && (Borrowck::isVariableNode(hir, assignNode.value) || Borrowck::isFieldAccessNode(hir, assignNode.value));

                if (takesBinding || Hir::bindingOwnsClosureEnv(hir, assignNode.value, targetType, typeStore, defStore)) {
                  if (!Borrowck::containsRaw(&mut result, defId.raw())) {
                    result.push(defId.raw());
                  }
                }
              }
            }
          }
        }
      }

      index += 1;
    }

    return result;
  }

  function isFieldAccessNode(hir: &Hir::HirStore, nodeId: Hir::HirId): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    return match (&node.kind) {
      Hir::HirKind::FieldAccess(_) -> true,
      _ -> false,
    };
  }

  function isVariableNode(hir: &Hir::HirStore, nodeId: Hir::HirId): boolean {
    let Option::SOME(node) = hir.get(nodeId) else {
      return false;
    };

    return match (&node.kind) {
      Hir::HirKind::Variable(_) -> true,
      _ -> false,
    };
  }

  /// The bindings an escaping closure captures by value, which is how a closure
  /// value moves into an environment that outlives the frame that built it.
  /// Mirrors `collect_envs_captured_by_escaping_closures`.
  function collectEnvsCapturedByEscapingClosures(hir: &Hir::HirStore): Vector<u32> {
    let mut result: Vector<u32> = Vector::new<u32>();
    let mut index: u64 = 0;

    while (index < hir.nodes.length()) {
      if (let Option::SOME(node) = hir.nodes.get(index)) {
        if (let Hir::HirKind::Closure(closureNode) = &node.kind) {
          if (closureNode.escapes) {
            let mut captureIndex: u64 = 0;

            while (captureIndex < closureNode.captures.length()) {
              if (let Option::SOME(capture) = closureNode.captures.get(captureIndex)) {
                if (let Hir::CaptureMode::ByValue = capture.mode) {
                  if (!Borrowck::containsRaw(&mut result, capture.sourceDef.raw())) {
                    result.push(capture.sourceDef.raw());
                  }
                }
              }

              captureIndex += 1;
            }
          }
        }
      }

      index += 1;
    }

    return result;
  }

  function collectStatementPositionNodes(
    hir: &Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
  ): Vector<u32> {
    let mut result: Vector<u32> = Vector::new<u32>();
    let mut pending: Vector<u32> = Vector::new<u32>();
    let mut index: u64 = 0;

    while (index < hir.nodes.length()) {
      if (let Option::SOME(node) = hir.nodes.get(index)) {
        match (&node.kind) {
          Hir::HirKind::Block(block) -> {
            let mut stmtIndex: u64 = 0;

            while (stmtIndex < block.statements.length()) {
              if (let Option::SOME(stmtId) = block.statements.get(stmtIndex)) {
                Borrowck::discardRaw(&mut result, &mut pending, stmtId.raw());
              }

              stmtIndex += 1;
            }
          },
          // Lowering wraps a statement-position expression in this, so the
          // match itself is the wrapper's child rather than the block's
          // statement.
          Hir::HirKind::ExpressionStatement(inner) -> {
            Borrowck::discardRaw(&mut result, &mut pending, inner.raw());
          },
          _ -> {},
        };
      }

      index += 1;
    }

    // A function returning `void` returns nothing, so the value its body ends
    // with, such as a closure body's tail, is discarded like a statement's. The
    // body checked and lowered is the one registered for the function: a
    // capturing closure's thunk gets a rewritten copy of the closure's body.
    let mut bodyIndex: u64 = 0;

    while (bodyIndex < hir.functionBodies.length()) {
      if (let Option::SOME(functionDef) = hir.functionBodies.keyAt(bodyIndex)) {
        if (let Option::SOME(bodyId) = hir.functionBodies.valueAt(bodyIndex)) {
          if (!Borrowck::functionReturnsValue(defStore, typeStore, functionDef)) {
            Borrowck::discardRaw(&mut result, &mut pending, bodyId.raw());
          }
        }
      }

      bodyIndex += 1;
    }

    while (let Option::SOME(current) = pending.pop()) {
      if (let Option::SOME(node) = hir.nodes.get(current as u64)) {
        match (&node.kind) {
          Hir::HirKind::Match(matchNode) -> {
            let mut armIndex: u64 = 0;

            while (armIndex < matchNode.arms.length()) {
              if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
                Borrowck::discardRaw(&mut result, &mut pending, arm.body.raw());
              }

              armIndex += 1;
            }
          },
          Hir::HirKind::Block(block) -> {
            if (let Option::SOME(tail) = block.expression) {
              Borrowck::discardRaw(&mut result, &mut pending, tail.raw());
            }
          },
          Hir::HirKind::If(ifNode) -> {
            Borrowck::discardRaw(&mut result, &mut pending, ifNode.thenBranch.raw());

            if (let Option::SOME(elseBranch) = ifNode.elseBranch) {
              Borrowck::discardRaw(&mut result, &mut pending, elseBranch.raw());
            }
          },
          _ -> {},
        };
      }
    }

    return result;
  }

  /// The node whose value a body produces: the tail of a block body, nothing
  /// for a block without one, and an expression body itself.
  function bodyResultNode(hir: &Hir::HirStore, bodyId: Hir::HirId): Option<Hir::HirId> {
    let Option::SOME(node) = hir.get(bodyId) else {
      return Option::NONE;
    };

    if (let Hir::HirKind::Block(block) = &node.kind) {
      return block.expression;
    }

    return Option::SOME(bodyId);
  }

  /// Whether the function `functionId` returns a value: its return type is
  /// neither `void` nor `never`.
  function functionReturnsValue(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    functionId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(definition) = defStore.get(functionId) else {
      return true;
    };

    let returnType: Analyzer::TypeId = match (definition) {
      Analyzer::Definition::Function(functionDef) -> functionDef.returnType,
      Analyzer::Definition::Method(methodDef) -> methodDef.returnType,
      _ -> {
        return true;
      },
    };

    let Option::SOME(type_) = typeStore.get(returnType) else {
      return true;
    };

    return match (type_) {
      Analyzer::Type::VOID | Analyzer::Type::NEVER -> false,
      _ -> true,
    };
  }

  /// Record `raw` as discarded and queue it, unless it already was.
  function discardRaw(result: &mut Vector<u32>, pending: &mut Vector<u32>, raw: u32): void {
    if (Borrowck::containsRaw(result, raw)) {
      return;
    }

    let mut discarded: &mut Vector<u32> = result;
    discarded.push(raw);

    let mut queued: &mut Vector<u32> = pending;
    queued.push(raw);
  }

  function checkFunction(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    diagnostics: &mut DiagnosticBag,
    schedules: &mut Hir::DropSchedules,
    functionId: Analyzer::DefinitionId,
    params: &Vector<Analyzer::DefinitionId>,
    bodyId: Hir::HirId,
    statementPositionNodes: &Vector<u32>,
    envsCapturedByEscapingClosures: &Vector<u32>,
    bindingsAssignedClosureEnv: &Vector<u32>,
    environmentCaptures: &Vector<u32>,
    reportEnabled: boolean,
    reportEvents: &mut Vector<Borrowck::OwnershipEvent>,
    ownedBuffer: u32,
  ): void {
    let mut state: Borrowck::State = Borrowck::State::init();
    state.setReportEnabled(reportEnabled);
    state.setStatementPositionNodes(Borrowck::copyU32Vector(statementPositionNodes));
    state.setEnvsCapturedByEscapingClosures(Borrowck::copyU32Vector(envsCapturedByEscapingClosures));
    state.setBindingsAssignedClosureEnv(Borrowck::copyU32Vector(bindingsAssignedClosureEnv));
    state.pushScopeEnding(0, false, false, Borrowck::closingSpanOf(hir, bodyId));
    state.setInDropMethod(Borrowck::isInstanceDropMethod(defStore, symbols, functionId));
    state.setCurrentFunction(functionId);
    state.setOwnedBuffer(ownedBuffer);
    state.setKeepsBorrowsToScopeEnd(Borrowck::functionUsesRawPointers(defStore, typeStore, hir, bodyId, ownedBuffer));

    let mut captureIndex: u64 = 0;

    while (captureIndex < environmentCaptures.length()) {
      if (let Option::SOME(captureRaw) = environmentCaptures.get(captureIndex)) {
        state.markEnvironmentCapture(*captureRaw);
      }

      captureIndex += 1;
    }

    let mut index: u64 = 0;

    while (index < params.length()) {
      if (let Option::SOME(paramId) = params.get(index)) {
        state.recordLocalDepth(paramId.raw(), state.scopeDepth());

        if (Borrowck::definitionNeedsDrop(defStore, typeStore, *paramId)) {
          Borrowck::declareOwned(&mut state, *paramId);
        } else if (Borrowck::paramTakesClosureEnv(defStore, typeStore, &state, *paramId)) {
          state.recordClosureEnvOwner(paramId.raw(), paramId.raw());
          state.markMoveOnlyClosureOwner(paramId.raw());
          Borrowck::declareOwned(&mut state, *paramId);
        }
      }

      index += 1;
    }

    // A body hands its tail out only when the function returns it: the tail of
    // a closure returning `void` is discarded. A closure's thunk body wraps the
    // closure's own body, so the function's return type decides, not the node.
    let bodyReturnsTail: boolean = Borrowck::nodeProducesValue(typeStore, hir, bodyId) && Borrowck::functionReturnsValue(defStore, typeStore, functionId);

    if (bodyReturnsTail) {
      Borrowck::markTailHandoverChain(hir, &mut state, bodyId);
    }

    Borrowck::checkNode(defStore, typeStore, symbols, hir, &mut state, diagnostics, schedules, bodyId);

    // A body's tail is returned like a `return` would return it. A tail that
    // names a binding of the function's root scope, such as a parameter, is
    // not handed over by any block, so without this the function's exit
    // would drop the value it is returning.
    if (bodyReturnsTail && state.reachable) {
      let tail: Hir::HirId = Borrowck::innermostTail(hir, bodyId);
      Borrowck::markTailReturned(defStore, typeStore, hir, &mut state, tail);
      let mut tailSpan: SourceSpan = Borrowck::closingSpanOf(hir, tail);

      if (let Option::SOME(tailNode) = hir.get(tail)) {
        tailSpan = tailNode.span;
      }

      Borrowck::rejectReturnedView(defStore, typeStore, symbols, hir, &mut state, diagnostics, tail, tailSpan);
    }

    Borrowck::reportMovesWhileBorrowed(defStore, symbols, &mut state, diagnostics);

    // A body's final expression is its result, handed to the caller like a
    // returned value.
    Borrowck::rejectClosureMoveOutOfBorrow(typeStore, hir, &mut state, diagnostics, bodyId);

    // The synthetic return at the end of the body unwinds everything still
    // open, which by now is the root scope alone. Mirrors the `FnEnd` block of
    // `check_function`, computed before the root scope is popped.
    let fnEnd: Hir::ExitKey = Hir::ExitKey::FnEnd(functionId);
    Borrowck::recordExitSchedule(&mut state, schedules, &fnEnd, 0);

    state.popScopeReleasing();

    if (reportEnabled) {
      let collected: Vector<Borrowck::OwnershipEvent> = state.takeReportEvents();
      let mut reportRef: &mut Vector<Borrowck::OwnershipEvent> = reportEvents;
      let mut index: u64 = 0;

      while (index < collected.length()) {
        if (let Option::SOME(event) = collected.get(index)) {
          reportRef.push(Borrowck::copyOwnershipEvent(event));
        }

        index += 1;
      }
    }
  }

  /// The node a body's value finally comes from, following block tails.
  function innermostTail(hir: &Hir::HirStore, nodeId: Hir::HirId): Hir::HirId {
    let Option::SOME(node) = hir.get(nodeId) else {
      return nodeId;
    };

    if (let Hir::HirKind::Block(block) = &node.kind) {
      if (let Option::SOME(tail) = block.expression) {
        return Borrowck::innermostTail(hir, tail);
      }
    }

    return nodeId;
  }

  /// Marks the binding a function's tail value moves out of, and every
  /// closure environment it carries, as returned. Mirrors the `Return` arm of
  /// `checkNode`, minus what that arm already checked while visiting the node.
  function markTailReturned(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    hir: &Hir::HirStore,
    state: &mut Borrowck::State,
    tail: Hir::HirId,
  ): void {
    if (let Option::SOME(source) = Borrowck::movedValue(defStore, typeStore, hir, state, tail)) {
      if (!state.isEnvironmentCapture(source.raw()) && state.isMoveValid(source.raw())) {
        Borrowck::noteMove(state, source, Borrowck::OwnershipReport::CONSUMER_RETURN, Borrowck::closingSpanOf(hir, tail));

        let mut returnRef: &mut Borrowck::State = state;
        returnRef.setMoveValue(source.raw(), Borrowck::MOVE_RETURNED);
      }
    }

    let mut closureEnvOwners: Vector<u32> = Vector::new<u32>();
    Borrowck::collectClosureEnvOwners(hir, state, tail, &mut closureEnvOwners);

    let mut ownerIndex: u64 = 0;

    while (ownerIndex < closureEnvOwners.length()) {
      if (let Option::SOME(owner) = closureEnvOwners.get(ownerIndex)) {
        if (state.isMoveValid(*owner)) {
          let mut closureRef: &mut Borrowck::State = state;
          closureRef.setMoveValue(*owner, Borrowck::MOVE_RETURNED);
        }
      }

      ownerIndex += 1;
    }
  }

  /// Whether the parameter `paramId` takes over the environment of the closure
  /// passed to it. A closure argument moves into its parameter, which then
  /// owns the environment like a local would; a `@noescape` parameter is only
  /// lent the closure for the call and owns nothing.
  function paramTakesClosureEnv(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    state: &Borrowck::State,
    paramId: Analyzer::DefinitionId,
  ): boolean {
    let Option::SOME(paramType) = Borrowck::variableTypeOf(defStore, paramId) else {
      return false;
    };

    if (!Hir::typeIsFunction(typeStore, paramType)) {
      return false;
    }

    if (state.envIsCapturedByEscapingClosure(paramId.raw())) {
      return false;
    }

    let Option::SOME(definition) = defStore.get(paramId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Variable(variableDef) -> !variableDef.noEscape,
      _ -> false,
    };
  }

  /// Borrow-check entry point. Walks every function and method body the HIR
  /// store carries, in item order, and returns the diagnostics they produced
  /// together with the drop schedules the same walk recorded.
  ///
  /// Not wired into `Analyzer::analyzeModule`: callers run it explicitly after
  /// `Lowering::lowerModule`.
  function checkModule(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
  ): Borrowck::BorrowckOutput {
    return Borrowck::checkModuleReporting(defStore, typeStore, symbols, hir, false);
  }

  /// `checkModule` with the ownership report turned on. Kept separate so the
  /// ordinary entry point stays a four-argument call and so the walk pays
  /// nothing for a report nobody asked for.
  /// The diagnostics each checked copy of a trait default produced, as
  /// `[start, end)` ranges of the module's bag. `keys` names the default
  /// itself, so the copies of one default can be counted.
  record InheritedRanges {
    public starts: Vector<u64>;
    public ends: Vector<u64>;
    public notes: Vector<String>;
    public keys: Vector<String>;
  }

  function recordInheritedRange(
    ranges: &mut Borrowck::InheritedRanges,
    start: u64,
    end: u64,
    note: &String,
  ): void {
    let marker: String = String::create("`, as inherited by");
    let key: String = match (note.indexOf(&marker)) {
      Option::SOME(position) -> note.substringBytes(0, position),
      Option::NONE -> note.clone(),
    };

    let mut rangesRef: &mut Borrowck::InheritedRanges = ranges;
    rangesRef.starts.push(start);
    rangesRef.ends.push(end);
    rangesRef.notes.push(note.clone());
    rangesRef.keys.push(key);
  }

  /// `note` with the inheriting type written as the instance a monomorphized
  /// `itemId` belongs to, `Tagged<String>` rather than `Tagged`: two instances
  /// of one generic type are separate copies of the default.
  function noteNamingInstance(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    itemId: Analyzer::DefinitionId,
    note: &String,
  ): String {
    let arguments: Vector<Analyzer::TypeId> = defStore.instanceOwnerArguments(itemId);

    if (arguments.length() == 0 || !note.endsWith("`")) {
      return note.clone();
    }

    let mut named: String = note.substringBytes(0, note.length() - 1);
    named.pushStr("<");
    let mut index: u64 = 0;

    while (index < arguments.length()) {
      if (let Option::SOME(argument) = arguments.get(index)) {
        if (index > 0) {
          named.pushStr(", ");
        }

        let argumentName: String = typeStore.nameOfResolved(*argument, &*defStore, &*symbols);
        named.push(&argumentName);
      }

      index += 1;
    }

    named.pushStr(">`");
    return named;
  }

  /// The inherited range holding diagnostic `index`, if any.
  function inheritedRangeOf(ranges: &Borrowck::InheritedRanges, index: u64): Option<u64> {
    let mut rangeIndex: u64 = 0;

    while (rangeIndex < ranges.starts.length()) {
      if (let Option::SOME(start) = ranges.starts.get(rangeIndex)) {
        if (let Option::SOME(end) = ranges.ends.get(rangeIndex)) {
          if (index >= *start && index < *end) {
            return Option::SOME(rangeIndex);
          }
        }
      }

      rangeIndex += 1;
    }

    return Option::NONE;
  }

  function sameReport(left: &Diagnostic, right: &Diagnostic): boolean {
    return left.code.equals(right.code) && left.primarySpan.file.raw() == right.primarySpan.file.raw() && left.primarySpan.start == right.primarySpan.start && left.primarySpan.end == right.primarySpan.end && left.message.equals(right.messageText());
  }

  /// Whether the copy in `rangeIndex` produced a diagnostic that reports
  /// the same thing as `diagnostic`.
  function rangeReports(
    diagnostics: &DiagnosticBag,
    ranges: &Borrowck::InheritedRanges,
    rangeIndex: u64,
    diagnostic: &Diagnostic,
  ): boolean {
    let Option::SOME(start) = ranges.starts.get(rangeIndex) else {
      return false;
    };
    let Option::SOME(end) = ranges.ends.get(rangeIndex) else {
      return false;
    };
    let mut index: u64 = *start;

    while (index < *end) {
      if (let Option::SOME(other) = diagnostics.get(index)) {
        if (Borrowck::sameReport(other, diagnostic)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// Settles what the copies of trait defaults reported.
  ///
  /// The trait's own default body is never lowered, so only the copies on
  /// implementing types reach this check, and they keep the trait's spans. A
  /// diagnostic every copy of a default produces does not depend on the type:
  /// it is kept once, as the trait's report. One only some copies produce is
  /// kept for each of them, with a note naming the type.
  function settleInheritedDiagnostics(
    diagnostics: &DiagnosticBag,
    ranges: &Borrowck::InheritedRanges,
  ): DiagnosticBag {
    let mut settled: DiagnosticBag = DiagnosticBag::init();
    let mut index: u64 = 0;

    while (index < diagnostics.length()) {
      let Option::SOME(diagnostic) = diagnostics.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(rangeIndex) = Borrowck::inheritedRangeOf(ranges, index) else {
        settled.push(Analyzer::copyDiagnostic(diagnostic));
        index += 1;
        continue;
      };

      let Option::SOME(key) = ranges.keys.get(rangeIndex) else {
        index += 1;
        continue;
      };

      let mut copies: u64 = 0;
      let mut reporting: u64 = 0;
      let mut firstReporting: u64 = rangeIndex;
      let mut otherIndex: u64 = 0;

      while (otherIndex < ranges.keys.length()) {
        if (let Option::SOME(otherKey) = ranges.keys.get(otherIndex)) {
          if (otherKey.equals(key.toStr())) {
            copies += 1;

            if (Borrowck::rangeReports(diagnostics, ranges, otherIndex, diagnostic)) {
              if (reporting == 0) {
                firstReporting = otherIndex;
              }

              reporting += 1;
            }
          }
        }

        otherIndex += 1;
      }

      if (reporting == copies) {
        if (firstReporting == rangeIndex) {
          settled.push(Analyzer::copyDiagnostic(diagnostic));
        }
      } else {
        let mut kept: Diagnostic = Analyzer::copyDiagnostic(diagnostic);

        if (let Option::SOME(note) = ranges.notes.get(rangeIndex)) {
          kept.addNote(note.toStr());
        }

        settled.push(kept);
      }

      index += 1;
    }

    return settled;
  }

  function checkModuleReporting(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    reportEnabled: boolean,
  ): Borrowck::BorrowckOutput {
    let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
    let mut reportEvents: Vector<Borrowck::OwnershipEvent> = Vector::new<Borrowck::OwnershipEvent>();
    let mut schedules: Hir::DropSchedules = Hir::DropSchedules::init();
    let statementPositionNodes: Vector<u32> = Borrowck::collectStatementPositionNodes(hir, defStore, typeStore);
    let mut discardedIndex: u64 = 0;

    while (discardedIndex < statementPositionNodes.length()) {
      if (let Option::SOME(nodeRaw) = statementPositionNodes.get(discardedIndex)) {
        if (let Option::SOME(node) = hir.nodes.get(*nodeRaw as u64)) {
          match (&node.kind) {
            Hir::HirKind::Match(_) | Hir::HirKind::If(_) -> {
              schedules.discardedResults.push(*nodeRaw);
            },
            _ -> {},
          };
        }
      }

      discardedIndex += 1;
    }

    let envsCapturedByEscapingClosures: Vector<u32> = Borrowck::collectEnvsCapturedByEscapingClosures(hir);
    let bindingsAssignedClosureEnv: Vector<u32> = Borrowck::collectBindingsAssignedClosureEnv(defStore, typeStore, hir);
    let thunkCaptures: Borrowck::ThunkCaptures = Borrowck::collectThunkCaptures(defStore, typeStore, hir);
    let ownedBuffer: u32 = Borrowck::stdStringDefinition(defStore, symbols);
    let mut inherited: Borrowck::InheritedRanges = Borrowck::InheritedRanges {
      starts: Vector::new<u64>(),
      ends: Vector::new<u64>(),
      notes: Vector::new<String>(),
      keys: Vector::new<String>(),
    };
    let mut index: u64 = 0;

    while (index < hir.items.length()) {
      Output::pulse();

      let Option::SOME(itemId) = hir.items.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(params) = Borrowck::callableParams(defStore, *itemId) else {
        index += 1;
        continue;
      };

      let Option::SOME(bodyId) = hir.functionBody(*itemId) else {
        index += 1;
        continue;
      };

      let environmentCaptures: Vector<u32> = Borrowck::environmentCapturesOf(&thunkCaptures, *itemId);
      let start: u64 = diagnostics.length();

      Borrowck::checkFunction(
        defStore,
        typeStore,
        symbols,
        hir,
        &mut diagnostics,
        &mut schedules,
        *itemId,
        &params,
        bodyId,
        &statementPositionNodes,
        &envsCapturedByEscapingClosures,
        &bindingsAssignedClosureEnv,
        &environmentCaptures,
        reportEnabled,
        &mut reportEvents,
        ownedBuffer,
      );

      if (let Option::SOME(note) = defStore.inheritedNoteOf(*itemId)) {
        let instanceNote: String = Borrowck::noteNamingInstance(defStore, typeStore, symbols, *itemId, &note);
        Borrowck::recordInheritedRange(&mut inherited, start, diagnostics.length(), &instanceNote);
      }

      index += 1;
    }

    let settled: DiagnosticBag = Borrowck::settleInheritedDiagnostics(&diagnostics, &inherited);

    return Borrowck::BorrowckOutput {
      diagnostics: settled,
      dropSchedules: schedules,
      ownershipEvents: reportEvents,
    };
  }
}
