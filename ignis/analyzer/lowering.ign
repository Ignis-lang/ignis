import SourceSpan from "@compiler::diagnostics";
import Ast from "@compiler::ast";
import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import Vector from "std::vector";

/// AST -> HIR lowering for the Ignis selfhost compiler (IGN-37, slices B,
/// C, D and E).
///
/// Port of the item/statement/expression subset of
/// `crates/ignis_analyzer/src/lowering.rs` that these slices cover:
///   - items: free functions (declaration + body), record and enum methods
///     (bodies only), namespaces and exports recursed into for the callables
///     they contain,
///   - statements: let (annotated or inferred), assignment, expression
///     statement, block, if/else, while, C-style `for`, `defer`, return,
///     break, continue, `let ... else`,
///   - expressions: literals, variable references, binary ops, unary ops,
///     grouping (transparent), calls to free functions, static method calls
///     through a path, instance method calls, record field reads, record
///     initializers, casts, references, dereferences, tuple literals, vector
///     literals, index access, postfix `!`, pipes into free functions, block
///     expressions, if expressions, unit, `match`, `if let` / `while let`
///     conditions, and the `@sizeOf` / `@alignOf` / `@panic` / `@trap` /
///     `@unreachable` builtins,
///   - patterns: wildcard, binding, literal, enum variant (with nested
///     destructuring), tuple, and or-patterns.
///
/// Everything else (closures, `for ... of`, the builtins the selfhost
/// typechecker rejects, enum variant construction, record destructuring
/// patterns, ...) lowers to a single explicit `HirKind::Error` fallback,
/// mirroring the Rust oracle's error nodes. A pattern outside the supported
/// set sends its whole enclosing construct to that fallback rather than
/// lowering partially, because `HirPattern` has no error form.
///
/// Deviations from the Rust oracle, rooted in selfhost model gaps:
///   - The selfhost `Type` enum has no error type, so `Error` fallback nodes
///     and unknown types use the `VOID` sentinel instead of `types.error()`.
///   - Statement nodes carry no checked type in `TypecheckOutput` (it is
///     keyed by expression ids), so statement blocks and ifs type as `void`
///     where the Rust oracle may show `never`.
///   - Locals have no `DefinitionId` before lowering (the body resolver
///     hands out per-function `LocalId`s), so lowering allocates a
///     `Definition::Variable` per let binding site and threads a
///     `LocalMap` from `LocalId` to that definition. The reverse scan finds
///     the innermost live binding at the reference point, which resolves
///     the ADR-B10 `LocalId` index reuse across sibling scopes because
///     bindings are registered in source order during the same walk.
///   - `TypecheckOutput` records expression types only: there is no resolved
///     call map and no pipe resolution table. Method, field and pipe targets
///     are therefore re-derived here from the checked receiver type and the
///     definition store, following the same lookup order the typechecker
///     uses, instead of being read back from the checker.
///   - Enum variant payload types come from `VariantDef.payload`, which the
///     resolver fills from the declaration. Where the oracle asks "is this
///     payload type void", this module asks for payload arity instead: an
///     unannotated slot still keeps a `VOID` placeholder, so arity is the
///     reliable question.
///   - `for ... of` has no lowering at all. The oracle's desugar reads the
///     binding `DefinitionId` (and through it the by-value/by-ref binding
///     type) out of a `for_of_binding_defs` table the checker fills, plus the
///     `data`/`len` field indexes of an iterable record. The selfhost
///     `TypecheckOutput` carries neither, and the binding type is never
///     recorded anywhere lowering can read, so the whole statement pins on
///     `Error` instead of guessing an iteration shape.
///   - `defer` carries a statement in the selfhost AST and an expression in
///     the Rust one. The `Expression` statement the parser wraps the deferred
///     expression in is unwrapped here, exactly like `checkDeferStmt` does, so
///     the `Defer` body is the expression the oracle would carry.
export namespace Lowering {
  /// Insertion-ordered map from body-resolver `LocalId`s to the `Variable`
  /// definitions lowering allocated for them. Entries are never popped:
  /// lookups reverse-scan so the innermost (latest) binding wins, exactly
  /// like the resolver's own shadowing rules at the point of reference.
  ///
  /// `currentReturnType` rides along as the one other piece of per-function
  /// state lowering needs: the enclosing function's declared return type,
  /// which the `try` desugar puts on the error value it propagates (the Rust
  /// oracle reads it from `current_lowering_return_type()`). It is `NONE`
  /// until the first function body is entered.
  record LocalMap {
    public fnRaws: Vector<u32>;
    public indexes: Vector<u32>;
    public defs: Vector<Analyzer::DefinitionId>;
    public currentReturnType: Option<Analyzer::TypeId>;

    public static init(): LocalMap {
      return LocalMap {
        fnRaws: Vector::new<u32>(),
        indexes: Vector::new<u32>(),
        defs: Vector::new<Analyzer::DefinitionId>(),
        currentReturnType: Option::NONE,
      };
    }
  }

  function registerLocal(
    locals: &mut Lowering::LocalMap,
    localId: Analyzer::ResolverBodies::LocalId,
    defId: Analyzer::DefinitionId,
  ): void {
    let mut localsRef: &mut Lowering::LocalMap = locals;

    localsRef.fnRaws.push(localId.enclosingFn.raw());
    localsRef.indexes.push(localId.index);
    localsRef.defs.push(defId);
  }

  function lookupLocal(
    locals: &mut Lowering::LocalMap,
    localId: Analyzer::ResolverBodies::LocalId,
  ): Option<Analyzer::DefinitionId> {
    let mut index: u64 = locals.fnRaws.length();

    while (index > 0) {
      index -= 1;

      let Option::SOME(fnRaw) = locals.fnRaws.get(index) else {
        continue;
      };
      let Option::SOME(localIndex) = locals.indexes.get(index) else {
        continue;
      };

      if (*fnRaw != localId.enclosingFn.raw() || *localIndex != localId.index) {
        continue;
      }

      let Option::SOME(defId) = locals.defs.get(index) else {
        return Option::NONE;
      };

      return Option::SOME(*defId);
    }

    return Option::NONE;
  }

  /// Checked type of an expression, using the same last-write-wins reverse
  /// scan as `Checks::exprIsNever` and the typechecker's own
  /// `lookupRecordedExprType`.
  function lookupExprType(
    typecheck: &Analyzer::Typecheck::TypecheckOutput,
    exprId: Ast::ExpressionId,
  ): Option<Analyzer::TypeId> {
    let mut index: u64 = typecheck.exprTypes.nodeIds.length();

    while (index > 0) {
      index -= 1;

      let Option::SOME(nodeId) = typecheck.exprTypes.nodeIds.get(index) else {
        continue;
      };

      if (*nodeId != exprId.raw()) {
        continue;
      }

      let Option::SOME(typeId) = typecheck.exprTypes.typeIds.get(index) else {
        return Option::NONE;
      };

      return Option::SOME(*typeId);
    }

    return Option::NONE;
  }

  function voidType(typeStore: &mut Analyzer::TypeStore): Analyzer::TypeId {
    let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
    return typeStoreRef.intern(Analyzer::Type::VOID);
  }

  function booleanType(typeStore: &mut Analyzer::TypeStore): Analyzer::TypeId {
    let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
    return typeStoreRef.intern(Analyzer::Type::BOOLEAN);
  }

  function neverType(typeStore: &mut Analyzer::TypeStore): Analyzer::TypeId {
    let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
    return typeStoreRef.intern(Analyzer::Type::NEVER);
  }

  function unsignedInt64Type(typeStore: &mut Analyzer::TypeStore): Analyzer::TypeId {
    let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
    return typeStoreRef.intern(Analyzer::Type::U64);
  }

  function exprTypeOrVoid(
    typeStore: &mut Analyzer::TypeStore,
    typecheck: &Analyzer::Typecheck::TypecheckOutput,
    exprId: Ast::ExpressionId,
  ): Analyzer::TypeId {
    if (let Option::SOME(typeId) = Lowering::lookupExprType(typecheck, exprId)) {
      return typeId;
    }

    return Lowering::voidType(typeStore);
  }

  /// Single fallback for every construct outside this slice. The selfhost
  /// type model has no error type, so the node types as `void`.
  function errorNode(
    hir: &mut Hir::HirStore,
    typeStore: &mut Analyzer::TypeStore,
    span: SourceSpan,
  ): Hir::HirId {
    let mut hirRef: &mut Hir::HirStore = hir;

    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Error,
      span: span,
      typeId: Lowering::voidType(typeStore),
    });
  }

  // =========================================================================
  // Type-shape lookups
  //
  // The selfhost `TypecheckOutput` keeps expression types and nothing else,
  // so member, method and try targets are re-derived from the checked type
  // of the receiver. Every helper below resolves alias chains first and
  // answers `NONE` on a cyclic alias, exactly like the typechecker's own
  // non-emitting probes.
  // =========================================================================

  /// Referent of `typeId` when it is a reference, `NONE` otherwise.
  function referenceReferent(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Option<Analyzer::TypeId> {
    let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

    if (resolved.cycleAlias.isSome()) {
      return Option::NONE;
    }

    let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
      return Option::NONE;
    };

    let Analyzer::Type::Reference(reference) = typeNode else {
      return Option::NONE;
    };

    return Option::SOME(reference.referent);
  }

  /// Pointee of a pointer or reference type, `NONE` otherwise. Mirrors the
  /// shapes the oracle's `Dereference` arm unwraps.
  function pointeeType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Option<Analyzer::TypeId> {
    let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

    if (resolved.cycleAlias.isSome()) {
      return Option::NONE;
    }

    let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::Pointer(pointer) -> Option::SOME(pointer.pointee),
      Analyzer::Type::Reference(reference) -> Option::SOME(reference.referent),
      _ -> Option::NONE,
    };
  }

  /// Element type an index access yields: slices and fixed arrays contribute
  /// their element, pointers their pointee, everything else `NONE`.
  function indexElementType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Option<Analyzer::TypeId> {
    let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

    if (resolved.cycleAlias.isSome()) {
      return Option::NONE;
    }

    let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
      return Option::NONE;
    };

    return match (typeNode) {
      Analyzer::Type::Slice(element) -> Option::SOME(element),
      Analyzer::Type::FixedArray(element, _) -> Option::SOME(element),
      Analyzer::Type::Pointer(pointer) -> Option::SOME(pointer.pointee),
      _ -> Option::NONE,
    };
  }

  /// Applied type arguments of a generic instance type, empty for every other
  /// shape — the oracle's `Type::Instance { args, .. }` extraction.
  function instanceTypeArguments(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Vector<Analyzer::TypeId> {
    let mut arguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

    if (resolved.cycleAlias.isSome()) {
      return arguments;
    }

    let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
      return arguments;
    };

    let Analyzer::Type::Instance(instance) = typeNode else {
      return arguments;
    };

    let mut index: u64 = 0;

    while (index < instance.typeArguments.length()) {
      if (let Option::SOME(typeArgument) = instance.typeArguments.get(index)) {
        arguments.push(*typeArgument);
      }

      index += 1;
    }

    return arguments;
  }

  /// Definition a record/enum type names, `NONE` for every other shape.
  /// `Instance` yields the generic definition, matching the oracle's
  /// `Type::Instance { generic, .. }` arm.
  function nominalDefinition(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Option<Analyzer::DefinitionId> {
    let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

    if (resolved.cycleAlias.isSome()) {
      return Option::NONE;
    }

    let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
      return Option::NONE;
    };

    match (typeNode) {
      Analyzer::Type::Record(defId) -> {
        return Option::SOME(defId);
      },
      Analyzer::Type::Enum(defId) -> {
        return Option::SOME(defId);
      },
      Analyzer::Type::Instance(instance) -> {
        return Option::SOME(instance.definition);
      },
      _ -> {
        return Option::NONE;
      },
    };

    return Option::NONE;
  }

  /// Owner-local instance method table of the record or enum `typeId` names.
  /// Empty for every other shape, which turns a method lookup into a miss.
  function instanceMethodTable(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Vector<Analyzer::DefinitionId> {
    let empty: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    let Option::SOME(ownerDef) = Lowering::nominalDefinition(defStore, typeStore, typeId) else {
      return empty;
    };

    let Option::SOME(definition) = defStore.get(ownerDef) else {
      return empty;
    };

    match (definition) {
      Analyzer::Definition::Record(record_) -> {
        return Analyzer::Typecheck::copyDefinitionIdVector(&record_.instanceMethods);
      },
      Analyzer::Definition::Enum(enum_) -> {
        return Analyzer::Typecheck::copyDefinitionIdVector(&enum_.instanceMethods);
      },
      _ -> {
        return empty;
      },
    };

    return empty;
  }

  /// Position and declared type of one field of a record type.
  record RecordFieldLocation {
    public index: u32;
    public fieldType: Analyzer::TypeId;
  }

  function recordFieldLocation(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    typeId: Analyzer::TypeId,
    name: str,
  ): Option<Lowering::RecordFieldLocation> {
    let Option::SOME(recordDef) = Lowering::nominalDefinition(defStore, typeStore, typeId) else {
      return Option::NONE;
    };

    let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(recordDef)) {
      let Analyzer::Definition::Record(record_) = definition else {
        return Option::NONE;
      };

      fields = Analyzer::Typecheck::copyDefinitionIdVector(&record_.fields);
    }

    let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
    let targetSym: Analyzer::SymbolId = symbolsRef.intern(name);

    let mut index: u64 = 0;

    while (index < fields.length()) {
      let Option::SOME(fieldDefId) = fields.get(index) else {
        index += 1;
        continue;
      };

      if (let Option::SOME(definition) = defStore.get(*fieldDefId)) {
        if (let Analyzer::Definition::Field(field) = definition) {
          if (field.name.raw() == targetSym.raw()) {
            return Option::SOME(Lowering::RecordFieldLocation {
              index: field.index,
              fieldType: field.fieldType,
            });
          }
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// Field definitions of the record a type names, in declaration order.
  /// `NONE` when the type names anything other than a record definition,
  /// mirroring the oracle's `DefinitionKind::Record(rd)` guard.
  function recordFieldDefinitions(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Option<Vector<Analyzer::DefinitionId>> {
    let Option::SOME(recordDef) = Lowering::nominalDefinition(defStore, typeStore, typeId) else {
      return Option::NONE;
    };

    let Option::SOME(definition) = defStore.get(recordDef) else {
      return Option::NONE;
    };

    let Analyzer::Definition::Record(record_) = definition else {
      return Option::NONE;
    };

    return Option::SOME(Analyzer::Typecheck::copyDefinitionIdVector(&record_.fields));
  }

  function mapBinaryOperator(operator: Ast::Expression::BinaryOperator): Hir::BinaryOperation {
    return match (operator) {
      Ast::Expression::BinaryOperator::Add -> Hir::BinaryOperation::Add,
      Ast::Expression::BinaryOperator::Subtract -> Hir::BinaryOperation::Sub,
      Ast::Expression::BinaryOperator::Multiply -> Hir::BinaryOperation::Mul,
      Ast::Expression::BinaryOperator::Divide -> Hir::BinaryOperation::Div,
      Ast::Expression::BinaryOperator::Modulo -> Hir::BinaryOperation::Mod,
      Ast::Expression::BinaryOperator::And -> Hir::BinaryOperation::And,
      Ast::Expression::BinaryOperator::Or -> Hir::BinaryOperation::Or,
      Ast::Expression::BinaryOperator::Equal -> Hir::BinaryOperation::Equal,
      Ast::Expression::BinaryOperator::NotEqual -> Hir::BinaryOperation::NotEqual,
      Ast::Expression::BinaryOperator::LessThan -> Hir::BinaryOperation::LessThan,
      Ast::Expression::BinaryOperator::LessThanOrEqual -> Hir::BinaryOperation::LessEqual,
      Ast::Expression::BinaryOperator::GreaterThan -> Hir::BinaryOperation::GreaterThan,
      Ast::Expression::BinaryOperator::GreaterThanOrEqual -> Hir::BinaryOperation::GreaterEqual,
      Ast::Expression::BinaryOperator::BitAnd -> Hir::BinaryOperation::BitAnd,
      Ast::Expression::BinaryOperator::BitOr -> Hir::BinaryOperation::BitOr,
      Ast::Expression::BinaryOperator::BitXor -> Hir::BinaryOperation::BitXor,
      Ast::Expression::BinaryOperator::ShiftLeft -> Hir::BinaryOperation::BitShiftLeft,
      Ast::Expression::BinaryOperator::ShiftRight -> Hir::BinaryOperation::BitShiftRight,
    };
  }

  /// `NONE` for the postfix-style `Increment`/`Decrement` operators, which
  /// are outside this slice and fall back to `Error`.
  function mapUnaryOperator(operator: Ast::Expression::UnaryOperator): Option<Hir::UnaryOperation> {
    return match (operator) {
      Ast::Expression::UnaryOperator::Not -> Option::SOME(Hir::UnaryOperation::Not),
      Ast::Expression::UnaryOperator::Negate -> Option::SOME(Hir::UnaryOperation::Neg),
      Ast::Expression::UnaryOperator::BitNot -> Option::SOME(Hir::UnaryOperation::BitNot),
      Ast::Expression::UnaryOperator::Increment -> Option::NONE,
      Ast::Expression::UnaryOperator::Decrement -> Option::NONE,
    };
  }

  /// `NONE` for plain `=`, mirroring the Rust `HIRKind::Assign` operation
  /// payload for compound assignments.
  function mapAssignmentOperator(
    operator: Ast::Expression::AssignmentOperator,
  ): Option<Hir::BinaryOperation> {
    return match (operator) {
      Ast::Expression::AssignmentOperator::Assign -> Option::NONE,
      Ast::Expression::AssignmentOperator::AddAssign -> Option::SOME(Hir::BinaryOperation::Add),
      Ast::Expression::AssignmentOperator::SubtractAssign -> Option::SOME(Hir::BinaryOperation::Sub),
      Ast::Expression::AssignmentOperator::MultiplyAssign -> Option::SOME(Hir::BinaryOperation::Mul),
      Ast::Expression::AssignmentOperator::DivideAssign -> Option::SOME(Hir::BinaryOperation::Div),
      Ast::Expression::AssignmentOperator::ModuloAssign -> Option::SOME(Hir::BinaryOperation::Mod),
      Ast::Expression::AssignmentOperator::ShiftLeftAssign -> Option::SOME(Hir::BinaryOperation::BitShiftLeft),
      Ast::Expression::AssignmentOperator::ShiftRightAssign -> Option::SOME(Hir::BinaryOperation::BitShiftRight),
      Ast::Expression::AssignmentOperator::BitAndAssign -> Option::SOME(Hir::BinaryOperation::BitAnd),
      Ast::Expression::AssignmentOperator::BitOrAssign -> Option::SOME(Hir::BinaryOperation::BitOr),
      Ast::Expression::AssignmentOperator::BitXorAssign -> Option::SOME(Hir::BinaryOperation::BitXor),
      Ast::Expression::AssignmentOperator::AndAssign -> Option::SOME(Hir::BinaryOperation::And),
      Ast::Expression::AssignmentOperator::OrAssign -> Option::SOME(Hir::BinaryOperation::Or),
    };
  }

  /// Maps a width-less AST literal to the width-carrying HIR literal using
  /// the checked type. The Rust oracle carries widths from parsing; the
  /// selfhost parser does not, so the typechecker's verdict selects the
  /// variant (with `i32`/`u64`/`f64` fallbacks matching the checker's own
  /// literal defaults).
  function literalKind(
    typeStore: &mut Analyzer::TypeStore,
    value: &Ast::Expression::LiteralValue,
    typeId: Analyzer::TypeId,
  ): Hir::LiteralValue {
    return match (value) {
      Ast::Expression::LiteralValue::Int(intValue) -> Lowering::intLiteralKind(typeStore, intValue, typeId),
      Ast::Expression::LiteralValue::UInt(uintValue) -> Lowering::uintLiteralKind(typeStore, uintValue, typeId),
      Ast::Expression::LiteralValue::Float(floatValue) -> Lowering::floatLiteralKind(typeStore, floatValue, typeId),
      Ast::Expression::LiteralValue::Boolean(boolValue) -> Hir::LiteralValue::Boolean(boolValue),
      Ast::Expression::LiteralValue::Character(charValue) -> Hir::LiteralValue::Char(charValue as u32),
      Ast::Expression::LiteralValue::String(text) -> Hir::LiteralValue::String(text.clone()),
      Ast::Expression::LiteralValue::Null -> Hir::LiteralValue::Null,
    };
  }

  function intLiteralKind(
    typeStore: &mut Analyzer::TypeStore,
    value: i64,
    typeId: Analyzer::TypeId,
  ): Hir::LiteralValue {
    if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
      return match (typeNode) {
        Analyzer::Type::I8 -> Hir::LiteralValue::Int8(value as i8),
        Analyzer::Type::I16 -> Hir::LiteralValue::Int16(value as i16),
        Analyzer::Type::I64 -> Hir::LiteralValue::Int64(value),
        Analyzer::Type::U8 -> Hir::LiteralValue::UnsignedInt8(value as u8),
        Analyzer::Type::U16 -> Hir::LiteralValue::UnsignedInt16(value as u16),
        Analyzer::Type::U32 -> Hir::LiteralValue::UnsignedInt32(value as u32),
        Analyzer::Type::U64 -> Hir::LiteralValue::UnsignedInt64(value as u64),
        _ -> Hir::LiteralValue::Int32(value as i32),
      };
    }

    return Hir::LiteralValue::Int32(value as i32);
  }

  function uintLiteralKind(
    typeStore: &mut Analyzer::TypeStore,
    value: u64,
    typeId: Analyzer::TypeId,
  ): Hir::LiteralValue {
    if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
      return match (typeNode) {
        Analyzer::Type::U8 -> Hir::LiteralValue::UnsignedInt8(value as u8),
        Analyzer::Type::U16 -> Hir::LiteralValue::UnsignedInt16(value as u16),
        Analyzer::Type::U32 -> Hir::LiteralValue::UnsignedInt32(value as u32),
        Analyzer::Type::I8 -> Hir::LiteralValue::Int8(value as i8),
        Analyzer::Type::I16 -> Hir::LiteralValue::Int16(value as i16),
        Analyzer::Type::I32 -> Hir::LiteralValue::Int32(value as i32),
        Analyzer::Type::I64 -> Hir::LiteralValue::Int64(value as i64),
        _ -> Hir::LiteralValue::UnsignedInt64(value),
      };
    }

    return Hir::LiteralValue::UnsignedInt64(value);
  }

  function floatLiteralKind(
    typeStore: &mut Analyzer::TypeStore,
    value: f64,
    typeId: Analyzer::TypeId,
  ): Hir::LiteralValue {
    if (let Option::SOME(typeNode) = typeStore.get(typeId)) {
      if (let Analyzer::Type::F32 = typeNode) {
        return Hir::LiteralValue::Float32(value as f32);
      }
    }

    return Hir::LiteralValue::Float64(value);
  }

  // =========================================================================
  // Patterns
  // =========================================================================

  /// Owned copy of the variant data a `Variant` pattern or an `EnumVariant`
  /// construction needs, taken before sub-pattern lowering pushes new
  /// `Variable` definitions into the store.
  record VariantPatternInfo {
    public enumDef: Analyzer::DefinitionId;
    public variantTag: u32;
    public payload: Vector<Analyzer::TypeId>;
  }

  function variantPatternInfo(
    defStore: &mut Analyzer::DefinitionStore,
    variantDef: Analyzer::DefinitionId,
  ): Option<Lowering::VariantPatternInfo> {
    let Option::SOME(definition) = defStore.get(variantDef) else {
      return Option::NONE;
    };

    let Analyzer::Definition::Variant(variant) = definition else {
      return Option::NONE;
    };

    let mut payload: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut index: u64 = 0;

    while (index < variant.payload.length()) {
      if (let Option::SOME(payloadType) = variant.payload.get(index)) {
        payload.push(*payloadType);
      }

      index += 1;
    }

    return Option::SOME(Lowering::VariantPatternInfo {
      enumDef: variant.owner,
      variantTag: variant.tagValue,
      payload: payload,
    });
  }

  /// Element types of a tuple type, or an empty vector for anything else.
  /// Missing entries make the corresponding sub-pattern fall back to `void`,
  /// the same sentinel unknown types use everywhere in this module.
  function tupleElementTypes(
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Vector<Analyzer::TypeId> {
    let mut elements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    let Option::SOME(typeNode) = typeStore.get(typeId) else {
      return elements;
    };

    let Analyzer::Type::Tuple(tupleType) = typeNode else {
      return elements;
    };

    let mut index: u64 = 0;

    while (index < tupleType.elements.length()) {
      if (let Option::SOME(elementType) = tupleType.elements.get(index)) {
        elements.push(*elementType);
      }

      index += 1;
    }

    return elements;
  }

  /// Allocates the `Definition::Variable` for one pattern binding site and
  /// registers it in the `LocalMap` under the body resolver's `LocalId`, so
  /// references in guards, arm bodies, and the statements after a `let else`
  /// resolve to this binding.
  function declarePatternBinding(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    patternId: Ast::PatternId,
    name: str,
    declaredType: Analyzer::TypeId,
  ): Analyzer::DefinitionId {
    let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
    let nameSym: Analyzer::SymbolId = symbolsRef.intern(name);

    let mut defStoreRef: &mut Analyzer::DefinitionStore = defStore;
    let defId: Analyzer::DefinitionId = defStoreRef.push(Analyzer::Definition::Variable(Analyzer::VariableDef {
      name: nameSym,
      visibility: Analyzer::Visibility::PRIVATE,
      declaredType: declaredType,
      mutable: false,
    }));

    if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Local(localId)) = Analyzer::ResolverBodies::findPatternRef(
      &output.resolvedBodies.bodyResolution,
      patternId.raw(),
    )) {
      Lowering::registerLocal(locals, localId, defId);
    }

    return defId;
  }

  /// Lowers one AST pattern. `NONE` means the pattern is outside this slice,
  /// which makes the whole enclosing construct fall back to `Error` instead
  /// of lowering partially: `HirPattern` has no error form.
  ///
  /// `expectedType` is the checked type of the value the pattern matches
  /// against, and becomes the declared type of a binding at this level. The
  /// selfhost `TypecheckOutput` records expression types only, so nested
  /// binding types are derived structurally from the variant payload and
  /// tuple element types instead of being read back from the checker.
  function lowerPattern(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    patternId: Ast::PatternId,
    expectedType: Analyzer::TypeId,
  ): Option<Hir::HirPattern> {
    let Option::SOME(pattern) = module.patterns.get(patternId) else {
      return Option::NONE;
    };

    match (pattern) {
      Ast::Pattern::Node::Wildcard(_) -> {
        return Option::SOME(Hir::HirPattern::Wildcard);
      },
      Ast::Pattern::Node::Binding(binding) -> {
        let defId: Analyzer::DefinitionId = Lowering::declarePatternBinding(
          defStore,
          symbols,
          output,
          locals,
          patternId,
          binding.name.toStr(),
          expectedType,
        );

        return Option::SOME(Hir::HirPattern::Binding(defId));
      },
      Ast::Pattern::Node::Literal(literal) -> {
        let Option::SOME(expression) = module.expressions.get(literal.expression) else {
          return Option::NONE;
        };

        let Ast::Expression::Node::Literal(literalExpr) = expression else {
          return Option::NONE;
        };

        let literalType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, literal.expression);

        return Option::SOME(Hir::HirPattern::Literal(Lowering::literalKind(typeStore, &literalExpr.value, literalType)));
      },
      Ast::Pattern::Node::Path(path) -> {
        return Lowering::lowerVariantPattern(defStore, typeStore, symbols, module, output, locals, patternId, &path);
      },
      Ast::Pattern::Node::Tuple(tuple) -> {
        let elementTypes: Vector<Analyzer::TypeId> = Lowering::tupleElementTypes(typeStore, expectedType);
        let Option::SOME(elements) = Lowering::lowerPatternList(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          &tuple.elements,
          &elementTypes,
        ) else {
          return Option::NONE;
        };

        return Option::SOME(Hir::HirPattern::Tuple(elements));
      },
      Ast::Pattern::Node::Or(orPattern) -> {
        // Every alternative matches the same value, so they all share the
        // scrutinee's type rather than taking a positional one.
        let mut alternativeTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
        let mut index: u64 = 0;

        while (index < orPattern.alternatives.length()) {
          alternativeTypes.push(expectedType);
          index += 1;
        }

        let Option::SOME(alternatives) = Lowering::lowerPatternList(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          &orPattern.alternatives,
          &alternativeTypes,
        ) else {
          return Option::NONE;
        };

        return Option::SOME(Hir::HirPattern::Or(alternatives));
      },
    };

    return Option::NONE;
  }

  /// Lowers a sequence of sub-patterns, pairing each with its expected type
  /// by position. `NONE` if any sub-pattern is outside this slice.
  function lowerPatternList(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    patternIds: &Vector<Ast::PatternId>,
    expectedTypes: &Vector<Analyzer::TypeId>,
  ): Option<Vector<Hir::HirPattern>> {
    let mut lowered: Vector<Hir::HirPattern> = Vector::new<Hir::HirPattern>();
    let mut index: u64 = 0;

    while (index < patternIds.length()) {
      let Option::SOME(subPatternId) = patternIds.get(index) else {
        return Option::NONE;
      };

      let mut expectedType: Analyzer::TypeId = Lowering::voidType(typeStore);
      if (let Option::SOME(positional) = expectedTypes.get(index)) {
        expectedType = *positional;
      }

      let Option::SOME(subPattern) = Lowering::lowerPattern(
        defStore,
        typeStore,
        symbols,
        module,
        output,
        locals,
        *subPatternId,
        expectedType,
      ) else {
        return Option::NONE;
      };

      lowered.push(subPattern);
      index += 1;
    }

    return Option::SOME(lowered);
  }

  /// Lowers a `Path` pattern that resolves to an enum variant. Record
  /// patterns and unresolved paths have no `HirPattern` counterpart and
  /// return `NONE`, unlike the Rust oracle's silent `Wildcard` fallback:
  /// a wildcard would change which values the pattern accepts.
  function lowerVariantPattern(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    patternId: Ast::PatternId,
    path: &Ast::Pattern::Path,
  ): Option<Hir::HirPattern> {
    let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Definition(variantDef)) = Analyzer::ResolverBodies::findPatternRef(
      &output.resolvedBodies.bodyResolution,
      patternId.raw(),
    ) else {
      return Option::NONE;
    };

    let Option::SOME(info) = Lowering::variantPatternInfo(defStore, variantDef) else {
      return Option::NONE;
    };

    let Option::SOME(args) = Lowering::lowerPatternList(
      defStore,
      typeStore,
      symbols,
      module,
      output,
      locals,
      &path.arguments,
      &info.payload,
    ) else {
      return Option::NONE;
    };

    return Option::SOME(Hir::HirPattern::Variant(Hir::VariantPattern {
      enumDef: info.enumDef,
      variantTag: info.variantTag,
      args: args,
    }));
  }

  // =========================================================================
  // Expressions
  // =========================================================================

  function lowerExpr(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
  ): Hir::HirId {
    let Option::SOME(expression) = module.expressions.get(exprId) else {
      return Lowering::errorNode(hir, typeStore, SourceSpan::new("", 0, 0));
    };

    match (expression) {
      Ast::Expression::Node::Literal(literal) -> {
        let literalType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);
        let kind: Hir::LiteralValue = Lowering::literalKind(typeStore, &literal.value, literalType);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Literal(kind),
          span: literal.span,
          typeId: literalType,
        });
      },
      Ast::Expression::Node::Variable(variable) -> {
        return Lowering::lowerNameRef(defStore, typeStore, symbols, module, output, locals, hir, exprId, variable.span);
      },
      Ast::Expression::Node::Call(call) -> {
        return Lowering::lowerCall(defStore, typeStore, symbols, module, output, locals, hir, exprId, &call);
      },
      Ast::Expression::Node::Binary(binaryExpr) -> {
        let left: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, binaryExpr.left);
        let right: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, binaryExpr.right);
        let binaryType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Binary(Hir::HirBinary {
            operation: Lowering::mapBinaryOperator(binaryExpr.operator),
            left: left,
            right: right,
          }),
          span: binaryExpr.span,
          typeId: binaryType,
        });
      },
      Ast::Expression::Node::Unary(unary) -> {
        let Option::SOME(operation) = Lowering::mapUnaryOperator(unary.operator) else {
          return Lowering::errorNode(hir, typeStore, unary.span);
        };

        let operand: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, unary.operand);
        let unaryType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Unary(Hir::HirUnary {
            operation: operation,
            operand: operand,
          }),
          span: unary.span,
          typeId: unaryType,
        });
      },
      Ast::Expression::Node::Grouped(grouped) -> {
        return Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, grouped.expression);
      },
      Ast::Expression::Node::Unit(unit) -> {
        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Unit,
          span: unit.span,
          typeId: Lowering::voidType(typeStore),
        });
      },
      Ast::Expression::Node::Assignment(assignment) -> {
        let target: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, assignment.target);
        let value: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, assignment.value);
        let assignType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Assign(Hir::HirAssign {
            target: target,
            value: value,
            operation: Lowering::mapAssignmentOperator(assignment.operator),
          }),
          span: assignment.span,
          typeId: assignType,
        });
      },
      Ast::Expression::Node::Block(block) -> {
        let blockType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);
        return Lowering::lowerBlockParts(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          hir,
          &block.statements,
          &block.tail,
          block.span,
          blockType,
        );
      },
      Ast::Expression::Node::If(ifExpr) -> {
        let condition: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, ifExpr.condition);
        let thenBranch: Hir::HirId = Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, ifExpr.thenBranch);

        let mut elseBranch: Option<Hir::HirId> = Option::NONE;
        if (let Option::SOME(elseId) = ifExpr.elseBranch) {
          elseBranch = Option::SOME(Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, elseId));
        }

        let ifType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::If(Hir::HirIf {
            condition: condition,
            thenBranch: thenBranch,
            elseBranch: elseBranch,
          }),
          span: ifExpr.span,
          typeId: ifType,
        });
      },
      Ast::Expression::Node::Ternary(ternary) -> {
        return Lowering::errorNode(hir, typeStore, ternary.span);
      },
      Ast::Expression::Node::Cast(cast) -> {
        return Lowering::lowerCast(defStore, typeStore, symbols, module, output, locals, hir, &cast);
      },
      Ast::Expression::Node::Path(path) -> {
        return Lowering::lowerNameRef(defStore, typeStore, symbols, module, output, locals, hir, exprId, path.span);
      },
      Ast::Expression::Node::Dereference(dereference) -> {
        let operand: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, dereference.operand);
        let operandType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, dereference.operand);

        let mut pointeeTypeId: Analyzer::TypeId = Lowering::voidType(typeStore);
        if (let Option::SOME(pointee) = Lowering::pointeeType(defStore, typeStore, operandType)) {
          pointeeTypeId = pointee;
        }

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Dereference(operand),
          span: dereference.span,
          typeId: pointeeTypeId,
        });
      },
      Ast::Expression::Node::Tuple(tuple) -> {
        let elements: Vector<Hir::HirId> = Lowering::lowerExpressionList(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          hir,
          &tuple.elements,
        );
        let tupleType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::TupleLiteral(elements),
          span: tuple.span,
          typeId: tupleType,
        });
      },
      Ast::Expression::Node::LetCondition(letCondition) -> {
        return Lowering::lowerLetCondition(defStore, typeStore, symbols, module, output, locals, hir, &letCondition);
      },
      Ast::Expression::Node::Reference(reference) -> {
        let target: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, reference.target);
        let targetType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, reference.target);

        let mut referenceType: Analyzer::TypeId = Lowering::voidType(typeStore);

        if (reference.mutable) {
          let mut mutableTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
          referenceType = mutableTypeStoreRef.mutableReference(targetType);
        } else {
          let mut sharedTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
          referenceType = sharedTypeStoreRef.reference(targetType);
        }

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Reference(Hir::HirReference {
            expression: target,
            mutable: reference.mutable,
          }),
          span: reference.span,
          typeId: referenceType,
        });
      },
      Ast::Expression::Node::Match(matchExpr) -> {
        return Lowering::lowerMatchExpr(defStore, typeStore, symbols, module, output, locals, hir, exprId, &matchExpr);
      },
      Ast::Expression::Node::Vector(vectorLiteral) -> {
        let elements: Vector<Hir::HirId> = Lowering::lowerExpressionList(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          hir,
          &vectorLiteral.elements,
        );

        // The oracle types a vector literal as a fixed array of its first
        // element's type rather than reading the checked type back.
        let mut elementType: Analyzer::TypeId = Lowering::voidType(typeStore);
        if (let Option::SOME(firstElementId) = vectorLiteral.elements.get(0)) {
          elementType = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, *firstElementId);
        }

        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let arrayType: Analyzer::TypeId = typeStoreRef.fixedArray(elementType, vectorLiteral.elements.length());

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::VectorLiteral(elements),
          span: vectorLiteral.span,
          typeId: arrayType,
        });
      },
      Ast::Expression::Node::VectorAccess(access) -> {
        let base: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, access.vector);
        let index: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, access.index);
        let baseType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, access.vector);

        let mut elementType: Analyzer::TypeId = Lowering::voidType(typeStore);
        if (let Option::SOME(element) = Lowering::indexElementType(defStore, typeStore, baseType)) {
          elementType = element;
        }

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Index(Hir::HirIndex {
            base: base,
            index: index,
          }),
          span: access.span,
          typeId: elementType,
        });
      },
      Ast::Expression::Node::PostfixIncrement(postfix) -> {
        return Lowering::errorNode(hir, typeStore, postfix.span);
      },
      Ast::Expression::Node::PostfixDecrement(postfix) -> {
        return Lowering::errorNode(hir, typeStore, postfix.span);
      },
      Ast::Expression::Node::MemberAccess(memberAccess) -> {
        return Lowering::lowerMemberAccess(defStore, typeStore, symbols, module, output, locals, hir, exprId, &memberAccess);
      },
      Ast::Expression::Node::RecordInit(recordInit) -> {
        return Lowering::lowerRecordInit(defStore, typeStore, symbols, module, output, locals, hir, exprId, &recordInit);
      },
      Ast::Expression::Node::BuiltinCall(builtinCall) -> {
        return Lowering::lowerBuiltinCall(defStore, typeStore, symbols, module, output, locals, hir, &builtinCall);
      },
      Ast::Expression::Node::Lambda(lambda) -> {
        return Lowering::errorNode(hir, typeStore, lambda.span);
      },
      Ast::Expression::Node::CaptureOverride(captureOverride) -> {
        return Lowering::errorNode(hir, typeStore, captureOverride.span);
      },
      Ast::Expression::Node::Pipe(pipe) -> {
        return Lowering::lowerPipe(defStore, typeStore, symbols, module, output, locals, hir, exprId, &pipe);
      },
      // Only reachable when a placeholder escaped its pipe: `lowerPipe`
      // substitutes the piped value for the placeholder it owns without ever
      // lowering the placeholder node itself.
      Ast::Expression::Node::PipePlaceholder(placeholder) -> {
        return Lowering::errorNode(hir, typeStore, placeholder.span);
      },
      Ast::Expression::Node::Try(tryExpr) -> {
        return Lowering::lowerTryExpr(defStore, typeStore, symbols, module, output, locals, hir, exprId, &tryExpr);
      },
    };

    return Lowering::errorNode(hir, typeStore, SourceSpan::new("", 0, 0));
  }

  /// Lowers a name reference (a `Variable` expression, or the single-segment
  /// `Path` the selfhost parser produces for bare identifiers) to
  /// `HirKind::Variable`. Local references map through the `LocalMap`;
  /// module-global references are limited to `Variable` and `Function`
  /// definitions — variants, records, and every other path shape are
  /// outside this slice and fall back to `Error`.
  function lowerNameRef(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
    span: SourceSpan,
  ): Hir::HirId {
    let Option::SOME(resolved) = Analyzer::ResolverBodies::findExprRef(
      &output.resolvedBodies.bodyResolution,
      exprId.raw(),
    ) else {
      return Lowering::errorNode(hir, typeStore, span);
    };

    let defIdOpt: Option<Analyzer::DefinitionId> = match (resolved) {
      Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> Lowering::lookupLocal(locals, localId),
      Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> Option::SOME(defId),
      Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> Option::NONE,
      Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> Option::NONE,
    };

    let Option::SOME(defId) = defIdOpt else {
      return Lowering::errorNode(hir, typeStore, span);
    };

    // `Enum::UNIT_VARIANT` names a value, not a binding: it lowers to a
    // payload-less `EnumVariant`, exactly like the oracle's `ResolvedPath::EnumVariant`
    // arm. A variant with a payload is a constructor and only lowers when applied.
    if (let Option::SOME(variantInfo) = Lowering::variantPatternInfo(defStore, defId)) {
      if (variantInfo.payload.length() > 0) {
        return Lowering::errorNode(hir, typeStore, span);
      }

      let variantType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

      let mut variantHirRef: &mut Hir::HirStore = hir;
      return variantHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::EnumVariant(Hir::HirEnumVariant {
          enumDef: variantInfo.enumDef,
          typeArgs: Lowering::instanceTypeArguments(defStore, typeStore, variantType),
          variantTag: variantInfo.variantTag,
          payload: Vector::new<Hir::HirId>(),
        }),
        span: span,
        typeId: variantType,
      });
    }

    let mut isReferenceable: boolean = false;
    let mut declaredType: Option<Analyzer::TypeId> = Option::NONE;

    if (let Option::SOME(definition) = defStore.get(defId)) {
      match (definition) {
        Analyzer::Definition::Variable(variableDef) -> {
          isReferenceable = true;
          declaredType = Option::SOME(variableDef.declaredType);
        },
        Analyzer::Definition::Function(_) -> {
          isReferenceable = true;
        },
        _ -> {},
      };
    }

    if (!isReferenceable) {
      return Lowering::errorNode(hir, typeStore, span);
    }

    // Assignment targets are not recorded in `exprTypes`, so a missing entry
    // falls back to the definition's declared type before the `void` sentinel.
    let mut variableType: Analyzer::TypeId = Lowering::voidType(typeStore);

    if (let Option::SOME(recordedType) = Lowering::lookupExprType(&output.typecheck, exprId)) {
      variableType = recordedType;
    } else if (let Option::SOME(fallbackType) = declaredType) {
      variableType = fallbackType;
    }

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Variable(defId),
      span: span,
      typeId: variableType,
    });
  }

  /// Lowers a list of expressions in source order: call arguments, tuple
  /// elements, and vector literal elements all share this walk.
  function lowerExpressionList(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    arguments: &Vector<Ast::ExpressionId>,
  ): Vector<Hir::HirId> {
    let mut lowered: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < arguments.length()) {
      let Option::SOME(argId) = arguments.get(index) else {
        index += 1;
        continue;
      };

      lowered.push(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, *argId));
      index += 1;
    }

    return lowered;
  }

  /// Lowers a call whose callee resolves to a free `Function` definition, or
  /// to a static `Definition::Method` reached through a path
  /// (`Type::method(args)`), which becomes a receiver-less `MethodCall`.
  ///
  /// `obj.method(args)` is dispatched on the callee's AST shape, exactly like
  /// the typechecker's own branch 1: the selfhost parser only ever builds a
  /// `Dot` `MemberAccess`, so `Type::method(args)` and `Enum::Variant(args)`
  /// arrive as `Path` callees instead.
  ///
  /// `Enum::Variant(args)` is a constructor rather than a call and lowers to
  /// `EnumVariant`, mirroring the oracle's `try_lower_path_call` enum arm.
  /// Closure calls and generic explicit type arguments are outside this slice
  /// and fall back to `Error`.
  /// Resolves explicitly written call type arguments (`f<T, U>(...)`) to
  /// semantic types with the typechecker's own non-emitting annotation probe.
  /// `NONE` when any argument fails to resolve, matching the checker's refusal.
  function resolveCallTypeArguments(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    typeArgumentIds: &Vector<Ast::TypeId>,
  ): Option<Vector<Analyzer::TypeId>> {
    let mut resolvedArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut index: u64 = 0;

    while (index < typeArgumentIds.length()) {
      let Option::SOME(annotationId) = typeArgumentIds.get(index) else {
        return Option::NONE;
      };

      let Option::SOME(resolved) = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        *annotationId,
      ) else {
        return Option::NONE;
      };

      resolvedArguments.push(resolved);
      index += 1;
    }

    return Option::SOME(resolvedArguments);
  }

  function lowerCall(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
    call: &Ast::Expression::Call,
  ): Hir::HirId {
    if (let Option::SOME(calleeExpr) = module.expressions.get(call.callee)) {
      if (let Ast::Expression::Node::MemberAccess(memberAccess) = calleeExpr) {
        return Lowering::lowerMethodCall(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          hir,
          exprId,
          call,
          &memberAccess,
        );
      }
    }

    let Option::SOME(callTypeArgs) = Lowering::resolveCallTypeArguments(
      defStore,
      typeStore,
      symbols,
      module,
      &call.typeArguments,
    ) else {
      return Lowering::errorNode(hir, typeStore, call.span);
    };

    let Option::SOME(resolved) = Analyzer::ResolverBodies::findExprRef(
      &output.resolvedBodies.bodyResolution,
      call.callee.raw(),
    ) else {
      return Lowering::errorNode(hir, typeStore, call.span);
    };

    let Analyzer::ResolverBodies::ResolvedRef::Definition(calleeDef) = resolved else {
      return Lowering::errorNode(hir, typeStore, call.span);
    };

    if (let Option::SOME(methodInfo) = Analyzer::Typecheck::lookupMethodDefInfo(defStore, calleeDef)) {
      // An instance method named through a path has no receiver to pass, and
      // the typechecker already rejects it; lowering it receiver-less would
      // invent a static call the source never wrote.
      if (!methodInfo.isStatic) {
        return Lowering::errorNode(hir, typeStore, call.span);
      }

      let staticArgs: Vector<Hir::HirId> = Lowering::lowerExpressionList(
        defStore,
        typeStore,
        symbols,
        module,
        output,
        locals,
        hir,
        &call.arguments,
      );

      let staticType: Analyzer::TypeId = match (Lowering::lookupExprType(&output.typecheck, exprId)) {
        Option::SOME(typeId) -> typeId,
        Option::NONE -> methodInfo.returnType,
      };

      let mut staticHirRef: &mut Hir::HirStore = hir;
      return staticHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::MethodCall(Hir::HirMethodCall {
          receiver: Option::NONE,
          method: calleeDef,
          typeArgs: callTypeArgs,
          args: staticArgs,
        }),
        span: call.span,
        typeId: staticType,
      });
    }

    if (let Option::SOME(variantInfo) = Lowering::variantPatternInfo(defStore, calleeDef)) {
      let payload: Vector<Hir::HirId> = Lowering::lowerExpressionList(
        defStore,
        typeStore,
        symbols,
        module,
        output,
        locals,
        hir,
        &call.arguments,
      );

      let variantType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

      let mut variantHirRef: &mut Hir::HirStore = hir;
      return variantHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::EnumVariant(Hir::HirEnumVariant {
          enumDef: variantInfo.enumDef,
          typeArgs: Lowering::instanceTypeArguments(defStore, typeStore, variantType),
          variantTag: variantInfo.variantTag,
          payload: payload,
        }),
        span: call.span,
        typeId: variantType,
      });
    }

    let mut calleeIsFunction: boolean = false;
    let mut calleeReturnType: Analyzer::TypeId = Lowering::voidType(typeStore);

    if (let Option::SOME(definition) = defStore.get(calleeDef)) {
      if (let Analyzer::Definition::Function(functionDef) = definition) {
        calleeIsFunction = true;
        calleeReturnType = functionDef.returnType;
      }
    }

    if (!calleeIsFunction) {
      return Lowering::errorNode(hir, typeStore, call.span);
    }

    let args: Vector<Hir::HirId> = Lowering::lowerExpressionList(
      defStore,
      typeStore,
      symbols,
      module,
      output,
      locals,
      hir,
      &call.arguments,
    );

    let callType: Analyzer::TypeId = match (Lowering::lookupExprType(&output.typecheck, exprId)) {
      Option::SOME(typeId) -> typeId,
      Option::NONE -> calleeReturnType,
    };

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Call(Hir::HirCall {
        callee: calleeDef,
        typeArgs: callTypeArgs,
        args: args,
      }),
      span: call.span,
      typeId: callType,
    });
  }

  /// Lowers `obj.method(args)` to `HirKind::MethodCall`.
  ///
  /// The method is found the way the typechecker finds it: the receiver's
  /// checked type is stripped of one reference layer, the resulting record or
  /// enum contributes its `instanceMethods` table, and the member name is
  /// looked up there. The receiver itself is passed straight through when the
  /// object is already a reference, and wrapped in `HirKind::Reference`
  /// otherwise, mutable exactly when the method binds `&mut self` — the same
  /// rule the Rust oracle applies.
  ///
  /// Extension-function calls (`obj.extMethod(args)` lowered to a plain
  /// `Call`) have no selfhost counterpart: the analyzer has no `@extension`
  /// support, so a member that misses the instance table falls back to
  /// `Error`.
  function lowerMethodCall(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
    call: &Ast::Expression::Call,
    memberAccess: &Ast::Expression::MemberAccess,
  ): Hir::HirId {
    let Option::SOME(callTypeArgs) = Lowering::resolveCallTypeArguments(
      defStore,
      typeStore,
      symbols,
      module,
      &call.typeArguments,
    ) else {
      return Lowering::errorNode(hir, typeStore, call.span);
    };

    if (memberAccess.operator != Ast::Expression::AccessOperator::Dot) {
      return Lowering::errorNode(hir, typeStore, call.span);
    }

    let baseType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, memberAccess.object);
    let referentOpt: Option<Analyzer::TypeId> = Lowering::referenceReferent(defStore, typeStore, baseType);

    let receiverType: Analyzer::TypeId = match (referentOpt) {
      Option::SOME(referent) -> referent,
      Option::NONE -> baseType,
    };

    let methods: Vector<Analyzer::DefinitionId> = Lowering::instanceMethodTable(defStore, typeStore, receiverType);

    let Option::SOME(methodDefId) = Analyzer::ResolverBodies::lookupMethodInTable(
      defStore,
      &methods,
      memberAccess.member.toStr(),
      symbols,
    ) else {
      return Lowering::errorNode(hir, typeStore, call.span);
    };

    let Option::SOME(methodInfo) = Analyzer::Typecheck::lookupMethodDefInfo(defStore, methodDefId) else {
      return Lowering::errorNode(hir, typeStore, call.span);
    };

    if (methodInfo.isStatic) {
      return Lowering::errorNode(hir, typeStore, call.span);
    }

    let base: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, memberAccess.object);

    let mut receiver: Hir::HirId = base;

    if (referentOpt.isNone()) {
      let mut referenceTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let mut receiverRefType: Analyzer::TypeId = referenceTypeStoreRef.reference(baseType);

      if (methodInfo.selfMutable) {
        let mut mutableTypeStoreRef: &mut Analyzer::TypeStore = typeStore;
        receiverRefType = mutableTypeStoreRef.mutableReference(baseType);
      }

      let mut referenceHirRef: &mut Hir::HirStore = hir;
      receiver = referenceHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::Reference(Hir::HirReference {
          expression: base,
          mutable: methodInfo.selfMutable,
        }),
        span: memberAccess.span,
        typeId: receiverRefType,
      });
    }

    let args: Vector<Hir::HirId> = Lowering::lowerExpressionList(
      defStore,
      typeStore,
      symbols,
      module,
      output,
      locals,
      hir,
      &call.arguments,
    );

    let callType: Analyzer::TypeId = match (Lowering::lookupExprType(&output.typecheck, exprId)) {
      Option::SOME(typeId) -> typeId,
      Option::NONE -> methodInfo.returnType,
    };

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::MethodCall(Hir::HirMethodCall {
        receiver: Option::SOME(receiver),
        method: methodDefId,
        typeArgs: callTypeArgs,
        args: args,
      }),
      span: call.span,
      typeId: callType,
    });
  }

  /// Lowers `obj.field` to `HirKind::FieldAccess`, inserting the single
  /// `Dereference` the oracle's `auto_deref_for_lowering` inserts when the
  /// object is a reference.
  ///
  /// `Type::member` never reaches here: the selfhost parser turns `::` into a
  /// `Path` expression, so `MemberAccess` always carries `Dot` and the
  /// oracle's static-access branch (`StaticAccess`, unit `EnumVariant`) has no
  /// reachable form to lower.
  function lowerMemberAccess(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
    memberAccess: &Ast::Expression::MemberAccess,
  ): Hir::HirId {
    if (memberAccess.operator != Ast::Expression::AccessOperator::Dot) {
      return Lowering::errorNode(hir, typeStore, memberAccess.span);
    }

    let baseType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, memberAccess.object);
    let base: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, memberAccess.object);

    let mut accessBase: Hir::HirId = base;
    let mut accessType: Analyzer::TypeId = baseType;

    if (let Option::SOME(referent) = Lowering::referenceReferent(defStore, typeStore, baseType)) {
      accessType = referent;

      let mut derefHirRef: &mut Hir::HirStore = hir;
      accessBase = derefHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::Dereference(base),
        span: memberAccess.span,
        typeId: referent,
      });
    }

    let Option::SOME(field) = Lowering::recordFieldLocation(
      defStore,
      typeStore,
      symbols,
      accessType,
      memberAccess.member.toStr(),
    ) else {
      return Lowering::errorNode(hir, typeStore, memberAccess.span);
    };

    let fieldType: Analyzer::TypeId = match (Lowering::lookupExprType(&output.typecheck, exprId)) {
      Option::SOME(typeId) -> typeId,
      Option::NONE -> field.fieldType,
    };

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::FieldAccess(Hir::HirFieldAccess {
        base: accessBase,
        fieldIndex: field.index,
      }),
      span: memberAccess.span,
      typeId: fieldType,
    });
  }

  /// Lowers `expr as T` to `HirKind::Cast`. The target type is resolved from
  /// the annotation with the same helper the typechecker's cast branch uses,
  /// and types the node, exactly like the oracle's `resolve_type_syntax`.
  /// An unresolvable target has no type to cast to and falls back to `Error`.
  function lowerCast(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    cast: &Ast::Expression::Cast,
  ): Hir::HirId {
    let expression: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, cast.expression);

    let Option::SOME(targetType) = Analyzer::Typecheck::resolveLocalAnnotation(
      defStore,
      typeStore,
      symbols,
      module,
      cast.targetType,
    ) else {
      return Lowering::errorNode(hir, typeStore, cast.span);
    };

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Cast(Hir::HirCast {
        expression: expression,
        target: targetType,
      }),
      span: cast.span,
      typeId: targetType,
    });
  }

  /// Lowers `Rec { field: value, ... }` to `HirKind::RecordInit`.
  ///
  /// Values are lowered in source order and the resulting fields are emitted
  /// in declaration order, which is what the oracle's trailing sort by field
  /// index produces. A field name the record does not declare is dropped
  /// without lowering its value, mirroring the oracle's `find` miss.
  ///
  /// The record definition is re-derived from the checked type of the whole
  /// initializer instead of from the path expression: the selfhost
  /// typechecker records the record type on this node, and the oracle's
  /// `resolve_record_path_for_lowering` has no selfhost counterpart.
  /// Explicit type arguments are rejected outright by the typechecker
  /// ("generic record initializers"), so they stay on `Error`.
  function lowerRecordInit(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
    recordInit: &Ast::Expression::RecordInit,
  ): Hir::HirId {
    if (recordInit.typeArguments.length() > 0) {
      return Lowering::errorNode(hir, typeStore, recordInit.span);
    }

    let resultType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

    let Option::SOME(recordDef) = Lowering::nominalDefinition(defStore, typeStore, resultType) else {
      return Lowering::errorNode(hir, typeStore, recordInit.span);
    };

    if (Lowering::recordFieldDefinitions(defStore, typeStore, resultType).isNone()) {
      return Lowering::errorNode(hir, typeStore, recordInit.span);
    }

    let mut fieldIndexes: Vector<u32> = Vector::new<u32>();
    let mut fieldValues: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < recordInit.fields.length()) {
      let Option::SOME(field) = recordInit.fields.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(location) = Lowering::recordFieldLocation(
        defStore,
        typeStore,
        symbols,
        resultType,
        field.name.toStr(),
      ) else {
        index += 1;
        continue;
      };

      fieldIndexes.push(location.index);
      fieldValues.push(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, field.value));

      index += 1;
    }

    let fields: Vector<Hir::HirRecordField> = Lowering::recordFieldsInDeclarationOrder(&fieldIndexes, &fieldValues);
    let typeArgs: Vector<Analyzer::TypeId> = Lowering::instanceTypeArguments(defStore, typeStore, resultType);

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::RecordInit(Hir::HirRecordInit {
        recordDef: recordDef,
        typeArgs: typeArgs,
        fields: fields,
      }),
      span: recordInit.span,
      typeId: resultType,
    });
  }

  /// Reorders the `(field index, value)` pairs collected in source order into
  /// ascending field index, the order the oracle's sort leaves them in.
  function recordFieldsInDeclarationOrder(
    fieldIndexes: &Vector<u32>,
    fieldValues: &Vector<Hir::HirId>,
  ): Vector<Hir::HirRecordField> {
    let mut fields: Vector<Hir::HirRecordField> = Vector::new<Hir::HirRecordField>();

    let mut emitted: Vector<boolean> = Vector::new<boolean>();
    let mut flagIndex: u64 = 0;

    while (flagIndex < fieldIndexes.length()) {
      emitted.push(false);
      flagIndex += 1;
    }

    let mut remaining: u64 = fieldIndexes.length();

    while (remaining > 0) {
      let mut bestPosition: Option<u64> = Option::NONE;
      let mut bestIndex: u32 = 0;
      let mut position: u64 = 0;

      while (position < fieldIndexes.length()) {
        let Option::SOME(alreadyEmitted) = emitted.get(position) else {
          position += 1;
          continue;
        };
        let Option::SOME(fieldIndex) = fieldIndexes.get(position) else {
          position += 1;
          continue;
        };

        if (*alreadyEmitted) {
          position += 1;
          continue;
        }

        if (bestPosition.isNone() || *fieldIndex < bestIndex) {
          bestPosition = Option::SOME(position);
          bestIndex = *fieldIndex;
        }

        position += 1;
      }

      let Option::SOME(chosen) = bestPosition else {
        return fields;
      };

      if (let Option::SOME(value) = fieldValues.get(chosen)) {
        fields.push(Hir::HirRecordField {
          fieldIndex: bestIndex,
          value: *value,
        });
      }

      emitted.set(chosen, true);
      remaining -= 1;
    }

    return fields;
  }

  /// Lowers the `@name(...)` builtins the selfhost typechecker accepts.
  ///
  /// `@sizeOf` / `@alignOf` take their single type argument through the same
  /// annotation resolver the checker uses, `@panic` lowers its message
  /// operand, and `@trap` / `@unreachable` carry nothing. Every other builtin
  /// — including the ones with an `HirKind` counterpart such as `@maxOf` /
  /// `@minOf` / `@bitCast` — is rejected by the typechecker as unsupported,
  /// so no checked operand or result type exists to lower against and the
  /// call stays on `Error`.
  ///
  /// `@typeName` stays on `Error` for a language reason rather than a model
  /// one: the oracle folds it to the printed type name, and the selfhost type
  /// printer (`TypeStore::nameOfResolved`) takes shared borrows of the three
  /// stores, which lowering holds mutably end to end. The compiler has no
  /// `&mut` to `&` reborrow, so the call cannot be made from here.
  function lowerBuiltinCall(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    builtinCall: &Ast::Expression::BuiltinCall,
  ): Hir::HirId {
    let name: &String = &builtinCall.name;

    if (name.equals("trap")) {
      let mut trapHirRef: &mut Hir::HirStore = hir;
      return trapHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::Trap,
        span: builtinCall.span,
        typeId: Lowering::neverType(typeStore),
      });
    }

    if (name.equals("unreachable")) {
      let mut unreachableHirRef: &mut Hir::HirStore = hir;
      return unreachableHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::BuiltinUnreachable,
        span: builtinCall.span,
        typeId: Lowering::neverType(typeStore),
      });
    }

    if (name.equals("panic")) {
      let Option::SOME(messageId) = builtinCall.arguments.get(0) else {
        return Lowering::errorNode(hir, typeStore, builtinCall.span);
      };

      let message: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, *messageId);

      let mut panicHirRef: &mut Hir::HirStore = hir;
      return panicHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::Panic(message),
        span: builtinCall.span,
        typeId: Lowering::neverType(typeStore),
      });
    }

    let mut takesTypeArgument: boolean = false;

    if (name.equals("sizeOf") || name.equals("alignOf")) {
      takesTypeArgument = true;
    }

    if (!takesTypeArgument) {
      return Lowering::errorNode(hir, typeStore, builtinCall.span);
    }

    let Option::SOME(typeArgumentId) = builtinCall.typeArguments.get(0) else {
      return Lowering::errorNode(hir, typeStore, builtinCall.span);
    };

    let Option::SOME(operandType) = Analyzer::Typecheck::resolveLocalAnnotation(
      defStore,
      typeStore,
      symbols,
      module,
      *typeArgumentId,
    ) else {
      return Lowering::errorNode(hir, typeStore, builtinCall.span);
    };

    if (name.equals("sizeOf")) {
      let mut sizeHirRef: &mut Hir::HirStore = hir;
      return sizeHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::SizeOf(operandType),
        span: builtinCall.span,
        typeId: Lowering::unsignedInt64Type(typeStore),
      });
    }

    let mut alignHirRef: &mut Hir::HirStore = hir;
    return alignHirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::AlignOf(operandType),
      span: builtinCall.span,
      typeId: Lowering::unsignedInt64Type(typeStore),
    });
  }

  /// Everything the `try` desugar needs from a `@lang(try)` enum: the
  /// definition, the applied type arguments, and the tag plus payload types
  /// of the ok and err variants.
  record TryEnumInfo {
    public enumDef: Analyzer::DefinitionId;
    public typeArgs: Vector<Analyzer::TypeId>;
    public okTag: u32;
    public errTag: u32;
    public okPayload: Vector<Analyzer::TypeId>;
    public errPayload: Vector<Analyzer::TypeId>;
  }

  function tryVariantPayload(
    defStore: &mut Analyzer::DefinitionStore,
    variants: &Vector<Analyzer::DefinitionId>,
    tag: u32,
  ): Vector<Analyzer::TypeId> {
    let empty: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    let Option::SOME(variantDefId) = variants.get(tag as u64) else {
      return empty;
    };

    let Option::SOME(definition) = defStore.get(*variantDefId) else {
      return empty;
    };

    let Analyzer::Definition::Variant(variant) = definition else {
      return empty;
    };

    return Analyzer::Typecheck::copyVariantPayloadTypeIds(&variant.payload);
  }

  function tryEnumInfo(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): Option<Lowering::TryEnumInfo> {
    let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

    if (resolved.cycleAlias.isSome()) {
      return Option::NONE;
    }

    let Option::SOME(decomposition) = Analyzer::Typecheck::tryDecomposeEnumType(typeStore, resolved.typeId) else {
      return Option::NONE;
    };

    let Option::SOME(parts) = Analyzer::Typecheck::tryEnumParts(defStore, decomposition.enumDefId) else {
      return Option::NONE;
    };

    return Option::SOME(Lowering::TryEnumInfo {
      enumDef: decomposition.enumDefId,
      typeArgs: decomposition.typeArguments,
      okTag: parts.okVariant,
      errTag: parts.errVariant,
      okPayload: Lowering::tryVariantPayload(defStore, &parts.variants, parts.okVariant),
      errPayload: Lowering::tryVariantPayload(defStore, &parts.variants, parts.errVariant),
    });
  }

  /// Allocates one of the two synthetic bindings the `try` desugar needs.
  /// They are never registered in the `LocalMap`: no source name refers to
  /// them, only the generated pattern and body do.
  function declareTryBinding(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    name: str,
    declaredType: Analyzer::TypeId,
  ): Analyzer::DefinitionId {
    let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
    let nameSym: Analyzer::SymbolId = symbolsRef.intern(name);

    let mut defStoreRef: &mut Analyzer::DefinitionStore = defStore;
    return defStoreRef.push(Analyzer::Definition::Variable(Analyzer::VariableDef {
      name: nameSym,
      visibility: Analyzer::Visibility::PRIVATE,
      declaredType: declaredType,
      mutable: false,
    }));
  }

  /// Lowers a postfix `!` to the two-arm `Match` the Rust oracle desugars it
  /// into: the ok arm yields the unwrapped payload, and the err arm returns
  /// the error re-wrapped in the same variant, propagating it to the caller.
  ///
  /// The oracle decides whether each arm binds a payload by asking whether
  /// the payload type is `void`; the decision is made on payload arity here
  /// instead, which is the same rule variant *patterns* already follow in this
  /// module. The bindings carry the resolved payload type.
  function lowerTryExpr(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
    tryExpr: &Ast::Expression::Try,
  ): Hir::HirId {
    let scrutinee: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, tryExpr.expression);
    let scrutineeType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, tryExpr.expression);

    let Option::SOME(info) = Lowering::tryEnumInfo(defStore, typeStore, scrutineeType) else {
      return Lowering::errorNode(hir, typeStore, tryExpr.span);
    };

    let voidTypeId: Analyzer::TypeId = Lowering::voidType(typeStore);

    let mut okInnerType: Analyzer::TypeId = voidTypeId;
    if (let Option::SOME(payloadType) = info.okPayload.get(0)) {
      okInnerType = *payloadType;
    }

    let mut errInnerType: Analyzer::TypeId = voidTypeId;
    if (let Option::SOME(payloadType) = info.errPayload.get(0)) {
      errInnerType = *payloadType;
    }

    let mut okBinding: Option<Analyzer::DefinitionId> = Option::NONE;
    if (info.okPayload.length() == 1) {
      okBinding = Option::SOME(Lowering::declareTryBinding(defStore, symbols, "_try_ok_value", okInnerType));
    }

    let mut errBinding: Option<Analyzer::DefinitionId> = Option::NONE;
    if (info.errPayload.length() == 1) {
      errBinding = Option::SOME(Lowering::declareTryBinding(defStore, symbols, "_try_err_value", errInnerType));
    }

    let mut okArgs: Vector<Hir::HirPattern> = Vector::new<Hir::HirPattern>();

    let mut okBodyHirRef: &mut Hir::HirStore = hir;
    let mut okBody: Hir::HirId = match (okBinding) {
      Option::SOME(okBindingId) -> okBodyHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::Variable(okBindingId),
        span: tryExpr.span,
        typeId: okInnerType,
      }),
      Option::NONE -> okBodyHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::Unit,
        span: tryExpr.span,
        typeId: voidTypeId,
      }),
    };

    if (let Option::SOME(okBindingId) = okBinding) {
      okArgs.push(Hir::HirPattern::Binding(okBindingId));
    }

    let mut errPayloadNodes: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut errArgs: Vector<Hir::HirPattern> = Vector::new<Hir::HirPattern>();

    if (let Option::SOME(errBindingId) = errBinding) {
      let mut errHirRef: &mut Hir::HirStore = hir;
      errPayloadNodes.push(errHirRef.alloc(Hir::HirNode {
        kind: Hir::HirKind::Variable(errBindingId),
        span: tryExpr.span,
        typeId: errInnerType,
      }));
      errArgs.push(Hir::HirPattern::Binding(errBindingId));
    }

    // The propagated value is typed by the enclosing function's return type
    // when that names the same enum, and by the operand's type otherwise —
    // the oracle's `current_lowering_return_type()` filter.
    let mut errValueType: Analyzer::TypeId = scrutineeType;

    if (let Option::SOME(returnType) = locals.currentReturnType) {
      if (let Option::SOME(returnEnum) = Lowering::nominalDefinition(defStore, typeStore, returnType)) {
        if (returnEnum.raw() == info.enumDef.raw()) {
          errValueType = returnType;
        }
      }
    }

    let mut errTypeArgs: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut typeArgIndex: u64 = 0;

    while (typeArgIndex < info.typeArgs.length()) {
      if (let Option::SOME(typeArg) = info.typeArgs.get(typeArgIndex)) {
        errTypeArgs.push(*typeArg);
      }

      typeArgIndex += 1;
    }

    let mut errHirRef2: &mut Hir::HirStore = hir;

    let errValue: Hir::HirId = errHirRef2.alloc(Hir::HirNode {
      kind: Hir::HirKind::EnumVariant(Hir::HirEnumVariant {
        enumDef: info.enumDef,
        typeArgs: errTypeArgs,
        variantTag: info.errTag,
        payload: errPayloadNodes,
      }),
      span: tryExpr.span,
      typeId: errValueType,
    });

    // The oracle types this synthetic `Return` as `void` rather than `never`,
    // unlike the `return` statements it lowers from source.
    let errBody: Hir::HirId = errHirRef2.alloc(Hir::HirNode {
      kind: Hir::HirKind::Return(Option::SOME(errValue)),
      span: tryExpr.span,
      typeId: voidTypeId,
    });

    let mut arms: Vector<Hir::HirMatchArm> = Vector::new<Hir::HirMatchArm>();

    arms.push(Hir::HirMatchArm {
      pattern: Hir::HirPattern::Variant(Hir::VariantPattern {
        enumDef: info.enumDef,
        variantTag: info.okTag,
        args: okArgs,
      }),
      guard: Option::NONE,
      body: okBody,
    });
    arms.push(Hir::HirMatchArm {
      pattern: Hir::HirPattern::Variant(Hir::VariantPattern {
        enumDef: info.enumDef,
        variantTag: info.errTag,
        args: errArgs,
      }),
      guard: Option::NONE,
      body: errBody,
    });

    let resultType: Analyzer::TypeId = match (Lowering::lookupExprType(&output.typecheck, exprId)) {
      Option::SOME(typeId) -> typeId,
      Option::NONE -> okInnerType,
    };

    return errHirRef2.alloc(Hir::HirNode {
      kind: Hir::HirKind::Match(Hir::HirMatch {
        scrutinee: scrutinee,
        arms: arms,
      }),
      span: tryExpr.span,
      typeId: resultType,
    });
  }

  /// Where the piped value lands in the callee's argument list.
  record PipePlacement {
    public callee: Ast::ExpressionId;
    public extraArgs: Vector<Ast::ExpressionId>;
    /// Index of the `_` the piped value replaces; `NONE` means "prepend".
    public replaceAt: Option<u64>;
  }

  function copyExpressionIds(source: &Vector<Ast::ExpressionId>): Vector<Ast::ExpressionId> {
    let mut out: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(exprId) = source.get(index)) {
        out.push(*exprId);
      }

      index += 1;
    }

    return out;
  }

  /// Index of the direct argument that is a `_` placeholder, if any.
  function directPlaceholderIndex(
    module: &Ast::Module,
    arguments: &Vector<Ast::ExpressionId>,
  ): Option<u64> {
    let mut index: u64 = 0;

    while (index < arguments.length()) {
      if (let Option::SOME(argId) = arguments.get(index)) {
        if (let Option::SOME(argExpr) = module.expressions.get(*argId)) {
          if (let Ast::Expression::Node::PipePlaceholder(_) = argExpr) {
            return Option::SOME(index);
          }
        }
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// Reads the right side of a pipe the same way the typechecker does: a call
  /// supplies its own arguments around the piped value, and a bare name is
  /// called with the value alone. `NONE` for every shape whose placement this
  /// slice does not lower — a lambda, a bare method, a record initializer, a
  /// vector literal, a builtin call, or a `_` nested deeper than a direct
  /// argument of the right-side call.
  function pipePlacement(
    module: &Ast::Module,
    pipe: &Ast::Expression::Pipe,
  ): Option<Lowering::PipePlacement> {
    if (Analyzer::Typecheck::countPipePlaceholders(module, pipe.right) > 1) {
      return Option::NONE;
    }

    let rightExprId: Ast::ExpressionId = Analyzer::Typecheck::unwrapGroupedExpr(module, pipe.right);

    let Option::SOME(rightExpr) = module.expressions.get(rightExprId) else {
      return Option::NONE;
    };

    match (rightExpr) {
      Ast::Expression::Node::Call(call) -> {
        if (call.typeArguments.length() > 0) {
          return Option::NONE;
        }

        let extraArgs: Vector<Ast::ExpressionId> = Lowering::copyExpressionIds(&call.arguments);
        let replaceAt: Option<u64> = Lowering::directPlaceholderIndex(module, &extraArgs);

        if (Analyzer::Typecheck::countPipePlaceholders(module, pipe.right) == 1 && replaceAt.isNone()) {
          return Option::NONE;
        }

        return Option::SOME(Lowering::PipePlacement {
          callee: call.callee,
          extraArgs: extraArgs,
          replaceAt: replaceAt,
        });
      },
      Ast::Expression::Node::Path(_) -> {
        if (Analyzer::Typecheck::countPipePlaceholders(module, pipe.right) > 0) {
          return Option::NONE;
        }

        return Option::SOME(Lowering::PipePlacement {
          callee: rightExprId,
          extraArgs: Vector::new<Ast::ExpressionId>(),
          replaceAt: Option::NONE,
        });
      },
      Ast::Expression::Node::Variable(_) -> {
        if (Analyzer::Typecheck::countPipePlaceholders(module, pipe.right) > 0) {
          return Option::NONE;
        }

        return Option::SOME(Lowering::PipePlacement {
          callee: rightExprId,
          extraArgs: Vector::new<Ast::ExpressionId>(),
          replaceAt: Option::NONE,
        });
      },
      _ -> {
        return Option::NONE;
      },
    };

    return Option::NONE;
  }

  /// Lowers `left |> right` to the `HirKind::Call` the Rust oracle builds for
  /// a `PipeResolution::DirectCall`: the piped value is lowered first, then
  /// either prepended to the callee's own arguments or substituted for the
  /// `_` placeholder that named its position.
  ///
  /// The oracle reads the callee out of the `pipe_resolutions` table the
  /// typechecker fills. The selfhost `TypecheckOutput` has no such table, so
  /// the right side is re-read here with the same rules `checkPipeImplicit`
  /// uses. Only a free `Function` callee is lowered: pipes into methods,
  /// lambdas and closure values need the resolution data that table would
  /// carry, and stay on `Error`.
  function lowerPipe(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
    pipe: &Ast::Expression::Pipe,
  ): Hir::HirId {
    let Option::SOME(placement) = Lowering::pipePlacement(module, pipe) else {
      return Lowering::errorNode(hir, typeStore, pipe.span);
    };

    let Option::SOME(resolved) = Analyzer::ResolverBodies::findExprRef(
      &output.resolvedBodies.bodyResolution,
      placement.callee.raw(),
    ) else {
      return Lowering::errorNode(hir, typeStore, pipe.span);
    };

    let Analyzer::ResolverBodies::ResolvedRef::Definition(calleeDef) = resolved else {
      return Lowering::errorNode(hir, typeStore, pipe.span);
    };

    let mut calleeIsFunction: boolean = false;
    let mut calleeReturnType: Analyzer::TypeId = Lowering::voidType(typeStore);

    if (let Option::SOME(definition) = defStore.get(calleeDef)) {
      if (let Analyzer::Definition::Function(functionDef) = definition) {
        calleeIsFunction = true;
        calleeReturnType = functionDef.returnType;
      }
    }

    if (!calleeIsFunction) {
      return Lowering::errorNode(hir, typeStore, pipe.span);
    }

    let piped: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, pipe.left);

    let mut args: Vector<Hir::HirId> = Vector::new<Hir::HirId>();

    if (placement.replaceAt.isNone()) {
      args.push(piped);
    }

    let mut index: u64 = 0;

    while (index < placement.extraArgs.length()) {
      let Option::SOME(argId) = placement.extraArgs.get(index) else {
        index += 1;
        continue;
      };

      let mut isPlaceholder: boolean = false;
      if (let Option::SOME(replaceIndex) = placement.replaceAt) {
        isPlaceholder = replaceIndex == index;
      }

      if (isPlaceholder) {
        args.push(piped);
      } else {
        args.push(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, *argId));
      }

      index += 1;
    }

    let pipeType: Analyzer::TypeId = match (Lowering::lookupExprType(&output.typecheck, exprId)) {
      Option::SOME(typeId) -> typeId,
      Option::NONE -> calleeReturnType,
    };

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Call(Hir::HirCall {
        callee: calleeDef,
        typeArgs: Vector::new<Analyzer::TypeId>(),
        args: args,
      }),
      span: pipe.span,
      typeId: pipeType,
    });
  }

  /// Lowers a `match` to `HirKind::Match`. Each arm lowers its pattern
  /// first, so the bindings it introduces are registered before the guard
  /// and body that reference them. An arm whose pattern is outside this
  /// slice sends the whole match to `Error`.
  function lowerMatchExpr(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    exprId: Ast::ExpressionId,
    matchExpr: &Ast::Expression::Match,
  ): Hir::HirId {
    let scrutinee: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, matchExpr.scrutinee);
    let scrutineeType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, matchExpr.scrutinee);

    let mut arms: Vector<Hir::HirMatchArm> = Vector::new<Hir::HirMatchArm>();
    let mut index: u64 = 0;

    while (index < matchExpr.arms.length()) {
      let Option::SOME(arm) = matchExpr.arms.get(index) else {
        return Lowering::errorNode(hir, typeStore, matchExpr.span);
      };

      let Option::SOME(pattern) = Lowering::lowerPattern(
        defStore,
        typeStore,
        symbols,
        module,
        output,
        locals,
        arm.pattern,
        scrutineeType,
      ) else {
        return Lowering::errorNode(hir, typeStore, matchExpr.span);
      };

      let mut guard: Option<Hir::HirId> = Option::NONE;
      if (let Option::SOME(guardId) = arm.guard) {
        guard = Option::SOME(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, guardId));
      }

      let body: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, arm.body);

      arms.push(Hir::HirMatchArm {
        pattern: pattern,
        guard: guard,
        body: body,
      });

      index += 1;
    }

    let matchType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprId);

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Match(Hir::HirMatch {
        scrutinee: scrutinee,
        arms: arms,
      }),
      span: matchExpr.span,
      typeId: matchType,
    });
  }

  /// Lowers an `if let` / `while let` condition to the two-arm boolean
  /// `Match` the Rust oracle desugars it into: the pattern arm yields
  /// `true`, a trailing wildcard arm yields `false`, and the enclosing
  /// `If`/`Loop` consumes that boolean.
  ///
  /// The selfhost typechecker rejects let conditions outright, so no
  /// expression type is ever recorded for this node; the boolean type is
  /// interned directly, exactly like the oracle does.
  function lowerLetCondition(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    letCondition: &Ast::Expression::LetCondition,
  ): Hir::HirId {
    let scrutinee: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, letCondition.value);
    let scrutineeType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, letCondition.value);

    let Option::SOME(pattern) = Lowering::lowerPattern(
      defStore,
      typeStore,
      symbols,
      module,
      output,
      locals,
      letCondition.pattern,
      scrutineeType,
    ) else {
      return Lowering::errorNode(hir, typeStore, letCondition.span);
    };

    let booleanTypeId: Analyzer::TypeId = Lowering::booleanType(typeStore);

    let mut hirRef: &mut Hir::HirStore = hir;

    let trueNode: Hir::HirId = hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Literal(Hir::LiteralValue::Boolean(true)),
      span: letCondition.span,
      typeId: booleanTypeId,
    });
    let falseNode: Hir::HirId = hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Literal(Hir::LiteralValue::Boolean(false)),
      span: letCondition.span,
      typeId: booleanTypeId,
    });

    let mut arms: Vector<Hir::HirMatchArm> = Vector::new<Hir::HirMatchArm>();
    arms.push(Hir::HirMatchArm {
      pattern: pattern,
      guard: Option::NONE,
      body: trueNode,
    });
    arms.push(Hir::HirMatchArm {
      pattern: Hir::HirPattern::Wildcard,
      guard: Option::NONE,
      body: falseNode,
    });

    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Match(Hir::HirMatch {
        scrutinee: scrutinee,
        arms: arms,
      }),
      span: letCondition.span,
      typeId: booleanTypeId,
    });
  }

  // =========================================================================
  // Statements
  // =========================================================================

  /// Shared lowering for statement blocks and expression blocks. Comments
  /// are skipped instead of lowered: the Rust AST has no comment
  /// statements, so a comment node would otherwise force a synthetic HIR
  /// node with no oracle counterpart.
  function lowerBlockParts(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    statements: &Vector<Ast::StatementId>,
    tail: &Option<Ast::ExpressionId>,
    span: SourceSpan,
    blockType: Analyzer::TypeId,
  ): Hir::HirId {
    let mut loweredStatements: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < statements.length()) {
      let Option::SOME(stmtId) = statements.get(index) else {
        index += 1;
        continue;
      };

      let mut isComment: boolean = false;
      if (let Option::SOME(stmt) = module.statements.get(*stmtId)) {
        if (let Ast::Statement::Node::Comment(_) = stmt) {
          isComment = true;
        }
      }

      if (isComment) {
        index += 1;
        continue;
      }

      loweredStatements.push(Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, *stmtId));
      index += 1;
    }

    let mut tailExpr: Option<Hir::HirId> = Option::NONE;
    if (let Option::SOME(tailId) = tail) {
      tailExpr = Option::SOME(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, tailId));
    }

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Block(Hir::HirBlock {
        statements: loweredStatements,
        expression: tailExpr,
      }),
      span: span,
      typeId: blockType,
    });
  }

  /// Lowers a `let`/`let mut` with a simple `Binding` pattern: allocates a
  /// `Definition::Variable` for the binding site, registers it in the
  /// `LocalMap` after the initializer is lowered (the binding is not
  /// visible inside its own initializer), and records the initializer in
  /// `variablesInits` like the Rust oracle. Destructuring patterns are
  /// outside this slice and fall back to `Error`.
  function lowerLetLike(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    span: SourceSpan,
    patternId: Ast::PatternId,
    value: &Option<Ast::ExpressionId>,
    mutable: boolean,
  ): Hir::HirId {
    let mut bindingName: String = String::create("");
    let mut isBinding: boolean = false;

    if (let Option::SOME(pattern) = module.patterns.get(patternId)) {
      if (let Ast::Pattern::Node::Binding(binding) = pattern) {
        bindingName = binding.name.clone();
        isBinding = true;
      }
    }

    if (!isBinding) {
      return Lowering::errorNode(hir, typeStore, span);
    }

    let mut init: Option<Hir::HirId> = Option::NONE;
    let mut bindingType: Analyzer::TypeId = Lowering::voidType(typeStore);

    if (let Option::SOME(valueId) = value) {
      init = Option::SOME(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, valueId));
      bindingType = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, valueId);
    }

    let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
    let nameSym: Analyzer::SymbolId = symbolsRef.intern(bindingName.toStr());

    let mut defStoreRef: &mut Analyzer::DefinitionStore = defStore;
    let defId: Analyzer::DefinitionId = defStoreRef.push(Analyzer::Definition::Variable(Analyzer::VariableDef {
      name: nameSym,
      visibility: Analyzer::Visibility::PRIVATE,
      declaredType: bindingType,
      mutable: mutable,
    }));

    if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Local(localId)) = Analyzer::ResolverBodies::findPatternRef(
      &output.resolvedBodies.bodyResolution,
      patternId.raw(),
    )) {
      Lowering::registerLocal(locals, localId, defId);
    }

    let mut hirRef: &mut Hir::HirStore = hir;

    if (let Option::SOME(initId) = init) {
      hirRef.setVariableInit(defId, initId);
    }

    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Let(Hir::HirLet {
        name: defId,
        value: init,
      }),
      span: span,
      typeId: Lowering::voidType(typeStore),
    });
  }

  /// Lowers a `let ... else` to `HirKind::LetElse`. The value and the else
  /// block are lowered before the pattern, so the bindings are registered
  /// after the block that cannot see them and before the statements that
  /// can, mirroring the Rust oracle's order.
  ///
  /// The annotated shorthand (`let x: T = optional else { ... }`, which the
  /// oracle desugars through the scrutinee's try-capable ok variant) stays
  /// on the `Error` fallback: the selfhost analyzer binds the annotation
  /// type to the pattern directly and exposes no ok-variant resolution, so
  /// there is nothing to derive the unwrapping pattern from.
  function lowerLetElse(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    letElse: &Ast::Statement::LetElse,
  ): Hir::HirId {
    let mut isShorthand: boolean = false;

    if (letElse.annotation.isSome()) {
      if (let Option::SOME(pattern) = module.patterns.get(letElse.pattern)) {
        if (let Ast::Pattern::Node::Binding(_) = pattern) {
          isShorthand = true;
        }
      }
    }

    if (isShorthand) {
      return Lowering::errorNode(hir, typeStore, letElse.span);
    }

    let value: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, letElse.value);
    let elseBlock: Hir::HirId = Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, letElse.elseBranch);
    let valueType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, letElse.value);

    let Option::SOME(pattern) = Lowering::lowerPattern(
      defStore,
      typeStore,
      symbols,
      module,
      output,
      locals,
      letElse.pattern,
      valueType,
    ) else {
      return Lowering::errorNode(hir, typeStore, letElse.span);
    };

    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::LetElse(Hir::HirLetElse {
        pattern: pattern,
        value: value,
        elseBlock: elseBlock,
      }),
      span: letElse.span,
      typeId: Lowering::voidType(typeStore),
    });
  }

  /// Lowers a `defer` to `HirKind::Defer`. The oracle's body is the deferred
  /// expression; the selfhost parser wraps it in an `Expression` statement,
  /// which is unwrapped here so the two carry the same node. Any other
  /// statement form is lowered as-is, exactly like `checkDeferStmt` walks it.
  function lowerDefer(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    deferStmt: &Ast::Statement::Defer,
  ): Hir::HirId {
    let mut deferredExpr: Option<Ast::ExpressionId> = Option::NONE;

    if (let Option::SOME(innerStmt) = module.statements.get(deferStmt.statement)) {
      if (let Ast::Statement::Node::Expression(expressionStmt) = innerStmt) {
        deferredExpr = Option::SOME(expressionStmt.expression);
      }
    }

    if (let Option::SOME(exprId) = deferredExpr) {
      let body: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, exprId);
      return Lowering::deferNode(hir, typeStore, deferStmt.span, body);
    }

    let body: Hir::HirId = Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, deferStmt.statement);
    return Lowering::deferNode(hir, typeStore, deferStmt.span, body);
  }

  function deferNode(
    hir: &mut Hir::HirStore,
    typeStore: &mut Analyzer::TypeStore,
    span: SourceSpan,
    body: Hir::HirId,
  ): Hir::HirId {
    let mut hirRef: &mut Hir::HirStore = hir;
    return hirRef.alloc(Hir::HirNode {
      kind: Hir::HirKind::Defer(body),
      span: span,
      typeId: Lowering::voidType(typeStore),
    });
  }

  function lowerStmt(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    stmtId: Ast::StatementId,
  ): Hir::HirId {
    let Option::SOME(stmt) = module.statements.get(stmtId) else {
      return Lowering::errorNode(hir, typeStore, SourceSpan::new("", 0, 0));
    };

    match (stmt) {
      Ast::Statement::Node::Variable(variable) -> {
        return Lowering::lowerLetLike(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          hir,
          variable.span,
          variable.pattern,
          &variable.value,
          variable.mutable,
        );
      },
      Ast::Statement::Node::Let(letStmt) -> {
        return Lowering::lowerLetLike(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          hir,
          letStmt.span,
          letStmt.pattern,
          &letStmt.value,
          false,
        );
      },
      Ast::Statement::Node::Expression(exprStmt) -> {
        let loweredExpr: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, exprStmt.expression);
        let exprType: Analyzer::TypeId = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, exprStmt.expression);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::ExpressionStatement(loweredExpr),
          span: exprStmt.span,
          typeId: exprType,
        });
      },
      Ast::Statement::Node::Block(block) -> {
        let mut blockType: Analyzer::TypeId = Lowering::voidType(typeStore);
        if (let Option::SOME(tailId) = &block.tail) {
          blockType = Lowering::exprTypeOrVoid(typeStore, &output.typecheck, tailId);
        }

        return Lowering::lowerBlockParts(
          defStore,
          typeStore,
          symbols,
          module,
          output,
          locals,
          hir,
          &block.statements,
          &block.tail,
          block.span,
          blockType,
        );
      },
      Ast::Statement::Node::If(ifStmt) -> {
        let condition: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, ifStmt.condition);
        let thenBranch: Hir::HirId = Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, ifStmt.thenBranch);

        let mut elseBranch: Option<Hir::HirId> = Option::NONE;
        if (let Option::SOME(elseId) = ifStmt.elseBranch) {
          elseBranch = Option::SOME(Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, elseId));
        }

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::If(Hir::HirIf {
            condition: condition,
            thenBranch: thenBranch,
            elseBranch: elseBranch,
          }),
          span: ifStmt.span,
          typeId: Lowering::voidType(typeStore),
        });
      },
      Ast::Statement::Node::While(whileStmt) -> {
        let condition: Hir::HirId = Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, whileStmt.condition);
        let body: Hir::HirId = Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, whileStmt.body);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Loop(Hir::HirLoop {
            condition: Hir::LoopKind::While(condition),
            body: body,
          }),
          span: whileStmt.span,
          typeId: Lowering::voidType(typeStore),
        });
      },
      Ast::Statement::Node::Return(returnStmt) -> {
        let mut value: Option<Hir::HirId> = Option::NONE;
        if (let Option::SOME(valueId) = returnStmt.value) {
          value = Option::SOME(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, valueId));
        }

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Return(value),
          span: returnStmt.span,
          typeId: Lowering::neverType(typeStore),
        });
      },
      Ast::Statement::Node::Break(breakStmt) -> {
        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Break,
          span: breakStmt.span,
          typeId: Lowering::neverType(typeStore),
        });
      },
      Ast::Statement::Node::Continue(continueStmt) -> {
        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Continue,
          span: continueStmt.span,
          typeId: Lowering::neverType(typeStore),
        });
      },
      Ast::Statement::Node::LetElse(letElse) -> {
        return Lowering::lowerLetElse(defStore, typeStore, symbols, module, output, locals, hir, &letElse);
      },
      Ast::Statement::Node::For(forStmt) -> {
        let mut init: Option<Hir::HirId> = Option::NONE;
        if (let Option::SOME(initializerId) = forStmt.initializer) {
          init = Option::SOME(Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, initializerId));
        }

        let mut condition: Option<Hir::HirId> = Option::NONE;
        if (let Option::SOME(conditionId) = forStmt.condition) {
          condition = Option::SOME(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, conditionId));
        }

        let mut update: Option<Hir::HirId> = Option::NONE;
        if (let Option::SOME(updateId) = forStmt.update) {
          update = Option::SOME(Lowering::lowerExpr(defStore, typeStore, symbols, module, output, locals, hir, updateId));
        }

        let body: Hir::HirId = Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, forStmt.body);

        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Loop(Hir::HirLoop {
            condition: Hir::LoopKind::For(Hir::ForLoop {
              init: init,
              condition: condition,
              update: update,
            }),
            body: body,
          }),
          span: forStmt.span,
          typeId: Lowering::voidType(typeStore),
        });
      },
      Ast::Statement::Node::ForOf(forOf) -> {
        return Lowering::errorNode(hir, typeStore, forOf.span);
      },
      Ast::Statement::Node::Defer(deferStmt) -> {
        return Lowering::lowerDefer(defStore, typeStore, symbols, module, output, locals, hir, &deferStmt);
      },
      Ast::Statement::Node::Item(itemStmt) -> {
        return Lowering::errorNode(hir, typeStore, itemStmt.span);
      },
      Ast::Statement::Node::Comment(comment) -> {
        let mut hirRef: &mut Hir::HirStore = hir;
        return hirRef.alloc(Hir::HirNode {
          kind: Hir::HirKind::Unit,
          span: comment.span,
          typeId: Lowering::voidType(typeStore),
        });
      },
    };

    return Lowering::errorNode(hir, typeStore, SourceSpan::new("", 0, 0));
  }

  // =========================================================================
  // Items
  // =========================================================================

  /// Owned copy of the signature data lowering needs from a `FunctionDef` or
  /// a `MethodDef`, taken up front so the `DefinitionStore` borrow ends
  /// before body lowering pushes new `Variable` definitions into it.
  ///
  /// A method's `params` include the receiver binding: the binder binds every
  /// parameter pattern of the method item, `self` included, so the vector
  /// stays positionally aligned with the AST parameter patterns.
  record FunctionSignature {
    public name: Analyzer::SymbolId;
    public params: Vector<Analyzer::DefinitionId>;
    public returnType: Analyzer::TypeId;
  }

  function callableSignature(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
  ): Option<Lowering::FunctionSignature> {
    let Option::SOME(definition) = defStore.get(defId) else {
      return Option::NONE;
    };

    match (definition) {
      Analyzer::Definition::Function(functionDef) -> {
        return Option::SOME(Lowering::FunctionSignature {
          name: functionDef.name,
          params: Analyzer::Typecheck::copyDefinitionIdVector(&functionDef.params),
          returnType: functionDef.returnType,
        });
      },
      Analyzer::Definition::Method(methodDef) -> {
        return Option::SOME(Lowering::FunctionSignature {
          name: methodDef.name,
          params: Analyzer::Typecheck::copyDefinitionIdVector(&methodDef.params),
          returnType: methodDef.returnType,
        });
      },
      _ -> {
        return Option::NONE;
      },
    };

    return Option::NONE;
  }

  /// `DefinitionId` for an item, consulting binder pass 2 first and falling
  /// back to pass 1, like `Checks::findItemDef`.
  function findItemDef(
    output: &Analyzer::AnalyzerOutput,
    itemId: Ast::ItemId,
  ): Option<Analyzer::DefinitionId> {
    let pass2Result: Option<Analyzer::DefinitionId> = Analyzer::Binder::findDef(&output.pass2, itemId.raw());
    if (pass2Result.isSome()) {
      return pass2Result;
    }

    return Analyzer::Binder::findDef(&output.pass1, itemId.raw());
  }

  /// Registers the parameter bindings of a function in the `LocalMap`,
  /// pairing the body resolver's parameter `LocalId`s (bound in declaration
  /// order at function entry) with the binder's existing `Variable`
  /// definitions from `FunctionDef.params`.
  function registerParams(
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    parameters: &Vector<Ast::PatternId>,
    paramDefs: &Vector<Analyzer::DefinitionId>,
  ): void {
    let mut index: u64 = 0;

    while (index < parameters.length()) {
      let Option::SOME(patternId) = parameters.get(index) else {
        index += 1;
        continue;
      };
      let Option::SOME(defId) = paramDefs.get(index) else {
        index += 1;
        continue;
      };

      if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Local(localId)) = Analyzer::ResolverBodies::findPatternRef(
        &output.resolvedBodies.bodyResolution,
        patternId.raw(),
      )) {
        Lowering::registerLocal(locals, localId, *defId);
      }

      index += 1;
    }
  }

  function lowerFunctionItem(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    itemId: Ast::ItemId,
    function_: &Ast::Item::Function,
  ): void {
    let Option::SOME(defId) = Lowering::findItemDef(output, itemId) else {
      return;
    };

    let Option::SOME(signature) = Lowering::callableSignature(defStore, defId) else {
      return;
    };

    Lowering::lowerCallableBody(
      defStore,
      typeStore,
      symbols,
      module,
      output,
      locals,
      hir,
      defId,
      function_,
      &signature,
    );

    let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
    let mainSym: Analyzer::SymbolId = symbolsRef.intern("main");

    if (signature.name.raw() == mainSym.raw()) {
      let mut hirRef: &mut Hir::HirStore = hir;
      hirRef.setEntryPoint(defId);
    }
  }

  /// Registers the parameters of one callable, lowers its body, and records
  /// the result in the HIR store. `currentReturnType` is saved and restored
  /// around the body so a nested callable — a record method lowered after the
  /// function that precedes it — cannot leak its return type into the next
  /// one's `try` desugar.
  function lowerCallableBody(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    defId: Analyzer::DefinitionId,
    function_: &Ast::Item::Function,
    signature: &Lowering::FunctionSignature,
  ): void {
    Lowering::registerParams(module, output, locals, &function_.parameters, &signature.params);

    let previousReturnType: Option<Analyzer::TypeId> = locals.currentReturnType;

    let mut localsRef: &mut Lowering::LocalMap = locals;
    localsRef.currentReturnType = Option::SOME(signature.returnType);

    let body: Hir::HirId = Lowering::lowerStmt(defStore, typeStore, symbols, module, output, locals, hir, function_.body);

    let mut restoreRef: &mut Lowering::LocalMap = locals;
    restoreRef.currentReturnType = previousReturnType;

    let mut hirRef: &mut Hir::HirStore = hir;
    hirRef.setFunctionBody(defId, body);
    hirRef.addItem(defId);
  }

  /// Lowers the bodies of one record's or enum's methods, in declaration
  /// order. The oracle registers a method body exactly like a free function's
  /// (`function_bodies` plus `items`) and emits no node for the owner itself,
  /// which is why nothing is returned here.
  ///
  /// Method bodies are invisible in the HIR display: its definition printer
  /// only renders `Definition::Function` entries, mirroring the Rust printer's
  /// `DefinitionKind::Function` arm. The locals a method body declares still
  /// surface in the variable-initializer section.
  function lowerOwnerMethods(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    methodItemIds: &Vector<Ast::ItemId>,
  ): void {
    let mut index: u64 = 0;

    while (index < methodItemIds.length()) {
      let Option::SOME(methodItemId) = methodItemIds.get(index) else {
        index += 1;
        continue;
      };

      Lowering::lowerMethodItem(defStore, typeStore, symbols, module, output, locals, hir, *methodItemId);
      index += 1;
    }
  }

  /// Lowers one method item's body. Unlike `lowerFunctionItem` this never
  /// sets the entry point: only a free `main` is an entry point.
  function lowerMethodItem(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    itemId: Ast::ItemId,
  ): void {
    let Option::SOME(item) = module.items.get(itemId) else {
      return;
    };

    let Ast::Item::Node::Function(function_) = item else {
      return;
    };

    let Option::SOME(defId) = Lowering::findItemDef(output, itemId) else {
      return;
    };

    let Option::SOME(signature) = Lowering::callableSignature(defStore, defId) else {
      return;
    };

    Lowering::lowerCallableBody(
      defStore,
      typeStore,
      symbols,
      module,
      output,
      locals,
      hir,
      defId,
      &function_,
      &signature,
    );
  }

  /// Lowers one root item: functions and owner-local methods get bodies,
  /// namespaces recurse, and exports unwrap. Constants, traits, aliases,
  /// imports, and externs are outside this slice and are skipped without HIR
  /// output; a record or enum contributes only its methods, exactly like the
  /// oracle, whose record/enum arms lower method bodies and return an empty
  /// block for the declaration itself.
  function lowerItem(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    itemId: Ast::ItemId,
  ): void {
    let Option::SOME(item) = module.items.get(itemId) else {
      return;
    };

    match (item) {
      Ast::Item::Node::Function(function_) -> {
        Lowering::lowerFunctionItem(defStore, typeStore, symbols, module, output, locals, hir, itemId, &function_);
      },
      Ast::Item::Node::Record(recordItem) -> {
        Lowering::lowerOwnerMethods(defStore, typeStore, symbols, module, output, locals, hir, &recordItem.methods);
      },
      Ast::Item::Node::Enum(enumItem) -> {
        Lowering::lowerOwnerMethods(defStore, typeStore, symbols, module, output, locals, hir, &enumItem.methods);
      },
      Ast::Item::Node::Namespace(namespaceItem) -> {
        Lowering::lowerItems(defStore, typeStore, symbols, module, output, locals, hir, &namespaceItem.items);
      },
      Ast::Item::Node::Export(exportItem) -> {
        if (let Option::SOME(innerItemId) = exportItem.declaration) {
          Lowering::lowerItem(defStore, typeStore, symbols, module, output, locals, hir, innerItemId);
        }
      },
      _ -> {},
    };
  }

  function lowerItems(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
    locals: &mut Lowering::LocalMap,
    hir: &mut Hir::HirStore,
    itemIds: &Vector<Ast::ItemId>,
  ): void {
    let mut index: u64 = 0;

    while (index < itemIds.length()) {
      let Option::SOME(itemId) = itemIds.get(index) else {
        index += 1;
        continue;
      };

      Lowering::lowerItem(defStore, typeStore, symbols, module, output, locals, hir, *itemId);
      index += 1;
    }
  }

  /// Lowering entry point. Consumes the post-typecheck analyzer output for
  /// one module and produces the HIR store for its root items in
  /// declaration order. Not wired into `Analyzer::analyzeModule`: callers
  /// (tests today, the driver in a later slice) invoke it explicitly after
  /// analysis.
  function lowerModule(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    output: &Analyzer::AnalyzerOutput,
  ): Hir::HirStore {
    let mut hir: Hir::HirStore = Hir::HirStore::init();
    let mut locals: Lowering::LocalMap = Lowering::LocalMap::init();

    Lowering::lowerItems(defStore, typeStore, symbols, module, output, &mut locals, &mut hir, &module.roots);

    return hir;
  }
}
