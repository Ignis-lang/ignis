import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import Vector from "std::vector";

/// Escape analysis for closures, the port of
/// `crates/ignis_analyzer/src/escape.rs`.
///
/// # The rule
///
/// A closure's environment holds its captures. A non-escaping closure keeps
/// that environment in the frame that created it; an escaping one must
/// heap-allocate it, because the value outlives the frame. Deciding this
/// wrong in the "non-escaping" direction is a use-after-return, so the
/// analysis is deliberately conservative: when in doubt, escape.
///
/// A closure escapes when its **value** reaches a position that outlives the
/// frame that built it. The analysis is position-aware: the escaping value
/// may be the closure expression written in place, a variable that aliases
/// one, or the tail of a block / branch / match arm that produces one.
/// Concretely, a closure escapes when it appears in:
///
///   - a `return` operand, or the tail expression of a function or closure
///     body (the function's result crosses the frame boundary), including a
///     closure literal written into an aggregate built in that position;
///   - an assignment whose target is a field, an index, or a static place
///     (the place outlives the assignment);
///   - a record-initializer field, an enum-variant payload, or a
///     vector/tuple literal element (the aggregate may itself outlive the
///     frame);
///   - an argument of a call whose matching parameter is **not**
///     `@noescape` (the callee may store it), or any argument of an
///     indirect closure call (no static parameter information is
///     available);
///   - the capture list of another closure that escapes (transitively).
///
/// # Who frees a heap environment
///
/// A heap environment is freed by the binding that owns it, exactly once: the
/// local a closure literal is bound to, or — for a closure that crosses a
/// return — the local in the caller that receives the returned value. So a
/// closure literal written as a bare temporary is heap-allocated only where an
/// owner exists on the other side, which is the result position. Everywhere
/// else a bare temporary keeps its stack environment: it lives in the frame
/// that built it, which is alive for the whole call it is handed to, and
/// heap-allocating it there would only produce an environment nothing frees. A
/// closure reached through a variable is heap-allocated in every escaping
/// position, because that variable's binding owns the environment and frees it
/// at scope exit.
///
/// The gap this leaves is a callee that stores a closure it was handed past
/// the call while its caller's frame, or the binding that owns the
/// environment, goes away first. `@noescape` is the callee's promise not to do
/// that, and it is what lets a borrowed reference capture stay sound.
///
/// A closure stays non-escaping — and keeps its stack environment — when it
/// is only bound to a local and called locally, or when it is passed to a
/// `@noescape` parameter.
///
/// A closure with no captures is reported here like any other, but it has no
/// environment to place anywhere: `Capture::populateClosureCaptures` keeps
/// its `escapes` flag false so that a plain function used as a function
/// value, which lowers to a zero-capture closure, allocates nothing.
export namespace Escape {
  /// Maps a definition bound to a closure (directly or through an alias
  /// chain) to that closure's node. Two parallel vectors instead of a map,
  /// matching how the rest of the selfhost models small keyed tables.
  record AliasTable {
    public defs: Vector<Analyzer::DefinitionId>;
    public closures: Vector<Hir::HirId>;

    public static init(): AliasTable {
      return AliasTable {
        defs: Vector::new<Analyzer::DefinitionId>(),
        closures: Vector::new<Hir::HirId>(),
      };
    }

    public lookup(&self, defId: Analyzer::DefinitionId): Option<Hir::HirId> {
      let mut index: u64 = 0;

      while (index < self.defs.length()) {
        if (let Option::SOME(existing) = self.defs.get(index)) {
          if (existing.raw() == defId.raw()) {
            if (let Option::SOME(closureId) = self.closures.get(index)) {
              return Option::SOME(*closureId);
            }

            return Option::NONE;
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    public insert(&mut self, defId: Analyzer::DefinitionId, closureId: Hir::HirId): void {
      if (self.lookup(defId).isSome()) {
        return;
      }

      self.defs.push(defId);
      self.closures.push(closureId);
    }
  }

  function pushHirId(ids: &mut Vector<Hir::HirId>, value: Hir::HirId): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(existing) = ids.get(index)) {
        if (existing.raw() == value.raw()) {
          return;
        }
      }

      index += 1;
    }

    let mut idsRef: &mut Vector<Hir::HirId> = ids;
    idsRef.push(value);
  }

  function copyHirIds(ids: &mut Vector<Hir::HirId>): Vector<Hir::HirId> {
    let mut result: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        result.push(*id);
      }

      index += 1;
    }

    return result;
  }

  /// The closure nodes that outlive their defining scope.
  function analyzeEscapes(
    hir: &mut Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
  ): Vector<Hir::HirId> {
    let mut aliases: Escape::AliasTable = Escape::AliasTable::init();

    let mut nodeIndex: u64 = 0;

    while (nodeIndex < hir.nodes.length()) {
      if (let Option::SOME(node) = hir.nodes.get(nodeIndex)) {
        if (let Hir::HirKind::Let(letNode) = &node.kind) {
          if (let Option::SOME(valueId) = letNode.value) {
            if (let Option::SOME(valueNode) = hir.get(valueId)) {
              if (let Hir::HirKind::Closure(_) = &valueNode.kind) {
                aliases.insert(letNode.name, valueId);
              }
            }
          }
        }
      }

      nodeIndex += 1;
    }

    // Fixpoint over `let b = a` chains, so an alias of an alias still names
    // the closure it ultimately refers to.
    let mut changed: boolean = true;

    while (changed) {
      changed = false;

      let mut aliasIndex: u64 = 0;

      while (aliasIndex < hir.nodes.length()) {
        if (let Option::SOME(node) = hir.nodes.get(aliasIndex)) {
          if (let Hir::HirKind::Let(letNode) = &node.kind) {
            if (let Option::SOME(valueId) = letNode.value) {
              if (let Option::SOME(valueNode) = hir.get(valueId)) {
                if (let Hir::HirKind::Variable(sourceDef) = &valueNode.kind) {
                  if (let Option::SOME(closureId) = aliases.lookup(sourceDef)) {
                    if (aliases.lookup(letNode.name).isNone()) {
                      aliases.insert(letNode.name, closureId);
                      changed = true;
                    }
                  }
                }
              }
            }
          }
        }

        aliasIndex += 1;
      }
    }

    let mut escaping: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut bodyIndex: u64 = 0;

    while (bodyIndex < hir.functionBodies.length()) {
      if (let Option::SOME(bodyId) = hir.functionBodies.valueAt(bodyIndex)) {
        Escape::markTailExpression(hir, &aliases, &mut escaping, bodyId);
        Escape::scanForEscapes(hir, defStore, &aliases, &mut escaping, bodyId);
      }

      bodyIndex += 1;
    }

    Escape::propagateThroughCaptures(hir, &aliases, &mut escaping);

    return escaping;
  }

  /// A closure captured by an escaping closure outlives the capturing
  /// closure's defining frame too, so its own environment must be
  /// heap-allocated as well.
  function propagateThroughCaptures(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
  ): void {
    let mut changed: boolean = true;

    while (changed) {
      changed = false;

      // Snapshotted so the loop below can freely push onto `escaping`
      // without iterating the vector it is mutating.
      let snapshot: Vector<Hir::HirId> = Escape::copyHirIds(escaping);
      let mut index: u64 = 0;

      while (index < snapshot.length()) {
        if (let Option::SOME(closureId) = snapshot.get(index)) {
          let capturedClosureId: Hir::HirId = *closureId;

          if (let Option::SOME(node) = hir.get(capturedClosureId)) {
            if (let Hir::HirKind::Closure(closureNode) = &node.kind) {
              let mut captureIndex: u64 = 0;

              while (captureIndex < closureNode.captures.length()) {
                if (let Option::SOME(capture) = closureNode.captures.get(captureIndex)) {
                  if (let Option::SOME(innerClosureId) = aliases.lookup(capture.sourceDef)) {
                    let lengthBefore: u64 = escaping.length();
                    Escape::pushHirId(escaping, innerClosureId);

                    if (escaping.length() != lengthBefore) {
                      changed = true;
                    }
                  }
                }

                captureIndex += 1;
              }
            }
          }
        }

        index += 1;
      }
    }
  }

  /// Mark the tail expression of a block body: its value is the body's
  /// result, so it crosses the frame boundary exactly like an explicit
  /// `return` operand.
  function markTailExpression(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    bodyId: Hir::HirId,
  ): void {
    let Option::SOME(node) = hir.get(bodyId) else {
      return;
    };

    if (let Hir::HirKind::Block(blockNode) = &node.kind) {
      if (let Option::SOME(tailId) = blockNode.expression) {
        Escape::markEscapingResult(hir, aliases, escaping, tailId);
      }
    }
  }

  /// Mark the closures a **result** can evaluate to: the operand of a
  /// `return`, or the tail expression of a function or closure body.
  ///
  /// The result may be the closure expression itself, a variable aliasing
  /// one, or the result of a block, an `if`/`else`, or a `match` whose
  /// branches produce one. A closure literal counts here because the
  /// caller's binding takes ownership of the environment.
  function markEscapingResult(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    hirId: Hir::HirId,
  ): void {
    Escape::markEscapingValue(hir, aliases, escaping, hirId, true);
  }

  /// Mark the closures a value reaching a non-result escaping position can
  /// evaluate to: a call argument, an assignment to a field or index, a
  /// record-initializer field, an enum payload, a vector or tuple element.
  ///
  /// A closure literal written straight into one of these positions is not
  /// marked: nothing on the other side owns its environment, so
  /// heap-allocating it would only leak it, while leaving it in the frame
  /// that built it keeps it alive for at least as long as a binding in that
  /// frame would.
  function markEscapingArgument(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    hirId: Hir::HirId,
  ): void {
    Escape::markEscapingValue(hir, aliases, escaping, hirId, false);
  }

  function markEscapingValue(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    hirId: Hir::HirId,
    includeLiteral: boolean,
  ): void {
    let Option::SOME(node) = hir.get(hirId) else {
      return;
    };

    match (&node.kind) {
      Hir::HirKind::Closure(_) -> {
        if (includeLiteral) {
          Escape::pushHirId(escaping, hirId);
        }
      },
      Hir::HirKind::Variable(defId) -> {
        if (let Option::SOME(closureId) = aliases.lookup(defId)) {
          Escape::pushHirId(escaping, closureId);
        }
      },
      Hir::HirKind::Block(blockNode) -> {
        if (let Option::SOME(tailId) = blockNode.expression) {
          Escape::markEscapingValue(hir, aliases, escaping, tailId, includeLiteral);
        }
      },
      Hir::HirKind::If(ifNode) -> {
        Escape::markEscapingValue(hir, aliases, escaping, ifNode.thenBranch, includeLiteral);

        if (let Option::SOME(elseId) = ifNode.elseBranch) {
          Escape::markEscapingValue(hir, aliases, escaping, elseId, includeLiteral);
        }
      },
      Hir::HirKind::Match(matchNode) -> {
        let mut armIndex: u64 = 0;

        while (armIndex < matchNode.arms.length()) {
          if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
            Escape::markEscapingValue(hir, aliases, escaping, arm.body, includeLiteral);
          }

          armIndex += 1;
        }
      },
      // An aggregate built in result position crosses the frame boundary with
      // its elements inside it, so a closure literal written into one is in
      // result position too. Outside result position the aggregate is only as
      // long-lived as the frame that built it, which is what the literal
      // already assumes.
      Hir::HirKind::RecordInit(recordNode) -> {
        if (includeLiteral) {
          let mut fieldIndex: u64 = 0;

          while (fieldIndex < recordNode.fields.length()) {
            if (let Option::SOME(field) = recordNode.fields.get(fieldIndex)) {
              Escape::markEscapingValue(hir, aliases, escaping, field.value, true);
            }

            fieldIndex += 1;
          }
        }
      },
      Hir::HirKind::EnumVariant(variantNode) -> {
        if (includeLiteral) {
          Escape::markEscapingResultList(hir, aliases, escaping, &variantNode.payload);
        }
      },
      Hir::HirKind::VectorLiteral(elements) -> {
        if (includeLiteral) {
          Escape::markEscapingResultList(hir, aliases, escaping, &elements);
        }
      },
      Hir::HirKind::TupleLiteral(elements) -> {
        if (includeLiteral) {
          Escape::markEscapingResultList(hir, aliases, escaping, &elements);
        }
      },
      _ -> {},
    };
  }

  /// Calls `markEscapingResult` on every id in `ids`.
  function markEscapingResultList(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    ids: &Vector<Hir::HirId>,
  ): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        Escape::markEscapingResult(hir, aliases, escaping, *id);
      }

      index += 1;
    }
  }

  /// Calls `markEscapingArgument` on every id in `ids`.
  function markEscapingArgumentList(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    ids: &Vector<Hir::HirId>,
  ): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        Escape::markEscapingArgument(hir, aliases, escaping, *id);
      }

      index += 1;
    }
  }

  function scanForEscapesList(
    hir: &mut Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    ids: &Vector<Hir::HirId>,
  ): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, *id);
      }

      index += 1;
    }
  }

  /// Whether the parameter in `paramIndex` carries `@noescape`.
  function paramIsNoEscape(
    defStore: &mut Analyzer::DefinitionStore,
    paramDefs: &Vector<Analyzer::DefinitionId>,
    paramIndex: u64,
  ): boolean {
    let Option::SOME(paramDefId) = paramDefs.get(paramIndex) else {
      return false;
    };

    let Option::SOME(definition) = defStore.get(*paramDefId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Variable(variableDef) -> variableDef.noEscape,
      _ -> false,
    };
  }

  function calleeParams(
    defStore: &mut Analyzer::DefinitionStore,
    calleeDef: Analyzer::DefinitionId,
  ): Vector<Analyzer::DefinitionId> {
    let mut params: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(calleeDef)) {
      match (definition) {
        Analyzer::Definition::Function(functionDef) -> {
          params = Escape::copyDefIds(&functionDef.params);
        },
        Analyzer::Definition::Method(methodDef) -> {
          params = Escape::copyDefIds(&methodDef.params);
        },
        _ -> {},
      };
    }

    return params;
  }

  function copyDefIds(source: &Vector<Analyzer::DefinitionId>): Vector<Analyzer::DefinitionId> {
    let mut result: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(defId) = source.get(index)) {
        result.push(*defId);
      }

      index += 1;
    }

    return result;
  }

  /// Scans every argument of a call: each one escapes on its own unless its
  /// parameter carries `@noescape`, and each is descended into either way.
  function scanCallArguments(
    hir: &mut Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    args: &Vector<Hir::HirId>,
    paramDefs: &Vector<Analyzer::DefinitionId>,
    paramOffset: u64,
  ): void {
    let mut index: u64 = 0;

    while (index < args.length()) {
      if (let Option::SOME(argId) = args.get(index)) {
        if (!Escape::paramIsNoEscape(defStore, paramDefs, index + paramOffset)) {
          Escape::markEscapingArgument(hir, aliases, escaping, *argId);
        }

        Escape::scanForEscapes(hir, defStore, aliases, escaping, *argId);
      }

      index += 1;
    }
  }

  function scanForEscapes(
    hir: &mut Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    hirId: Hir::HirId,
  ): void {
    let Option::SOME(node) = hir.get(hirId) else {
      return;
    };

    match (&node.kind) {
      Hir::HirKind::Return(value) -> {
        if (let Option::SOME(valueId) = value) {
          Escape::markEscapingResult(hir, aliases, escaping, valueId);
          Escape::scanForEscapes(hir, defStore, aliases, escaping, valueId);
        }
      },
      Hir::HirKind::Call(callNode) -> {
        let paramDefs: Vector<Analyzer::DefinitionId> = Escape::calleeParams(defStore, callNode.callee);
        Escape::scanCallArguments(hir, defStore, aliases, escaping, &callNode.args, &paramDefs, 0);
      },
      Hir::HirKind::MethodCall(methodNode) -> {
        let mut paramOffset: u64 = 0;

        if (let Option::SOME(receiverId) = methodNode.receiver) {
          Escape::scanForEscapes(hir, defStore, aliases, escaping, receiverId);
          // `self` occupies the first parameter slot of an instance method.
          paramOffset = 1;
        }

        let paramDefs: Vector<Analyzer::DefinitionId> = Escape::calleeParams(defStore, methodNode.method);
        Escape::scanCallArguments(hir, defStore, aliases, escaping, &methodNode.args, &paramDefs, paramOffset);
      },
      // A call through a closure value has no parameter list to consult.
      Hir::HirKind::CallClosure(closureCall) -> {
        let noParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
        Escape::scanForEscapes(hir, defStore, aliases, escaping, closureCall.callee);
        Escape::scanCallArguments(hir, defStore, aliases, escaping, &closureCall.args, &noParams, 0);
      },
      Hir::HirKind::Assign(assignNode) -> {
        let mut complexTarget: boolean = false;

        if (let Option::SOME(targetNode) = hir.get(assignNode.target)) {
          match (&targetNode.kind) {
            Hir::HirKind::FieldAccess(_) -> {
              complexTarget = true;
            },
            Hir::HirKind::StaticAccess(_) -> {
              complexTarget = true;
            },
            Hir::HirKind::Index(_) -> {
              complexTarget = true;
            },
            _ -> {},
          };
        }

        if (complexTarget) {
          Escape::markEscapingArgument(hir, aliases, escaping, assignNode.value);
        }

        Escape::scanForEscapes(hir, defStore, aliases, escaping, assignNode.target);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, assignNode.value);
      },
      Hir::HirKind::RecordInit(recordNode) -> {
        let mut fieldIndex: u64 = 0;

        while (fieldIndex < recordNode.fields.length()) {
          if (let Option::SOME(field) = recordNode.fields.get(fieldIndex)) {
            Escape::markEscapingArgument(hir, aliases, escaping, field.value);
            Escape::scanForEscapes(hir, defStore, aliases, escaping, field.value);
          }

          fieldIndex += 1;
        }
      },
      Hir::HirKind::EnumVariant(variantNode) -> {
        let mut payloadIndex: u64 = 0;

        while (payloadIndex < variantNode.payload.length()) {
          if (let Option::SOME(payloadId) = variantNode.payload.get(payloadIndex)) {
            Escape::markEscapingArgument(hir, aliases, escaping, *payloadId);
            Escape::scanForEscapes(hir, defStore, aliases, escaping, *payloadId);
          }

          payloadIndex += 1;
        }
      },
      // A nested closure body is its own frame: its tail expression and
      // inner escape points are analyzed exactly like a function body's.
      Hir::HirKind::Closure(closureNode) -> {
        Escape::markTailExpression(hir, aliases, escaping, closureNode.body);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, closureNode.body);
      },
      Hir::HirKind::Block(blockNode) -> {
        Escape::scanForEscapesList(hir, defStore, aliases, escaping, &blockNode.statements);

        if (let Option::SOME(expressionId) = blockNode.expression) {
          Escape::scanForEscapes(hir, defStore, aliases, escaping, expressionId);
        }
      },
      Hir::HirKind::Let(letNode) -> {
        if (let Option::SOME(valueId) = letNode.value) {
          Escape::scanForEscapes(hir, defStore, aliases, escaping, valueId);
        }
      },
      Hir::HirKind::If(ifNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, ifNode.condition);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, ifNode.thenBranch);

        if (let Option::SOME(elseId) = ifNode.elseBranch) {
          Escape::scanForEscapes(hir, defStore, aliases, escaping, elseId);
        }
      },
      Hir::HirKind::LetElse(letElseNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, letElseNode.value);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, letElseNode.elseBlock);
      },
      Hir::HirKind::Loop(loopNode) -> {
        match (&loopNode.condition) {
          Hir::LoopKind::While(conditionId) -> {
            Escape::scanForEscapes(hir, defStore, aliases, escaping, conditionId);
          },
          Hir::LoopKind::For(forLoop) -> {
            if (let Option::SOME(initId) = forLoop.init) {
              Escape::scanForEscapes(hir, defStore, aliases, escaping, initId);
            }

            if (let Option::SOME(conditionId) = forLoop.condition) {
              Escape::scanForEscapes(hir, defStore, aliases, escaping, conditionId);
            }

            if (let Option::SOME(updateId) = forLoop.update) {
              Escape::scanForEscapes(hir, defStore, aliases, escaping, updateId);
            }
          },
          Hir::LoopKind::Infinite -> {},
        };

        Escape::scanForEscapes(hir, defStore, aliases, escaping, loopNode.body);
      },
      Hir::HirKind::ExpressionStatement(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::Binary(binaryNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, binaryNode.left);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, binaryNode.right);
      },
      Hir::HirKind::Unary(unaryNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, unaryNode.operand);
      },
      Hir::HirKind::Cast(castNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, castNode.expression);
      },
      Hir::HirKind::BitCast(castNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, castNode.expression);
      },
      Hir::HirKind::Reference(referenceNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, referenceNode.expression);
      },
      Hir::HirKind::Dereference(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::TypeOf(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::Panic(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::Defer(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::Index(indexNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, indexNode.base);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, indexNode.index);
      },
      Hir::HirKind::FieldAccess(fieldNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, fieldNode.base);
      },
      Hir::HirKind::VectorLiteral(elements) -> {
        Escape::markEscapingArgumentList(hir, aliases, escaping, &elements);
        Escape::scanForEscapesList(hir, defStore, aliases, escaping, &elements);
      },
      Hir::HirKind::TupleLiteral(elements) -> {
        Escape::markEscapingArgumentList(hir, aliases, escaping, &elements);
        Escape::scanForEscapesList(hir, defStore, aliases, escaping, &elements);
      },
      Hir::HirKind::MakeSlice(sliceNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, sliceNode.data);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, sliceNode.len);
      },
      Hir::HirKind::Match(matchNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, matchNode.scrutinee);

        let mut armIndex: u64 = 0;

        while (armIndex < matchNode.arms.length()) {
          if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
            if (let Option::SOME(guardId) = arm.guard) {
              Escape::scanForEscapes(hir, defStore, aliases, escaping, guardId);
            }

            Escape::scanForEscapes(hir, defStore, aliases, escaping, arm.body);
          }

          armIndex += 1;
        }
      },
      Hir::HirKind::BuiltinLoad(loadNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, loadNode.ptr);
      },
      Hir::HirKind::BuiltinStore(storeNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, storeNode.ptr);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, storeNode.value);
      },
      Hir::HirKind::BuiltinHash(hashNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, hashNode.value);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, hashNode.hasher);
      },
      Hir::HirKind::BuiltinEq(eqNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, eqNode.left);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, eqNode.right);
      },
      Hir::HirKind::BuiltinDropInPlace(dropNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, dropNode.ptr);
      },
      _ -> {},
    };
  }
}
