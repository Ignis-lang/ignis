import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import Id from "@compiler::ids";
import Vector from "std::vector";

/// Escape analysis for closures, the port of
/// `crates/ignis_analyzer/src/escape.rs`.
///
/// # The rule
///
/// A closure's environment holds its captures. A non-escaping closure keeps
/// that environment in the frame that created it; an escaping one must
/// heap-allocate it, because the value outlives the frame. Deciding this
/// wrong in the "non-escaping" direction is a use-after-return, so the
/// analysis is deliberately conservative: when in doubt, escape.
///
/// A closure escapes when its **value** reaches a position that outlives the
/// frame that built it. The analysis is position-aware: the escaping value
/// may be the closure expression written in place, a variable that aliases
/// one, or the tail of a block / branch / match arm that produces one.
/// Concretely, a closure escapes when it appears in:
///
///   - a `return` operand, or the tail expression of a function or closure
///     body (the function's result crosses the frame boundary), including a
///     closure literal written into an aggregate built in that position;
///   - an assignment whose target is a field, an index, a static place, or
///     a dereference (the place outlives the assignment);
///   - a record-initializer field, an enum-variant payload, or a
///     vector/tuple literal element (the aggregate may itself outlive the
///     frame);
///   - an argument of a call whose matching parameter is **not**
///     `@noescape` (the callee may store it), or any argument of an
///     indirect closure call (no static parameter information is
///     available);
///   - a binding declared outside a loop or closure body that contains the
///     literal: the site runs again (next iteration) or its frame ends (the
///     thunk returns) while the binding still holds the closure. Such a
///     closure escaping a loop still lives in its frame, so only its
///     references to bindings declared inside the loop outlive their
///     referent; one escaping a closure body outlives every reference
///     (`referenceOutlivesReferent`);
///   - the capture list of another closure that escapes (transitively).
///
/// # Who frees a heap environment
///
/// A heap environment is freed by the binding that owns it, exactly once: the
/// local a closure literal is bound to, the local in the caller that receives
/// a returned closure, or a parameter that is not `@noescape`, which owns the
/// closure it receives. So a closure literal written as a bare temporary is
/// heap-allocated only where an owner exists on the other side: the result
/// position and a call argument whose parameter is not `@noescape`, which
/// includes every argument of an indirect closure call. Everywhere else a bare temporary keeps its stack environment:
/// it lives in the frame that built it, and heap-allocating it there would
/// only produce an environment nothing frees. A closure reached through a
/// variable is heap-allocated in every escaping position, because that
/// variable's binding owns the environment and frees it at scope exit.
///
/// The gap this leaves is a callee that stores a closure it was handed past
/// the call while its caller's frame, or the binding that owns the
/// environment, goes away first. `@noescape` is the callee's promise not to do
/// that, and it is what lets a borrowed reference capture stay sound.
///
/// A closure stays non-escaping — and keeps its stack environment — when it
/// is only bound to a local and called locally, or when it is passed to a
/// `@noescape` parameter.
///
/// A closure with no captures is reported here like any other, but it has no
/// environment to place anywhere: `Capture::populateClosureCaptures` keeps
/// its `escapes` flag false so that a plain function used as a function
/// value, which lowers to a zero-capture closure, allocates nothing.
export namespace Escape {
  /// Maps a definition bound to a closure (directly or through an alias
  /// chain) to that closure's node. Two parallel vectors instead of a map,
  /// matching how the rest of the selfhost models small keyed tables.
  record AliasTable {
    public defs: Vector<Analyzer::DefinitionId>;
    public closures: Vector<Hir::HirId>;

    public static init(): AliasTable {
      return AliasTable {
        defs: Vector::new<Analyzer::DefinitionId>(),
        closures: Vector::new<Hir::HirId>(),
      };
    }

    /// Every closure ever bound to `defId`. One binding can name several over
    /// its lifetime — `let mut f = A; f = B;` — and which one is live where the
    /// binding's value escapes needs flow analysis this pass does not do, so all
    /// of them escape with it: when in doubt, escape.
    public lookupAll(&self, defId: Analyzer::DefinitionId): Vector<Hir::HirId> {
      let mut result: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
      let mut index: u64 = 0;

      while (index < self.defs.length()) {
        if (let Option::SOME(existing) = self.defs.get(index)) {
          if (existing.raw() == defId.raw()) {
            if (let Option::SOME(closureId) = self.closures.get(index)) {
              result.push(*closureId);
            }
          }
        }

        index += 1;
      }

      return result;
    }

    /// Whether `defId` already names `closureId`.
    public names(&self, defId: Analyzer::DefinitionId, closureId: Hir::HirId): boolean {
      let mut index: u64 = 0;

      while (index < self.defs.length()) {
        if (let Option::SOME(existing) = self.defs.get(index)) {
          if (existing.raw() == defId.raw()) {
            if (let Option::SOME(bound) = self.closures.get(index)) {
              if (bound.raw() == closureId.raw()) {
                return true;
              }
            }
          }
        }

        index += 1;
      }

      return false;
    }

    public insert(&mut self, defId: Analyzer::DefinitionId, closureId: Hir::HirId): boolean {
      if (self.names(defId, closureId)) {
        return false;
      }

      self.defs.push(defId);
      self.closures.push(closureId);

      return true;
    }
  }

  function pushHirId(ids: &mut Vector<Hir::HirId>, value: Hir::HirId): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(existing) = ids.get(index)) {
        if (existing.raw() == value.raw()) {
          return;
        }
      }

      index += 1;
    }

    let mut idsRef: &mut Vector<Hir::HirId> = ids;
    idsRef.push(value);
  }

  function copyHirIds(ids: &mut Vector<Hir::HirId>): Vector<Hir::HirId> {
    let mut result: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        result.push(*id);
      }

      index += 1;
    }

    return result;
  }

  /// A binding and the value written into it, by `let` or by assignment.
  record BoundClosure {
    public name: Analyzer::DefinitionId;
    public valueId: Hir::HirId;
  }

  /// The binding `node` writes a value into: the name of a `let`, or the
  /// variable an assignment targets. Anything else answers `NONE`.
  function boundClosureTarget(
    hir: &mut Hir::HirStore,
    node: &Hir::HirNode
  ): Option<Escape::BoundClosure> {
    if (let Hir::HirKind::Let(letNode) = &node.kind) {
      if (let Option::SOME(valueId) = letNode.value) {
        return Option::SOME(Escape::BoundClosure { name: letNode.name, valueId: valueId });
      }

      return Option::NONE;
    }

    if (let Hir::HirKind::Assign(assignNode) = &node.kind) {
      if (let Option::SOME(targetNode) = hir.get(assignNode.target)) {
        if (let Hir::HirKind::Variable(defId) = &targetNode.kind) {
          return Option::SOME(Escape::BoundClosure { name: defId, valueId: assignNode.value });
        }
      }
    }

    return Option::NONE;
  }

  /// A closure that outlives one run of the region it was built in: the loop
  /// node, or the closure node whose body built it.
  record RegionEscape {
    public closureId: Hir::HirId;
    public regionId: Hir::HirId;
  }

  /// What escape analysis decided for the closures of a program.
  record EscapeResult {
    /// Every closure whose environment goes to the heap.
    public escaping: Vector<Hir::HirId>;
    /// The closures among them that outlive the frame that built them, either
    /// directly or inside a closure that does. A reference capture in one of
    /// these always outlives its referent.
    public frameEscaping: Vector<Hir::HirId>;
    /// Every region a closure escapes, directly or inside a closure that
    /// escapes it. A closure that escapes only regions stays inside its frame,
    /// so only references to bindings declared in one of those regions outlive
    /// their referent.
    public regions: Vector<Escape::RegionEscape>;
  }

  /// The closure nodes that outlive their defining scope.
  function analyzeEscapes(
    hir: &mut Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
  ): Escape::EscapeResult {
    let mut aliases: Escape::AliasTable = Escape::AliasTable::init();

    let mut nodeIndex: u64 = 0;

    while (nodeIndex < hir.nodes.length()) {
      if (let Option::SOME(node) = hir.nodes.get(nodeIndex)) {
        // A binding names a closure when it is initialized with one, and
        // equally when one is later assigned to it. Reading only the `let`
        // left a closure literal assigned to an existing binding unreachable
        // from the name, so a later `return f` marked nothing. The value may
        // also choose its closure through a block tail, an `if` or a `match`,
        // and the binding then names every closure literal it can choose.
        if (let Option::SOME(bound) = Escape::boundClosureTarget(hir, node)) {
          let literals: Vector<Hir::HirId> = Hir::valueClosureLiterals(&*hir, bound.valueId);
          let mut literalIndex: u64 = 0;

          while (literalIndex < literals.length()) {
            if (let Option::SOME(literalId) = literals.get(literalIndex)) {
              let _ = aliases.insert(bound.name, *literalId);
            }

            literalIndex += 1;
          }
        }
      }

      nodeIndex += 1;
    }

    // Fixpoint over `let b = a` chains, so an alias of an alias still names
    // the closure it ultimately refers to.
    let mut changed: boolean = true;

    while (changed) {
      changed = false;

      let mut aliasIndex: u64 = 0;

      while (aliasIndex < hir.nodes.length()) {
        if (let Option::SOME(node) = hir.nodes.get(aliasIndex)) {
          if (let Option::SOME(bound) = Escape::boundClosureTarget(hir, node)) {
            // A binding chosen by a branch names every closure its branches
            // can hand over, existing bindings included.
            let mut results: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
            Hir::collectValueResults(&*hir, bound.valueId, &mut results);

            let mut resultIndex: u64 = 0;

            while (resultIndex < results.length()) {
              if (let Option::SOME(resultId) = results.get(resultIndex)) {
                if (let Option::SOME(valueNode) = hir.get(*resultId)) {
                  if (let Hir::HirKind::Variable(sourceDef) = &valueNode.kind) {
                    let sources: Vector<Hir::HirId> = aliases.lookupAll(sourceDef);
                    let mut sourceIndex: u64 = 0;

                    while (sourceIndex < sources.length()) {
                      if (let Option::SOME(closureId) = sources.get(sourceIndex)) {
                        if (aliases.insert(bound.name, *closureId)) {
                          changed = true;
                        }
                      }

                      sourceIndex += 1;
                    }
                  }
                }
              }

              resultIndex += 1;
            }
          }
        }

        aliasIndex += 1;
      }
    }

    let mut escaping: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut bodyIndex: u64 = 0;

    while (bodyIndex < hir.functionBodies.length()) {
      if (let Option::SOME(bodyId) = hir.functionBodies.valueAt(bodyIndex)) {
        Escape::markTailExpression(hir, &aliases, &mut escaping, bodyId);
        Escape::scanForEscapes(hir, defStore, &aliases, &mut escaping, bodyId);
      }

      bodyIndex += 1;
    }

    let mut frameEscaping: Vector<Hir::HirId> = Escape::copyHirIds(&mut escaping);
    Escape::propagateThroughCaptures(hir, &aliases, &mut frameEscaping);

    let mut regions: Vector<Escape::RegionEscape> = Vector::new<Escape::RegionEscape>();
    Escape::markRegionEscapes(hir, &aliases, &mut escaping, &mut regions);
    Escape::propagateThroughCaptures(hir, &aliases, &mut escaping);
    Escape::inheritCapturerLifetimes(hir, &aliases, &escaping, &mut frameEscaping, &mut regions);

    return Escape::EscapeResult {
      escaping: escaping,
      frameEscaping: frameEscaping,
      regions: regions,
    };
  }

  /// A closure an escaping closure captures lives as long as the capturing
  /// closure: it escapes the frame when that one does, and every region that
  /// one escapes. Repeated until nothing changes, so a chain of captures
  /// passes the lifetime all the way down.
  function inheritCapturerLifetimes(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &Vector<Hir::HirId>,
    frameEscaping: &mut Vector<Hir::HirId>,
    regions: &mut Vector<Escape::RegionEscape>,
  ): void {
    let mut changed: boolean = true;

    while (changed) {
      changed = false;

      let mut index: u64 = 0;

      while (index < escaping.length()) {
        let Option::SOME(closureId) = escaping.get(index) else {
          index += 1;
          continue;
        };

        let captured: Vector<Hir::HirId> = Escape::capturedClosures(hir, aliases, *closureId);
        let capturerEscapesFrame: boolean = Escape::containsHirId(&*frameEscaping, *closureId);
        let mut capturerRegions: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
        let mut regionIndex: u64 = 0;

        while (regionIndex < regions.length()) {
          if (let Option::SOME(region) = regions.get(regionIndex)) {
            if (region.closureId.raw() == closureId.raw()) {
              capturerRegions.push(region.regionId);
            }
          }

          regionIndex += 1;
        }

        let mut capturedIndex: u64 = 0;

        while (capturedIndex < captured.length()) {
          if (let Option::SOME(innerId) = captured.get(capturedIndex)) {
            if (capturerEscapesFrame && !Escape::containsHirId(&*frameEscaping, *innerId)) {
              Escape::pushHirId(frameEscaping, *innerId);
              changed = true;
            }

            let mut inheritIndex: u64 = 0;

            while (inheritIndex < capturerRegions.length()) {
              if (let Option::SOME(regionId) = capturerRegions.get(inheritIndex)) {
                if (Escape::addRegionEscape(regions, *innerId, *regionId)) {
                  changed = true;
                }
              }

              inheritIndex += 1;
            }
          }

          capturedIndex += 1;
        }

        index += 1;
      }
    }
  }

  /// The closure literals the captures of `closureId` can name.
  function capturedClosures(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    closureId: Hir::HirId,
  ): Vector<Hir::HirId> {
    let mut captureDefs: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(node) = hir.get(closureId)) {
      if (let Hir::HirKind::Closure(closureNode) = &node.kind) {
        let mut captureIndex: u64 = 0;

        while (captureIndex < closureNode.captures.length()) {
          if (let Option::SOME(capture) = closureNode.captures.get(captureIndex)) {
            captureDefs.push(capture.sourceDef);
          }

          captureIndex += 1;
        }
      }
    }

    let mut result: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut defIndex: u64 = 0;

    while (defIndex < captureDefs.length()) {
      if (let Option::SOME(defId) = captureDefs.get(defIndex)) {
        let inner: Vector<Hir::HirId> = aliases.lookupAll(*defId);
        let mut innerIndex: u64 = 0;

        while (innerIndex < inner.length()) {
          if (let Option::SOME(innerClosureId) = inner.get(innerIndex)) {
            Escape::pushHirId(&mut result, *innerClosureId);
          }

          innerIndex += 1;
        }
      }

      defIndex += 1;
    }

    return result;
  }

  /// Record that `closureId` escapes `regionId`, once.
  function addRegionEscape(
    regions: &mut Vector<Escape::RegionEscape>,
    closureId: Hir::HirId,
    regionId: Hir::HirId,
  ): boolean {
    let mut index: u64 = 0;

    while (index < regions.length()) {
      if (let Option::SOME(region) = regions.get(index)) {
        if (region.closureId.raw() == closureId.raw() && region.regionId.raw() == regionId.raw()) {
          return false;
        }
      }

      index += 1;
    }

    let mut regionsRef: &mut Vector<Escape::RegionEscape> = regions;
    regionsRef.push(Escape::RegionEscape { closureId: closureId, regionId: regionId });

    return true;
  }

  /// A stack environment is one slot per closure site, reused every time the
  /// site runs. A loop body runs the site again in the same frame, and a
  /// closure body runs it in the thunk's frame, which ends with each call. A
  /// closure bound to a binding declared outside that region outlives one run
  /// of the site: the next iteration overwrites its environment while the
  /// binding still holds it, or the thunk returns and the environment is gone.
  /// Such a closure escapes the region, so its environment goes to the heap.
  function markRegionEscapes(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    regions: &mut Vector<Escape::RegionEscape>,
  ): void {
    if (aliases.defs.length() == 0) {
      return;
    }

    let mut nodeIndex: u64 = 0;

    while (nodeIndex < hir.nodes.length()) {
      let mut isRegion: boolean = false;

      if (let Option::SOME(node) = hir.nodes.get(nodeIndex)) {
        match (&node.kind) {
          Hir::HirKind::Loop(_) -> {
            isRegion = true;
          },
          Hir::HirKind::Closure(_) -> {
            isRegion = true;
          },
          _ -> {},
        };
      }

      if (isRegion) {
        let regionId: Hir::HirId = Id::fromRaw<Hir::NodeTag>(nodeIndex as u32);
        Escape::markRegionEscapesUnder(hir, aliases, escaping, regions, regionId);
      }

      nodeIndex += 1;
    }
  }

  /// Mark every closure literal in the region `regionId` that a binding
  /// declared outside the region names.
  function markRegionEscapesUnder(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    regions: &mut Vector<Escape::RegionEscape>,
    regionId: Hir::HirId,
  ): void {
    let mut literals: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut pending: Vector<Hir::HirId> = Escape::regionRoots(hir, regionId);

    while (let Option::SOME(hirId) = pending.pop()) {
      if (let Option::SOME(node) = hir.get(hirId)) {
        if (let Hir::HirKind::Closure(_) = &node.kind) {
          literals.push(hirId);
        }

        let children: Vector<Hir::HirId> = Hir::childIds(&node.kind);
        let mut childIndex: u64 = 0;

        while (childIndex < children.length()) {
          if (let Option::SOME(childId) = children.get(childIndex)) {
            pending.push(*childId);
          }

          childIndex += 1;
        }
      }
    }

    if (literals.length() == 0) {
      return;
    }

    let declared: Vector<Analyzer::DefinitionId> = Escape::regionBindings(hir, regionId);
    let mut aliasIndex: u64 = 0;

    while (aliasIndex < aliases.defs.length()) {
      if (let Option::SOME(defId) = aliases.defs.get(aliasIndex)) {
        if (let Option::SOME(closureId) = aliases.closures.get(aliasIndex)) {
          if (Escape::containsHirId(&literals, *closureId) && !Escape::containsDefId(&declared, *defId)) {
            Escape::pushHirId(escaping, *closureId);

            let _ = Escape::addRegionEscape(regions, *closureId, regionId);
          }
        }
      }

      aliasIndex += 1;
    }
  }

  /// The nodes a region runs again: every child of a loop, condition and
  /// update included, or the body of a closure.
  function regionRoots(hir: &mut Hir::HirStore, regionId: Hir::HirId): Vector<Hir::HirId> {
    let mut roots: Vector<Hir::HirId> = Vector::new<Hir::HirId>();

    if (let Option::SOME(node) = hir.get(regionId)) {
      match (&node.kind) {
        Hir::HirKind::Loop(_) -> {
          roots = Hir::childIds(&node.kind);
        },
        Hir::HirKind::Closure(closureNode) -> {
          roots.push(closureNode.body);
        },
        _ -> {},
      };
    }

    return roots;
  }

  /// Every binding the region `regionId` declares: `let` names, pattern
  /// bindings and the parameters of every closure in it, the region's own
  /// closure included. A binding declared here does not outlive one run of the
  /// region. Collecting too many only rejects more, so the walk descends
  /// everywhere, nested closures included.
  function regionBindings(
    hir: &mut Hir::HirStore,
    regionId: Hir::HirId
  ): Vector<Analyzer::DefinitionId> {
    let mut bindings: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut pending: Vector<Hir::HirId> = Escape::regionRoots(hir, regionId);

    if (let Option::SOME(regionNode) = hir.get(regionId)) {
      if (let Hir::HirKind::Closure(closureNode) = &regionNode.kind) {
        Escape::pushDefIds(&mut bindings, &closureNode.params);
      }
    }

    while (let Option::SOME(hirId) = pending.pop()) {
      if (let Option::SOME(node) = hir.get(hirId)) {
        match (&node.kind) {
          Hir::HirKind::Let(letNode) -> {
            bindings.push(letNode.name);
          },
          Hir::HirKind::LetElse(letElseNode) -> {
            Escape::collectPatternBindings(&letElseNode.pattern, &mut bindings);
          },
          Hir::HirKind::Match(matchNode) -> {
            let mut armIndex: u64 = 0;

            while (armIndex < matchNode.arms.length()) {
              if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
                Escape::collectPatternBindings(&arm.pattern, &mut bindings);
              }

              armIndex += 1;
            }
          },
          Hir::HirKind::Closure(closureNode) -> {
            Escape::pushDefIds(&mut bindings, &closureNode.params);
          },
          _ -> {},
        };

        let children: Vector<Hir::HirId> = Hir::childIds(&node.kind);
        let mut childIndex: u64 = 0;

        while (childIndex < children.length()) {
          if (let Option::SOME(childId) = children.get(childIndex)) {
            pending.push(*childId);
          }

          childIndex += 1;
        }
      }
    }

    return bindings;
  }

  function pushDefIds(
    target: &mut Vector<Analyzer::DefinitionId>,
    source: &Vector<Analyzer::DefinitionId>
  ): void {
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(defId) = source.get(index)) {
        let mut targetRef: &mut Vector<Analyzer::DefinitionId> = target;
        targetRef.push(*defId);
      }

      index += 1;
    }
  }

  function collectPatternBindings(
    pattern: &Hir::HirPattern,
    bindings: &mut Vector<Analyzer::DefinitionId>
  ): void {
    match (pattern) {
      Hir::HirPattern::Binding(defId) -> {
        let mut bindingsRef: &mut Vector<Analyzer::DefinitionId> = bindings;
        bindingsRef.push(defId);
      },
      Hir::HirPattern::Variant(variantPattern) -> {
        let mut index: u64 = 0;

        while (index < variantPattern.args.length()) {
          if (let Option::SOME(argPattern) = variantPattern.args.get(index)) {
            Escape::collectPatternBindings(argPattern, bindings);
          }

          index += 1;
        }
      },
      Hir::HirPattern::Tuple(elements) -> {
        let mut index: u64 = 0;

        while (index < elements.length()) {
          if (let Option::SOME(element) = elements.get(index)) {
            Escape::collectPatternBindings(element, bindings);
          }

          index += 1;
        }
      },
      Hir::HirPattern::Or(alternatives) -> {
        let mut index: u64 = 0;

        while (index < alternatives.length()) {
          if (let Option::SOME(alternative) = alternatives.get(index)) {
            Escape::collectPatternBindings(alternative, bindings);
          }

          index += 1;
        }
      },
      _ -> {},
    };
  }

  /// Whether a reference capture of `defId` in the escaping closure
  /// `closureId` outlives its referent. A closure that escapes its frame or a
  /// closure body outlives every reference it holds; one that escapes only
  /// loops outlives just the bindings those loops declare.
  function referenceOutlivesReferent(
    hir: &mut Hir::HirStore,
    result: &Escape::EscapeResult,
    closureId: Hir::HirId,
    defId: Analyzer::DefinitionId,
  ): boolean {
    if (Escape::containsHirId(&result.frameEscaping, closureId)) {
      return true;
    }

    let mut foundRegion: boolean = false;
    let mut regionIndex: u64 = 0;

    while (regionIndex < result.regions.length()) {
      if (let Option::SOME(region) = result.regions.get(regionIndex)) {
        if (region.closureId.raw() == closureId.raw()) {
          foundRegion = true;

          // A closure body region is a thunk frame that ends with each call.
          // A reference built there can point into that frame even when it
          // names a binding of an outer scope (an outer capture copied into
          // the thunk), so every reference outlives its referent.
          if (let Option::SOME(regionNode) = hir.get(region.regionId)) {
            if (let Hir::HirKind::Closure(_) = &regionNode.kind) {
              return true;
            }
          }

          let declared: Vector<Analyzer::DefinitionId> = Escape::regionBindings(hir, region.regionId);

          if (Escape::containsDefId(&declared, defId)) {
            return true;
          }
        }
      }

      regionIndex += 1;
    }

    // Every heap closure is frame-escaping or has a region record; one with
    // neither has no known bound, so treat it like a frame escape.
    return !foundRegion;
  }

  function containsHirId(ids: &Vector<Hir::HirId>, value: Hir::HirId): boolean {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(existing) = ids.get(index)) {
        if (existing.raw() == value.raw()) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function containsDefId(
    ids: &Vector<Analyzer::DefinitionId>,
    value: Analyzer::DefinitionId
  ): boolean {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(existing) = ids.get(index)) {
        if (existing.raw() == value.raw()) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// A closure captured by an escaping closure outlives the capturing
  /// closure's defining frame too, so its own environment must be
  /// heap-allocated as well.
  function propagateThroughCaptures(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
  ): void {
    let mut changed: boolean = true;

    while (changed) {
      changed = false;

      // Snapshotted so the loop below can freely push onto `escaping`
      // without iterating the vector it is mutating.
      let snapshot: Vector<Hir::HirId> = Escape::copyHirIds(escaping);
      let mut index: u64 = 0;

      while (index < snapshot.length()) {
        if (let Option::SOME(closureId) = snapshot.get(index)) {
          let capturedClosureId: Hir::HirId = *closureId;

          if (let Option::SOME(node) = hir.get(capturedClosureId)) {
            if (let Hir::HirKind::Closure(closureNode) = &node.kind) {
              let mut captureIndex: u64 = 0;

              while (captureIndex < closureNode.captures.length()) {
                if (let Option::SOME(capture) = closureNode.captures.get(captureIndex)) {
                  let inner: Vector<Hir::HirId> = aliases.lookupAll(capture.sourceDef);
                  let mut innerIndex: u64 = 0;

                  while (innerIndex < inner.length()) {
                    if (let Option::SOME(innerClosureId) = inner.get(innerIndex)) {
                      let lengthBefore: u64 = escaping.length();
                      Escape::pushHirId(escaping, *innerClosureId);

                      if (escaping.length() != lengthBefore) {
                        changed = true;
                      }
                    }

                    innerIndex += 1;
                  }
                }

                captureIndex += 1;
              }
            }
          }
        }

        index += 1;
      }
    }
  }

  /// Mark the tail expression of a block body: its value is the body's
  /// result, so it crosses the frame boundary exactly like an explicit
  /// `return` operand.
  function markTailExpression(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    bodyId: Hir::HirId,
  ): void {
    let Option::SOME(node) = hir.get(bodyId) else {
      return;
    };

    if (let Hir::HirKind::Block(blockNode) = &node.kind) {
      if (let Option::SOME(tailId) = blockNode.expression) {
        Escape::markEscapingResult(hir, aliases, escaping, tailId);
      }
    }
  }

  /// Mark the closures a **result** can evaluate to: the operand of a
  /// `return`, or the tail expression of a function or closure body.
  ///
  /// The result may be the closure expression itself, a variable aliasing
  /// one, or the result of a block, an `if`/`else`, or a `match` whose
  /// branches produce one. A closure literal counts here because the
  /// caller's binding takes ownership of the environment.
  function markEscapingResult(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    hirId: Hir::HirId,
  ): void {
    Escape::markEscapingValue(hir, aliases, escaping, hirId, true);
  }

  /// Mark the closures a value reaching a non-result escaping position can
  /// evaluate to: an assignment to a field, index or dereference, a record-initializer field,
  /// an enum payload, a vector or tuple element.
  ///
  /// A closure literal written straight into one of these positions is not
  /// marked: nothing on the other side owns its environment, so
  /// heap-allocating it would only leak it, while leaving it in the frame
  /// that built it keeps it alive for at least as long as a binding in that
  /// frame would.
  function markEscapingArgument(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    hirId: Hir::HirId,
  ): void {
    Escape::markEscapingValue(hir, aliases, escaping, hirId, false);
  }

  function markEscapingValue(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    hirId: Hir::HirId,
    includeLiteral: boolean,
  ): void {
    let Option::SOME(node) = hir.get(hirId) else {
      return;
    };

    match (&node.kind) {
      Hir::HirKind::Closure(_) -> {
        if (includeLiteral) {
          Escape::pushHirId(escaping, hirId);
        }
      },
      Hir::HirKind::Variable(defId) -> {
        let bound: Vector<Hir::HirId> = aliases.lookupAll(defId);
        let mut boundIndex: u64 = 0;

        while (boundIndex < bound.length()) {
          if (let Option::SOME(closureId) = bound.get(boundIndex)) {
            Escape::pushHirId(escaping, *closureId);
          }

          boundIndex += 1;
        }
      },
      Hir::HirKind::Block(blockNode) -> {
        if (let Option::SOME(tailId) = blockNode.expression) {
          Escape::markEscapingValue(hir, aliases, escaping, tailId, includeLiteral);
        }
      },
      Hir::HirKind::If(ifNode) -> {
        Escape::markEscapingValue(hir, aliases, escaping, ifNode.thenBranch, includeLiteral);

        if (let Option::SOME(elseId) = ifNode.elseBranch) {
          Escape::markEscapingValue(hir, aliases, escaping, elseId, includeLiteral);
        }
      },
      Hir::HirKind::Match(matchNode) -> {
        let mut armIndex: u64 = 0;

        while (armIndex < matchNode.arms.length()) {
          if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
            Escape::markEscapingValue(hir, aliases, escaping, arm.body, includeLiteral);
          }

          armIndex += 1;
        }
      },
      // An aggregate built in result position crosses the frame boundary with
      // its elements inside it, so a closure literal written into one is in
      // result position too. Outside result position the aggregate is only as
      // long-lived as the frame that built it, which is what the literal
      // already assumes.
      Hir::HirKind::RecordInit(recordNode) -> {
        if (includeLiteral) {
          let mut fieldIndex: u64 = 0;

          while (fieldIndex < recordNode.fields.length()) {
            if (let Option::SOME(field) = recordNode.fields.get(fieldIndex)) {
              Escape::markEscapingValue(hir, aliases, escaping, field.value, true);
            }

            fieldIndex += 1;
          }
        }
      },
      Hir::HirKind::EnumVariant(variantNode) -> {
        if (includeLiteral) {
          Escape::markEscapingResultList(hir, aliases, escaping, &variantNode.payload);
        }
      },
      Hir::HirKind::VectorLiteral(elements) -> {
        if (includeLiteral) {
          Escape::markEscapingResultList(hir, aliases, escaping, &elements);
        }
      },
      Hir::HirKind::TupleLiteral(elements) -> {
        if (includeLiteral) {
          Escape::markEscapingResultList(hir, aliases, escaping, &elements);
        }
      },
      _ -> {},
    };
  }

  /// Calls `markEscapingResult` on every id in `ids`.
  function markEscapingResultList(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    ids: &Vector<Hir::HirId>,
  ): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        Escape::markEscapingResult(hir, aliases, escaping, *id);
      }

      index += 1;
    }
  }

  /// Calls `markEscapingArgument` on every id in `ids`.
  function markEscapingArgumentList(
    hir: &mut Hir::HirStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    ids: &Vector<Hir::HirId>,
  ): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        Escape::markEscapingArgument(hir, aliases, escaping, *id);
      }

      index += 1;
    }
  }

  function scanForEscapesList(
    hir: &mut Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    ids: &Vector<Hir::HirId>,
  ): void {
    let mut index: u64 = 0;

    while (index < ids.length()) {
      if (let Option::SOME(id) = ids.get(index)) {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, *id);
      }

      index += 1;
    }
  }

  /// Whether the parameter in `paramIndex` carries `@noescape`.
  function paramIsNoEscape(
    defStore: &mut Analyzer::DefinitionStore,
    paramDefs: &Vector<Analyzer::DefinitionId>,
    paramIndex: u64,
  ): boolean {
    let Option::SOME(paramDefId) = paramDefs.get(paramIndex) else {
      return false;
    };

    let Option::SOME(definition) = defStore.get(*paramDefId) else {
      return false;
    };

    return match (definition) {
      Analyzer::Definition::Variable(variableDef) -> variableDef.noEscape,
      _ -> false,
    };
  }

  function calleeParams(
    defStore: &mut Analyzer::DefinitionStore,
    calleeDef: Analyzer::DefinitionId,
  ): Vector<Analyzer::DefinitionId> {
    let mut params: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    if (let Option::SOME(definition) = defStore.get(calleeDef)) {
      match (definition) {
        Analyzer::Definition::Function(functionDef) -> {
          params = Escape::copyDefIds(&functionDef.params);
        },
        Analyzer::Definition::Method(methodDef) -> {
          params = Escape::copyDefIds(&methodDef.params);
        },
        _ -> {},
      };
    }

    return params;
  }

  function copyDefIds(source: &Vector<Analyzer::DefinitionId>): Vector<Analyzer::DefinitionId> {
    let mut result: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(defId) = source.get(index)) {
        result.push(*defId);
      }

      index += 1;
    }

    return result;
  }

  /// Scans every argument of a call: each one escapes on its own unless its
  /// parameter carries `@noescape`, and each is descended into either way.
  function scanCallArguments(
    hir: &mut Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    args: &Vector<Hir::HirId>,
    paramDefs: &Vector<Analyzer::DefinitionId>,
    paramOffset: u64,
  ): void {
    let mut index: u64 = 0;

    while (index < args.length()) {
      if (let Option::SOME(argId) = args.get(index)) {
        // A parameter that is not `@noescape` owns the closure it receives
        // and frees it, so a closure literal handed to it needs a heap
        // environment the callee can keep. An argument without a known
        // parameter, such as one of an indirect closure call, is treated the
        // same way, because nothing says the callee will not store it.
        if (!Escape::paramIsNoEscape(defStore, paramDefs, index + paramOffset)) {
          Escape::markEscapingResult(hir, aliases, escaping, *argId);
        }

        Escape::scanForEscapes(hir, defStore, aliases, escaping, *argId);
      }

      index += 1;
    }
  }

  function scanForEscapes(
    hir: &mut Hir::HirStore,
    defStore: &mut Analyzer::DefinitionStore,
    aliases: &Escape::AliasTable,
    escaping: &mut Vector<Hir::HirId>,
    hirId: Hir::HirId,
  ): void {
    let Option::SOME(node) = hir.get(hirId) else {
      return;
    };

    match (&node.kind) {
      Hir::HirKind::Return(value) -> {
        if (let Option::SOME(valueId) = value) {
          Escape::markEscapingResult(hir, aliases, escaping, valueId);
          Escape::scanForEscapes(hir, defStore, aliases, escaping, valueId);
        }
      },
      Hir::HirKind::Call(callNode) -> {
        let paramDefs: Vector<Analyzer::DefinitionId> = Escape::calleeParams(defStore, callNode.callee);
        Escape::scanCallArguments(hir, defStore, aliases, escaping, &callNode.args, &paramDefs, 0);
      },
      Hir::HirKind::MethodCall(methodNode) -> {
        let mut paramOffset: u64 = 0;

        if (let Option::SOME(receiverId) = methodNode.receiver) {
          Escape::scanForEscapes(hir, defStore, aliases, escaping, receiverId);
          // `self` occupies the first parameter slot of an instance method.
          paramOffset = 1;
        }

        let paramDefs: Vector<Analyzer::DefinitionId> = Escape::calleeParams(defStore, methodNode.method);
        Escape::scanCallArguments(hir, defStore, aliases, escaping, &methodNode.args, &paramDefs, paramOffset);
      },
      // A call through a closure value has no parameter list to consult.
      Hir::HirKind::CallClosure(closureCall) -> {
        let noParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
        Escape::scanForEscapes(hir, defStore, aliases, escaping, closureCall.callee);
        Escape::scanCallArguments(hir, defStore, aliases, escaping, &closureCall.args, &noParams, 0);
      },
      Hir::HirKind::Assign(assignNode) -> {
        let mut complexTarget: boolean = false;

        if (let Option::SOME(targetNode) = hir.get(assignNode.target)) {
          match (&targetNode.kind) {
            Hir::HirKind::FieldAccess(_) -> {
              complexTarget = true;
            },
            Hir::HirKind::StaticAccess(_) -> {
              complexTarget = true;
            },
            Hir::HirKind::Index(_) -> {
              complexTarget = true;
            },
            Hir::HirKind::Dereference(_) -> {
              complexTarget = true;
            },
            _ -> {},
          };
        }

        if (complexTarget) {
          Escape::markEscapingArgument(hir, aliases, escaping, assignNode.value);
        }

        Escape::scanForEscapes(hir, defStore, aliases, escaping, assignNode.target);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, assignNode.value);
      },
      Hir::HirKind::RecordInit(recordNode) -> {
        let mut fieldIndex: u64 = 0;

        while (fieldIndex < recordNode.fields.length()) {
          if (let Option::SOME(field) = recordNode.fields.get(fieldIndex)) {
            Escape::markEscapingArgument(hir, aliases, escaping, field.value);
            Escape::scanForEscapes(hir, defStore, aliases, escaping, field.value);
          }

          fieldIndex += 1;
        }
      },
      Hir::HirKind::EnumVariant(variantNode) -> {
        let mut payloadIndex: u64 = 0;

        while (payloadIndex < variantNode.payload.length()) {
          if (let Option::SOME(payloadId) = variantNode.payload.get(payloadIndex)) {
            Escape::markEscapingArgument(hir, aliases, escaping, *payloadId);
            Escape::scanForEscapes(hir, defStore, aliases, escaping, *payloadId);
          }

          payloadIndex += 1;
        }
      },
      // A nested closure body is its own frame: its tail expression and
      // inner escape points are analyzed exactly like a function body's.
      Hir::HirKind::Closure(closureNode) -> {
        Escape::markTailExpression(hir, aliases, escaping, closureNode.body);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, closureNode.body);
      },
      Hir::HirKind::Block(blockNode) -> {
        Escape::scanForEscapesList(hir, defStore, aliases, escaping, &blockNode.statements);

        if (let Option::SOME(expressionId) = blockNode.expression) {
          Escape::scanForEscapes(hir, defStore, aliases, escaping, expressionId);
        }
      },
      Hir::HirKind::Let(letNode) -> {
        if (let Option::SOME(valueId) = letNode.value) {
          Escape::scanForEscapes(hir, defStore, aliases, escaping, valueId);
        }
      },
      Hir::HirKind::If(ifNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, ifNode.condition);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, ifNode.thenBranch);

        if (let Option::SOME(elseId) = ifNode.elseBranch) {
          Escape::scanForEscapes(hir, defStore, aliases, escaping, elseId);
        }
      },
      Hir::HirKind::LetElse(letElseNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, letElseNode.value);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, letElseNode.elseBlock);
      },
      Hir::HirKind::Loop(loopNode) -> {
        match (&loopNode.condition) {
          Hir::LoopKind::While(conditionId) -> {
            Escape::scanForEscapes(hir, defStore, aliases, escaping, conditionId);
          },
          Hir::LoopKind::For(forLoop) -> {
            if (let Option::SOME(initId) = forLoop.init) {
              Escape::scanForEscapes(hir, defStore, aliases, escaping, initId);
            }

            if (let Option::SOME(conditionId) = forLoop.condition) {
              Escape::scanForEscapes(hir, defStore, aliases, escaping, conditionId);
            }

            if (let Option::SOME(updateId) = forLoop.update) {
              Escape::scanForEscapes(hir, defStore, aliases, escaping, updateId);
            }
          },
          Hir::LoopKind::Infinite -> {},
        };

        Escape::scanForEscapes(hir, defStore, aliases, escaping, loopNode.body);
      },
      Hir::HirKind::ExpressionStatement(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::Binary(binaryNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, binaryNode.left);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, binaryNode.right);
      },
      Hir::HirKind::Unary(unaryNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, unaryNode.operand);
      },
      Hir::HirKind::Cast(castNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, castNode.expression);
      },
      Hir::HirKind::BitCast(castNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, castNode.expression);
      },
      Hir::HirKind::Reference(referenceNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, referenceNode.expression);
      },
      Hir::HirKind::Dereference(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::TypeOf(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::ToRawFunction(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::FromRawFunction(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::InlineAsm(asmNode) -> {
        let operands: Vector<Hir::HirId> = Hir::inlineAsmChildIds(&asmNode);
        Escape::scanForEscapesList(hir, defStore, aliases, escaping, &operands);
      },
      Hir::HirKind::Panic(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::Defer(inner) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, inner);
      },
      Hir::HirKind::Index(indexNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, indexNode.base);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, indexNode.index);
      },
      Hir::HirKind::FieldAccess(fieldNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, fieldNode.base);
      },
      Hir::HirKind::VectorLiteral(elements) -> {
        Escape::markEscapingArgumentList(hir, aliases, escaping, &elements);
        Escape::scanForEscapesList(hir, defStore, aliases, escaping, &elements);
      },
      Hir::HirKind::TupleLiteral(elements) -> {
        Escape::markEscapingArgumentList(hir, aliases, escaping, &elements);
        Escape::scanForEscapesList(hir, defStore, aliases, escaping, &elements);
      },
      Hir::HirKind::MakeSlice(sliceNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, sliceNode.data);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, sliceNode.len);
      },
      Hir::HirKind::MakeRange(rangeNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, rangeNode.start);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, rangeNode.end);
      },
      Hir::HirKind::Match(matchNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, matchNode.scrutinee);

        let mut armIndex: u64 = 0;

        while (armIndex < matchNode.arms.length()) {
          if (let Option::SOME(arm) = matchNode.arms.get(armIndex)) {
            if (let Option::SOME(guardId) = arm.guard) {
              Escape::scanForEscapes(hir, defStore, aliases, escaping, guardId);
            }

            Escape::scanForEscapes(hir, defStore, aliases, escaping, arm.body);
          }

          armIndex += 1;
        }
      },
      Hir::HirKind::BuiltinLoad(loadNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, loadNode.ptr);
      },
      Hir::HirKind::BuiltinSplat(splatNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, splatNode.value);
      },
      Hir::HirKind::BuiltinAtomic(atomicNode) -> {
        let mut operandIndex: u64 = 0;

        while (operandIndex < atomicNode.operands.length()) {
          if (let Option::SOME(operand) = atomicNode.operands.get(operandIndex)) {
            Escape::scanForEscapes(hir, defStore, aliases, escaping, *operand);
          }

          operandIndex += 1;
        }
      },
      Hir::HirKind::BuiltinStore(storeNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, storeNode.ptr);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, storeNode.value);
      },
      Hir::HirKind::BuiltinHash(hashNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, hashNode.value);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, hashNode.hasher);
      },
      Hir::HirKind::BuiltinEq(eqNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, eqNode.left);
        Escape::scanForEscapes(hir, defStore, aliases, escaping, eqNode.right);
      },
      Hir::HirKind::BuiltinDropInPlace(dropNode) -> {
        Escape::scanForEscapes(hir, defStore, aliases, escaping, dropNode.ptr);
      },
      _ -> {},
    };
  }
}
