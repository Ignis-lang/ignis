          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Reference(r) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(s) -> r.referent.raw() == s.referent.raw() && r.mutable == s.mutable,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Slice(e) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(f) -> e.equals(&f),
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::FixedArray(e, n) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(f, m) -> e.equals(&f) && n == m,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Tuple(a) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(b) -> Analyzer::Type::typeIdVectorsEqual(&a.elements, &b.elements),
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Function(f) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(g) -> Analyzer::Type::typeIdVectorsEqual(&f.params, &g.params) && f.returnType.raw() == g.returnType.raw(),
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Record(defId) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(otherDefId) -> defId.raw() == otherDefId.raw(),
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Enum(defId) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(otherDefId) -> defId.raw() == otherDefId.raw(),
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Param(s1) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(s2) -> s1.equals(&s2),
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Instance(i1) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(i2) -> i1.definition.raw() == i2.definition.raw() && Analyzer::Type::typeIdVectorsEqual(&i1.typeArguments, &i2.typeArguments),
          Analyzer::Type::Alias(_) -> false,
        },
        Analyzer::Type::Alias(a1) -> match (other) {
          Analyzer::Type::I8 -> false,
          Analyzer::Type::I16 -> false,
          Analyzer::Type::I32 -> false,
          Analyzer::Type::I64 -> false,
          Analyzer::Type::U8 -> false,
          Analyzer::Type::U16 -> false,
          Analyzer::Type::U32 -> false,
          Analyzer::Type::U64 -> false,
          Analyzer::Type::F32 -> false,
          Analyzer::Type::F64 -> false,
          Analyzer::Type::BOOLEAN -> false,
          Analyzer::Type::CHAR -> false,
          Analyzer::Type::STR -> false,
          Analyzer::Type::VOID -> false,
          Analyzer::Type::NEVER -> false,
          Analyzer::Type::ATOM -> false,
          Analyzer::Type::Pointer(_) -> false,
          Analyzer::Type::Reference(_) -> false,
          Analyzer::Type::Slice(_) -> false,
          Analyzer::Type::FixedArray(_, _) -> false,
          Analyzer::Type::Tuple(_) -> false,
          Analyzer::Type::Function(_) -> false,
          Analyzer::Type::Record(_) -> false,
          Analyzer::Type::Enum(_) -> false,
          Analyzer::Type::Param(_) -> false,
          Analyzer::Type::Instance(_) -> false,
          Analyzer::Type::Alias(a2) -> a1.raw() == a2.raw(),
        },
      };
    }

    /// Compares two TypeId vectors for structural equality element-by-element.
    /// Short-circuits false if lengths differ; then checks each index via TypeId::equals.
    private static typeIdVectorsEqual(
      left: &Vector<Analyzer::TypeId>,
      right: &Vector<Analyzer::TypeId>,
    ): boolean {
      if (left.length() != right.length()) {
        return false;
      }

      let mut index: u64 = 0;

      while (index < left.length()) {
        let Option::SOME(l) = left.get(index) else {
          return false;
        };
        let Option::SOME(r) = right.get(index) else {
          return false;
        };

        if (!l.equals(r)) {
          return false;
        }

        index += 1;
      }

      return true;
    }
  }

  /// Owns all interned types and caches one canonical `Analyzer::TypeId` per primitive.
  /// The set of primitives is finite and known at construction time, so the
  /// store eagerly allocates one slot per variant during `init()`.
  record TypeStore {
    types: IndexVec<Analyzer::TypeTag, Analyzer::Type>;
    primI8: Analyzer::TypeId;
    primI16: Analyzer::TypeId;
    primI32: Analyzer::TypeId;
    primI64: Analyzer::TypeId;
    primU8: Analyzer::TypeId;
    primU16: Analyzer::TypeId;
    primU32: Analyzer::TypeId;
    primU64: Analyzer::TypeId;
    primF32: Analyzer::TypeId;
    primF64: Analyzer::TypeId;
    primBoolean: Analyzer::TypeId;
    primChar: Analyzer::TypeId;
    primStr: Analyzer::TypeId;
    primVoid: Analyzer::TypeId;
    primNever: Analyzer::TypeId;
    primAtom: Analyzer::TypeId;

    public static init(): TypeStore {
      let mut storage: IndexVec<Analyzer::TypeTag, Analyzer::Type> = IndexVec::new<Analyzer::TypeTag, Analyzer::Type>();

      let idI8: Analyzer::TypeId = storage.push(Analyzer::Type::I8);
      let idI16: Analyzer::TypeId = storage.push(Analyzer::Type::I16);
      let idI32: Analyzer::TypeId = storage.push(Analyzer::Type::I32);
      let idI64: Analyzer::TypeId = storage.push(Analyzer::Type::I64);
      let idU8: Analyzer::TypeId = storage.push(Analyzer::Type::U8);
      let idU16: Analyzer::TypeId = storage.push(Analyzer::Type::U16);
      let idU32: Analyzer::TypeId = storage.push(Analyzer::Type::U32);
      let idU64: Analyzer::TypeId = storage.push(Analyzer::Type::U64);
      let idF32: Analyzer::TypeId = storage.push(Analyzer::Type::F32);
      let idF64: Analyzer::TypeId = storage.push(Analyzer::Type::F64);
      let idBoolean: Analyzer::TypeId = storage.push(Analyzer::Type::BOOLEAN);
      let idChar: Analyzer::TypeId = storage.push(Analyzer::Type::CHAR);
      let idStr: Analyzer::TypeId = storage.push(Analyzer::Type::STR);
      let idVoid: Analyzer::TypeId = storage.push(Analyzer::Type::VOID);
      let idNever: Analyzer::TypeId = storage.push(Analyzer::Type::NEVER);
      let idAtom: Analyzer::TypeId = storage.push(Analyzer::Type::ATOM);

      return TypeStore {
        types: storage,
        primI8: idI8,
        primI16: idI16,
        primI32: idI32,
        primI64: idI64,
        primU8: idU8,
        primU16: idU16,
        primU32: idU32,
        primU64: idU64,
        primF32: idF32,
        primF64: idF64,
        primBoolean: idBoolean,
        primChar: idChar,
        primStr: idStr,
        primVoid: idVoid,
        primNever: idNever,
        primAtom: idAtom,
      };
    }

    /// Returns the canonical `Analyzer::TypeId` for any type variant.
    ///
    /// Primitive arms short-circuit in O(1) via cached field lookup.
    /// Compound arms perform a linear scan of `self.types` via `Analyzer::Type::equals`
    /// to find an existing match before inserting; on miss, the new entry is pushed.
    public intern(&mut self, kind: Analyzer::Type): Analyzer::TypeId {
      return match (kind) {
        Analyzer::Type::I8 -> self.primI8,
        Analyzer::Type::I16 -> self.primI16,
        Analyzer::Type::I32 -> self.primI32,
        Analyzer::Type::I64 -> self.primI64,
        Analyzer::Type::U8 -> self.primU8,
        Analyzer::Type::U16 -> self.primU16,
        Analyzer::Type::U32 -> self.primU32,
        Analyzer::Type::U64 -> self.primU64,
        Analyzer::Type::F32 -> self.primF32,
        Analyzer::Type::F64 -> self.primF64,
        Analyzer::Type::BOOLEAN -> self.primBoolean,
        Analyzer::Type::CHAR -> self.primChar,
        Analyzer::Type::STR -> self.primStr,
        Analyzer::Type::VOID -> self.primVoid,
        Analyzer::Type::NEVER -> self.primNever,
        Analyzer::Type::ATOM -> self.primAtom,
        Analyzer::Type::Pointer(p) -> self.internCompound(Analyzer::Type::Pointer(p)),  // dedup by PointerType.equals (pointee + mutable)
        Analyzer::Type::Reference(r) -> self.internCompound(Analyzer::Type::Reference(r)),
        Analyzer::Type::Slice(e) -> self.internCompound(Analyzer::Type::Slice(e)),
        Analyzer::Type::FixedArray(e, n) -> self.internCompound(Analyzer::Type::FixedArray(e, n)),
        Analyzer::Type::Tuple(t) -> self.internCompound(Analyzer::Type::Tuple(t)),
        Analyzer::Type::Function(f) -> self.internCompound(Analyzer::Type::Function(f)),
        Analyzer::Type::Record(defId) -> self.internCompound(Analyzer::Type::Record(defId)),
        Analyzer::Type::Enum(defId) -> self.internCompound(Analyzer::Type::Enum(defId)),
        Analyzer::Type::Param(symbol) -> self.internCompound(Analyzer::Type::Param(symbol)),
        Analyzer::Type::Instance(instance) -> self.internCompound(Analyzer::Type::Instance(instance)),
        Analyzer::Type::Alias(defId) -> self.internCompound(Analyzer::Type::Alias(defId)),
      };
    }

    /// Performs a linear scan of `self.types` for a structurally equal entry.
    /// Inserts a new entry on miss and returns the resulting id.
    /// Must only be called for compound (non-primitive) variants.
    private internCompound(&mut self, kind: Analyzer::Type): Analyzer::TypeId {
      let length: u64 = self.types.length();
      let mut index: u64 = 0;

      while (index < length) {
        let id: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(index as u32);

        match (self.types.get(id)) {
          Option::SOME(existing) -> {
            if (existing.equals(&kind)) {
              return id;
            }
          },
          Option::NONE -> {},
        };

        index += 1;
      }

      return self.types.push(kind);
    }

    /// Returns the canonical id for an immutable pointer-to-`pointee` type (`*T`).
    public pointer(&mut self, pointee: Analyzer::TypeId): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Pointer(Analyzer::PointerType { pointee: pointee, mutable: false }));
    }

    /// Returns the canonical id for a mutable pointer-to-`pointee` type (`*mut T`).
    public mutablePointer(&mut self, pointee: Analyzer::TypeId): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Pointer(Analyzer::PointerType { pointee: pointee, mutable: true }));
    }

    /// Returns the canonical id for an immutable reference to `referent` (&T).
    public reference(&mut self, referent: Analyzer::TypeId): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Reference(Analyzer::ReferenceType { referent: referent, mutable: false }));
    }

    /// Returns the canonical id for a mutable reference to `referent` (&mut T).
    public mutableReference(&mut self, referent: Analyzer::TypeId): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Reference(Analyzer::ReferenceType { referent: referent, mutable: true }));
    }

    /// Returns the canonical id for a slice-of-`element` type.
    public slice(&mut self, element: Analyzer::TypeId): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Slice(element));
    }

    /// Returns the canonical id for a fixed-array-of-`element` with `length` elements.
    public fixedArray(&mut self, element: Analyzer::TypeId, length: u64): Analyzer::TypeId {
      return self.intern(Analyzer::Type::FixedArray(element, length));
    }

    /// Returns the canonical id for a tuple with the given element types (in order).
    /// Takes ownership of `elements`; the vector is moved into storage on cache miss.
    public tuple(&mut self, elements: Vector<Analyzer::TypeId>): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Tuple(Analyzer::TupleType { elements: elements }));
    }

    /// Returns the canonical id for a function type with the given parameter types and return type.
    /// Takes ownership of `params`; the vector is moved into storage on cache miss.
    /// Named `functionType` because `function` is a reserved keyword in Ignis.
    public functionType(
      &mut self,
      params: Vector<Analyzer::TypeId>,
      returnType: Analyzer::TypeId
    ): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Function(Analyzer::FunctionType { params: params, returnType: returnType }));
    }

    /// Returns the canonical id for a user-defined record type identified by `defId`.
    /// Named `recordType` because `record` is a reserved keyword in Ignis.
    public recordType(&mut self, defId: Analyzer::DefinitionId): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Record(defId));
    }

    /// Returns the canonical id for a user-defined enum type identified by `defId`.
    /// Named `enumType` because `enum` is a reserved keyword in Ignis.
    public enumType(&mut self, defId: Analyzer::DefinitionId): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Enum(defId));
    }

    /// Returns the canonical id for a type alias identified by `defId`.
    /// The alias is structurally distinct from `Record(defId)` and `Enum(defId)`
    /// even when the same defId is used (different variant tag).
    public aliasType(&mut self, defId: Analyzer::DefinitionId): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Alias(defId));
    }

    /// Returns the canonical id for an unresolved generic parameter identified by `name`.
    ///
    /// Two `Param` calls with the same interned `Symbol` return the same id;
    /// distinct symbols produce distinct ids even when their textual names match,
    /// preserving the binder's notion of identity across scopes.
    public param(&mut self, name: Symbol): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Param(name));
    }

    /// Returns the canonical id for a generic nominal applied to `typeArguments`.
    ///
    /// Takes ownership of `typeArguments`; the vector is moved into storage on
    /// cache miss. Two instances are structurally equal when both the definition
    /// id and the ordered type argument ids match.
    public instance(
      &mut self,
      definition: Analyzer::DefinitionId,
      typeArguments: Vector<Analyzer::TypeId>,
    ): Analyzer::TypeId {
      return self.intern(Analyzer::Type::Instance(Analyzer::InstanceType {
        definition: definition,
        typeArguments: typeArguments,
      }));
    }

    /// Whether a type parameter is reachable from `typeId`.
    ///
    /// Inference only has something to learn from a parameter that mentions one: a
    /// concrete parameter type is checked against the argument, never unified with it.
    /// `Alias` is not followed, matching `substitute`'s own gap — a generic alias whose
    /// aliased type carries a `Param` reads as concrete here too.
    public containsTypeParam(&self, typeId: Analyzer::TypeId): boolean {
      let Option::SOME(kind) = self.types.get(typeId) else {
        return false;
      };

      match (kind) {
        Analyzer::Type::Param(_) -> {
          return true;
        },
        Analyzer::Type::Pointer(p) -> {
          return self.containsTypeParam(p.pointee);
        },
        Analyzer::Type::Reference(r) -> {
          return self.containsTypeParam(r.referent);
        },
        Analyzer::Type::Slice(element) -> {
          return self.containsTypeParam(element);
        },
        Analyzer::Type::FixedArray(element, _) -> {
          return self.containsTypeParam(element);
        },
        Analyzer::Type::Tuple(t) -> {
          return self.anyContainsTypeParam(&t.elements);
        },
        Analyzer::Type::Function(f) -> {
          if (self.anyContainsTypeParam(&f.params)) {
            return true;
          }

          return self.containsTypeParam(f.returnType);
        },
        Analyzer::Type::Instance(instance) -> {
          return self.anyContainsTypeParam(&instance.typeArguments);
        },
        _ -> {
          return false;
        },
      };

      @panic("unreachable: containsTypeParam match did not return");
    }

    /// Whether any entry of `typeIds` mentions a type parameter.
    public anyContainsTypeParam(&self, typeIds: &Vector<Analyzer::TypeId>): boolean {
      let mut index: u64 = 0;

      while (index < typeIds.length()) {
        let Option::SOME(typeId) = typeIds.get(index) else {
          index += 1;
          continue;
        };

        if (self.containsTypeParam(*typeId)) {
          return true;
        }

        index += 1;
      }

      return false;
    }

    /// Structural unification for inference: walks `parameterType` against
    /// `actualType`, binding each `Param(sym)` it meets to whatever concrete type sits
    /// at the same position, and returns the bindings in `paramSymbols` order.
    ///
    /// `NONE` means the shapes disagree, a parameter was bound to two different types,
    /// or some parameter was never reached — in every case there is nothing sound to
    /// substitute, and the caller keeps the declared types. This is stricter than the
    /// Rust reference, which fills unresolved parameters with an error type and carries
    /// on; without an error type to name, refusing outright is the honest equivalent.
    ///
    /// Unification is structural, never coercive: a shared reference does not unify
    /// with a mutable one, arrays must agree on length, and instances must name the
    /// same definition. `Alias` is not followed, matching `substitute`.
    public inferTypeArguments(
      &self,
      parameterType: Analyzer::TypeId,
      actualType: Analyzer::TypeId,
      paramSymbols: &Vector<Symbol>,
    ): Option<Vector<Analyzer::TypeId>> {
      let mut bindings: Vector<Option<Analyzer::TypeId>> = Vector::new<Option<Analyzer::TypeId>>();
      let mut index: u64 = 0;

      while (index < paramSymbols.length()) {
        bindings.push(Option::NONE);
        index += 1;
      }

      if (!self.unifyForInference(parameterType, actualType, paramSymbols, &mut bindings)) {
        return Option::NONE;
      }

      let mut resolved: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut resolvedIndex: u64 = 0;

      while (resolvedIndex < bindings.length()) {
        let Option::SOME(binding) = bindings.get(resolvedIndex) else {
          return Option::NONE;
        };

        let Option::SOME(boundType) = binding else {
          return Option::NONE;
        };

        resolved.push(boundType);
        resolvedIndex += 1;
      }

      return Option::SOME(resolved);
    }

    /// Walk of `inferTypeArguments`. Records what each parameter must be and reports
    /// whether the two shapes stayed compatible the whole way down.
    public unifyForInference(
      &self,
      parameterType: Analyzer::TypeId,
      actualType: Analyzer::TypeId,
      paramSymbols: &Vector<Symbol>,
      bindings: &mut Vector<Option<Analyzer::TypeId>>,
    ): boolean {
      let Option::SOME(parameterKind) = self.types.get(parameterType) else {
        return false;
      };

      if (let Analyzer::Type::Param(symbol) = parameterKind) {
        return self.bindInferredParam(symbol, actualType, paramSymbols, bindings);
      }

      // Nothing to learn from a concrete parameter: whether it accepts the argument is
      // the caller's own type check, not this walk's business.
      if (!self.containsTypeParam(parameterType)) {
        return true;
      }

      let Option::SOME(actualKind) = self.types.get(actualType) else {
        return false;
      };

      match (parameterKind) {
        Analyzer::Type::Pointer(p) -> {
          let Analyzer::Type::Pointer(actualPointer) = actualKind else {
            return false;
          };

          if (p.mutable != actualPointer.mutable) {
            return false;
          }

          return self.unifyForInference(p.pointee, actualPointer.pointee, paramSymbols, bindings);
        },
        Analyzer::Type::Reference(r) -> {
          let Analyzer::Type::Reference(actualReference) = actualKind else {
            return false;
          };

          if (r.mutable != actualReference.mutable) {
            return false;
          }

          return self.unifyForInference(r.referent, actualReference.referent, paramSymbols, bindings);
        },
        Analyzer::Type::Slice(element) -> {
          let Analyzer::Type::Slice(actualElement) = actualKind else {
            return false;
          };

          return self.unifyForInference(element, actualElement, paramSymbols, bindings);
        },
        Analyzer::Type::FixedArray(element, length) -> {
          let Analyzer::Type::FixedArray(actualElement, actualLength) = actualKind else {
            return false;
          };

          if (length != actualLength) {
            return false;
          }

          return self.unifyForInference(element, actualElement, paramSymbols, bindings);
        },
        Analyzer::Type::Tuple(t) -> {
          let Analyzer::Type::Tuple(actualTuple) = actualKind else {
            return false;
          };

          return self.unifyEachForInference(&t.elements, &actualTuple.elements, paramSymbols, bindings);
        },
        Analyzer::Type::Function(f) -> {
          let Analyzer::Type::Function(actualFunction) = actualKind else {
            return false;
          };

          if (!self.unifyEachForInference(&f.params, &actualFunction.params, paramSymbols, bindings)) {
            return false;
          }

          return self.unifyForInference(f.returnType, actualFunction.returnType, paramSymbols, bindings);
        },
        Analyzer::Type::Instance(instance) -> {
          let Analyzer::Type::Instance(actualInstance) = actualKind else {
            return false;
          };

          if (instance.definition.raw() != actualInstance.definition.raw()) {
            return false;
          }

          return self.unifyEachForInference(&instance.typeArguments, &actualInstance.typeArguments, paramSymbols, bindings);
        },
        _ -> {
          return false;
        },
      };

      @panic("unreachable: unifyForInference match did not return");
    }

    /// Pairwise unification of two type lists. Differing lengths are a shape mismatch.
    public unifyEachForInference(
      &self,
      parameterTypes: &Vector<Analyzer::TypeId>,
      actualTypes: &Vector<Analyzer::TypeId>,
      paramSymbols: &Vector<Symbol>,
      bindings: &mut Vector<Option<Analyzer::TypeId>>,
    ): boolean {
      if (parameterTypes.length() != actualTypes.length()) {
        return false;
      }

      let mut index: u64 = 0;

      while (index < parameterTypes.length()) {
        let Option::SOME(parameterType) = parameterTypes.get(index) else {
          return false;
        };

        let Option::SOME(actualType) = actualTypes.get(index) else {
          return false;
        };

        if (!self.unifyForInference(*parameterType, *actualType, paramSymbols, bindings)) {
          return false;
        }

        index += 1;
      }

      return true;
    }

    /// Bind one type parameter, or confirm it already stands for the same type.
    ///
    /// A parameter the caller never declared is not ours to bind: the walk reached a
    /// `Param` from some other owner, and guessing would key a binding on a symbol that
    /// means something else here.
    public bindInferredParam(
      &self,
      symbol: Symbol,
      actualType: Analyzer::TypeId,
      paramSymbols: &Vector<Symbol>,
      bindings: &mut Vector<Option<Analyzer::TypeId>>,
    ): boolean {
      let mut index: u64 = 0;

      while (index < paramSymbols.length()) {
        let Option::SOME(paramSymbol) = paramSymbols.get(index) else {
          index += 1;
          continue;
        };

        if (paramSymbol.raw() != symbol.raw()) {
          index += 1;
          continue;
        }

        let Option::SOME(existing) = bindings.get(index) else {
          return false;
        };

        if (let Option::SOME(alreadyBound) = existing) {
          return alreadyBound.raw() == actualType.raw();
        }

        let mut bindingsRef: &mut Vector<Option<Analyzer::TypeId>> = bindings;
        return bindingsRef.set(index, Option::SOME(actualType));
      }

      return false;
    }

    /// Substitutes every `Param(sym)` occurrence reachable from `typeId` with the
    /// corresponding entry of `args`, matched positionally against `params`.
    ///
    /// Substitution is keyed by Symbol, which is globally text-interned
    /// (SymbolTable.intern -> StringInterner). This is sound ONLY because
    /// resolver.ign:buildTypeParamScope never lets a field-type annotation name a
    /// generic parameter outside its own item's scope, so inside one record's field
    /// types Param(Symbol("T")) can only mean that record's own T.
    /// INVARIANT: never memoize substitution results keyed on Symbol across
    /// different owning records.
    ///
    /// Returns `typeId` unchanged when `params.length() != args.length()`.
    ///
    /// Known parity gap (matches the Rust reference): `Alias` is not followed,
    /// so a generic alias whose `aliasedType` carries `Param` is not substituted.
    public substitute(
      &mut self,
      typeId: Analyzer::TypeId,
      params: &Vector<Symbol>,
      args: &Vector<Analyzer::TypeId>,
    ): Analyzer::TypeId {
      if (params.length() != args.length()) {
        return typeId;
      }

      let Option::SOME(kind) = self.types.get(typeId) else {
        return typeId;
      };

      match (kind) {
        Analyzer::Type::I8 -> { return typeId; },
        Analyzer::Type::I16 -> { return typeId; },
        Analyzer::Type::I32 -> { return typeId; },
        Analyzer::Type::I64 -> { return typeId; },
        Analyzer::Type::U8 -> { return typeId; },
        Analyzer::Type::U16 -> { return typeId; },
        Analyzer::Type::U32 -> { return typeId; },
        Analyzer::Type::U64 -> { return typeId; },
        Analyzer::Type::F32 -> { return typeId; },
        Analyzer::Type::F64 -> { return typeId; },
        Analyzer::Type::BOOLEAN -> { return typeId; },
        Analyzer::Type::CHAR -> { return typeId; },
        Analyzer::Type::STR -> { return typeId; },
        Analyzer::Type::VOID -> { return typeId; },
        Analyzer::Type::NEVER -> { return typeId; },
        Analyzer::Type::ATOM -> { return typeId; },
        Analyzer::Type::Record(_) -> { return typeId; },
        Analyzer::Type::Enum(_) -> { return typeId; },
        Analyzer::Type::Alias(_) -> { return typeId; },
        Analyzer::Type::Pointer(p) -> {
          let substitutedPointee: Analyzer::TypeId = self.substitute(p.pointee, params, args);

          if (substitutedPointee.raw() == p.pointee.raw()) {
            return typeId;
          }

          if (p.mutable) {
            return self.mutablePointer(substitutedPointee);
          }

          return self.pointer(substitutedPointee);
        },
        Analyzer::Type::Reference(r) -> {
          let substitutedReferent: Analyzer::TypeId = self.substitute(r.referent, params, args);

          if (substitutedReferent.raw() == r.referent.raw()) {
            return typeId;
          }

          if (r.mutable) {
            return self.mutableReference(substitutedReferent);
          }

          return self.reference(substitutedReferent);
        },
        Analyzer::Type::Slice(element) -> {
          let substitutedElement: Analyzer::TypeId = self.substitute(element, params, args);

          if (substitutedElement.raw() == element.raw()) {
            return typeId;
          }

          return self.slice(substitutedElement);
        },
        Analyzer::Type::FixedArray(element, length) -> {
          let substitutedElement: Analyzer::TypeId = self.substitute(element, params, args);

          if (substitutedElement.raw() == element.raw()) {
            return typeId;
          }

          return self.fixedArray(substitutedElement, length);
        },
        Analyzer::Type::Tuple(t) -> {
          let mut changed: boolean = false;
          let mut newElements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < t.elements.length()) {
            let Option::SOME(elementId) = t.elements.get(index) else {
              index += 1;
              continue;
            };

            let substitutedElement: Analyzer::TypeId = self.substitute(*elementId, params, args);

            if (substitutedElement.raw() != elementId.raw()) {
              changed = true;
            }

            newElements.push(substitutedElement);
            index += 1;
          }

          if (changed) {
            return self.tuple(newElements);
          }

          return typeId;
        },
        Analyzer::Type::Function(f) -> {
          let mut changed: boolean = false;
          let mut newParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < f.params.length()) {
            let Option::SOME(paramTypeId) = f.params.get(index) else {
              index += 1;
              continue;
            };

            let substitutedParam: Analyzer::TypeId = self.substitute(*paramTypeId, params, args);

            if (substitutedParam.raw() != paramTypeId.raw()) {
              changed = true;
            }

            newParams.push(substitutedParam);
            index += 1;
          }

          let substitutedReturnType: Analyzer::TypeId = self.substitute(f.returnType, params, args);

          if (substitutedReturnType.raw() != f.returnType.raw()) {
            changed = true;
          }

          if (changed) {
            return self.functionType(newParams, substitutedReturnType);
          }

          return typeId;
        },
        Analyzer::Type::Param(symbol) -> {
          let mut index: u64 = 0;

          while (index < params.length()) {
            let Option::SOME(paramSymbol) = params.get(index) else {
              index += 1;
              continue;
            };

            if (paramSymbol.raw() == symbol.raw()) {
              let Option::SOME(argTypeId) = args.get(index) else {
                return typeId;
              };

              return *argTypeId;
            }

            index += 1;
          }

          return typeId;
        },
        Analyzer::Type::Instance(instance) -> {
          let mut changed: boolean = false;
          let mut newTypeArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < instance.typeArguments.length()) {
            let Option::SOME(typeArgumentId) = instance.typeArguments.get(index) else {
              index += 1;
              continue;
            };

            let substitutedTypeArgument: Analyzer::TypeId = self.substitute(*typeArgumentId, params, args);

            if (substitutedTypeArgument.raw() != typeArgumentId.raw()) {
              changed = true;
            }

            newTypeArguments.push(substitutedTypeArgument);
            index += 1;
          }

          if (changed) {
            return self.instance(instance.definition, newTypeArguments);
          }

          return typeId;
        },
      };

      @panic("unreachable: substitute match did not return");
    }

    /// Formats a tuple type as a comma-separated parenthesized list.
    /// Empty tuple -> "()", single element -> "(i32)", multiple -> "(i32, str)".
    private tupleNameOf(&self, elements: &Vector<Analyzer::TypeId>): String {
      if (elements.length() == 0) {
        return String::create("()");
      }

      let mut result: String = String::create("(");
      let mut index: u64 = 0;

      while (index < elements.length()) {
        let Option::SOME(elementId) = elements.get(index) else {
          index += 1;
          continue;
        };

        if (index > 0) {
          result = result.concat(", ");
        }

        result = result.concat(self.nameOf(*elementId).toStr());

        index += 1;
      }

      return result.concat(")");
    }

    /// Formats a pointer type as "*T" when immutable, "*mut T" when mutable.
    /// Recurses through nameOf for the pointee name.
    private pointerNameOf(&self, ptrType: &Analyzer::PointerType): String {
      if (ptrType.mutable) {
        return `*mut ${self.nameOf(ptrType.pointee).toStr()}`;
      }

      return `*${self.nameOf(ptrType.pointee).toStr()}`;
    }

    /// Formats a reference type as "&T" when immutable, "&mut T" when mutable.
    /// Recurses through nameOf for the referent name.
    private referenceNameOf(&self, refType: &Analyzer::ReferenceType): String {
      if (refType.mutable) {
        return `&mut ${self.nameOf(refType.referent).toStr()}`;
      }

      return `&${self.nameOf(refType.referent).toStr()}`;
    }

    /// Formats a function type as "fn(p1, p2) -> r".
    /// Empty params produce "fn() -> r". Parameters are joined with ", ".
    /// Recurses through nameOf for each param and the return type.
    private functionNameOf(&self, fn_: &Analyzer::FunctionType): String {
      let mut result: String = String::create("fn(");
      let mut index: u64 = 0;

      while (index < fn_.params.length()) {
        let Option::SOME(paramId) = fn_.params.get(index) else {
          index += 1;
          continue;
        };

        if (index > 0) {
          result = result.concat(", ");
        }

        result = result.concat(self.nameOf(*paramId).toStr());

        index += 1;
      }

      result = result.concat(") -> ");
      result = result.concat(self.nameOf(fn_.returnType).toStr());

      return result;
    }

    /// Recursively resolves a `TypeId` to its canonical string name.
    ///
    /// For primitive ids, delegates to `Analyzer::Type::name()`.
    /// For compound ids, builds the name string by recursing through the inner id(s).
    /// Panics if the id is not present in the store.
    ///
    /// For user-facing diagnostics that need real nominal names (record, enum,
    /// type parameter names from source), use `nameOfResolved` instead.
    public nameOf(&self, id: Analyzer::TypeId): String {
      if (let Option::SOME(type_) = self.types.get(id)) {
        return match (type_) {
          Analyzer::Type::I8 -> String::create(type_.name()),
          Analyzer::Type::I16 -> String::create(type_.name()),
          Analyzer::Type::I32 -> String::create(type_.name()),
          Analyzer::Type::I64 -> String::create(type_.name()),
          Analyzer::Type::U8 -> String::create(type_.name()),
          Analyzer::Type::U16 -> String::create(type_.name()),
          Analyzer::Type::U32 -> String::create(type_.name()),
          Analyzer::Type::U64 -> String::create(type_.name()),
          Analyzer::Type::F32 -> String::create(type_.name()),
          Analyzer::Type::F64 -> String::create(type_.name()),
          Analyzer::Type::BOOLEAN -> String::create(type_.name()),
          Analyzer::Type::CHAR -> String::create(type_.name()),
          Analyzer::Type::STR -> String::create(type_.name()),
          Analyzer::Type::VOID -> String::create(type_.name()),
          Analyzer::Type::NEVER -> String::create(type_.name()),
          Analyzer::Type::ATOM -> String::create(type_.name()),
          Analyzer::Type::Pointer(p) -> self.pointerNameOf(&p),
          Analyzer::Type::Reference(refType) -> self.referenceNameOf(&refType),
          Analyzer::Type::Slice(element) -> self.nameOf(element).concat("[]"),
          Analyzer::Type::FixedArray(element, length) -> self.nameOf(element).concat("[").concat(String::create(length).toStr()).concat("]"),
          Analyzer::Type::Tuple(t) -> self.tupleNameOf(&t.elements),
          Analyzer::Type::Function(f) -> self.functionNameOf(&f),
          Analyzer::Type::Record(defId) -> `<record:DefId(${String::create(defId.raw()).toStr()})>`,
          Analyzer::Type::Enum(defId) -> `<enum:DefId(${String::create(defId.raw()).toStr()})>`,
          Analyzer::Type::Param(symbol) -> `<param:Symbol(${String::create(symbol.raw()).toStr()})>`,
          Analyzer::Type::Instance(instance) -> self.instanceNameOf(&instance),
          Analyzer::Type::Alias(defId) -> `<alias:DefId(${String::create(defId.raw()).toStr()})>`,
        };
      }

      @panic("TypeStore::nameOf: unknown TypeId");
    }

    /// Formats an instance type as "<instance:DefId(N)<arg1, arg2>>" using
    /// the same definition-id placeholder as Record/Enum until the
    /// DefinitionStore/SymbolTable threading lands.
    private instanceNameOf(&self, instance: &Analyzer::InstanceType): String {
      let mut result: String = `<instance:DefId(${String::create(instance.definition.raw()).toStr()})<`;

      let mut index: u64 = 0;
      while (index < instance.typeArguments.length()) {
        let Option::SOME(argId) = instance.typeArguments.get(index) else {
          index += 1;
          continue;
        };

        if (index > 0) {
          result = result.concat(", ");
        }

        result = result.concat(self.nameOf(*argId).toStr());
        index += 1;
      }

      return result.concat(">>");
    }

    /// Resolves the real name of a record definition. On lookup miss or wrong
    /// definition kind, falls back to the `<record:DefId(N)>` placeholder.
    private recordNameOfResolved(
      &self,
      defId: Analyzer::DefinitionId,
      defs: &Analyzer::DefinitionStore,
      syms: &Analyzer::SymbolTable,
    ): String {
      let fallback: String = `<record:DefId(${String::create(defId.raw()).toStr()})>`;

      if (let Option::SOME(def) = defs.get(defId)) {
        return match (def) {
          Analyzer::Definition::Record(rec) -> match (syms.resolve(rec.name)) {
            Option::SOME(name) -> String::create(name),
            Option::NONE -> fallback,
          },
          Analyzer::Definition::Function(_) -> fallback,
          Analyzer::Definition::Method(_) -> fallback,
          Analyzer::Definition::Enum(_) -> fallback,
          Analyzer::Definition::Variable(_) -> fallback,
          Analyzer::Definition::Field(_) -> fallback,
          Analyzer::Definition::Variant(_) -> fallback,
          Analyzer::Definition::TypeParam(_) -> fallback,
          Analyzer::Definition::TypeAlias(_) -> fallback,
          Analyzer::Definition::Trait(_) -> fallback,
        };
      }

      return fallback;
    }

    /// Resolves the real name of an enum definition. On lookup miss or wrong
    /// definition kind, falls back to the `<enum:DefId(N)>` placeholder.
    private enumNameOfResolved(
      &self,
      defId: Analyzer::DefinitionId,
      defs: &Analyzer::DefinitionStore,
      syms: &Analyzer::SymbolTable,
    ): String {
      let fallback: String = `<enum:DefId(${String::create(defId.raw()).toStr()})>`;

      if (let Option::SOME(def) = defs.get(defId)) {
        return match (def) {
          Analyzer::Definition::Enum(e) -> match (syms.resolve(e.name)) {
            Option::SOME(name) -> String::create(name),
            Option::NONE -> fallback,
          },
          Analyzer::Definition::Function(_) -> fallback,
          Analyzer::Definition::Method(_) -> fallback,
          Analyzer::Definition::Record(_) -> fallback,
          Analyzer::Definition::Variable(_) -> fallback,
          Analyzer::Definition::Field(_) -> fallback,
          Analyzer::Definition::Variant(_) -> fallback,
          Analyzer::Definition::TypeParam(_) -> fallback,
          Analyzer::Definition::TypeAlias(_) -> fallback,
          Analyzer::Definition::Trait(_) -> fallback,
        };
      }

      return fallback;
    }

    /// Formats a tuple type as a comma-separated parenthesized list, using
    /// `nameOfResolved` for each element to produce real nominal names.
    private tupleNameOfResolved(
      &self,
      elements: &Vector<Analyzer::TypeId>,
      defs: &Analyzer::DefinitionStore,
      syms: &Analyzer::SymbolTable,
    ): String {
      if (elements.length() == 0) {
        return String::create("()");
      }

      let mut result: String = String::create("(");
      let mut index: u64 = 0;

      while (index < elements.length()) {
        let Option::SOME(elementId) = elements.get(index) else {
          index += 1;
          continue;
        };

        if (index > 0) {
          result = result.concat(", ");
        }

        result = result.concat(self.nameOfResolved(*elementId, defs, syms).toStr());

        index += 1;
      }

      return result.concat(")");
    }

    /// Formats a pointer type as "*T" or "*mut T", using `nameOfResolved`
    /// for the pointee to produce real nominal names.
    private pointerNameOfResolved(
      &self,
      ptrType: &Analyzer::PointerType,
      defs: &Analyzer::DefinitionStore,
      syms: &Analyzer::SymbolTable,
    ): String {
      if (ptrType.mutable) {
        return `*mut ${self.nameOfResolved(ptrType.pointee, defs, syms).toStr()}`;
      }

      return `*${self.nameOfResolved(ptrType.pointee, defs, syms).toStr()}`;
    }

    /// Formats a reference type as "&T" or "&mut T", using `nameOfResolved`
    /// for the referent to produce real nominal names.
    private referenceNameOfResolved(
      &self,
      refType: &Analyzer::ReferenceType,
      defs: &Analyzer::DefinitionStore,
      syms: &Analyzer::SymbolTable,
    ): String {
      if (refType.mutable) {
        return `&mut ${self.nameOfResolved(refType.referent, defs, syms).toStr()}`;
      }

      return `&${self.nameOfResolved(refType.referent, defs, syms).toStr()}`;
    }

    /// Formats a function type as "fn(p1, p2) -> r", using `nameOfResolved`
    /// for each parameter and the return type to produce real nominal names.
    private functionNameOfResolved(
      &self,
      fn_: &Analyzer::FunctionType,
      defs: &Analyzer::DefinitionStore,
      syms: &Analyzer::SymbolTable,
    ): String {
      let mut result: String = String::create("fn(");
      let mut index: u64 = 0;

      while (index < fn_.params.length()) {
        let Option::SOME(paramId) = fn_.params.get(index) else {
          index += 1;
          continue;
        };

        if (index > 0) {
          result = result.concat(", ");
        }

        result = result.concat(self.nameOfResolved(*paramId, defs, syms).toStr());

        index += 1;
      }

      result = result.concat(") -> ");
      result = result.concat(self.nameOfResolved(fn_.returnType, defs, syms).toStr());

      return result;
    }

    /// Formats an instance type with real nominal name resolved from `defs` and
    /// `syms`. Produces `Name<arg1, arg2>` for non-empty type arguments; bare
    /// `Name` when empty. Falls back to `<instance:DefId(N)<args>>` on lookup miss.
    private instanceNameOfResolved(
      &self,
      inst: &Analyzer::InstanceType,
      defs: &Analyzer::DefinitionStore,
      syms: &Analyzer::SymbolTable,
    ): String {
      let nominalName: String = match (defs.get(inst.definition)) {
        Option::NONE -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
        Option::SOME(def) -> match (def) {
          Analyzer::Definition::Record(rec) -> match (syms.resolve(rec.name)) {
            Option::SOME(name) -> String::create(name),
            Option::NONE -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          },
          Analyzer::Definition::Enum(e) -> match (syms.resolve(e.name)) {
            Option::SOME(name) -> String::create(name),
            Option::NONE -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          },
          Analyzer::Definition::Function(_) -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          Analyzer::Definition::Variable(_) -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          Analyzer::Definition::Field(_) -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          Analyzer::Definition::Variant(_) -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          Analyzer::Definition::TypeParam(_) -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          Analyzer::Definition::Method(_) -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          Analyzer::Definition::TypeAlias(_) -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
          Analyzer::Definition::Trait(_) -> `<instance:DefId(${String::create(inst.definition.raw()).toStr()})>`,
        },
      };

      if (inst.typeArguments.length() == 0) {
        return nominalName;
      }

      let mut result: String = nominalName.concat("<");
      let mut index: u64 = 0;

      while (index < inst.typeArguments.length()) {
        let Option::SOME(argId) = inst.typeArguments.get(index) else {
          index += 1;
          continue;
        };

        if (index > 0) {
          result = result.concat(", ");
        }

        result = result.concat(self.nameOfResolved(*argId, defs, syms).toStr());

        index += 1;
      }

      return result.concat(">");
    }

    /// Recursively resolves a `TypeId` to a human-readable name by consulting
    /// `defs` and `syms` for nominal types (records, enums, type parameters).
    ///
    /// Unlike `nameOf`, this method never panics: all unknown-id paths return
    /// a deterministic placeholder string. Prefer this method for any
    /// user-facing diagnostic output that must show real source-level names.
    public nameOfResolved(
      &self,
      id: Analyzer::TypeId,
      defs: &Analyzer::DefinitionStore,
      syms: &Analyzer::SymbolTable,
    ): String {
      if (let Option::SOME(type_) = self.types.get(id)) {
        return match (type_) {
          Analyzer::Type::I8 -> String::create(type_.name()),
          Analyzer::Type::I16 -> String::create(type_.name()),
          Analyzer::Type::I32 -> String::create(type_.name()),
          Analyzer::Type::I64 -> String::create(type_.name()),
          Analyzer::Type::U8 -> String::create(type_.name()),
          Analyzer::Type::U16 -> String::create(type_.name()),
          Analyzer::Type::U32 -> String::create(type_.name()),
          Analyzer::Type::U64 -> String::create(type_.name()),
          Analyzer::Type::F32 -> String::create(type_.name()),
          Analyzer::Type::F64 -> String::create(type_.name()),
          Analyzer::Type::BOOLEAN -> String::create(type_.name()),
          Analyzer::Type::CHAR -> String::create(type_.name()),
          Analyzer::Type::STR -> String::create(type_.name()),
          Analyzer::Type::VOID -> String::create(type_.name()),
          Analyzer::Type::NEVER -> String::create(type_.name()),
          Analyzer::Type::ATOM -> String::create(type_.name()),
          Analyzer::Type::Pointer(p) -> self.pointerNameOfResolved(&p, defs, syms),
          Analyzer::Type::Reference(refType) -> self.referenceNameOfResolved(&refType, defs, syms),
          Analyzer::Type::Slice(element) -> self.nameOfResolved(element, defs, syms).concat("[]"),
          Analyzer::Type::FixedArray(element, length) -> self.nameOfResolved(element, defs, syms)
            .concat("[")
            .concat(String::create(length).toStr())
            .concat("]"),
          Analyzer::Type::Tuple(t) -> self.tupleNameOfResolved(&t.elements, defs, syms),
          Analyzer::Type::Function(f) -> self.functionNameOfResolved(&f, defs, syms),
          Analyzer::Type::Record(defId) -> self.recordNameOfResolved(defId, defs, syms),
          Analyzer::Type::Enum(defId) -> self.enumNameOfResolved(defId, defs, syms),
          Analyzer::Type::Param(symbol) -> match (syms.resolve(symbol)) {
            Option::SOME(name) -> String::create(name),
            Option::NONE -> `<param:Symbol(${String::create(symbol.raw()).toStr()})>`,
          },
          Analyzer::Type::Instance(inst) -> self.instanceNameOfResolved(&inst, defs, syms),
          Analyzer::Type::Alias(defId) -> `<alias:DefId(${String::create(defId.raw()).toStr()})>`,
        };
      }

      return `<unknown-type:TypeId(${String::create(id.raw()).toStr()})>`;
    }

    public get(&self, id: Analyzer::TypeId): Option<&Analyzer::Type> {
      return self.types.get(id);
    }

    public length(&self): u64 {
      return self.types.length();
    }
  }
}
