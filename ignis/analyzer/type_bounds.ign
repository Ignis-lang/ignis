import
  Diagnostic,
  DiagnosticBag,
  DiagnosticCode,
  LabelKind,
  Severity,
  SourceSpan,
from "@compiler::diagnostics";

import _ from "./view_type";

export namespace Analyzer {
  /// The type-level half of generic bound checking: whether the type
  /// arguments of an instance, or of a call, satisfy the bounds of the type
  /// parameters they bind. `Bounds` applies it to the types lowered bodies
  /// meet; the typechecker applies it to declared field, payload and
  /// signature types, which no body has to mention.
  namespace TypeBounds {
    /// Checks every generic record or enum instantiated anywhere inside the
    /// type, including through references, pointers, tuples and the type
    /// arguments of another instance.
    function checkType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      enclosing: Analyzer::DefinitionId,
      root: Analyzer::TypeId,
      span: SourceSpan,
      diagnostics: &mut DiagnosticBag,
    ): void {
      let mut pending: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      pending.push(root);

      while (pending.length() > 0) {
        let Option::SOME(typeId) = pending.pop() else {
          break;
        };

        let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

        if (resolved.cycleAlias.isSome()) {
          continue;
        }

        let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
          continue;
        };

        let mut instanceDefId: Option<Analyzer::DefinitionId> = Option::NONE;
        let mut components: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

        match (type_) {
          Analyzer::Type::Pointer(pointer) -> {
            components.push(pointer.pointee);
          },
          Analyzer::Type::Reference(reference) -> {
            components.push(reference.referent);
          },
          Analyzer::Type::Slice(element) -> {
            components.push(element);
          },
          Analyzer::Type::FixedArray(element, _) -> {
            components.push(element);
          },
          Analyzer::Type::Tuple(tuple) -> {
            components = Analyzer::TypeBounds::copyTypeIds(&tuple.elements);
          },
          Analyzer::Type::Function(function_) -> {
            components = Analyzer::TypeBounds::copyTypeIds(&function_.params);
            components.push(function_.returnType);
          },
          Analyzer::Type::RawFunction(function_) -> {
            components = Analyzer::TypeBounds::copyTypeIds(&function_.params);
            components.push(function_.returnType);
          },
          Analyzer::Type::Instance(instance) -> {
            instanceDefId = Option::SOME(instance.definition);
            components = Analyzer::TypeBounds::copyTypeIds(&instance.typeArguments);
          },
          _ -> {},
        };

        if (let Option::SOME(definition) = instanceDefId) {
          let params: Vector<Analyzer::DefinitionId> = Analyzer::TypeBounds::declaredTypeParams(defStore, definition);

          if (params.length() == components.length()) {
            Analyzer::TypeBounds::checkArguments(defStore, typeStore, symbols, enclosing, definition, &params, &components, false, span, diagnostics);
          }
        }

        let mut index: u64 = 0;

        while (index < components.length()) {
          if (let Option::SOME(component) = components.get(index)) {
            pending.push(*component);
          }

          index += 1;
        }
      }
    }

    /// Reports each bound of `params` that the type argument at the same
    /// position does not satisfy.
    function checkArguments(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      enclosing: Analyzer::DefinitionId,
      generic: Analyzer::DefinitionId,
      params: &Vector<Analyzer::DefinitionId>,
      typeArgs: &Vector<Analyzer::TypeId>,
      acceptFunctions: boolean,
      span: SourceSpan,
      diagnostics: &mut DiagnosticBag,
    ): void {
      let mut index: u64 = 0;

      while (index < params.length()) {
        let Option::SOME(paramDefId) = params.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(typeArg) = typeArgs.get(index) else {
          index += 1;
          continue;
        };

        let mut paramName: Option<Analyzer::SymbolId> = Option::NONE;
        let mut bounds: Vector<String> = Vector::new<String>();
        let mut ownsStorage: boolean = false;

        if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*paramDefId)) {
          paramName = Option::SOME(typeParam.name);
          bounds = Analyzer::TypeBounds::copyStrings(&typeParam.bounds);
          ownsStorage = typeParam.ownsStorage;
        }

        // An `@owns` parameter is an owning storage slot: the declaring type
        // keeps the argument in storage it allocates or in a field, where the
        // type system cannot see whose bytes a view borrows. A view argument
        // is therefore rejected here, at every instantiation (L17).
        if (ownsStorage) {
          let resolvedArgument: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, *typeArg);

          if (resolvedArgument.cycleAlias.isNone() && Analyzer::ViewType::isView(defStore, typeStore, resolvedArgument.typeId)) {
            Analyzer::TypeBounds::reportViewInOwningSlot(defStore, typeStore, symbols, generic, paramName, resolvedArgument.typeId, span, diagnostics);
          }
        }

        let boundTraits: Vector<Option<Analyzer::DefinitionId>> = defStore.traitReferencesOf(*paramDefId);
        let mut boundIndex: u64 = 0;

        while (boundIndex < bounds.length()) {
          if (let Option::SOME(bound) = bounds.get(boundIndex)) {
            let boundTrait: Option<Analyzer::DefinitionId> = Analyzer::TypeBounds::traitAt(&boundTraits, boundIndex);

            if (!Analyzer::TypeBounds::satisfies(defStore, typeStore, symbols, enclosing, *typeArg, bound, boundTrait, acceptFunctions)) {
              let boundText: String = Analyzer::TypeBounds::traitDisplayName(defStore, bound, boundTrait);
              let mut writtenText: String = bound.clone();

              if (let Option::SOME(traitId) = boundTrait) {
                writtenText = Analyzer::TypeBounds::publishedPath(defStore, bound, traitId);
              }

              Analyzer::TypeBounds::reportUnsatisfied(defStore, typeStore, symbols, generic, paramName, boundText.toStr(), writtenText.toStr(), *typeArg, span, diagnostics);
            }
          }

          boundIndex += 1;
        }

        index += 1;
      }
    }

    /// Reports a view type argument bound to an `@owns` parameter (A0265).
    function reportViewInOwningSlot(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      generic: Analyzer::DefinitionId,
      paramName: Option<Analyzer::SymbolId>,
      typeArg: Analyzer::TypeId,
      span: SourceSpan,
      diagnostics: &mut DiagnosticBag,
    ): void {
      let typeName: String = typeStore.nameOfResolved(typeArg, &*defStore, &*symbols);
      let mut genericName: str = "?";
      let mut parameter: str = "?";

      if (let Option::SOME(definition) = defStore.get(generic)) {
        if (let Option::SOME(name) = symbols.resolve(definition.name())) {
          genericName = name;
        }
      }

      if (let Option::SOME(paramSymbol) = paramName) {
        if (let Option::SOME(name) = symbols.resolve(paramSymbol)) {
          parameter = name;
        }
      }

      let message: String = `type '${typeName.toStr()}' is a view and cannot be stored in '${genericName}': its parameter '${parameter}' owns its storage (@owns)`;
      let label: String = `'${typeName.toStr()}' borrows storage it does not own; store an owned type here, such as a 'String' or a 'static str'`;

      let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::VIEW_IN_OWNING_SLOT, message.toStr(), span);
      diagnostic.addLabel(LabelKind::PRIMARY, span, label.toStr());

      let mut bag: &mut DiagnosticBag = diagnostics;
      bag.push(diagnostic);
    }

    /// The trait the name at `index` resolved to, `NONE` when it named no
    /// trait or was never resolved.
    function traitAt(
      references: &Vector<Option<Analyzer::DefinitionId>>,
      index: u64,
    ): Option<Analyzer::DefinitionId> {
      return match (references.get(index)) {
        Option::SOME(reference) -> *reference,
        Option::NONE -> Option::NONE,
      };
    }

    /// How a diagnostic names a trait: the path it is published under in its
    /// module, prefixed with the module's path when another trait of the
    /// program is published under the same path, as the `Hash` traits of
    /// `std::hash` and `std::collections` are. `name` when the trait is
    /// unresolved or has no recorded path.
    function traitDisplayName(
      defStore: &mut Analyzer::DefinitionStore,
      name: &String,
      traitId: Option<Analyzer::DefinitionId>,
    ): String {
      let Option::SOME(resolved) = traitId else {
        return name.clone();
      };

      let qualified: String = Analyzer::TypeBounds::publishedPath(defStore, name, resolved);
      let mut traitSymbol: Option<Analyzer::SymbolId> = Option::NONE;

      if (let Option::SOME(Analyzer::Definition::Trait(trait_)) = defStore.get(resolved)) {
        traitSymbol = Option::SOME(trait_.name);
      }

      let Option::SOME(symbol) = traitSymbol else {
        return qualified;
      };

      let candidates: Vector<Analyzer::DefinitionId> = defStore.definitionsNamed(symbol);
      let mut shared: boolean = false;
      let mut index: u64 = 0;

      while (index < candidates.length()) {
        if (let Option::SOME(candidate) = candidates.get(index)) {
          if (candidate.raw() != resolved.raw()) {
            if (let Option::SOME(Analyzer::Definition::Trait(_)) = defStore.get(*candidate)) {
              let other: String = Analyzer::TypeBounds::publishedPath(defStore, name, *candidate);

              if (other.equals(qualified.toStr())) {
                shared = true;
              }
            }
          }
        }

        index += 1;
      }

      if (!shared) {
        return qualified;
      }

      let Option::SOME(moduleIndex) = defStore.defModuleOf(resolved) else {
        return qualified;
      };

      let Option::SOME(moduleName) = defStore.moduleDisplayNameOf(moduleIndex) else {
        return qualified;
      };

      return `${moduleName.toStr()}::${qualified.toStr()}`;
    }

    /// The path `traitId` is published under in its module, or `name`.
    function publishedPath(
      defStore: &mut Analyzer::DefinitionStore,
      name: &String,
      traitId: Analyzer::DefinitionId,
    ): String {
      if (let Option::SOME(qualified) = defStore.qualifiedNameOf(traitId)) {
        if (qualified.length() > 0) {
          return qualified.clone();
        }
      }

      return name.clone();
    }

    /// Whether `typeArg`, seen from inside `enclosing`, satisfies the bound
    /// named `bound`. A bound that resolved to a trait, `boundTrait`, is met
    /// only by a declaration naming that same trait; an unresolved bound, such
    /// as a lang trait, is matched by name.
    function satisfies(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      enclosing: Analyzer::DefinitionId,
      typeArg: Analyzer::TypeId,
      bound: &String,
      boundTrait: Option<Analyzer::DefinitionId>,
      acceptFunctions: boolean,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeArg);

      // A cyclic alias is reported where it is declared.
      if (resolved.cycleAlias.isSome()) {
        return true;
      }

      if (bound.equals("Send") || bound.equals("Sync")) {
        // A function type says nothing about what a closure captured. A call
        // argument is judged by `checkClosureCaptures` once captures are known.
        if (acceptFunctions && Analyzer::TypeBounds::isFunctionType(defStore, typeStore, resolved.typeId)) {
          return true;
        }

        let scope: Vector<Analyzer::DefinitionId> = Analyzer::Typecheck::typeParamsInScope(defStore, enclosing);
        let mut visited: Vector<u32> = Vector::new<u32>();
        return Analyzer::Typecheck::isThreadSafeType(defStore, typeStore, resolved.typeId, bound.equals("Sync"), &scope, &mut visited);
      }

      if (bound.equals("Copy")) {
        if (Analyzer::Typecheck::isCopyType(defStore, typeStore, resolved.typeId)) {
          return true;
        }
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return true;
      };

      let mut paramSymbol: Option<Analyzer::SymbolId> = Option::NONE;
      let mut nominal: Option<Analyzer::DefinitionId> = Option::NONE;
      let mut structural: boolean = false;

      match (type_) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64
        | Analyzer::Type::BOOLEAN
        | Analyzer::Type::CHAR
        | Analyzer::Type::STR
        | Analyzer::Type::STATIC_STR -> {
          structural = bound.equals("Eq") || bound.equals("Hash");
        },
        Analyzer::Type::Param(symbol) -> {
          paramSymbol = Option::SOME(symbol);
        },
        Analyzer::Type::Record(definition) -> {
          nominal = Option::SOME(definition);
        },
        Analyzer::Type::Enum(definition) -> {
          nominal = Option::SOME(definition);
        },
        Analyzer::Type::Instance(instance) -> {
          nominal = Option::SOME(instance.definition);
        },
        _ -> {},
      };

      if (structural) {
        return true;
      }

      if (let Option::SOME(symbol) = paramSymbol) {
        return Analyzer::TypeBounds::typeParamDeclares(defStore, enclosing, symbol, bound.toStr(), boundTrait);
      }

      if (let Option::SOME(definition) = nominal) {
        if (Analyzer::TypeBounds::declaresImplements(defStore, definition, bound.toStr(), boundTrait)) {
          return true;
        }
      }

      let Option::SOME(traitId) = boundTrait else {
        return false;
      };

      return Analyzer::TypeBounds::extensionImplements(defStore, typeStore, symbols, enclosing, resolved.typeId, traitId);
    }

    /// One extension block that applies to a type, with what the block's own
    /// type parameters stand for in it.
    record ExtensionMatch {
      public extension: Analyzer::DefinitionId;
      public typeArguments: Vector<Analyzer::TypeId>;
    }

    /// Every extension block whose target is `typeId`: the same primitive,
    /// record, enum or instance, or, for a generic block, an instance of the
    /// same declaration, whose arguments the block's parameters then stand
    /// for. A block over one concrete instance, `extension Vector<u8>`, applies
    /// to that instance only. A `static str` takes the blocks of `str`, which
    /// it converts to.
    function extensionsFor(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Vector<Analyzer::TypeBounds::ExtensionMatch> {
      let mut matches: Vector<Analyzer::TypeBounds::ExtensionMatch> = Vector::new<Analyzer::TypeBounds::ExtensionMatch>();
      let blocks: Vector<Analyzer::DefinitionId> = defStore.extensionBlocks();

      if (blocks.length() == 0) {
        return matches;
      }

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      let mut wanted: Analyzer::TypeId = resolved.typeId;
      let mut instanceDef: Option<Analyzer::DefinitionId> = Option::NONE;
      let mut instanceArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut isStaticStr: boolean = false;

      if (let Option::SOME(node) = typeStore.get(wanted)) {
        match (node) {
          Analyzer::Type::Instance(instance) -> {
            instanceDef = Option::SOME(instance.definition);
            instanceArguments = Analyzer::TypeBounds::copyTypeIds(&instance.typeArguments);
          },
          Analyzer::Type::STATIC_STR -> {
            isStaticStr = true;
          },
          _ -> {},
        };
      }

      if (isStaticStr) {
        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        wanted = typeStoreRef.intern(Analyzer::Type::STR);
      }

      let mut index: u64 = 0;

      while (index < blocks.length()) {
        let Option::SOME(block) = blocks.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(target) = defStore.extensionTargetOf(*block) else {
          index += 1;
          continue;
        };

        if (target.raw() == wanted.raw()) {
          matches.push(Analyzer::TypeBounds::ExtensionMatch {
            extension: *block,
            typeArguments: Vector::new<Analyzer::TypeId>(),
          });
        } else if (let Option::SOME(definition) = instanceDef) {
          let generic: boolean = Analyzer::TypeBounds::declaredTypeParams(defStore, *block).length() > 0;

          if (let Option::SOME(Analyzer::Type::Instance(targetInstance)) = typeStore.get(target)) {
            if (generic && targetInstance.definition.raw() == definition.raw() && targetInstance.typeArguments.length() == instanceArguments.length()) {
              matches.push(Analyzer::TypeBounds::ExtensionMatch {
                extension: *block,
                typeArguments: Analyzer::TypeBounds::copyTypeIds(&instanceArguments),
              });
            }
          }
        }

        index += 1;
      }

      return matches;
    }

    /// Whether an extension block implements the trait `traitId` for
    /// `typeId`. A generic block applies only where its arguments satisfy the
    /// bounds of its own type parameters.
    function extensionImplements(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      enclosing: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
      traitId: Analyzer::DefinitionId,
    ): boolean {
      let matches: Vector<Analyzer::TypeBounds::ExtensionMatch> = Analyzer::TypeBounds::extensionsFor(defStore, typeStore, typeId);
      let mut index: u64 = 0;

      while (index < matches.length()) {
        let Option::SOME(entry) = matches.get(index) else {
          index += 1;
          continue;
        };

        if (defStore.refersToTrait(entry.extension, traitId) && Analyzer::TypeBounds::extensionArgumentsSatisfy(defStore, typeStore, symbols, enclosing, entry)) {
          return true;
        }

        index += 1;
      }

      return false;
    }

    /// Whether the arguments a generic extension block is matched with
    /// satisfy the bounds its type parameters declare.
    function extensionArgumentsSatisfy(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      enclosing: Analyzer::DefinitionId,
      entry: &Analyzer::TypeBounds::ExtensionMatch,
    ): boolean {
      let parameters: Vector<Analyzer::DefinitionId> = Analyzer::TypeBounds::declaredTypeParams(defStore, entry.extension);
      let mut index: u64 = 0;

      while (index < parameters.length()) {
        let Option::SOME(parameter) = parameters.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(argument) = entry.typeArguments.get(index) else {
          index += 1;
          continue;
        };

        let mut bounds: Vector<String> = Vector::new<String>();

        if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*parameter)) {
          bounds = Analyzer::TypeBounds::copyStrings(&typeParam.bounds);
        }

        let references: Vector<Option<Analyzer::DefinitionId>> = defStore.traitReferencesOf(*parameter);
        let mut boundIndex: u64 = 0;

        while (boundIndex < bounds.length()) {
          if (let Option::SOME(bound) = bounds.get(boundIndex)) {
            let boundTrait: Option<Analyzer::DefinitionId> = Analyzer::TypeBounds::traitAt(&references, boundIndex);

            if (!Analyzer::TypeBounds::satisfies(defStore, typeStore, symbols, enclosing, *argument, bound, boundTrait, false)) {
              return false;
            }
          }

          boundIndex += 1;
        }

        index += 1;
      }

      return true;
    }

    /// Whether the type parameter named `symbol` in scope at `enclosing`
    /// declares `bound`: the trait `boundTrait` when it resolved, otherwise a
    /// bound of that name. A parameter that is not in scope cannot be judged
    /// here and is accepted rather than reported against the wrong declaration.
    function typeParamDeclares(
      defStore: &mut Analyzer::DefinitionStore,
      enclosing: Analyzer::DefinitionId,
      symbol: Analyzer::SymbolId,
      bound: str,
      boundTrait: Option<Analyzer::DefinitionId>,
    ): boolean {
      let scoped: Vector<Analyzer::DefinitionId> = Analyzer::Typecheck::typeParamsInScope(defStore, enclosing);
      let mut index: u64 = 0;

      while (index < scoped.length()) {
        if (let Option::SOME(paramDefId) = scoped.get(index)) {
          if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*paramDefId)) {
            if (typeParam.name.raw() == symbol.raw()) {
              if (let Option::SOME(traitId) = boundTrait) {
                if (defStore.refersToTrait(*paramDefId, traitId)) {
                  return true;
                }

                let references: Vector<Option<Analyzer::DefinitionId>> = defStore.traitReferencesOf(*paramDefId);
                return Analyzer::TypeBounds::containsUnresolvedName(&typeParam.bounds, &references, bound);
              }

              return Analyzer::TypeBounds::containsName(&typeParam.bounds, bound);
            }
          }
        }

        index += 1;
      }

      return true;
    }

    /// Whether the record or enum lists `bound` in its `@implements`: the
    /// trait `boundTrait` when it resolved, otherwise a trait of that name.
    function declaresImplements(
      defStore: &mut Analyzer::DefinitionStore,
      definition: Analyzer::DefinitionId,
      bound: str,
      boundTrait: Option<Analyzer::DefinitionId>,
    ): boolean {
      if (let Option::SOME(traitId) = boundTrait) {
        if (defStore.refersToTrait(definition, traitId)) {
          return true;
        }

        let references: Vector<Option<Analyzer::DefinitionId>> = defStore.traitReferencesOf(definition);

        return match (defStore.get(definition)) {
          Option::SOME(Analyzer::Definition::Record(record_)) -> Analyzer::TypeBounds::containsUnresolvedName(&record_.implementedTraits, &references, bound),
          Option::SOME(Analyzer::Definition::Enum(enum_)) -> Analyzer::TypeBounds::containsUnresolvedName(&enum_.implementedTraits, &references, bound),
          _ -> false,
        };
      }

      return match (defStore.get(definition)) {
        Option::SOME(Analyzer::Definition::Record(record_)) -> Analyzer::TypeBounds::containsName(&record_.implementedTraits, bound),
        Option::SOME(Analyzer::Definition::Enum(enum_)) -> Analyzer::TypeBounds::containsName(&enum_.implementedTraits, bound),
        _ -> false,
      };
    }

    /// The type parameters a record, enum or trait declares.
    function declaredTypeParams(
      defStore: &mut Analyzer::DefinitionStore,
      definition: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      return match (defStore.get(definition)) {
        Option::SOME(Analyzer::Definition::Record(record_)) -> Analyzer::TypeBounds::copyDefinitionIds(&record_.typeParams),
        Option::SOME(Analyzer::Definition::Enum(enum_)) -> Analyzer::TypeBounds::copyDefinitionIds(&enum_.typeParams),
        _ -> Vector::new<Analyzer::DefinitionId>(),
      };
    }

    function reportUnsatisfied(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      generic: Analyzer::DefinitionId,
      paramName: Option<Analyzer::SymbolId>,
      bound: str,
      written: str,
      typeArg: Analyzer::TypeId,
      span: SourceSpan,
      diagnostics: &mut DiagnosticBag,
    ): void {
      let typeName: String = typeStore.nameOfResolved(typeArg, &*defStore, &*symbols);
      let mut genericName: str = "?";
      let mut parameter: str = "?";

      if (let Option::SOME(definition) = defStore.get(generic)) {
        if (let Option::SOME(name) = symbols.resolve(definition.name())) {
          genericName = name;
        }
      }

      if (let Option::SOME(paramSymbol) = paramName) {
        if (let Option::SOME(name) = symbols.resolve(paramSymbol)) {
          parameter = name;
        }
      }

      let message: String = `type '${typeName.toStr()}' does not satisfy the bound '${parameter}: ${bound}' of '${genericName}'`;
      let mut label: String = `'${typeName.toStr()}' cannot implement '${bound}'`;

      let boundText: String = `${bound}`;
      let threadSafety: boolean = boundText.equals("Send") || boundText.equals("Sync");

      if (threadSafety) {
        if (Analyzer::ViewType::isView(defStore, typeStore, typeArg)) {
          label = `'${typeName.toStr()}' is a view: it borrows storage it does not own, so it is neither Send nor Sync`;
        } else {
          label = `'${typeName.toStr()}' holds a raw pointer, a function value or another member that is not ${bound}`;
        }
      }

      if (let Option::SOME(type_) = typeStore.get(typeArg)) {
        match (type_) {
          Analyzer::Type::Param(_) -> {
            label = `add '${bound}' to the bounds of '${typeName.toStr()}'`;
          },
          Analyzer::Type::Record(_) | Analyzer::Type::Enum(_) | Analyzer::Type::Instance(_) -> {
            if (!threadSafety) {
              label = `declare \`@implements(${written})\` on '${typeName.toStr()}'`;

              if (!boundText.equals(written)) {
                label = `declare \`@implements(${written})\` on '${typeName.toStr()}', with '${bound}' in scope`;
              }
            }
          },
          _ -> {},
        };
      }

      let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::GENERIC_BOUND_NOT_SATISFIED, message.toStr(), span);
      diagnostic.addLabel(LabelKind::PRIMARY, span, label.toStr());

      let mut bag: &mut DiagnosticBag = diagnostics;
      bag.push(diagnostic);
    }

    /// Whether `names` holds the language trait `name` at a position whose
    /// trait did not resolve. A language trait named without a declaration in
    /// scope keeps matching by name even a bound that did resolve.
    function containsUnresolvedName(
      names: &Vector<String>,
      references: &Vector<Option<Analyzer::DefinitionId>>,
      name: str,
    ): boolean {
      let mut index: u64 = 0;

      while (index < names.length()) {
        if (let Option::SOME(entry) = names.get(index)) {
          if (entry.equals(name) && Analyzer::Resolver::isUndeclaredTraitName(entry) && Analyzer::TypeBounds::traitAt(references, index).isNone()) {
            return true;
          }
        }

        index += 1;
      }

      return false;
    }

    function containsName(names: &Vector<String>, name: str): boolean {
      let mut index: u64 = 0;

      while (index < names.length()) {
        if (let Option::SOME(entry) = names.get(index)) {
          if (entry.equals(name)) {
            return true;
          }
        }

        index += 1;
      }

      return false;
    }

    function isFunctionType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      return match (typeStore.get(resolved.typeId)) {
        Option::SOME(Analyzer::Type::Function(_)) -> true,
        _ -> false,
      };
    }

    function copyTypeIds(source: &Vector<Analyzer::TypeId>): Vector<Analyzer::TypeId> {
      let mut copy: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        if (let Option::SOME(entry) = source.get(index)) {
          copy.push(*entry);
        }

        index += 1;
      }

      return copy;
    }

    function copyDefinitionIds(
      source: &Vector<Analyzer::DefinitionId>
    ): Vector<Analyzer::DefinitionId> {
      let mut copy: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        if (let Option::SOME(entry) = source.get(index)) {
          copy.push(*entry);
        }

        index += 1;
      }

      return copy;
    }

    function copyStrings(source: &Vector<String>): Vector<String> {
      let mut copy: Vector<String> = Vector::new<String>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        if (let Option::SOME(entry) = source.get(index)) {
          copy.push(entry.clone());
        }

        index += 1;
      }

      return copy;
    }
  }
}
