import
  Diagnostic,
  DiagnosticBag,
  DiagnosticCode,
  LabelKind,
  Severity,
  SourceSpan,
from "@compiler::diagnostics";
import Ast from "@compiler::ast";
import Id from "@compiler::ids";
import Vector from "std::vector";

/// Constant-evaluation phase for the Ignis selfhost compiler.
///
/// Port of `crates/ignis_analyzer/src/const_eval.rs`. Runs after typecheck
/// because signed-versus-unsigned folding reads the checked type of the left
/// operand from `TypecheckOutput.exprTypes` (mirroring the Rust
/// `const_operand_is_unsigned`).
///
/// The binder binds module-level constants as immutable `Definition::Variable`
/// (there is no `Definition::Constant` in the selfhost), so evaluated values
/// live in a side map keyed by the constant's raw `DefinitionId` instead of on
/// the definition itself.
///
/// Constants are evaluated in module declaration order, recursing into
/// namespaces and unwrapping exports. A reference to a constant that has not
/// been evaluated yet simply folds to not-const; like the Rust oracle, no
/// cycle diagnostic is emitted, and failed folds (overflow, division by zero,
/// out-of-range shifts) are silently not-const.
///
/// A `static mut` field is the one static field with storage the emitter always
/// has to seed, so its initializer must fold: a scalar to a `ConstValue`, and an
/// array or record literal of constants to a flattened `ConstPart` sequence.
/// One that does not fold is A0230, the only diagnostic this phase reports.
/// One written without an initializer starts zeroed and folds to a single
/// `Zero` part.
/// An immutable static field and a module constant fold the same way when they
/// can, so taking their address names a read-only global seeded with that
/// value; one that does not fold is left to its uses.
///
/// Scoped out relative to the Rust oracle:
///   - function-body and local-statement walking (selfhost constants are
///     module-level only),
///   - the A0068 diagnostic for a static field whose initializer is not
///     constant,
///   - `ConstValue::Array` / `ConstValue::Tuple` and vector-index folding for
///     constants (an aggregate folds only as a static field or constant
///     initializer, never inside an expression),
///   - enum tag evaluation, `configFlag`, and the A0048/A0074 typecheck
///     integrations.
export namespace Analyzer {
  namespace ConstEval {
    /// Compile-time constant value. `Int` stores the two's-complement bit
    /// pattern of any integer type in an `i64`, exactly like the Rust
    /// `ConstValue::Int`; unsigned semantics are recovered from the checked
    /// expression type at fold time.
    enum ConstValue {
      Int(i64),
      Float(f64),
      Bool(boolean),
      Char(char),
      Str(String),
      Null,
    }

    /// One step of a folded array or record initializer, in source nesting
    /// order. `Open` and `Close` bracket one array or record, `Field` names the
    /// record field (owner and index) the next step initializes, `Value` is a
    /// scalar leaf with the type of the storage it initializes, and `Zero` is
    /// storage of the given type whose every byte is zero.
    enum ConstPart {
      Open,
      Close,
      Field(Analyzer::DefinitionId, u32),
      Value(Analyzer::ConstEval::ConstValue, Analyzer::TypeId),
      Zero(Analyzer::TypeId),
    }

    /// Side map from a constant's raw `DefinitionId` to its evaluated value.
    /// Parallel vectors, following the `ExprTypeMap` pattern.
    ///
    /// `aggregateDefIdRaws` and `aggregates` hold the static fields and
    /// constants whose initializer is an array or record literal, each with its
    /// parts.
    record ConstValueMap {
      public defIdRaws: Vector<u32>;
      public values: Vector<Analyzer::ConstEval::ConstValue>;
      public aggregateDefIdRaws: Vector<u32>;
      public aggregates: Vector<Vector<Analyzer::ConstEval::ConstPart>>;

      public static empty(): ConstValueMap {
        return ConstValueMap {
          defIdRaws: Vector::new<u32>(),
          values: Vector::new<Analyzer::ConstEval::ConstValue>(),
          aggregateDefIdRaws: Vector::new<u32>(),
          aggregates: Vector::new<Vector<Analyzer::ConstEval::ConstPart>>(),
        };
      }
    }

    /// Output of the const-eval phase.
    record ConstEvalOutput {
      public diagnostics: DiagnosticBag;
      public values: Analyzer::ConstEval::ConstValueMap;
    }

    function copyConstValue(
      value: &Analyzer::ConstEval::ConstValue
    ): Analyzer::ConstEval::ConstValue {
      return match (value) {
        Analyzer::ConstEval::ConstValue::Int(i) -> Analyzer::ConstEval::ConstValue::Int(i),
        Analyzer::ConstEval::ConstValue::Float(f) -> Analyzer::ConstEval::ConstValue::Float(f),
        Analyzer::ConstEval::ConstValue::Bool(b) -> Analyzer::ConstEval::ConstValue::Bool(b),
        Analyzer::ConstEval::ConstValue::Char(c) -> Analyzer::ConstEval::ConstValue::Char(c),
        Analyzer::ConstEval::ConstValue::Str(s) -> Analyzer::ConstEval::ConstValue::Str(s.clone()),
        Analyzer::ConstEval::ConstValue::Null -> Analyzer::ConstEval::ConstValue::Null,
      };
    }

    /// Look up the evaluated value for a constant's raw `DefinitionId`.
    function findConstValue(
      map: &mut Analyzer::ConstEval::ConstValueMap,
      defIdRaw: u32,
    ): Option<Analyzer::ConstEval::ConstValue> {
      let mut index: u64 = map.defIdRaws.length();

      while (index > 0) {
        index -= 1;

        let Option::SOME(candidate) = map.defIdRaws.get(index) else {
          continue;
        };

        if (*candidate == defIdRaw) {
          let Option::SOME(value) = map.values.get(index) else {
            return Option::NONE;
          };

          return Option::SOME(Analyzer::ConstEval::copyConstValue(value));
        }
      }

      return Option::NONE;
    }

    function insertConstValue(
      map: &mut Analyzer::ConstEval::ConstValueMap,
      defIdRaw: u32,
      value: Analyzer::ConstEval::ConstValue,
    ): void {
      let mut mapRef: &mut Analyzer::ConstEval::ConstValueMap = map;
      mapRef.defIdRaws.push(defIdRaw);
      mapRef.values.push(value);
    }

    function copyConstPart(part: &Analyzer::ConstEval::ConstPart): Analyzer::ConstEval::ConstPart {
      return match (part) {
        Analyzer::ConstEval::ConstPart::Open -> Analyzer::ConstEval::ConstPart::Open,
        Analyzer::ConstEval::ConstPart::Close -> Analyzer::ConstEval::ConstPart::Close,
        Analyzer::ConstEval::ConstPart::Field(owner, index) -> Analyzer::ConstEval::ConstPart::Field(owner, index),
        Analyzer::ConstEval::ConstPart::Value(value, ty) -> Analyzer::ConstEval::ConstPart::Value(Analyzer::ConstEval::copyConstValue(&value), ty),
        Analyzer::ConstEval::ConstPart::Zero(ty) -> Analyzer::ConstEval::ConstPart::Zero(ty),
      };
    }

    function copyConstParts(
      parts: &Vector<Analyzer::ConstEval::ConstPart>
    ): Vector<Analyzer::ConstEval::ConstPart> {
      let mut copied: Vector<Analyzer::ConstEval::ConstPart> = Vector::new<Analyzer::ConstEval::ConstPart>();
      let mut index: u64 = 0;

      while (index < parts.length()) {
        if (let Option::SOME(part) = parts.get(index)) {
          copied.push(Analyzer::ConstEval::copyConstPart(part));
        }

        index += 1;
      }

      return copied;
    }

    /// The folded initializer parts of an array or record static field or constant.
    function findConstAggregate(
      map: &Analyzer::ConstEval::ConstValueMap,
      defIdRaw: u32,
    ): Option<Vector<Analyzer::ConstEval::ConstPart>> {
      let mut index: u64 = 0;

      while (index < map.aggregateDefIdRaws.length()) {
        if (let Option::SOME(candidate) = map.aggregateDefIdRaws.get(index)) {
          if (*candidate == defIdRaw) {
            if (let Option::SOME(parts) = map.aggregates.get(index)) {
              return Option::SOME(Analyzer::ConstEval::copyConstParts(parts));
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    function insertConstAggregate(
      map: &mut Analyzer::ConstEval::ConstValueMap,
      defIdRaw: u32,
      parts: Vector<Analyzer::ConstEval::ConstPart>,
    ): void {
      let mut mapRef: &mut Analyzer::ConstEval::ConstValueMap = map;
      mapRef.aggregateDefIdRaws.push(defIdRaw);
      mapRef.aggregates.push(parts);
    }

    /// Appends a copy of every value and aggregate in `source` to `target`.
    function appendConstValueMap(
      target: &mut Analyzer::ConstEval::ConstValueMap,
      source: &Analyzer::ConstEval::ConstValueMap,
    ): void {
      let mut targetRef: &mut Analyzer::ConstEval::ConstValueMap = target;
      let mut index: u64 = 0;

      while (index < source.defIdRaws.length()) {
        if (let Option::SOME(defIdRaw) = source.defIdRaws.get(index)) {
          if (let Option::SOME(value) = source.values.get(index)) {
            targetRef.defIdRaws.push(*defIdRaw);
            targetRef.values.push(Analyzer::ConstEval::copyConstValue(value));
          }
        }

        index += 1;
      }

      let mut aggregateIndex: u64 = 0;

      while (aggregateIndex < source.aggregateDefIdRaws.length()) {
        if (let Option::SOME(defIdRaw) = source.aggregateDefIdRaws.get(aggregateIndex)) {
          if (let Option::SOME(parts) = source.aggregates.get(aggregateIndex)) {
            targetRef.aggregateDefIdRaws.push(*defIdRaw);
            targetRef.aggregates.push(Analyzer::ConstEval::copyConstParts(parts));
          }
        }

        aggregateIndex += 1;
      }
    }

    // =========================================================================
    // Checked integer arithmetic
    //
    // Ignis has no `checked_*` builtins, so the Rust `i64::checked_*` /
    // `u64::checked_*` semantics are mirrored with explicit bound checks that
    // run before the operation, keeping the compiler itself free of overflow.
    // =========================================================================

    function checkedAddSigned(left: i64, right: i64): Option<i64> {
      if (right > 0 && left > maxOf<i64>() - right) {
        return Option::NONE;
      }
      if (right < 0 && left < minOf<i64>() - right) {
        return Option::NONE;
      }

      return Option::SOME(left + right);
    }

    function checkedSubSigned(left: i64, right: i64): Option<i64> {
      if (right < 0 && left > maxOf<i64>() + right) {
        return Option::NONE;
      }
      if (right > 0 && left < minOf<i64>() + right) {
        return Option::NONE;
      }

      return Option::SOME(left - right);
    }

    /// Overflow-checked `i64` multiplication. The `-1` factors are handled
    /// first so the division-based bound checks below never divide `minOf` by
    /// `-1`, which itself overflows.
    function checkedMulSigned(left: i64, right: i64): Option<i64> {
      if (left == 0 || right == 0) {
        return Option::SOME(0);
      }

      if (left == -1) {
        if (right == minOf<i64>()) {
          return Option::NONE;
        }
        return Option::SOME(-right);
      }

      if (right == -1) {
        if (left == minOf<i64>()) {
          return Option::NONE;
        }
        return Option::SOME(-left);
      }

      if (left > 0 && right > 0 && left > maxOf<i64>() / right) {
        return Option::NONE;
      }
      if (left > 0 && right < 0 && right < minOf<i64>() / left) {
        return Option::NONE;
      }
      if (left < 0 && right > 0 && left < minOf<i64>() / right) {
        return Option::NONE;
      }
      if (left < 0 && right < 0 && left < maxOf<i64>() / right) {
        return Option::NONE;
      }

      return Option::SOME(left * right);
    }

    /// Caller guarantees `right != 0`.
    function checkedDivSigned(left: i64, right: i64): Option<i64> {
      if (left == minOf<i64>() && right == -1) {
        return Option::NONE;
      }

      return Option::SOME(left / right);
    }

    /// Caller guarantees `right != 0`. Like Rust `checked_rem`,
    /// `minOf % -1` is not-const even though its mathematical result is zero.
    function checkedRemSigned(left: i64, right: i64): Option<i64> {
      if (left == minOf<i64>() && right == -1) {
        return Option::NONE;
      }

      return Option::SOME(left % right);
    }

    function checkedAddUnsigned(left: u64, right: u64): Option<u64> {
      if (left > maxOf<u64>() - right) {
        return Option::NONE;
      }

      return Option::SOME(left + right);
    }

    function checkedSubUnsigned(left: u64, right: u64): Option<u64> {
      if (left < right) {
        return Option::NONE;
      }

      return Option::SOME(left - right);
    }

    function checkedMulUnsigned(left: u64, right: u64): Option<u64> {
      if (right != 0 && left > maxOf<u64>() / right) {
        return Option::NONE;
      }

      return Option::SOME(left * right);
    }

    function intFromSigned(result: Option<i64>): Option<Analyzer::ConstEval::ConstValue> {
      return match (result) {
        Option::SOME(value) -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(value)),
        Option::NONE -> Option::NONE,
      };
    }

    function intFromUnsigned(result: Option<u64>): Option<Analyzer::ConstEval::ConstValue> {
      return match (result) {
        Option::SOME(value) -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(value as i64)),
        Option::NONE -> Option::NONE,
      };
    }

    // =========================================================================
    // Folding
    // =========================================================================

    /// Finite check that is false for NaN and both infinities: a finite value
    /// minus itself is exactly zero, while `inf - inf` and `NaN - NaN` are NaN.
    function isFiniteFloat(value: f64): boolean {
      return value - value == 0.0;
    }

    function finiteFloat(value: f64): Option<Analyzer::ConstEval::ConstValue> {
      if (!Analyzer::ConstEval::isFiniteFloat(value)) {
        return Option::NONE;
      }

      return Option::SOME(Analyzer::ConstEval::ConstValue::Float(value));
    }

    /// Truncated float remainder, mirroring Rust's `%` on `f64` (fmod).
    ///
    /// The Ignis `%` operator does not support floats, so the remainder is
    /// computed as `l - trunc(l / r) * r` with the truncation done through an
    /// `i64` cast. Divergence from the oracle: when `|l / r|` exceeds the
    /// `i64` range the fold answers not-const instead of folding, because the
    /// truncation cannot be represented.
    function floatRemainder(left: f64, right: f64): Option<Analyzer::ConstEval::ConstValue> {
      let quotient: f64 = left / right;

      if (!Analyzer::ConstEval::isFiniteFloat(quotient)) {
        return Option::NONE;
      }
      if (quotient > maxOf<i64>() as f64 || quotient < minOf<i64>() as f64) {
        return Option::NONE;
      }

      let truncated: f64 = (quotient as i64) as f64;
      return Analyzer::ConstEval::finiteFloat(left - truncated * right);
    }

    /// Folds an integer binary operation over the two's-complement bit
    /// patterns held by `ConstValue::Int`. Mirrors the Rust
    /// `const_eval_int_binary`: `unsignedFold` comes from the left operand's
    /// checked type, and only division, remainder, the ordering comparisons,
    /// and a right shift branch on it — the other operations produce the same
    /// bits either way. The caller has already rejected division and
    /// remainder by zero.
    function foldIntBinary(
      operator: Ast::Expression::BinaryOperator,
      left: i64,
      right: i64,
      unsignedFold: boolean,
    ): Option<Analyzer::ConstEval::ConstValue> {
      match (operator) {
        Ast::Expression::BinaryOperator::Add -> {
          if (unsignedFold) {
            return Analyzer::ConstEval::intFromUnsigned(
              Analyzer::ConstEval::checkedAddUnsigned(left as u64, right as u64),
            );
          }
          return Analyzer::ConstEval::intFromSigned(Analyzer::ConstEval::checkedAddSigned(left, right));
        },
        Ast::Expression::BinaryOperator::Subtract -> {
          if (unsignedFold) {
            return Analyzer::ConstEval::intFromUnsigned(
              Analyzer::ConstEval::checkedSubUnsigned(left as u64, right as u64),
            );
          }
          return Analyzer::ConstEval::intFromSigned(Analyzer::ConstEval::checkedSubSigned(left, right));
        },
        Ast::Expression::BinaryOperator::Multiply -> {
          if (unsignedFold) {
            return Analyzer::ConstEval::intFromUnsigned(
              Analyzer::ConstEval::checkedMulUnsigned(left as u64, right as u64),
            );
          }
          return Analyzer::ConstEval::intFromSigned(Analyzer::ConstEval::checkedMulSigned(left, right));
        },
        Ast::Expression::BinaryOperator::Divide -> {
          if (unsignedFold) {
            return Analyzer::ConstEval::intFromUnsigned(Option::SOME((left as u64) / (right as u64)));
          }
          return Analyzer::ConstEval::intFromSigned(Analyzer::ConstEval::checkedDivSigned(left, right));
        },
        Ast::Expression::BinaryOperator::Modulo -> {
          if (unsignedFold) {
            return Analyzer::ConstEval::intFromUnsigned(Option::SOME((left as u64) % (right as u64)));
          }
          return Analyzer::ConstEval::intFromSigned(Analyzer::ConstEval::checkedRemSigned(left, right));
        },
        Ast::Expression::BinaryOperator::Equal -> {
          return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left == right));
        },
        Ast::Expression::BinaryOperator::NotEqual -> {
          return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left != right));
        },
        Ast::Expression::BinaryOperator::LessThan -> {
          if (unsignedFold) {
            return Option::SOME(Analyzer::ConstEval::ConstValue::Bool((left as u64) < (right as u64)));
          }
          return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left < right));
        },
        Ast::Expression::BinaryOperator::LessThanOrEqual -> {
          if (unsignedFold) {
            return Option::SOME(Analyzer::ConstEval::ConstValue::Bool((left as u64) <= (right as u64)));
          }
          return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left <= right));
        },
        Ast::Expression::BinaryOperator::GreaterThan -> {
          if (unsignedFold) {
            return Option::SOME(Analyzer::ConstEval::ConstValue::Bool((left as u64) > (right as u64)));
          }
          return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left > right));
        },
        Ast::Expression::BinaryOperator::GreaterThanOrEqual -> {
          if (unsignedFold) {
            return Option::SOME(Analyzer::ConstEval::ConstValue::Bool((left as u64) >= (right as u64)));
          }
          return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left >= right));
        },
        Ast::Expression::BinaryOperator::BitAnd -> {
          return Option::SOME(Analyzer::ConstEval::ConstValue::Int(left & right));
        },
        Ast::Expression::BinaryOperator::BitOr -> {
          return Option::SOME(Analyzer::ConstEval::ConstValue::Int(left | right));
        },
        Ast::Expression::BinaryOperator::BitXor -> {
          return Option::SOME(Analyzer::ConstEval::ConstValue::Int(left ^ right));
        },
        Ast::Expression::BinaryOperator::ShiftLeft -> {
          if (right < 0 || right > 63) {
            return Option::NONE;
          }
          return Option::SOME(Analyzer::ConstEval::ConstValue::Int(left << right));
        },
        Ast::Expression::BinaryOperator::ShiftRight -> {
          if (right < 0 || right > 63) {
            return Option::NONE;
          }
          if (unsignedFold) {
            return Option::SOME(Analyzer::ConstEval::ConstValue::Int(((left as u64) >> (right as u64)) as i64));
          }
          return Option::SOME(Analyzer::ConstEval::ConstValue::Int(left >> right));
        },
        _ -> {
          return Option::NONE;
        },
      };

      return Option::NONE;
    }

    function foldFloatBinary(
      operator: Ast::Expression::BinaryOperator,
      left: f64,
      right: f64,
    ): Option<Analyzer::ConstEval::ConstValue> {
      match (operator) {
        Ast::Expression::BinaryOperator::Add -> {
          return Analyzer::ConstEval::finiteFloat(left + right);
        },
        Ast::Expression::BinaryOperator::Subtract -> {
          return Analyzer::ConstEval::finiteFloat(left - right);
        },
        Ast::Expression::BinaryOperator::Multiply -> {
          return Analyzer::ConstEval::finiteFloat(left * right);
        },
        Ast::Expression::BinaryOperator::Divide -> {
          if (right == 0.0) {
            return Option::NONE;
          }
          return Analyzer::ConstEval::finiteFloat(left / right);
        },
        Ast::Expression::BinaryOperator::Modulo -> {
          if (right == 0.0) {
            return Option::NONE;
          }
          return Analyzer::ConstEval::floatRemainder(left, right);
        },
        Ast::Expression::BinaryOperator::Equal -> {
          return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left == right));
        },
        Ast::Expression::BinaryOperator::NotEqual -> {
          return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left != right));
        },
        _ -> {
          return Option::NONE;
        },
      };

      return Option::NONE;
    }

    function foldBoolBinary(
      operator: Ast::Expression::BinaryOperator,
      left: boolean,
      right: boolean,
    ): Option<Analyzer::ConstEval::ConstValue> {
      return match (operator) {
        Ast::Expression::BinaryOperator::And -> Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left && right)),
        Ast::Expression::BinaryOperator::Or -> Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left || right)),
        Ast::Expression::BinaryOperator::Equal -> Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left == right)),
        Ast::Expression::BinaryOperator::NotEqual -> Option::SOME(Analyzer::ConstEval::ConstValue::Bool(left != right)),
        _ -> Option::NONE,
      };
    }

    /// Mirrors the Rust `const_eval_binary`: only same-shape operand pairs
    /// fold, and integer division/remainder by zero is not-const before the
    /// per-operator dispatch.
    function foldBinary(
      operator: Ast::Expression::BinaryOperator,
      left: Option<Analyzer::ConstEval::ConstValue>,
      right: Option<Analyzer::ConstEval::ConstValue>,
      unsignedFold: boolean,
    ): Option<Analyzer::ConstEval::ConstValue> {
      let Option::SOME(leftValue) = left else {
        return Option::NONE;
      };
      let Option::SOME(rightValue) = right else {
        return Option::NONE;
      };

      let leftRef: &Analyzer::ConstEval::ConstValue = &leftValue;
      let rightRef: &Analyzer::ConstEval::ConstValue = &rightValue;

      match (leftRef) {
        Analyzer::ConstEval::ConstValue::Int(l) -> {
          match (rightRef) {
            Analyzer::ConstEval::ConstValue::Int(r) -> {
              let isDivision: boolean = match (operator) {
                Ast::Expression::BinaryOperator::Divide
                | Ast::Expression::BinaryOperator::Modulo -> true,
                _ -> false,
              };

              if (isDivision && r == 0) {
                return Option::NONE;
              }

              return Analyzer::ConstEval::foldIntBinary(operator, l, r, unsignedFold);
            },
            _ -> {
              return Option::NONE;
            },
          };
        },
        Analyzer::ConstEval::ConstValue::Float(l) -> {
          match (rightRef) {
            Analyzer::ConstEval::ConstValue::Float(r) -> {
              return Analyzer::ConstEval::foldFloatBinary(operator, l, r);
            },
            _ -> {
              return Option::NONE;
            },
          };
        },
        Analyzer::ConstEval::ConstValue::Bool(l) -> {
          match (rightRef) {
            Analyzer::ConstEval::ConstValue::Bool(r) -> {
              return Analyzer::ConstEval::foldBoolBinary(operator, l, r);
            },
            _ -> {
              return Option::NONE;
            },
          };
        },
        _ -> {
          return Option::NONE;
        },
      };

      return Option::NONE;
    }

    /// Mirrors the Rust `const_eval_unary`. Negating an unsigned value has no
    /// meaning here; leaving it unfolded keeps a wrong constant out of the
    /// program.
    function foldUnary(
      operator: Ast::Expression::UnaryOperator,
      operand: Option<Analyzer::ConstEval::ConstValue>,
      unsignedFold: boolean,
    ): Option<Analyzer::ConstEval::ConstValue> {
      let Option::SOME(operandValue) = operand else {
        return Option::NONE;
      };

      let operandRef: &Analyzer::ConstEval::ConstValue = &operandValue;

      match (operandRef) {
        Analyzer::ConstEval::ConstValue::Int(i) -> {
          match (operator) {
            Ast::Expression::UnaryOperator::Negate -> {
              if (unsignedFold) {
                return Option::NONE;
              }
              if (i == minOf<i64>()) {
                return Option::NONE;
              }
              return Option::SOME(Analyzer::ConstEval::ConstValue::Int(-i));
            },
            Ast::Expression::UnaryOperator::Not -> {
              return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(i == 0));
            },
            Ast::Expression::UnaryOperator::BitNot -> {
              return Option::SOME(Analyzer::ConstEval::ConstValue::Int(~i));
            },
            _ -> {
              return Option::NONE;
            },
          };
        },
        Analyzer::ConstEval::ConstValue::Float(f) -> {
          match (operator) {
            Ast::Expression::UnaryOperator::Negate -> {
              return Analyzer::ConstEval::finiteFloat(-f);
            },
            _ -> {
              return Option::NONE;
            },
          };
        },
        Analyzer::ConstEval::ConstValue::Bool(b) -> {
          match (operator) {
            Ast::Expression::UnaryOperator::Not -> {
              return Option::SOME(Analyzer::ConstEval::ConstValue::Bool(!b));
            },
            _ -> {
              return Option::NONE;
            },
          };
        },
        _ -> {
          return Option::NONE;
        },
      };

      return Option::NONE;
    }

    // =========================================================================
    // Expression evaluation
    // =========================================================================

    function constValueFromLiteral(
      value: &Ast::Expression::LiteralValue
    ): Analyzer::ConstEval::ConstValue {
      return match (value) {
        Ast::Expression::LiteralValue::Int(i) -> Analyzer::ConstEval::ConstValue::Int(i),
        Ast::Expression::LiteralValue::UInt(u) -> Analyzer::ConstEval::ConstValue::Int(u as i64),
        Ast::Expression::LiteralValue::Float(f) -> Analyzer::ConstEval::ConstValue::Float(f),
        Ast::Expression::LiteralValue::Boolean(b) -> Analyzer::ConstEval::ConstValue::Bool(b),
        Ast::Expression::LiteralValue::Character(c) -> Analyzer::ConstEval::ConstValue::Char(c),
        Ast::Expression::LiteralValue::String(s) -> Analyzer::ConstEval::ConstValue::Str(s.clone()),
        Ast::Expression::LiteralValue::Atom(name) -> Analyzer::ConstEval::ConstValue::Str(name.clone()),
        Ast::Expression::LiteralValue::Null -> Analyzer::ConstEval::ConstValue::Null,
      };
    }

    /// Whether an expression's checked type is an unsigned integer, mirroring
    /// the Rust `const_operand_is_unsigned` (no alias resolution, matching
    /// `TypeStore::is_unsigned`).
    /// The checked type of expression `exprId`, when typecheck recorded one.
    function exprTypeOf(
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::TypeId> {
      let mut index: u64 = typecheck.exprTypes.nodeIds.length();

      while (index > 0) {
        index -= 1;

        let Option::SOME(nodeId) = typecheck.exprTypes.nodeIds.get(index) else {
          continue;
        };

        if (*nodeId != exprId.raw()) {
          continue;
        }

        if (let Option::SOME(typeId) = typecheck.exprTypes.typeIds.get(index)) {
          return Option::SOME(*typeId);
        }

        return Option::NONE;
      }

      return Option::NONE;
    }

    /// The constant a scalar type is when every byte is zero: `0`, `0.0`,
    /// `false`, the null character or `null`. `NONE` for an aggregate or a type
    /// with no zero value.
    function scalarZeroValue(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Option<Analyzer::ConstEval::ConstValue> {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
        return Option::NONE;
      };

      return match (typeNode) {
        Analyzer::Type::I8 -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(0)),
        Analyzer::Type::I16 -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(0)),
        Analyzer::Type::I32 -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(0)),
        Analyzer::Type::I64 -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(0)),
        Analyzer::Type::U8 -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(0)),
        Analyzer::Type::U16 -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(0)),
        Analyzer::Type::U32 -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(0)),
        Analyzer::Type::U64 -> Option::SOME(Analyzer::ConstEval::ConstValue::Int(0)),
        Analyzer::Type::F32 -> Option::SOME(Analyzer::ConstEval::ConstValue::Float(0.0)),
        Analyzer::Type::F64 -> Option::SOME(Analyzer::ConstEval::ConstValue::Float(0.0)),
        Analyzer::Type::BOOLEAN -> Option::SOME(Analyzer::ConstEval::ConstValue::Bool(false)),
        Analyzer::Type::CHAR -> Option::SOME(Analyzer::ConstEval::ConstValue::Char('\0')),
        Analyzer::Type::Pointer(_) -> Option::SOME(Analyzer::ConstEval::ConstValue::Null),
        _ -> Option::NONE,
      };
    }

    function exprTypeIsUnsigned(
      typeStore: &mut Analyzer::TypeStore,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprId: Ast::ExpressionId,
    ): boolean {
      let mut index: u64 = typecheck.exprTypes.nodeIds.length();

      while (index > 0) {
        index -= 1;

        let Option::SOME(nodeId) = typecheck.exprTypes.nodeIds.get(index) else {
          continue;
        };

        if (*nodeId != exprId.raw()) {
          continue;
        }

        let Option::SOME(typeId) = typecheck.exprTypes.typeIds.get(index) else {
          return false;
        };
        let Option::SOME(typeNode) = typeStore.get(*typeId) else {
          return false;
        };

        return match (typeNode) {
          Analyzer::Type::U8
          | Analyzer::Type::U16
          | Analyzer::Type::U32
          | Analyzer::Type::U64 -> true,
          _ -> false,
        };
      }

      return false;
    }

    /// Value of a `Variable`/`Path` reference to an already-evaluated
    /// constant. The body resolver records the resolved definition on the
    /// expression itself, so both expression shapes resolve the same way; a
    /// reference to anything but an immutable module-level `Variable`
    /// definition is not const.
    function referencedConstValue(
      values: &mut Analyzer::ConstEval::ConstValueMap,
      defStore: &mut Analyzer::DefinitionStore,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::ConstEval::ConstValue> {
      let Option::SOME(resolvedRef) = Analyzer::ResolverBodies::findExprRef(
        &resolvedBodies.bodyResolution,
        exprId.raw(),
      ) else {
        return Option::NONE;
      };

      let Analyzer::ResolverBodies::ResolvedRef::Definition(defId) = resolvedRef else {
        return Option::NONE;
      };

      let Option::SOME(def) = defStore.get(defId) else {
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Variable(variable) -> {
          if (variable.mutable) {
            return Option::NONE;
          }

          return Analyzer::ConstEval::findConstValue(values, defId.raw());
        },
        _ -> {
          return Option::NONE;
        },
      };

      return Option::NONE;
    }

    /// Mirrors the Rust `const_eval_expression_node` for the expression
    /// shapes in scope: literals, references to earlier constants, binary and
    /// unary folding, const-condition ternaries, and grouping. Everything
    /// else is not const.
    function evalExpression(
      values: &mut Analyzer::ConstEval::ConstValueMap,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::ConstEval::ConstValue> {
      let Option::SOME(expression) = module.expressions.get(exprId) else {
        return Option::NONE;
      };

      match (expression) {
        Ast::Expression::Node::Literal(literal) -> {
          return Option::SOME(Analyzer::ConstEval::constValueFromLiteral(&literal.value));
        },
        Ast::Expression::Node::Variable(_) -> {
          return Analyzer::ConstEval::referencedConstValue(values, defStore, resolvedBodies, exprId);
        },
        Ast::Expression::Node::Path(_) -> {
          return Analyzer::ConstEval::referencedConstValue(values, defStore, resolvedBodies, exprId);
        },
        Ast::Expression::Node::Binary(binaryExpr) -> {
          let left: Option<Analyzer::ConstEval::ConstValue> = Analyzer::ConstEval::evalExpression(
            values,
            defStore,
            typeStore,
            module,
            resolvedBodies,
            typecheck,
            binaryExpr.left,
          );
          let right: Option<Analyzer::ConstEval::ConstValue> = Analyzer::ConstEval::evalExpression(
            values,
            defStore,
            typeStore,
            module,
            resolvedBodies,
            typecheck,
            binaryExpr.right,
          );
          let unsignedFold: boolean = Analyzer::ConstEval::exprTypeIsUnsigned(typeStore, typecheck, binaryExpr.left);

          return Analyzer::ConstEval::foldBinary(binaryExpr.operator, left, right, unsignedFold);
        },
        Ast::Expression::Node::Ternary(ternary) -> {
          let Option::SOME(condition) = Analyzer::ConstEval::evalExpression(
            values,
            defStore,
            typeStore,
            module,
            resolvedBodies,
            typecheck,
            ternary.condition,
          ) else {
            return Option::NONE;
          };

          let conditionRef: &Analyzer::ConstEval::ConstValue = &condition;

          match (conditionRef) {
            Analyzer::ConstEval::ConstValue::Bool(flag) -> {
              if (flag) {
                return Analyzer::ConstEval::evalExpression(
                  values,
                  defStore,
                  typeStore,
                  module,
                  resolvedBodies,
                  typecheck,
                  ternary.thenBranch,
                );
              }

              return Analyzer::ConstEval::evalExpression(
                values,
                defStore,
                typeStore,
                module,
                resolvedBodies,
                typecheck,
                ternary.elseBranch,
              );
            },
            _ -> {
              return Option::NONE;
            },
          };
        },
        Ast::Expression::Node::Unary(unary) -> {
          if (let Option::SOME(negatedValue) = Analyzer::Typecheck::negativeIntegerLiteralValue(module, &unary)) {
            return Option::SOME(Analyzer::ConstEval::ConstValue::Int(negatedValue));
          }

          let operand: Option<Analyzer::ConstEval::ConstValue> = Analyzer::ConstEval::evalExpression(
            values,
            defStore,
            typeStore,
            module,
            resolvedBodies,
            typecheck,
            unary.operand,
          );
          let unsignedFold: boolean = Analyzer::ConstEval::exprTypeIsUnsigned(typeStore, typecheck, unary.operand);

          return Analyzer::ConstEval::foldUnary(unary.operator, operand, unsignedFold);
        },
        Ast::Expression::Node::Grouped(grouped) -> {
          return Analyzer::ConstEval::evalExpression(
            values,
            defStore,
            typeStore,
            module,
            resolvedBodies,
            typecheck,
            grouped.expression,
          );
        },
        Ast::Expression::Node::BuiltinCall(call) -> {
          if (!call.name.equals("zeroed")) {
            return Option::NONE;
          }

          let Option::SOME(zeroType) = Analyzer::ConstEval::exprTypeOf(typecheck, exprId) else {
            return Option::NONE;
          };

          return Analyzer::ConstEval::scalarZeroValue(defStore, typeStore, zeroType);
        },
        _ -> {
          return Option::NONE;
        },
      };

      return Option::NONE;
    }

    // =========================================================================
    // Item walk
    // =========================================================================

    /// `DefinitionId` for a constant item. Constants are bound in binder
    /// pass 2, so that index is consulted first.
    function constantItemDef(
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
    ): Option<Analyzer::DefinitionId> {
      let pass2Result: Option<Analyzer::DefinitionId> = Analyzer::Binder::findDef(pass2, itemId.raw());
      if (pass2Result.isSome()) {
        return pass2Result;
      }

      return Analyzer::Binder::findDef(pass1, itemId.raw());
    }

    /// Copy of the static-field definition ids `defId` owns, in the order the
    /// binder pushed them.
    function ownerStaticFieldDefs(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(definition) = defStore.get(defId)) {
        match (definition) {
          Analyzer::Definition::Record(recordDef) -> {
            let mut index: u64 = 0;

            while (index < recordDef.staticFields.length()) {
              if (let Option::SOME(staticId) = recordDef.staticFields.get(index)) {
                out.push(*staticId);
              }

              index += 1;
            }
          },
          Analyzer::Definition::Enum(enumDef) -> {
            let mut index: u64 = 0;

            while (index < enumDef.staticFields.length()) {
              if (let Option::SOME(staticId) = enumDef.staticFields.get(index)) {
                out.push(*staticId);
              }

              index += 1;
            }
          },
          _ -> {},
        };
      }

      return out;
    }

    /// Folds the initializers of the static fields `ownerItemId` declares.
    ///
    /// A `static mut` field always has storage of its own, so the emitter needs
    /// the constant that storage starts at and an initializer that does not fold
    /// is A0230. An immutable static field gets storage only when its address is
    /// taken; one whose initializer does not fold is skipped without a
    /// diagnostic and keeps lowering that expression at each use.
    ///
    /// `fieldPatternIds` is walked with the binder's own static-field filter, so
    /// the k-th static field it accepts is the k-th id the binder pushed into
    /// the owner's `staticFields`.
    function evalOwnerStaticFields(
      values: &mut Analyzer::ConstEval::ConstValueMap,
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      ownerItemId: Ast::ItemId,
      fieldPatternIds: &Vector<Ast::PatternId>,
      enumMembers: boolean,
    ): void {
      let Option::SOME(ownerDefId) = Analyzer::ConstEval::constantItemDef(pass1, pass2, ownerItemId) else {
        return;
      };

      let staticFieldDefs: Vector<Analyzer::DefinitionId> = Analyzer::ConstEval::ownerStaticFieldDefs(defStore, ownerDefId);

      let mut patternIndex: u64 = 0;
      let mut staticIndex: u64 = 0;

      while (patternIndex < fieldPatternIds.length()) {
        let Option::SOME(patternId) = fieldPatternIds.get(patternIndex) else {
          patternIndex += 1;
          continue;
        };

        patternIndex += 1;

        let isStatic: boolean = match (enumMembers) {
          true -> Analyzer::Binder::variantPatternIsStaticField(module, *patternId),
          false -> Analyzer::Binder::fieldPatternIsStatic(module, *patternId),
        };

        if (!isStatic) {
          continue;
        }

        let fieldDefIdOpt: Option<Analyzer::DefinitionId> = match (staticFieldDefs.get(staticIndex)) {
          Option::SOME(value) -> Option::SOME(*value),
          Option::NONE -> Option::NONE,
        };

        staticIndex += 1;

        let Option::SOME(fieldDefId) = fieldDefIdOpt else {
          continue;
        };

        let mut isMutable: boolean = false;
        let mut declaredType: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(0);

        if (let Option::SOME(Analyzer::Definition::Variable(variableDef)) = defStore.get(fieldDefId)) {
          isMutable = variableDef.mutable;
          declaredType = variableDef.declaredType;
        }

        let mut initializerOpt: Option<Ast::ExpressionId> = Option::NONE;
        let mut fieldName: String = String::new();

        if (let Option::SOME(Ast::Pattern::Node::Binding(binding)) = module.patterns.get(*patternId)) {
          initializerOpt = binding.initializer;
          fieldName = binding.name.clone();
        }

        let Option::SOME(initializer) = initializerOpt else {
          if (isMutable) {
            let mut zeroParts: Vector<Analyzer::ConstEval::ConstPart> = Vector::new<Analyzer::ConstEval::ConstPart>();
            zeroParts.push(Analyzer::ConstEval::ConstPart::Zero(declaredType));
            Analyzer::ConstEval::insertConstAggregate(values, fieldDefId.raw(), zeroParts);
          }

          continue;
        };

        let mut parts: Vector<Analyzer::ConstEval::ConstPart> = Vector::new<Analyzer::ConstEval::ConstPart>();
        let mut report: Analyzer::ConstEval::FoldReport = Analyzer::ConstEval::FoldReport::none();
        let folded: boolean = Analyzer::ConstEval::evalInitializerParts(
          values,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          typecheck,
          initializer,
          declaredType,
          &mut report,
          &mut parts,
        );

        if (!folded) {
          if (Analyzer::ConstEval::reportOversizedSplat(diagnostics, &report)) {
            continue;
          }

          if (isMutable) {
            Analyzer::ConstEval::reportNonConstantStaticMut(diagnostics, module, initializer, &fieldName);
          }

          continue;
        }

        if (parts.length() == 1) {
          if (let Option::SOME(Analyzer::ConstEval::ConstPart::Value(value, _)) = parts.get(0)) {
            Analyzer::ConstEval::insertConstValue(values, fieldDefId.raw(), Analyzer::ConstEval::copyConstValue(&value));
            continue;
          }
        }

        Analyzer::ConstEval::insertConstAggregate(values, fieldDefId.raw(), parts);
      }
    }

    /// What a failed fold reports besides "not constant": the first `@splat`
    /// whose non-zero value would expand past `ARRAY_EXPANSION_LIMIT` elements,
    /// with the span of the call and the length it asked for.
    record FoldReport {
      public oversizedSplat: Option<SourceSpan>;
      public oversizedLength: u64;

      public static none(): FoldReport {
        return FoldReport {
          oversizedSplat: Option::NONE,
          oversizedLength: 0,
        };
      }
    }

    /// A0240 for the oversized `@splat` a failed fold recorded. False when it
    /// recorded none.
    function reportOversizedSplat(
      diagnostics: &mut DiagnosticBag,
      report: &Analyzer::ConstEval::FoldReport,
    ): boolean {
      let Option::SOME(span) = report.oversizedSplat else {
        return false;
      };

      let message: String = `'@splat' expands to ${report.oversizedLength} elements, more than the limit of ${Analyzer::Typecheck::ARRAY_EXPANSION_LIMIT}`;
      let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::SPLAT_TOO_LARGE, message.toStr(), span);
      diagnostic.addLabel(LabelKind::PRIMARY, span, "a constant initializer holds every element, so only a zero value may be larger");

      let mut bag: &mut DiagnosticBag = diagnostics;
      bag.push(diagnostic);

      return true;
    }

    /// Folds `exprId`, the initializer of storage typed `expectedType`, into
    /// `parts`: an array literal of a fixed array type and a record literal of
    /// a record type open a bracket and fold each element or field against its
    /// own type, and any other expression is one scalar `Value`. False when
    /// some leaf does not fold, or a literal does not match the type it
    /// initializes.
    function evalInitializerParts(
      values: &mut Analyzer::ConstEval::ConstValueMap,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprId: Ast::ExpressionId,
      expectedType: Analyzer::TypeId,
      report: &mut Analyzer::ConstEval::FoldReport,
      parts: &mut Vector<Analyzer::ConstEval::ConstPart>,
    ): boolean {
      let Option::SOME(expression) = module.expressions.get(exprId) else {
        return false;
      };

      if (let Ast::Expression::Node::Grouped(grouped) = expression) {
        return Analyzer::ConstEval::evalInitializerParts(
          values,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          typecheck,
          grouped.expression,
          expectedType,
          report,
          parts,
        );
      }

      if (let Ast::Expression::Node::BuiltinCall(call) = expression) {
        if (call.name.equals("zeroed")) {
          return Analyzer::ConstEval::evalZeroedParts(defStore, typeStore, typecheck, exprId, parts);
        }

        if (call.name.equals("splat")) {
          return Analyzer::ConstEval::evalSplatParts(
            values,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            typecheck,
            exprId,
            &call,
            report,
            parts,
          );
        }
      }

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, expectedType);
      let mut arrayElement: Option<Analyzer::TypeId> = Option::NONE;
      let mut arraySize: u64 = 0;
      let mut recordDefId: Option<Analyzer::DefinitionId> = Option::NONE;

      if (let Option::SOME(typeNode) = typeStore.get(resolved.typeId)) {
        match (typeNode) {
          Analyzer::Type::FixedArray(element, size) -> {
            arrayElement = Option::SOME(element);
            arraySize = size;
          },
          Analyzer::Type::Record(defId) -> {
            recordDefId = Option::SOME(defId);
          },
          _ -> {},
        };
      }

      let mut partsRef: &mut Vector<Analyzer::ConstEval::ConstPart> = parts;

      if (let Option::SOME(elementType) = arrayElement) {
        let Ast::Expression::Node::Vector(literal) = expression else {
          return false;
        };

        if (let Option::SOME(rangeId) = Analyzer::Typecheck::arrayRangeElementId(module, &literal)) {
          return Analyzer::ConstEval::evalArrayRangeParts(module, rangeId, elementType, arraySize, parts);
        }

        if (literal.elements.length() != arraySize) {
          return false;
        }

        partsRef.push(Analyzer::ConstEval::ConstPart::Open);

        let mut index: u64 = 0;

        while (index < literal.elements.length()) {
          let Option::SOME(elementId) = literal.elements.get(index) else {
            return false;
          };

          if (!Analyzer::ConstEval::evalInitializerParts(values, defStore, typeStore, symbols, module, resolvedBodies, typecheck, *elementId, elementType, report, parts)) {
            return false;
          }

          index += 1;
        }

        let mut closeRef: &mut Vector<Analyzer::ConstEval::ConstPart> = parts;
        closeRef.push(Analyzer::ConstEval::ConstPart::Close);
        return true;
      }

      if (let Option::SOME(ownerId) = recordDefId) {
        let Ast::Expression::Node::RecordInit(recordInit) = expression else {
          return false;
        };

        partsRef.push(Analyzer::ConstEval::ConstPart::Open);

        let mut index: u64 = 0;

        while (index < recordInit.fields.length()) {
          let Option::SOME(field) = recordInit.fields.get(index) else {
            return false;
          };

          let Option::SOME(fieldDef) = Analyzer::ConstEval::recordFieldNamed(defStore, symbols, ownerId, field.name.toStr()) else {
            return false;
          };

          let mut fieldRef: &mut Vector<Analyzer::ConstEval::ConstPart> = parts;
          fieldRef.push(Analyzer::ConstEval::ConstPart::Field(ownerId, fieldDef.index));

          if (!Analyzer::ConstEval::evalInitializerParts(values, defStore, typeStore, symbols, module, resolvedBodies, typecheck, field.value, fieldDef.fieldType, report, parts)) {
            return false;
          }

          index += 1;
        }

        let mut closeRef: &mut Vector<Analyzer::ConstEval::ConstPart> = parts;
        closeRef.push(Analyzer::ConstEval::ConstPart::Close);
        return true;
      }

      let Option::SOME(value) = Analyzer::ConstEval::evalExpression(values, defStore, typeStore, module, resolvedBodies, typecheck, exprId) else {
        return false;
      };

      partsRef.push(Analyzer::ConstEval::ConstPart::Value(value, expectedType));
      return true;
    }

    /// Whether `value` is a constant whose every byte is zero.
    function isZeroConstValue(value: &Analyzer::ConstEval::ConstValue): boolean {
      return match (value) {
        Analyzer::ConstEval::ConstValue::Int(number) -> number == 0,
        Analyzer::ConstEval::ConstValue::Float(number) -> number == 0.0 && 1.0 / number > 0.0,
        Analyzer::ConstEval::ConstValue::Bool(flag) -> !flag,
        Analyzer::ConstEval::ConstValue::Char(character) -> character == '\0',
        Analyzer::ConstEval::ConstValue::Null -> true,
        Analyzer::ConstEval::ConstValue::Str(_) -> false,
      };
    }

    /// Whether `parts` folds a value whose every byte is zero: one `Zero`, or
    /// one scalar that is the zero of its type.
    function isZeroParts(parts: &Vector<Analyzer::ConstEval::ConstPart>): boolean {
      if (parts.length() != 1) {
        return false;
      }

      let Option::SOME(part) = parts.get(0) else {
        return false;
      };

      return match (part) {
        Analyzer::ConstEval::ConstPart::Zero(_) -> true,
        Analyzer::ConstEval::ConstPart::Value(value, _) -> Analyzer::ConstEval::isZeroConstValue(&value),
        _ -> false,
      };
    }

    /// Folds `@splat<T[N]>(value)` at `exprId` into `parts`. A zero value is
    /// one `Zero` of the array type, however large it is. Any other value folds
    /// once against the element type and is written `N` times inside the
    /// brackets of the array, which is false, with the call recorded in
    /// `report`, past `ARRAY_EXPANSION_LIMIT` elements.
    function evalSplatParts(
      values: &mut Analyzer::ConstEval::ConstValueMap,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprId: Ast::ExpressionId,
      call: &Ast::Expression::BuiltinCall,
      report: &mut Analyzer::ConstEval::FoldReport,
      parts: &mut Vector<Analyzer::ConstEval::ConstPart>,
    ): boolean {
      let Option::SOME(arrayType) = Analyzer::ConstEval::exprTypeOf(typecheck, exprId) else {
        return false;
      };

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, arrayType);
      let mut elementType: Option<Analyzer::TypeId> = Option::NONE;
      let mut size: u64 = 0;

      if (let Option::SOME(Analyzer::Type::FixedArray(element, count)) = typeStore.get(resolved.typeId)) {
        elementType = Option::SOME(element);
        size = count;
      }

      let Option::SOME(element) = elementType else {
        return false;
      };

      let Option::SOME(valueId) = call.arguments.get(0) else {
        return false;
      };

      let mut elementParts: Vector<Analyzer::ConstEval::ConstPart> = Vector::new<Analyzer::ConstEval::ConstPart>();

      if (!Analyzer::ConstEval::evalInitializerParts(values, defStore, typeStore, symbols, module, resolvedBodies, typecheck, *valueId, element, report, &mut elementParts)) {
        return false;
      }

      let mut partsRef: &mut Vector<Analyzer::ConstEval::ConstPart> = parts;

      if (Analyzer::ConstEval::isZeroParts(&elementParts)) {
        partsRef.push(Analyzer::ConstEval::ConstPart::Zero(arrayType));

        return true;
      }

      if (size > Analyzer::Typecheck::ARRAY_EXPANSION_LIMIT) {
        let mut reportRef: &mut Analyzer::ConstEval::FoldReport = report;
        reportRef.oversizedSplat = Option::SOME(call.span);
        reportRef.oversizedLength = size;

        return false;
      }

      partsRef.push(Analyzer::ConstEval::ConstPart::Open);

      let mut copyIndex: u64 = 0;

      while (copyIndex < size) {
        let mut partIndex: u64 = 0;

        while (partIndex < elementParts.length()) {
          if (let Option::SOME(part) = elementParts.get(partIndex)) {
            partsRef.push(Analyzer::ConstEval::copyConstPart(part));
          }

          partIndex += 1;
        }

        copyIndex += 1;
      }

      partsRef.push(Analyzer::ConstEval::ConstPart::Close);

      return true;
    }

    /// Whether `parts` is exactly one `Zero`.
    function isSingleZero(parts: &Vector<Analyzer::ConstEval::ConstPart>): boolean {
      if (parts.length() != 1) {
        return false;
      }

      if (let Option::SOME(Analyzer::ConstEval::ConstPart::Zero(_)) = parts.get(0)) {
        return true;
      }

      return false;
    }

    /// Folds `@zeroed<T>()` at `exprId` into `parts`: the scalar zero of `T`, or
    /// one `Zero` part for storage of an aggregate type. False when typecheck
    /// recorded no type for the call, which it reports itself.
    function evalZeroedParts(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprId: Ast::ExpressionId,
      parts: &mut Vector<Analyzer::ConstEval::ConstPart>,
    ): boolean {
      let Option::SOME(zeroType) = Analyzer::ConstEval::exprTypeOf(typecheck, exprId) else {
        return false;
      };

      let mut partsRef: &mut Vector<Analyzer::ConstEval::ConstPart> = parts;

      if (let Option::SOME(scalar) = Analyzer::ConstEval::scalarZeroValue(defStore, typeStore, zeroType)) {
        partsRef.push(Analyzer::ConstEval::ConstPart::Value(scalar, zeroType));
        return true;
      }

      partsRef.push(Analyzer::ConstEval::ConstPart::Zero(zeroType));

      return true;
    }

    /// Folds the array range `[a..b]` into one `Value` per integer it yields,
    /// inside the brackets of the array it initializes. False when the range
    /// does not yield exactly `arraySize` values, which the typechecker has
    /// already reported against the declared type.
    function evalArrayRangeParts(
      module: &Ast::Module,
      rangeId: Ast::ExpressionId,
      elementType: Analyzer::TypeId,
      arraySize: u64,
      parts: &mut Vector<Analyzer::ConstEval::ConstPart>,
    ): boolean {
      let Option::SOME(Ast::Expression::Node::Range(range)) = module.expressions.get(rangeId) else {
        return false;
      };
      let Option::SOME(startId) = range.start else {
        return false;
      };
      let Option::SOME(endId) = range.end else {
        return false;
      };
      let Option::SOME(start) = Analyzer::Typecheck::arrayRangeBound(module, startId) else {
        return false;
      };
      let Option::SOME(end) = Analyzer::Typecheck::arrayRangeBound(module, endId) else {
        return false;
      };

      if (Analyzer::Typecheck::arrayRangeLength(&start, &end, range.inclusive) != arraySize) {
        return false;
      }

      let mut partsRef: &mut Vector<Analyzer::ConstEval::ConstPart> = parts;
      partsRef.push(Analyzer::ConstEval::ConstPart::Open);

      let mut offset: u64 = 0;

      while (offset < arraySize) {
        let value: Analyzer::Typecheck::ArrayRangeBound = Analyzer::Typecheck::arrayRangeBoundAt(&start, offset);
        let mut folded: i64 = value.magnitude as i64;

        if (value.negative) {
          folded = (0 - ((value.magnitude - 1) as i64)) - 1;
        }

        partsRef.push(Analyzer::ConstEval::ConstPart::Value(Analyzer::ConstEval::ConstValue::Int(folded), elementType));
        offset += 1;
      }

      partsRef.push(Analyzer::ConstEval::ConstPart::Close);

      return true;
    }

    /// The index and declared type of the instance field `name` of the record
    /// `recordDefId`.
    record RecordFieldInfo {
      public index: u32;
      public fieldType: Analyzer::TypeId;
    }

    function recordFieldNamed(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      recordDefId: Analyzer::DefinitionId,
      name: str,
    ): Option<Analyzer::ConstEval::RecordFieldInfo> {
      let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(recordDefId)) {
        fields = Analyzer::Resolver::copyDefinitionIdVector(&recordDef.fields);
      }

      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let target: Analyzer::SymbolId = symbolsRef.intern(name);
      let mut index: u64 = 0;

      while (index < fields.length()) {
        if (let Option::SOME(fieldDefId) = fields.get(index)) {
          if (let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldDefId)) {
            if (fieldDef.name.raw() == target.raw()) {
              return Option::SOME(Analyzer::ConstEval::RecordFieldInfo { index: fieldDef.index, fieldType: fieldDef.fieldType });
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// A0230 at the initializer of the `static mut` field `fieldName`.
    function reportNonConstantStaticMut(
      diagnostics: &mut DiagnosticBag,
      module: &Ast::Module,
      initializer: Ast::ExpressionId,
      fieldName: &String,
    ): void {
      let Option::SOME(node) = module.expressions.get(initializer) else {
        return;
      };

      let span: SourceSpan = Ast::Serializer::expressionSpan(node);
      let message: String = `'static mut' field '${fieldName.toStr()}' needs a constant initializer`;
      let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::STATIC_MUT_NON_CONSTANT_INITIALIZER, message.toStr(), span);
      diagnostic.addLabel(LabelKind::PRIMARY, span, "only literals, constants, and array or record literals of them are constant");

      let mut bag: &mut DiagnosticBag = diagnostics;
      bag.push(diagnostic);
    }

    /// Folds a module constant whose initializer is an array or record literal of
    /// constants, so taking its address can name a read-only global. Anything
    /// else that did not fold as a scalar is left to its uses.
    function evalConstantAggregate(
      values: &mut Analyzer::ConstEval::ConstValueMap,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      defId: Analyzer::DefinitionId,
      initializer: Ast::ExpressionId,
      diagnostics: &mut DiagnosticBag,
    ): void {
      let mut declaredType: Option<Analyzer::TypeId> = Option::NONE;

      if (let Option::SOME(Analyzer::Definition::Variable(variableDef)) = defStore.get(defId)) {
        declaredType = Option::SOME(variableDef.declaredType);
      }

      let Option::SOME(storageType) = declaredType else {
        return;
      };

      let mut parts: Vector<Analyzer::ConstEval::ConstPart> = Vector::new<Analyzer::ConstEval::ConstPart>();
      let mut report: Analyzer::ConstEval::FoldReport = Analyzer::ConstEval::FoldReport::none();
      let folded: boolean = Analyzer::ConstEval::evalInitializerParts(
        values,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        typecheck,
        initializer,
        storageType,
        &mut report,
        &mut parts,
      );

      if (!folded) {
        let _reported: boolean = Analyzer::ConstEval::reportOversizedSplat(diagnostics, &report);

        return;
      }

      if (parts.length() < 2 && !Analyzer::ConstEval::isSingleZero(&parts)) {
        return;
      }

      Analyzer::ConstEval::insertConstAggregate(values, defId.raw(), parts);
    }

    /// Evaluate one item: constants fold, namespaces recurse, exports unwrap,
    /// everything else is skipped (mirroring the pass-2 binder walk).
    function evalItem(
      values: &mut Analyzer::ConstEval::ConstValueMap,
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      itemId: Ast::ItemId,
    ): void {
      let Option::SOME(item) = module.items.get(itemId) else {
        return;
      };

      match (item) {
        Ast::Item::Node::Constant(constant) -> {
          let Option::SOME(defId) = Analyzer::ConstEval::constantItemDef(pass1, pass2, itemId) else {
            return;
          };

          let valueOpt: Option<Analyzer::ConstEval::ConstValue> = Analyzer::ConstEval::evalExpression(
            values,
            defStore,
            typeStore,
            module,
            resolvedBodies,
            typecheck,
            constant.value,
          );

          if (let Option::SOME(value) = valueOpt) {
            Analyzer::ConstEval::insertConstValue(values, defId.raw(), value);
            return;
          }

          Analyzer::ConstEval::evalConstantAggregate(
            values,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            typecheck,
            defId,
            constant.value,
            diagnostics,
          );
        },
        Ast::Item::Node::Record(recordItem) -> {
          Analyzer::ConstEval::evalOwnerStaticFields(
            values,
            diagnostics,
            defStore,
            typeStore,
            symbols,
            module,
            pass1,
            pass2,
            resolvedBodies,
            typecheck,
            itemId,
            &recordItem.fields,
            false,
          );
        },
        Ast::Item::Node::Enum(enumItem) -> {
          Analyzer::ConstEval::evalOwnerStaticFields(
            values,
            diagnostics,
            defStore,
            typeStore,
            symbols,
            module,
            pass1,
            pass2,
            resolvedBodies,
            typecheck,
            itemId,
            &enumItem.variants,
            true,
          );
        },
        Ast::Item::Node::Namespace(namespaceItem) -> {
          Analyzer::ConstEval::evalItems(
            values,
            diagnostics,
            defStore,
            typeStore,
            symbols,
            module,
            pass1,
            pass2,
            resolvedBodies,
            typecheck,
            &namespaceItem.items,
          );
        },
        Ast::Item::Node::Export(exportItem) -> {
          if (let Option::SOME(innerItemId) = exportItem.declaration) {
            Analyzer::ConstEval::evalItem(
              values,
              diagnostics,
              defStore,
              typeStore,
              symbols,
              module,
              pass1,
              pass2,
              resolvedBodies,
              typecheck,
              innerItemId,
            );
          }
        },
        _ -> {},
      };
    }

    function evalItems(
      values: &mut Analyzer::ConstEval::ConstValueMap,
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      itemIds: &Vector<Ast::ItemId>,
    ): void {
      let mut index: u64 = 0;

      while (index < itemIds.length()) {
        let Option::SOME(itemId) = itemIds.get(index) else {
          index += 1;
          continue;
        };

        Analyzer::ConstEval::evalItem(
          values,
          diagnostics,
          defStore,
          typeStore,
          symbols,
          module,
          pass1,
          pass2,
          resolvedBodies,
          typecheck,
          *itemId,
        );

        index += 1;
      }
    }

    /// Const-eval phase entry point. Walks the module's root items in
    /// declaration order; that ordering is the cycle protection, because a
    /// reference to a not-yet-evaluated constant is simply not const.
    function evalModule(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
    ): Analyzer::ConstEval::ConstEvalOutput {
      let mut values: Analyzer::ConstEval::ConstValueMap = Analyzer::ConstEval::ConstValueMap::empty();
      let mut diagnostics: DiagnosticBag = DiagnosticBag::init();

      Analyzer::ConstEval::evalItems(
        &mut values,
        &mut diagnostics,
        defStore,
        typeStore,
        symbols,
        module,
        pass1,
        pass2,
        resolvedBodies,
        typecheck,
        &module.roots,
      );

      return Analyzer::ConstEval::ConstEvalOutput {
        diagnostics: diagnostics,
        values: values,
      };
    }
  }
}
