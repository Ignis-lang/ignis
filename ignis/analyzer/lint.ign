import
  SourceSpan,
  Diagnostic,
  DiagnosticBag,
  Severity,
  DiagnosticCode,
  LabelKind,
from "@compiler::diagnostics";

import Ast from "@compiler::ast";
import Id from "@compiler::ids";
import Vector from "std::vector";

/// Lint phase for the Ignis selfhost compiler.
///
/// Port of `crates/ignis_analyzer/src/lint.rs`. Runs after the extra-checks
/// phase, and reports in the oracle's order: unused variable, unused `mut`,
/// unused import, deprecated call.
///
/// Ported lints:
///   - unused import (A0123): an entry of the current module's direct-import
///     overlay whose definition is never referenced by the module. The Rust
///     oracle checks `referenced_defs`, which every resolution site feeds
///     (expressions, patterns, and type annotations). The selfhost
///     equivalent combines three sources: `ResolvedRef::Definition` entries
///     under expression keys and pattern keys of `bodyResolution`, one
///     owner hop for member refs (a `Vec::create` path records the static
///     method's def, so its owner — the imported record — counts as used,
///     mirroring the oracle's owner marking at resolution time), and a
///     syntactic scan of type-annotation paths (the selfhost type resolver
///     keeps no use side-table, so an import used only as a type is matched
///     by its local name in head position of a `Type::Path`).
///   - deprecated call (A0124): an expression reference to a function or
///     method definition carrying `@deprecated`. Mirrors the Rust
///     `lint_deprecated_calls` wording and its `(def, span.start)` dedup.
///     Instance method calls (`value.method()`) are resolved by the
///     typechecker without a `bodyResolution` entry (ADR-B7), so deprecation
///     covers functions and methods referenced through paths (static calls);
///     deprecated instance-method receivers are a follow-up.
///   - unused variable (A0122): a local binding that is never read. Local
///     bindings are not definitions in the selfhost analyzer, so the
///     declaration log and the read set both come from the typechecker's
///     `LocalBindingUses` side-table, keyed by binding-site `PatternId`
///     because `LocalId` indexes are reused across sibling scopes (ADR-B10).
///     Parameters are excluded here rather than at the recording site: they
///     are syntactically identifiable (an item's `parameters` vector, a
///     lambda's `parameters` vector), and the oracle models them as
///     `DefinitionKind::Parameter`, which neither unused lint looks at.
///   - unused mut (A0127): a `mut` local binding that is never the root of a
///     mutation. The mutation set is recorded by the typechecker, the only
///     phase that sees assignment targets, `&mut` borrows and `mut self`
///     receivers.
///
/// Lint levels come from module-flat `@allow`/`@warn`/`@deny` directives on
/// top-level functions (including exported ones), matching the Rust
/// `collect_lint_directives`: the overrides are collected into one flat list
/// and the effective level is the last matching entry, defaulting to `WARN`.
/// Scoped overrides are deliberately not implemented — the oracle has none.
///
/// Scoped out relative to the Rust oracle:
///   - prefix `++`/`--` are not mutation sites in the oracle either, and the
///     selfhost typechecker rejects the postfix forms outright, so neither
///     feeds the mutation set.
export namespace Analyzer {
  namespace Lint {
    /// Output of the lint phase.
    record LintOutput {
      public diagnostics: DiagnosticBag;
    }

    /// The lints a directive can name, spelled as in the Rust `LintId`.
    enum LintKind {
      UNUSED_VARIABLE,
      UNUSED_IMPORT,
      UNUSED_MUT,
      DEPRECATED,
    }

    /// Reporting level for one lint. `ALLOW` suppresses the lint entirely.
    enum LintLevel {
      ALLOW,
      WARN,
      DENY,
    }

    /// Module-flat lint level overrides, in source order (ADR-1 parallel
    /// vectors). `effectiveLevel` scans them backwards, so a later directive
    /// wins over an earlier one.
    record LintOverrides {
      public kinds: Vector<Analyzer::Lint::LintKind>;
      public levels: Vector<Analyzer::Lint::LintLevel>;
    }

    function emitLint(
      diagnostics: &mut DiagnosticBag,
      severity: Severity,
      span: SourceSpan,
      code: str,
      message: str,
      labelMessage: str,
    ): void {
      let mut diagnostic: Diagnostic = Diagnostic::new(
        severity,
        code,
        message,
        span,
      );
      diagnostic.addLabel(LabelKind::PRIMARY, span, labelMessage);

      let mut bag: &mut DiagnosticBag = diagnostics;
      bag.push(diagnostic);
    }

    function emitWarning(
      diagnostics: &mut DiagnosticBag,
      span: SourceSpan,
      code: str,
      message: str,
      labelMessage: str,
    ): void {
      Analyzer::Lint::emitLint(diagnostics, Severity::WARNING, span, code, message, labelMessage);
    }

    /// The reporting severity for an enabled lint. `ALLOW` never reaches here:
    /// callers return before emitting anything.
    function levelSeverity(level: Analyzer::Lint::LintLevel): Severity {
      return match (level) {
        Analyzer::Lint::LintLevel::ALLOW -> Severity::WARNING,
        Analyzer::Lint::LintLevel::WARN -> Severity::WARNING,
        Analyzer::Lint::LintLevel::DENY -> Severity::ERROR,
      };
    }

    /// The level in force for `kind`: the last matching override, or `WARN`.
    function effectiveLevel(
      overrides: &Analyzer::Lint::LintOverrides,
      kind: Analyzer::Lint::LintKind,
    ): Analyzer::Lint::LintLevel {
      let mut index: u64 = overrides.kinds.length();

      while (index > 0) {
        index -= 1;

        let Option::SOME(candidate) = overrides.kinds.get(index) else {
          continue;
        };

        if (*candidate != kind) {
          continue;
        }

        let Option::SOME(level) = overrides.levels.get(index) else {
          continue;
        };

        return *level;
      }

      return Analyzer::Lint::LintLevel::WARN;
    }

    /// The level an attribute name selects, or `NONE` when the attribute is
    /// not a lint directive.
    function directiveLevel(name: &String): Option<Analyzer::Lint::LintLevel> {
      if (name.equals("allow")) {
        return Option::SOME(Analyzer::Lint::LintLevel::ALLOW);
      }
      if (name.equals("warn")) {
        return Option::SOME(Analyzer::Lint::LintLevel::WARN);
      }
      if (name.equals("deny")) {
        return Option::SOME(Analyzer::Lint::LintLevel::DENY);
      }

      return Option::NONE;
    }

    /// The lint a directive argument names, or `NONE` when it names none.
    function directiveLintKind(argument: &String): Option<Analyzer::Lint::LintKind> {
      if (argument.equals("unused_variable")) {
        return Option::SOME(Analyzer::Lint::LintKind::UNUSED_VARIABLE);
      }
      if (argument.equals("unused_import")) {
        return Option::SOME(Analyzer::Lint::LintKind::UNUSED_IMPORT);
      }
      if (argument.equals("unused_mut")) {
        return Option::SOME(Analyzer::Lint::LintKind::UNUSED_MUT);
      }
      if (argument.equals("deprecated")) {
        return Option::SOME(Analyzer::Lint::LintKind::DEPRECATED);
      }

      return Option::NONE;
    }

    /// Read the lint directives of one attribute list into `overrides`.
    ///
    /// Mirrors the Rust `bind_lint_directives`: a directive must carry exactly
    /// one argument, and that argument must name a known lint; both failures
    /// are errors and the directive is dropped.
    function collectAttributeDirectives(
      diagnostics: &mut DiagnosticBag,
      overrides: &mut Analyzer::Lint::LintOverrides,
      attributes: &Vector<Ast::Attribute>,
    ): void {
      let mut index: u64 = 0;

      while (index < attributes.length()) {
        let Option::SOME(attribute) = attributes.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(level) = Analyzer::Lint::directiveLevel(&attribute.name) else {
          index += 1;
          continue;
        };

        if (attribute.arguments.length() != 1) {
          let message: String = String::create("@")
            .concat(attribute.name.toStr())
            .concat(" expects 1 argument(s), got ")
            .concat(attribute.arguments.length());
          Analyzer::Lint::emitLint(
            diagnostics,
            Severity::ERROR,
            attribute.span,
            DiagnosticCode::ATTRIBUTE_ARG_COUNT,
            message.toStr(),
            message.toStr(),
          );
          index += 1;
          continue;
        }

        let Option::SOME(argument) = attribute.arguments.get(0) else {
          index += 1;
          continue;
        };

        let Option::SOME(kind) = Analyzer::Lint::directiveLintKind(argument) else {
          let message: String = String::create("unknown lint '").concat(argument.toStr()).concat("'");
          Analyzer::Lint::emitLint(
            diagnostics,
            Severity::ERROR,
            attribute.span,
            DiagnosticCode::UNKNOWN_LINT,
            message.toStr(),
            message.toStr(),
          );
          index += 1;
          continue;
        };

        let mut overridesRef: &mut Analyzer::Lint::LintOverrides = overrides;
        overridesRef.kinds.push(kind);
        overridesRef.levels.push(level);
        index += 1;
      }
    }

    /// Collect the module's lint directives from top-level function
    /// attributes, including functions wrapped in an `export` declaration.
    /// The result is flat: the Rust oracle pushes every directive it finds
    /// into one module-wide list without ever popping it.
    function collectLintDirectives(
      diagnostics: &mut DiagnosticBag,
      module: &Ast::Module,
    ): Analyzer::Lint::LintOverrides {
      let mut overrides: Analyzer::Lint::LintOverrides = Analyzer::Lint::LintOverrides {
        kinds: Vector::new<Analyzer::Lint::LintKind>(),
        levels: Vector::new<Analyzer::Lint::LintLevel>(),
      };

      let mut index: u64 = 0;

      while (index < module.roots.length()) {
        let Option::SOME(rootId) = module.roots.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(item) = module.items.get(*rootId) else {
          index += 1;
          continue;
        };

        if (let Ast::Item::Node::Function(function_) = item) {
          Analyzer::Lint::collectAttributeDirectives(diagnostics, &mut overrides, &function_.metadata.attributes);
          index += 1;
          continue;
        }

        if (let Ast::Item::Node::Export(exported) = item) {
          if (let Option::SOME(declarationId) = exported.declaration) {
            if (let Option::SOME(declaration) = module.items.get(declarationId)) {
              if (let Ast::Item::Node::Function(function_) = declaration) {
                Analyzer::Lint::collectAttributeDirectives(diagnostics, &mut overrides, &function_.metadata.attributes);
              }
            }
          }
        }

        index += 1;
      }

      return overrides;
    }

    function usedContains(used: &Vector<u32>, defRaw: u32): boolean {
      let mut index: u64 = 0;

      while (index < used.length()) {
        let Option::SOME(existing) = used.get(index) else {
          index += 1;
          continue;
        };

        if (*existing == defRaw) {
          return true;
        }

        index += 1;
      }

      return false;
    }

    function markUsed(used: &mut Vector<u32>, defRaw: u32): void {
      let mut index: u64 = 0;

      while (index < used.length()) {
        let Option::SOME(existing) = used.get(index) else {
          index += 1;
          continue;
        };

        if (*existing == defRaw) {
          return;
        }

        index += 1;
      }

      let mut usedRef: &mut Vector<u32> = used;
      usedRef.push(defRaw);
    }

    /// Mark a resolved definition as referenced. Member definitions also mark
    /// their owner: a `Owner::member` path records only the member's def in
    /// `bodyResolution`, while the Rust resolver marks the owner referenced
    /// when it resolves the qualifier.
    function markResolvedDefUsed(
      used: &mut Vector<u32>,
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): void {
      Analyzer::Lint::markUsed(used, defId.raw());

      let Option::SOME(def) = defStore.get(defId) else {
        return;
      };

      match (def) {
        Analyzer::Definition::Method(method) -> {
          Analyzer::Lint::markUsed(used, method.owner.raw());
        },
        Analyzer::Definition::Variant(variant) -> {
          Analyzer::Lint::markUsed(used, variant.owner.raw());
        },
        Analyzer::Definition::Field(field) -> {
          Analyzer::Lint::markUsed(used, field.owner.raw());
        },
        Analyzer::Definition::TypeParam(typeParam) -> {
          Analyzer::Lint::markUsed(used, typeParam.owner.raw());
        },
        _ -> {},
      };
    }

    /// Raw definition ids referenced by the module's bodies: every
    /// `ResolvedRef::Definition` under an expression key or a pattern key of
    /// `bodyResolution`, plus one owner hop per member ref.
    function collectUsedDefs(
      defStore: &mut Analyzer::DefinitionStore,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
    ): Vector<u32> {
      let mut used: Vector<u32> = Vector::new<u32>();

      let mut exprIndex: u64 = 0;
      while (exprIndex < module.expressions.length()) {
        let exprRef: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::ResolverBodies::findExprRef(
          &resolvedBodies.bodyResolution,
          exprIndex as u32,
        );

        if (let Option::SOME(resolvedRef) = exprRef) {
          if (let Analyzer::ResolverBodies::ResolvedRef::Definition(defId) = &resolvedRef) {
            Analyzer::Lint::markResolvedDefUsed(&mut used, defStore, defId);
          }
        }

        exprIndex += 1;
      }

      let mut patternIndex: u64 = 0;
      while (patternIndex < module.patterns.length()) {
        let patternRef: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::ResolverBodies::findPatternRef(
          &resolvedBodies.bodyResolution,
          patternIndex as u32,
        );

        if (let Option::SOME(resolvedRef) = patternRef) {
          if (let Analyzer::ResolverBodies::ResolvedRef::Definition(defId) = &resolvedRef) {
            Analyzer::Lint::markResolvedDefUsed(&mut used, defStore, defId);
          }
        }

        patternIndex += 1;
      }

      return used;
    }

    /// Whether any type annotation in the module names `name` in head
    /// position of a `Type::Path`. Composite types (`Generic`, `Reference`,
    /// `Slice`, ...) store their inner types as separate nodes in the same
    /// store, so scanning `Path` nodes alone covers every spelling.
    function nameUsedInTypePosition(module: &Ast::Module, name: str): boolean {
      let mut index: u64 = 0;

      while (index < module.types.length()) {
        let typeId: Ast::TypeId = Id::fromRaw<Ast::TypeTag>(index as u32);
        let Option::SOME(typeNode) = module.types.get(typeId) else {
          index += 1;
          continue;
        };

        if (let Ast::Type::Node::Path(path) = typeNode) {
          if (let Option::SOME(headSegment) = path.segments.get(0)) {
            if (headSegment.equals(name)) {
              return true;
            }
          }
        }

        index += 1;
      }

      return false;
    }

    /// Raw `PatternId`s of every function, method and lambda parameter in the
    /// module. Parameters are bound as locals by the typechecker but the Rust
    /// oracle stores them as `DefinitionKind::Parameter`, which neither the
    /// unused-variable nor the unused-mut lint inspects.
    function collectParameterPatterns(module: &Ast::Module): Vector<u32> {
      let mut patterns: Vector<u32> = Vector::new<u32>();

      let mut itemIndex: u64 = 0;
      while (itemIndex < module.items.length()) {
        let itemId: Ast::ItemId = Id::fromRaw<Ast::ItemTag>(itemIndex as u32);
        let Option::SOME(item) = module.items.get(itemId) else {
          itemIndex += 1;
          continue;
        };

        if (let Ast::Item::Node::Function(function_) = item) {
          Analyzer::Lint::appendPatternRaws(&mut patterns, &function_.parameters);
        }

        itemIndex += 1;
      }

      let mut exprIndex: u64 = 0;
      while (exprIndex < module.expressions.length()) {
        let exprId: Ast::ExpressionId = Id::fromRaw<Ast::ExpressionTag>(exprIndex as u32);
        let Option::SOME(expression) = module.expressions.get(exprId) else {
          exprIndex += 1;
          continue;
        };

        if (let Ast::Expression::Node::Lambda(lambda) = expression) {
          Analyzer::Lint::appendPatternRaws(&mut patterns, &lambda.parameters);
        }

        exprIndex += 1;
      }

      return patterns;
    }

    function appendPatternRaws(
      target: &mut Vector<u32>,
      patternIds: &Vector<Ast::PatternId>,
    ): void {
      let mut index: u64 = 0;
      let mut targetRef: &mut Vector<u32> = target;

      while (index < patternIds.length()) {
        let Option::SOME(patternId) = patternIds.get(index) else {
          index += 1;
          continue;
        };

        targetRef.push(patternId.raw());
        index += 1;
      }
    }

    /// The declared name of a binding pattern, or `NONE` when the id does not
    /// name a `Pattern::Binding`.
    function bindingPatternName(module: &Ast::Module, patternRaw: u32): Option<String> {
      let patternId: Ast::PatternId = Id::fromRaw<Ast::PatternTag>(patternRaw);
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return Option::NONE;
      };

      if (let Ast::Pattern::Node::Binding(binding) = pattern) {
        return Option::SOME(binding.name.clone());
      }

      return Option::NONE;
    }

    /// Whether a binding name opts out of the unused lints by starting with
    /// `_`, mirroring the oracle's `name.starts_with('_')`.
    function nameIsUnderscorePrefixed(name: &String): boolean {
      return match (name.byteAt(0)) {
        Option::SOME(byte) -> byte == '_' as u8,
        Option::NONE -> false,
      };
    }

    /// Unused-variable lint (A0122). Reports every logged local binding that
    /// is not a parameter, does not start with `_`, and was never read.
    function lintUnusedVariables(
      diagnostics: &mut DiagnosticBag,
      module: &Ast::Module,
      localUses: &Analyzer::Typecheck::LocalBindingUses,
      parameterPatterns: &Vector<u32>,
      severity: Severity,
    ): void {
      let mut index: u64 = 0;

      while (index < localUses.patterns.length()) {
        let Option::SOME(patternRaw) = localUses.patterns.get(index) else {
          index += 1;
          continue;
        };

        if (Analyzer::Lint::usedContains(parameterPatterns, *patternRaw)) {
          index += 1;
          continue;
        }

        if (Analyzer::Lint::usedContains(&localUses.referenced, *patternRaw)) {
          index += 1;
          continue;
        }

        let Option::SOME(name) = Analyzer::Lint::bindingPatternName(module, *patternRaw) else {
          index += 1;
          continue;
        };

        if (Analyzer::Lint::nameIsUnderscorePrefixed(&name)) {
          index += 1;
          continue;
        }

        let Option::SOME(span) = localUses.spans.get(index) else {
          index += 1;
          continue;
        };

        let message: String = String::create("unused variable '").concat(name.toStr()).concat("'");
        Analyzer::Lint::emitLint(
          diagnostics,
          severity,
          *span,
          DiagnosticCode::UNUSED_VARIABLE,
          message.toStr(),
          message.toStr(),
        );

        index += 1;
      }
    }

    /// Unused-mut lint (A0127). Reports every logged `mut` local binding that
    /// is never the root of a mutation.
    ///
    /// `self` is exempt like in the oracle: `&mut self` describes what the
    /// caller must hold, not whether the receiver is reassigned in the body.
    function lintUnusedMut(
      diagnostics: &mut DiagnosticBag,
      module: &Ast::Module,
      localUses: &Analyzer::Typecheck::LocalBindingUses,
      parameterPatterns: &Vector<u32>,
      severity: Severity,
    ): void {
      let mut index: u64 = 0;

      while (index < localUses.patterns.length()) {
        let Option::SOME(patternRaw) = localUses.patterns.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(mutable) = localUses.mutableFlags.get(index) else {
          index += 1;
          continue;
        };
        if (!*mutable) {
          index += 1;
          continue;
        }

        if (Analyzer::Lint::usedContains(parameterPatterns, *patternRaw)) {
          index += 1;
          continue;
        }

        if (Analyzer::Lint::usedContains(&localUses.mutated, *patternRaw)) {
          index += 1;
          continue;
        }

        let Option::SOME(name) = Analyzer::Lint::bindingPatternName(module, *patternRaw) else {
          index += 1;
          continue;
        };

        if (name.equals("self")) {
          index += 1;
          continue;
        }

        if (Analyzer::Lint::nameIsUnderscorePrefixed(&name)) {
          index += 1;
          continue;
        }

        let Option::SOME(span) = localUses.spans.get(index) else {
          index += 1;
          continue;
        };

        let message: String = String::create("variable '").concat(name.toStr()).concat("' does not need to be mutable");
        Analyzer::Lint::emitLint(
          diagnostics,
          severity,
          *span,
          DiagnosticCode::UNUSED_MUT,
          message.toStr(),
          message.toStr(),
        );

        index += 1;
      }
    }

    /// Unused-import lint (A0123). Iterates the current module's overlay
    /// only — imports owned by other modules are never reported here,
    /// mirroring the Rust per-module `imported_defs` iteration.
    function lintUnusedImports(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      overlay: &Analyzer::Imports::ImportOverlay,
      severity: Severity,
    ): void {
      let used: Vector<u32> = Analyzer::Lint::collectUsedDefs(defStore, module, resolvedBodies);
      let mut index: u64 = 0;

      while (index < overlay.syms.length()) {
        let Option::SOME(defId) = overlay.defs.get(index) else {
          index += 1;
          continue;
        };

        if (Analyzer::Lint::usedContains(&used, defId.raw())) {
          index += 1;
          continue;
        }

        let Option::SOME(sym) = overlay.syms.get(index) else {
          index += 1;
          continue;
        };
        let name: str = match (symbols.resolve(*sym)) {
          Option::SOME(resolved) -> resolved,
          Option::NONE -> "<unknown>",
        };

        if (Analyzer::Lint::nameUsedInTypePosition(module, name)) {
          index += 1;
          continue;
        }

        let Option::SOME(importSpan) = overlay.spans.get(index) else {
          index += 1;
          continue;
        };

        let message: String = String::create("unused import '").concat(name).concat("'");
        Analyzer::Lint::emitLint(
          diagnostics,
          severity,
          *importSpan,
          DiagnosticCode::UNUSED_IMPORT,
          message.toStr(),
          message.toStr(),
        );

        index += 1;
      }
    }

    /// Whether the definition is a function or method marked `@deprecated`.
    function defIsDeprecated(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): boolean {
      let Option::SOME(def) = defStore.get(defId) else {
        return false;
      };

      return match (def) {
        Analyzer::Definition::Function(function_) -> function_.isDeprecated,
        Analyzer::Definition::Method(method) -> method.isDeprecated,
        _ -> false,
      };
    }

    /// The deprecation message of a deprecated function or method; empty when
    /// `@deprecated` carries no argument (mirrors the Rust
    /// `unwrap_or_default`).
    function defDeprecationMessage(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): String {
      let Option::SOME(def) = defStore.get(defId) else {
        return String::new();
      };

      match (def) {
        Analyzer::Definition::Function(function_) -> {
          if (let Option::SOME(message) = &function_.deprecatedMessage) {
            return message.clone();
          }
        },
        Analyzer::Definition::Method(method) -> {
          if (let Option::SOME(message) = &method.deprecatedMessage) {
            return message.clone();
          }
        },
        _ -> {},
      };

      return String::new();
    }

    function deprecatedSeen(
      seenDefs: &Vector<u32>,
      seenStarts: &Vector<u64>,
      defRaw: u32,
      start: u64,
    ): boolean {
      let mut index: u64 = 0;

      while (index < seenDefs.length()) {
        let Option::SOME(existingDef) = seenDefs.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(existingStart) = seenStarts.get(index) else {
          index += 1;
          continue;
        };

        if (*existingDef == defRaw && *existingStart == start) {
          return true;
        }

        index += 1;
      }

      return false;
    }

    /// Deprecated-call lint (A0124). One warning per `(definition,
    /// span.start)` pair, mirroring the Rust dedup of callee and call-site
    /// entries.
    function lintDeprecatedCalls(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      severity: Severity,
    ): void {
      let mut seenDefs: Vector<u32> = Vector::new<u32>();
      let mut seenStarts: Vector<u64> = Vector::new<u64>();
      let mut exprIndex: u64 = 0;

      while (exprIndex < module.expressions.length()) {
        let exprRef: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::ResolverBodies::findExprRef(
          &resolvedBodies.bodyResolution,
          exprIndex as u32,
        );

        let Option::SOME(resolvedRef) = exprRef else {
          exprIndex += 1;
          continue;
        };
        let Analyzer::ResolverBodies::ResolvedRef::Definition(defId) = resolvedRef else {
          exprIndex += 1;
          continue;
        };

        if (!Analyzer::Lint::defIsDeprecated(defStore, defId)) {
          exprIndex += 1;
          continue;
        }

        let exprId: Ast::ExpressionId = Id::fromRaw<Ast::ExpressionTag>(exprIndex as u32);
        let Option::SOME(expression) = module.expressions.get(exprId) else {
          exprIndex += 1;
          continue;
        };
        let span: SourceSpan = Ast::Serializer::expressionSpan(expression);

        if (Analyzer::Lint::deprecatedSeen(&seenDefs, &seenStarts, defId.raw(), span.start)) {
          exprIndex += 1;
          continue;
        }
        seenDefs.push(defId.raw());
        seenStarts.push(span.start);

        let mut name: str = "<unknown>";
        if (let Option::SOME(def) = defStore.get(defId)) {
          if (let Option::SOME(resolved) = symbols.resolve(def.name())) {
            name = resolved;
          }
        }

        let deprecationMessage: String = Analyzer::Lint::defDeprecationMessage(defStore, defId);
        let message: String = String::create("use of deprecated function '")
          .concat(name)
          .concat("': ")
          .concat(&deprecationMessage);

        Analyzer::Lint::emitLint(
          diagnostics,
          severity,
          span,
          DiagnosticCode::DEPRECATED_CALL,
          message.toStr(),
          message.toStr(),
        );

        exprIndex += 1;
      }
    }

    /// Lint phase entry point. `overlay` must be the current module's own
    /// direct-import overlay.
    ///
    /// Lint order mirrors the Rust `lint_phase`: unused variables, unused
    /// `mut`, unused imports, deprecated calls.
    function lintModule(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      overlay: &Analyzer::Imports::ImportOverlay,
    ): Analyzer::Lint::LintOutput {
      let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
      let overrides: Analyzer::Lint::LintOverrides = Analyzer::Lint::collectLintDirectives(&mut diagnostics, module);
      let parameterPatterns: Vector<u32> = Analyzer::Lint::collectParameterPatterns(module);

      let unusedVariableLevel: Analyzer::Lint::LintLevel = Analyzer::Lint::effectiveLevel(
        &overrides,
        Analyzer::Lint::LintKind::UNUSED_VARIABLE,
      );
      if (unusedVariableLevel != Analyzer::Lint::LintLevel::ALLOW) {
        Analyzer::Lint::lintUnusedVariables(
          &mut diagnostics,
          module,
          &typecheck.localUses,
          &parameterPatterns,
          Analyzer::Lint::levelSeverity(unusedVariableLevel),
        );
      }

      let unusedMutLevel: Analyzer::Lint::LintLevel = Analyzer::Lint::effectiveLevel(
        &overrides,
        Analyzer::Lint::LintKind::UNUSED_MUT,
      );
      if (unusedMutLevel != Analyzer::Lint::LintLevel::ALLOW) {
        Analyzer::Lint::lintUnusedMut(
          &mut diagnostics,
          module,
          &typecheck.localUses,
          &parameterPatterns,
          Analyzer::Lint::levelSeverity(unusedMutLevel),
        );
      }

      let unusedImportLevel: Analyzer::Lint::LintLevel = Analyzer::Lint::effectiveLevel(
        &overrides,
        Analyzer::Lint::LintKind::UNUSED_IMPORT,
      );
      if (unusedImportLevel != Analyzer::Lint::LintLevel::ALLOW) {
        Analyzer::Lint::lintUnusedImports(
          &mut diagnostics,
          defStore,
          symbols,
          module,
          resolvedBodies,
          overlay,
          Analyzer::Lint::levelSeverity(unusedImportLevel),
        );
      }

      let deprecatedLevel: Analyzer::Lint::LintLevel = Analyzer::Lint::effectiveLevel(
        &overrides,
        Analyzer::Lint::LintKind::DEPRECATED,
      );
      if (deprecatedLevel != Analyzer::Lint::LintLevel::ALLOW) {
        Analyzer::Lint::lintDeprecatedCalls(
          &mut diagnostics,
          defStore,
          symbols,
          module,
          resolvedBodies,
          Analyzer::Lint::levelSeverity(deprecatedLevel),
        );
      }

      return Analyzer::Lint::LintOutput {
        diagnostics: diagnostics,
      };
    }
  }
}
