import _ from "./types";
import _ from "./definitions";
import _ from "./symbols";

/// The S2 view-type predicate: one authoritative answer, per `TypeId`, to
/// "is this type a second-class view?".
///
/// A view type borrows storage it does not own: `str` (what `toStr()`, slicing
/// and similar views produce), `&T`, `&mut T`, and slices are views; a record,
/// enum, tuple or fixed array with a field of view type is a view (a `static
/// str` field does not make it one, because a static string owns its bytes); a
/// generic instance is a view when a type argument is (`Vector<str>`,
/// `Option<&T>`) or when a declared field or payload is once the arguments are
/// substituted (`Tagged<i32>` with a `text: str` field). Type aliases are transparent. Raw pointers are not views and are
/// not followed: raw pointers and `extern` functions are the unchecked
/// boundary (S5). A `static str` is not a view. Unresolved `Param`s are not
/// views; after monomorphization the predicate answers on the substituted
/// type.
///
/// Function types (`Function`, `RawFunction`) are not views at the type level:
/// capture information is a property of the closure VALUE, not of the type
/// (function types are interned structurally, so two same-signature closures
/// share one `TypeId`). Whether a concrete closure value is a view is
/// `Analyzer::ViewType::closureIsView` (declared in `view_type_closure.ign`,
/// beside this file) over the HIR captures and the types they carry into the
/// environment. It sits in its own file because this module is part of the
/// analyzer's Hir-free core (the typechecker members that judge `Send` and
/// declared types), which must not depend on `@compiler::hir`; the passes
/// that hold closure nodes (T4b storage/Send, T4c call sites) import it
/// directly. Consequences the enforcement passes own, decided at the node
/// level where the closure value is at hand:
///
/// - An aggregate with a function-typed field is not flagged by `isView` even
///   when the closure stored in it captures by reference; the passes must
///   combine `isView` with `closureIsView` on the closure nodes they inspect.
/// - The `Send` verdict for closure values is likewise node-level, not a
///   property of the function type.
export namespace Analyzer::ViewType {
  /// Whether `typeId` is a second-class view type (S2). Recursive records and
  /// enums terminate: nominal instances currently being visited are skipped on
  /// revisit, which is sound because a revisit can only happen through a
  /// non-view component (a view component answers before recursing). The
  /// guard is keyed on the instance — the definition AND its type arguments —
  /// not the definition alone: `Vector<Vector<str>>` and `Option<Option<&i32>>`
  /// repeat the same definition with different arguments, and a guard on the
  /// definition would prune the inner one before its view argument was seen.
  public function isView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let mut visiting: Vector<Vector<u32>> = Vector::new<Vector<u32>>();
    return ViewType::isViewInner(defStore, typeStore, typeId, &mut visiting);
  }

  function isViewInner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
    visiting: &mut Vector<Vector<u32>>,
  ): boolean {
    let Option::SOME(type_) = typeStore.get(typeId) else {
      return false;
    };

    let mut components: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut nominal: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut isEnum: boolean = false;
    let mut hasTypeArguments: boolean = false;
    let mut aliased: Option<Analyzer::TypeId> = Option::NONE;
    let mut holds: boolean = false;

    match (type_) {
      Analyzer::Type::STR -> {
        holds = true;
      },
      Analyzer::Type::Reference(_) -> {
        holds = true;
      },
      Analyzer::Type::Slice(_) -> {
        holds = true;
      },
      // A `static str` owns its bytes. Raw pointers are the unchecked
      // boundary (S5) and are not followed. Function types carry no capture
      // information; see the module doc comment. Everything else (primitives,
      // `Param`, `Range`) is not a view.
      Analyzer::Type::STATIC_STR | Analyzer::Type::Pointer(_) -> {},
      Analyzer::Type::FixedArray(element, _) -> {
        components.push(element);
      },
      Analyzer::Type::Tuple(tuple) -> {
        components = ViewType::copyTypeIds(&tuple.elements);
      },
      Analyzer::Type::Record(defId) -> {
        nominal = Option::SOME(defId);
      },
      Analyzer::Type::Enum(defId) -> {
        nominal = Option::SOME(defId);
        isEnum = true;
      },
      Analyzer::Type::Instance(instance) -> {
        nominal = Option::SOME(instance.definition);
        components = ViewType::copyTypeIds(&instance.typeArguments);
        isEnum = ViewType::isEnumDefinition(defStore, instance.definition);
        hasTypeArguments = true;
      },
      Analyzer::Type::Alias(aliasDefId) -> {
        aliased = ViewType::aliasedTypeOf(defStore, aliasDefId);
      },
      _ -> {},
    };

    if (holds) {
      return true;
    }

    if (let Option::SOME(target) = aliased) {
      return ViewType::isViewInner(defStore, typeStore, target, visiting);
    }

    if (let Option::SOME(defId) = nominal) {
      let key: Vector<u32> = ViewType::visitKey(defId.raw(), &components);

      if (ViewType::containsKey(&*visiting, &key)) {
        return false;
      }

      let mut visitingRef: &mut Vector<Vector<u32>> = visiting;
      visitingRef.push(key);

      let mut members: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

      if (isEnum) {
        members = ViewType::enumPayloadTypes(defStore, defId);
      } else {
        members = ViewType::recordFieldTypes(defStore, defId);
      }

      // A type argument can be a view the members never mention (`Vector`
      // keeps its elements behind a raw pointer), so the arguments stay
      // components alongside the substituted members.
      let paramSymbols: Vector<Analyzer::SymbolId> = ViewType::typeParamSymbols(defStore, defId);
      let arguments: Vector<Analyzer::TypeId> = ViewType::copyTypeIds(&components);
      let mut memberIndex: u64 = 0;

      while (memberIndex < members.length()) {
        if (let Option::SOME(member) = members.get(memberIndex)) {
          if (hasTypeArguments) {
            let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
            components.push(typeStoreRef.substitute(*member, &paramSymbols, &arguments));
          } else {
            components.push(*member);
          }
        }

        memberIndex += 1;
      }
    }

    let mut index: u64 = 0;

    while (index < components.length()) {
      if (let Option::SOME(component) = components.get(index)) {
        if (ViewType::isViewInner(defStore, typeStore, *component, visiting)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// Whether a value of `typeId` can carry a view another value holds: the
  /// view predicate (`isView`), widened for the types whose view-ness is
  /// decided at the value level, not the type level: a function type at any
  /// depth (a closure's captures are a property of the value,
  /// `closureIsView`, so a record, enum, tuple, array, instance or alias
  /// holding one, or a `&T` to it, can carry the closure's view; a nested
  /// capture-free `fn(A) -> R` cannot), a raw pointer whose pointee can carry
  /// a view (`*str`, `*mut str`, a pointer to a record holding a view or a
  /// closure; not `*u8` or `*mut String`), an
  /// unresolved `Param` (a monomorphized instance may carry a view, and the
  /// borrow check runs before monomorphization) and an unknown type id.
  public function canCarryView(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let Option::SOME(type_) = typeStore.get(typeId) else {
      return true;
    };

    match (type_) {
      Analyzer::Type::Function(_) | Analyzer::Type::RawFunction(_) | Analyzer::Type::Param(_) -> {
        return true;
      },
      _ -> {},
    };

    if (ViewType::isView(defStore, typeStore, typeId)) {
      return true;
    }

    let mut visiting: Vector<Vector<u32>> = Vector::new<Vector<u32>>();
    return ViewType::canReachMutablePlaceInner(defStore, typeStore, typeId, 2, ViewType::NO_OWNED_BUFFER, &mut visiting);
  }

  /// Whether a value of `typeId` can hold something derived from a view, so
  /// a binding or place of this type written by a statement that uses the
  /// view carries it (`canCarryView`, plus a raw pointer at any depth,
  /// whatever its pointee: `text as *u8` points into the view). The raw
  /// pointers the standard owning storage keeps in its fields point to its
  /// own allocation and do not count: `String` (the standard library
  /// record whose definition is `ownedBuffer`, identified by the caller
  /// from its module, never by name) and every type with an `@owns` type parameter
  /// (`Vector`, `HashMap`, `Rc`, ...), whose type arguments decide instead
  /// (`Vector<*u8>` counts). Any other type, a user type with a `Drop`
  /// implementation included, is walked through its fields. The borrow
  /// check runs on monomorphized code, where an instance is a plain record
  /// whose type arguments are read from its instance origin.
  public function canHoldDerived(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
    ownedBuffer: u32,
  ): boolean {
    if (ViewType::canCarryView(defStore, typeStore, typeId)) {
      return true;
    }

    let mut visiting: Vector<Vector<u32>> = Vector::new<Vector<u32>>();
    return ViewType::canReachMutablePlaceInner(defStore, typeStore, typeId, 3, ownedBuffer, &mut visiting);
  }

  /// Whether a value of `typeId` lets the code it is handed to write into a
  /// place it does not own: a `&mut T`, a raw pointer whatever its pointee
  /// (it can be cast back), a closure value (its captures are invisible in
  /// the type), an unresolved `Param` (any of these once substituted), or a
  /// record, enum, tuple, fixed array, slice, instance or alias containing
  /// one, followed through `&T` as well. A capture-free `fn(A) -> R` reaches
  /// nothing. The borrow check keeps a view's borrow to the end of the scope
  /// when the view is handed to a call next to such an operand, since the
  /// callee can store the view there. Recursion is guarded on the instance,
  /// as in `isView`.
  public function canReachMutablePlace(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let mut visiting: Vector<Vector<u32>> = Vector::new<Vector<u32>>();
    return ViewType::canReachMutablePlaceInner(defStore, typeStore, typeId, 0, ViewType::NO_OWNED_BUFFER, &mut visiting);
  }

  /// `canReachMutablePlace` narrowed to places that can hold a view, for the
  /// operand that carries the view itself: a `&mut T` counts only when `T`
  /// can carry a view (`canCarryView`), and a raw pointer only when its
  /// pointee can, so `&mut String` and the `*mut u8` inside a `String` reach
  /// nothing a view could be stored in, while `&mut str`, a `*mut str` field
  /// or a function-typed field next to the view do. Both are followed into
  /// otherwise, as are aggregates, `&T`, instances and aliases.
  public function canReachViewHoldingPlace(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
  ): boolean {
    let mut visiting: Vector<Vector<u32>> = Vector::new<Vector<u32>>();
    return ViewType::canReachMutablePlaceInner(defStore, typeStore, typeId, 1, ViewType::NO_OWNED_BUFFER, &mut visiting);
  }

  /// The shared walker. `mode` 0 answers `canReachMutablePlace`, 1
  /// `canReachViewHoldingPlace`, and 2 the nested part of `canCarryView`,
  /// where a function type, a `Param` or a raw pointer to a view counts, and
  /// raw pointers are followed to their pointee; 3 the nested part of
  /// `canHoldDerived`, where any raw pointer counts and the fields of the
  /// standard owning storage are replaced by its type arguments.
  function canReachMutablePlaceInner(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    typeId: Analyzer::TypeId,
    mode: u8,
    ownedBuffer: u32,
    visiting: &mut Vector<Vector<u32>>,
  ): boolean {
    let Option::SOME(type_) = typeStore.get(typeId) else {
      return true;
    };

    let mut components: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut nominal: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut isEnum: boolean = false;
    let mut hasTypeArguments: boolean = false;

    match (type_) {
      Analyzer::Type::Reference(referenceType) -> {
        if (referenceType.mutable && mode != 2 && mode != 3) {
          if (mode == 0 || ViewType::canCarryView(defStore, typeStore, referenceType.referent)) {
            return true;
          }
        }

        components.push(referenceType.referent);
      },
      Analyzer::Type::Pointer(pointerType) -> {
        if (mode == 3) {
          return true;
        }

        if (mode == 2) {
          if (ViewType::isView(defStore, typeStore, pointerType.pointee)) {
            return true;
          }
        } else if (mode == 0 || ViewType::canCarryView(defStore, typeStore, pointerType.pointee)) {
          return true;
        }

        components.push(pointerType.pointee);
      },
      Analyzer::Type::Function(_) | Analyzer::Type::Param(_) -> {
        return true;
      },
      Analyzer::Type::Slice(element) -> {
        components.push(element);
      },
      Analyzer::Type::FixedArray(element, _) -> {
        components.push(element);
      },
      Analyzer::Type::Tuple(tuple) -> {
        components = ViewType::copyTypeIds(&tuple.elements);
      },
      Analyzer::Type::Record(defId) -> {
        nominal = Option::SOME(defId);
      },
      Analyzer::Type::Enum(defId) -> {
        nominal = Option::SOME(defId);
        isEnum = true;
      },
      Analyzer::Type::Instance(instance) -> {
        nominal = Option::SOME(instance.definition);
        components = ViewType::copyTypeIds(&instance.typeArguments);
        isEnum = ViewType::isEnumDefinition(defStore, instance.definition);
        hasTypeArguments = true;
      },
      Analyzer::Type::Alias(aliasDefId) -> {
        let Option::SOME(target) = ViewType::aliasedTypeOf(defStore, aliasDefId) else {
          return true;
        };

        return ViewType::canReachMutablePlaceInner(defStore, typeStore, target, mode, ownedBuffer, visiting);
      },
      _ -> {},
    };

    if (let Option::SOME(defId) = nominal) {
      let key: Vector<u32> = ViewType::visitKey(defId.raw(), &components);

      if (ViewType::containsKey(&*visiting, &key)) {
        return false;
      }

      let mut visitingRef: &mut Vector<Vector<u32>> = visiting;
      visitingRef.push(key);

      let mut members: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

      let mut owningStorage: boolean = false;

      if (mode == 3) {
        if (let Option::SOME(arguments) = ViewType::owningStorageArguments(defStore, defId, ownedBuffer)) {
          owningStorage = true;
          let mut argumentIndex: u64 = 0;

          while (argumentIndex < arguments.length()) {
            if (let Option::SOME(argument) = arguments.get(argumentIndex)) {
              components.push(*argument);
            }

            argumentIndex += 1;
          }
        }
      }

      if (owningStorage) {
        // The storage's own pointers point to its allocation.
      } else if (isEnum) {
        members = ViewType::enumPayloadTypes(defStore, defId);
      } else {
        members = ViewType::recordFieldTypes(defStore, defId);
      }

      let paramSymbols: Vector<Analyzer::SymbolId> = ViewType::typeParamSymbols(defStore, defId);
      let arguments: Vector<Analyzer::TypeId> = ViewType::copyTypeIds(&components);
      let mut memberIndex: u64 = 0;

      while (memberIndex < members.length()) {
        if (let Option::SOME(member) = members.get(memberIndex)) {
          if (hasTypeArguments) {
            let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
            components.push(typeStoreRef.substitute(*member, &paramSymbols, &arguments));
          } else {
            components.push(*member);
          }
        }

        memberIndex += 1;
      }
    }

    let mut index: u64 = 0;

    while (index < components.length()) {
      if (let Option::SOME(component) = components.get(index)) {
        if (ViewType::canReachMutablePlaceInner(defStore, typeStore, *component, mode, ownedBuffer, visiting)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function copyTypeIds(source: &Vector<Analyzer::TypeId>): Vector<Analyzer::TypeId> {
    let mut copied: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(entry) = source.get(index)) {
        copied.push(*entry);
      }

      index += 1;
    }

    return copied;
  }

  /// Every field type of a record definition, in declaration order.
  function recordFieldTypes(
    defStore: &mut Analyzer::DefinitionStore,
    recordDefId: Analyzer::DefinitionId,
  ): Vector<Analyzer::TypeId> {
    let mut types: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    if (let Option::SOME(definition) = defStore.get(recordDefId)) {
      if (let Analyzer::Definition::Record(recordDef) = definition) {
        let mut index: u64 = 0;

        while (index < recordDef.fields.length()) {
          if (let Option::SOME(fieldId) = recordDef.fields.get(index)) {
            if (let Option::SOME(fieldDefinition) = defStore.get(*fieldId)) {
              if (let Analyzer::Definition::Field(fieldDef) = fieldDefinition) {
                types.push(fieldDef.fieldType);
              }
            }
          }

          index += 1;
        }
      }
    }

    return types;
  }

  /// Every payload type of every variant of an enum definition.
  function enumPayloadTypes(
    defStore: &mut Analyzer::DefinitionStore,
    enumDefId: Analyzer::DefinitionId,
  ): Vector<Analyzer::TypeId> {
    let mut types: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    if (let Option::SOME(definition) = defStore.get(enumDefId)) {
      if (let Analyzer::Definition::Enum(enumDef) = definition) {
        let mut index: u64 = 0;

        while (index < enumDef.variants.length()) {
          if (let Option::SOME(variantId) = enumDef.variants.get(index)) {
            if (let Option::SOME(variantDefinition) = defStore.get(*variantId)) {
              if (let Analyzer::Definition::Variant(variantDef) = variantDefinition) {
                let mut payloadIndex: u64 = 0;

                while (payloadIndex < variantDef.payload.length()) {
                  if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
                    types.push(*payloadType);
                  }

                  payloadIndex += 1;
                }
              }
            }
          }

          index += 1;
        }
      }
    }

    return types;
  }

  /// `ownedBuffer` of the walks that do not skip owning storage.
  const NO_OWNED_BUFFER: u32 = 4294967295;

  /// The type arguments that decide what the standard owning storage `defId`
  /// can hold, when it is one: none for the definition `ownedBuffer`
  /// (`String`); the instance arguments of a monomorphized
  /// instance of a type with an `@owns` type parameter; and none for such a
  /// generic type itself, whose arguments an `Instance` type already lists.
  function owningStorageArguments(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
    ownedBuffer: u32,
  ): Option<Vector<Analyzer::TypeId>> {
    if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(defId)) {
      if (defId.raw() == ownedBuffer && recordDef.typeParams.isEmpty() && recordDef.implementsDrop) {
        return Option::SOME(Vector::new<Analyzer::TypeId>());
      }
    }

    if (ViewType::hasOwningTypeParameter(defStore, defId)) {
      return Option::SOME(Vector::new<Analyzer::TypeId>());
    }

    let mut generic: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut arguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    if (let Option::SOME(Analyzer::SymbolOrigin::Instance(origin)) = defStore.symbolOriginOf(defId)) {
      generic = Option::SOME(origin.generic);
      arguments = ViewType::copyTypeIds(&origin.ownerArgs);
      let mut index: u64 = 0;

      while (index < origin.methodArgs.length()) {
        if (let Option::SOME(argument) = origin.methodArgs.get(index)) {
          arguments.push(*argument);
        }

        index += 1;
      }
    }

    if (let Option::SOME(genericId) = generic) {
      if (ViewType::hasOwningTypeParameter(defStore, genericId)) {
        return Option::SOME(arguments);
      }
    }

    return Option::NONE;
  }

  /// Whether a record or enum declares an `@owns` type parameter.
  function hasOwningTypeParameter(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId
  ): boolean {
    let mut paramDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    match (defStore.get(defId)) {
      Option::SOME(Analyzer::Definition::Record(recordDef)) -> {
        paramDefIds = ViewType::copyDefinitionIds(&recordDef.typeParams);
      },
      Option::SOME(Analyzer::Definition::Enum(enumDef)) -> {
        paramDefIds = ViewType::copyDefinitionIds(&enumDef.typeParams);
      },
      _ -> {},
    };

    let mut index: u64 = 0;

    while (index < paramDefIds.length()) {
      if (let Option::SOME(paramDefId) = paramDefIds.get(index)) {
        if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*paramDefId)) {
          if (typeParam.ownsStorage) {
            return true;
          }
        }
      }

      index += 1;
    }

    return false;
  }

  function isEnumDefinition(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId
  ): boolean {
    return match (defStore.get(defId)) {
      Option::SOME(Analyzer::Definition::Enum(_)) -> true,
      _ -> false,
    };
  }

  /// The interned names of a record's or enum's type parameters, in
  /// declaration order: the parameters an instance's arguments substitute.
  function typeParamSymbols(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId,
  ): Vector<Analyzer::SymbolId> {
    let mut paramDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

    match (defStore.get(defId)) {
      Option::SOME(Analyzer::Definition::Record(recordDef)) -> {
        paramDefIds = ViewType::copyDefinitionIds(&recordDef.typeParams);
      },
      Option::SOME(Analyzer::Definition::Enum(enumDef)) -> {
        paramDefIds = ViewType::copyDefinitionIds(&enumDef.typeParams);
      },
      _ -> {},
    };

    let mut symbols: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();
    let mut index: u64 = 0;

    while (index < paramDefIds.length()) {
      if (let Option::SOME(paramDefId) = paramDefIds.get(index)) {
        if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*paramDefId)) {
          symbols.push(typeParam.name);
        }
      }

      index += 1;
    }

    return symbols;
  }

  function copyDefinitionIds(
    source: &Vector<Analyzer::DefinitionId>
  ): Vector<Analyzer::DefinitionId> {
    let mut copied: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(entry) = source.get(index)) {
        copied.push(*entry);
      }

      index += 1;
    }

    return copied;
  }

  function aliasedTypeOf(
    defStore: &mut Analyzer::DefinitionStore,
    aliasDefId: Analyzer::DefinitionId,
  ): Option<Analyzer::TypeId> {
    let Option::SOME(definition) = defStore.get(aliasDefId) else {
      return Option::NONE;
    };

    return match (definition) {
      Analyzer::Definition::TypeAlias(aliasDef) -> Option::SOME(aliasDef.aliasedType),
      _ -> Option::NONE,
    };
  }

  /// The revisit-guard key of a nominal visit: the definition's raw id
  /// followed by its type arguments (`Instance`) or none (a plain record or
  /// enum, whose field types are gathered after the key is pushed).
  function visitKey(defRaw: u32, args: &Vector<Analyzer::TypeId>): Vector<u32> {
    let mut key: Vector<u32> = Vector::new<u32>();
    key.push(defRaw);
    key.push(args.length() as u32);

    let mut index: u64 = 0;

    while (index < args.length()) {
      if (let Option::SOME(argument) = args.get(index)) {
        key.push(argument.raw());
      }

      index += 1;
    }

    return key;
  }

  function containsKey(visiting: &Vector<Vector<u32>>, key: &Vector<u32>): boolean {
    let mut index: u64 = 0;

    while (index < visiting.length()) {
      if (let Option::SOME(entry) = visiting.get(index)) {
        if (ViewType::keysEqual(entry, key)) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  function keysEqual(left: &Vector<u32>, right: &Vector<u32>): boolean {
    if (left.length() != right.length()) {
      return false;
    }

    let mut index: u64 = 0;

    while (index < left.length()) {
      if (let Option::SOME(leftEntry) = left.get(index)) {
        if (let Option::SOME(rightEntry) = right.get(index)) {
          if (*leftEntry != *rightEntry) {
            return false;
          }
        }
      }

      index += 1;
    }

    return true;
  }
}
