import
  Diagnostic,
  DiagnosticBag,
  DiagnosticCode,
  LabelKind,
  Severity,
  SourceSpan,
from "@compiler::diagnostics";
import Ast from "@compiler::ast";

export namespace Analyzer {
  namespace Typecheck {
    /// Resolve a definition name for diagnostics, falling back to a stable
    /// placeholder when the symbol is not in the table.
    function copyCheckSymbolText(
      symbols: &Analyzer::SymbolTable,
      name: Analyzer::SymbolId
    ): String {
      return match (symbols.resolve(name)) {
        Option::SOME(text) -> String::create(text),
        Option::NONE -> String::create("<unknown>"),
      };
    }

    /// Structural check behind `@implements(Copy)` on a record: every field
    /// type must itself be Copy. Mirrors the Rust
    /// `Typecheck::validate_copy_structural`
    /// (`crates/ignis_analyzer/src/typeck.rs`), which reports one A0148 per
    /// offending field at the record's declaration span.
    function checkRecordCopyStructural(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      defId: Analyzer::DefinitionId,
      span: SourceSpan,
    ): void {
      let mut implementsCopy: boolean = false;
      let mut typeName: String = String::create("");
      let mut fieldDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(definition) = defStore.get(defId)) {
        if (let Analyzer::Definition::Record(recordDef) = definition) {
          implementsCopy = recordDef.implementsCopy;
          typeName = Analyzer::Typecheck::copyCheckSymbolText(&*symbols, recordDef.name);

          let mut fieldIndex: u64 = 0;
          while (fieldIndex < recordDef.fields.length()) {
            let Option::SOME(fieldDefId) = recordDef.fields.get(fieldIndex) else {
              fieldIndex += 1;
              continue;
            };

            fieldDefIds.push(*fieldDefId);
            fieldIndex += 1;
          }
        }
      }

      if (!implementsCopy) {
        return;
      }

      let mut index: u64 = 0;
      while (index < fieldDefIds.length()) {
        let Option::SOME(fieldDefId) = fieldDefIds.get(index) else {
          index += 1;
          continue;
        };

        let mut fieldNameOption: Option<Analyzer::SymbolId> = Option::NONE;
        let mut fieldTypeOption: Option<Analyzer::TypeId> = Option::NONE;

        if (let Option::SOME(fieldDefinition) = defStore.get(*fieldDefId)) {
          if (let Analyzer::Definition::Field(fieldDef) = fieldDefinition) {
            fieldNameOption = Option::SOME(fieldDef.name);
            fieldTypeOption = Option::SOME(fieldDef.fieldType);
          }
        }

        let Option::SOME(fieldName) = fieldNameOption else {
          index += 1;
          continue;
        };
        let Option::SOME(fieldType) = fieldTypeOption else {
          index += 1;
          continue;
        };

        if (Analyzer::Typecheck::isCopyType(defStore, typeStore, fieldType)) {
          index += 1;
          continue;
        }

        let fieldNameText: String = Analyzer::Typecheck::copyCheckSymbolText(&*symbols, fieldName);
        let fieldTypeName: String = typeStore.nameOfResolved(fieldType, &*defStore, &*symbols);

        let message: String = String::create("type '")
          .concat(typeName.toStr())
          .concat("' declares @implements(Copy) but field '")
          .concat(fieldNameText.toStr())
          .concat("' has non-Copy type '")
          .concat(fieldTypeName.toStr())
          .concat("'");

        Analyzer::Typecheck::emitDiagnostic(
          state,
          span,
          DiagnosticCode::COPY_ON_NON_COPY_FIELD,
          message.toStr(),
        );

        index += 1;
      }
    }

    /// Every required method (one without a default body) of each user trait
    /// the record or enum names in `@implements` has to be declared on it, with
    /// the same kind: a static trait method by a static method and an instance
    /// one by an instance method. A static method also has to match the trait's
    /// signature, with `Self` read as the implementing type. Instance method
    /// signatures are not compared.
    ///
    /// Each name is checked against the trait the resolver resolved it to, so
    /// two traits sharing a name in different namespaces are checked apart. A
    /// name that resolved to no trait was already reported, or is a lang trait,
    /// which carries its own checks.
    function checkImplementedTraitMethods(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      defId: Analyzer::DefinitionId,
      span: SourceSpan,
    ): void {
      let mut kindName: str = "record";
      let mut typeName: String = String::create("");
      let mut traitNames: Vector<String> = Vector::new<String>();
      let mut declared: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut declaredStatics: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut ownerTypeParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut ownerTypeId: Option<Analyzer::TypeId> = Option::NONE;

      match (defStore.get(defId)) {
        Option::SOME(Analyzer::Definition::Record(recordDef)) -> {
          typeName = Analyzer::Typecheck::copyCheckSymbolText(&*symbols, recordDef.name);
          traitNames = Analyzer::Typecheck::copyStringVector(&recordDef.implementedTraits);
          declared = Analyzer::TypeBounds::copyDefinitionIds(&recordDef.instanceMethods);
          declaredStatics = Analyzer::TypeBounds::copyDefinitionIds(&recordDef.staticMethods);
          ownerTypeParams = Analyzer::TypeBounds::copyDefinitionIds(&recordDef.typeParams);
          ownerTypeId = Option::SOME(recordDef.typeId);
        },
        Option::SOME(Analyzer::Definition::Enum(enumDef)) -> {
          kindName = "enum";
          typeName = Analyzer::Typecheck::copyCheckSymbolText(&*symbols, enumDef.name);
          traitNames = Analyzer::Typecheck::copyStringVector(&enumDef.implementedTraits);
          declared = Analyzer::TypeBounds::copyDefinitionIds(&enumDef.instanceMethods);
          declaredStatics = Analyzer::TypeBounds::copyDefinitionIds(&enumDef.staticMethods);
          ownerTypeParams = Analyzer::TypeBounds::copyDefinitionIds(&enumDef.typeParams);
          ownerTypeId = Option::SOME(enumDef.typeId);
        },
        _ -> {},
      };

      let Option::SOME(ownerType) = ownerTypeId else {
        return;
      };
      let mut selfType: Analyzer::TypeId = Analyzer::Typecheck::implementingSelfType(defStore, typeStore, defId, &ownerTypeParams, ownerType);

      // An extension block is checked as the type it extends.
      if (let Option::SOME(target) = defStore.extensionTargetOf(defId)) {
        kindName = "extension";
        selfType = target;
        typeName = typeStore.nameOfResolved(target, &*defStore, &*symbols);
      }
      let traitIds: Vector<Option<Analyzer::DefinitionId>> = defStore.traitReferencesOf(defId);
      let mut traitIndex: u64 = 0;

      while (traitIndex < traitNames.length()) {
        let Option::SOME(traitName) = traitNames.get(traitIndex) else {
          traitIndex += 1;
          continue;
        };

        let Option::SOME(traitId) = Analyzer::TypeBounds::traitAt(&traitIds, traitIndex) else {
          traitIndex += 1;
          continue;
        };

        if (Analyzer::Typecheck::isLangTraitName(traitName)) {
          traitIndex += 1;
          continue;
        }

        let mut required: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
        let mut traitIsGeneric: boolean = false;

        if (let Option::SOME(Analyzer::Definition::Trait(traitDef)) = defStore.get(traitId)) {
          required = Analyzer::TypeBounds::copyDefinitionIds(&traitDef.methods);
          traitIsGeneric = traitDef.typeParams.length() > 0;
        }

        let traitText: String = Analyzer::TypeBounds::traitDisplayName(defStore, traitName, Option::SOME(traitId));
        let mut requiredIndex: u64 = 0;

        while (requiredIndex < required.length()) {
          let Option::SOME(traitMethodId) = required.get(requiredIndex) else {
            requiredIndex += 1;
            continue;
          };

          let mut methodNameOpt: Option<Analyzer::SymbolId> = Option::NONE;
          let mut traitMethodIsStatic: boolean = false;

          if (let Option::SOME(Analyzer::Definition::Method(traitMethod)) = defStore.get(*traitMethodId)) {
            methodNameOpt = Option::SOME(traitMethod.name);
            traitMethodIsStatic = traitMethod.isStatic;
          }

          let Option::SOME(methodName) = methodNameOpt else {
            requiredIndex += 1;
            continue;
          };

          let declaredInstance: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::methodNamed(defStore, &declared, methodName);
          let declaredStatic: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::methodNamed(defStore, &declaredStatics, methodName);
          let sameKind: Option<Analyzer::DefinitionId> = traitMethodIsStatic ? declaredStatic : declaredInstance;
          let otherKind: Option<Analyzer::DefinitionId> = traitMethodIsStatic ? declaredInstance : declaredStatic;
          let methodText: String = Analyzer::Typecheck::copyCheckSymbolText(&*symbols, methodName);

          if (let Option::SOME(implementation) = sameKind) {
            if (traitMethodIsStatic && !traitIsGeneric) {
              Analyzer::Typecheck::checkStaticTraitMethodSignature(
                state,
                defStore,
                typeStore,
                symbols,
                *traitMethodId,
                implementation,
                selfType,
                kindName,
                &typeName,
                &traitText,
                &methodText,
                span,
              );
            }
          } else if (otherKind.isSome()) {
            let declaredKind: str = traitMethodIsStatic ? "an instance method" : "a static method";
            let expectedKind: str = traitMethodIsStatic ? "static" : "an instance method";
            let message: String = `${kindName} '${typeName.toStr()}' declares '${methodText.toStr()}' as ${declaredKind}, but @implements(${traitText.toStr()}) requires it to be ${expectedKind}`;
            let mut label: String = `declare '${methodText.toStr()}' with a self parameter and without 'static'`;

            if (traitMethodIsStatic) {
              label = `declare '${methodText.toStr()}' with 'static' and without a self parameter`;
            }

            Analyzer::Typecheck::emitDiagnosticLabeled(
              state,
              span,
              DiagnosticCode::TRAIT_METHOD_KIND_MISMATCH,
              message.toStr(),
              label.toStr(),
            );
          } else {
            let message: String = `${kindName} '${typeName.toStr()}' declares @implements(${traitText.toStr()}) but does not define the required method '${methodText.toStr()}'`;
            let label: String = `add '${methodText.toStr()}' to '${typeName.toStr()}' or give it a default body in '${traitText.toStr()}'`;

            Analyzer::Typecheck::emitDiagnosticLabeled(
              state,
              span,
              DiagnosticCode::TRAIT_METHOD_NOT_IMPLEMENTED,
              message.toStr(),
              label.toStr(),
            );
          }

          requiredIndex += 1;
        }

        traitIndex += 1;
      }
    }

    /// The traits an extension block names that it cannot implement, the
    /// module it may be declared in, and a second implementation of the same
    /// trait for the same type by an earlier block.
    ///
    /// The language traits and the canonical `Eq` and `Hash` are answered
    /// from the type itself, so a block cannot supply them. A block is
    /// declared in the module of the trait or, for a record or enum, in the
    /// module of the type: two modules can then never implement one trait
    /// for one type apart from each other.
    function checkExtensionBlock(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      defId: Analyzer::DefinitionId,
      span: SourceSpan,
    ): void {
      let Option::SOME(target) = defStore.extensionTargetOf(defId) else {
        return;
      };

      let mut traitNames: Vector<String> = Vector::new<String>();

      if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(defId)) {
        traitNames = Analyzer::Typecheck::copyStringVector(&recordDef.implementedTraits);
      }

      let typeName: String = typeStore.nameOfResolved(target, &*defStore, &*symbols);
      let traitIds: Vector<Option<Analyzer::DefinitionId>> = defStore.traitReferencesOf(defId);
      let blockModule: Option<u64> = defStore.defModuleOf(defId);
      let headDef: Option<Analyzer::DefinitionId> = defStore.extensionHeadOf(defId);
      let blocks: Vector<Analyzer::DefinitionId> = defStore.extensionBlocks();
      let mut traitIndex: u64 = 0;

      while (traitIndex < traitNames.length()) {
        let Option::SOME(traitName) = traitNames.get(traitIndex) else {
          traitIndex += 1;
          continue;
        };

        let traitIdOpt: Option<Analyzer::DefinitionId> = Analyzer::TypeBounds::traitAt(&traitIds, traitIndex);

        if (Analyzer::Typecheck::traitAnsweredByCompiler(defStore, traitName, traitIdOpt)) {
          let message: String = `'${traitName.toStr()}' cannot be implemented by an extension block`;
          let label: String = `the compiler answers '${traitName.toStr()}' for '${typeName.toStr()}' from the type itself`;
          Analyzer::Typecheck::emitDiagnosticLabeled(state, span, DiagnosticCode::EXTENSION_OF_LANG_TRAIT, message.toStr(), label.toStr());
          traitIndex += 1;
          continue;
        }

        let Option::SOME(traitId) = traitIdOpt else {
          traitIndex += 1;
          continue;
        };

        let traitText: String = Analyzer::TypeBounds::traitDisplayName(defStore, traitName, Option::SOME(traitId));

        if (let Option::SOME(module) = blockModule) {
          let traitModule: Option<u64> = defStore.defModuleOf(traitId);
          let mut allowed: boolean = Analyzer::Typecheck::sameModule(traitModule, module);
          let mut typeOwnerText: String = String::new();

          if (let Option::SOME(head) = headDef) {
            allowed = allowed || Analyzer::Typecheck::sameModule(defStore.defModuleOf(head), module);
            typeOwnerText = ` or the one that declares '${typeName.toStr()}'`;
          }

          if (!allowed) {
            let message: String = `an extension block implementing '${traitText.toStr()}' for '${typeName.toStr()}' has to be declared in the module that declares '${traitText.toStr()}'${typeOwnerText.toStr()}`;
            let mut label: String = String::create("declared in another module");

            if (headDef.isNone()) {
              label = `a primitive is extended only in the module of the trait`;
            }

            Analyzer::Typecheck::emitDiagnosticLabeled(state, span, DiagnosticCode::EXTENSION_OUTSIDE_OWNING_MODULE, message.toStr(), label.toStr());
            traitIndex += 1;
            continue;
          }
        }

        let mut blockIndex: u64 = 0;

        while (blockIndex < blocks.length()) {
          let Option::SOME(other) = blocks.get(blockIndex) else {
            blockIndex += 1;
            continue;
          };

          // Only an earlier block counts, so each pair is reported once, at
          // the second.
          if (other.raw() >= defId.raw()) {
            blockIndex += 1;
            continue;
          }

          let mut sameTarget: boolean = false;

          if (let Option::SOME(otherTarget) = defStore.extensionTargetOf(*other)) {
            sameTarget = otherTarget.raw() == target.raw();

            if (let Option::SOME(head) = headDef) {
              if (let Option::SOME(otherHead) = defStore.extensionHeadOf(*other)) {
                sameTarget = sameTarget || otherHead.raw() == head.raw();
              }
            }
          }

          if (sameTarget && defStore.refersToTrait(*other, traitId)) {
            if (let Option::SOME(otherSpan) = defStore.extensionSpanOf(*other)) {
              Analyzer::Typecheck::emitDuplicateImplementation(state, &typeName, &traitText, span, otherSpan, "an earlier extension block implements it here");
            }
          }

          blockIndex += 1;
        }

        traitIndex += 1;
      }
    }

    /// An extension block implementing a trait the record or enum `defId`
    /// already names in its own `@implements`.
    function checkExtensionDuplicates(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      defId: Analyzer::DefinitionId,
      span: SourceSpan,
    ): void {
      let blocks: Vector<Analyzer::DefinitionId> = defStore.extensionsOfDefinition(defId);

      if (blocks.length() == 0) {
        return;
      }

      let traitIds: Vector<Option<Analyzer::DefinitionId>> = defStore.traitReferencesOf(defId);
      let mut typeName: String = String::new();

      if (let Option::SOME(definition) = defStore.get(defId)) {
        typeName = Analyzer::Typecheck::copyCheckSymbolText(&*symbols, definition.name());
      }

      let unnamed: String = String::new();
      let mut traitIndex: u64 = 0;

      while (traitIndex < traitIds.length()) {
        if (let Option::SOME(traitId) = Analyzer::TypeBounds::traitAt(&traitIds, traitIndex)) {
          let mut blockIndex: u64 = 0;

          while (blockIndex < blocks.length()) {
            if (let Option::SOME(block) = blocks.get(blockIndex)) {
              if (defStore.refersToTrait(*block, traitId)) {
                if (let Option::SOME(blockSpan) = defStore.extensionSpanOf(*block)) {
                  let traitText: String = Analyzer::TypeBounds::traitDisplayName(defStore, &unnamed, Option::SOME(traitId));
                  Analyzer::Typecheck::emitDuplicateImplementation(state, &typeName, &traitText, blockSpan, span, "the type names it in its own @implements here");
                }
              }
            }

            blockIndex += 1;
          }
        }

        traitIndex += 1;
      }
    }

    /// Reports a second implementation of `traitText` for `typeName` at
    /// `span`, pointing at the first one.
    function emitDuplicateImplementation(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeName: &String,
      traitText: &String,
      span: SourceSpan,
      firstSpan: SourceSpan,
      firstLabel: str,
    ): void {
      let message: String = `'${typeName.toStr()}' implements '${traitText.toStr()}' twice`;
      let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::DUPLICATE_TRAIT_IMPLEMENTATION, message.toStr(), span);
      diagnostic.addLabel(LabelKind::PRIMARY, span, "second implementation");
      diagnostic.addLabel(LabelKind::SECONDARY, firstSpan, firstLabel);
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.diagnostics.push(diagnostic);
    }

    /// Whether two module indexes name the same module.
    function sameModule(candidate: Option<u64>, module: u64): boolean {
      if (let Option::SOME(index) = candidate) {
        return index == module;
      }

      return false;
    }

    /// Whether the trait written `name`, resolved to `traitId`, is one the
    /// compiler answers from a type's structure or declaration: a language
    /// trait, or the canonical `Eq` and `Hash` of `std::hash`, or either of
    /// those names left unresolved.
    function traitAnsweredByCompiler(
      defStore: &mut Analyzer::DefinitionStore,
      name: &String,
      traitId: Option<Analyzer::DefinitionId>,
    ): boolean {
      let Option::SOME(resolved) = traitId else {
        return Analyzer::Typecheck::isLangTraitName(name) || name.equals("Eq") || name.equals("Hash");
      };

      if (!name.equals("Eq") && !name.equals("Hash")) {
        return false;
      }

      let Option::SOME(module) = defStore.defModuleOf(resolved) else {
        return false;
      };

      if (let Option::SOME(moduleName) = defStore.moduleDisplayNameOf(module)) {
        return moduleName.equals("std::hash");
      }

      return false;
    }

    /// The type `Self` names inside the methods of the record or enum `defId`:
    /// the type itself, or its instance over its own type parameters.
    function implementingSelfType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      defId: Analyzer::DefinitionId,
      typeParams: &Vector<Analyzer::DefinitionId>,
      ownerTypeId: Analyzer::TypeId,
    ): Analyzer::TypeId {
      if (typeParams.length() == 0) {
        return ownerTypeId;
      }

      let mut arguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < typeParams.length()) {
        if (let Option::SOME(paramDefId) = typeParams.get(index)) {
          if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*paramDefId)) {
            let mut typeStoreParamRef: &mut Analyzer::TypeStore = typeStore;
            arguments.push(typeStoreParamRef.param(typeParam.name));
          }
        }

        index += 1;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      return typeStoreRef.instance(defId, arguments);
    }

    /// The type a written `Self` names inside `functionId`: the extended type
    /// in an extension block, the record or enum in its own methods and in a
    /// trait default copied onto it, and the parameter `Self` in a trait's
    /// own methods. `NONE` outside a method.
    function methodSelfType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      functionId: Analyzer::DefinitionId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(Analyzer::Definition::Method(method)) = defStore.get(functionId) else {
        return Option::NONE;
      };
      let owner: Analyzer::DefinitionId = method.owner;

      if (let Option::SOME(target) = defStore.extensionTargetOf(owner)) {
        return Option::SOME(target);
      }

      let mut typeParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut ownerType: Option<Analyzer::TypeId> = Option::NONE;

      match (defStore.get(owner)) {
        Option::SOME(Analyzer::Definition::Record(recordDef)) -> {
          typeParams = Analyzer::TypeBounds::copyDefinitionIds(&recordDef.typeParams);
          ownerType = Option::SOME(recordDef.typeId);
        },
        Option::SOME(Analyzer::Definition::Enum(enumDef)) -> {
          typeParams = Analyzer::TypeBounds::copyDefinitionIds(&enumDef.typeParams);
          ownerType = Option::SOME(enumDef.typeId);
        },
        Option::SOME(Analyzer::Definition::Trait(_)) -> {
          let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
          let selfSymbol: Analyzer::SymbolId = symbolsRef.intern("Self");
          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.param(selfSymbol));
        },
        _ -> {},
      };

      let Option::SOME(ownerTypeId) = ownerType else {
        return Option::NONE;
      };

      return Option::SOME(Analyzer::Typecheck::implementingSelfType(defStore, typeStore, owner, &typeParams, ownerTypeId));
    }

    /// Resolves the type argument of a builtin such as `@typeName<T>()`,
    /// reading a bare `Self` from the method `enclosing` rather than as a name.
    function resolveBuiltinTypeArgument(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      typeId: Ast::TypeId,
      enclosing: Analyzer::DefinitionId,
    ): Option<Analyzer::TypeId> {
      if (let Option::SOME(Ast::Type::Node::Path(path)) = module.types.get(typeId)) {
        if (path.segments.length() == 1) {
          if (let Option::SOME(segment) = path.segments.get(0)) {
            if (segment.equals("Self")) {
              return Analyzer::Typecheck::methodSelfType(defStore, typeStore, symbols, enclosing);
            }
          }
        }
      }

      return Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, typeId, Option::SOME(enclosing));
    }

    /// The first method in `methods` named `name`.
    function methodNamed(
      defStore: &mut Analyzer::DefinitionStore,
      methods: &Vector<Analyzer::DefinitionId>,
      name: Analyzer::SymbolId,
    ): Option<Analyzer::DefinitionId> {
      let mut index: u64 = 0;

      while (index < methods.length()) {
        if (let Option::SOME(methodId) = methods.get(index)) {
          if (let Option::SOME(Analyzer::Definition::Method(methodDef)) = defStore.get(*methodId)) {
            if (methodDef.name.raw() == name.raw()) {
              return Option::SOME(*methodId);
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// Reports a static method that implements a static trait method with a
    /// different signature: another parameter count, parameter type or return
    /// type, once `Self` in the trait's signature is read as `selfType`.
    function checkStaticTraitMethodSignature(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      traitMethodId: Analyzer::DefinitionId,
      implementationId: Analyzer::DefinitionId,
      selfType: Analyzer::TypeId,
      kindName: str,
      typeName: &String,
      traitText: &String,
      methodText: &String,
      span: SourceSpan,
    ): void {
      let Option::SOME(traitSignature) = Analyzer::Typecheck::extractFunctionSignature(defStore, traitMethodId) else {
        return;
      };
      let Option::SOME(implementationSignature) = Analyzer::Typecheck::extractFunctionSignature(defStore, implementationId) else {
        return;
      };

      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let selfSymbol: Analyzer::SymbolId = symbolsRef.intern("Self");
      let mut selfSymbols: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();
      selfSymbols.push(selfSymbol);
      let mut selfArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      selfArguments.push(selfType);

      let declaredParams: Vector<Analyzer::TypeId> = Analyzer::Typecheck::methodExplicitParamTypes(defStore, &traitSignature, true);
      let implementedParams: Vector<Analyzer::TypeId> = Analyzer::Typecheck::methodExplicitParamTypes(defStore, &implementationSignature, true);
      let mut expectedParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < declaredParams.length()) {
        if (let Option::SOME(declared) = declaredParams.get(index)) {
          let mut typeStoreParamRef: &mut Analyzer::TypeStore = typeStore;
          expectedParams.push(typeStoreParamRef.substitute(*declared, &selfSymbols, &selfArguments));
        }

        index += 1;
      }

      let mut typeStoreReturnRef: &mut Analyzer::TypeStore = typeStore;
      let expectedReturn: Analyzer::TypeId = typeStoreReturnRef.substitute(traitSignature.returnType, &selfSymbols, &selfArguments);
      let sameArity: boolean = expectedParams.length() == implementedParams.length();
      let mut matches: boolean = sameArity && expectedReturn.raw() == implementationSignature.returnType.raw();
      index = 0;

      while (matches && index < expectedParams.length()) {
        if (let Option::SOME(expected) = expectedParams.get(index)) {
          if (let Option::SOME(implemented) = implementedParams.get(index)) {
            if (expected.raw() != implemented.raw()) {
              matches = false;
            }
          }
        }

        index += 1;
      }

      if (matches) {
        return;
      }

      let expectedType: Analyzer::TypeId = typeStoreReturnRef.functionType(expectedParams, expectedReturn);
      let foundType: Analyzer::TypeId = typeStoreReturnRef.functionType(implementedParams, implementationSignature.returnType);
      let expectedText: String = typeStore.nameOfResolved(expectedType, &*defStore, &*symbols);
      let foundText: String = typeStore.nameOfResolved(foundType, &*defStore, &*symbols);
      let message: String = `static method '${methodText.toStr()}' of ${kindName} '${typeName.toStr()}' does not match @implements(${traitText.toStr()}): expected '${expectedText.toStr()}', found '${foundText.toStr()}'`;
      let label: String = `declare '${methodText.toStr()}' with the trait's parameter and return types, reading 'Self' as '${typeName.toStr()}'`;

      Analyzer::Typecheck::emitDiagnosticLabeled(
        state,
        span,
        DiagnosticCode::TRAIT_STATIC_METHOD_SIGNATURE_MISMATCH,
        message.toStr(),
        label.toStr(),
      );
    }

    /// Whether `name` is a lang trait, which `@implements` accepts without a
    /// user trait declaration and which is validated by its own checks.
    function isLangTraitName(name: &String): boolean {
      return name.equals("Drop") || name.equals("Clone") || name.equals("Copy") || name.equals("Send") || name.equals("Sync");
    }

    /// Structural check behind `@implements(Copy)` on an enum: every variant
    /// payload type must itself be Copy. Mirrors the Rust
    /// `Typecheck::validate_copy_structural_enum`
    /// (`crates/ignis_analyzer/src/typeck.rs`), which reports one A0149 per
    /// offending payload slot and names its zero-based index.
    function checkEnumCopyStructural(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      defId: Analyzer::DefinitionId,
      span: SourceSpan,
    ): void {
      let mut implementsCopy: boolean = false;
      let mut typeName: String = String::create("");
      let mut variantDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(definition) = defStore.get(defId)) {
        if (let Analyzer::Definition::Enum(enumDef) = definition) {
          implementsCopy = enumDef.implementsCopy;
          typeName = Analyzer::Typecheck::copyCheckSymbolText(&*symbols, enumDef.name);

          let mut variantIndex: u64 = 0;
          while (variantIndex < enumDef.variants.length()) {
            let Option::SOME(variantDefId) = enumDef.variants.get(variantIndex) else {
              variantIndex += 1;
              continue;
            };

            variantDefIds.push(*variantDefId);
            variantIndex += 1;
          }
        }
      }

      if (!implementsCopy) {
        return;
      }

      let mut index: u64 = 0;
      while (index < variantDefIds.length()) {
        let Option::SOME(variantDefId) = variantDefIds.get(index) else {
          index += 1;
          continue;
        };

        let mut variantNameOption: Option<Analyzer::SymbolId> = Option::NONE;
        let mut payloadTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

        if (let Option::SOME(variantDefinition) = defStore.get(*variantDefId)) {
          if (let Analyzer::Definition::Variant(variantDef) = variantDefinition) {
            variantNameOption = Option::SOME(variantDef.name);

            let mut payloadIndex: u64 = 0;
            while (payloadIndex < variantDef.payload.length()) {
              let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex) else {
                payloadIndex += 1;
                continue;
              };

              payloadTypes.push(*payloadType);
              payloadIndex += 1;
            }
          }
        }

        let Option::SOME(variantName) = variantNameOption else {
          index += 1;
          continue;
        };
        let variantNameText: String = Analyzer::Typecheck::copyCheckSymbolText(&*symbols, variantName);

        let mut slotIndex: u64 = 0;
        while (slotIndex < payloadTypes.length()) {
          let Option::SOME(payloadType) = payloadTypes.get(slotIndex) else {
            slotIndex += 1;
            continue;
          };
          let payloadTypeId: Analyzer::TypeId = *payloadType;

          if (Analyzer::Typecheck::isCopyType(defStore, typeStore, payloadTypeId)) {
            slotIndex += 1;
            continue;
          }

          let payloadTypeName: String = typeStore.nameOfResolved(payloadTypeId, &*defStore, &*symbols);

          let message: String = String::create("type '")
            .concat(typeName.toStr())
            .concat("' declares @implements(Copy) but variant '")
            .concat(variantNameText.toStr())
            .concat("' payload ")
            .concat(String::create(slotIndex).toStr())
            .concat(" has non-Copy type '")
            .concat(payloadTypeName.toStr())
            .concat("'");

          Analyzer::Typecheck::emitDiagnostic(
            state,
            span,
            DiagnosticCode::COPY_ON_NON_COPY_VARIANT_PAYLOAD,
            message.toStr(),
          );

          slotIndex += 1;
        }

        index += 1;
      }
    }

    function checkFunctionItem(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      functionDefId: Analyzer::DefinitionId,
      function_: &Ast::Item::Function,
    ): void {
      let signatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(
        defStore,
        functionDefId,
      );
      let Option::SOME(signature) = signatureOpt else {
        return;
      };

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.currentFunction = functionDefId;
      stateRef.currentReturnType = signature.returnType;
      stateRef.loopDepth = 0;
      stateRef.scopeMarks = Vector::new<u64>();
      stateRef.localPatternIds = Vector::new<Ast::PatternId>();
      stateRef.localFunctionIds = Vector::new<Analyzer::DefinitionId>();
      stateRef.localIndexes = Vector::new<u32>();
      stateRef.localTypeIds = Vector::new<Analyzer::TypeId>();
      stateRef.localMutableFlags = Vector::new<boolean>();
      stateRef.localPlaceMutableFlags = Vector::new<boolean>();

      Analyzer::Typecheck::checkSignatureBounds(state, defStore, typeStore, symbols, module, functionDefId, function_, &signature);

      Analyzer::Typecheck::pushScope(state);
      Analyzer::Typecheck::bindFunctionParameters(state, defStore, typeStore, symbols, resolvedBodies, module, function_, &signature.params);
      Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, function_.body);
      Analyzer::Typecheck::popScope(state);
    }

    /// Checks the bounds of the generic instances a declared type names. The
    /// bounds pass only meets the types of expressions, so a field, payload or
    /// parameter type that no expression has would otherwise go unchecked.
    function checkDeclaredTypeBounds(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      enclosing: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
      span: SourceSpan,
    ): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      Analyzer::TypeBounds::checkType(defStore, typeStore, symbols, enclosing, typeId, span, &mut stateRef.diagnostics);
    }

    /// Checks the parameter and return types of a function or method, each at
    /// its own span.
    function checkSignatureBounds(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      functionDefId: Analyzer::DefinitionId,
      function_: &Ast::Item::Function,
      signature: &Analyzer::Typecheck::FunctionSignature,
    ): void {
      let mut index: u64 = 0;

      while (index < signature.params.length()) {
        let Option::SOME(paramDefId) = signature.params.get(index) else {
          index += 1;
          continue;
        };

        let mut declaredType: Option<Analyzer::TypeId> = Option::NONE;

        if (let Option::SOME(Analyzer::Definition::Variable(parameter)) = defStore.get(*paramDefId)) {
          declaredType = Option::SOME(parameter.declaredType);
        }

        let mut span: SourceSpan = function_.span;

        if (let Option::SOME(patternId) = function_.parameters.get(index)) {
          span = Analyzer::Typecheck::patternSpanOr(module, *patternId, function_.span);
        }

        if (let Option::SOME(typeId) = declaredType) {
          Analyzer::Typecheck::checkDeclaredTypeBounds(state, defStore, typeStore, symbols, functionDefId, typeId, span);
        }

        index += 1;
      }

      let mut returnSpan: SourceSpan = function_.span;

      if (let Option::SOME(returnTypeId) = function_.returnType) {
        if (let Option::SOME(typeNode) = module.types.get(returnTypeId)) {
          returnSpan = Ast::Serializer::typeSpan(typeNode);
        }
      }

      Analyzer::Typecheck::checkDeclaredTypeBounds(state, defStore, typeStore, symbols, functionDefId, signature.returnType, returnSpan);
    }

    /// Checks the type of every field, instance and static, a record declares.
    function checkRecordFieldBounds(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      recordDefId: Analyzer::DefinitionId,
      record_: &Ast::Item::Record,
    ): void {
      let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut staticFields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(recordDefId)) {
        fields = Analyzer::Typecheck::copyDefinitionIdVector(&recordDef.fields);
        staticFields = Analyzer::Typecheck::copyDefinitionIdVector(&recordDef.staticFields);
      }

      Analyzer::Typecheck::checkMemberBounds(state, defStore, typeStore, symbols, module, recordDefId, &fields, &record_.fields, record_.span);
      Analyzer::Typecheck::checkMemberBounds(state, defStore, typeStore, symbols, module, recordDefId, &staticFields, &record_.fields, record_.span);
      Analyzer::Typecheck::checkStaticFieldsHoldNoViews(state, defStore, typeStore, symbols, module, &staticFields, &record_.fields, record_.span);
    }

    /// Checks every variant payload type and static field type an enum declares.
    function checkEnumMemberBounds(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      enumDefId: Analyzer::DefinitionId,
      enum_: &Ast::Item::Enum,
    ): void {
      let mut variants: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut staticFields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(Analyzer::Definition::Enum(enumDef)) = defStore.get(enumDefId)) {
        variants = Analyzer::Typecheck::copyDefinitionIdVector(&enumDef.variants);
        staticFields = Analyzer::Typecheck::copyDefinitionIdVector(&enumDef.staticFields);
      }

      Analyzer::Typecheck::checkMemberBounds(state, defStore, typeStore, symbols, module, enumDefId, &variants, &enum_.variants, enum_.span);
      Analyzer::Typecheck::checkMemberBounds(state, defStore, typeStore, symbols, module, enumDefId, &staticFields, &enum_.variants, enum_.span);
      Analyzer::Typecheck::checkStaticFieldsHoldNoViews(state, defStore, typeStore, symbols, module, &staticFields, &enum_.variants, enum_.span);
    }

    /// Checks the declared types of `members`, each at the span of the member
    /// pattern that names it, or at `fallback` when none does.
    function checkMemberBounds(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      owner: Analyzer::DefinitionId,
      members: &Vector<Analyzer::DefinitionId>,
      memberPatterns: &Vector<Ast::PatternId>,
      fallback: SourceSpan,
    ): void {
      let mut index: u64 = 0;

      while (index < members.length()) {
        let Option::SOME(memberDefId) = members.get(index) else {
          index += 1;
          continue;
        };

        let mut types: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
        let mut nameOpt: Option<Analyzer::SymbolId> = Option::NONE;

        match (defStore.get(*memberDefId)) {
          Option::SOME(Analyzer::Definition::Field(field)) -> {
            types.push(field.fieldType);
            nameOpt = Option::SOME(field.name);
          },
          Option::SOME(Analyzer::Definition::Variable(variable)) -> {
            types.push(variable.declaredType);
            nameOpt = Option::SOME(variable.name);
          },
          Option::SOME(Analyzer::Definition::Variant(variant)) -> {
            types = Analyzer::Typecheck::copyTypeIdVector(&variant.payload);
            nameOpt = Option::SOME(variant.name);
          },
          _ -> {},
        };

        let mut span: SourceSpan = fallback;

        if (let Option::SOME(name) = nameOpt) {
          if (let Option::SOME(text) = symbols.resolve(name)) {
            span = Analyzer::Typecheck::memberPatternSpan(module, memberPatterns, text, fallback);
          }
        }

        let mut typeIndex: u64 = 0;

        while (typeIndex < types.length()) {
          if (let Option::SOME(typeId) = types.get(typeIndex)) {
            Analyzer::Typecheck::checkDeclaredTypeBounds(state, defStore, typeStore, symbols, owner, *typeId, span);
          }

          typeIndex += 1;
        }

        index += 1;
      }
    }

    /// The span of the first member pattern named `name`: a field or unit
    /// variant binding, or a payload variant's path.
    function memberPatternSpan(
      module: &Ast::Module,
      memberPatterns: &Vector<Ast::PatternId>,
      name: str,
      fallback: SourceSpan,
    ): SourceSpan {
      let mut index: u64 = 0;

      while (index < memberPatterns.length()) {
        if (let Option::SOME(patternId) = memberPatterns.get(index)) {
          match (module.patterns.get(*patternId)) {
            Option::SOME(Ast::Pattern::Node::Binding(binding)) -> {
              if (binding.name.equals(name)) {
                return binding.span;
              }
            },
            Option::SOME(Ast::Pattern::Node::Path(path)) -> {
              if (path.segments.length() > 0) {
                if (let Option::SOME(last) = path.segments.get(path.segments.length() - 1)) {
                  if (last.equals(name)) {
                    return path.span;
                  }
                }
              }
            },
            _ -> {},
          };
        }

        index += 1;
      }

      return fallback;
    }

    function patternSpanOr(
      module: &Ast::Module,
      patternId: Ast::PatternId,
      fallback: SourceSpan
    ): SourceSpan {
      return match (module.patterns.get(patternId)) {
        Option::SOME(Ast::Pattern::Node::Wildcard(value)) -> value.span,
        Option::SOME(Ast::Pattern::Node::Binding(value)) -> value.span,
        Option::SOME(Ast::Pattern::Node::Literal(value)) -> value.span,
        Option::SOME(Ast::Pattern::Node::Path(value)) -> value.span,
        Option::SOME(Ast::Pattern::Node::Tuple(value)) -> value.span,
        Option::SOME(Ast::Pattern::Node::Or(value)) -> value.span,
        Option::NONE -> fallback,
      };
    }

    function checkConstantItem(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      constantDefId: Analyzer::DefinitionId,
      constant: &Ast::Item::Constant,
    ): void {
      let Option::SOME(def) = defStore.get(constantDefId) else {
        return;
      };

      let variableDef: Analyzer::VariableDef = match (def) {
        Analyzer::Definition::Variable(value) -> value,
        Analyzer::Definition::Function(_) -> {
          return;
        },
        Analyzer::Definition::Record(_) -> {
          return;
        },
        Analyzer::Definition::Enum(_) -> {
          return;
        },
        Analyzer::Definition::Field(_) -> {
          return;
        },
        Analyzer::Definition::Variant(_) -> {
          return;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return;
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return;
        },
        Analyzer::Definition::Trait(_) -> {
          return;
        },
        Analyzer::Definition::Method(_) -> {
          return;
        },
      };

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.currentFunction = constantDefId;
      stateRef.currentReturnType = variableDef.declaredType;
      stateRef.loopDepth = 0;
      stateRef.scopeMarks = Vector::new<u64>();
      stateRef.localPatternIds = Vector::new<Ast::PatternId>();
      stateRef.localFunctionIds = Vector::new<Analyzer::DefinitionId>();
      stateRef.localIndexes = Vector::new<u32>();
      stateRef.localTypeIds = Vector::new<Analyzer::TypeId>();
      stateRef.localMutableFlags = Vector::new<boolean>();
      stateRef.localPlaceMutableFlags = Vector::new<boolean>();

      if (constant.annotation.isNone()) {
        // Both parsers require the annotation grammatically, so this path is
        // only reachable from programmatic ASTs. The binder left the `VOID`
        // sentinel as `declaredType`; infer it from the value instead. A
        // value that fails to type already reported its own diagnostic.
        let inferredTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          constant.value,
        );

        if (let Option::SOME(inferredType) = inferredTypeOpt) {
          Analyzer::Typecheck::patchVariableDeclaredType(defStore, constantDefId, inferredType);
        }

        return;
      }

      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        constant.value,
        Option::SOME(variableDef.declaredType),
      );

      if (let Option::SOME(actualType) = actualTypeOpt) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, constant.span, variableDef.declaredType, actualType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, defStore, typeStore, symbols, constant.span, variableDef.declaredType, actualType);
        }
      }
    }

    /// Typecheck the value of every static field a record declares, against the
    /// type the field annotates. The definitions sit in `RecordDef.staticFields`
    /// in declaration order, so they are walked alongside the written fields.
    function checkRecordStaticFields(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      recordDefId: Analyzer::DefinitionId,
      record_: &Ast::Item::Record,
    ): void {
      let staticDefIds: Vector<Analyzer::DefinitionId> = Analyzer::Typecheck::recordStaticFieldDefs(defStore, recordDefId);

      if (staticDefIds.length() == 0) {
        return;
      }

      let mut staticIndex: u64 = 0;
      let mut patternIndex: u64 = 0;

      while (patternIndex < record_.fields.length()) {
        let Option::SOME(fieldPatId) = record_.fields.get(patternIndex) else {
          patternIndex += 1;
          continue;
        };

        if (!Analyzer::Binder::fieldPatternIsStatic(module, *fieldPatId)) {
          patternIndex += 1;
          continue;
        }

        let Option::SOME(staticDefId) = staticDefIds.get(staticIndex) else {
          patternIndex += 1;
          staticIndex += 1;
          continue;
        };

        if (let Option::SOME(pattern) = module.patterns.get(*fieldPatId)) {
          if (let Ast::Pattern::Node::Binding(binding) = pattern) {
            if (let Option::SOME(valueExprId) = binding.initializer) {
              Analyzer::Typecheck::checkStaticFieldValue(
                state,
                defStore,
                typeStore,
                symbols,
                module,
                resolvedBodies,
                *staticDefId,
                valueExprId,
                binding.span,
              );
            } else {
              Analyzer::Typecheck::checkZeroInitializedStatic(
                state,
                defStore,
                typeStore,
                symbols,
                *staticDefId,
                &binding.name,
                binding.span,
              );
            }

            Analyzer::Typecheck::checkThreadLocalNeedsNoDrop(state, defStore, typeStore, symbols, *staticDefId, &binding.name, binding.span);
          }
        }

        staticIndex += 1;
        patternIndex += 1;
      }
    }

    /// A `@threadLocal` field's type must not run a drop (A0260): nothing runs
    /// when a thread exits, so its copy would never be torn down. Every type
    /// that is not Copy runs one, either its own or one of a field or element.
    function checkThreadLocalNeedsNoDrop(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      staticDefId: Analyzer::DefinitionId,
      fieldName: &String,
      span: SourceSpan,
    ): void {
      let Option::SOME(Analyzer::Definition::Variable(variableDef)) = defStore.get(staticDefId) else {
        return;
      };

      if (!variableDef.threadLocal) {
        return;
      }

      let declaredType: Analyzer::TypeId = variableDef.declaredType;

      if (Analyzer::Typecheck::isCopyType(defStore, typeStore, declaredType)) {
        return;
      }

      let typeName: String = typeStore.nameOfResolved(declaredType, &*defStore, &*symbols);
      let message: String = `thread-local '${fieldName.toStr()}' has type '${typeName.toStr()}', which runs a drop that no thread exit runs`;

      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::THREAD_LOCAL_NEEDS_DROP, message.toStr());
    }

    /// A view type cannot be stored in a `static` or `static mut` field (S3):
    /// a view borrows storage it does not own, and a static outlives every
    /// owner it could borrow. A `static str` field is accepted: a static
    /// string owns its bytes. Reported at the written type when the field has
    /// one, at the whole binding otherwise.
    function checkStaticFieldsHoldNoViews(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      staticFields: &Vector<Analyzer::DefinitionId>,
      memberPatterns: &Vector<Ast::PatternId>,
      fallback: SourceSpan,
    ): void {
      let mut index: u64 = 0;

      while (index < staticFields.length()) {
        if (let Option::SOME(staticDefId) = staticFields.get(index)) {
          if (let Option::SOME(Analyzer::Definition::Variable(variableDef)) = defStore.get(*staticDefId)) {
            if (Analyzer::ViewType::isView(defStore, typeStore, variableDef.declaredType)) {
              if (let Option::SOME(name) = symbols.resolve(variableDef.name)) {
                let kind: str = variableDef.mutable ? "'static mut'" : "'static'";
                let typeName: String = typeStore.nameOfResolved(variableDef.declaredType, &*defStore, &*symbols);
                let message: String = `${kind} field '${name}' has type '${typeName.toStr()}', which is a view type: a view borrows storage it does not own, and a static outlives every owner`;
                let span: SourceSpan = Analyzer::Typecheck::staticFieldTypeSpan(module, memberPatterns, name, fallback);

                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::STATIC_FIELD_OF_VIEW_TYPE, message.toStr());
              }
            }
          }
        }

        index += 1;
      }
    }

    /// The span of the type a member binding annotates, of the whole binding
    /// when it annotates none, or of `fallback` when no binding names `name`.
    function staticFieldTypeSpan(
      module: &Ast::Module,
      memberPatterns: &Vector<Ast::PatternId>,
      name: str,
      fallback: SourceSpan,
    ): SourceSpan {
      let mut index: u64 = 0;

      while (index < memberPatterns.length()) {
        if (let Option::SOME(patternId) = memberPatterns.get(index)) {
          if (let Option::SOME(Ast::Pattern::Node::Binding(binding)) = module.patterns.get(*patternId)) {
            if (binding.name.equals(name)) {
              if (let Option::SOME(annotationId) = binding.annotation) {
                if (let Option::SOME(typeNode) = module.types.get(annotationId)) {
                  return Ast::Serializer::typeSpan(typeNode);
                }
              }

              return binding.span;
            }
          }
        }

        index += 1;
      }

      return fallback;
    }

    /// A `static mut` field written without an initializer starts with every
    /// byte zero, so its declared type has to have a zero value (A0239).
    function checkZeroInitializedStatic(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      staticDefId: Analyzer::DefinitionId,
      fieldName: &String,
      span: SourceSpan,
    ): void {
      let Option::SOME(definition) = defStore.get(staticDefId) else {
        return;
      };

      let Analyzer::Definition::Variable(variableDef) = definition else {
        return;
      };

      let declaredType: Analyzer::TypeId = variableDef.declaredType;

      if (let Option::SOME(failure) = Analyzer::Typecheck::zeroInitFailure(defStore, typeStore, symbols, declaredType)) {
        let message: String = `'static mut' field '${fieldName.toStr()}' has no initializer, so it starts zeroed: ${failure.toStr()}`;

        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_NOT_ZEROABLE, message.toStr());
      }
    }

    /// Typecheck the value of every static field an enum declares. The members
    /// carry variants and static fields together, so the definitions are walked
    /// alongside them on their own counter.
    function checkEnumStaticFields(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      enumDefId: Analyzer::DefinitionId,
      enum_: &Ast::Item::Enum,
    ): void {
      let staticDefIds: Vector<Analyzer::DefinitionId> = Analyzer::Typecheck::enumStaticFieldDefs(defStore, enumDefId);

      if (staticDefIds.length() == 0) {
        return;
      }

      let mut staticIndex: u64 = 0;
      let mut patternIndex: u64 = 0;

      while (patternIndex < enum_.variants.length()) {
        let Option::SOME(memberPatId) = enum_.variants.get(patternIndex) else {
          patternIndex += 1;
          continue;
        };

        if (!Analyzer::Binder::variantPatternIsStaticField(module, *memberPatId)) {
          patternIndex += 1;
          continue;
        }

        let Option::SOME(staticDefId) = staticDefIds.get(staticIndex) else {
          patternIndex += 1;
          staticIndex += 1;
          continue;
        };

        if (let Option::SOME(pattern) = module.patterns.get(*memberPatId)) {
          if (let Ast::Pattern::Node::Binding(binding) = pattern) {
            if (let Option::SOME(valueExprId) = binding.initializer) {
              Analyzer::Typecheck::checkStaticFieldValue(
                state,
                defStore,
                typeStore,
                symbols,
                module,
                resolvedBodies,
                *staticDefId,
                valueExprId,
                binding.span,
              );
            }

            Analyzer::Typecheck::checkThreadLocalNeedsNoDrop(state, defStore, typeStore, symbols, *staticDefId, &binding.name, binding.span);
          }
        }

        staticIndex += 1;
        patternIndex += 1;
      }
    }

    /// The enum's static field definitions, in declaration order.
    function enumStaticFieldDefs(
      defStore: &mut Analyzer::DefinitionStore,
      enumDefId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let Option::SOME(definition) = defStore.get(enumDefId) else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      let Analyzer::Definition::Enum(enum_) = definition else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      return Analyzer::Typecheck::copyDefinitionIdVector(&enum_.staticFields);
    }

    /// The record's static field definitions, in declaration order.
    function recordStaticFieldDefs(
      defStore: &mut Analyzer::DefinitionStore,
      recordDefId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let Option::SOME(definition) = defStore.get(recordDefId) else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      let Analyzer::Definition::Record(record_) = definition else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      return Analyzer::Typecheck::copyDefinitionIdVector(&record_.staticFields);
    }

    /// Typecheck one static field's value against its declared type, in the
    /// same value-only context a module constant is checked in.
    function checkStaticFieldValue(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      staticDefId: Analyzer::DefinitionId,
      valueExprId: Ast::ExpressionId,
      span: SourceSpan,
    ): void {
      let Option::SOME(definition) = defStore.get(staticDefId) else {
        return;
      };

      let Analyzer::Definition::Variable(variableDef) = definition else {
        return;
      };

      let declaredType: Analyzer::TypeId = variableDef.declaredType;

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.currentFunction = staticDefId;
      stateRef.currentReturnType = declaredType;
      stateRef.loopDepth = 0;
      stateRef.scopeMarks = Vector::new<u64>();
      stateRef.localPatternIds = Vector::new<Ast::PatternId>();
      stateRef.localFunctionIds = Vector::new<Analyzer::DefinitionId>();
      stateRef.localIndexes = Vector::new<u32>();
      stateRef.localTypeIds = Vector::new<Analyzer::TypeId>();
      stateRef.localMutableFlags = Vector::new<boolean>();
      stateRef.localPlaceMutableFlags = Vector::new<boolean>();

      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        valueExprId,
        Option::SOME(declaredType),
      );

      if (let Option::SOME(actualType) = actualTypeOpt) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, declaredType, actualType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, defStore, typeStore, symbols, span, declaredType, actualType);
        }
      }
    }

    /// Resolve the `DefinitionId` for an owner-local method item and reuse
    /// `checkFunctionItem` to typecheck its body. `extractFunctionSignature`
    /// handles `Definition::Method`, so method bodies are checked exactly like
    /// function bodies: parameters are bound as locals and the return statement
    /// is validated against the resolved method return type. Signature-only
    /// methods with empty block bodies reach `checkStmt` with no return statement
    /// and therefore emit no diagnostic.
    function checkMethodItem(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      methodItemId: Ast::ItemId,
      function_: &Ast::Item::Function,
    ): void {
      let defOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::lookupItemDef(pass1, pass2, methodItemId);
      let Option::SOME(defId) = defOpt else {
        return;
      };

      Analyzer::Typecheck::checkFunctionItem(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        defId,
        function_,
      );
    }

    /// Remembers the diagnostics the copy of a trait default on one
    /// implementing type produced, from `start` to the end of the bag.
    function recordInheritedDiagnostics(
      state: &mut Analyzer::Typecheck::TypecheckState,
      start: u64,
      inherited: &Ast::InheritedMethod,
    ): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      let end: u64 = stateRef.diagnostics.length();

      if (end == start) {
        return;
      }

      let note: String = Ast::inheritedMethodNote(inherited);

      stateRef.inheritedStarts.push(start);
      stateRef.inheritedEnds.push(end);
      stateRef.inheritedNotes.push(note);
    }

    /// The index of the inherited range holding diagnostic `index`, if any.
    function inheritedRangeOf(
      state: &Analyzer::Typecheck::TypecheckState,
      index: u64
    ): Option<u64> {
      let mut rangeIndex: u64 = 0;

      while (rangeIndex < state.inheritedStarts.length()) {
        if (let Option::SOME(start) = state.inheritedStarts.get(rangeIndex)) {
          if (let Option::SOME(end) = state.inheritedEnds.get(rangeIndex)) {
            if (index >= *start && index < *end) {
              return Option::SOME(rangeIndex);
            }
          }
        }

        rangeIndex += 1;
      }

      return Option::NONE;
    }

    /// Settles what the copies of trait defaults reported.
    ///
    /// Every default body is checked once against the trait, whose `Self` sees
    /// only the trait's methods, and again on each type that inherits it. An
    /// error the trait-level check already reports at the same place is that
    /// report, so the copies' version of it is dropped. What only a copy finds
    /// depends on the implementing type: it is kept, once per type, with a note
    /// naming the type.
    function settleInheritedDiagnostics(state: &mut Analyzer::Typecheck::TypecheckState): void {
      if (state.inheritedStarts.length() == 0) {
        return;
      }

      let mut settled: DiagnosticBag = DiagnosticBag::init();
      let mut index: u64 = 0;

      while (index < state.diagnostics.length()) {
        let Option::SOME(diagnostic) = state.diagnostics.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(rangeIndex) = Analyzer::Typecheck::inheritedRangeOf(&*state, index) else {
          settled.push(Analyzer::copyDiagnostic(diagnostic));
          index += 1;
          continue;
        };

        let mut reportedByTrait: boolean = false;
        let mut otherIndex: u64 = 0;

        while (otherIndex < state.diagnostics.length()) {
          if (Analyzer::Typecheck::inheritedRangeOf(&*state, otherIndex).isNone()) {
            if (let Option::SOME(other) = state.diagnostics.get(otherIndex)) {
              if (other.code.equals(diagnostic.code) && Analyzer::sameSpan(&other.primarySpan, &diagnostic.primarySpan)) {
                reportedByTrait = true;
              }
            }
          }

          otherIndex += 1;
        }

        if (!reportedByTrait) {
          let mut kept: Diagnostic = Analyzer::copyDiagnostic(diagnostic);

          if (let Option::SOME(note) = state.inheritedNotes.get(rangeIndex)) {
            kept.addNote(note.toStr());
          }

          settled.push(kept);
        }

        index += 1;
      }

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.diagnostics = settled;
    }

    /// Iterate an owner's method `ItemId`s and typecheck each method body.
    /// Non-Function items in the methods vector are skipped defensively. Mirrors
    /// `ResolverBodies::walkOwnerMethodsForBody` but for typecheck traversal.
    function checkOwnerMethods(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      methodItemIds: &Vector<Ast::ItemId>,
    ): void {
      let mut index: u64 = 0;

      while (index < methodItemIds.length()) {
        let Option::SOME(methodItemId) = methodItemIds.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(item) = module.items.get(*methodItemId) else {
          index += 1;
          continue;
        };

        match (item) {
          Ast::Item::Node::Function(function_) -> {
            let start: u64 = state.diagnostics.length();

            // A copy of a trait default another module declares names what
            // that module sees, not what this one does.
            let mut previousModule: Option<u64> = Option::NONE;

            if (let Option::SOME(scope) = module.inheritedScopeOf(*methodItemId)) {
              if (let Option::SOME(sourcePath) = &scope.sourceModule) {
                let mut scopeRef: &mut Analyzer::DefinitionStore = defStore;
                previousModule = scopeRef.enterModuleScope(&sourcePath);
              }
            }

            Analyzer::Typecheck::checkMethodItem(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              pass1,
              pass2,
              resolvedBodies,
              *methodItemId,
              &function_,
            );

            if (let Option::SOME(previous) = previousModule) {
              let mut scopeRef: &mut Analyzer::DefinitionStore = defStore;
              scopeRef.leaveModuleScope(previous);
            }

            if (let Option::SOME(inherited) = module.inheritedMethod(*methodItemId)) {
              Analyzer::Typecheck::recordInheritedDiagnostics(state, start, inherited);
            }
          },
          Ast::Item::Node::Record(_) -> {},
          Ast::Item::Node::Enum(_) -> {},
          Ast::Item::Node::Namespace(_) -> {},
          Ast::Item::Node::Import(_) -> {},
          Ast::Item::Node::Extern(_) -> {},
          Ast::Item::Node::Constant(_) -> {},
          Ast::Item::Node::Export(_) -> {},
          Ast::Item::Node::TypeAlias(_) -> {},
          Ast::Item::Node::Trait(_) -> {},
        };

        index += 1;
      }
    }

    /// Typecheck every item in a container's item list. Used for the children of
    /// namespaces, which hold most of the real declaration surface.
    function checkItems(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      itemIds: &Vector<Ast::ItemId>,
    ): void {
      let mut index: u64 = 0;

      while (index < itemIds.length()) {
        let Option::SOME(itemId) = itemIds.get(index) else {
          index += 1;
          continue;
        };

        Analyzer::Typecheck::checkItem(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          pass1,
          pass2,
          resolvedBodies,
          *itemId,
        );

        index += 1;
      }
    }

    function checkItem(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      itemId: Ast::ItemId,
    ): void {
      let Option::SOME(item) = module.items.get(itemId) else {
        return;
      };

      match (item) {
        Ast::Item::Node::Function(function_) -> {
          let defOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::lookupItemDef(pass1, pass2, itemId);
          let Option::SOME(defId) = defOpt else {
            return;
          };

          Analyzer::Typecheck::checkFunctionItem(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            defId,
            &function_,
          );
        },
        Ast::Item::Node::Constant(constant) -> {
          let defOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::lookupItemDef(pass1, pass2, itemId);
          let Option::SOME(defId) = defOpt else {
            return;
          };

          Analyzer::Typecheck::checkConstantItem(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            defId,
            &constant,
          );
        },
        Ast::Item::Node::Record(record_) -> {
          if (let Option::SOME(recordDefId) = Analyzer::Typecheck::lookupItemDef(pass1, pass2, itemId)) {
            Analyzer::Typecheck::checkRecordCopyStructural(
              state,
              defStore,
              typeStore,
              symbols,
              recordDefId,
              record_.span,
            );

            if (module.extensionTarget(itemId).isSome()) {
              // A block whose target did not resolve was reported already.
              if (defStore.extensionTargetOf(recordDefId).isSome()) {
                Analyzer::Typecheck::checkImplementedTraitMethods(state, defStore, typeStore, symbols, recordDefId, record_.span);
                Analyzer::Typecheck::checkExtensionBlock(state, defStore, typeStore, symbols, recordDefId, record_.span);
              }
            } else {
              Analyzer::Typecheck::checkImplementedTraitMethods(state, defStore, typeStore, symbols, recordDefId, record_.span);
              Analyzer::Typecheck::checkExtensionDuplicates(state, defStore, typeStore, symbols, recordDefId, record_.span);
            }

            Analyzer::Typecheck::checkRecordFieldBounds(state, defStore, typeStore, symbols, module, recordDefId, &record_);

            Analyzer::Typecheck::checkRecordStaticFields(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              recordDefId,
              &record_,
            );
          }

          Analyzer::Typecheck::checkOwnerMethods(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            pass1,
            pass2,
            resolvedBodies,
            &record_.methods,
          );
        },
        Ast::Item::Node::Enum(enum_) -> {
          if (let Option::SOME(enumDefId) = Analyzer::Typecheck::lookupItemDef(pass1, pass2, itemId)) {
            Analyzer::Typecheck::checkEnumCopyStructural(
              state,
              defStore,
              typeStore,
              symbols,
              enumDefId,
              enum_.span,
            );

            Analyzer::Typecheck::checkImplementedTraitMethods(state, defStore, typeStore, symbols, enumDefId, enum_.span);
            Analyzer::Typecheck::checkExtensionDuplicates(state, defStore, typeStore, symbols, enumDefId, enum_.span);

            Analyzer::Typecheck::checkEnumMemberBounds(state, defStore, typeStore, symbols, module, enumDefId, &enum_);

            Analyzer::Typecheck::checkEnumStaticFields(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              enumDefId,
              &enum_,
            );
          }

          Analyzer::Typecheck::checkOwnerMethods(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            pass1,
            pass2,
            resolvedBodies,
            &enum_.methods,
          );
        },
        Ast::Item::Node::Namespace(namespace_) -> {
          Analyzer::Typecheck::checkItems(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            pass1,
            pass2,
            resolvedBodies,
            &namespace_.items,
          );
        },
        Ast::Item::Node::Import(_) -> {},
        Ast::Item::Node::Extern(_) -> {},
        Ast::Item::Node::Export(export_) -> {
          if (let Option::SOME(innerItemId) = export_.declaration) {
            Analyzer::Typecheck::checkItem(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              pass1,
              pass2,
              resolvedBodies,
              innerItemId,
            );
          }
        },
        Ast::Item::Node::TypeAlias(_) -> {},
        Ast::Item::Node::Trait(trait_) -> {
          Analyzer::Typecheck::checkOwnerMethods(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            pass1,
            pass2,
            resolvedBodies,
            &trait_.methods,
          );
        },
      };
    }
  }
}
