/// A payload variant used bare is reported as a zero-argument application of a
/// one-argument constructor.
/// Spec: IGN-127 — variant construction.
@test
function typecheckPayloadVariantWithoutArgumentsIsRejected(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "enum Shape {\n  CIRCLE(u32),\n  EMPTY,\n}\n\nfunction make(): Shape {\n  return Shape::CIRCLE;\n}\n",
