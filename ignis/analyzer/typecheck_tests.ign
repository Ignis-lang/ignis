  let blockExpr: Ast::ExpressionId = typecheckAddBlockExpr(&mut module, Vector::new<Ast::StatementId>(), Option::SOME(typecheckAddIntLiteral(&mut module, 1)));
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, blockExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, blockExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario (follow-up a, S3 review): when every arm body fails to
/// typecheck (an unresolved variable reference in both arms), `joinTypes`
/// must NOT fall back to claiming the match's own type is `NEVER` and then
/// compare that synthetic `NEVER` against `expected` — that would add a
/// spurious third diagnostic on top of the two unresolved-reference
/// diagnostics already emitted at each arm's own call site. Distinguishing
/// "no candidates because none typed" from "all candidates were `NEVER`-
/// typed diverging arms" requires the caller to report how many bodies were
/// attempted; `joinTypes` returns `Option::NONE` (undiagnosed further) here,
/// and the match expression itself records no expression type.
/// Spec: selfhost-typecheck — arm/branch compatibility checked unconditionally
/// (S3 review follow-up, not a spec regression).
@test
function typecheckMatchExpressionAllFailedArmsReturnsNoneNotNever(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");
  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddVariable(&mut module, "missingA"),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddVariable(&mut module, "missingB"),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Only the two unresolved-reference diagnostics (one per arm body) remain
  // — no additional "type mismatch: expected `i32`, found `NEVER`" from a
  // spurious NEVER fallback.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 2);
  Test::assertEq<boolean>(findExprType(&output, matchExpr).isSome(), false);
}

// Phase 16: record-init and call-argument expectation
// (selfhost-bidirectional-typecheck, S5)
// ============================================================

/// Scenario: a call argument that is itself a match-expression is now
/// checked with `expected` set to the parameter's declared type, so a
/// consistently-typed-but-wrong-typed set of arms is caught by `joinTypes`'
/// own expected-comparison (`type mismatch`) instead of by the call site's
/// generic `invalid argument type` fallback. Exactly one diagnostic is
/// emitted — no cascade into a second one once `joinTypes` already reported
/// the mismatch and returned `Option::NONE`.
/// Spec: selfhost-typecheck — record-init and call-argument expectation.
@test
function typecheckCallArgumentMatchExpressionJoinsAgainstParameterType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let boolTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let helperParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "flag", boolTypeId);
  let helperExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "flag");
  let helperRet: Ast::StatementId = typecheckAddReturnExpr(&mut module, helperExpr);
  let mut helperBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  helperBodyStmts.push(helperRet);
  let helperBody: Ast::StatementId = typecheckAddBlock(&mut module, helperBodyStmts);
  let mut helperParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  helperParams.push(helperParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("helper"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: helperParams,
    returnType: Option::SOME(boolTypeId),
    body: helperBody,
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchArg: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);

  let helperCallee: Ast::ExpressionId = typecheckAddVariable(&mut module, "helper");
  let mut callArgs: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  callArgs.push(matchArg);
  let callExpr: Ast::ExpressionId = typecheckAddCall(&mut module, helperCallee, callArgs);
  let callStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, callExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(callStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Before threading `expected` into the call-argument check, this mismatch
  // would surface as `invalid argument type` from the call site's own
  // fallback comparison. With `expected` threaded, `joinTypes` catches it
  // first (via its own `expected`-comparison) and reports the generic
  // `type mismatch` diagnostic instead — still exactly one diagnostic.
  assertSingleDiagnostic(&output, DiagnosticCode::TYPE_MISMATCH, "type mismatch: expected `boolean`, found `i32`");
}

/// Scenario: a call argument that is a match-expression whose joined type
/// already matches the parameter's declared type typechecks cleanly, with
/// the match's own expression type recorded as the parameter's type.
/// Spec: selfhost-typecheck — record-init and call-argument expectation.
@test
function typecheckCallArgumentMatchExpressionAgainstCompatibleParameterType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let helperParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", i32TypeId);
  let helperExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "value");
  let helperRet: Ast::StatementId = typecheckAddReturnExpr(&mut module, helperExpr);
  let mut helperBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  helperBodyStmts.push(helperRet);
  let helperBody: Ast::StatementId = typecheckAddBlock(&mut module, helperBodyStmts);
  let mut helperParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  helperParams.push(helperParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("helper"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: helperParams,
    returnType: Option::SOME(i32TypeId),
    body: helperBody,
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchArg: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);

  let helperCallee: Ast::ExpressionId = typecheckAddVariable(&mut module, "helper");
  let mut callArgs: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  callArgs.push(matchArg);
  let callExpr: Ast::ExpressionId = typecheckAddCall(&mut module, helperCallee, callArgs);
  let callStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, callExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(callStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, matchArg, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: a record-init field value that is a match-expression is now
/// checked with `expected` set to the field's declared type, so `joinTypes`'
/// own expected-comparison — not the record-init's generic field-mismatch
/// fallback — is what reports the mismatch. The diagnostic's span is the
/// match expression's own span (recorded from inside `checkMatchExpr`), not
/// the record-init's span, proving `expected` actually reached the field
/// value instead of being discarded at the call site. Exactly one
/// diagnostic is emitted; the record-init's own fallback check never runs
/// because `checkExprExpected` already returned `Option::NONE`.
/// Spec: selfhost-typecheck — record-init and call-argument expectation.
@test
function typecheckRecordInitFieldValueMatchExpressionJoinsAgainstFieldType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let boolTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let xField: Ast::PatternId = typecheckAddAnnotatedField(&mut module, "x", boolTypeId);
  let mut pointFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  pointFields.push(xField);
  typecheckAddRecordItem(&mut module, "Point", Vector::new<Ast::GenericParam>(), pointFields);

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchSpan: SourceSpan = SourceSpan::new("typecheck_tests.ign", 30, 40);
  let matchFieldValue: Ast::ExpressionId = module.addExpression(Ast::Expression::Node::Match(Ast::Expression::Match {
    span: matchSpan,
    scrutinee: cExpr,
    arms: arms,
  }));

  let pointPath: Ast::ExpressionId = typecheckAddVariable(&mut module, "Point");
  let mut initFields: Vector<Ast::Expression::RecordInitField> = Vector::new<Ast::Expression::RecordInitField>();
  initFields.push(typecheckRecordInitField("x", matchFieldValue));
  let recordSpan: SourceSpan = SourceSpan::new("typecheck_tests.ign", 10, 20);
  let initExpr: Ast::ExpressionId = module.addExpression(Ast::Expression::Node::RecordInit(Ast::Expression::RecordInit {
    span: recordSpan,
    path: pointPath,
    typeArguments: Vector::new<Ast::TypeId>(),
    fields: initFields,
  }));
  let initStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, initExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(initStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
  let Option::SOME(diagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckRecordInitFieldValueMatchExpressionJoinsAgainstFieldType: missing diagnostic");
  };
  Test::assertEq<str>(diagnostic.code, DiagnosticCode::TYPE_MISMATCH);
  Test::assertEq<str>(diagnostic.messageText(), "type mismatch: expected `boolean`, found `i32`");
  Test::assertEq<u64>(diagnostic.primarySpan.start, 30);
}

/// Scenario: a record-init field value that is a nested record-init
/// resolves and checks cleanly once `expected` reaches the outer field
/// value — pinning that threading `expected` through `checkRecordInitExpr`'s
/// field loop does not disturb ordinary nested initializers (the nested
/// record's own path resolution is independent of the outer expectation;
/// only its own declared field types matter).
/// Spec: selfhost-typecheck — record-init and call-argument expectation.
@test
function typecheckRecordInitFieldValueNestedRecordInitTypechecksCleanly(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let innerValueField: Ast::PatternId = typecheckAddAnnotatedField(&mut module, "value", i32TypeId);
  let mut innerFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  innerFields.push(innerValueField);
  typecheckAddRecordItem(&mut module, "Inner", Vector::new<Ast::GenericParam>(), innerFields);

  let innerPathType: Ast::TypeId = typecheckAddPathType(&mut module, "Inner");
  let outerInnerField: Ast::PatternId = typecheckAddAnnotatedField(&mut module, "inner", innerPathType);
  let mut outerFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  outerFields.push(outerInnerField);
  typecheckAddRecordItem(&mut module, "Outer", Vector::new<Ast::GenericParam>(), outerFields);

  let innerPath: Ast::ExpressionId = typecheckAddVariable(&mut module, "Inner");
  let mut innerInitFields: Vector<Ast::Expression::RecordInitField> = Vector::new<Ast::Expression::RecordInitField>();
  innerInitFields.push(typecheckRecordInitField("value", typecheckAddIntLiteral(&mut module, 1)));
  let innerInit: Ast::ExpressionId = typecheckAddRecordInit(&mut module, innerPath, Vector::new<Ast::TypeId>(), innerInitFields);

  let outerPath: Ast::ExpressionId = typecheckAddVariable(&mut module, "Outer");
  let mut outerInitFields: Vector<Ast::Expression::RecordInitField> = Vector::new<Ast::Expression::RecordInitField>();
  outerInitFields.push(typecheckRecordInitField("inner", innerInit));
  let outerInit: Ast::ExpressionId = typecheckAddRecordInit(&mut module, outerPath, Vector::new<Ast::TypeId>(), outerInitFields);
  let outerStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, outerInit);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(outerStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  Test::assertEq<boolean>(findExprType(&output, innerInit).isSome(), true);
  Test::assertEq<boolean>(findExprType(&output, outerInit).isSome(), true);
}

/// Scenario (mandatory S4-review follow-up): a match-expression where one
/// arm typechecks successfully (`i32`) and the sibling arm fails on its own
/// (an unresolved variable reference). Pins two things: (a) exactly the
/// failed arm's own diagnostic is emitted — `joinTypes` does not add a
/// second diagnostic for the mismatch-that-never-happens, since the failed
/// arm contributes no candidate to the join at all; and (b) the CURRENT
/// survivor-propagation behavior — the match's joined type is the one
/// successfully-typed arm's type (`i32`) — even though its sibling failed.
/// This is intentional-for-now: overall compilation already fails because
/// of the failed arm's own diagnostic, so a "wrong" survivor type causes no
/// additional harm today. A future change to divergent-arm handling should
/// treat this test as the point of deliberate departure, not a silent
/// regression.
/// Spec: selfhost-typecheck — arm/branch compatibility checked unconditionally.
@test
function typecheckMatchExpressionMixedPartialJoinUsesSurvivorType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");
  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddVariable(&mut module, "missing"),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Follow-up (a): exactly the failed arm's own unresolved-reference
  // diagnostic — no additional join-mismatch diagnostic.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);

  // Follow-up (b): the joined type is the survivor arm's type (`i32`),
  // pinned as CURRENT, intentional-for-now behavior.
  assertExprType(&output, matchExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: a lambda with annotated parameters and an annotated return type takes the
/// function type it denotes, and its body is checked against its own return type.
/// Spec: IGN-26 — lambda typing, unblocked by the closure resolution of IGN-14.
@test
function typecheckLambdaExpressionHappyPath(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  // function main(): void { let f: (i32) -> i32 = (x: i32): i32 -> { return x; }; return; }
  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let voidTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "void");

  let mut annotationParams: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  annotationParams.push(i32TypeId);
  let lambdaAnnotation: Ast::TypeId = module.addType(Ast::Type::Node::Function(Ast::Type::Function {
    span: typecheckDummySpan(),
    parameters: annotationParams,
    returnType: i32TypeId,
  }));

  let paramPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "x", i32TypeId);
  let paramUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "x");
  let lambdaReturn: Ast::StatementId = typecheckAddReturnExpr(&mut module, paramUse);

  let mut lambdaBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  lambdaBodyStmts.push(lambdaReturn);
  let lambdaBody: Ast::StatementId = typecheckAddBlock(&mut module, lambdaBodyStmts);

  let mut lambdaParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  lambdaParams.push(paramPattern);

  let lambdaExpr: Ast::ExpressionId = module.addExpression(Ast::Expression::Node::Lambda(Ast::Expression::Lambda {
    span: typecheckDummySpan(),
    parameters: lambdaParams,
    returnType: Option::SOME(i32TypeId),
    body: lambdaBody,
  }));

  let fPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "_f", lambdaAnnotation);
  let letStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: fPattern,
    annotation: Option::SOME(lambdaAnnotation),
    value: Option::SOME(lambdaExpr),
  }));

  let retStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Return(Ast::Statement::Return {
    span: typecheckDummySpan(),
    value: Option::NONE,
  }));

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(voidTypeId),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  Test::assertEq<u64>(output.diagnostics.length(), 0);

  let i32Type: Analyzer::TypeId = typeStore.intern(Analyzer::Type::I32);
  let mut expectedParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  expectedParams.push(i32Type);
  let expectedLambdaType: Analyzer::TypeId = typeStore.intern(Analyzer::Type::Function(Analyzer::FunctionType {
    params: expectedParams,
    returnType: i32Type,
  }));

  assertExprType(&output, lambdaExpr, expectedLambdaType);
  assertExprType(&output, paramUse, i32Type);
}

/// Scenario: calling a local that holds a function value takes its signature from the local's
/// own type, checks the arguments against it, and yields its return type.
/// Spec: IGN-26 — callees that are locals rather than definitions.
@test
function typecheckCallThroughLocalFunctionValueHappyPath(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  // function main(): i32 { let f: (i32) -> i32 = (x: i32): i32 -> { return x; }; return f(1); }
  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");

  let mut annotationParams: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  annotationParams.push(i32TypeId);
  let lambdaAnnotation: Ast::TypeId = module.addType(Ast::Type::Node::Function(Ast::Type::Function {
    span: typecheckDummySpan(),
    parameters: annotationParams,
    returnType: i32TypeId,
  }));

  let paramPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "x", i32TypeId);
  let paramUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "x");
  let lambdaReturn: Ast::StatementId = typecheckAddReturnExpr(&mut module, paramUse);

  let mut lambdaBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  lambdaBodyStmts.push(lambdaReturn);
  let lambdaBody: Ast::StatementId = typecheckAddBlock(&mut module, lambdaBodyStmts);

  let mut lambdaParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  lambdaParams.push(paramPattern);

  let lambdaExpr: Ast::ExpressionId = module.addExpression(Ast::Expression::Node::Lambda(Ast::Expression::Lambda {
    span: typecheckDummySpan(),
    parameters: lambdaParams,
    returnType: Option::SOME(i32TypeId),
    body: lambdaBody,
  }));

  let fPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "f", lambdaAnnotation);
  let letStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: fPattern,
    annotation: Option::SOME(lambdaAnnotation),
    value: Option::SOME(lambdaExpr),
  }));

  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "f");
  let argExpr: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);

  let mut callArgs: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  callArgs.push(argExpr);

  let callExpr: Ast::ExpressionId = module.addExpression(Ast::Expression::Node::Call(Ast::Expression::Call {
    span: typecheckDummySpan(),
    callee: calleeExpr,
    typeArguments: Vector::new<Ast::TypeId>(),
    arguments: callArgs,
  }));

  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, callExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(i32TypeId),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  Test::assertEq<u64>(output.diagnostics.length(), 0);

  let i32Type: Analyzer::TypeId = typeStore.intern(Analyzer::Type::I32);
  assertExprType(&output, callExpr, i32Type);
}

/// Build `function main(): i32 { let f: (i32) -> i32 = (x: i32): i32 -> { return x; }; <tail> }`
/// and return the module plus the identifiers a caller needs to assert on.
///
/// Every call-through-a-local scenario needs the same lambda-bound local; only what follows it
/// differs, so the shared part lives here rather than in each test.
function typecheckAddFunctionValuedLocal(
  module: &mut Ast::Module,
  i32TypeId: Ast::TypeId,
): Ast::StatementId {
  let mut annotationParams: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  annotationParams.push(i32TypeId);

  let mut moduleRef: &mut Ast::Module = module;
  let lambdaAnnotation: Ast::TypeId = moduleRef.addType(Ast::Type::Node::Function(Ast::Type::Function {
    span: typecheckDummySpan(),
    parameters: annotationParams,
    returnType: i32TypeId,
  }));

  let paramPattern: Ast::PatternId = typecheckAddAnnotatedBinding(module, "x", i32TypeId);
  let paramUse: Ast::ExpressionId = typecheckAddVariable(module, "x");
  let lambdaReturn: Ast::StatementId = typecheckAddReturnExpr(module, paramUse);

  let mut lambdaBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  lambdaBodyStmts.push(lambdaReturn);
  let lambdaBody: Ast::StatementId = typecheckAddBlock(module, lambdaBodyStmts);

  let mut lambdaParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  lambdaParams.push(paramPattern);

  let mut moduleRef2: &mut Ast::Module = module;
  let lambdaExpr: Ast::ExpressionId = moduleRef2.addExpression(Ast::Expression::Node::Lambda(Ast::Expression::Lambda {
    span: typecheckDummySpan(),
    parameters: lambdaParams,
    returnType: Option::SOME(i32TypeId),
    body: lambdaBody,
  }));

  let fPattern: Ast::PatternId = typecheckAddAnnotatedBinding(module, "f", lambdaAnnotation);

  let mut moduleRef3: &mut Ast::Module = module;
  return moduleRef3.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: fPattern,
    annotation: Option::SOME(lambdaAnnotation),
    value: Option::SOME(lambdaExpr),
  }));
}

/// Add `f(<args>)` and return the call expression id.
function typecheckAddLocalCall(
  module: &mut Ast::Module,
  args: Vector<Ast::ExpressionId>,
): Ast::ExpressionId {
  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(module, "f");
  let mut moduleRef: &mut Ast::Module = module;

  return moduleRef.addExpression(Ast::Expression::Node::Call(Ast::Expression::Call {
    span: typecheckDummySpan(),
    callee: calleeExpr,
    typeArguments: Vector::new<Ast::TypeId>(),
    arguments: args,
  }));
}

/// Wrap `stmts` in `function main(): <returnType> { ... }` and register it as a root item.
function typecheckAddMainFunction(
  module: &mut Ast::Module,
  stmts: Vector<Ast::StatementId>,
  returnType: Ast::TypeId,
): void {
  let bodyBlock: Ast::StatementId = typecheckAddBlock(module, stmts);
  let mut moduleRef: &mut Ast::Module = module;

  moduleRef.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(returnType),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));
}

/// Scenario: calling a function-valued local with the wrong number of arguments reports the
/// arity mismatch, and the call still takes the declared return type so one mistake does not
/// cascade.
/// Spec: IGN-26 — callees that are locals.
@test
function typecheckCallThroughLocalWithWrongArityProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let letStmt: Ast::StatementId = typecheckAddFunctionValuedLocal(&mut module, i32TypeId);

  let firstArg: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let secondArg: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 2);

  let mut callArgs: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  callArgs.push(firstArg);
  callArgs.push(secondArg);

  let callExpr: Ast::ExpressionId = typecheckAddLocalCall(&mut module, callArgs);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, callExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::INVALID_NUMBER_OF_ARGUMENTS);
  assertExprType(&output, callExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: an argument whose type does not match the parameter is reported against the
/// signature carried by the local's own type.
/// Spec: IGN-26 — callees that are locals.
@test
function typecheckCallThroughLocalWithWrongArgumentTypeProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let letStmt: Ast::StatementId = typecheckAddFunctionValuedLocal(&mut module, i32TypeId);

  let boolArg: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);

  let mut callArgs: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  callArgs.push(boolArg);

  let callExpr: Ast::ExpressionId = typecheckAddLocalCall(&mut module, callArgs);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, callExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::INVALID_ARGUMENT_TYPE);
}

/// Scenario: calling a local that is not a function at all is a type error naming the type,
/// not an unsupported construct.
/// Spec: IGN-26 — A0069.
@test
function typecheckCallThroughNonCallableLocalProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  // function main(): i32 { let f: i32 = 1; return f(); }
  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let fPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "f", i32TypeId);
  let initExpr: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);

  let letStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: fPattern,
    annotation: Option::SOME(i32TypeId),
    value: Option::SOME(initExpr),
  }));

  let callExpr: Ast::ExpressionId = typecheckAddLocalCall(&mut module, Vector::new<Ast::ExpressionId>());
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, callExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::CALL_ON_NON_CALLABLE);
}

/// Add `@name<typeArgs>(args)` and return its expression id.
function typecheckAddBuiltinCall(
  module: &mut Ast::Module,
  name: str,
  typeArgs: Vector<Ast::TypeId>,
  args: Vector<Ast::ExpressionId>,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;

  return moduleRef.addExpression(Ast::Expression::Node::BuiltinCall(Ast::Expression::BuiltinCall {
    span: typecheckDummySpan(),
    name: String::create(name),
    typeArguments: typeArgs,
    arguments: args,
  }));
}

/// Scenario: `@sizeOf<i32>()`, `@alignOf<i32>()`, and `@typeName<i32>()` take one
/// type argument and yield their fixed result types.
/// Spec: IGN-26 — builtin calls.
@test
function typecheckTypeArgumentBuiltinsHappyPath(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let u64TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "u64");

  let mut typeArgs: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  typeArgs.push(i32TypeId);
  let mut alignOfTypeArgs: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  alignOfTypeArgs.push(i32TypeId);
  let mut typeNameTypeArgs: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  typeNameTypeArgs.push(i32TypeId);

  let builtinExpr: Ast::ExpressionId = typecheckAddBuiltinCall(
    &mut module,
    "sizeOf",
    typeArgs,
    Vector::new<Ast::ExpressionId>(),
  );

  let alignOfExpr: Ast::ExpressionId = typecheckAddBuiltinCall(
    &mut module,
    "alignOf",
    alignOfTypeArgs,
    Vector::new<Ast::ExpressionId>(),
  );

  let typeNameExpr: Ast::ExpressionId = typecheckAddBuiltinCall(
    &mut module,
    "typeName",
    typeNameTypeArgs,
    Vector::new<Ast::ExpressionId>(),
  );

  let alignOfStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Expression(Ast::Statement::Expression {
    span: typecheckDummySpan(),
    expression: alignOfExpr,
  }));
  let typeNameStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Expression(Ast::Statement::Expression {
    span: typecheckDummySpan(),
    expression: typeNameExpr,
  }));
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, builtinExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(alignOfStmt);
  bodyStmts.push(typeNameStmt);
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, u64TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, builtinExpr, typeStore.intern(Analyzer::Type::U64));
  assertExprType(&output, alignOfExpr, typeStore.intern(Analyzer::Type::U64));
  assertExprType(&output, typeNameExpr, typeStore.intern(Analyzer::Type::STR));
}

/// Scenario: `@panic("boom")`, `@trap()`, and `@unreachable()` never return.
/// Spec: IGN-26 — builtin calls.
@test
function typecheckDivergingBuiltinsHappyPath(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let voidTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "void");

  let messageExpr: Ast::ExpressionId = module.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: typecheckDummySpan(),
    value: Ast::Expression::LiteralValue::String(String::create("boom")),
  }));

  let mut args: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  args.push(messageExpr);

  let builtinExpr: Ast::ExpressionId = typecheckAddBuiltinCall(
    &mut module,
    "panic",
    Vector::new<Ast::TypeId>(),
    args,
  );

  let trapExpr: Ast::ExpressionId = typecheckAddBuiltinCall(
    &mut module,
    "trap",
    Vector::new<Ast::TypeId>(),
    Vector::new<Ast::ExpressionId>(),
  );
  let unreachableExpr: Ast::ExpressionId = typecheckAddBuiltinCall(
    &mut module,
    "unreachable",
    Vector::new<Ast::TypeId>(),
    Vector::new<Ast::ExpressionId>(),
  );

  let trapStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Expression(Ast::Statement::Expression {
    span: typecheckDummySpan(),
    expression: trapExpr,
  }));
  let unreachableStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Expression(Ast::Statement::Expression {
    span: typecheckDummySpan(),
    expression: unreachableExpr,
  }));

  let exprStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Expression(Ast::Statement::Expression {
    span: typecheckDummySpan(),
    expression: builtinExpr,
  }));

  // Each diverging builtin lives in its own function: any statement after a
  // `NEVER`-typed expression statement would now trip the extra-checks
  // unreachable-code diagnostic (A0025).
  let mut trapStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  trapStmts.push(trapStmt);
  let trapBody: Ast::StatementId = typecheckAddBlock(&mut module, trapStmts);
  typecheckAddFunctionItem(&mut module, "trapFn", Option::SOME(voidTypeId), trapBody);

  let mut unreachableStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  unreachableStmts.push(unreachableStmt);
  let unreachableBody: Ast::StatementId = typecheckAddBlock(&mut module, unreachableStmts);
  typecheckAddFunctionItem(&mut module, "unreachableFn", Option::SOME(voidTypeId), unreachableBody);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(exprStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, voidTypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, builtinExpr, typeStore.intern(Analyzer::Type::NEVER));
  assertExprType(&output, trapExpr, typeStore.intern(Analyzer::Type::NEVER));
  assertExprType(&output, unreachableExpr, typeStore.intern(Analyzer::Type::NEVER));
}

