@test
function typecheckFloatLiteralCoercesToAnnotatedFloatType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let f32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "f32");
  let literalExpr: Ast::ExpressionId = typecheckAddFloatLiteral(&mut module, 1.5);
  let ratioPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "_ratio", f32TypeId);
  let ratioStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, ratioPattern, f32TypeId, literalExpr);

  let mut stmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  stmts.push(ratioStmt);
  typecheckAddSingleExprFunction(&mut module, "coerceF32", stmts);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, literalExpr, typeStore.intern(Analyzer::Type::F32));
}

/// Scenario: a bare integer literal with no expected type keeps the default
/// `i32` — the coercion only fires when an expected type is supplied.
/// Spec: IGN-120 — integer literal coercion against the expected type.
@test
function typecheckIntLiteralWithoutAnnotationKeepsDefaultType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let literalExpr: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let exprStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, literalExpr);
  let mut stmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  stmts.push(exprStmt);
  typecheckAddSingleExprFunction(&mut module, "defaultInt", stmts);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, literalExpr, typeStore.intern(Analyzer::Type::I32));
}

// ===========================================================================
// IGN-127 — real variant payload types
//
// These tests go through the parser instead of building the AST by hand: a
// variant payload annotation only exists in parsed source, and the whole
// point of this slice is that the resolver reads it.
// ===========================================================================

function typecheckParseSource(source: str): ParseOutput {
  let file: SourceFile = SourceFile::create("typecheck_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(parsed.lexDiagnostics.length(), 0);
  Test::assertEq<u64>(parsed.parseDiagnostics.length(), 0);

  return parsed;
}

function typecheckCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

/// The first diagnostic code in `bag`, or `"none"` when the bag is empty.
function typecheckFirstDiagnosticCode(bag: &DiagnosticBag): str {
  let Option::SOME(diagnostic) = bag.get(0) else {
    return "none";
  };

  return diagnostic.code;
}

function typecheckFindTryExpr(module: &Ast::Module): Option<Ast::ExpressionId> {
  let mut index: u64 = 0;

  while (index < module.expressions.length()) {
    let exprId: Ast::ExpressionId = Id::fromRaw<Ast::ExpressionTag>(index as u32);

    if (let Option::SOME(node) = module.expressions.get(exprId)) {
      if (let Ast::Expression::Node::Try(_) = node) {
        return Option::SOME(exprId);
      }
    }

    index += 1;
  }

  return Option::NONE;
}

/// Declared payload type of `variantName`'s first slot, as a type name.
function typecheckVariantPayloadTypeName(
  defStore: &Analyzer::DefinitionStore,
  typeStore: &Analyzer::TypeStore,
  symbols: &Analyzer::SymbolTable,
  variantName: str,
): String {
  let mut index: u64 = 0;

  while (index < defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);

    if (let Option::SOME(definition) = defStore.get(defId)) {
      if (let Analyzer::Definition::Variant(variant) = definition) {
        if (let Option::SOME(name) = symbols.resolve(variant.name)) {
          if (name.equals(variantName)) {
            let Option::SOME(payloadType) = variant.payload.get(0) else {
              return String::create("<no-payload>");
            };

            return typeStore.nameOfResolved(*payloadType, defStore, symbols);
          }
        }
      }
    }

    index += 1;
  }

  return String::create("<variant-not-found>");
}

/// The headline of IGN-127: `!` on a `@lang(try)` enum whose ok variant
/// carries `u32` yields `u32`, so binding it to a `u32` local typechecks.
/// Before payload types were resolved this reported `I0031 expected u32,
/// found void`.
/// Spec: IGN-127 — real variant payload types.
@test
function typecheckTryYieldsTheOkPayloadType(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "@lang(try)\nenum Res {\n  OK(u32),\n  ERROR(u32),\n}\n\nfunction outer(input: Res): Res {\n  let unwrapped: u32 = input!;\n  return input;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);

  let Option::SOME(tryExpr) = typecheckFindTryExpr(&parsed.module) else {
    @panic("typecheckTryYieldsTheOkPayloadType: no try expression parsed");
  };

  assertExprType(&output, tryExpr, typeStore.intern(Analyzer::Type::U32));
}

/// The resolver replaces the binder's placeholders with the declared slot
/// types, including a slot whose type is another user record.
/// Spec: IGN-127 — real variant payload types.
@test
function typecheckResolvesDeclaredVariantPayloadTypes(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "record Point {\n  public x: u32;\n}\n\nenum Shape {\n  CIRCLE(u32),\n  AT(Point),\n  EMPTY,\n}\n\nfunction go(): void {\n  return;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
  Test::assertEq<str>(typecheckVariantPayloadTypeName(&defStore, &typeStore, &symbols, "CIRCLE").toStr(), "u32");
  Test::assertEq<str>(typecheckVariantPayloadTypeName(&defStore, &typeStore, &symbols, "AT").toStr(), "Point");
  Test::assertEq<str>(typecheckVariantPayloadTypeName(&defStore, &typeStore, &symbols, "EMPTY").toStr(), "<no-payload>");
}

/// A forward reference works because binding predeclares every type before the
/// resolver walks payload annotations.
/// Spec: IGN-127 — real variant payload types.
@test
function typecheckResolvesVariantPayloadDeclaredLater(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "enum Shape {\n  AT(Point),\n}\n\nrecord Point {\n  public x: u32;\n}\n\nfunction go(): void {\n  return;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
  Test::assertEq<str>(typecheckVariantPayloadTypeName(&defStore, &typeStore, &symbols, "AT").toStr(), "Point");
}

/// `Enum::Variant(args)` typechecks as a constructor: arity and argument types
