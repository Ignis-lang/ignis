    name: String::create("assignDefinition"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  assertSingleDiagnostic(&output, DiagnosticCode::INVALID_ASSIGNMENT_TARGET, "assignment target must resolve to a local binding");
}

