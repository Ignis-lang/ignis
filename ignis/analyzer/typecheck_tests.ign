  literalElements.push(typecheckAddBoolLiteral(&mut module, true));
  let vectorExpr: Ast::ExpressionId = typecheckAddVectorLiteralExpr(&mut module, literalElements);

  let vectorStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, vectorExpr);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(vectorStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useHeterogeneousVector"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::TYPE_MISMATCH);
}

function typecheckAddCastExpr(
  module: &mut Ast::Module,
  expression: Ast::ExpressionId,
  targetType: Ast::TypeId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Cast(Ast::Expression::Cast {
    span: typecheckDummySpan(),
    expression: expression,
    targetType: targetType,
  }));
}

function typecheckAddDereferenceExpr(
  module: &mut Ast::Module,
  operand: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Dereference(Ast::Expression::Dereference {
    span: typecheckDummySpan(),
    operand: operand,
  }));
}

function typecheckAddReferenceExpr(
  module: &mut Ast::Module,
  mutable: boolean,
  target: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Reference(Ast::Expression::Reference {
    span: typecheckDummySpan(),
    mutable: mutable,
    target: target,
  }));
}

function typecheckAddUnaryExpr(
  module: &mut Ast::Module,
  operator: Ast::Expression::UnaryOperator,
  operand: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Unary(Ast::Expression::Unary {
    span: typecheckDummySpan(),
    operator: operator,
    operand: operand,
  }));
}

function typecheckAddReferenceType(
  module: &mut Ast::Module,
  mutable: boolean,
  target: Ast::TypeId,
): Ast::TypeId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addType(Ast::Type::Node::Reference(Ast::Type::Reference {
    span: typecheckDummySpan(),
    mutable: mutable,
    target: target,
  }));
}

function typecheckAddFloatLiteral(module: &mut Ast::Module, value: f64): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: typecheckDummySpan(),
    value: Ast::Expression::LiteralValue::Float(value),
  }));
}

function typecheckAddSingleExprFunction(
  module: &mut Ast::Module,
  name: str,
  stmts: Vector<Ast::StatementId>,
): void {
  let mut bodyStmts: Vector<Ast::StatementId> = stmts;
  bodyStmts.push(typecheckAddReturn(module));
  let bodyBlock: Ast::StatementId = typecheckAddBlock(module, bodyStmts);

  let mut moduleRef: &mut Ast::Module = module;
  moduleRef.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create(name),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));
}

/// Scenario: `1 as i64` accepts the numeric-to-numeric cast and types the
/// expression as the cast target.
/// Spec: IGN-28 — typecheck cast, dereference, reference, and unary expressions.
@test
function typecheckCastI32AsI64HappyPath(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i64TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i64");
  let castExpr: Ast::ExpressionId = typecheckAddCastExpr(
    &mut module,
    typecheckAddIntLiteral(&mut module, 1),
    i64TypeId,
  );

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, castExpr));
  typecheckAddSingleExprFunction(&mut module, "castNumeric", bodyStmts);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, castExpr, typeStore.intern(Analyzer::Type::I64));
}

