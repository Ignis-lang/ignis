/// Scenario (ADR D10): calling a name that exists in `staticMethods` (but not
/// `instanceMethods`) through an instance receiver is rejected — static
/// methods are not callable through `.` on a value.
/// Spec: selfhost-method-call-resolution — Requirement: Instance method calls.
@test
function typecheckInstanceMethodCallStaticThroughInstanceProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
