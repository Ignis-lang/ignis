  let mut innerFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  innerFields.push(typecheckAddAnnotatedField(&mut module, "id", i32TypeId));
  let _innerItem: Ast::ItemId = typecheckAddRecordItemWithMetadata(&mut module, "Inner", innerFields, typecheckImplementsMetadata("Drop"));

  let innerTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "Inner");
  let mut outerFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  outerFields.push(typecheckAddAnnotatedField(&mut module, "inner", innerTypeId));
  let _outerItem: Ast::ItemId = typecheckAddRecordItem(&mut module, "Outer", Vector::new<Ast::GenericParam>(), outerFields);

  typecheckAddForOfOverRecordArray(&mut module, "Outer", false);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::FOR_OF_REQUIRES_COPY_OR_REF);
}

/// Scenario: an iterable record whose `length` field is typed through an
/// alias of `u64` still qualifies for the iterable-record protocol.
/// Spec: IGN-118 — copy-aware for-of.
@test
function typecheckForOfIterableRecordWithAliasedLengthBindsElement(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let u64TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "u64");
  let _aliasItem: Ast::ItemId = typecheckAddTypeAliasItem(&mut module, "Len", u64TypeId);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let dataTypeId: Ast::TypeId = typecheckAddPointerType(&mut module, i32TypeId, false);
  let lenTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "Len");
  let mut recordFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  recordFields.push(typecheckAddAnnotatedField(&mut module, "data", dataTypeId));
  recordFields.push(typecheckAddAnnotatedField(&mut module, "length", lenTypeId));
  let _recordItem: Ast::ItemId = typecheckAddRecordItem(&mut module, "Buffer", Vector::new<Ast::GenericParam>(), recordFields);

  let bufferTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "Buffer");
  let bufferPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "buffer", bufferTypeId);
  let bufferStmt: Ast::StatementId = typecheckAddUninitializedLetStmt(&mut module, bufferPattern, Option::SOME(bufferTypeId));

  let itemPattern: Ast::PatternId = typecheckAddBinding(&mut module, "item");
  let itemUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "item");
  let itemUseStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, itemUse);
  let mut loopBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  loopBodyStmts.push(itemUseStmt);
  let loopBody: Ast::StatementId = typecheckAddBlock(&mut module, loopBodyStmts);

  let iterableExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "buffer");
  let forOfStmt: Ast::StatementId = typecheckAddForOfStatement(&mut module, itemPattern, iterableExpr, loopBody);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(bufferStmt);
  bodyStmts.push(forOfStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let _funcItem: Ast::ItemId = typecheckAddFunctionItem(&mut module, "forOfAliasedLength", Option::NONE, bodyBlock);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, itemUse, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: `defer cleanup();` over a `void` call is accepted.
/// Spec: IGN-29 — defer statements.
@test
function typecheckDeferVoidCallIsAccepted(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let helperRet: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut helperBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  helperBodyStmts.push(helperRet);
  let helperBody: Ast::StatementId = typecheckAddBlock(&mut module, helperBodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("cleanup"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: helperBody,
    metadata: Ast::emptyMetadata(),
  }));

  let callee: Ast::ExpressionId = typecheckAddVariable(&mut module, "cleanup");
  let callExpr: Ast::ExpressionId = typecheckAddCall(&mut module, callee, Vector::new<Ast::ExpressionId>());
  let callStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, callExpr);
  let deferStmt: Ast::StatementId = typecheckAddDeferStatement(&mut module, callStmt);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(deferStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("deferVoid"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
}

