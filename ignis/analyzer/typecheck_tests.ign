/// Scenario (ADR D10): calling a name that exists in `staticMethods` (but not
/// `instanceMethods`) through an instance receiver is rejected — static
/// methods are not callable through `.` on a value.
/// Spec: selfhost-method-call-resolution — Requirement: Instance method calls.
@test
function typecheckInstanceMethodCallStaticThroughInstanceProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let createRetStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, typecheckAddIntLiteral(&mut module, 1));
  let mut createBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  createBodyStmts.push(createRetStmt);
  let createBody: Ast::StatementId = typecheckAddBlock(&mut module, createBodyStmts);
  let createMethodId: Ast::ItemId = typecheckAddMethodItem(&mut module, "create", Vector::new<Ast::PatternId>(), Option::SOME(i32Type), createBody);
  let mut methods: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
  methods.push(createMethodId);

  module.addRootItem(Ast::Item::Node::Record(Ast::Item::Record {
    span: typecheckDummySpan(),
    name: String::create("R"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    fields: Vector::new<Ast::PatternId>(),
    methods: methods,
    metadata: Ast::emptyMetadata(),
  }));

  let recordType: Ast::TypeId = typecheckAddPathType(&mut module, "R");
  let rPath: Ast::ExpressionId = typecheckAddVariable(&mut module, "R");
  let initExpr: Ast::ExpressionId = typecheckAddRecordInit(&mut module, rPath, Vector::new<Ast::TypeId>(), Vector::new<Ast::Expression::RecordInitField>());
  let valuePattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", recordType);
  let valueStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: valuePattern,
    annotation: Option::SOME(recordType),
    value: Option::SOME(initExpr),
  }));

  let valueExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "value");
  let methodAccessExpr: Ast::ExpressionId = typecheckAddMemberAccess(&mut module, valueExpr, "create");
  let callExpr: Ast::ExpressionId = typecheckAddCall(&mut module, methodAccessExpr, Vector::new<Ast::ExpressionId>());
  let callStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, callExpr);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);

  let mut mainBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  mainBodyStmts.push(valueStmt);
  mainBodyStmts.push(callStmt);
  mainBodyStmts.push(retStmt);
  let mainBody: Ast::StatementId = typecheckAddBlock(&mut module, mainBodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, mainBody);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, "static method `create` cannot be called through an instance");
}

/// Scenario (ADR D7, Local-only enforcement): calling a `&mut self` method
/// through an immutable local receiver is rejected.
/// Spec: selfhost-method-call-resolution — Requirement: Instance method calls.
@test
function typecheckInstanceMethodCallMutSelfOnImmutableLocalProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let selfPat: Ast::PatternId = typecheckAddSelfReceiverPattern(&mut module, true);
  let mutateBody: Ast::StatementId = typecheckAddBlock(&mut module, Vector::new<Ast::StatementId>());
  let mut mutateParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  mutateParams.push(selfPat);
  let mutateMethodId: Ast::ItemId = typecheckAddMethodItem(&mut module, "mutate", mutateParams, Option::NONE, mutateBody);
  let mut methods: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
  methods.push(mutateMethodId);

  module.addRootItem(Ast::Item::Node::Record(Ast::Item::Record {
    span: typecheckDummySpan(),
    name: String::create("R"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    fields: Vector::new<Ast::PatternId>(),
    methods: methods,
    metadata: Ast::emptyMetadata(),
  }));

  let recordType: Ast::TypeId = typecheckAddPathType(&mut module, "R");
  let rPath: Ast::ExpressionId = typecheckAddVariable(&mut module, "R");
  let initExpr: Ast::ExpressionId = typecheckAddRecordInit(&mut module, rPath, Vector::new<Ast::TypeId>(), Vector::new<Ast::Expression::RecordInitField>());
  let valuePattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", recordType);
  let valueStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: valuePattern,
    annotation: Option::SOME(recordType),
    value: Option::SOME(initExpr),
  }));

  let valueExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "value");
  let methodAccessExpr: Ast::ExpressionId = typecheckAddMemberAccess(&mut module, valueExpr, "mutate");
  let callExpr: Ast::ExpressionId = typecheckAddCall(&mut module, methodAccessExpr, Vector::new<Ast::ExpressionId>());
  let callStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, callExpr);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);

  let mut mainBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  mainBodyStmts.push(valueStmt);
  mainBodyStmts.push(callStmt);
  mainBodyStmts.push(retStmt);
  let mainBody: Ast::StatementId = typecheckAddBlock(&mut module, mainBodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, mainBody);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::MUTABILITY_VIOLATION, "cannot call mutable method on immutable receiver");
}

/// Triangulates the mut-self check: the same `&mut self` method call succeeds
/// with no diagnostic when the receiver local is declared mutable.
