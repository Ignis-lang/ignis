/// An argument that does not satisfy the declared payload type is rejected —
/// impossible to detect while every payload type was a `void` placeholder.
/// Spec: IGN-127 — variant construction.
@test
function typecheckVariantConstructionRejectsWrongArgumentType(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "enum Shape {\n  CIRCLE(u32),\n  EMPTY,\n}\n\nfunction make(flag: boolean): Shape {\n  return Shape::CIRCLE(flag);\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<str>(typecheckFirstDiagnosticCode(&output.diagnostics), DiagnosticCode::INVALID_ARGUMENT_TYPE);
}

/// A generic enum's payload is declared as its type parameter, and the return
/// type supplies what that parameter stands for, so the construction binds it
/// and the payload argument is checked against `u32` rather than against `T`.
/// The declared payload stays `T`: only the construction is specialized.
/// Spec: IGN-135 — generic enum variant construction.
@test
function typecheckGenericVariantConstructionBindsFromExpectedType(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "enum Box<T> {\n  SOME(T),\n}\n\nfunction make(): Box<u32> {\n  return Box::SOME(1);\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
  Test::assertEq<str>(typecheckVariantPayloadTypeName(&defStore, &typeStore, &symbols, "SOME").toStr(), "T");
}

/// The payload argument is checked against the *substituted* payload type, so a
/// value that does not fit what the expected type bound is reported. Without
/// substitution the comparison would be against the bare type parameter and this
/// would pass.
/// Spec: IGN-135 — generic enum variant construction.
@test
function typecheckGenericVariantConstructionRejectsMismatchedPayload(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "enum Box<T> {\n  SOME(T),\n}\n\nfunction make(): Box<u32> {\n  return Box::SOME(true);\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<str>(typecheckFirstDiagnosticCode(&output.diagnostics), DiagnosticCode::INVALID_ARGUMENT_TYPE);
}

/// With no expected type there is nothing to bind the enum's type parameter to,
/// so the payload type stays as declared and a concrete argument is reported
/// against it. This mirrors the reference, which infers variant type arguments
/// from the expected type and from nowhere else — notably not from the argument.
/// Spec: IGN-135 — generic enum variant construction.
@test
function typecheckGenericVariantConstructionWithoutExpectedKeepsDeclaredPayload(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "enum Box<T> {\n  SOME(T),\n}\n\nfunction make(): void {\n  Box::SOME(1);\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<str>(typecheckFirstDiagnosticCode(&output.diagnostics), DiagnosticCode::INVALID_ARGUMENT_TYPE);
}

/// Payload sub-patterns bind the declared payload type, read straight from the
/// definition now that the AST read-back bridge is gone.
/// Spec: IGN-127 — real variant payload types.
@test
function typecheckVariantPatternBindsDeclaredPayloadType(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "enum Shape {\n  CIRCLE(u32),\n  EMPTY,\n}\n\nfunction area(shape: Shape): u32 {\n  match (shape) {\n    Shape::CIRCLE(radius) -> {\n      return radius;\n    },\n    Shape::EMPTY -> {\n      return 0;\n    },\n  };\n\n  return 0;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
}

/// Expression id of the first literal in `module`, so a test can assert the
/// type an expected-type position gave it.
function typecheckFindFirstLiteralExpr(module: &Ast::Module): Option<Ast::ExpressionId> {
  let mut index: u64 = 0;

  while (index < module.expressions.length()) {
    let exprId: Ast::ExpressionId = Id::fromRaw<Ast::ExpressionTag>(index as u32);

    if (let Option::SOME(node) = module.expressions.get(exprId)) {
      if (let Ast::Expression::Node::Literal(_) = node) {
        return Option::SOME(exprId);
      }
    }

    index += 1;
  }

  return Option::NONE;
}

/// The enclosing return type is the expectation for a returned value, so an
/// unsuffixed literal adopts it instead of defaulting to `u32`.
/// Spec: IGN-132 — expected-type propagation.
@test
function typecheckReturnValueAdoptsTheFunctionReturnType(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function f(): i32 {\n  return 1;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);

  let Option::SOME(literalExpr) = typecheckFindFirstLiteralExpr(&parsed.module) else {
    @panic("typecheckReturnValueAdoptsTheFunctionReturnType: no literal parsed");
  };

  assertExprType(&output, literalExpr, typeStore.intern(Analyzer::Type::I32));
}

/// A returned literal that does not fit the return type is still an overflow,
/// so propagation does not weaken the range check.
/// Spec: IGN-132 — expected-type propagation.
@test
function typecheckReturnValueOverflowingTheReturnTypeIsRejected(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function f(): i8 {\n  return 256;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<str>(typecheckFirstDiagnosticCode(&output.diagnostics), DiagnosticCode::INTEGER_OVERFLOW);
}

