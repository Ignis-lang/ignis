@test
function typecheckUnannotatedConstantInfersDeclaredTypeFromValue(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let literalExpr: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 7);

  let constId: Ast::ItemId = module.addRootItem(Ast::Item::Node::Constant(Ast::Item::Constant {
    span: typecheckDummySpan(),
    name: String::create("INFERRED"),
    annotation: Option::NONE,
    value: literalExpr,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, literalExpr, typeStore.intern(Analyzer::Type::I32));

  let Option::SOME(constDefId) = Analyzer::Binder::findDef(&output.pass2, constId.raw()) else {
    @panic("typecheckUnannotatedConstantInfersDeclaredTypeFromValue: constant not found in pass-2 output");
  };

  let Option::SOME(constDef) = defStore.get(constDefId) else {
    @panic("typecheckUnannotatedConstantInfersDeclaredTypeFromValue: defStore.get NONE for constant");
  };

  match (constDef) {
    Analyzer::Definition::Variable(v) -> {
      Test::assertEq<u32>(v.declaredType.raw(), typeStore.intern(Analyzer::Type::I32).raw());
    },
    Analyzer::Definition::Record(_) -> @panic("expected Variable"),
    Analyzer::Definition::Enum(_) -> @panic("expected Variable"),
    Analyzer::Definition::Function(_) -> @panic("expected Variable"),
    Analyzer::Definition::Field(_) -> @panic("expected Variable"),
    Analyzer::Definition::Variant(_) -> @panic("expected Variable"),
    Analyzer::Definition::TypeParam(_) -> @panic("expected Variable"),
    Analyzer::Definition::TypeAlias(_) -> @panic("expected Variable"),
    Analyzer::Definition::Trait(_) -> @panic("expected Variable"),
    Analyzer::Definition::Method(_) -> @panic("expected Variable"),
  };
}

/// Scenario: `1 << 2` returned from an `i32` function typechecks as `i32`.
/// Spec: IGN-30 — shift/bitwise binary operators.
@test
function typecheckShiftLeftOnIntegersUsesOperandType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let leftExpr: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let rightExpr: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 2);
  let binaryExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::ShiftLeft,
    leftExpr,
    rightExpr,
  );
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, binaryExpr);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("unsupportedBinary"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(i32TypeId),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, binaryExpr, typeStore.intern(Analyzer::Type::I32));
}

