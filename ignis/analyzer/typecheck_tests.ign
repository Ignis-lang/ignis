// ===========================================================================
// IGN-133 — declaration-site alias cycles, assignment through references, and
// member access on a non-record
// ===========================================================================

/// How many diagnostics in `bag` carry `code`.
function typecheckCountDiagnosticCode(bag: &DiagnosticBag, code: str): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (String::create(diagnostic.code).equals(code)) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

/// A self-referential alias is reported where it is declared, with no use of
/// the alias anywhere. Before this the declaration was accepted in silence and
/// `A0060` only ever came from chasing an alias in a checked position.
/// Spec: IGN-133 — B11 alias cycles.
@test
function typecheckSelfReferentialAliasIsReportedAtItsDeclaration(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "type A = A;\n\nfunction main(): void {\n  return;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 1);
  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::CYCLIC_TYPE_ALIAS), 1);
}

/// A two-hop cycle reports exactly once, at the declaration the chase started
/// from, mirroring the Rust oracle: the second alias in the cycle is already
/// implicated and stays silent.
/// Spec: IGN-133 — B11 alias cycles.
@test
function typecheckTwoHopAliasCycleIsReportedOnce(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "type A = B;\ntype B = A;\n\nfunction main(): void {\n  return;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 1);
  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::CYCLIC_TYPE_ALIAS), 1);
}

/// An alias chain that ends in a concrete type is not a cycle, however many
/// hops it takes.
/// Spec: IGN-133 — B11 alias cycles.
@test
function typecheckAliasChainWithoutACycleStaysClean(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "type A = B;\ntype B = u32;\n\nfunction main(): u32 {\n  let value: A = 1;\n  return value;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
}

/// `x = v` on a `&mut T` parameter assigns through the reference: the target
/// type is the referent and the parameter's own mutability does not gate it.
/// Before this it reported `A0067`.
/// Spec: IGN-133 — B13 assignment through a reference.
@test
function typecheckAssignmentThroughMutableReferenceParameterIsAccepted(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function modify(x: &mut u32): void {\n  x = 42;\n  return;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
}

/// `*x = v` through a `&mut T` is accepted. Before this it reported `I0009`,
/// because an assignment target had to resolve to a plain local binding.
/// Spec: IGN-133 — B13 assignment through a reference.
@test
function typecheckDereferenceAssignmentThroughMutableReferenceIsAccepted(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function modify(x: &mut u32): void {\n  *x = 42;\n  return;\n}\n",
  );

