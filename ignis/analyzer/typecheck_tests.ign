/// Integer operands of different widths unify on the wider one, so the sum of
/// a `u8` and a `u32` is a `u32`.
/// Spec: IGN-132 — implicit widening.
@test
function typecheckBinaryOperandsOfDifferentWidthsUnifyOnTheWiderOne(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function f(a: u8, b: u32): u32 {\n  return a + b;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
}

/// Operands that cross the sign boundary share no common type, so they are
/// still a mismatch.
/// Spec: IGN-132 — implicit widening.
@test
function typecheckBinaryOperandsCrossingTheSignBoundaryAreRejected(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function f(a: u8, b: i32): i32 {\n  return a + b;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<str>(typecheckFirstDiagnosticCode(&output.diagnostics), DiagnosticCode::TYPE_MISMATCH);
}

/// A comparison of different widths is allowed on the same rule and still
/// yields `boolean`.
/// Spec: IGN-132 — implicit widening.
@test
function typecheckComparisonOfDifferentWidthsIsAccepted(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function f(a: u8, b: u32): boolean {\n  return a < b;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
}

/// Expression id of the first binary expression in `module`, so a test can
/// assert the type a unification gave it.
function typecheckFindFirstBinaryExpr(module: &Ast::Module): Option<Ast::ExpressionId> {
  let mut index: u64 = 0;

  while (index < module.expressions.length()) {
    let exprId: Ast::ExpressionId = Id::fromRaw<Ast::ExpressionTag>(index as u32);

    if (let Option::SOME(node) = module.expressions.get(exprId)) {
      if (let Ast::Expression::Node::Binary(_) = node) {
        return Option::SOME(exprId);
      }
    }

    index += 1;
  }

  return Option::NONE;
}

/// An equality between integers of different widths is accepted on the same
/// common-type rule as arithmetic and comparison, and yields `boolean`.
/// Spec: IGN-132 — implicit widening.
@test
function typecheckEqualityOfDifferentWidthsIsAccepted(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function f(a: u8, b: u32): boolean {\n  return a == b;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);

  let Option::SOME(binaryExpr) = typecheckFindFirstBinaryExpr(&parsed.module) else {
    @panic("typecheckEqualityOfDifferentWidthsIsAccepted: no binary expression parsed");
  };

  assertExprType(&output, binaryExpr, typeStore.intern(Analyzer::Type::BOOLEAN));
}

/// An equality crossing the sign boundary shares no common type and is still
