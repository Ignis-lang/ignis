// Phase 11: Enum-variant pattern binding (selfhost-match-exhaustiveness prerequisite, S2a)
// ============================================================

/// Scenario: a qualified enum-variant pattern (`E::A`) matching a
/// non-generic enum scrutinee binds successfully. Before this fix,
/// `collectPatternBindings` routed every `Path` pattern through
/// `collectRecordPathPatternBindings`, which rejected `Type::Enum` with
/// "record destructure annotation must be a non-generic record". Since S2b1,
/// enum-variant patterns give no exhaustiveness credit yet (variant crediting
/// is a later slice), so this single-arm, no-wildcard match also gets a
/// statement-position non-exhaustive WARNING alongside `checkMatchExpr`'s
/// still-standing `emitUnsupported("match expressions")` wall (S3 has not
/// landed).
/// Spec: selfhost-match-exhaustiveness — enum coverage prerequisite.
@test
function typecheckEnumVariantPatternBindsNonGenericEnumScrutinee(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "A"));
  variants.push(typecheckAddBinding(&mut module, "B"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("E"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let enumType: Ast::TypeId = typecheckAddPathType(&mut module, "E");
  let eParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "e", enumType);
  let eExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "e");

  let variantPattern: Ast::PatternId = typecheckAddPathPattern2(&mut module, "E", "A", Vector::new<Ast::PatternId>());
  let armBody: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: variantPattern,
    guard: Option::NONE,
    body: armBody,
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, eExpr, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(eParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useEnum"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Slice S2b2 credits the `E::A` arm's variant toward coverage, so only `B`
  // remains uncovered — the message now names it instead of the blanket
  // "requires a wildcard" wording from S2b1. Since S3 lifted the match wall,
  // this exhaustiveness WARNING is the only diagnostic.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
  let Option::SOME(exhaustivenessDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckEnumVariantPatternBindsNonGenericEnumScrutinee: missing exhaustiveness diagnostic");
  };
  Test::assertEq<Severity>(exhaustivenessDiagnostic.severity, Severity::WARNING);
  Test::assertEq<str>(exhaustivenessDiagnostic.code, DiagnosticCode::NON_EXHAUSTIVE_MATCH);
  Test::assertEq<str>(exhaustivenessDiagnostic.messageText(), "non-exhaustive match: enum scrutinee is missing variant `B`");
}

/// Scenario: a bare variant pattern (`E::B`, zero arguments) matching a
/// variant declared with one payload slot. The resolver's own arity check
/// (`resolvePatternPathVariantArity`, ADR-R5) only ever validates against a
/// hardcoded zero, so it accepts this pattern — the mismatch against the
/// variant's *declared* payload arity is caught by typecheck's own
/// `collectEnumVariantPatternBindings` arity check.
/// Spec: selfhost-match-exhaustiveness — enum coverage prerequisite.
@test
function typecheckEnumVariantPatternRejectsPayloadArityMismatch(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut declArgs: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  declArgs.push(typecheckAddWildcardPattern(&mut module));
  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddPathPattern(&mut module, "B", declArgs));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("E"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let enumType: Ast::TypeId = typecheckAddPathType(&mut module, "E");
  let eParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "e", enumType);
  let eExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "e");

  let variantPattern: Ast::PatternId = typecheckAddPathPattern2(&mut module, "E", "B", Vector::new<Ast::PatternId>());
  let armBody: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: variantPattern,
    guard: Option::NONE,
    body: armBody,
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, eExpr, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(eParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useEnum"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // `E` declares a single variant (`B`). Slice S2b2 credits `E::B` toward
  // coverage regardless of the (independently diagnosed) arity mismatch, so
  // the enum is fully covered and no exhaustiveness diagnostic is emitted.
  // Since S3 lifted the match wall, only the arity diagnostic remains.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
  let Option::SOME(arityDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckEnumVariantPatternRejectsPayloadArityMismatch: missing arity diagnostic");
  };
  Test::assertEq<str>(arityDiagnostic.code, DiagnosticCode::PATTERN_ARITY_MISMATCH);
  Test::assertEq<str>(arityDiagnostic.messageText(), "enum variant pattern arity does not match the variant's declared payload");
}

/// Scenario: a qualified variant pattern matching a *generic* enum scrutinee
/// (annotated with the bare generic enum name, so its declared type resolves
/// to the enum's own `typeId` with `typeParams.length() > 0`) is still
/// walled off — `requireNonGenericEnumDefId` rejects it exactly like
/// `requireNonGenericRecordDefId` rejects generic record destructuring.
/// Spec: selfhost-match-exhaustiveness — generic scrutineess stay out of scope.
@test
function typecheckEnumVariantPatternRejectsGenericEnumScrutinee(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "A"));
  let mut genericParameters: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  genericParameters.push(typecheckGenericParam("T"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("E"),
    genericParameters: genericParameters,
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let enumType: Ast::TypeId = typecheckAddPathType(&mut module, "E");
  let eParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "e", enumType);
  let eExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "e");

  let variantPattern: Ast::PatternId = typecheckAddPathPattern2(&mut module, "E", "A", Vector::new<Ast::PatternId>());
  let armBody: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: variantPattern,
    guard: Option::NONE,
    body: armBody,
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, eExpr, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(eParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useEnum"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Since S3 lifted the match wall, only the generic-enum bind diagnostic
  // and the exhaustiveness WARNING remain.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 2);
  let Option::SOME(genericDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckEnumVariantPatternRejectsGenericEnumScrutinee: missing generic-enum diagnostic");
  };
  Test::assertEq<str>(genericDiagnostic.code, DiagnosticCode::UNSUPPORTED_CONSTRUCT);
  Test::assertEq<str>(genericDiagnostic.messageText(), "typecheck does not support generic enum destructuring");

  let Option::SOME(exhaustivenessDiagnostic) = output.typecheck.diagnostics.get(1) else {
    @panic("typecheckEnumVariantPatternRejectsGenericEnumScrutinee: missing exhaustiveness diagnostic");
  };
  Test::assertEq<Severity>(exhaustivenessDiagnostic.severity, Severity::WARNING);
  Test::assertEq<str>(exhaustivenessDiagnostic.messageText(), "non-exhaustive match: generic enum scrutinee requires a wildcard/irrefutable-binding arm");
}

// Phase 12: bool/irrefutable exhaustiveness + `valuePosition` plumbing
// (selfhost-match-exhaustiveness, S2b1)
// ============================================================

/// Scenario: a `bool` scrutinee with only a `true` literal arm, no
/// wildcard, in statement position. `false` is uncovered, so
/// `analyzeMatchExhaustiveness` returns `Missing`; statement position means
/// the diagnostic is a WARNING (`valuePosition = false`), landing alongside
/// `checkMatchExpr`'s still-standing `emitUnsupported("match expressions")`
/// wall (S3 has not lifted it).
/// Spec: selfhost-match-exhaustiveness — closed-domain coverage, position-
/// sensitive severity.
@test
function typecheckMatchStatementBoolMissingFalseArmWarns(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let scrutinee: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);
  let truePattern: Ast::PatternId = typecheckAddLiteralPattern(&mut module, typecheckAddBoolLiteral(&mut module, true));
  let armBody: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: truePattern,
    guard: Option::NONE,
    body: armBody,
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Literal patterns are still walled by `collectPatternBindings`
  // ("literal patterns" unsupported) independently of exhaustiveness — that
  // wall fires during the arm-binding loop, before exhaustiveness runs.
  // Since S3 lifted the match wall, only these two diagnostics remain.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 2);
  let Option::SOME(bindDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckMatchStatementBoolMissingFalseArmWarns: missing pattern-bind diagnostic");
  };
  Test::assertEq<Severity>(bindDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(bindDiagnostic.code, DiagnosticCode::UNSUPPORTED_CONSTRUCT);
  Test::assertEq<str>(bindDiagnostic.messageText(), "typecheck does not support literal patterns");

  let Option::SOME(exhaustivenessDiagnostic) = output.typecheck.diagnostics.get(1) else {
    @panic("typecheckMatchStatementBoolMissingFalseArmWarns: missing exhaustiveness diagnostic");
  };
  Test::assertEq<Severity>(exhaustivenessDiagnostic.severity, Severity::WARNING);
  Test::assertEq<str>(exhaustivenessDiagnostic.code, DiagnosticCode::NON_EXHAUSTIVE_MATCH);
  Test::assertEq<str>(exhaustivenessDiagnostic.messageText(), "non-exhaustive match: bool scrutinee requires both `true` and `false` arms, or a wildcard/irrefutable-binding arm");
}

/// Scenario: a `bool` scrutinee with both `true` and `false` literal arms
/// covers the closed domain — `bool` is a 2-value domain, so no wildcard is
/// needed. No exhaustiveness diagnostic is emitted; only the pre-existing
/// `emitUnsupported("match expressions")` wall remains.
/// Spec: selfhost-match-exhaustiveness — closed-domain coverage.
@test
function typecheckMatchStatementBoolBothLiteralsCoveredEmitsNoExhaustivenessDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let scrutinee: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);
  let truePattern: Ast::PatternId = typecheckAddLiteralPattern(&mut module, typecheckAddBoolLiteral(&mut module, true));
  let falsePattern: Ast::PatternId = typecheckAddLiteralPattern(&mut module, typecheckAddBoolLiteral(&mut module, false));
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: truePattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: falsePattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Both arms are literal patterns, so each independently trips the
  // pre-existing "literal patterns" bind-time wall; exhaustiveness itself
  // stays silent (bool coverage is complete). Since S3 lifted the match
  // wall, only these two bind diagnostics remain.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 2);
  let Option::SOME(firstBindDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckMatchStatementBoolBothLiteralsCoveredEmitsNoExhaustivenessDiagnostic: missing first pattern-bind diagnostic");
  };
  Test::assertEq<Severity>(firstBindDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(firstBindDiagnostic.code, DiagnosticCode::UNSUPPORTED_CONSTRUCT);
  Test::assertEq<str>(firstBindDiagnostic.messageText(), "typecheck does not support literal patterns");

  let Option::SOME(secondBindDiagnostic) = output.typecheck.diagnostics.get(1) else {
    @panic("typecheckMatchStatementBoolBothLiteralsCoveredEmitsNoExhaustivenessDiagnostic: missing second pattern-bind diagnostic");
  };
  Test::assertEq<Severity>(secondBindDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(secondBindDiagnostic.code, DiagnosticCode::UNSUPPORTED_CONSTRUCT);
  Test::assertEq<str>(secondBindDiagnostic.messageText(), "typecheck does not support literal patterns");
}

/// Scenario: a wildcard arm satisfies coverage for an open-domain (`i32`)
/// scrutinee in EXPRESSION position (`let x: i32 = match (...) { ... };`).
/// `checkExprExpected`'s `Node::Match` arm always calls `checkMatchExpr` with
/// `valuePosition = true`. The match is exhaustive (no exhaustiveness
/// diagnostic), and since S3 lifted the match wall, the arm body's `i32`
/// type joins cleanly against the annotated `expected` — no diagnostics at
/// all, and the match expression itself types as `i32`.
/// Spec: selfhost-match-exhaustiveness — open-domain requires catch-all.
/// Spec: selfhost-typecheck — match-as-expression with expected type.
@test
function typecheckMatchExpressionWildcardCoversOpenDomain(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");
  let scrutinee: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 0);
  let wildcardPattern: Ast::PatternId = typecheckAddWildcardPattern(&mut module);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: wildcardPattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, matchExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: the same shape as above but with no wildcard and a single
/// literal arm — the `i32` scrutinee is an open domain, so a non-wildcard
/// literal arm never guarantees coverage. Because the match sits in
/// EXPRESSION position (`let` value), the non-exhaustive diagnostic is an
/// ERROR, not a WARNING.
/// Spec: selfhost-match-exhaustiveness — open-domain requires catch-all,
/// position-sensitive severity.
@test
function typecheckMatchExpressionNonExhaustiveIsError(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");
  let scrutinee: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 0);
  let zeroPattern: Ast::PatternId = typecheckAddLiteralPattern(&mut module, typecheckAddIntLiteral(&mut module, 0));
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: zeroPattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // The literal `0` pattern independently trips the pre-existing "literal
  // patterns" bind-time wall before exhaustiveness runs. Since S3 lifted the
  // match wall, only these two diagnostics remain — the sole arm's `i32`
  // body type still joins cleanly against `expected`.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 2);
  let Option::SOME(bindDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckMatchExpressionNonExhaustiveIsError: missing pattern-bind diagnostic");
  };
  Test::assertEq<Severity>(bindDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(bindDiagnostic.code, DiagnosticCode::UNSUPPORTED_CONSTRUCT);
  Test::assertEq<str>(bindDiagnostic.messageText(), "typecheck does not support literal patterns");

  let Option::SOME(exhaustivenessDiagnostic) = output.typecheck.diagnostics.get(1) else {
    @panic("typecheckMatchExpressionNonExhaustiveIsError: missing exhaustiveness diagnostic");
  };
  Test::assertEq<Severity>(exhaustivenessDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(exhaustivenessDiagnostic.code, DiagnosticCode::NON_EXHAUSTIVE_MATCH);
  Test::assertEq<str>(exhaustivenessDiagnostic.messageText(), "non-exhaustive match: scrutinee requires a wildcard/irrefutable-binding arm");
}

/// Scenario: a guarded wildcard arm is the match's only arm. A guard cannot
/// guarantee coverage regardless of the pattern shape, so
/// `analyzeMatchExhaustiveness` must skip guarded arms entirely — even a
/// wildcard pattern gives no credit when guarded. Statement position, so the
/// diagnostic is a WARNING.
/// Spec: selfhost-match-exhaustiveness — closed-domain coverage (guarded arms
/// excluded).
@test
function typecheckMatchStatementGuardedWildcardDoesNotCountAsCoverage(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let scrutinee: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 0);
  let wildcardPattern: Ast::PatternId = typecheckAddWildcardPattern(&mut module);
  let guardExpr: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: wildcardPattern,
    guard: Option::SOME(guardExpr),
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Since S3 lifted the match wall, the statement-position exhaustiveness
  // WARNING is the only diagnostic.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
  let Option::SOME(exhaustivenessDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckMatchStatementGuardedWildcardDoesNotCountAsCoverage: missing exhaustiveness diagnostic");
  };
  Test::assertEq<Severity>(exhaustivenessDiagnostic.severity, Severity::WARNING);
  Test::assertEq<str>(exhaustivenessDiagnostic.messageText(), "non-exhaustive match: scrutinee requires a wildcard/irrefutable-binding arm");
}

/// Scenario: a parenthesised match used as an expression statement —
/// `(match (n) { ... });` — arrives as `Node::Grouped` wrapping the match,
/// not `Node::Match` directly. `checkStmt`'s statement-position guard only
/// matches a *direct* `Node::Match`, so this takes the ordinary expression
/// path (`checkExpr`, `valuePosition = true`) and gets the stricter ERROR
/// severity even though it is syntactically a statement. This is the
/// documented conservative edge case (design D2).
/// Spec: selfhost-expected-type-propagation — position mechanism.
@test
function typecheckGroupedMatchStatementTakesExpressionPositionPath(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let scrutinee: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 0);
  let zeroPattern: Ast::PatternId = typecheckAddLiteralPattern(&mut module, typecheckAddIntLiteral(&mut module, 0));
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: zeroPattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);
  let groupedExpr: Ast::ExpressionId = typecheckAddGroupedExpr(&mut module, matchExpr);
  let groupedStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, groupedExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(groupedStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // The literal `0` pattern independently trips the pre-existing "literal
  // patterns" bind-time wall before exhaustiveness runs. Since S3 lifted the
  // match wall, only these two diagnostics remain — the sole arm's `i32`
  // body type joins cleanly (no annotated `expected` reaches the inner
  // match here, since the statement's own `checkExpr` call passes `NONE`).
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 2);
  let Option::SOME(bindDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckGroupedMatchStatementTakesExpressionPositionPath: missing pattern-bind diagnostic");
  };
  Test::assertEq<Severity>(bindDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(bindDiagnostic.code, DiagnosticCode::UNSUPPORTED_CONSTRUCT);
  Test::assertEq<str>(bindDiagnostic.messageText(), "typecheck does not support literal patterns");

  let Option::SOME(exhaustivenessDiagnostic) = output.typecheck.diagnostics.get(1) else {
    @panic("typecheckGroupedMatchStatementTakesExpressionPositionPath: missing exhaustiveness diagnostic");
  };
  Test::assertEq<Severity>(exhaustivenessDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(exhaustivenessDiagnostic.messageText(), "non-exhaustive match: scrutinee requires a wildcard/irrefutable-binding arm");
}

// Phase 13: enum variant coverage crediting (selfhost-match-exhaustiveness,
// S2b2), plus review findings R3-001 and R3-002.
// ============================================================

/// Scenario: every declared variant of a non-generic enum has its own
/// unguarded arm. `classifyMatchArmPattern` now credits each `Path` arm that
/// resolves to a `Definition::Variant` into `coveredVariants`, so the enum
/// is fully covered without a wildcard arm — no exhaustiveness diagnostic.
/// Spec: selfhost-match-exhaustiveness — closed-domain coverage.
@test
function typecheckMatchStatementEnumAllVariantsCoveredEmitsNoExhaustivenessDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  variants.push(typecheckAddBinding(&mut module, "Blue"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Blue", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 3),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Since S3 lifted the match wall, a fully-covered statement-position match
  // emits no diagnostics at all.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
}

/// Scenario: two arms match the same variant (`Red` twice), plus one arm for
/// the remaining variant (`Green`). Duplicate credit must not double-count
/// or otherwise break the coverage check — `matchCoverageHasVariant` dedups
/// by `raw()` id, and the enum is still fully covered.
/// Spec: selfhost-match-exhaustiveness — closed-domain coverage.
@test
function typecheckMatchStatementEnumDuplicateVariantArmFullCoverageIsExhaustive(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 3),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Since S3 lifted the match wall, a fully-covered statement-position match
  // emits no diagnostics at all.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
}

/// Scenario: the `Red` arm carries a guard, so it must not count toward
/// coverage regardless of matching a real variant — `analyzeMatchExhaustiveness`
/// skips guarded arms before classification ever runs. Only `Green` is
/// credited, so `Red` is reported missing by name.
/// Spec: selfhost-match-exhaustiveness — closed-domain coverage (guarded arms
/// excluded).
@test
function typecheckMatchStatementEnumGuardedVariantArmDoesNotCountAsCoverage(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");
  let guardExpr: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::SOME(guardExpr),
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // The guarded `Red` arm gives no coverage credit, so `Red` is reported
  // missing by name even though its pattern otherwise matches a real
  // variant. Since S3 lifted the match wall, this WARNING is the only
  // diagnostic.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
  let Option::SOME(exhaustivenessDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckMatchStatementEnumGuardedVariantArmDoesNotCountAsCoverage: missing exhaustiveness diagnostic");
  };
  Test::assertEq<Severity>(exhaustivenessDiagnostic.severity, Severity::WARNING);
  Test::assertEq<str>(exhaustivenessDiagnostic.code, DiagnosticCode::NON_EXHAUSTIVE_MATCH);
  Test::assertEq<str>(exhaustivenessDiagnostic.messageText(), "non-exhaustive match: enum scrutinee is missing variant `Red`");
}

/// Scenario: a match over a plain (non-generic) record scrutinee, with a
/// single record-destructure arm that is not irrefutable-by-pattern-shape in
/// this slice's coverage model (`Path` patterns only credit enum variants).
/// R3-002: rather than falsely reporting `Missing`, `Type::Record(_)`
/// scrutinees stay `Unknown` (silent) until record destructure crediting
/// lands (S3-adjacent follow-up) — no false-positive exhaustiveness
/// diagnostic on a match that is actually exhaustive-by-shape.
/// Spec: selfhost-match-exhaustiveness — review finding R3-002.
@test
function typecheckMatchStatementRecordScrutineeStaysSilentOnCoverage(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let mut fields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  fields.push(typecheckAddAnnotatedField(&mut module, "x", i32Type));
  typecheckAddRecordItem(&mut module, "Point", Vector::new<Ast::GenericParam>(), fields);

  let pointType: Ast::TypeId = typecheckAddPathType(&mut module, "Point");
  let pParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "p", pointType);
  let pExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "p");

  let mut destructureArgs: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  destructureArgs.push(typecheckAddBinding(&mut module, "a"));
  let destructurePattern: Ast::PatternId = typecheckAddPathPattern(&mut module, "Point", destructureArgs);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: destructurePattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, pExpr, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(pParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("usePoint"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Since S3 lifted the match wall, an exhaustive-by-shape statement-
  // position match over a record scrutinee emits no diagnostics at all.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
}

/// Scenario: a match over a generic record scrutinee instantiated with
/// concrete type arguments (`Box<i32>`), which resolves to `Type::Instance`.
/// R3-001: the `Type::Instance(_)` arm used to say "generic enum scrutinee"
/// unconditionally; it must look up the instance's generic definition and
/// use record-appropriate wording when that definition is a record.
/// Spec: selfhost-match-exhaustiveness — review finding R3-001.
@test
function typecheckMatchStatementGenericRecordInstanceScrutineeUsesRecordWordedMessage(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let tTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "T");
  let mut boxFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  boxFields.push(typecheckAddAnnotatedField(&mut module, "value", tTypeId));
  let mut genericParams: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  genericParams.push(typecheckGenericParam("T"));
  typecheckAddRecordItem(&mut module, "Box", genericParams, boxFields);

  let boxBaseType: Ast::TypeId = typecheckAddPathType(&mut module, "Box");
  let mut typeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  typeArguments.push(typecheckAddPathType(&mut module, "i32"));
  let boxInstanceType: Ast::TypeId = typecheckAddGenericType(&mut module, boxBaseType, typeArguments);

  let bParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "b", boxInstanceType);
  let bExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "b");

  let mut destructureArgs: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  destructureArgs.push(typecheckAddBinding(&mut module, "v"));
  let destructurePattern: Ast::PatternId = typecheckAddPathPattern(&mut module, "Box", destructureArgs);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: destructurePattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, bExpr, arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(bParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useBox"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // The destructure pattern independently trips the generic-record-
  // destructure bind-time wall before exhaustiveness runs. Since S3 lifted
  // the match wall, only these two diagnostics remain.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 2);
  let Option::SOME(bindDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckMatchStatementGenericRecordInstanceScrutineeUsesRecordWordedMessage: missing bind diagnostic");
  };
  Test::assertEq<Severity>(bindDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(bindDiagnostic.code, DiagnosticCode::UNSUPPORTED_CONSTRUCT);
  Test::assertEq<str>(bindDiagnostic.messageText(), "typecheck does not support generic record destructuring");

  let Option::SOME(exhaustivenessDiagnostic) = output.typecheck.diagnostics.get(1) else {
    @panic("typecheckMatchStatementGenericRecordInstanceScrutineeUsesRecordWordedMessage: missing exhaustiveness diagnostic");
  };
  Test::assertEq<Severity>(exhaustivenessDiagnostic.severity, Severity::WARNING);
  Test::assertEq<str>(exhaustivenessDiagnostic.code, DiagnosticCode::NON_EXHAUSTIVE_MATCH);
  Test::assertEq<str>(exhaustivenessDiagnostic.messageText(), "non-exhaustive match: generic record scrutinee requires a wildcard/irrefutable-binding arm");
}

// Phase 14: match-as-expression + `joinTypes` (selfhost-bidirectional-typecheck,
// S3)
// ============================================================

/// Scenario: an expression-position match with two arms that both produce
/// `i32` joins cleanly into a single result type, which is recorded as the
/// match expression's own type — the wall is gone and `checkMatchExpr` now
/// produces a value instead of always returning `Option::NONE`.
/// Spec: selfhost-typecheck — match-as-expression with expected type.
@test
function typecheckMatchExpressionJoinsCompatibleArmTypes(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");
  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, matchExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: an expression-position match with mismatched arm types (`i32`
/// vs `boolean`) produces exactly one `match-arm-type-mismatch` diagnostic.
/// The match is wrapped in `Grouped` inside a statement — per the documented
/// conservative edge case (design D2) this still takes the expression-
/// position path, but crucially with `expected = Option::NONE` (no
/// annotation reaches it), exercising the closed oracle-bug regression: arm
/// compatibility is checked regardless of whether `expected` is present.
/// Spec: selfhost-typecheck — arm/branch compatibility checked unconditionally.
@test
function typecheckMatchExpressionArmTypeMismatchProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddBoolLiteral(&mut module, true),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);
  let groupedExpr: Ast::ExpressionId = typecheckAddGroupedExpr(&mut module, matchExpr);
  let groupedStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, groupedExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(groupedStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
  let Option::SOME(mismatchDiagnostic) = output.typecheck.diagnostics.get(0) else {
    @panic("typecheckMatchExpressionArmTypeMismatchProducesDiagnostic: missing arm-mismatch diagnostic");
  };
  Test::assertEq<Severity>(mismatchDiagnostic.severity, Severity::ERROR);
  Test::assertEq<str>(mismatchDiagnostic.code, DiagnosticCode::ARM_OR_BRANCH_TYPE_MISMATCH);
  Test::assertEq<str>(mismatchDiagnostic.messageText(), "match arm type mismatch: expected `i32`, found `boolean`");
}

/// Scenario: one arm's body is an unresolved reference (already diagnosed at
/// its own call site, typed as `Option::NONE`); the other arm produces
/// `i32`. `joinTypes` excludes the `Option::NONE` arm from the pairwise
/// comparison entirely, so it does not poison the join — the match still
/// resolves to `i32` with no additional `match-arm-type-mismatch`.
/// Spec: selfhost-typecheck — arm/branch compatibility checked unconditionally
/// (divergence exclusion, design D2).
@test
function typecheckMatchExpressionErroredArmDoesNotPoisonJoin(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");
  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()),
    guard: Option::NONE,
    body: typecheckAddVariable(&mut module, "missing"),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Only the unresolved-reference diagnostic from the `Green` arm's own body
  // check remains — no `match-arm-type-mismatch` on top of it.
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
  assertExprType(&output, matchExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: an expression-position match whose single, exhaustive
/// (wildcard) arm produces `boolean`, but the enclosing `let` annotates
/// `i32`. `joinTypes` compares the joined result against `expected` exactly
/// once and reports the existing `type-mismatch` diagnostic — no separate
/// `match-arm-type-mismatch` wording, since only one arm contributed to the
/// join.
/// Spec: selfhost-typecheck — arm type mismatch against expected.
@test
function typecheckMatchExpressionJoinedTypeMismatchesExpected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");
  let scrutinee: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 0);
  let wildcardPattern: Ast::PatternId = typecheckAddWildcardPattern(&mut module);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: wildcardPattern,
    guard: Option::NONE,
    body: typecheckAddBoolLiteral(&mut module, true),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::TYPE_MISMATCH, "type mismatch: expected `i32`, found `boolean`");
}

/// Scenario: the same mismatched-arm-type match as
/// `typecheckMatchExpressionArmTypeMismatchProducesDiagnostic`, but used
/// directly as a statement (`Node::Match` reached straight from
/// `checkStmt`, not through `Grouped`). Statement position never imposes a
/// cross-arm join (design D2): the match is fully covered (no exhaustiveness
/// diagnostic) and the diverging arm types are never compared, so no
/// diagnostic is emitted at all.
/// Spec: selfhost-typecheck — statement-position match still checks arm
/// compatibility (per-arm only, no cross-arm constraint).
@test
function typecheckMatchStatementArmTypeDivergenceProducesNoDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
