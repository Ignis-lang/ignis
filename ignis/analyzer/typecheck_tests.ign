  let voidTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "void");

  let nPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "n", i32TypeId);
  let nValue: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 5);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, nPattern, i32TypeId, nValue);

  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "n");
  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, calleeExpr);
  let exprStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(exprStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, voidTypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::CALL_ON_NON_CALLABLE);
}

/// Scenario: parenthesising the callee does not change the verdict — `1 |> (f)` is the
/// same call as `1 |> f`.
/// Spec: IGN-26 — pipes without a placeholder.
@test
function typecheckPipeIntoParenthesisedCalleeIsTheSameCall(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");

  let letStmt: Ast::StatementId = typecheckAddFunctionValuedLocal(&mut module, i32TypeId);

  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "f");
  let groupedCallee: Ast::ExpressionId = typecheckAddGroupedExpr(&mut module, calleeExpr);
  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, groupedCallee);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, pipeExpr, typeStore.intern(Analyzer::Type::I32));
}

