  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 1);
  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::MUTABILITY_VIOLATION), 1);
}

/// A field assignment through a `&mut self` receiver is accepted: the field is
/// a place and the receiver makes it mutable.
/// Spec: IGN-133 — B13 assignment through a reference.
@test
function typecheckFieldAssignmentThroughMutableSelfIsAccepted(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "record Counter {\n  public value: u32;\n\n  public bump(&mut self): void {\n    self.value = 1;\n    return;\n  }\n}\n\nfunction main(): void {\n  return;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
}

/// A field assignment whose base is an immutable local is a mutability error.
