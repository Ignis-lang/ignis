/// Scenario: a `match` whose every arm diverges joins to `never`, and that joined type
/// still satisfies the expected type rather than reporting a mismatch against it.
/// Spec: IGN-26 — builtin calls.
@test
function typecheckAllDivergingMatchSatisfiesExpectedType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let u64TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "u64");

  let firstMessage: Ast::ExpressionId = module.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: typecheckDummySpan(),
    value: Ast::Expression::LiteralValue::String(String::create("a")),
  }));
  let mut firstArgs: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  firstArgs.push(firstMessage);
  let firstBody: Ast::ExpressionId = typecheckAddBuiltinCall(&mut module, "panic", Vector::new<Ast::TypeId>(), firstArgs);

  let secondBody: Ast::ExpressionId = typecheckAddBuiltinCall(
    &mut module,
    "unreachable",
    Vector::new<Ast::TypeId>(),
    Vector::new<Ast::ExpressionId>(),
  );

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddWildcardPattern(&mut module),
    guard: Option::NONE,
    body: firstBody,
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddWildcardPattern(&mut module),
    guard: Option::NONE,
    body: secondBody,
  });

  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddIntLiteral(&mut module, 1), arms);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, matchExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, u64TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
}

/// Add a `_` placeholder expression.
function typecheckAddPipePlaceholder(module: &mut Ast::Module): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;

  return moduleRef.addExpression(Ast::Expression::Node::PipePlaceholder(Ast::Expression::PipePlaceholder {
    span: typecheckDummySpan(),
  }));
}

/// Add `() -> <returnType> { <body> }`.
function typecheckAddNullaryLambda(
  module: &mut Ast::Module,
  returnType: Ast::TypeId,
  body: Ast::StatementId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;

  return moduleRef.addExpression(Ast::Expression::Node::Lambda(Ast::Expression::Lambda {
    span: typecheckDummySpan(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(returnType),
    body: body,
  }));
}

/// Add a block expression `{ <tail> }` with no statements.
function typecheckAddBlockExprWithTail(
  module: &mut Ast::Module,
  tail: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;

  return moduleRef.addExpression(Ast::Expression::Node::Block(Ast::Expression::Block {
    span: typecheckDummySpan(),
    statements: Vector::new<Ast::StatementId>(),
    tail: Option::SOME(tail),
  }));
}

/// Add `[<elements>]`.
function typecheckAddVectorLiteral(
  module: &mut Ast::Module,
  elements: Vector<Ast::ExpressionId>,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;

  return moduleRef.addExpression(Ast::Expression::Node::Vector(Ast::Expression::VectorLiteral {
    span: typecheckDummySpan(),
    elements: elements,
  }));
}

/// Add `left |> right`.
function typecheckAddPipe(
  module: &mut Ast::Module,
  left: Ast::ExpressionId,
  right: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;

  return moduleRef.addExpression(Ast::Expression::Node::Pipe(Ast::Expression::Pipe {
    span: typecheckDummySpan(),
    left: left,
    right: right,
  }));
}

/// Scenario: `1 |> f(_)` types the placeholder as the piped value and the pipe as the
/// call's return type.
/// Spec: IGN-26 — pipe expressions.
@test
function typecheckPipeWithPlaceholderArgumentHappyPath(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");

  let letStmt: Ast::StatementId = typecheckAddFunctionValuedLocal(&mut module, i32TypeId);

  let placeholderExpr: Ast::ExpressionId = typecheckAddPipePlaceholder(&mut module);
  let mut callArgs: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  callArgs.push(placeholderExpr);
  let callExpr: Ast::ExpressionId = typecheckAddLocalCall(&mut module, callArgs);

  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, callExpr);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, placeholderExpr, typeStore.intern(Analyzer::Type::I32));
  assertExprType(&output, pipeExpr, typeStore.intern(Analyzer::Type::I32));
}

