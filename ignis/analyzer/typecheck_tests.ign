  let Option::SOME(literalExpr) = typecheckFindFirstLiteralExpr(&parsed.module) else {
    @panic("typecheckComparisonRightOperandAdoptsTheLeftOperandType: no literal parsed");
  };

  assertExprType(&output, literalExpr, typeStore.intern(Analyzer::Type::I32));
}

/// A non-numeric operand still rejects: propagation only supplies a type to a
