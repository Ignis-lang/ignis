/// Build `@implements(<traitName>)` metadata.
function typecheckImplementsMetadata(traitName: str): Ast::Metadata {
  let mut arguments: Vector<String> = Vector::new<String>();
  arguments.push(String::create(traitName));

  let mut attributes: Vector<Ast::Attribute> = Vector::new<Ast::Attribute>();
  attributes.push(Ast::Attribute {
    span: typecheckDummySpan(),
    name: String::create("implements"),
    arguments: arguments,
  });

  return Ast::Metadata {
    attributes: attributes,
    modifiers: Vector::new<Ast::Modifier>(),
  };
}

