    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::FOR_OF_EXPECTS_VECTOR, "for-of expects vector type, got 'i32'");
}

/// Scenario: a `&i32` annotated binding over an `i32` fixed array is accepted
/// and the binding types as the reference, not the element.
/// Spec: IGN-29 — for-of statements.
@test
function typecheckForOfReferenceBindingTypesAsReference(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let arrayTypeId: Ast::TypeId = typecheckAddFixedArrayType(&mut module, i32TypeId, 2);
  let arrayPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "arr", arrayTypeId);
  let arrayStmt: Ast::StatementId = typecheckAddUninitializedLetStmt(&mut module, arrayPattern, Option::SOME(arrayTypeId));

  let referenceTypeId: Ast::TypeId = typecheckAddReferenceType(&mut module, false, i32TypeId);
  let itemPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "item", referenceTypeId);
  let itemUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "item");
  let itemUseStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, itemUse);
  let mut loopBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  loopBodyStmts.push(itemUseStmt);
  let loopBody: Ast::StatementId = typecheckAddBlock(&mut module, loopBodyStmts);

  let iterableExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "arr");
  let forOfStmt: Ast::StatementId = typecheckAddForOfStatement(&mut module, itemPattern, iterableExpr, loopBody);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(arrayStmt);
  bodyStmts.push(forOfStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("forOfReference"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  let elementTypeId: Analyzer::TypeId = typeStore.intern(Analyzer::Type::I32);
  let expectedTypeId: Analyzer::TypeId = typeStore.reference(elementTypeId);
  assertExprType(&output, itemUse, expectedTypeId);
}

/// Scenario: a `&mut i32` binding over an immutable iterable place is
/// rejected; the loop otherwise typechecks.
/// Spec: IGN-29 — for-of statements.
@test
function typecheckForOfMutRefOverImmutableIterableProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let arrayTypeId: Ast::TypeId = typecheckAddFixedArrayType(&mut module, i32TypeId, 2);
  let arrayPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "arr", arrayTypeId);
  let arrayStmt: Ast::StatementId = typecheckAddUninitializedLetStmt(&mut module, arrayPattern, Option::SOME(arrayTypeId));

  let mutReferenceTypeId: Ast::TypeId = typecheckAddReferenceType(&mut module, true, i32TypeId);
  let itemPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "item", mutReferenceTypeId);
  let loopBody: Ast::StatementId = typecheckAddBlock(&mut module, Vector::new<Ast::StatementId>());

  let iterableExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "arr");
  let forOfStmt: Ast::StatementId = typecheckAddForOfStatement(&mut module, itemPattern, iterableExpr, loopBody);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(arrayStmt);
  bodyStmts.push(forOfStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("forOfMutRef"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::FOR_OF_MUT_REQUIRES_MUTABLE_ITER, "cannot take mutable reference in for-of over immutable vector");
}

/// Wire `let arr: <recordName>[2]; for (item of arr) {}` into a function item
/// on the module. When `byReference` the binding is annotated as
/// `&<recordName>`, otherwise it is left unannotated.
function typecheckAddForOfOverRecordArray(
  module: &mut Ast::Module,
  recordName: str,
  byReference: boolean,
): void {
  let recordTypeId: Ast::TypeId = typecheckAddPathType(module, recordName);
  let arrayTypeId: Ast::TypeId = typecheckAddFixedArrayType(module, recordTypeId, 2);
  let arrayPattern: Ast::PatternId = typecheckAddAnnotatedBinding(module, "arr", arrayTypeId);
  let arrayStmt: Ast::StatementId = typecheckAddUninitializedLetStmt(module, arrayPattern, Option::SOME(arrayTypeId));

  let mut itemPattern: Ast::PatternId = typecheckAddBinding(module, "_item");
  if (byReference) {
    let bindingRecordTypeId: Ast::TypeId = typecheckAddPathType(module, recordName);
    let referenceTypeId: Ast::TypeId = typecheckAddReferenceType(module, false, bindingRecordTypeId);
    itemPattern = typecheckAddAnnotatedBinding(module, "_item", referenceTypeId);
  }

  let loopBody: Ast::StatementId = typecheckAddBlock(module, Vector::new<Ast::StatementId>());
  let iterableExpr: Ast::ExpressionId = typecheckAddVariable(module, "arr");
  let forOfStmt: Ast::StatementId = typecheckAddForOfStatement(module, itemPattern, iterableExpr, loopBody);
  let retStmt: Ast::StatementId = typecheckAddReturn(module);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(arrayStmt);
  bodyStmts.push(forOfStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(module, bodyStmts);

  let _funcItem: Ast::ItemId = typecheckAddFunctionItem(module, "forOfRecordArray", Option::NONE, bodyBlock);
}

/// Scenario: an unannotated binding over an array of a `@implements(Drop)`
/// record is rejected: the element is not Copy.
/// Spec: IGN-118 — copy-aware for-of.
@test
function typecheckForOfOverDropRecordArrayRequiresRef(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let mut fields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  fields.push(typecheckAddAnnotatedField(&mut module, "id", i32TypeId));
  let _recordItem: Ast::ItemId = typecheckAddRecordItemWithMetadata(&mut module, "Owned", fields, typecheckImplementsMetadata("Drop"));

  typecheckAddForOfOverRecordArray(&mut module, "Owned", false);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::FOR_OF_REQUIRES_COPY_OR_REF);
}

