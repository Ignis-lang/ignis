@test
function typecheckBinaryComparisonAndEqualityReturnBoolean(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let boolTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let equalityExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Equal,
    typecheckAddIntLiteral(&mut module, 1),
    typecheckAddIntLiteral(&mut module, 2),
  );
  let compareExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::LessThan,
    typecheckAddIntLiteral(&mut module, 3),
    typecheckAddIntLiteral(&mut module, 4),
  );
  let equalityStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, equalityExpr);
  let compareStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, compareExpr);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(equalityStmt);
  bodyStmts.push(compareStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("compareI32"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(boolTypeId),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, equalityExpr, typeStore.intern(Analyzer::Type::BOOLEAN));
  assertExprType(&output, compareExpr, typeStore.intern(Analyzer::Type::BOOLEAN));
}

@test
function typecheckMixedPrimitiveBinaryOperandsProduceDiagnostics(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let badArithmeticExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Add,
    typecheckAddIntLiteral(&mut module, 1),
    module.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
      span: typecheckDummySpan(),
      value: Ast::Expression::LiteralValue::UInt(2),
    })),
  );
  let badCompareExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::LessThan,
    typecheckAddIntLiteral(&mut module, 3),
    typecheckAddBoolLiteral(&mut module, false),
  );
  let arithmeticStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, badArithmeticExpr);
  let compareStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, badCompareExpr);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(arithmeticStmt);
  bodyStmts.push(compareStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("mixedPrimitiveBinary"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(i32TypeId),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  // Only the `3 < false` comparison is diagnosed. The `1 + 2` pair mixes a
  // signed and an unsigned literal, and the right operand is now checked
  // expecting the left one's type, so the unsuffixed literal adopts `i32`
  // exactly as the reference analyzer's binary arm does.
  Test::assertEq<u64>(output.diagnostics.length(), 1);
}

@test
function typecheckLogicalOperatorsRequireBooleanOperands(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let boolTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let boolExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::And,
    typecheckAddBoolLiteral(&mut module, true),
    typecheckAddBoolLiteral(&mut module, false),
  );
  let badExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Or,
    typecheckAddBoolLiteral(&mut module, true),
    typecheckAddIntLiteral(&mut module, 1),
  );
  let goodStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, boolExpr);
  let badStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, badExpr);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(goodStmt);
  bodyStmts.push(badStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("logicNeedsBool"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(boolTypeId),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  assertSingleDiagnosticCode(&output, DiagnosticCode::TYPE_MISMATCH);
  assertExprType(&output, boolExpr, typeStore.intern(Analyzer::Type::BOOLEAN));
}

@test
function typecheckIfAndWhileStatementsCheckBooleanConditionsAndBodies(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");

  let whilePattern: Ast::PatternId = typecheckAddBinding(&mut module, "loopValue");
  let whileInit: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let whileLet: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: whilePattern,
    annotation: Option::SOME(i32TypeId),
    value: Option::SOME(whileInit),
  }));
  let whileUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "loopValue");
  let whileUseStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, whileUse);
  let mut whileBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  whileBodyStmts.push(whileLet);
  whileBodyStmts.push(whileUseStmt);
  let whileBody: Ast::StatementId = typecheckAddBlock(&mut module, whileBodyStmts);
  let whileStmt: Ast::StatementId = typecheckAddWhileStatement(
    &mut module,
    typecheckAddBoolLiteral(&mut module, true),
    whileBody,
  );

  let ifPattern: Ast::PatternId = typecheckAddBinding(&mut module, "ifValue");
  let ifInit: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 2);
  let ifLet: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: ifPattern,
    annotation: Option::SOME(i32TypeId),
    value: Option::SOME(ifInit),
  }));
  let ifUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "ifValue");
  let ifUseStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, ifUse);
  let mut thenStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  thenStmts.push(ifLet);
  thenStmts.push(ifUseStmt);
  let thenBlock: Ast::StatementId = typecheckAddBlock(&mut module, thenStmts);
  let elseBlock: Ast::StatementId = typecheckAddBlock(&mut module, Vector::new<Ast::StatementId>());
  let ifStmt: Ast::StatementId = typecheckAddIfStatement(
    &mut module,
    typecheckAddBoolLiteral(&mut module, false),
    thenBlock,
    Option::SOME(elseBlock),
  );

  let badIfStmt: Ast::StatementId = typecheckAddIfStatement(
    &mut module,
    typecheckAddIntLiteral(&mut module, 0),
    typecheckAddBlock(&mut module, Vector::new<Ast::StatementId>()),
    Option::NONE,
  );
  let badWhileStmt: Ast::StatementId = typecheckAddWhileStatement(
    &mut module,
    typecheckAddIntLiteral(&mut module, 1),
    typecheckAddBlock(&mut module, Vector::new<Ast::StatementId>()),
  );

  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(whileStmt);
  bodyStmts.push(ifStmt);
  bodyStmts.push(badIfStmt);
  bodyStmts.push(badWhileStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("checkConditions"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &module,
  );

  Test::assertEq<u64>(output.diagnostics.length(), 2);
  assertExprType(&output, whileUse, typeStore.intern(Analyzer::Type::I32));
  assertExprType(&output, ifUse, typeStore.intern(Analyzer::Type::I32));
}

@test
function typecheckAliasCycleProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let aliasTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "A");
  let _aliasId: Ast::ItemId = typecheckAddTypeAliasItem(&mut module, "A", aliasTypeId);

  let valuePattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", aliasTypeId);
  let valueStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: valuePattern,
    annotation: Option::SOME(aliasTypeId),
    value: Option::SOME(typecheckAddIntLiteral(&mut module, 1)),
  }));
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(valueStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("cyclicAlias"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::CYCLIC_TYPE_ALIAS), 1);
}

@test
function typecheckMutualAliasCycleProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let aliasATypeId: Ast::TypeId = typecheckAddPathType(&mut module, "A");
  let aliasBTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "B");
  let _aliasAId: Ast::ItemId = typecheckAddTypeAliasItem(&mut module, "A", aliasBTypeId);
  let _aliasBId: Ast::ItemId = typecheckAddTypeAliasItem(&mut module, "B", aliasATypeId);

  let valuePattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", aliasATypeId);
  let valueStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: valuePattern,
    annotation: Option::SOME(aliasATypeId),
    value: Option::SOME(typecheckAddIntLiteral(&mut module, 1)),
  }));
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(valueStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("mutualAlias"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::CYCLIC_TYPE_ALIAS), 1);
}

@test
function typecheckAcyclicAliasChainStaysValid(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let aliasATypeId: Ast::TypeId = typecheckAddPathType(&mut module, "A");
  let aliasBTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "B");
  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let _aliasBId: Ast::ItemId = typecheckAddTypeAliasItem(&mut module, "B", i32TypeId);
  let _aliasAId: Ast::ItemId = typecheckAddTypeAliasItem(&mut module, "A", aliasBTypeId);

  let valuePattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", aliasATypeId);
  let valueStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: valuePattern,
    annotation: Option::SOME(aliasATypeId),
    value: Option::SOME(typecheckAddIntLiteral(&mut module, 1)),
  }));
  let valueExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "value");
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, valueExpr);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(valueStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("acyclicAlias"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(aliasATypeId),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
}

@test
function typecheckForStatementUsesLoopLocalAcrossSurface(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let indexPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "i", i32TypeId);
  let initStmt: Ast::StatementId = typecheckAddMutableVariableStmt(
    &mut module,
    indexPattern,
    i32TypeId,
    typecheckAddIntLiteral(&mut module, 0),
  );
  let conditionExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::LessThan,
    typecheckAddVariable(&mut module, "i"),
    typecheckAddIntLiteral(&mut module, 3),
  );
  let updateExpr: Ast::ExpressionId = typecheckAddAssignment(
    &mut module,
    Ast::Expression::AssignmentOperator::Assign,
    typecheckAddVariable(&mut module, "i"),
    typecheckAddBinary(
      &mut module,
      Ast::Expression::BinaryOperator::Add,
      typecheckAddVariable(&mut module, "i"),
      typecheckAddIntLiteral(&mut module, 1),
    ),
  );
  let bodyUseExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "i");
  let bodyUseStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, bodyUseExpr);
  let mut loopBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  loopBodyStmts.push(bodyUseStmt);
  let loopBody: Ast::StatementId = typecheckAddBlock(&mut module, loopBodyStmts);
  let forStmt: Ast::StatementId = typecheckAddForStatement(
    &mut module,
    Option::SOME(initStmt),
    Option::SOME(conditionExpr),
    Option::SOME(updateExpr),
    loopBody,
  );
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(forStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("forSurface"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, conditionExpr, typeStore.intern(Analyzer::Type::BOOLEAN));
  assertExprType(&output, updateExpr, typeStore.intern(Analyzer::Type::I32));
  assertExprType(&output, bodyUseExpr, typeStore.intern(Analyzer::Type::I32));
}

@test
function typecheckForLoopLocalDoesNotEscape(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let indexPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "i", i32TypeId);
  let initStmt: Ast::StatementId = typecheckAddMutableVariableStmt(
    &mut module,
    indexPattern,
    i32TypeId,
    typecheckAddIntLiteral(&mut module, 0),
  );
  let loopBody: Ast::StatementId = typecheckAddBlock(&mut module, Vector::new<Ast::StatementId>());
  let forStmt: Ast::StatementId = typecheckAddForStatement(
    &mut module,
    Option::SOME(initStmt),
    Option::SOME(typecheckAddBoolLiteral(&mut module, true)),
    Option::NONE,
    loopBody,
  );
  let escapedExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "i");
  let escapedStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, escapedExpr);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(forStmt);
  bodyStmts.push(escapedStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("forEscape"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::UNSUPPORTED_CONSTRUCT, "typecheck does not support unresolved expression reference");
}

@test
function typecheckLoopControlDiagnosticsRespectLoopDepth(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  // break/continue statements are terminators for the extra-checks phase, so
  // each one is guarded by an `if` to keep its successors reachable; the
  // typechecker still visits the branches with the same loop depth.
  let nestedBreak: Ast::StatementId = typecheckAddBreakStatement(&mut module, Option::NONE);
  let nestedBreakIf: Ast::StatementId = typecheckAddIfStatement(
    &mut module,
    typecheckAddBoolLiteral(&mut module, true),
    nestedBreak,
    Option::NONE,
  );
  let nestedContinue: Ast::StatementId = typecheckAddContinueStatement(&mut module);
  let mut whileBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  whileBodyStmts.push(nestedBreakIf);
  whileBodyStmts.push(nestedContinue);
  let whileBody: Ast::StatementId = typecheckAddBlock(&mut module, whileBodyStmts);
  let whileStmt: Ast::StatementId = typecheckAddWhileStatement(
    &mut module,
    typecheckAddBoolLiteral(&mut module, true),
    whileBody,
  );
  let outsideBreak: Ast::StatementId = typecheckAddBreakStatement(&mut module, Option::NONE);
  let outsideBreakIf: Ast::StatementId = typecheckAddIfStatement(
    &mut module,
    typecheckAddBoolLiteral(&mut module, true),
    outsideBreak,
    Option::NONE,
  );
  let outsideContinue: Ast::StatementId = typecheckAddContinueStatement(&mut module);
  let outsideContinueIf: Ast::StatementId = typecheckAddIfStatement(
    &mut module,
    typecheckAddBoolLiteral(&mut module, true),
    outsideContinue,
    Option::NONE,
  );
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(whileStmt);
  bodyStmts.push(outsideBreakIf);
  bodyStmts.push(outsideContinueIf);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("loopDepth"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 2);
  let Option::SOME(firstDiagnostic) = output.diagnostics.get(0) else {
    @panic("typecheckLoopControlDiagnosticsRespectLoopDepth: missing first diagnostic");
  };
  let Option::SOME(secondDiagnostic) = output.diagnostics.get(1) else {
    @panic("typecheckLoopControlDiagnosticsRespectLoopDepth: missing second diagnostic");
  };
  Test::assertEq<str>(firstDiagnostic.messageText(), "`break` used outside of loop");
  Test::assertEq<str>(secondDiagnostic.messageText(), "`continue` used outside of loop");
}

@test
function typecheckRejectsNonBooleanForConditionAndBreakValues(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let breakStmt: Ast::StatementId = typecheckAddBreakStatement(&mut module, Option::SOME(typecheckAddIntLiteral(&mut module, 1)));
  let mut loopBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  loopBodyStmts.push(breakStmt);
  let loopBody: Ast::StatementId = typecheckAddBlock(&mut module, loopBodyStmts);
  let forStmt: Ast::StatementId = typecheckAddForStatement(
    &mut module,
    Option::NONE,
    Option::SOME(typecheckAddIntLiteral(&mut module, 1)),
    Option::NONE,
    loopBody,
  );
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(forStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("badForCondition"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 2);
  let Option::SOME(secondDiagnostic) = output.diagnostics.get(1) else {
    @panic("typecheckRejectsNonBooleanForConditionAndBreakValues: missing second diagnostic");
  };
  Test::assertEq<str>(secondDiagnostic.messageText(), "typecheck does not support break values");
}

/// Scenario: `for (let item of arr)` over a fixed-array local with a Copy
/// element binds `item` by value inside the loop scope.
/// Spec: IGN-29 — for-of statements.
@test
function typecheckForOfOverFixedArrayBindsCopyElement(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let arrayTypeId: Ast::TypeId = typecheckAddFixedArrayType(&mut module, i32TypeId, 3);
  let arrayPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "arr", arrayTypeId);
  let arrayStmt: Ast::StatementId = typecheckAddUninitializedLetStmt(&mut module, arrayPattern, Option::SOME(arrayTypeId));

  let itemPattern: Ast::PatternId = typecheckAddBinding(&mut module, "item");
  let itemUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "item");
  let itemUseStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, itemUse);
  let mut loopBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  loopBodyStmts.push(itemUseStmt);
  let loopBody: Ast::StatementId = typecheckAddBlock(&mut module, loopBodyStmts);

  let iterableExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "arr");
  let forOfStmt: Ast::StatementId = typecheckAddForOfStatement(&mut module, itemPattern, iterableExpr, loopBody);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(arrayStmt);
  bodyStmts.push(forOfStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("forOfFixedArray"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, itemUse, typeStore.intern(Analyzer::Type::I32));
}

