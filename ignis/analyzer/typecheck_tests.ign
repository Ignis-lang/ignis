@test
function typecheckLetElseAnnotatedBindingChecksElseAndBindsPattern(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let pattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "x", i32Type);
  let elseReturn: Ast::StatementId = typecheckAddReturnExpr(&mut module, typecheckAddIntLiteral(&mut module, 0));
  let mut elseStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  elseStmts.push(elseReturn);
  let elseBlock: Ast::StatementId = typecheckAddBlock(&mut module, elseStmts);
  let letElseStmt: Ast::StatementId = typecheckAddLetElseStmt(
    &mut module,
    pattern,
    Option::SOME(i32Type),
    typecheckAddIntLiteral(&mut module, 1),
    elseBlock,
  );
  let xUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "x");
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, xUse);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letElseStmt);
  bodyStmts.push(retStmt);
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::SOME(i32Type), body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, xUse, typeStore.intern(Analyzer::Type::I32));
}

