/// Scenario: piping into a mutating method whose receiver is an immutable binding is
/// rejected — a pipe is a call, and it does not grant mutability the receiver lacks.
/// Spec: IGN-116 — pipes into a method.
@test
function typecheckPipeIntoMutatingMethodOnImmutableReceiverIsRejected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  // record R { m(&mut self, v: i32): i32 { return v; } }
  let i32MethodType: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let methodValue: Ast::ExpressionId = typecheckAddVariable(&mut module, "v");
  let methodRet: Ast::StatementId = typecheckAddReturnExpr(&mut module, methodValue);
  let mut methodStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  methodStmts.push(methodRet);
  let methodBody: Ast::StatementId = typecheckAddBlock(&mut module, methodStmts);

  let mut methodParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  methodParams.push(typecheckAddSelfReceiverPattern(&mut module, true));
  methodParams.push(typecheckAddAnnotatedBinding(&mut module, "v", typecheckAddPathType(&mut module, "i32")));

  let methodId: Ast::ItemId = module.addItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("m"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: methodParams,
    returnType: Option::SOME(i32MethodType),
    body: methodBody,
    metadata: Ast::emptyMetadata(),
  }));

  let mut methods: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
  methods.push(methodId);

  module.addRootItem(Ast::Item::Node::Record(Ast::Item::Record {
    span: typecheckDummySpan(),
    name: String::create("R"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    fields: Vector::new<Ast::PatternId>(),
    methods: methods,
    metadata: Ast::emptyMetadata(),
  }));

  // function useImmutableReceiver(r: R): i32 { return 1 |> r.m; }
  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let recordType: Ast::TypeId = typecheckAddPathType(&mut module, "R");
  let rParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "r", recordType);

  let receiverExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "r");
  let memberExpr: Ast::ExpressionId = typecheckAddMemberAccess(&mut module, receiverExpr, "m");
  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, memberExpr);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(rParam);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useImmutableReceiver"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::SOME(i32TypeId),
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertContainsDiagnosticCode(&output, DiagnosticCode::MUTABILITY_VIOLATION);
}

/// Scenario: `1 |> R::m` naming an instance method is rejected, and the rejection comes
/// from name resolution rather than typecheck: `resolvePathTail` reports that the method
/// requires a receiver and resolves the path to `Unresolved`, so the pipe's callee path
/// never sees an instance method at all. This pins that the case stays covered as the
/// pipe walls come down — a guard in typecheck would be unreachable code.
/// Spec: IGN-116 — pipes into a method.
@test
function typecheckPipeIntoInstanceMethodByPathIsRejected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  typecheckAddRecordWithI32Method(&mut module, "R", "m", false);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");

  let calleePath: Ast::ExpressionId = typecheckAddPathExpr2(&mut module, "R", "m");
  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, calleePath);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertContainsDiagnosticCodeInBag(&output.diagnostics, DiagnosticCode::METHOD_CALL_KIND_MISMATCH);
  assertLacksDiagnosticCode(&output, DiagnosticCode::UNSUPPORTED_CONSTRUCT);
}

/// Scenario: `1 |> r.m` where `m` takes two explicit parameters reports the count once
/// and the pipe still carries the method's return type, so the `return` that consumes it
/// type-checks and adds no second diagnostic. Bailing out instead would strip the type
/// and hide every later mistake in the same expression behind one recompile.
/// Spec: IGN-116 — pipes into a method.
@test
function typecheckPipeIntoMethodWithWrongArityKeepsReturnType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  // record R { m(self, a: i32, b: i32): i32 { return a; } }
  let methodReturnType: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let methodValue: Ast::ExpressionId = typecheckAddVariable(&mut module, "a");
  let methodRet: Ast::StatementId = typecheckAddReturnExpr(&mut module, methodValue);
  let mut methodStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  methodStmts.push(methodRet);
  let methodBody: Ast::StatementId = typecheckAddBlock(&mut module, methodStmts);

  let mut methodParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  methodParams.push(typecheckAddSelfReceiverPattern(&mut module, false));
  methodParams.push(typecheckAddAnnotatedBinding(&mut module, "a", typecheckAddPathType(&mut module, "i32")));
  methodParams.push(typecheckAddAnnotatedBinding(&mut module, "b", typecheckAddPathType(&mut module, "i32")));

  let methodId: Ast::ItemId = module.addItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("m"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: methodParams,
    returnType: Option::SOME(methodReturnType),
    body: methodBody,
    metadata: Ast::emptyMetadata(),
  }));

  let mut methods: Vector<Ast::ItemId> = Vector::new<Ast::ItemId>();
  methods.push(methodId);

  module.addRootItem(Ast::Item::Node::Record(Ast::Item::Record {
    span: typecheckDummySpan(),
    name: String::create("R"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    fields: Vector::new<Ast::PatternId>(),
    methods: methods,
    metadata: Ast::emptyMetadata(),
  }));

  // function useWrongArity(r: R): i32 { return 1 |> r.m; }
  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let recordType: Ast::TypeId = typecheckAddPathType(&mut module, "R");
  let rParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "r", recordType);

  let receiverExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "r");
  let memberExpr: Ast::ExpressionId = typecheckAddMemberAccess(&mut module, receiverExpr, "m");
  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, memberExpr);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(rParam);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useWrongArity"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::SOME(i32TypeId),
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // The count is the only complaint: the pipe kept the method's `i32`, so the enclosing
  // `return` never reports a mismatch against the function's own `i32`.
  assertSingleDiagnosticCode(&output, DiagnosticCode::INVALID_NUMBER_OF_ARGUMENTS);
  assertExprType(&output, pipeExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: `1 |> identity` where `identity<T>(value: T): T` infers `T = i32` from the
/// piped value, so the pipe types as i32 rather than as the unresolved parameter.
/// Spec: IGN-116 — generic inference for a piped callee.
@test
function typecheckPipeIntoGenericFunctionInfersTypeArgument(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  // function identity<T>(value: T): T { return value; }
  let tType: Ast::TypeId = typecheckAddPathType(&mut module, "T");
  let valueParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", tType);
  let valueExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "value");
  let identityRet: Ast::StatementId = typecheckAddReturnExpr(&mut module, valueExpr);
  let mut identityStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  identityStmts.push(identityRet);
  let identityBody: Ast::StatementId = typecheckAddBlock(&mut module, identityStmts);

  let mut identityParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  identityParams.push(valueParam);

  let mut genericParams: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  genericParams.push(Ast::GenericParam {
    span: typecheckDummySpan(),
    name: String::create("T"),
    bounds: Vector::new<Ast::GenericBound>(),
  });

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("identity"),
    genericParameters: genericParams,
    parameters: identityParams,
    returnType: Option::SOME(typecheckAddPathType(&mut module, "T")),
    body: identityBody,
    metadata: Ast::emptyMetadata(),
  }));

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");

  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "identity");
  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, calleeExpr);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, pipeExpr, typeStore.intern(Analyzer::Type::I32));
}

function typecheckAddTupleExpr(
  module: &mut Ast::Module,
  elements: Vector<Ast::ExpressionId>,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Tuple(Ast::Expression::Tuple {
    span: typecheckDummySpan(),
    elements: elements,
  }));
}

function typecheckAddUnitExpr(module: &mut Ast::Module): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Unit(Ast::Expression::Unit {
    span: typecheckDummySpan(),
  }));
}

function typecheckAddVectorLiteralExpr(
  module: &mut Ast::Module,
  elements: Vector<Ast::ExpressionId>,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Vector(Ast::Expression::VectorLiteral {
    span: typecheckDummySpan(),
    elements: elements,
  }));
}

function typecheckAddVectorAccessExpr(
  module: &mut Ast::Module,
  vector: Ast::ExpressionId,
  index: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::VectorAccess(Ast::Expression::VectorAccess {
    span: typecheckDummySpan(),
    vector: vector,
    index: index,
  }));
}

function typecheckAddTupleType(
  module: &mut Ast::Module,
  elements: Vector<Ast::TypeId>,
): Ast::TypeId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addType(Ast::Type::Node::Tuple(Ast::Type::Tuple {
    span: typecheckDummySpan(),
    elements: elements,
  }));
}

function typecheckAddSliceType(module: &mut Ast::Module, element: Ast::TypeId): Ast::TypeId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addType(Ast::Type::Node::Slice(Ast::Type::Slice {
    span: typecheckDummySpan(),
    element: element,
  }));
}

function typecheckAddFixedArrayType(
  module: &mut Ast::Module,
  element: Ast::TypeId,
  size: u64,
): Ast::TypeId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addType(Ast::Type::Node::FixedArray(Ast::Type::FixedArray {
    span: typecheckDummySpan(),
    element: element,
    size: size,
  }));
}

/// Scenario: `let t: (i32, boolean) = (1, true);` types the tuple expression as
/// `(i32, boolean)` and accepts the tuple annotation without diagnostics.
/// Spec: IGN-27 — typecheck tuples, unit, and vector literals/indexing.
@test
function typecheckTupleExpressionWithTupleAnnotationHappyPath(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let booleanTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let mut annotationElements: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  annotationElements.push(i32TypeId);
  annotationElements.push(booleanTypeId);
  let tupleAnnotation: Ast::TypeId = typecheckAddTupleType(&mut module, annotationElements);

  let mut tupleElements: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  tupleElements.push(typecheckAddIntLiteral(&mut module, 1));
  tupleElements.push(typecheckAddBoolLiteral(&mut module, true));
  let tupleExpr: Ast::ExpressionId = typecheckAddTupleExpr(&mut module, tupleElements);

  let tPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "_t", tupleAnnotation);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, tPattern, tupleAnnotation, tupleExpr);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useTuple"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);

  let mut expectedElements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  expectedElements.push(typeStore.intern(Analyzer::Type::I32));
  expectedElements.push(typeStore.intern(Analyzer::Type::BOOLEAN));
  assertExprType(&output, tupleExpr, typeStore.tuple(expectedElements));
}

