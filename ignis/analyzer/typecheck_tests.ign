/// `.field` on a primitive is a member-access error, not the generic type
/// mismatch it used to fall into.
/// Spec: IGN-133 — B12 member access on a non-record.
@test
function typecheckMemberAccessOnPrimitiveReportsTheMemberCode(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "function main(): u32 {\n  let x: u32 = 42;\n  return x.field;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::MEMBER_ACCESS_ON_NON_RECORD), 1);
  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::TYPE_MISMATCH), 0);
}

/// A record receiver with a field that does not exist keeps reporting the
/// unknown-member code: the non-record classification does not swallow it.
/// Spec: IGN-133 — B12 member access on a non-record.
@test
function typecheckMemberAccessOnRecordWithUnknownFieldStillReportsUnknownMember(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "record Point {\n  public x: u32;\n}\n\nfunction main(): u32 {\n  let point: Point = Point { x: 1 };\n  return point.y;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::UNKNOWN_MEMBER), 1);
  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::MEMBER_ACCESS_ON_NON_RECORD), 0);
}

/// A cyclic alias that is also used in a checked position reports exactly one
/// `CYCLIC_TYPE_ALIAS` across the whole run: the resolver owns the report at
/// the declaration and use-site chasing stays silent, matching the reference
/// analyzer's single diagnostic on the same source.
/// Spec: IGN-133 — B11 alias cycles.
@test
function typecheckUsedCyclicAliasIsReportedExactlyOnce(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "type A = A;\n\nfunction main(): void {\n  let x: A = 1;\n  return;\n}\n",
  );

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountDiagnosticCode(&output.diagnostics, DiagnosticCode::CYCLIC_TYPE_ALIAS), 1);
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
}

// IGN-136: literal, tuple, and or patterns
// ============================================================

/// Scenario: `match (0) { 0 -> 1, _ -> 2 }` in statement position. A literal
/// pattern binds nothing and its value is an `i32` like the scrutinee, so the
/// arm is accepted and nothing is reported.
/// Spec: IGN-136 — typecheck literal patterns.
@test
function typecheckLiteralPatternMatchingTheScrutineeTypeIsAccepted(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let scrutinee: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 0);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddLiteralPattern(&mut module, typecheckAddIntLiteral(&mut module, 0)),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddWildcardPattern(&mut module),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
}

/// Scenario: a `str` literal pattern against a `boolean` scrutinee. The
/// literal's type cannot be the scrutinee's, which is a type error rather than
/// a silently accepted arm.
/// Spec: IGN-136 — typecheck literal patterns.
@test
function typecheckLiteralPatternOfTheWrongTypeIsRejected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let scrutinee: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddLiteralPattern(&mut module, typecheckAddStringLiteral(&mut module, "nope")),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddWildcardPattern(&mut module),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, scrutinee, arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::TYPE_MISMATCH, "type mismatch: expected `boolean`, found `str`");
}

/// Scenario: a `u8` scrutinee with an integer literal pattern. The literal
/// adopts the scrutinee's integer type exactly as it would in expression
/// position, so `1` is a `u8` here and not the default `i32`.
/// Spec: IGN-136 — typecheck literal patterns.
@test
function typecheckLiteralPatternAdoptsTheIntegerScrutineeType(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let u8Type: Ast::TypeId = typecheckAddPathType(&mut module, "u8");
  let nPattern: Ast::PatternId = typecheckAddBinding(&mut module, "n");
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, nPattern, u8Type, typecheckAddIntLiteral(&mut module, 1));

  let patternLiteral: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddLiteralPattern(&mut module, patternLiteral),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddWildcardPattern(&mut module),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddVariable(&mut module, "n"), arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, patternLiteral, typeStore.intern(Analyzer::Type::U8));
}

/// Scenario: a `u8` scrutinee with a literal pattern the type cannot hold.
/// Adopting the scrutinee type also means inheriting its range check, so the
/// out-of-range literal is reported as an overflow rather than a mismatch.
/// Spec: IGN-136 — typecheck literal patterns.
@test
function typecheckLiteralPatternOverflowingTheScrutineeTypeIsRejected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let u8Type: Ast::TypeId = typecheckAddPathType(&mut module, "u8");
  let nPattern: Ast::PatternId = typecheckAddBinding(&mut module, "n");
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, nPattern, u8Type, typecheckAddIntLiteral(&mut module, 1));

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddLiteralPattern(&mut module, typecheckAddIntLiteral(&mut module, 300)),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddWildcardPattern(&mut module),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddVariable(&mut module, "n"), arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::INTEGER_OVERFLOW, "Integer literal overflows type 'u8'");
}

/// Scenario: `let (_a, b): (i32, boolean) = (1, true); b;` binds each element
/// sub-pattern to the tuple element type in the same position — `b` is a
/// `boolean`, not the tuple type.
/// Spec: IGN-136 — typecheck tuple patterns.
@test
function typecheckTuplePatternBindsElementTypesByPosition(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let booleanType: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let mut annotationElements: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  annotationElements.push(i32Type);
  annotationElements.push(booleanType);
  let tupleAnnotation: Ast::TypeId = typecheckAddTupleType(&mut module, annotationElements);

  let mut valueElements: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  valueElements.push(typecheckAddIntLiteral(&mut module, 1));
  valueElements.push(typecheckAddBoolLiteral(&mut module, true));
  let tupleValue: Ast::ExpressionId = typecheckAddTupleExpr(&mut module, valueElements);

  let mut elements: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  elements.push(typecheckAddBinding(&mut module, "_a"));
  elements.push(typecheckAddBinding(&mut module, "b"));
  let tuplePattern: Ast::PatternId = typecheckAddTuplePattern(&mut module, elements);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, tuplePattern, tupleAnnotation, tupleValue);

  let bExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "b");
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddExprStmt(&mut module, bExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, bExpr, typeStore.intern(Analyzer::Type::BOOLEAN));
}

/// Scenario: a one-element tuple pattern against a two-element tuple type.
/// Arity is part of the tuple's shape, so the pattern cannot describe the
/// scrutinee at all.
/// Spec: IGN-136 — typecheck tuple patterns.
@test
function typecheckTuplePatternArityMismatchIsRejected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let booleanType: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let mut annotationElements: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  annotationElements.push(i32Type);
  annotationElements.push(booleanType);
  let tupleAnnotation: Ast::TypeId = typecheckAddTupleType(&mut module, annotationElements);

  let mut valueElements: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  valueElements.push(typecheckAddIntLiteral(&mut module, 1));
  valueElements.push(typecheckAddBoolLiteral(&mut module, true));
  let tupleValue: Ast::ExpressionId = typecheckAddTupleExpr(&mut module, valueElements);

  let mut elements: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  elements.push(typecheckAddBinding(&mut module, "_a"));
  let tuplePattern: Ast::PatternId = typecheckAddTuplePattern(&mut module, elements);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, tuplePattern, tupleAnnotation, tupleValue);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(
    &output,
    DiagnosticCode::TYPE_MISMATCH,
    "pattern type mismatch: expected `(i32, boolean)`, got `tuple with 1 elements`",
  );
}

/// Scenario: a tuple element sub-pattern whose own type disagrees with the
/// element type it is bound against — a `boolean` literal in the `i32` slot.
/// Sub-patterns recurse with the element type, so the inner mismatch is
/// reported rather than swallowed by the outer shape check.
/// Spec: IGN-136 — typecheck tuple patterns.
@test
function typecheckTuplePatternElementTypeMismatchIsRejected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let booleanType: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let mut annotationElements: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  annotationElements.push(i32Type);
  annotationElements.push(booleanType);
  let tupleAnnotation: Ast::TypeId = typecheckAddTupleType(&mut module, annotationElements);

  let mut valueElements: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  valueElements.push(typecheckAddIntLiteral(&mut module, 1));
  valueElements.push(typecheckAddBoolLiteral(&mut module, true));
  let tupleValue: Ast::ExpressionId = typecheckAddTupleExpr(&mut module, valueElements);

  let mut elements: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  elements.push(typecheckAddLiteralPattern(&mut module, typecheckAddBoolLiteral(&mut module, true)));
  elements.push(typecheckAddBinding(&mut module, "_b"));
  let tuplePattern: Ast::PatternId = typecheckAddTuplePattern(&mut module, elements);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, tuplePattern, tupleAnnotation, tupleValue);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::TYPE_MISMATCH, "type mismatch: expected `i32`, found `boolean`");
}

/// Scenario: `match (b) { true | false -> 1 }`. Both alternatives are
/// binding-free literals of the scrutinee's type, and together they cover the
/// closed `boolean` domain, so the arm is accepted and the match is
/// exhaustive.
/// Spec: IGN-136 — typecheck or patterns.
@test
function typecheckOrPatternWithBindingFreeAlternativesIsAccepted(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut alternatives: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  alternatives.push(typecheckAddLiteralPattern(&mut module, typecheckAddBoolLiteral(&mut module, true)));
  alternatives.push(typecheckAddLiteralPattern(&mut module, typecheckAddBoolLiteral(&mut module, false)));
  let orPattern: Ast::PatternId = typecheckAddOrPattern(&mut module, alternatives);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: orPattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddBoolLiteral(&mut module, true), arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
}

/// Scenario: `match (c) { Color::Red | Color::Green -> 1 }` over a two-variant
/// enum. Each alternative credits its own variant toward coverage, so the
/// single or-pattern arm covers the enum and no exhaustiveness diagnostic is
/// emitted.
/// Spec: IGN-136 — typecheck or patterns, exhaustiveness crediting.
@test
function typecheckOrPatternCreditsEveryAlternativeVariantTowardCoverage(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(&mut module, "Red"));
  variants.push(typecheckAddBinding(&mut module, "Green"));
  module.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Color"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));

  let colorType: Ast::TypeId = typecheckAddPathType(&mut module, "Color");
  let cParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "c", colorType);
  let cExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "c");

  let mut alternatives: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  alternatives.push(typecheckAddPathPattern2(&mut module, "Color", "Red", Vector::new<Ast::PatternId>()));
  alternatives.push(typecheckAddPathPattern2(&mut module, "Color", "Green", Vector::new<Ast::PatternId>()));
  let orPattern: Ast::PatternId = typecheckAddOrPattern(&mut module, alternatives);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: orPattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, cExpr, arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(cParam);
  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useColor"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
}

/// Scenario: an or-pattern whose alternatives include a binding. Matching a
/// binding through an or-pattern needs the resolver to merge the binding sets
/// of every alternative, which it does not do yet (IGN-15), so only
/// binding-free alternatives are accepted.
/// Spec: IGN-136 — typecheck or patterns.
@test
function typecheckOrPatternWithABindingAlternativeIsRejected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut alternatives: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  alternatives.push(typecheckAddLiteralPattern(&mut module, typecheckAddIntLiteral(&mut module, 0)));
  alternatives.push(typecheckAddBinding(&mut module, "_x"));
  let orPattern: Ast::PatternId = typecheckAddOrPattern(&mut module, alternatives);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: orPattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddWildcardPattern(&mut module),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddIntLiteral(&mut module, 0), arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(
    &output,
    DiagnosticCode::OR_PATTERN_BINDINGS_DISALLOWED,
    "bindings are not allowed in OR patterns",
  );
}

/// Scenario: an or-pattern alternative whose type disagrees with the
/// scrutinee. Every alternative is checked against the same scrutinee type, so
/// the `i32` literal alternative is reported against the `boolean` scrutinee.
/// Spec: IGN-136 — typecheck or patterns.
@test
function typecheckOrPatternAlternativeOfTheWrongTypeIsRejected(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut alternatives: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  alternatives.push(typecheckAddLiteralPattern(&mut module, typecheckAddBoolLiteral(&mut module, true)));
  alternatives.push(typecheckAddLiteralPattern(&mut module, typecheckAddStringLiteral(&mut module, "nope")));
  let orPattern: Ast::PatternId = typecheckAddOrPattern(&mut module, alternatives);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: orPattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  arms.push(Ast::Expression::MatchArm {
    pattern: typecheckAddWildcardPattern(&mut module),
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 2),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddBoolLiteral(&mut module, true), arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::TYPE_MISMATCH, "type mismatch: expected `boolean`, found `str`");
}

/// Scenario: `match (n) { _ | _ -> 1 }` over an open `i32` domain. An
/// or-pattern is irrefutable only when every alternative is a wildcard, which
/// this one is, so the match is exhaustive without a separate catch-all arm.
/// Spec: IGN-136 — typecheck or patterns, exhaustiveness crediting.
@test
function typecheckOrPatternOfOnlyWildcardsIsIrrefutable(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let mut alternatives: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  alternatives.push(typecheckAddWildcardPattern(&mut module));
  alternatives.push(typecheckAddWildcardPattern(&mut module));
  let orPattern: Ast::PatternId = typecheckAddOrPattern(&mut module, alternatives);

  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: orPattern,
    guard: Option::NONE,
    body: typecheckAddIntLiteral(&mut module, 1),
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddIntLiteral(&mut module, 0), arms);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, matchExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
}

function typecheckAddCallWithTypeArguments(
  module: &mut Ast::Module,
  callee: Ast::ExpressionId,
  typeArguments: Vector<Ast::TypeId>,
  args: Vector<Ast::ExpressionId>,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Call(Ast::Expression::Call {
    span: typecheckDummySpan(),
    callee: callee,
    typeArguments: typeArguments,
    arguments: args,
  }));
}

/// Scenario: `identity<i32>(1)` on `function identity<T>(value: T): T` binds `T`
/// to the written type argument, so the call types as `i32` and the argument is
/// checked against the substituted parameter.
/// Spec: IGN-135 — explicit call type arguments.
@test
function typecheckExplicitCallTypeArgumentSpecializesSignature(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let tTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "T");
  let valueParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", tTypeId);
  let mut identityParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  identityParams.push(valueParam);

  let valueUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "value");
  let identityReturn: Ast::StatementId = typecheckAddReturnExpr(&mut module, valueUse);
  let mut identityBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  identityBodyStmts.push(identityReturn);
  let identityBody: Ast::StatementId = typecheckAddBlock(&mut module, identityBodyStmts);

  let mut identityGenerics: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  identityGenerics.push(typecheckGenericParam("T"));

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("identity"),
    genericParameters: identityGenerics,
    parameters: identityParams,
    returnType: Option::SOME(tTypeId),
    body: identityBody,
    metadata: Ast::emptyMetadata(),
  }));

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "identity");
  let argumentExpr: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);

  let mut callTypeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  callTypeArguments.push(i32TypeId);
  let mut callArguments: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  callArguments.push(argumentExpr);

  let callExpr: Ast::ExpressionId = typecheckAddCallWithTypeArguments(
    &mut module,
    calleeExpr,
    callTypeArguments,
    callArguments,
  );
  let callStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, callExpr);
  let mainReturn: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut mainBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  mainBodyStmts.push(callStmt);
  mainBodyStmts.push(mainReturn);
  let mainBody: Ast::StatementId = typecheckAddBlock(&mut module, mainBodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: mainBody,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, callExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: two type arguments written for a callee that declares one is
/// reported once, and the arguments are left unchecked so a single mistake does
/// not also produce a mismatch per argument.
/// Spec: IGN-135 — explicit call type arguments.
@test
function typecheckExplicitCallTypeArgumentCountMismatchIsReported(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let tTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "T");
  let valueParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", tTypeId);
  let mut identityParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  identityParams.push(valueParam);

  let valueUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "value");
  let identityReturn: Ast::StatementId = typecheckAddReturnExpr(&mut module, valueUse);
  let mut identityBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  identityBodyStmts.push(identityReturn);
  let identityBody: Ast::StatementId = typecheckAddBlock(&mut module, identityBodyStmts);

  let mut identityGenerics: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  identityGenerics.push(typecheckGenericParam("T"));

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("identity"),
    genericParameters: identityGenerics,
    parameters: identityParams,
    returnType: Option::SOME(tTypeId),
    body: identityBody,
    metadata: Ast::emptyMetadata(),
  }));

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let booleanTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "identity");
  let argumentExpr: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);

  let mut callTypeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  callTypeArguments.push(i32TypeId);
  callTypeArguments.push(booleanTypeId);
  let mut callArguments: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  callArguments.push(argumentExpr);

  let callExpr: Ast::ExpressionId = typecheckAddCallWithTypeArguments(
    &mut module,
    calleeExpr,
    callTypeArguments,
    callArguments,
  );
  let callStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, callExpr);
  let mainReturn: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut mainBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  mainBodyStmts.push(callStmt);
  mainBodyStmts.push(mainReturn);
  let mainBody: Ast::StatementId = typecheckAddBlock(&mut module, mainBodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: mainBody,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertContainsDiagnosticCode(&output, DiagnosticCode::TYPE_ARGUMENT_COUNT_MISMATCH);
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
}

/// Scenario: type arguments written for a callee that declares none have nothing
/// to bind, and the reference analyzer ignores them rather than reporting, so the
/// call still checks as an ordinary one.
/// Spec: IGN-135 — explicit call type arguments.
@test
function typecheckExplicitCallTypeArgumentOnNonGenericCalleeIsIgnored(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let plainLiteral: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 7);
  let plainReturn: Ast::StatementId = typecheckAddReturnExpr(&mut module, plainLiteral);
  let mut plainBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  plainBodyStmts.push(plainReturn);
  let plainBody: Ast::StatementId = typecheckAddBlock(&mut module, plainBodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("plain"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(i32TypeId),
    body: plainBody,
    metadata: Ast::emptyMetadata(),
  }));

  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "plain");

  let mut callTypeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  callTypeArguments.push(i32TypeId);

  let callExpr: Ast::ExpressionId = typecheckAddCallWithTypeArguments(
    &mut module,
    calleeExpr,
    callTypeArguments,
    Vector::new<Ast::ExpressionId>(),
  );
  let callStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, callExpr);
  let mainReturn: Ast::StatementId = typecheckAddReturn(&mut module);
  let mut mainBodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  mainBodyStmts.push(callStmt);
  mainBodyStmts.push(mainReturn);
  let mainBody: Ast::StatementId = typecheckAddBlock(&mut module, mainBodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: mainBody,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, callExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: two type arguments written for a record that declares one is
/// reported, and the written arguments are dropped so no instance is built with
/// the wrong number of them.
/// Spec: IGN-135 — explicit record initializer type arguments.
@test
function typecheckWrittenRecordInitTypeArgumentCountMismatchIsReported(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let tTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "T");
  let mut boxFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  boxFields.push(typecheckAddAnnotatedField(&mut module, "value", tTypeId));
  let mut boxGenerics: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  boxGenerics.push(typecheckGenericParam("T"));
  typecheckAddRecordItem(&mut module, "Box", boxGenerics, boxFields);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let booleanTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "boolean");
  let boxPath: Ast::ExpressionId = typecheckAddVariable(&mut module, "Box");
  let fieldValue: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let mut initFields: Vector<Ast::Expression::RecordInitField> = Vector::new<Ast::Expression::RecordInitField>();
  initFields.push(typecheckRecordInitField("value", fieldValue));

  let mut initTypeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  initTypeArguments.push(i32TypeId);
  initTypeArguments.push(booleanTypeId);
  let initExpr: Ast::ExpressionId = typecheckAddRecordInit(&mut module, boxPath, initTypeArguments, initFields);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, initExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertContainsDiagnosticCode(&output, DiagnosticCode::TYPE_ARGUMENT_COUNT_MISMATCH);
}

/// Scenario: a type argument written on a record that declares none has nothing
/// to bind, so it is ignored and the initializer keeps the plain record type
/// rather than becoming an instance of a record with no parameters to fill.
/// Spec: IGN-135 — explicit record initializer type arguments.
@test
function typecheckWrittenRecordInitTypeArgumentOnNonGenericRecordIsIgnored(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let mut pointFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  pointFields.push(typecheckAddAnnotatedField(&mut module, "x", i32TypeId));
  typecheckAddRecordItem(&mut module, "Point", Vector::new<Ast::GenericParam>(), pointFields);

  let pointPath: Ast::ExpressionId = typecheckAddVariable(&mut module, "Point");
  let fieldValue: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let mut initFields: Vector<Ast::Expression::RecordInitField> = Vector::new<Ast::Expression::RecordInitField>();
  initFields.push(typecheckRecordInitField("x", fieldValue));

  let mut initTypeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  initTypeArguments.push(i32TypeId);
  let initExpr: Ast::ExpressionId = typecheckAddRecordInit(&mut module, pointPath, initTypeArguments, initFields);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(typecheckAddExprStmt(&mut module, initExpr));
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, fieldValue, typeStore.intern(Analyzer::Type::I32));
}

/// Build `function identity<T>(value: T): T { return value; }` as a root item.
function typecheckAddIdentityFunction(module: &mut Ast::Module): void {
  let tType: Ast::TypeId = typecheckAddPathType(module, "T");
  let valueParam: Ast::PatternId = typecheckAddAnnotatedBinding(module, "value", tType);
  let valueExpr: Ast::ExpressionId = typecheckAddVariable(module, "value");
  let identityRet: Ast::StatementId = typecheckAddReturnExpr(module, valueExpr);

  let mut identityStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  identityStmts.push(identityRet);
  let identityBody: Ast::StatementId = typecheckAddBlock(module, identityStmts);

  let mut identityParams: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  identityParams.push(valueParam);

  let mut genericParams: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  genericParams.push(typecheckGenericParam("T"));

  let returnType: Ast::TypeId = typecheckAddPathType(module, "T");
  let mut moduleRef: &mut Ast::Module = module;

  moduleRef.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("identity"),
    genericParameters: genericParams,
    parameters: identityParams,
    returnType: Option::SOME(returnType),
    body: identityBody,
    metadata: Ast::emptyMetadata(),
  }));
}

/// Scenario: `1 |> identity<i32>()` binds `T` from the written type argument, so
/// the pipe types as `i32` and the piped value is checked against the
/// substituted parameter.
/// Spec: IGN-135 — explicit type arguments on a piped call.
@test
function typecheckPipeExplicitTypeArgumentSpecializesSignature(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  typecheckAddIdentityFunction(&mut module);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "identity");

  let mut callTypeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  callTypeArguments.push(i32TypeId);

  let callExpr: Ast::ExpressionId = typecheckAddCallWithTypeArguments(
    &mut module,
    calleeExpr,
    callTypeArguments,
    Vector::new<Ast::ExpressionId>(),
  );

  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, callExpr);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, pipeExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: `1 |> identity<str>()` writes a type argument the piped value does
/// not satisfy. The written argument wins over what the value would have
/// inferred, so the mismatch is reported instead of silently rebinding `T`.
/// Spec: IGN-135 — explicit type arguments on a piped call.
@test
function typecheckPipeExplicitTypeArgumentOverridesInference(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  typecheckAddIdentityFunction(&mut module);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let strTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "str");
  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "identity");

  let mut callTypeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  callTypeArguments.push(strTypeId);

  let callExpr: Ast::ExpressionId = typecheckAddCallWithTypeArguments(
    &mut module,
    calleeExpr,
    callTypeArguments,
    Vector::new<Ast::ExpressionId>(),
  );

  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, callExpr);
  let pipeStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, pipeExpr);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, typecheckAddIntLiteral(&mut module, 0));

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(pipeStmt);
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::INVALID_ARGUMENT_TYPE);
  assertExprType(&output, pipeExpr, typeStore.intern(Analyzer::Type::STR));
}

/// Scenario: two type arguments written for a piped callee that declares one is
/// reported once, and the piped value is left unchecked so a single mistake does
/// not also produce an argument mismatch. The pipe keeps the declared return
/// type, matching the direct call path.
/// Spec: IGN-135 — explicit type arguments on a piped call.
@test
function typecheckPipeExplicitTypeArgumentCountMismatchIsReported(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  typecheckAddIdentityFunction(&mut module);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let strTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "str");
  let calleeExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "identity");

  let mut callTypeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  callTypeArguments.push(i32TypeId);
  callTypeArguments.push(strTypeId);

  let callExpr: Ast::ExpressionId = typecheckAddCallWithTypeArguments(
    &mut module,
    calleeExpr,
    callTypeArguments,
    Vector::new<Ast::ExpressionId>(),
  );

  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, callExpr);
  let pipeStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, pipeExpr);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, typecheckAddIntLiteral(&mut module, 0));

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(pipeStmt);
  bodyStmts.push(retStmt);
  typecheckAddMainFunction(&mut module, bodyStmts, i32TypeId);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::TYPE_ARGUMENT_COUNT_MISMATCH);
}

/// Build `enum Maybe<T> { NOTHING }` as a root item.
function typecheckAddGenericMaybeEnum(module: &mut Ast::Module): void {
  let mut variants: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  variants.push(typecheckAddBinding(module, "NOTHING"));

  let mut genericParameters: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  genericParameters.push(typecheckGenericParam("T"));

  let mut moduleRef: &mut Ast::Module = module;

  moduleRef.addRootItem(Ast::Item::Node::Enum(Ast::Item::Enum {
    span: typecheckDummySpan(),
    name: String::create("Maybe"),
    genericParameters: genericParameters,
    variants: variants,
    methods: Vector::new<Ast::ItemId>(),
    metadata: Ast::emptyMetadata(),
  }));
}

/// Scenario: `function make(): Maybe<i32> { return Maybe::NOTHING; }` on a
/// generic enum takes its type arguments from the expected return type, so the
/// payload-less variant types as `Maybe<i32>` rather than as the bare enum.
/// Spec: IGN-135 — generic enum variants in expression position.
@test
function typecheckGenericVariantInExpressionPositionUsesExpectedTypeArguments(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  typecheckAddGenericMaybeEnum(&mut module);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let maybeBase: Ast::TypeId = typecheckAddPathType(&mut module, "Maybe");
  let mut maybeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  maybeArguments.push(i32TypeId);
  let maybeOfI32: Ast::TypeId = typecheckAddGenericType(&mut module, maybeBase, maybeArguments);

  let variantExpr: Ast::ExpressionId = typecheckAddPathExpr2(&mut module, "Maybe", "NOTHING");
  let returnStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, variantExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(returnStmt);
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("make"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(maybeOfI32),
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);

  let Option::SOME(variantType) = findExprType(&output, variantExpr) else {
    @panic("typecheckGenericVariantInExpressionPositionUsesExpectedTypeArguments: variant has no type");
  };
  let Option::SOME(variantTypeNode) = typeStore.get(variantType) else {
    @panic("typecheckGenericVariantInExpressionPositionUsesExpectedTypeArguments: variant type not interned");
  };
  let Analyzer::Type::Instance(instance) = variantTypeNode else {
    @panic("typecheckGenericVariantInExpressionPositionUsesExpectedTypeArguments: variant type is not an instance");
  };

  Test::assertEq<u64>(instance.typeArguments.length(), 1);

  let Option::SOME(firstArgument) = instance.typeArguments.get(0) else {
    @panic("typecheckGenericVariantInExpressionPositionUsesExpectedTypeArguments: instance has no type argument");
  };

  Test::assertEq<u32>(firstArgument.raw(), typeStore.intern(Analyzer::Type::I32).raw());
}

/// Scenario: the same variant written with nothing to infer from keeps the
/// enum's own declared type and reports nothing, which is what applying a
/// generic variant constructor without an expected type already does.
/// Spec: IGN-135 — generic enum variants in expression position.
@test
function typecheckGenericVariantInExpressionPositionWithoutExpectedTypeIsAccepted(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  typecheckAddGenericMaybeEnum(&mut module);

  let variantExpr: Ast::ExpressionId = typecheckAddPathExpr2(&mut module, "Maybe", "NOTHING");
  let variantStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, variantExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(variantStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  let Option::SOME(_) = findExprType(&output, variantExpr) else {
    @panic("typecheckGenericVariantInExpressionPositionWithoutExpectedTypeIsAccepted: variant has no type");
  };
}

/// Scenario: `let value: Maybe<i32> = Maybe::NOTHING;` resolves the generic
/// annotation to the enum instance, so the binding is typed and the variant
/// takes its type argument from it.
/// Spec: IGN-142 — generic type annotations on locals.
@test
function typecheckGenericEnumAnnotationOnLocalResolves(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  typecheckAddGenericMaybeEnum(&mut module);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let maybeBase: Ast::TypeId = typecheckAddPathType(&mut module, "Maybe");
  let mut maybeArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  maybeArguments.push(i32TypeId);
  let maybeOfI32: Ast::TypeId = typecheckAddGenericType(&mut module, maybeBase, maybeArguments);

  let valuePattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "value", maybeOfI32);
  let variantExpr: Ast::ExpressionId = typecheckAddPathExpr2(&mut module, "Maybe", "NOTHING");

  let letStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: valuePattern,
    annotation: Option::SOME(maybeOfI32),
    value: Option::SOME(variantExpr),
  }));

  let valueUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "value");
  let valueStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, valueUse);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(valueStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);

  let Option::SOME(bindingType) = findExprType(&output, valueUse) else {
    @panic("typecheckGenericEnumAnnotationOnLocalResolves: binding has no type");
  };
  let Option::SOME(variantType) = findExprType(&output, variantExpr) else {
    @panic("typecheckGenericEnumAnnotationOnLocalResolves: variant has no type");
  };

  Test::assertEq<u32>(bindingType.raw(), variantType.raw());

  let Option::SOME(bindingTypeNode) = typeStore.get(bindingType) else {
    @panic("typecheckGenericEnumAnnotationOnLocalResolves: binding type not interned");
  };
  let Analyzer::Type::Instance(instance) = bindingTypeNode else {
    @panic("typecheckGenericEnumAnnotationOnLocalResolves: binding type is not an instance");
  };

  Test::assertEq<u64>(instance.typeArguments.length(), 1);

  let Option::SOME(firstArgument) = instance.typeArguments.get(0) else {
    @panic("typecheckGenericEnumAnnotationOnLocalResolves: instance has no type argument");
  };

  Test::assertEq<u32>(firstArgument.raw(), typeStore.intern(Analyzer::Type::I32).raw());
}

/// Scenario: the same annotation over a generic record, initialized with a
/// record literal, agrees with the initializer's own inferred instance.
/// Spec: IGN-142 — generic type annotations on locals.
@test
function typecheckGenericRecordAnnotationOnLocalResolves(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let tTypeId: Ast::TypeId = typecheckAddPathType(&mut module, "T");
  let mut boxFields: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  boxFields.push(typecheckAddAnnotatedField(&mut module, "value", tTypeId));

  let mut boxGenerics: Vector<Ast::GenericParam> = Vector::new<Ast::GenericParam>();
  boxGenerics.push(typecheckGenericParam("T"));
  typecheckAddRecordItem(&mut module, "Box", boxGenerics, boxFields);

  let i32TypeId: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let boxBase: Ast::TypeId = typecheckAddPathType(&mut module, "Box");
  let mut boxArguments: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();
  boxArguments.push(i32TypeId);
  let boxOfI32: Ast::TypeId = typecheckAddGenericType(&mut module, boxBase, boxArguments);

  let mut initFields: Vector<Ast::Expression::RecordInitField> = Vector::new<Ast::Expression::RecordInitField>();
  initFields.push(typecheckRecordInitField("value", typecheckAddIntLiteral(&mut module, 1)));
  let boxPath: Ast::ExpressionId = typecheckAddVariable(&mut module, "Box");
  let initExpr: Ast::ExpressionId = typecheckAddRecordInit(
    &mut module,
    boxPath,
    Vector::new<Ast::TypeId>(),
    initFields,
  );

  let boxPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "boxed", boxOfI32);
  let letStmt: Ast::StatementId = module.addStatement(Ast::Statement::Node::Let(Ast::Statement::Let {
    span: typecheckDummySpan(),
    pattern: boxPattern,
    annotation: Option::SOME(boxOfI32),
    value: Option::SOME(initExpr),
  }));

  let boxedUse: Ast::ExpressionId = typecheckAddVariable(&mut module, "boxed");
  let boxedStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, boxedUse);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(boxedStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("main"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);

  let Option::SOME(bindingType) = findExprType(&output, boxedUse) else {
    @panic("typecheckGenericRecordAnnotationOnLocalResolves: binding has no type");
  };
  let Option::SOME(initType) = findExprType(&output, initExpr) else {
    @panic("typecheckGenericRecordAnnotationOnLocalResolves: initializer has no type");
  };

  Test::assertEq<u32>(bindingType.raw(), initType.raw());
}
