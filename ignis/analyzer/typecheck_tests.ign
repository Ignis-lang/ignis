  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);

  Test::assertEq<u64>(typecheckCountErrors(&output.diagnostics), 0);
}

/// Widening is one-way: a wider integer does not fit a narrower binding.
/// Spec: IGN-132 — implicit widening.
@test
function typecheckWideningRejectsNarrowingConversion(): void {
