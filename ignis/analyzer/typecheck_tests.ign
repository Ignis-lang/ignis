// Phase 15: if-as-expression, ternary, block tails +
// join-diagnosis follow-ups (selfhost-bidirectional-typecheck, S4)
// ============================================================

/// Scenario: an if-expression whose `then`/`else` branches both produce
/// `i32` joins cleanly, exactly like a match expression, and the joined
/// type is recorded as the if-expression's own type.
/// Spec: selfhost-typecheck — if-as-expression / ternary / block tail.
@test
function typecheckIfExpressionJoinsCompatibleBranchTypes(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");

  let condition: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);
  let thenBranch: Ast::StatementId = typecheckAddBlockStmt(&mut module, Vector::new<Ast::StatementId>(), Option::SOME(typecheckAddIntLiteral(&mut module, 1)));
  let elseBranch: Ast::StatementId = typecheckAddBlockStmt(&mut module, Vector::new<Ast::StatementId>(), Option::SOME(typecheckAddIntLiteral(&mut module, 2)));
  let ifExpr: Ast::ExpressionId = typecheckAddIfExpr(&mut module, condition, thenBranch, Option::SOME(elseBranch));
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, ifExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, ifExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: an if-expression with no `else` branch cannot produce a value,
/// so it is diagnosed instead of silently typing as `void`.
/// Spec: selfhost-typecheck — if-as-expression requires an else branch.
@test
function typecheckIfExpressionMissingElseProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let condition: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);
  let thenBranch: Ast::StatementId = typecheckAddBlockStmt(&mut module, Vector::new<Ast::StatementId>(), Option::SOME(typecheckAddIntLiteral(&mut module, 1)));
  let ifExpr: Ast::ExpressionId = typecheckAddIfExpr(&mut module, condition, thenBranch, Option::NONE);
  let ifStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, ifExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(ifStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::IF_MISSING_ELSE, "if expression requires an else branch");
}

/// Scenario: an if-expression used as a bare statement (no `expected` type
/// reaches either branch) still checks `then`/`else` compatibility, mirroring
/// the closed match-expression oracle bug (design D2): compatibility does
/// not depend on `expected.isSome()`. Exactly one `branch type mismatch`
/// diagnostic is emitted — no cascade into a second diagnostic once the
/// pairwise join fails.
/// Spec: selfhost-typecheck — arm/branch compatibility checked unconditionally.
@test
function typecheckIfExpressionBranchTypeMismatchProducesExactlyOneDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let condition: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);
  let thenBranch: Ast::StatementId = typecheckAddBlockStmt(&mut module, Vector::new<Ast::StatementId>(), Option::SOME(typecheckAddIntLiteral(&mut module, 1)));
  let elseBranch: Ast::StatementId = typecheckAddBlockStmt(&mut module, Vector::new<Ast::StatementId>(), Option::SOME(typecheckAddBoolLiteral(&mut module, true)));
  let ifExpr: Ast::ExpressionId = typecheckAddIfExpr(&mut module, condition, thenBranch, Option::SOME(elseBranch));
  let ifStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, ifExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(ifStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnostic(&output, DiagnosticCode::ARM_OR_BRANCH_TYPE_MISMATCH, "branch type mismatch: expected `i32`, found `boolean`");
}

/// Scenario: a ternary expression joins its `then`/`else` operand types the
/// same way as an if-expression, with `expected` threaded into both operands.
/// Spec: selfhost-typecheck — if-as-expression / ternary / block tail.
@test
function typecheckTernaryExpressionJoinsBranchTypes(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32Type: Ast::TypeId = typecheckAddPathType(&mut module, "i32");
  let xPattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");

  let condition: Ast::ExpressionId = typecheckAddBoolLiteral(&mut module, true);
  let thenBranch: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let elseBranch: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 2);
  let ternaryExpr: Ast::ExpressionId = typecheckAddTernaryExpr(&mut module, condition, thenBranch, elseBranch);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, xPattern, i32Type, ternaryExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 0);
  assertExprType(&output, ternaryExpr, typeStore.intern(Analyzer::Type::I32));
}

/// Scenario: a block expression with a tail resolves to the tail's type
/// (with `expected` threaded into it) instead of hitting the
