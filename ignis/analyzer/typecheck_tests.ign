@test
function typecheckMatchStatementChecksPatternGuardAndArmBody(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let pattern: Ast::PatternId = typecheckAddBinding(&mut module, "x");
  let guardExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "x");
  let bodyExpr: Ast::ExpressionId = typecheckAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Add,
    typecheckAddVariable(&mut module, "x"),
    typecheckAddBoolLiteral(&mut module, true),
  );
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: pattern,
    guard: Option::SOME(guardExpr),
    body: bodyExpr,
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddIntLiteral(&mut module, 1), arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Since S2b1, a guarded arm never counts toward coverage — not even a
  // binding pattern that would otherwise be irrefutable — so this sole,
  // guarded arm leaves the `i32` scrutinee's open domain uncovered and adds
  // a statement-position exhaustiveness WARNING on top of the pre-existing 2
  // diagnostics (guard condition, arm-body operand mismatch). Since S3, the
  // match wall is lifted and statement position no longer adds one.
  Test::assertEq<u64>(output.diagnostics.length(), 3);
  assertExprType(&output, guardExpr, typeStore.intern(Analyzer::Type::I32));
}

@test
function typecheckMatchStatementDoesNotSkipArmBodyDiagnostics(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let pattern: Ast::PatternId = typecheckAddWildcardPattern(&mut module);
  let missingExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "missing");
  let mut arms: Vector<Ast::Expression::MatchArm> = Vector::new<Ast::Expression::MatchArm>();
  arms.push(Ast::Expression::MatchArm {
    pattern: pattern,
    guard: Option::NONE,
    body: missingExpr,
  });
  let matchExpr: Ast::ExpressionId = typecheckAddMatchExpr(&mut module, typecheckAddIntLiteral(&mut module, 1), arms);
  let matchStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, matchExpr);
  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(matchStmt);
  bodyStmts.push(typecheckAddReturn(&mut module));
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);
  typecheckAddFunctionItem(&mut module, "main", Option::NONE, body);

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  // Since S3 lifted the match wall, only the arm-body diagnostic remains
  // (the wildcard pattern is irrefutable, so exhaustiveness stays silent).
  Test::assertEq<u64>(output.typecheck.diagnostics.length(), 1);
}

@test
function typecheckMatchWithUnresolvedScrutineeStillChecksArmBody(): void {
