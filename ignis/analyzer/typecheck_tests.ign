  let mut literalElements: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
  literalElements.push(typecheckAddIntLiteral(&mut module, 1));
  literalElements.push(typecheckAddIntLiteral(&mut module, 2));
  literalElements.push(typecheckAddIntLiteral(&mut module, 3));
  let vectorExpr: Ast::ExpressionId = typecheckAddVectorLiteralExpr(&mut module, literalElements);

  let aPattern: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "_a", arrayAnnotation);
  let letStmt: Ast::StatementId = typecheckAddLetStmt(&mut module, aPattern, arrayAnnotation, vectorExpr);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(letStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useVectorLiteral"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);

  let elementType: Analyzer::TypeId = typeStore.intern(Analyzer::Type::I32);
  assertExprType(&output, vectorExpr, typeStore.fixedArray(elementType, 3));
}

/// Scenario: an empty vector literal has no element to infer a type from, so
/// it reports `CANNOT_INFER_TYPE` instead of producing a fixed-array type.
/// Spec: IGN-27 — typecheck tuples, unit, and vector literals/indexing.
@test
function typecheckEmptyVectorLiteralProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let vectorExpr: Ast::ExpressionId = typecheckAddVectorLiteralExpr(&mut module, Vector::new<Ast::ExpressionId>());
  let vectorStmt: Ast::StatementId = typecheckAddExprStmt(&mut module, vectorExpr);
  let retStmt: Ast::StatementId = typecheckAddReturn(&mut module);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(vectorStmt);
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useEmptyVectorLiteral"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::NONE,
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  assertSingleDiagnosticCode(&output, DiagnosticCode::CANNOT_INFER_TYPE);
}

