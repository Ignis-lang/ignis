function typecheckVariantConstructionWithMatchingArguments(): void {
  let parsed: ParseOutput = typecheckParseSource(
    "enum Shape {\n  CIRCLE(u32),\n  EMPTY,\n}\n\nfunction make(): Shape {\n  return Shape::CIRCLE(1);\n}\n",
