  let recordType: Ast::TypeId = typecheckAddPathType(&mut module, "R");
  let rParam: Ast::PatternId = typecheckAddAnnotatedBinding(&mut module, "r", recordType);

  let receiverExpr: Ast::ExpressionId = typecheckAddVariable(&mut module, "r");
  let memberExpr: Ast::ExpressionId = typecheckAddMemberAccess(&mut module, receiverExpr, "m");
  let pipeLeft: Ast::ExpressionId = typecheckAddIntLiteral(&mut module, 1);
  let pipeExpr: Ast::ExpressionId = typecheckAddPipe(&mut module, pipeLeft, memberExpr);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(&mut module, pipeExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  let body: Ast::StatementId = typecheckAddBlock(&mut module, bodyStmts);

  let mut params: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();
  params.push(rParam);

  module.addRootItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create("useMethodPipe"),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: params,
    returnType: Option::SOME(i32TypeId),
    body: body,
    metadata: Ast::emptyMetadata(),
  }));

  let output: Analyzer::AnalyzerOutput = typecheckAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertExprType(&output, pipeExpr, typeStore.intern(Analyzer::Type::I32));
