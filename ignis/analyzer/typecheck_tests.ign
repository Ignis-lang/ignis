/// Build a non-root function item whose body returns `true` while the annotated
/// return type is `i32`, so nesting it anywhere must still report a mismatch.
function typecheckAddNestedBadReturnFunction(module: &mut Ast::Module, name: str): Ast::ItemId {
  let i32TypeId: Ast::TypeId = typecheckAddPathType(module, "i32");
  let boolExpr: Ast::ExpressionId = typecheckAddBoolLiteral(module, true);
  let retStmt: Ast::StatementId = typecheckAddReturnExpr(module, boolExpr);

  let mut bodyStmts: Vector<Ast::StatementId> = Vector::new<Ast::StatementId>();
  bodyStmts.push(retStmt);
  let bodyBlock: Ast::StatementId = typecheckAddBlock(module, bodyStmts);

  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addItem(Ast::Item::Node::Function(Ast::Item::Function {
    span: typecheckDummySpan(),
    name: String::create(name),
    genericParameters: Vector::new<Ast::GenericParam>(),
    parameters: Vector::new<Ast::PatternId>(),
    returnType: Option::SOME(i32TypeId),
    body: bodyBlock,
    metadata: Ast::emptyMetadata(),
  }));
}

