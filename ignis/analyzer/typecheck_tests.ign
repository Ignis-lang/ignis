/// Scenario: calling a name absent from `instanceMethods` (and not a static
/// method either) produces a `TYPE_MISMATCH` diagnostic — no silent success.
/// Spec: selfhost-method-call-resolution — unknown method.
@test
function typecheckInstanceMethodCallUnknownMethodProducesDiagnostic(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
