import IndexVec from "@compiler::indexing";
import HashMap from "std::collections";

export namespace Analyzer {
  /// Visibility of a top-level declaration in a module.
  /// Stored on `FunctionDef`, `RecordDef`, `EnumDef`, and `VariableDef`.
  /// Sub-definition wrappers (FieldDef, VariantDef, TypeParamDef) inherit access
  /// from their parent and do not carry their own visibility field.
  enum Visibility {
    PUBLIC,
    PRIVATE,

    /// Exhaustive 2×2 nested-match equality. No wildcard arms so that adding
    /// a future variant forces a compile error here.
    public equals(&self, other: &Analyzer::Visibility): boolean {
      return match (self) {
        Analyzer::Visibility::PUBLIC -> match (other) {
          Analyzer::Visibility::PUBLIC  -> true,
          Analyzer::Visibility::PRIVATE -> false,
        },
        Analyzer::Visibility::PRIVATE -> match (other) {
          Analyzer::Visibility::PUBLIC  -> false,
          Analyzer::Visibility::PRIVATE -> true,
        },
      };
    }
  }

  /// Payload wrapper for the `Definition::TypeParam` variant.
  /// Holds the interned name, the owning definition, and the parameter's
  /// positional index within that definition's type-parameter list.
  record TypeParamDef {
    public name: Analyzer::SymbolId;
    public owner: Analyzer::DefinitionId;
    public index: u32;
    /// Every trait named by a `T: Trait` bound, in written order. Held as the
    /// written path text for the same reason `RecordDef::implementedTraits` is:
    /// the binder records the bound before trait names resolve.
    public bounds: Vector<String>;
  }

  /// Payload wrapper for the `Definition::Field` variant.
  /// Holds the interned name, the field's declared type, the owning record's
  /// definition id, and the positional index within the record's field list.
  record FieldDef {
    public name: Analyzer::SymbolId;
    public fieldType: Analyzer::TypeId;
    public owner: Analyzer::DefinitionId;
    public index: u32;
    /// The alignment `@aligned(N)` asks for, in bytes.
    public alignment: Option<u64>;
  }

  /// Payload wrapper for the `Definition::Variant` variant.
  /// `payload` holds the types carried by the variant in declaration order;
  /// an empty vector represents a fieldless variant.
  record VariantDef {
    public name: Analyzer::SymbolId;
    public payload: Vector<Analyzer::TypeId>;
    public owner: Analyzer::DefinitionId;
    public tagValue: u32;
  }

  /// Payload wrapper for the `Definition::Variable` variant.
  /// Used for local variables and function parameters stored as sub-definitions.
  /// Named `mutable` to avoid the reserved keyword `mut`.
  record VariableDef {
    public name: Analyzer::SymbolId;
    public visibility: Analyzer::Visibility;
    public declaredType: Analyzer::TypeId;
    public mutable: boolean;
    /// `@takes` on a parameter: an extern callee consumes this argument.
    /// Meaningless on a local, where it stays false.
    public takes: boolean;
    /// `@noescape` on a parameter: a closure passed here does not outlive the
    /// call, so escape analysis leaves its environment on the stack.
    public noEscape: boolean;
    /// A `const NAME: Type;` inside an `extern` block: no value of its own,
    /// and the emitted C names it as written.
    public isExtern: boolean;
  }

  /// Payload wrapper for the `Definition::Function` variant.
  /// `params` is a vector of `DefinitionId`s referencing `Variable` sub-defs
  /// in declaration order. `typeParams` holds `TypeParam` sub-def ids.
  record FunctionDef {
    public name: Analyzer::SymbolId;
    public visibility: Analyzer::Visibility;
    public typeParams: Vector<Analyzer::DefinitionId>;
    public params: Vector<Analyzer::DefinitionId>;
    public returnType: Analyzer::TypeId;
    /// Set when the function carries `@deprecated`, with or without a message.
    public isDeprecated: boolean;
    /// The optional `@deprecated("...")` message. `NONE` both when the
    /// function is not deprecated and when `@deprecated` has no argument
    /// (mirrors the Rust `FunctionAttr::Deprecated(Option<String>)` payload).
    public deprecatedMessage: Option<String>;
    /// The type named by `@extension(Type)`, as the raw text the parser saw.
    /// `NONE` for an ordinary function. Kept as text because attribute
    /// arguments are lexemes and the binder resolves no types.
    public extensionTarget: Option<String>;
    /// Set when the extension attribute is written `@extension(Type, mut)`,
    /// which makes the receiver a mutable place rather than a value.
    public extensionMutable: boolean;
    /// Declared inside an `extern` block, so it has no body and keeps its
    /// written name in the emitted C.
    public isExtern: boolean;
    /// The C symbol named by `@externName("name")` on an extern function,
    /// when it differs from the written name.
    public externName: Option<String>;
  }

  /// Payload wrapper for the `Definition::Method` variant.
  /// Models a method declared inside a record, enum, or trait body. Method
  /// parameters remain existing `Variable` sub-definitions referenced by `params`;
  /// this slice introduces the owner-aware model without method-call resolution.
  /// `owner` is the owning record/enum/trait `DefinitionId`. `isStatic` separates
  /// receiver (`self`) methods from owner-local static methods. `selfMutable`
  /// records whether the receiver is bound mutably; static methods keep it `false`.
  record MethodDef {
    public name: Analyzer::SymbolId;
    public visibility: Analyzer::Visibility;
    public owner: Analyzer::DefinitionId;
    public typeParams: Vector<Analyzer::DefinitionId>;
    public params: Vector<Analyzer::DefinitionId>;
    public returnType: Analyzer::TypeId;
    public isStatic: boolean;
    public selfMutable: boolean;
    /// Set when the method carries `@deprecated`, with or without a message.
    public isDeprecated: boolean;
    /// The optional `@deprecated("...")` message. `NONE` both when the
    /// method is not deprecated and when `@deprecated` has no argument.
    public deprecatedMessage: Option<String>;
  }

  /// Payload wrapper for the `Definition::Record` variant.
  /// `fields` is a vector of `DefinitionId`s referencing `Field` sub-defs.
  /// `typeId` is the interned `Type::Record(defId)` for this definition.
  /// Named `RecordDef` to avoid clashing with the `record` keyword.
  record RecordDef {
    public name: Analyzer::SymbolId;
    public visibility: Analyzer::Visibility;
    public typeParams: Vector<Analyzer::DefinitionId>;
    public fields: Vector<Analyzer::DefinitionId>;
    /// Owner-local instance method ids (`self` receivers), populated by the binder.
    public instanceMethods: Vector<Analyzer::DefinitionId>;
    /// Owner-local static method ids (no `self`), populated by the binder.
    public staticMethods: Vector<Analyzer::DefinitionId>;
    /// Owner-local static field ids, one `Definition::Variable` per field the
    /// record declares with `static`. Reached as `Record::NAME`, never through
    /// an instance, so they sit outside `fields`.
    public staticFields: Vector<Analyzer::DefinitionId>;
    public typeId: Analyzer::TypeId;
    /// Set when the record carries `@implements(Copy)`.
    public implementsCopy: boolean;
    /// Set when the record carries `@implements(Drop)`.
    public implementsDrop: boolean;
    /// Every trait named by an `@implements(...)` attribute, in written order.
    /// Held as raw attribute text because attribute arguments are not resolved
    /// to definitions.
    public implementedTraits: Vector<String>;
    /// Set when the record carries `@packed`.
    public packed: boolean;
    /// The alignment `@aligned(N)` asks for, in bytes.
    public alignment: Option<u64>;
  }

  /// Payload wrapper for the `Definition::Enum` variant.
  /// `variants` is a vector of `DefinitionId`s referencing `Variant` sub-defs.
  /// `typeId` is the interned `Type::Enum(defId)` for this definition.
  /// Named `EnumDef` to avoid clashing with the `enum` keyword.
  record EnumDef {
    public name: Analyzer::SymbolId;
    public visibility: Analyzer::Visibility;
    public typeParams: Vector<Analyzer::DefinitionId>;
    public variants: Vector<Analyzer::DefinitionId>;
    /// Owner-local instance method ids (`self` receivers), populated by the binder.
    public instanceMethods: Vector<Analyzer::DefinitionId>;
    /// Owner-local static method ids (no `self`), populated by the binder.
    public staticMethods: Vector<Analyzer::DefinitionId>;
    /// Owner-local static field ids, one `Definition::Variable` per member the
    /// enum declares with a value. Reached as `Enum::NAME`, alongside the
    /// variants rather than among them.
    public staticFields: Vector<Analyzer::DefinitionId>;
    public typeId: Analyzer::TypeId;
    /// Set when the enum carries `@lang(try)` and has exactly two variants, which
    /// is what lets `?` work on it. `NONE` for every other enum.
    public tryCapable: Option<Analyzer::TryCapability>;
    /// Set when the enum carries `@implements(Copy)`.
    public implementsCopy: boolean;
    /// Set when the enum carries `@implements(Drop)`.
    public implementsDrop: boolean;
    /// Every trait named by an `@implements(...)` attribute, in written order.
    /// Held as raw attribute text because attribute arguments are not resolved
    /// to definitions.
    public implementedTraits: Vector<String>;
  }

  /// Which variants of a `@lang(try)` enum carry the success and failure payloads.
  ///
  /// Identified by declaration order rather than by name, so an enum spelling its
  /// variants `OK`/`ERROR` and one spelling them `SOME`/`NONE` are both usable.
  record TryCapability {
    public okVariant: u32;
    public errVariant: u32;
  }

  /// Payload wrapper for the `Definition::TypeAlias` variant.
  /// `aliasedType` is filled by the resolver pass; VOID sentinel until then.
  /// `typeId` is interned as `Type::Alias(defId)` by binder pass-2.
  record TypeAliasDef {
    public name: Analyzer::SymbolId;
    public visibility: Analyzer::Visibility;
    public typeParams: Vector<Analyzer::DefinitionId>;
    public aliasedType: Analyzer::TypeId;
    public typeId: Analyzer::TypeId;
  }

  /// Payload wrapper for the `Definition::Trait` variant.
  /// `methods` stores bound trait method definitions; `assocTypes` remain deferred.
  /// `typeId` stays VOID — no `Type::Trait` variant in this slice (ADR-C6).
  record TraitDef {
    public name: Analyzer::SymbolId;
    public visibility: Analyzer::Visibility;
    public typeParams: Vector<Analyzer::DefinitionId>;
    public methods: Vector<Analyzer::DefinitionId>;
    public assocTypes: Vector<Analyzer::DefinitionId>;
    public typeId: Analyzer::TypeId;
  }

  /// A named declaration in the analyzer's definition store.
  /// Each variant wraps a `*Def` record that carries the declaration's full payload.
  /// Method `name()` is exhaustive — no wildcard arm — so adding a future
  /// variant forces a compile error at every call site.
  enum Definition {
    Function(Analyzer::FunctionDef),
    Method(Analyzer::MethodDef),
    Record(Analyzer::RecordDef),
    Enum(Analyzer::EnumDef),
    Variable(Analyzer::VariableDef),
    Field(Analyzer::FieldDef),
    Variant(Analyzer::VariantDef),
    TypeParam(Analyzer::TypeParamDef),
    TypeAlias(Analyzer::TypeAliasDef),
    Trait(Analyzer::TraitDef),

    /// Returns the interned symbol for this definition's declared name.
    /// Exhaustive across all ten variants — no wildcard arm.
    public name(&self): Analyzer::SymbolId {
      return match (self) {
        Analyzer::Definition::Function(wrapper)   -> wrapper.name,
        Analyzer::Definition::Method(wrapper)     -> wrapper.name,
        Analyzer::Definition::Record(wrapper)     -> wrapper.name,
        Analyzer::Definition::Enum(wrapper)       -> wrapper.name,
        Analyzer::Definition::Variable(wrapper)   -> wrapper.name,
        Analyzer::Definition::Field(wrapper)      -> wrapper.name,
        Analyzer::Definition::Variant(wrapper)    -> wrapper.name,
        Analyzer::Definition::TypeParam(wrapper)  -> wrapper.name,
        Analyzer::Definition::TypeAlias(wrapper)  -> wrapper.name,
        Analyzer::Definition::Trait(wrapper)      -> wrapper.name,
      };
    }

    /// Returns a stable small integer identifying this definition's variant tag,
    /// used to detect variant-changing replacements in `DefinitionStore::replace`.
    /// Exhaustive across all ten variants — no wildcard arm.
    public variantTag(&self): u32 {
      return match (self) {
        Analyzer::Definition::Function(_)   -> 0,
        Analyzer::Definition::Method(_)     -> 1,
        Analyzer::Definition::Record(_)     -> 2,
        Analyzer::Definition::Enum(_)       -> 3,
        Analyzer::Definition::Variable(_)   -> 4,
        Analyzer::Definition::Field(_)      -> 5,
        Analyzer::Definition::Variant(_)    -> 6,
        Analyzer::Definition::TypeParam(_)  -> 7,
        Analyzer::Definition::TypeAlias(_)  -> 8,
        Analyzer::Definition::Trait(_)      -> 9,
      };
    }
  }

  /// Flat, insertion-ordered store of all definitions visible in a module.
  /// Mirrors the slice-1 `TypeStore` shape: no interning, no caches, `init()`
  /// returns empty and `push` is the sole allocator.
  record DefinitionStore {
    definitions: IndexVec<Analyzer::DefinitionTag, Analyzer::Definition>;
    /// The written path of each declaration (`Analyzer::TypeId`), keyed by
    /// raw definition id. Filled by `analyzeProgram` as modules bind, so
    /// later phases can pick between same-named declarations by the path a
    /// reference writes. Empty for definitions no module publishes.
    qualifiedNames: HashMap<u32, String>;
    /// The module index each published declaration belongs to, and the module
    /// currently being analyzed — so a bare-name scan can prefer the current
    /// module's declaration over a same-named one from elsewhere.
    defModules: HashMap<u32, u64>;
    activeModule: u64;
    /// Every declaration the module currently being analyzed can name: its own
    /// declarations and re-exports, plus what its imports bind. Refreshed for
    /// each module, and left unpublished when a caller analyzes a single
    /// module, where nothing can come from elsewhere.
    visibleDefs: HashMap<u32, boolean>;
    visibleDefsPublished: boolean;

    public static init(): DefinitionStore {
      return DefinitionStore {
        definitions: IndexVec::new<Analyzer::DefinitionTag, Analyzer::Definition>(),
        qualifiedNames: HashMap::new<u32, String>(),
        defModules: HashMap::new<u32, u64>(),
        activeModule: 0,
        visibleDefs: HashMap::new<u32, boolean>(),
        visibleDefsPublished: false,
      };
    }

    /// Record which module published `id`. First write wins.
    public setDefModule(&mut self, id: Analyzer::DefinitionId, moduleIndex: u64): void {
      let raw: u32 = id.raw();
      if (self.defModules.get(&raw).isSome()) {
        return;
      }

      self.defModules.insert(raw, moduleIndex);
    }

    /// Whether `id` was published by the module currently being analyzed.
    public defBelongsToActiveModule(&self, id: Analyzer::DefinitionId): boolean {
      let raw: u32 = id.raw();
      let Option::SOME(moduleIndex) = self.defModules.get(&raw) else {
        return false;
      };

      return *moduleIndex == self.activeModule;
    }

    /// The module that published `id`, if any.
    public defModuleOf(&self, id: Analyzer::DefinitionId): Option<u64> {
      let raw: u32 = id.raw();
      let Option::SOME(moduleIndex) = self.defModules.get(&raw) else {
        return Option::NONE;
      };

      return Option::SOME(*moduleIndex);
    }

    /// Set the module whose bodies are being analyzed.
    public setActiveModule(&mut self, moduleIndex: u64): void {
      self.activeModule = moduleIndex;
    }

    /// Replace the set of declarations the module being analyzed can name.
    public setActiveModuleVisibleDefs(&mut self, defs: &Vector<Analyzer::DefinitionId>): void {
      self.visibleDefs = HashMap::new<u32, boolean>();
      self.visibleDefsPublished = true;

      let mut index: u64 = 0;
      while (index < defs.length()) {
        if (let Option::SOME(defId) = defs.get(index)) {
          self.visibleDefs.insert(defId.raw(), true);
        }

        index += 1;
      }
    }

    /// Whether `id` is nameable from the module currently being analyzed.
    /// True while no set has been published, so a single-module analysis keeps
    /// seeing every definition.
    public defVisibleInActiveModule(&self, id: Analyzer::DefinitionId): boolean {
      if (!self.visibleDefsPublished) {
        return true;
      }

      let raw: u32 = id.raw();
      return self.visibleDefs.get(&raw).isSome();
    }

    /// Record the written path a declaration is published under. First write
    /// wins: a re-export repeats the original path.
    public setQualifiedName(&mut self, id: Analyzer::DefinitionId, qualifiedName: String): void {
      let raw: u32 = id.raw();
      if (self.qualifiedNames.get(&raw).isSome()) {
        return;
      }

      self.qualifiedNames.insert(id.raw(), qualifiedName);
    }

    /// The written path recorded for `id`, if any.
    public qualifiedNameOf(&self, id: Analyzer::DefinitionId): Option<&String> {
      let raw: u32 = id.raw();
      return self.qualifiedNames.get(&raw);
    }

    public push(&mut self, def: Analyzer::Definition): Analyzer::DefinitionId {
      return self.definitions.push(def);
    }

    public get(&self, id: Analyzer::DefinitionId): Option<&Analyzer::Definition> {
      return self.definitions.get(id);
    }

    public length(&self): u64 {
      return self.definitions.length();
    }

    /// Replace the definition at `id` with `def`. Returns `false` if `id` is out of bounds.
    ///
    /// Caller is responsible for preserving the variant tag — patching a Record with an
    /// Enum is permitted by the type system but breaks every downstream invariant.
    /// Delegates to `IndexVec::set` so production builds only need the setter
    /// specialization instead of a separate public mutable-reference accessor.
    public replace(&mut self, id: Analyzer::DefinitionId, def: Analyzer::Definition): boolean {
      let mut tagMismatch: boolean = false;

      if (let Option::SOME(existing) = self.definitions.get(id)) {
        if (existing.variantTag() != def.variantTag()) {
          tagMismatch = true;
        }
      }

      if (tagMismatch) {
        @panic("DefinitionStore::replace: replacement definition changes variant tag, which breaks every downstream invariant");
      }

      return self.definitions.set(id, def);
    }
  }
}
