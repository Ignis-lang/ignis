// ===========================================================================
// Rejected fixtures: the host rejects these and so does the selfhost, with
// the code named below. Where the two code spaces disagree the host code is
// recorded alongside the selfhost one.
// ===========================================================================

/// Origin: golden_err::undeclared_identifier.
/// Host expectation: I0033.
@test
function parityUndeclaredIdentifier(): void {
  parityRejectsSource(
    "function main(): void {\n    let x: i32 = unknown_var;\n    return;\n}\n",
    DiagnosticCode::UNDECLARED_VARIABLE,
