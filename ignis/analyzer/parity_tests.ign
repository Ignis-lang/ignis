@test
function parityMatchArmInferencePropagates(): void {
  parityAcceptsSource(
    "enum Option<T> {\n    Some(T),\n    None,\n}\n\nfunction fromBool(flag: boolean): Option<i32> {\n    return match (flag) {\n        true -> Option::Some(1),\n        false -> Option::None,\n    };\n}\n",
  );
}

