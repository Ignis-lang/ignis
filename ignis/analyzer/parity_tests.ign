/// Origin: diagnostics::borrow_checking_continues_after_a_let_else.
/// Host expectation: rejected with A0047 (MutatedWhileBorrowed).
@test
function parityBorrowCheckingContinuesAfterLetElse(): void {
  parityRejectsSource(
    "enum Maybe {\n    Some(i32),\n    None,\n}\n\nfunction run(input: Maybe): i32 {\n    let mut owned: i32 = 1;\n\n    let Maybe::Some(v) = input else {\n        return -1;\n    };\n\n    let r: &mut i32 = &mut owned;\n    owned = 5;\n    return v + *r;\n}\n",
    DiagnosticCode::MUTATED_WHILE_BORROWED,
    1,
  );
}

/// Origin: diagnostics::move_in_a_let_else_else_block_does_not_hide_a_later_double_move.
/// Host expectation: rejected with O0001 (UseAfterMove) at the second
/// `consume(other)`; the move inside the else block is not what is reported.
@test
function parityMoveInLetElseDoesNotHideLaterDoubleMove(): void {
  parityRejectsSource(
    "@implements(Drop)\nrecord Owned {\n    public id: i32;\n    drop(&mut self): void { return; }\n}\n\nenum Maybe {\n    Some(i32),\n    None,\n}\n\nfunction consume(value: Owned): i32 {\n    return 1;\n}\n\nfunction run(input: Maybe): i32 {\n    let owned: Owned = Owned { id: 1 };\n    let other: Owned = Owned { id: 2 };\n\n    let Maybe::Some(v) = input else {\n        consume(owned);\n        return -1;\n    };\n\n    consume(other);\n    consume(other);\n    return v;\n}\n",
    DiagnosticCode::USE_AFTER_MOVE,
    1,
  );
}

/// Origin: golden_ok::move_inside_a_let_else_else_block_does_not_escape_it.
/// Host expectation: accepted — the else block diverges, so the move it makes
/// is never observable on the path that falls through the binding.
@test
function parityMoveInsideLetElseElseBlock(): void {
  parityAcceptsSource(
    "@implements(Drop)\nrecord Owned {\n    public id: i32;\n    drop(&mut self): void { return; }\n}\n\nenum Maybe {\n    Some(i32),\n    None,\n}\n\nfunction consume(value: Owned): i32 {\n    return 1;\n}\n\nfunction run(input: Maybe): i32 {\n    let owned: Owned = Owned { id: 1 };\n\n    let Maybe::Some(v) = input else {\n        consume(owned);\n        return -1;\n    };\n\n    consume(owned);\n    return v;\n}\n",
  );
}

