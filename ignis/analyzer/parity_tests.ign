import Test from "std::test";

import DiagnosticBag, DiagnosticCode, Severity, SourceFile from "@compiler::diagnostics";
import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import ParseOutput, Parser from "@compiler::parser";
import Lowering from "./lowering";
import Borrowck from "./borrowck";

// ===========================================================================
// IGN-40 slice A — analyzer parity harness and curated corpus
//
// Every fixture below is copied verbatim from a host suite
// (`crates/ignis_analyzer/tests/`) or from a `test_cases/analyzer/` file, and
// each test names its origin. The corpus is classified against what the
// selfhost analyzer actually does: the fixtures the selfhost already agrees
// with are permanent gates here, and the ones it does not are inventoried in
// the gap list at the bottom of this file rather than weakened into passing.
//
// Parity is defined on the OUTCOME, not on the literal error code. The
// selfhost owns its own code space (see `ignis/diagnostics/codes.ign`), which
// deliberately renumbers most of the `A####` family, so a reject fixture names
// the selfhost code and records the host code it corresponds to.
// ===========================================================================

function parityCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

function parityCountCode(bag: &DiagnosticBag, code: str): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (String::create(diagnostic.code).equals(code)) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

/// Runs `source` through the whole selfhost pipeline — parse, `analyzeModule`,
/// `Lowering::lowerModule`, `Borrowck::checkModule` — and asserts that every
/// stage stays silent.
///
/// The assertion is on the full bag, not on the error count: a fixture the
/// host accepts without complaint must not acquire a selfhost warning either,
/// because a warning here is the shape a future false positive takes.
function parityAcceptsSource(source: str): void {
  let file: SourceFile = SourceFile::create("parity_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(parsed.lexDiagnostics.length(), 0);
  Test::assertEq<u64>(parsed.parseDiagnostics.length(), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(output.diagnostics.length(), 0);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let checked: Borrowck::BorrowckOutput = Borrowck::checkModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &hir,
  );

  Test::assertEq<u64>(checked.diagnostics.length(), 0);
}

/// Runs `source` through the whole selfhost pipeline and asserts that the only
/// diagnostics it draws are `expectedCount` warnings carrying `code`.
///
/// Used by fixtures the host compiles without errors but still lints: the host
/// reports the same warning on the same source, so emitting it here is parity,
/// not a false positive. Anything beyond that exact count still fails.
function parityAcceptsSourceWithLint(source: str, code: str, expectedCount: u64): void {
  let file: SourceFile = SourceFile::create("parity_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(parsed.lexDiagnostics.length(), 0);
  Test::assertEq<u64>(parsed.parseDiagnostics.length(), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(parityCountErrors(&output.diagnostics), 0);
  Test::assertEq<u64>(output.diagnostics.length(), expectedCount);
  Test::assertEq<u64>(parityCountCode(&output.diagnostics, code), expectedCount);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let checked: Borrowck::BorrowckOutput = Borrowck::checkModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &hir,
  );

  Test::assertEq<u64>(checked.diagnostics.length(), 0);
}

/// Runs `source` through the same pipeline and asserts that `code` is reported
/// exactly `expectedCount` times.
///
/// Only the named code is asserted. Several of these fixtures also draw
/// cascade diagnostics the host does not emit; those are recorded in the gap
/// list instead of being frozen here, so that removing one does not fail a
/// gate that is about a different diagnostic.
///
/// Parse errors are always rejected: a fixture the parser cannot read never
/// reaches the phase under test.
function parityRejectsSource(source: str, code: str, expectedCount: u64): void {
  let file: SourceFile = SourceFile::create("parity_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(parityCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(parityCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  if (parityCountErrors(&output.diagnostics) > 0) {
    Test::assertEq<u64>(parityCountCode(&output.diagnostics, code), expectedCount);
    return;
  }

  Test::assertEq<u64>(parityCountCode(&output.diagnostics, code), 0);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let checked: Borrowck::BorrowckOutput = Borrowck::checkModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &hir,
  );

  Test::assertEq<u64>(parityCountCode(&checked.diagnostics, code), expectedCount);
}

