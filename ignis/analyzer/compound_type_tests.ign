  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);

  let immutable: Analyzer::TypeId = store.pointer(idI32);
  let mutable_: Analyzer::TypeId = store.mutablePointer(idI32);

  let Option::SOME(immutableType) = store.get(immutable) else {
    @panic("expected type to exist");
  };
  let Option::SOME(mutableType) = store.get(mutable_) else {
    @panic("expected type to exist");
  };

  Test::assert(!immutableType.equals(mutableType));
}

