  let actual: String = store.nameOf(id);

  Test::assertEq<str>(actual.toStr(), expected.toStr());
}

// ─── Fixture helpers ──────────────────────────────────────────────────────────

/// Creates a minimal `RecordDef` in `defs` with the given name interned into
/// `syms`, and a corresponding `Type::Record` entry in `store`. Returns the
/// `DefinitionId` of the newly created record.
function mkRecordDef(
  syms: &mut Analyzer::SymbolTable,
  defs: &mut Analyzer::DefinitionStore,
  store: &mut Analyzer::TypeStore,
  name: str,
): Analyzer::DefinitionId {
  let mut symsRef: &mut Analyzer::SymbolTable = syms;
  let mut defsRef: &mut Analyzer::DefinitionStore = defs;
  let mut storeRef: &mut Analyzer::TypeStore = store;

  let sym: Analyzer::SymbolId = symsRef.intern(name);
  let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(defsRef.length() as u32);
  let typeId: Analyzer::TypeId = storeRef.recordType(defId);
  let def: Analyzer::Definition = Analyzer::Definition::Record(Analyzer::RecordDef {
    name: sym,
    visibility: Analyzer::Visibility::PUBLIC,
    typeParams: Vector::new<Analyzer::DefinitionId>(),
    fields: Vector::new<Analyzer::DefinitionId>(),
    instanceMethods: Vector::new<Analyzer::DefinitionId>(),
    staticMethods: Vector::new<Analyzer::DefinitionId>(),
    staticFields: Vector::new<Analyzer::DefinitionId>(),
    typeId: typeId,
    implementsCopy: false,
    implementsDrop: false,
    implementedTraits: Vector::new<String>(),
    packed: false,
    alignment: Option::NONE,
  });

  defsRef.push(def);

  return defId;
}

/// Creates a minimal `EnumDef` in `defs` with the given name interned into
/// `syms`, and a corresponding `Type::Enum` entry in `store`. Returns the
/// `DefinitionId` of the newly created enum.
function mkEnumDef(
  syms: &mut Analyzer::SymbolTable,
  defs: &mut Analyzer::DefinitionStore,
  store: &mut Analyzer::TypeStore,
  name: str,
): Analyzer::DefinitionId {
  let mut symsRef: &mut Analyzer::SymbolTable = syms;
  let mut defsRef: &mut Analyzer::DefinitionStore = defs;
  let mut storeRef: &mut Analyzer::TypeStore = store;

  let sym: Analyzer::SymbolId = symsRef.intern(name);
  let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(defsRef.length() as u32);
  let typeId: Analyzer::TypeId = storeRef.enumType(defId);
  let def: Analyzer::Definition = Analyzer::Definition::Enum(Analyzer::EnumDef {
    name: sym,
    visibility: Analyzer::Visibility::PUBLIC,
    typeParams: Vector::new<Analyzer::DefinitionId>(),
    variants: Vector::new<Analyzer::DefinitionId>(),
    tryCapable: Option::NONE,
    instanceMethods: Vector::new<Analyzer::DefinitionId>(),
    staticMethods: Vector::new<Analyzer::DefinitionId>(),
    staticFields: Vector::new<Analyzer::DefinitionId>(),
    typeId: typeId,
    implementsCopy: false,
    implementsDrop: false,
    implementedTraits: Vector::new<String>(),
  });

  defsRef.push(def);

  return defId;
}

