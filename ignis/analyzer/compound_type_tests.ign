@test
function substituteParamHitReturnsMappedArg(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let tSymbol: Symbol = Symbol::fromRaw(1);
  let paramId: Analyzer::TypeId = store.param(tSymbol);
  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);

  let mut params: Vector<Symbol> = Vector::new<Symbol>();
  params.push(tSymbol);
  let mut args: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  args.push(idI32);

  let result: Analyzer::TypeId = store.substitute(paramId, &params, &args);

  Test::assertEq<u32>(result.raw(), idI32.raw());
}

@test
function substituteParamMissReturnsOriginalType(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let unrelatedSymbol: Symbol = Symbol::fromRaw(9);
  let paramId: Analyzer::TypeId = store.param(unrelatedSymbol);
  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);

  let mut params: Vector<Symbol> = Vector::new<Symbol>();
  params.push(Symbol::fromRaw(1));
  let mut args: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  args.push(idI32);

  let result: Analyzer::TypeId = store.substitute(paramId, &params, &args);

  Test::assertEq<u32>(result.raw(), paramId.raw());
}

