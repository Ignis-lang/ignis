  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);

  let inner: Analyzer::TypeId = store.functionType(Vector::new<Analyzer::TypeId>(), idI32);
  let outer: Analyzer::TypeId = store.functionType(Vector::new<Analyzer::TypeId>(), inner);

  Test::assertEq<str>(store.nameOf(outer).toStr(), "fn() -> fn() -> i32");
}

@test
function equalsFalseForFunctionVsTuple(): void {
  let idZero: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(0);

  let ft: Analyzer::FunctionType = Analyzer::FunctionType { params: Vector::new<Analyzer::TypeId>(), returnType: idZero };
  let tt: Analyzer::TupleType = Analyzer::TupleType { elements: Vector::new<Analyzer::TypeId>() };

  let fnType: Analyzer::Type = Analyzer::Type::Function(ft);
  let tupleType: Analyzer::Type = Analyzer::Type::Tuple(tt);

  Test::assert(!fnType.equals(&tupleType));
  Test::assert(!tupleType.equals(&fnType));
}

@test
function equalsFalseForFunctionWithDifferentReturnTypes(): void {
  let idZero: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(0);
  let idOne: Analyzer::TypeId = Id::fromRaw<Analyzer::TypeTag>(1);

  let ft1: Analyzer::FunctionType = Analyzer::FunctionType { params: Vector::new<Analyzer::TypeId>(), returnType: idZero };
  let ft2: Analyzer::FunctionType = Analyzer::FunctionType { params: Vector::new<Analyzer::TypeId>(), returnType: idOne };

  let type1: Analyzer::Type = Analyzer::Type::Function(ft1);
  let type2: Analyzer::Type = Analyzer::Type::Function(ft2);

  Test::assert(!type1.equals(&type2));
}

@test
function recordTypeInterningIsIdempotent(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);

  let lengthBefore: u64 = store.length();

  let first: Analyzer::TypeId = store.recordType(defId);
  let second: Analyzer::TypeId = store.recordType(defId);

  Test::assertEq<u32>(first.raw(), second.raw());
  Test::assertEq<u64>(store.length(), lengthBefore + 1);
}

@test
function enumTypeInterningIsIdempotent(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(7);

  let lengthBefore: u64 = store.length();

  let first: Analyzer::TypeId = store.enumType(defId);
  let second: Analyzer::TypeId = store.enumType(defId);

  Test::assertEq<u32>(first.raw(), second.raw());
  Test::assertEq<u64>(store.length(), lengthBefore + 1);
}

@test
function distinctDefinitionIdsProduceDistinctRecordTypeIds(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let defIdA: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);
  let defIdB: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(1);

  let lengthBefore: u64 = store.length();

  let idA: Analyzer::TypeId = store.recordType(defIdA);
  let idB: Analyzer::TypeId = store.recordType(defIdB);

  Test::assert(idA.raw() != idB.raw());
  Test::assertEq<u64>(store.length(), lengthBefore + 2);
}

@test
function distinctDefinitionIdsProduceDistinctEnumTypeIds(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let defIdA: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(0);
  let defIdB: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(1);

  let idA: Analyzer::TypeId = store.enumType(defIdA);
  let idB: Analyzer::TypeId = store.enumType(defIdB);

  Test::assert(idA.raw() != idB.raw());
}

@test
function recordAndEnumWithSameDefinitionIdAreDistinct(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(42);

  let lengthBefore: u64 = store.length();

  let recId: Analyzer::TypeId = store.recordType(defId);
  let enumId: Analyzer::TypeId = store.enumType(defId);

  Test::assert(recId.raw() != enumId.raw());
  Test::assertEq<u64>(store.length(), lengthBefore + 2);
}

