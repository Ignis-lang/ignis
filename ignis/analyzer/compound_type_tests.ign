  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let mut params: Vector<Symbol> = Vector::new<Symbol>();
  params.push(tSymbol);
  let mut args: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  args.push(idI32);

  let result: Analyzer::TypeId = store.substitute(instanceOfParam, &params, &args);

  let mut expectedArgs: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  expectedArgs.push(idI32);
  let expected: Analyzer::TypeId = store.instance(outerDefId, expectedArgs);

  Test::assertEq<u32>(result.raw(), expected.raw());
}

