@test
function nameOfResolvedReturnsPrimitiveName(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut syms: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let idBoolean: Analyzer::TypeId = store.intern(Analyzer::Type::BOOLEAN);
  let idStr: Analyzer::TypeId = store.intern(Analyzer::Type::STR);

  Test::assertEq<str>(store.nameOfResolved(idI32, &defs, &syms).toStr(), "i32");
  Test::assertEq<str>(store.nameOfResolved(idBoolean, &defs, &syms).toStr(), "bool");
  Test::assertEq<str>(store.nameOfResolved(idStr, &defs, &syms).toStr(), "str");
}

@test
function nameOfResolvedReturnsRecordRealName(): void {
