import Test from "std::test";

import DiagnosticBag, Severity, SourceFile from "@compiler::diagnostics";
import Ast from "@compiler::ast";
import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import ParseOutput, Parser from "@compiler::parser";
import Id from "@compiler::ids";
import Lowering from "./lowering";

function loweringCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

/// Parses and analyzes `source`, runs lowering, and renders the resulting
/// HIR store with the display printer. Parse errors are always rejected;
/// analyzer errors are only rejected when `requireCleanAnalysis` is true.
///
/// Lowering reads name resolution and recorded expression types, so it runs
/// on analyzer output that carries errors just as well — which is what lets
/// the `if let` desugar be covered while the selfhost typechecker still
/// rejects let conditions outright.
function loweringRenderChecked(source: str, requireCleanAnalysis: boolean): String {
  let file: SourceFile = SourceFile::create("lowering_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(loweringCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(loweringCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  if (requireCleanAnalysis) {
    Test::assertEq<u64>(loweringCountErrors(&output.diagnostics), 0);
  }

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  return Hir::Display::printHir(&hir, &typeStore, &defStore, &symbols);
}

/// Renders `source` after asserting the whole pipeline is diagnostic-free.
function loweringRender(source: str): String {
  return loweringRenderChecked(source, true);
}

/// Renders every capture override the closures of `source` carry, in the
/// order lowering collected them. The HIR printer does not show them, and a
/// count alone would not tell a `@move` from a `@ref`.
function loweringRenderCaptureOverrides(source: str): String {
  let file: SourceFile = SourceFile::create("lowering_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(loweringCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(loweringCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(loweringCountErrors(&output.diagnostics), 0);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let mut rendered: String = String::create("");
  let mut nodeIndex: u64 = 0;

  while (nodeIndex < hir.nodes.length()) {
    let Option::SOME(node) = hir.nodes.get(nodeIndex) else {
      nodeIndex += 1;
      continue;
    };

    if (let Hir::HirKind::Closure(closure) = &node.kind) {
      let mut overrideIndex: u64 = 0;

      while (overrideIndex < closure.captureOverrides.length()) {
        let Option::SOME(override_) = closure.captureOverrides.get(overrideIndex) else {
          overrideIndex += 1;
          continue;
        };

        let modeText: str = match (override_.mode) {
          Hir::CaptureMode::ByValue -> "ByValue",
          Hir::CaptureMode::ByRef -> "ByRef",
          Hir::CaptureMode::ByMutRef -> "ByMutRef",
        };

        let mut name: String = String::create("<unknown>");

        if (let Option::SOME(definition) = defStore.get(override_.sourceDef)) {
          if (let Option::SOME(text) = symbols.resolve(definition.name())) {
            name = String::create(text);
          }
        }

        rendered.pushStr(name.toStr());
        rendered.pushStr(": ");
        rendered.pushStr(modeText);
        rendered.pushStr("\n");

        overrideIndex += 1;
      }
    }

    nodeIndex += 1;
  }

  return rendered;
}

/// Scenario: a local binding takes a record's name, and a record literal of
/// that name is written after it.
/// Spec: IGN-170 — a value can never be what `Name { ... }` wants, so the
/// literal reads the name against record declarations instead.
@test
function loweringRecordLiteralReadsPastABindingOfTheSameName(): void {
  let rendered: String = loweringRender(
    "record Point {\n  public x: i32;\n}\n\nfunction main(): i32 {\n  let Point: i32 = 7;\n  let origin: Point = Point { x: 5 };\n\n  return origin.x * 10 + Point;\n}\n",
  );

  Test::assertSnapshot("lowering-record-literal-past-binding", rendered.toStr());
}

/// Scenario: `@move` and `@ref` written on the binding a closure reads.
/// Spec: IGN-170 — the override reaches the closure's own list, and a nested
/// lambda keeps its overrides out of the enclosing one.
@test
function loweringCollectsCaptureOverridesPerClosure(): void {
  let rendered: String = loweringRenderCaptureOverrides(
    "function outer(): i32 {\n  let mut x: i32 = 10;\n  let mut y: i32 = 20;\n  let taken = (): i32 -> @move x;\n  let seen = (): i32 -> @ref y;\n\n  return taken() + seen();\n}\n",
  );

  Test::assertEq<str>(rendered.toStr(), "x: ByValue\ny: ByRef\n");
}

/// Scenario: a closure with no override written inside it.
/// Spec: IGN-170 — nothing is collected, so capture analysis keeps deciding
/// the mode on its own.
@test
function loweringCollectsNoCaptureOverridesWhenNoneAreWritten(): void {
  let rendered: String = loweringRenderCaptureOverrides(
    "function outer(): i32 {\n  let x: i32 = 10;\n  let read = (): i32 -> x;\n\n  return read();\n}\n",
  );

  Test::assertEq<str>(rendered.toStr(), "");
}

/// Scenario: `@typeName<T>()` over a primitive and over a record.
/// Spec: IGN-170 — the builtin folds to the printed name of its type
/// argument rather than staying on an error node.
@test
function loweringTypeNameFoldsToThePrintedTypeName(): void {
  let rendered: String = loweringRender(
    "record Point {\n  public x: i32;\n}\n\nfunction names(): str {\n  let primitive: str = @typeName<i32>();\n  let nominal: str = @typeName<Point>();\n\n  return nominal;\n}\n",
  );

  Test::assertSnapshot("lowering-type-name-builtin", rendered.toStr());
}

@test
function loweringLetArithmeticReturn(): void {
  let rendered: String = loweringRender(
    "function main(): u32 {\n  let x: u32 = 10;\n  let y: u32 = x + 32;\n  return y;\n}\n",
  );

  Test::assertSnapshot("lowering-let-arithmetic-return", rendered.toStr());
}

/// Scenario: `Rec<T> { ... }` written with its type arguments.
/// Spec: the initializer lowers to `RecordInit` like the inferred form, so
/// the written arguments do not cost the node its lowering.
@test
function loweringGenericRecordInitWithExplicitTypeArguments(): void {
  let rendered: String = loweringRender(
    "record Box<T> {\n  public value: T;\n}\n\nfunction main(): i32 {\n  let b: Box<i32> = Box<i32> { value: 21 };\n  return b.value;\n}\n",
  );

  Test::assertSnapshot("lowering-generic-record-init-type-arguments", rendered.toStr());
}

/// Scenario: a method reached through `|>` written bare, and written with the
/// piped value placed by a `_` at either end of the argument list.
/// Spec: all three lower to the method call the source means, rather than
/// falling back to an error node the emitter cannot write C for.
@test
function loweringPipeIntoMethodShapes(): void {
  let rendered: String = loweringRender(
    "record Math {\n  public base: i32;\n\n  sub(&self, a: i32, b: i32): i32 {\n    return self.base + a - b;\n  }\n\n  add(&self, x: i32): i32 {\n    return self.base + x;\n  }\n}\n\nfunction bare(m: Math): i32 {\n  return 5 |> m.add;\n}\n\nfunction placeholderFirst(m: Math): i32 {\n  return 7 |> m.sub(_, 3);\n}\n\nfunction placeholderLast(m: Math): i32 {\n  return 7 |> m.sub(3, _);\n}\n",
  );

  Test::assertSnapshot("lowering-pipe-method-shapes", rendered.toStr());
}

/// Scenario: a pipe into a lambda written on the spot and a pipe into a local
/// holding a closure.
/// Spec: both become a call through the value, and the callee keeps the
/// binding's function type rather than the type the call returns.
@test
function loweringPipeIntoClosureValue(): void {
  let rendered: String = loweringRender(
    "function immediate(): i32 {\n  return 10 |> (x: i32): i32 -> x * 3;\n}\n\nfunction throughBinding(): i32 {\n  let f: (i32) -> i32 = (x: i32): i32 -> x + 100;\n  return 5 |> f;\n}\n",
  );

  Test::assertSnapshot("lowering-pipe-closure-value", rendered.toStr());
}

@test
function loweringIfElseBranches(): void {
  let rendered: String = loweringRender(
    "function pick(flag: boolean): u32 {\n  if (flag) {\n    return 1;\n  } else {\n    return 0;\n  }\n}\n",
  );

  Test::assertSnapshot("lowering-if-else-branches", rendered.toStr());
}

@test
function loweringWhileWithAssignment(): void {
  let rendered: String = loweringRender(
    "function count(): u32 {\n  let mut total: u32 = 0;\n  let mut i: u32 = 0;\n  while (i < 3) {\n    total = total + i;\n    i = i + 1;\n  }\n  return total;\n}\n",
  );

  Test::assertSnapshot("lowering-while-with-assignment", rendered.toStr());
}

@test
function loweringCallBetweenFunctions(): void {
  let rendered: String = loweringRender(
    "function double(value: u32): u32 {\n  return value * 2;\n}\n\nfunction main(): u32 {\n  return double(21);\n}\n",
  );

  Test::assertSnapshot("lowering-call-between-functions", rendered.toStr());
}

@test
function loweringLiteralKinds(): void {
  let rendered: String = loweringRender(
    "function literals(): boolean {\n  let a: i32 = 1;\n  let b: u64 = 2;\n  let c: f64 = 1.5;\n  let d: boolean = true;\n  let e: char = 'x';\n  let f: str = \"hi\";\n  return d;\n}\n",
  );

  Test::assertSnapshot("lowering-literal-kinds", rendered.toStr());
}

@test
function loweringUnaryAndGrouping(): void {
  let rendered: String = loweringRender(
    "function negate(value: i32): i32 {\n  let flipped: i32 = -(value + value);\n  return flipped;\n}\n",
  );

  Test::assertSnapshot("lowering-unary-and-grouping", rendered.toStr());
}

@test
function loweringSetsEntryPointForMain(): void {
  let file: SourceFile = SourceFile::create(
    "lowering_tests.ign",
    "function main(): u32 {\n  return 0;\n}\n",
  );
  let parsed: ParseOutput = Parser::parseFile(&file);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  Test::assertEq<boolean>(hir.entryPoint.isSome(), true);
  Test::assertEq<u64>(hir.items.length(), 1);
  Test::assertEq<u64>(hir.functionBodies.length(), 1);
}

/// A cast carries the resolved target type both as the `Cast` target and as
/// the node's own type, like the oracle's `resolve_type_syntax` result.
@test
function loweringCastCarriesResolvedTargetType(): void {
  let rendered: String = loweringRender(
    "function widen(value: i32): i64 {\n  let wide: i64 = value as i64;\n  return wide;\n}\n",
  );

  Test::assertSnapshot("lowering-cast", rendered.toStr());
}

/// Sibling scopes reuse `LocalId` indexes (ADR-B10), so a reference in the
/// second branch must resolve to that branch's own binding, not the stale
/// entry the first branch registered under the same index.
@test
function loweringSiblingScopeLocalIndexReuse(): void {
  let rendered: String = loweringRender(
    "function pickName(flag: boolean): u32 {\n  if (flag) {\n    let first: u32 = 1;\n    return first;\n  } else {\n    let second: u32 = 2;\n    return second;\n  }\n}\n",
  );

  Test::assertSnapshot("lowering-sibling-scope-local-index-reuse", rendered.toStr());
}

@test
function loweringMatchUnitVariantsAndWildcard(): void {
  let rendered: String = loweringRender(
    "enum Signal {\n  RED,\n  YELLOW,\n  GREEN,\n}\n\nfunction code(signal: Signal): u32 {\n  return match (signal) {\n    Signal::RED -> 0,\n    Signal::YELLOW -> 1,\n    _ -> 2,\n  };\n}\n",
  );

  Test::assertSnapshot("lowering-match-unit-variants", rendered.toStr());
}

@test
function loweringMatchBindingArmUsesItsBinding(): void {
  let rendered: String = loweringRender(
    "function twice(value: u32): u32 {\n  return match (value) {\n    other -> other * 2,\n  };\n}\n",
  );

  Test::assertSnapshot("lowering-match-binding-arm", rendered.toStr());
}

/// Sibling match arms reuse `LocalId` indexes exactly like sibling blocks
/// (ADR-B10), so each arm body — and each arm guard — must reference its own
/// arm's binding rather than the previous arm's stale entry.
@test
function loweringSiblingMatchArmBindings(): void {
  let rendered: String = loweringRender(
    "function pick(value: u32): u32 {\n  return match (value) {\n    small if small < 10 -> small,\n    large -> large * 2,\n  };\n}\n",
  );

  Test::assertSnapshot("lowering-sibling-match-arm-bindings", rendered.toStr());
}

@test
function loweringLetElseBindingUsedAfterwards(): void {
  let rendered: String = loweringRender(
    "function read(value: u32): u32 {\n  let doubled = value * 2 else {\n    return 0;\n  };\n\n  return doubled;\n}\n",
  );

  Test::assertSnapshot("lowering-let-else-binding", rendered.toStr());
}

/// `if let` lowers to the oracle's two-arm boolean `Match`. The selfhost
/// typechecker rejects let conditions outright ("unsupported: let
/// conditions"), so this fixture skips the clean-analysis assertion; no
/// expression type is recorded for the scrutinee either, which is why the
/// match arms carry the `void` sentinel.
@test
function loweringIfLetDesugarsToBooleanMatch(): void {
  let rendered: String = loweringRenderChecked(
    "enum Slot {\n  EMPTY,\n  FILLED,\n}\n\nfunction read(slot: Slot): u32 {\n  if (let Slot::FILLED = slot) {\n    return 1;\n  }\n\n  return 0;\n}\n",
    false,
  );

  Test::assertSnapshot("lowering-if-let-boolean-match", rendered.toStr());
}

/// Variant payload destructuring lowers to `HirPattern::Variant` carrying one
/// `Binding` argument, and the arm body resolves that binding: the body
/// resolver gives the payload sub-pattern a `LocalId`, which lowering maps to
/// the `Definition::Variable` it allocates for the binding site.
@test
function loweringVariantDestructureBindsPayload(): void {
  let rendered: String = loweringRender(
    "enum Shape {\n  CIRCLE(u32),\n  EMPTY,\n}\n\nfunction area(shape: Shape): u32 {\n  return match (shape) {\n    Shape::CIRCLE(radius) -> radius,\n    _ -> 0,\n  };\n}\n",
  );

  Test::assertSnapshot("lowering-variant-destructure-binds-payload", rendered.toStr());
}

/// `defer` lowers to `HirKind::Defer` carrying the deferred expression: the
/// `Expression` statement the parser wraps it in is unwrapped, so the body is
/// the call itself rather than a statement node.
@test
function loweringDeferCarriesTheDeferredExpression(): void {
  let rendered: String = loweringRender(
    "function cleanup(): void {\n  return;\n}\n\nfunction work(): u32 {\n  defer cleanup();\n  return 1;\n}\n",
  );

  Test::assertSnapshot("lowering-defer", rendered.toStr());
}

/// An instance method on a reference receiver passes the object straight
/// through: `p` is already `&Point`, so no `Reference` node is inserted.
@test
function loweringInstanceMethodCallOnReferenceReceiver(): void {
  let rendered: String = loweringRender(
    "record Point {\n  public x: u32;\n\n  public getX(&self): u32 {\n    return self.x;\n  }\n}\n\nfunction readX(p: &Point): u32 {\n  return p.getX();\n}\n",
  );

  Test::assertSnapshot("lowering-instance-method-reference-receiver", rendered.toStr());
}

/// A value receiver is wrapped in a `Reference` node, mutable exactly when
/// the method binds `&mut self`.
@test
function loweringInstanceMethodCallOnValueReceiver(): void {
  let rendered: String = loweringRender(
    "record Counter {\n  public n: u32;\n\n  public read(&self): u32 {\n    return self.n;\n  }\n\n  public bump(&mut self): u32 {\n    return self.n;\n  }\n}\n\nfunction go(): u32 {\n  let mut counter: Counter = Counter { n: 1 };\n  return counter.read() + counter.bump();\n}\n",
  );

  Test::assertSnapshot("lowering-instance-method-value-receiver", rendered.toStr());
}

/// Arguments are lowered after the receiver, in source order.
@test
function loweringInstanceMethodCallArguments(): void {
  let rendered: String = loweringRender(
    "record Adder {\n  public base: u32;\n\n  public plus(&self, left: u32, right: u32): u32 {\n    return self.base + left + right;\n  }\n}\n\nfunction go(adder: &Adder): u32 {\n  return adder.plus(1, 2);\n}\n",
  );

  Test::assertSnapshot("lowering-instance-method-arguments", rendered.toStr());
}

/// `Type::method(args)` resolves to a static `Definition::Method`, which
/// lowers to a receiver-less `MethodCall`.
@test
function loweringStaticMethodCallThroughPath(): void {
  let rendered: String = loweringRender(
    "record Adder {\n  public base: u32;\n\n  public static make(value: u32): u32 {\n    return value;\n  }\n}\n\nfunction go(): u32 {\n  return Adder::make(3);\n}\n",
  );

  Test::assertSnapshot("lowering-static-method-call", rendered.toStr());
}

/// A field read through a reference inserts the single `Dereference` the
/// oracle's auto-deref inserts before the `FieldAccess`.
@test
function loweringMemberAccessRead(): void {
  let rendered: String = loweringRender(
    "record Inner {\n  public value: u32;\n}\n\nrecord Outer {\n  public first: u32;\n  public inner: Inner;\n}\n\nfunction go(outer: &Outer): u32 {\n  return outer.inner.value + outer.first;\n}\n",
  );

  Test::assertSnapshot("lowering-member-access-read", rendered.toStr());
}

/// Postfix `!` desugars to the oracle's two-arm `Match`: the ok arm yields the
/// unwrapped payload, the err arm returns it re-wrapped. Both bindings carry
/// the variant's declared payload type.
@test
function loweringTryDesugarsToMatch(): void {
  let rendered: String = loweringRender(
    "@lang(try)\nenum Res {\n  OK(u32),\n  ERROR(u32),\n}\n\nfunction outer(input: Res): Res {\n  let unwrapped = input!;\n  return input;\n}\n",
  );

  Test::assertSnapshot("lowering-try-desugar", rendered.toStr());
}

/// A try-capable enum whose variants carry no payload takes the arity-zero
/// path: the ok arm yields `Unit` and the err arm re-wraps nothing.
@test
function loweringTryWithoutPayload(): void {
  let rendered: String = loweringRender(
    "@lang(try)\nenum Flag {\n  OK,\n  ERROR,\n}\n\nfunction outer(input: Flag): Flag {\n  let unwrapped = input!;\n  return input;\n}\n",
  );

  Test::assertSnapshot("lowering-try-without-payload", rendered.toStr());
}

/// A bare-name pipe calls the free function with the piped value alone; a
/// pipe into a call prepends it to the arguments already written.
@test
function loweringPipeIntoFreeFunction(): void {
  let rendered: String = loweringRender(
    "function double(value: i32): i32 {\n  return value * 2;\n}\n\nfunction add(left: i32, right: i32): i32 {\n  return left + right;\n}\n\nfunction go(): i32 {\n  let doubled = 21 |> double;\n  return doubled |> add(1);\n}\n",
  );

  Test::assertSnapshot("lowering-pipe-into-free-function", rendered.toStr());
}

/// A `_` placeholder puts the piped value at the position it names instead of
/// prepending it, and the placeholder node itself is never lowered.
@test
function loweringPipeWithPlaceholder(): void {
  let rendered: String = loweringRender(
    "function subtract(left: i32, right: i32): i32 {\n  return left - right;\n}\n\nfunction go(): i32 {\n  return 1 |> subtract(9, _);\n}\n",
  );

  Test::assertSnapshot("lowering-pipe-with-placeholder", rendered.toStr());
}

/// Record initializer fields are emitted in declaration order even when the
/// source writes them out of order, which is what the oracle's trailing sort
/// by field index produces.
@test
function loweringRecordInitOrdersFieldsByDeclaration(): void {
  let rendered: String = loweringRender(
    "record Point {\n  public x: u32;\n  public y: u32;\n}\n\nfunction make(): Point {\n  return Point { y: 2, x: 1 };\n}\n",
  );

  Test::assertSnapshot("lowering-record-init", rendered.toStr());
}

/// `&value` types as a reference to the operand's checked type, and `*ref`
/// takes the referent back off it.
@test
function loweringReferenceAndDereference(): void {
  let rendered: String = loweringRender(
    "function readThrough(value: u32): u32 {\n  let borrowed: &u32 = &value;\n  return *borrowed;\n}\n",
  );

  Test::assertSnapshot("lowering-reference-and-dereference", rendered.toStr());
}

/// Assigning through a `&mut` variable writes to the referent: the target is
/// wrapped in the `Dereference` the oracle inserts, both for plain and for
/// compound assignment.
@test
function loweringAssignThroughMutableReference(): void {
  let rendered: String = loweringRender(
    "function bump(counter: &mut u64): void {\n  let mut alias: &mut u64 = counter;\n  alias += 1;\n  alias = 7;\n}\n",
  );

  Test::assertSnapshot("lowering-assign-through-mut-ref", rendered.toStr());
}

/// A vector literal types as a fixed array of its first element's type, and
/// an index access takes the element type back off the base.
@test
function loweringVectorLiteralAndIndexAccess(): void {
  let rendered: String = loweringRender(
    "function first(): u32 {\n  let items: u32[3] = [1, 2, 3];\n  return items[0];\n}\n",
  );

  Test::assertSnapshot("lowering-vector-and-index", rendered.toStr());
}

/// Tuple elements lower in source order into a `TupleLiteral`.
@test
function loweringTupleLiteral(): void {
  let rendered: String = loweringRender(
    "function pair(): u32 {\n  let both = (1, 2);\n  return 0;\n}\n",
  );

  Test::assertSnapshot("lowering-tuple-literal", rendered.toStr());
}

/// `@sizeOf` and `@alignOf` carry the resolved type argument and type as
/// `u64`.
@test
function loweringBuiltinsWithTypeArguments(): void {
  let rendered: String = loweringRender(
    "function sizes(): u64 {\n  let size: u64 = @sizeOf<u32>();\n  let align: u64 = @alignOf<u32>();\n  return size + align;\n}\n",
  );

  Test::assertSnapshot("lowering-builtins-type-arguments", rendered.toStr());
}

/// The same two builtins written without the `@` prefix reach the same
/// `SizeOf` / `AlignOf` nodes through the callee name.
@test
function loweringBareBuiltinsWithTypeArguments(): void {
  let rendered: String = loweringRender(
    "function sizes(): u64 {\n  let size: u64 = sizeOf<u32>();\n  let align: u64 = alignOf<u32>();\n  return size + align;\n}\n",
  );

  Test::assertSnapshot("lowering-bare-builtins-type-arguments", rendered.toStr());
}

/// `@bitCast` reinterprets the operand's bits and lowers to `BitCast`;
/// `@pointerCast` retargets a pointer and lowers to the ordinary `Cast`.
@test
function loweringCastBuiltins(): void {
  let rendered: String = loweringRender(
    "function reinterpret(): i32 {\n  let bits: i32 = 1065353216;\n  let value: f32 = @bitCast<f32>(bits);\n  return @bitCast<i32>(value);\n}\n\nfunction recast(): i32 {\n  let mut x: i32 = 42;\n  let p: *mut i32 = (&mut x) as *mut i32;\n  let q: *mut u8 = @pointerCast<*mut u8>(p);\n  let r: *mut i32 = @pointerCast<*mut i32>(q);\n  return *r;\n}\n",
  );

  Test::assertSnapshot("lowering-cast-builtins", rendered.toStr());
}

/// `@dropGlue<T>()` carries the type whose glue is wanted and types as the
/// `(*mut u8) -> void` function pointer the allocator takes.
@test
function loweringDropGlueBuiltin(): void {
  let rendered: String = loweringRender(
    "function glue(): (*mut u8) -> void {\n  return @dropGlue<u32>();\n}\n",
  );

  Test::assertSnapshot("lowering-drop-glue-builtin", rendered.toStr());
}

/// `@panic` lowers its message operand; `@trap` and `@unreachable` carry
/// nothing. All three type as `never`.
@test
function loweringDivergingBuiltins(): void {
  let rendered: String = loweringRender(
    "function boom(): void {\n  @panic(\"boom\");\n}\n\nfunction halt(): void {\n  @trap();\n}\n\nfunction nope(): void {\n  @unreachable();\n}\n",
  );

  Test::assertSnapshot("lowering-diverging-builtins", rendered.toStr());
}

/// A builtin the typechecker rejects as unsupported has no checked operand or
/// result type to lower against, so it stays on the `Error` fallback even
/// though `HirKind::MaxOf` exists.
@test
function loweringMaxOfBuiltinLowersToMaxOf(): void {
  let rendered: String = loweringRenderChecked(
    "function limit(): u32 {\n  return @maxOf<u32>();\n}\n",
    false,
  );

  Test::assertSnapshot("lowering-maxof-builtin", rendered.toStr());
}

/// `for ... of` over a fixed array desugars into the oracle's index loop:
/// `let __for_of_i = 0`, `__for_of_i < <length>`, `__for_of_i += 1`, and a
/// body that binds the element read out of the array.
@test
function loweringForOfFixedArrayDesugarsToIndexLoop(): void {
  let rendered: String = loweringRender(
    "function total(): u32 {\n  let items: u32[3] = [1, 2, 3];\n  let mut sum: u32 = 0;\n  for (let item of items) {\n    sum += item;\n  }\n\n  return sum;\n}\n",
  );

  Test::assertSnapshot("lowering-for-of-fixed-array", rendered.toStr());
}

/// A `&mut` annotation on the loop pattern binds the element's address, so
/// the body writes through the array instead of through a copy.
@test
function loweringForOfMutableReferenceBindsElementAddress(): void {
  let rendered: String = loweringRender(
    "function bump(): u32 {\n  let mut items: u32[2] = [1, 2];\n  for (let item: &mut u32 of items) {\n    *item = *item + 1;\n  }\n\n  return items[0];\n}\n",
  );

  Test::assertSnapshot("lowering-for-of-mut-ref", rendered.toStr());
}

/// A record with `data: *mut i32` and `length: u64` iterates through the
/// iterable-record protocol: both fields are read once into locals ahead of
/// the loop, which then indexes the data pointer.
@test
function loweringForOfIterableRecordHoistsDataAndLength(): void {
  let rendered: String = loweringRender(
    "record IntVector {\n  public data: *mut i32;\n  public length: u64;\n}\n\nfunction total(vector: IntVector): i32 {\n  let mut sum: i32 = 0;\n  for (let item of vector) {\n    sum += item;\n  }\n\n  return sum;\n}\n",
  );

  Test::assertSnapshot("lowering-for-of-iterable-record", rendered.toStr());
}

/// The typechecker also accepts a slice as an iterable, but the oracle's
/// desugar covers fixed arrays and iterable records only, so a slice pins the
/// whole statement on the `Error` fallback.
@test
function loweringForOfOverSliceFallsBackToError(): void {
  let rendered: String = loweringRender(
    "function total(items: i32[]): i32 {\n  let mut sum: i32 = 0;\n  for (let item of items) {\n    sum += item;\n  }\n\n  return sum;\n}\n",
  );

  Test::assertSnapshot("lowering-for-of-error", rendered.toStr());
}

/// Record and enum method bodies are registered exactly like free function
/// bodies (`functionBodies` plus `items`). The HIR display prints only
/// `Definition::Function` entries — mirroring the Rust printer — so a method
/// body shows up through the locals it declares.
@test
function loweringMethodBodiesAreRegistered(): void {
  let file: SourceFile = SourceFile::create(
    "lowering_tests.ign",
    "record Counter {\n  public n: u32;\n\n  public read(&self): u32 {\n    let current: u32 = self.n;\n    return current;\n  }\n\n  public static one(): u32 {\n    let unit: u32 = 1;\n    return unit;\n  }\n}\n\nfunction go(): u32 {\n  return 1;\n}\n",
  );
  let parsed: ParseOutput = Parser::parseFile(&file);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(loweringCountErrors(&output.diagnostics), 0);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  Test::assertEq<u64>(hir.functionBodies.length(), 3);
  Test::assertEq<u64>(hir.items.length(), 3);

  let rendered: String = Hir::Display::printHir(&hir, &typeStore, &defStore, &symbols);

  Test::assertSnapshot("lowering-method-bodies", rendered.toStr());
}

/// A placeholder nested deeper than a direct argument of the right-side call
/// has no placement rule, so the whole pipe stays on `Error` and the escaped
/// placeholder node lowers to its own `Error`.
@test
function loweringPipeWithNestedPlaceholder(): void {
  let rendered: String = loweringRenderChecked(
    "function double(value: u32): u32 {\n  return value * 2;\n}\n\nfunction add(left: u32, right: u32): u32 {\n  return left + right;\n}\n\nfunction go(): u32 {\n  return 1 |> add(2, double(_));\n}\n",
    false,
  );

  Test::assertSnapshot("lowering-pipe-nested-placeholder", rendered.toStr());
}

/// A pipe whose right side is not a function definition has no callee to
/// build a `Call` around.
@test
function loweringPipeIntoNonFunctionFallsBackToError(): void {
  let rendered: String = loweringRenderChecked(
    "function go(): u32 {\n  let target: u32 = 2;\n  return 1 |> target;\n}\n",
    false,
  );

  Test::assertSnapshot("lowering-pipe-non-function-error", rendered.toStr());
}

/// Explicit type arguments on a call resolve through the typechecker's
/// annotation probe and land in the `Call` node's `typeArgs`.
@test
function loweringCallWithExplicitTypeArguments(): void {
  let rendered: String = loweringRenderChecked(
    "function identity<T>(value: T): T {\n  return value;\n}\n\nfunction go(): u32 {\n  return identity<u32>(1);\n}\n",
    false,
  );

  Test::assertSnapshot("lowering-call-type-arguments", rendered.toStr());
}

/// `Enum::Variant(args)` lowers to `EnumVariant` with the arguments as its
/// payload, and a bare unit variant to the same node with an empty payload.
/// Spec: IGN-127 — variant construction.
@test
function loweringEnumVariantConstruction(): void {
  let rendered: String = loweringRender(
    "enum Shape {\n  CIRCLE(u32),\n  EMPTY,\n}\n\nfunction make(): Shape {\n  return Shape::CIRCLE(1);\n}\n\nfunction empty(): Shape {\n  return Shape::EMPTY;\n}\n",
  );

  Test::assertSnapshot("lowering-enum-variant-construction", rendered.toStr());
}

/// `i++` and `i--` lower to a compound assignment of one, so a C-style `for`
/// header reaches HIR as an ordinary counted loop.
/// Spec: IGN-172 — postfix step operators.
@test
function loweringPostfixStepIsCompoundAssignment(): void {
  let rendered: String = loweringRender(
    "function count(): i32 {\n  let mut total: i32 = 0;\n  for (let i = 0; i < 3; i++) {\n    total = total + i;\n  }\n  for (let j = 3; j > 0; j--) {\n    total = total + j;\n  }\n  return total;\n}\n",
  );

  Test::assertSnapshot("lowering-postfix-step", rendered.toStr());
}

/// An atom literal lowers to `Literal(Atom(...))` with the same interned
/// symbol at every occurrence, in expression and in pattern position.
/// Spec: IGN-172 — atom literals.
@test
function loweringAtomLiteralsInternOnce(): void {
  let rendered: String = loweringRender(
    "function main(): i32 {\n  let a: atom = :ok;\n  return match (a) {\n    :ok -> 1,\n    _ -> 0,\n  };\n}\n",
  );

  Test::assertSnapshot("lowering-atom-literal", rendered.toStr());
}

/// The annotated `let ... else` shorthand lowers to a `LetElse` whose pattern
/// destructures the scrutinee's ok variant into the written binding, rather
/// than matching the binding against the try enum itself.
@test
function loweringLetElseShorthandUnwrapsTheOkVariant(): void {
  let rendered: String = loweringRender(
    "@lang(try)\nenum Res<T, E> {\n  OK(T),\n  ERROR(E),\n}\n\nfunction parse(ok: boolean): Res<u32, u32> {\n  if (ok) {\n    return Res::OK(7);\n  }\n\n  return Res::ERROR(1);\n}\n\nfunction go(): u32 {\n  let value: u32 = parse(true) else {\n    return 0;\n  };\n\n  return value;\n}\n",
  );

  Test::assertSnapshot("lowering-let-else-shorthand", rendered.toStr());
}

/// The source every inherited trait default test below lowers.
function loweringTraitDefaultSource(): str {
  return "trait HasValue {\n  getValue(&self): i32;\n\n  doubled(&self): i32 {\n    return self.getValue() * 2;\n  }\n}\n\n@implements(HasValue)\nrecord Box {\n  public value: i32;\n\n  getValue(&self): i32 {\n    return self.value;\n  }\n}\n\nfunction main(): i32 {\n  let b: Box = Box { value: 21 };\n  return b.doubled();\n}\n";
}

/// The definition of the method named `methodName` that a record owns.
function loweringRecordOwnedMethod(
  defStore: &Analyzer::DefinitionStore,
  symbols: &Analyzer::SymbolTable,
  methodName: str,
): Option<Analyzer::DefinitionId> {
  let mut index: u64 = 0;

  while (index < defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);

    if (let Option::SOME(definition) = defStore.get(defId)) {
      if (let Analyzer::Definition::Method(method) = definition) {
        if (let Option::SOME(name) = symbols.resolve(method.name)) {
          if (name.equals(methodName)) {
            if (let Option::SOME(owner) = defStore.get(method.owner)) {
              if (let Analyzer::Definition::Record(_) = owner) {
                return Option::SOME(defId);
              }
            }
          }
        }
      }
    }

    index += 1;
  }

  return Option::NONE;
}

/// A record that inherits a trait default gets a lowered body for it, so the
/// emitter has a function to write instead of a call into nothing.
/// Spec: parity fixture e2e_ok::trait_default_method_uses_self.
@test
function loweringInheritedTraitDefaultHasABody(): void {
  let file: SourceFile = SourceFile::create("lowering_tests.ign", loweringTraitDefaultSource());
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(loweringCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(loweringCountErrors(&output.diagnostics), 0);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let Option::SOME(inherited) = loweringRecordOwnedMethod(&defStore, &symbols, "doubled") else {
    @panic("loweringInheritedTraitDefaultHasABody: the record owns no `doubled` method");
  };

  Test::assert(hir.functionBodies.get(inherited).isSome());
}

/// The call to an inherited trait default lowers to a method call on the
/// record, rather than to the error node an unknown method would produce.
/// Spec: parity fixture e2e_ok::trait_default_method_uses_self.
@test
function loweringInheritedTraitDefaultBody(): void {
  let rendered: String = loweringRender(loweringTraitDefaultSource());

  Test::assertSnapshot("lowering-trait-default-inherited", rendered.toStr());
}

/// A static field's value lowers once, so a use written `Record::NAME` reads
/// the value rather than a name the emitter has no definition for.
/// Spec: parity fixture e2e_ok::record_static_field.
@test
function loweringRecordStaticFieldValue(): void {
  let rendered: String = loweringRender(
    "record Config {\n  static MAX_SIZE: i32 = 1024;\n}\n\nfunction main(): i32 {\n  return Config::MAX_SIZE;\n}\n",
  );

  Test::assertSnapshot("lowering-record-static-field", rendered.toStr());
}

/// An enum static field lowers the same way, alongside the variants it is
/// written among.
/// Spec: parity fixture e2e_ok::enum_static_field.
@test
function loweringEnumStaticFieldValue(): void {
  let rendered: String = loweringRender(
    "enum Priority {\n  Low,\n  High,\n\n  DEFAULT_LEVEL: i32 = 1;\n}\n\nfunction main(): i32 {\n  return Priority::DEFAULT_LEVEL;\n}\n",
  );

  Test::assertSnapshot("lowering-enum-static-field", rendered.toStr());
}

/// Scenario: a module-level constant of function type called directly.
/// The callee is a value, not a declaration, so the call lowers to
/// `CallClosure` and the constant's lambda carries a thunk.
@test
function loweringCallThroughAFunctionTypedConstant(): void {
  let rendered: String = loweringRender(
    "const add: (i32, i32) -> i32 = (a: i32, b: i32): i32 -> a + b;\n\nfunction main(): i32 {\n  return add(2, 3);\n}\n",
  );

  Test::assertSnapshot("lowering-call-through-function-typed-constant", rendered.toStr());
}
