@test
function r27ConstFoldI32NegateWrapsAtMinimum(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  // Declared first: constants fold in declaration order, so `K` reads `M`.
  let minTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let minusMaxExpr: Ast::ExpressionId = constEvalAddUnary(
    &mut module,
    Ast::Expression::UnaryOperator::Negate,
    constEvalAddIntLiteral(&mut module, 2147483647),
  );
  let minusOneExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 1);
  let minExpr: Ast::ExpressionId = constEvalAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Subtract,
    minusMaxExpr,
    minusOneExpr,
  );
  let minItemId: Ast::ItemId = constEvalAddConstant(&mut module, "M", minTypeId, minExpr);

  let i32TypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let minRefExpr: Ast::ExpressionId = constEvalAddVariable(&mut module, "M");
  let valueExpr: Ast::ExpressionId = constEvalAddUnary(
    &mut module,
    Ast::Expression::UnaryOperator::Negate,
    minRefExpr,
  );
  let itemId: Ast::ItemId = constEvalAddConstant(&mut module, "K", i32TypeId, valueExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, minItemId, -2147483648);
  assertConstInt(&mut output, itemId, -2147483648);
}
