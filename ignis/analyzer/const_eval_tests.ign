@test
function constEvalAddressOfConstantStaticIsAccepted(): void {
  let output: Analyzer::AnalyzerOutput = constEvalAnalyzeSource(
    `record Table {
  static ROWS: u8[4] = [1, 2, 3, 4];
}

function main(): i32 {
  let p: *u8 = &Table::ROWS as *u8;
  return *(p + 1) as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(constEvalCountErrors(&output.diagnostics), 0);
}

@test
function constEvalZeroableStaticMutAndStaticAddressCheckCoexist(): void {
  // One record exercises both merged features at once: a `static mut` field
  // without an initializer folds to a zero part (the upstream zeroable rule,
  // which would report A0239 for a non-zeroable type), while the immutable
  // static whose initializer does not fold must report the distinct static
  // address code A0245, never A0239.
  let output: Analyzer::AnalyzerOutput = constEvalAnalyzeSource(
    `record Table {
  static mut COUNTER: u32;
  static VALUE: u64 = base();
}

function base(): u64 {
  return 7;
}

function main(): i32 {
  let p: *u64 = &Table::VALUE as *u64;
  return Table::COUNTER as i32 + *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(constEvalCountErrors(&output.diagnostics), 1);
  Test::assertEq<str>(constEvalFirstErrorCode(&output), "A0245");
}

