}

function base(): u64 {
  return 7;
}

function main(): i32 {
  let p: *u64 = &Table::CELL.value as *u64;
  return *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(constEvalCountErrors(&output.diagnostics), 1);
  Test::assertEq<str>(constEvalFirstErrorCode(&output), "A0245");
}

/// Indexing through a pointer-valued static addresses the pointee, not the
/// static's own storage, so it is not an address of the static even when the
/// static's initializer did not fold.
@test
function constEvalAddressThroughPointerValuedStaticIsAccepted(): void {
  let output: Analyzer::AnalyzerOutput = constEvalAnalyzeSource(
    `const OTHER: u64 = 5;

record Table {
  static SLOT: *u64 = &OTHER as *u64;
}

function main(): i32 {
  let p: *u64 = &Table::SLOT[0] as *u64;
  return *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(constEvalCountErrors(&output.diagnostics), 0);
}

// ===========================================================================
// Cross-module addresses through the program path
// ===========================================================================

function constEvalParseModule(fileName: str, source: str): Ast::Module {
  let file: SourceFile = SourceFile::create(fileName, source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(constEvalCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(constEvalCountErrors(&parsed.parseDiagnostics), 0);

  return parsed.module;
}

function constEvalModuleInfo(index: u64, path: str): Analyzer::Imports::ModuleInfo {
  return Analyzer::Imports::ModuleInfo {
    index: index,
    pathText: String::create(path),
    kind: Analyzer::Imports::ModuleKind::PROJECT,
  };
}

function constEvalAnalyzeProgram(
  definitionSource: str,
  consumerSource: str
): Vector<Analyzer::ModuleAnalysisRecord> {
  let definitions: Ast::Module = constEvalParseModule("a.ign", definitionSource);
  let consumer: Ast::Module = constEvalParseModule("b.ign", consumerSource);

  let mut modules: Vector<Ast::Module> = Vector::new<Ast::Module>();
  modules.push(definitions);
  modules.push(consumer);

  let mut infos: Vector<Analyzer::Imports::ModuleInfo> = Vector::new<Analyzer::Imports::ModuleInfo>();
  infos.push(constEvalModuleInfo(0, "a.ign"));
  infos.push(constEvalModuleInfo(1, "b.ign"));

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let noPrelude: Vector<String> = Vector::new<String>();

  return Analyzer::analyzeProgram(&mut defStore, &mut typeStore, &mut symbols, &modules, &infos, &noPrelude);
}

// One module's diagnostics summary, for program-path assertions.
record ConstEvalDiagnosticsSummary {
  count: u64;
  code: str;
}

function constEvalRecordFirstErrorCountAndCode(
  moduleRecord: &Analyzer::ModuleAnalysisRecord
): ConstEvalDiagnosticsSummary {
  let mut count: u64 = 0;
  let mut code: str = "";
  let mut index: u64 = 0;

  while (index < moduleRecord.output.diagnostics.length()) {
    let Option::SOME(diagnostic) = moduleRecord.output.diagnostics.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      if (count == 0) {
        code = diagnostic.code;
      }

      count += 1;
    }

    index += 1;
  }

  return ConstEvalDiagnosticsSummary { count: count, code: code };
}

@test
function constEvalProgramAddressOfImportedDynamicConstantIsRejected(): void {
  let records: Vector<Analyzer::ModuleAnalysisRecord> = constEvalAnalyzeProgram(
    `export function base(): u64 {
  return 7;
}

export const K: u64 = base();
`.toStr(),
    `import K from "a.ign";

function main(): i32 {
  let p: *u64 = &K as *u64;
  return *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(records.length(), 2);

  let Option::SOME(definitions) = records.get(0) else {
    Test::fail();
    return;
  };
  let definitionSummary: ConstEvalDiagnosticsSummary = constEvalRecordFirstErrorCountAndCode(&definitions);
  Test::assertEq<u64>(definitionSummary.count, 0);

  let Option::SOME(consumer) = records.get(1) else {
    Test::fail();
    return;
  };
  let consumerSummary: ConstEvalDiagnosticsSummary = constEvalRecordFirstErrorCountAndCode(&consumer);
  Test::assertEq<u64>(consumerSummary.count, 1);
  Test::assertEq<str>(consumerSummary.code, "A0245");
}

