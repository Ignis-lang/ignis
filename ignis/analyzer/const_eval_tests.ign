@test
function constEvalBinaryArithmeticFolds(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let twoExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 2);
  let threeExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 3);
  let sumExpr: Ast::ExpressionId = constEvalAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Add,
    twoExpr,
    threeExpr,
  );
  let groupedSum: Ast::ExpressionId = constEvalAddGrouped(&mut module, sumExpr);
  let fourExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 4);
  let valueExpr: Ast::ExpressionId = constEvalAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Multiply,
    groupedSum,
    fourExpr,
  );
  let itemId: Ast::ItemId = constEvalAddConstant(&mut module, "K", i32TypeId, valueExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, itemId, 20);
}

@test
function constEvalSignedOverflowIsNotConst(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let maxTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i64");
  let maxLiteral: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 9223372036854775807);
  let maxItemId: Ast::ItemId = constEvalAddConstant(&mut module, "M", maxTypeId, maxLiteral);

  let oneTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i64");
  let oneLiteral: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 1);
  let oneItemId: Ast::ItemId = constEvalAddConstant(&mut module, "ONE", oneTypeId, oneLiteral);

  let sumTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i64");
  let maxRef: Ast::ExpressionId = constEvalAddVariable(&mut module, "M");
  let oneRef: Ast::ExpressionId = constEvalAddVariable(&mut module, "ONE");
  let valueExpr: Ast::ExpressionId = constEvalAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Add,
    maxRef,
    oneRef,
  );
  let itemId: Ast::ItemId = constEvalAddConstant(&mut module, "K", sumTypeId, valueExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, maxItemId, 9223372036854775807);
  assertConstInt(&mut output, oneItemId, 1);
  assertNotConst(&mut output, itemId);
}

