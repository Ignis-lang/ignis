  return *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(records.length(), 2);

  let Option::SOME(definitions) = records.get(0) else {
    Test::fail();
    return;
  };
  let definitionSummary: ConstEvalDiagnosticsSummary = constEvalRecordFirstErrorCountAndCode(&definitions);
  Test::assertEq<u64>(definitionSummary.count, 0);

  let Option::SOME(consumer) = records.get(1) else {
    Test::fail();
    return;
  };
  let consumerSummary: ConstEvalDiagnosticsSummary = constEvalRecordFirstErrorCountAndCode(&consumer);
  Test::assertEq<u64>(consumerSummary.count, 1);
  Test::assertEq<str>(consumerSummary.code, "A0245");
}

/// A cross-module constant that folds has a read-only global in its defining
/// module, so its address stays accepted in the importer.
@test
function constEvalProgramAddressOfImportedFoldingConstantIsAccepted(): void {
  let records: Vector<Analyzer::ModuleAnalysisRecord> = constEvalAnalyzeProgram(
    `export const K: u64 = 5;
`.toStr(),
    `import K from "a.ign";

function main(): i32 {
  let p: *u64 = &K as *u64;
  return *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(records.length(), 2);

  let mut index: u64 = 0;

  while (index < records.length()) {
    let Option::SOME(moduleRecord) = records.get(index) else {
      index += 1;
      continue;
    };

    let summary: ConstEvalDiagnosticsSummary = constEvalRecordFirstErrorCountAndCode(&moduleRecord);
    Test::assertEq<u64>(summary.count, 0);
    index += 1;
  }
}

// =========================================================================
// R27: width-based wrapping constants and masked shift counts
// =========================================================================

@test
function r27ConstFoldI32ShiftLeftWrapsToMinimum(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let oneExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 1);
  let amountExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 31);
  let valueExpr: Ast::ExpressionId = constEvalAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::ShiftLeft,
    oneExpr,
    amountExpr,
  );
  let itemId: Ast::ItemId = constEvalAddConstant(&mut module, "K", i32TypeId, valueExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, itemId, -2147483648);
}

