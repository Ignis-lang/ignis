import Test from "std::test";

import DiagnosticBag, Severity, SourceFile, SourceSpan from "@compiler::diagnostics";
import Ast from "@compiler::ast";
import Analyzer from "@compiler::analyzer";
import ParseOutput, Parser from "@compiler::parser";

function constEvalDummySpan(): SourceSpan {
  return SourceSpan::new("const_eval_tests.ign", 0, 0);
}

function constEvalAddPathType(module: &mut Ast::Module, name: str): Ast::TypeId {
  let mut segments: Vector<String> = Vector::new<String>();
  segments.push(String::create(name));
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addType(Ast::Type::Node::Path(Ast::Type::Path {
    span: constEvalDummySpan(),
    segments: segments,
  }));
}

function constEvalAddIntLiteral(module: &mut Ast::Module, value: i64): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: constEvalDummySpan(),
    value: Ast::Expression::LiteralValue::Int(value),
  }));
}

function constEvalAddUintLiteral(module: &mut Ast::Module, value: u64): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: constEvalDummySpan(),
    value: Ast::Expression::LiteralValue::UInt(value),
  }));
}

function constEvalAddFloatLiteral(module: &mut Ast::Module, value: f64): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: constEvalDummySpan(),
    value: Ast::Expression::LiteralValue::Float(value),
  }));
}

function constEvalAddBoolLiteral(module: &mut Ast::Module, value: boolean): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: constEvalDummySpan(),
    value: Ast::Expression::LiteralValue::Boolean(value),
  }));
}

function constEvalAddStringLiteral(module: &mut Ast::Module, value: str): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: constEvalDummySpan(),
    value: Ast::Expression::LiteralValue::String(String::create(value)),
  }));
}

function constEvalAddCharLiteral(module: &mut Ast::Module, value: char): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Literal(Ast::Expression::Literal {
    span: constEvalDummySpan(),
    value: Ast::Expression::LiteralValue::Character(value),
  }));
}

function constEvalAddVariable(module: &mut Ast::Module, name: str): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Variable(Ast::Expression::Variable {
    span: constEvalDummySpan(),
    name: String::create(name),
  }));
}

function constEvalAddBinary(
  module: &mut Ast::Module,
  operator: Ast::Expression::BinaryOperator,
  left: Ast::ExpressionId,
  right: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Binary(Ast::Expression::Binary {
    span: constEvalDummySpan(),
    operator: operator,
    left: left,
    right: right,
  }));
}

function constEvalAddUnary(
  module: &mut Ast::Module,
  operator: Ast::Expression::UnaryOperator,
  operand: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Unary(Ast::Expression::Unary {
    span: constEvalDummySpan(),
    operator: operator,
    operand: operand,
  }));
}

function constEvalAddTernary(
  module: &mut Ast::Module,
  condition: Ast::ExpressionId,
  thenBranch: Ast::ExpressionId,
  elseBranch: Ast::ExpressionId,
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Ternary(Ast::Expression::Ternary {
    span: constEvalDummySpan(),
    condition: condition,
    thenBranch: thenBranch,
    elseBranch: elseBranch,
  }));
}

function constEvalAddGrouped(
  module: &mut Ast::Module,
  expression: Ast::ExpressionId
): Ast::ExpressionId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addExpression(Ast::Expression::Node::Grouped(Ast::Expression::Grouped {
    span: constEvalDummySpan(),
    expression: expression,
  }));
}

function constEvalAddConstant(
  module: &mut Ast::Module,
  name: str,
  annotation: Ast::TypeId,
  value: Ast::ExpressionId,
): Ast::ItemId {
  let mut moduleRef: &mut Ast::Module = module;
  return moduleRef.addRootItem(Ast::Item::Node::Constant(Ast::Item::Constant {
    span: constEvalDummySpan(),
    name: String::create(name),
    annotation: Option::SOME(annotation),
    value: value,
    metadata: Ast::emptyMetadata(),
  }));
}

function constEvalAnalyzeModule(
  defStore: &mut Analyzer::DefinitionStore,
  typeStore: &mut Analyzer::TypeStore,
  symbols: &mut Analyzer::SymbolTable,
  module: &Ast::Module,
): Analyzer::AnalyzerOutput {
  return Analyzer::analyzeModule(defStore, typeStore, symbols, module);
}

/// Evaluated value for the constant declared by `itemId`, or NONE when the
/// phase left it not-const.
function constEvalValueFor(
  output: &mut Analyzer::AnalyzerOutput,
  itemId: Ast::ItemId,
): Option<Analyzer::ConstEval::ConstValue> {
  let Option::SOME(defId) = Analyzer::Binder::findDef(&output.pass2, itemId.raw()) else {
    @panic("constEvalValueFor: constant item has no bound definition");
  };

  let mut outputRef: &mut Analyzer::AnalyzerOutput = output;
  return Analyzer::ConstEval::findConstValue(&mut outputRef.constValues.values, defId.raw());
}

function assertConstInt(
  output: &mut Analyzer::AnalyzerOutput,
  itemId: Ast::ItemId,
  expected: i64
): void {
  let Option::SOME(value) = constEvalValueFor(output, itemId) else {
    @panic("assertConstInt: constant has no evaluated value");
  };

  match (value) {
    Analyzer::ConstEval::ConstValue::Int(actual) -> Test::assertEq<i64>(actual, expected),
    _ -> @panic("assertConstInt: value is not Int"),
  };
}

function assertConstFloat(
  output: &mut Analyzer::AnalyzerOutput,
  itemId: Ast::ItemId,
  expected: f64
): void {
  let Option::SOME(value) = constEvalValueFor(output, itemId) else {
    @panic("assertConstFloat: constant has no evaluated value");
  };

  match (value) {
    Analyzer::ConstEval::ConstValue::Float(actual) -> {
      if (actual != expected) {
        @panic("assertConstFloat: value mismatch");
      }
    },
    _ -> @panic("assertConstFloat: value is not Float"),
  };
}

function assertConstBool(
  output: &mut Analyzer::AnalyzerOutput,
  itemId: Ast::ItemId,
  expected: boolean
): void {
  let Option::SOME(value) = constEvalValueFor(output, itemId) else {
    @panic("assertConstBool: constant has no evaluated value");
  };

  match (value) {
    Analyzer::ConstEval::ConstValue::Bool(actual) -> Test::assertEq<boolean>(actual, expected),
    _ -> @panic("assertConstBool: value is not Bool"),
  };
}

function assertConstStr(
  output: &mut Analyzer::AnalyzerOutput,
  itemId: Ast::ItemId,
  expected: str
): void {
  let Option::SOME(value) = constEvalValueFor(output, itemId) else {
    @panic("assertConstStr: constant has no evaluated value");
  };

  match (value) {
    Analyzer::ConstEval::ConstValue::Str(actual) -> Test::assertEq<str>(actual.toStr(), expected),
    _ -> @panic("assertConstStr: value is not Str"),
  };
}

function assertConstChar(
  output: &mut Analyzer::AnalyzerOutput,
  itemId: Ast::ItemId,
  expected: char
): void {
  let Option::SOME(value) = constEvalValueFor(output, itemId) else {
    @panic("assertConstChar: constant has no evaluated value");
  };

  match (value) {
    Analyzer::ConstEval::ConstValue::Char(actual) -> Test::assertEq<char>(actual, expected),
    _ -> @panic("assertConstChar: value is not Char"),
  };
}

function assertNotConst(output: &mut Analyzer::AnalyzerOutput, itemId: Ast::ItemId): void {
  if (constEvalValueFor(output, itemId).isSome()) {
    @panic("assertNotConst: constant unexpectedly has an evaluated value");
  }
}

function constEvalCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

function constEvalFirstErrorCode(output: &Analyzer::AnalyzerOutput): str {
  let mut index: u64 = 0;

  while (index < output.diagnostics.length()) {
    let Option::SOME(diagnostic) = output.diagnostics.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      return diagnostic.code;
    }

    index += 1;
  }

  return "";
}

/// Parses and analyzes `source` through the full analyzer, the way a user
/// module goes through it, so diagnostics from every phase are visible.
function constEvalAnalyzeSource(source: str): Analyzer::AnalyzerOutput {
  let file: SourceFile = SourceFile::create("const_eval_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(constEvalCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(constEvalCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  return Analyzer::analyzeModule(&mut defStore, &mut typeStore, &mut symbols, &parsed.module);
}

@test
function constEvalIntLiteral(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let valueExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 7);
  let itemId: Ast::ItemId = constEvalAddConstant(&mut module, "K", i32TypeId, valueExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, itemId, 7);
}

