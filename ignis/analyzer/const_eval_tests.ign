// ===========================================================================
// Address place wrappers: grouped and subobject places name the same storage
// ===========================================================================

/// A grouped place is rejected by the typechecker's lvalue rule (A0029), so
/// no valid shared reference reaches the const-eval descent through a
/// grouping. The descent still runs on the invalid program and adds its own
/// A0245; this pins the two-diagnostic outcome.
@test
function constEvalAddressOfGroupedPlaceIsRejectedAsNonLvalue(): void {
  let output: Analyzer::AnalyzerOutput = constEvalAnalyzeSource(
    `record Table {
  static VALUE: u64 = base();
}

function base(): u64 {
  return 7;
}

function main(): i32 {
  let p: *u64 = &(Table::VALUE) as *u64;
  return *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(constEvalCountErrors(&output.diagnostics), 2);
  Test::assertEq<str>(constEvalFirstErrorCode(&output), "A0029");
}

@test
function constEvalAddressOfNonConstantStaticElementIsRejected(): void {
  let output: Analyzer::AnalyzerOutput = constEvalAnalyzeSource(
    `record Table {
  static ROWS: u64[4] = [base(), base(), base(), base()];
}

function base(): u64 {
  return 7;
}

function main(): i32 {
  let p: *u64 = &Table::ROWS[1] as *u64;
  return *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(constEvalCountErrors(&output.diagnostics), 1);
  Test::assertEq<str>(constEvalFirstErrorCode(&output), "A0245");
}

@test
function constEvalAddressOfNonConstantStaticFieldIsRejected(): void {
  let output: Analyzer::AnalyzerOutput = constEvalAnalyzeSource(
    `record Cell {
  value: u64;
}

record Table {
