@test
function constEvalUnsignedDivisionUsesUnsignedSemantics(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let bigTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "u64");
  let bigLiteral: Ast::ExpressionId = constEvalAddUintLiteral(&mut module, 18446744073709551615);
  let bigItemId: Ast::ItemId = constEvalAddConstant(&mut module, "BIG", bigTypeId, bigLiteral);

  let twoTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "u64");
  let twoLiteral: Ast::ExpressionId = constEvalAddUintLiteral(&mut module, 2);
  let twoItemId: Ast::ItemId = constEvalAddConstant(&mut module, "TWO", twoTypeId, twoLiteral);

  let quotientTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "u64");
  let bigRef: Ast::ExpressionId = constEvalAddVariable(&mut module, "BIG");
  let twoRef: Ast::ExpressionId = constEvalAddVariable(&mut module, "TWO");
  let valueExpr: Ast::ExpressionId = constEvalAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Divide,
    bigRef,
    twoRef,
  );
  let itemId: Ast::ItemId = constEvalAddConstant(&mut module, "K", quotientTypeId, valueExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, itemId, 9223372036854775807);
}

@test
function constEvalTernaryWithConstConditionFolds(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let conditionExpr: Ast::ExpressionId = constEvalAddBoolLiteral(&mut module, true);
  let oneExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 1);
  let twoExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 2);
  let valueExpr: Ast::ExpressionId = constEvalAddTernary(&mut module, conditionExpr, oneExpr, twoExpr);
  let itemId: Ast::ItemId = constEvalAddConstant(&mut module, "K", i32TypeId, valueExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, itemId, 1);
}

@test
function constEvalReferenceToEarlierConstantFolds(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let twoExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 2);
  let firstItemId: Ast::ItemId = constEvalAddConstant(&mut module, "A", i32TypeId, twoExpr);

  let secondTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let referenceExpr: Ast::ExpressionId = constEvalAddVariable(&mut module, "A");
  let threeExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 3);
  let sumExpr: Ast::ExpressionId = constEvalAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Add,
    referenceExpr,
    threeExpr,
  );
  let secondItemId: Ast::ItemId = constEvalAddConstant(&mut module, "B", secondTypeId, sumExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, firstItemId, 2);
  assertConstInt(&mut output, secondItemId, 5);
}

@test
function constEvalReferenceToLaterConstantIsNotConst(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let firstTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let referenceExpr: Ast::ExpressionId = constEvalAddVariable(&mut module, "A");
  let threeExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 3);
  let sumExpr: Ast::ExpressionId = constEvalAddBinary(
    &mut module,
    Ast::Expression::BinaryOperator::Add,
    referenceExpr,
    threeExpr,
  );
  let firstItemId: Ast::ItemId = constEvalAddConstant(&mut module, "B", firstTypeId, sumExpr);

  let secondTypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let twoExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 2);
  let secondItemId: Ast::ItemId = constEvalAddConstant(&mut module, "A", secondTypeId, twoExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertNotConst(&mut output, firstItemId);
  assertConstInt(&mut output, secondItemId, 2);
}

@test
function constEvalGroupedLiteralFolds(): void {
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut module: Ast::Module = Ast::Module::init();

  let i32TypeId: Ast::TypeId = constEvalAddPathType(&mut module, "i32");
  let fiveExpr: Ast::ExpressionId = constEvalAddIntLiteral(&mut module, 5);
  let valueExpr: Ast::ExpressionId = constEvalAddGrouped(&mut module, fiveExpr);
  let itemId: Ast::ItemId = constEvalAddConstant(&mut module, "K", i32TypeId, valueExpr);

  let mut output: Analyzer::AnalyzerOutput = constEvalAnalyzeModule(&mut defStore, &mut typeStore, &mut symbols, &module);

  Test::assertEq<u64>(output.diagnostics.length(), 0);
  assertConstInt(&mut output, itemId, 5);
}
