// ===========================================================================
// Address of an immutable static or constant with a nonconstant initializer
// ===========================================================================

@test
function constEvalAddressOfNonConstantStaticIsRejected(): void {
  let output: Analyzer::AnalyzerOutput = constEvalAnalyzeSource(
    `record Table {
  static VALUE: u64 = base();
}

function base(): u64 {
  return 7;
}

function main(): i32 {
  let p: *u64 = &Table::VALUE as *u64;
  return *p as i32;
}
`.toStr(),
  );

  Test::assertEq<u64>(constEvalCountErrors(&output.diagnostics), 1);
  Test::assertEq<str>(constEvalFirstErrorCode(&output), "A0245");
}

@test
function constEvalAddressOfNonConstantModuleConstantIsRejected(): void {
  let output: Analyzer::AnalyzerOutput = constEvalAnalyzeSource(
    `function base(): u64 {
  return 7;
}

const K: u64 = base();

function main(): i32 {
