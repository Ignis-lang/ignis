import Ast from "@compiler::ast";
import Vector from "std::vector";

export namespace Analyzer {
  namespace Typecheck {
    /// Local coverage accumulator for one match's arm patterns. Self-contained
    /// (no `TypecheckState` fields) so it stays independent of the IGN-84
    /// state-migration surface.
    record MatchCoverage {
      public irrefutable: boolean;
      public coveredVariants: Vector<Analyzer::DefinitionId>;
      public coveredTrue: boolean;
      public coveredFalse: boolean;
    }

    enum ExhaustiveVerdict {
      Exhaustive,
      Missing(String),
      Unknown,
    }

    /// Returns `true` if `coverage.coveredVariants` already contains
    /// `variantDefId`, compared by `raw()` id.
    function matchCoverageHasVariant(
      coverage: &mut Analyzer::Typecheck::MatchCoverage,
      variantDefId: Analyzer::DefinitionId,
    ): boolean {
      let mut index: u64 = 0;
      while (index < coverage.coveredVariants.length()) {
        let Option::SOME(existing) = coverage.coveredVariants.get(index) else {
          index += 1;
          continue;
        };

        if (existing.raw() == variantDefId.raw()) {
          return true;
        }

        index += 1;
      }

      return false;
    }

    /// Reports whether every alternative of `orPattern` is a wildcard, which
    /// is the only shape that makes an or-pattern irrefutable. Mirrors the
    /// reference analyzer's or-pattern irrefutability rule.
    function orAlternativesAreAllWildcards(
      module: &Ast::Module,
      orPattern: &Ast::Pattern::Or,
    ): boolean {
      if (orPattern.alternatives.length() == 0) {
        return false;
      }

      let mut index: u64 = 0;
      while (index < orPattern.alternatives.length()) {
        let Option::SOME(alternativeId) = orPattern.alternatives.get(index) else {
          return false;
        };

        let Option::SOME(alternative) = module.patterns.get(*alternativeId) else {
          return false;
        };

        let Ast::Pattern::Node::Wildcard(_) = alternative else {
          return false;
        };

        index += 1;
      }

      return true;
    }

    /// Credits one arm's pattern toward `coverage`. Guarded arms must be
    /// filtered out by the caller before this is invoked — a guard cannot
    /// guarantee coverage regardless of the pattern shape.
    function classifyMatchArmPattern(
      coverage: &mut Analyzer::Typecheck::MatchCoverage,
      defStore: &mut Analyzer::DefinitionStore,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
    ): void {
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return;
      };

      // An or-pattern is only irrefutable when every alternative is a
      // wildcard; a binding or literal alternative merely credits coverage,
      // which `creditPatternCoverage` handles below.
      if (let Ast::Pattern::Node::Or(orPattern) = pattern) {
        if (Analyzer::Typecheck::orAlternativesAreAllWildcards(module, &orPattern)) {
          let mut coverageRef: &mut Analyzer::Typecheck::MatchCoverage = coverage;
          coverageRef.irrefutable = true;
        }
      }

      match (pattern) {
        Ast::Pattern::Node::Wildcard(_) -> {
          let mut coverageRef: &mut Analyzer::Typecheck::MatchCoverage = coverage;
          coverageRef.irrefutable = true;
        },
        Ast::Pattern::Node::Binding(_) -> {
          let mut coverageRef: &mut Analyzer::Typecheck::MatchCoverage = coverage;
          coverageRef.irrefutable = true;
        },
        _ -> {
          Analyzer::Typecheck::creditPatternCoverage(coverage, defStore, module, resolvedBodies, patternId);
        },
      };
    }

    /// Credits the closed-domain coverage a refutable pattern contributes:
    /// a boolean literal covers its own value, an enum-variant path covers its
    /// variant, and an or-pattern contributes everything its alternatives do.
    /// Every other shape contributes nothing — record and tuple destructure
    /// crediting is deferred follow-up work (no slice currently owns it).
    function creditPatternCoverage(
      coverage: &mut Analyzer::Typecheck::MatchCoverage,
      defStore: &mut Analyzer::DefinitionStore,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
    ): void {
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return;
      };

      match (pattern) {
        Ast::Pattern::Node::Literal(literal) -> {
          let Option::SOME(expr) = module.expressions.get(literal.expression) else {
            return;
          };

          if (let Ast::Expression::Node::Literal(exprLiteral) = expr) {
            if (let Ast::Expression::LiteralValue::Boolean(flag) = &exprLiteral.value) {
              let mut coverageRef: &mut Analyzer::Typecheck::MatchCoverage = coverage;
              if (flag) {
                coverageRef.coveredTrue = true;
              } else {
                coverageRef.coveredFalse = true;
              }
            }
          }
        },
        Ast::Pattern::Node::Path(_) -> {
          let patternRefOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupPatternRef(resolvedBodies, patternId);
          let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Definition(variantDefId)) = patternRefOpt else {
            return;
          };

          let Option::SOME(def) = defStore.get(variantDefId) else {
            return;
          };

          let Analyzer::Definition::Variant(_) = def else {
            return;
          };

          if (!Analyzer::Typecheck::matchCoverageHasVariant(coverage, variantDefId)) {
            let mut coverageRef: &mut Analyzer::Typecheck::MatchCoverage = coverage;
            coverageRef.coveredVariants.push(variantDefId);
          }
        },
        Ast::Pattern::Node::Or(orPattern) -> {
          let mut index: u64 = 0;
          while (index < orPattern.alternatives.length()) {
            let Option::SOME(alternativeId) = orPattern.alternatives.get(index) else {
              index += 1;
              continue;
            };

            Analyzer::Typecheck::creditPatternCoverage(coverage, defStore, module, resolvedBodies, *alternativeId);
            index += 1;
          }
        },
        _ -> {},
      };
    }

    /// Analyzes one match's arms for exhaustiveness against its scrutinee
    /// type. Pure AST-level analysis: no HIR, no `TypecheckState` mutation,
    /// no diagnostics emitted here — the caller decides severity from
    /// position and emits accordingly.
    function analyzeMatchExhaustiveness(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      scrutineeTypeOpt: Option<Analyzer::TypeId>,
      arms: &Vector<Ast::Expression::MatchArm>,
    ): Analyzer::Typecheck::ExhaustiveVerdict {
      let mut coverage: Analyzer::Typecheck::MatchCoverage = Analyzer::Typecheck::MatchCoverage {
        irrefutable: false,
        coveredVariants: Vector::new<Analyzer::DefinitionId>(),
        coveredTrue: false,
        coveredFalse: false,
      };

      let mut index: u64 = 0;
      while (index < arms.length()) {
        let Option::SOME(arm) = arms.get(index) else {
          index += 1;
          continue;
        };

        if (arm.guard.isSome()) {
          index += 1;
          continue;
        }

        Analyzer::Typecheck::classifyMatchArmPattern(&mut coverage, defStore, module, resolvedBodies, arm.pattern);
        index += 1;
      }

      if (coverage.irrefutable) {
        return Analyzer::Typecheck::ExhaustiveVerdict::Exhaustive;
      }

      let Option::SOME(scrutineeType) = scrutineeTypeOpt else {
        return Analyzer::Typecheck::ExhaustiveVerdict::Unknown;
      };

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, scrutineeType);
      let Option::SOME(resolvedTypeNode) = typeStore.get(resolved.typeId) else {
        return Analyzer::Typecheck::ExhaustiveVerdict::Unknown;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::BOOLEAN -> {
          if (coverage.coveredTrue && coverage.coveredFalse) {
            return Analyzer::Typecheck::ExhaustiveVerdict::Exhaustive;
          }

          return Analyzer::Typecheck::ExhaustiveVerdict::Missing(String::create("bool scrutinee requires both `true` and `false` arms, or a wildcard/irrefutable-binding arm"));
        },
        Analyzer::Type::Enum(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            return Analyzer::Typecheck::ExhaustiveVerdict::Unknown;
          };

          match (def) {
            Analyzer::Definition::Enum(enum_) -> {
              if (enum_.typeParams.length() > 0) {
                return Analyzer::Typecheck::ExhaustiveVerdict::Missing(String::create("generic enum scrutinee requires a wildcard/irrefutable-binding arm"));
              }

              let mut missingCount: u64 = 0;
              let mut firstMissingName: Option<str> = Option::NONE;
              let mut variantIndex: u64 = 0;
              while (variantIndex < enum_.variants.length()) {
                let Option::SOME(variantId) = enum_.variants.get(variantIndex) else {
                  variantIndex += 1;
                  continue;
                };

                if (!Analyzer::Typecheck::matchCoverageHasVariant(&mut coverage, *variantId)) {
                  missingCount += 1;

                  if (firstMissingName.isNone()) {
                    if (let Option::SOME(Analyzer::Definition::Variant(variant)) = defStore.get(*variantId)) {
                      firstMissingName = symbols.resolve(variant.name);
                    }
                  }
                }

                variantIndex += 1;
              }

              if (missingCount == 0) {
                return Analyzer::Typecheck::ExhaustiveVerdict::Exhaustive;
              }

              if (let Option::SOME(name) = firstMissingName) {
                let message: String = `enum scrutinee is missing variant \`${name}\``;
                return Analyzer::Typecheck::ExhaustiveVerdict::Missing(message);
              }

              let message: String = `enum scrutinee is missing ${missingCount} variant(s)`;
              return Analyzer::Typecheck::ExhaustiveVerdict::Missing(message);
            },
            _ -> {
              return Analyzer::Typecheck::ExhaustiveVerdict::Unknown;
            },
          };
        },
        Analyzer::Type::Instance(instance) -> {
          let Option::SOME(genericDef) = defStore.get(instance.definition) else {
            return Analyzer::Typecheck::ExhaustiveVerdict::Missing(String::create("generic scrutinee requires a wildcard/irrefutable-binding arm"));
          };

          match (genericDef) {
            Analyzer::Definition::Record(_) -> {
              return Analyzer::Typecheck::ExhaustiveVerdict::Missing(String::create("generic record scrutinee requires a wildcard/irrefutable-binding arm"));
            },
            _ -> {
              return Analyzer::Typecheck::ExhaustiveVerdict::Missing(String::create("generic enum scrutinee requires a wildcard/irrefutable-binding arm"));
            },
          };
        },
        // Record and Tuple scrutinees are irrefutable-by-shape (a plain
        // destructure pattern always matches), but this analyzer still does
        // not credit record/tuple destructure patterns toward coverage.
        // Staying silent here avoids a false-positive `Missing` verdict on a
        // match that is actually exhaustive; real destructure crediting is
        // deferred follow-up work (no slice currently owns it).
        Analyzer::Type::Record(_) -> {
          return Analyzer::Typecheck::ExhaustiveVerdict::Unknown;
        },
        Analyzer::Type::Tuple(_) -> {
          return Analyzer::Typecheck::ExhaustiveVerdict::Unknown;
        },
        _ -> {
          return Analyzer::Typecheck::ExhaustiveVerdict::Missing(String::create("scrutinee requires a wildcard/irrefutable-binding arm"));
        },
      };

      @panic("unreachable: analyzeMatchExhaustiveness match did not return");
    }
  }
}
