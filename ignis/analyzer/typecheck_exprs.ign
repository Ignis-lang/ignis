import SourceSpan, DiagnosticCode from "@compiler::diagnostics";

import Ast from "@compiler::ast";
import Vector from "std::vector";

export namespace Analyzer {
  namespace Typecheck {
    function checkBlockBody(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      statements: &Vector<Ast::StatementId>,
      tail: Option<Ast::ExpressionId>,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      Analyzer::Typecheck::pushScope(state);

      let mut index: u64 = 0;
      while (index < statements.length()) {
        let Option::SOME(stmtId) = statements.get(index) else {
          index += 1;
          continue;
        };
        Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, *stmtId);
        index += 1;
      }

      if (let Option::SOME(tailId) = tail) {
        let tailTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          tailId,
          expected,
        );
        Analyzer::Typecheck::popScope(state);
        return tailTypeOpt;
      }

      Analyzer::Typecheck::popScope(state);
      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      return Option::SOME(typeStoreRef.intern(Analyzer::Type::VOID));
    }

    function checkBinaryExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      b: &Ast::Expression::Binary,
    ): Option<Analyzer::TypeId> {
      let leftTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        b.left,
      );
      let rightTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        b.right,
      );

      match (b.operator) {
        Ast::Expression::BinaryOperator::BitAnd -> {
          Analyzer::Typecheck::emitUnsupported(state, b.span, "binary expressions");
          return Option::NONE;
        },
        Ast::Expression::BinaryOperator::BitOr -> {
          Analyzer::Typecheck::emitUnsupported(state, b.span, "binary expressions");
          return Option::NONE;
        },
        Ast::Expression::BinaryOperator::BitXor -> {
          Analyzer::Typecheck::emitUnsupported(state, b.span, "binary expressions");
          return Option::NONE;
        },
        Ast::Expression::BinaryOperator::ShiftLeft -> {
          Analyzer::Typecheck::emitUnsupported(state, b.span, "binary expressions");
          return Option::NONE;
        },
        Ast::Expression::BinaryOperator::ShiftRight -> {
          Analyzer::Typecheck::emitUnsupported(state, b.span, "binary expressions");
          return Option::NONE;
        },
        _ -> {},
      };

      let Option::SOME(leftType) = leftTypeOpt else {
        return Option::NONE;
      };
      let Option::SOME(rightType) = rightTypeOpt else {
        return Option::NONE;
      };

      if (Analyzer::Typecheck::isArithmeticBinaryOperator(b.operator)) {
        if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, leftType, rightType) && Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, b.span, leftType)) {
          Analyzer::Typecheck::recordExprType(state, exprId, leftType);
          return Option::SOME(leftType);
        }

        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, b.span, leftType, rightType);
        return Option::NONE;
      }

      if (Analyzer::Typecheck::isEqualityBinaryOperator(b.operator)) {
        if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, leftType, rightType) && (Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, b.span, leftType) || Analyzer::Typecheck::isBooleanType(state, defStore, typeStore, b.span, leftType))) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, b.span, leftType, rightType);
        return Option::NONE;
      }

      if (Analyzer::Typecheck::isComparisonBinaryOperator(b.operator)) {
        if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, leftType, rightType) && Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, b.span, leftType)) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, b.span, leftType, rightType);
        return Option::NONE;
      }

      if (Analyzer::Typecheck::isLogicalBinaryOperator(b.operator)) {
        let leftValid: boolean = Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, b.span, leftType);
        let rightValid: boolean = Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, b.span, rightType);
        if (leftValid && rightValid) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        return Option::NONE;
      }

      Analyzer::Typecheck::emitUnsupported(state, b.span, "binary expressions");
      return Option::NONE;
    }

    function checkAssignmentExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::Assignment,
    ): Option<Analyzer::TypeId> {
      if (value.operator != Ast::Expression::AssignmentOperator::Assign) {
        Analyzer::Typecheck::emitDiagnostic(
          state,
          value.span,
          DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
          "typecheck only supports plain `=` assignment expressions",
        );
        return Option::NONE;
      }

      let resolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, value.target);
      let Option::SOME(resolved) = resolvedOpt else {
        Analyzer::Typecheck::emitDiagnostic(
          state,
          value.span,
          DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
          "assignment target must resolve to a local binding",
        );
        return Option::NONE;
      };

      let localId: Analyzer::ResolverBodies::LocalId = match (resolved) {
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> localId,
        Analyzer::ResolverBodies::ResolvedRef::Definition(_) -> {
          Analyzer::Typecheck::emitDiagnostic(
            state,
            value.span,
            DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
            "assignment target must resolve to a local binding",
          );
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          Analyzer::Typecheck::emitDiagnostic(
            state,
            value.span,
            DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
            "assignment target must resolve to a local binding",
          );
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          Analyzer::Typecheck::emitDiagnostic(
            state,
            value.span,
            DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
            "assignment target must resolve to a local binding",
          );
          return Option::NONE;
        },
      };

      let localBindingOpt: Option<Analyzer::Typecheck::LocalBindingInfo> = Analyzer::Typecheck::lookupLocalBinding(state, localId);
      let Option::SOME(localBinding) = localBindingOpt else {
        Analyzer::Typecheck::emitDiagnostic(
          state,
          value.span,
          DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
          "assignment target must resolve to a local binding",
        );
        return Option::NONE;
      };

      if (!localBinding.mutable) {
        Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::MUTABILITY_VIOLATION, "cannot assign to immutable local");
        return Option::NONE;
      }

      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.value,
      );
      let Option::SOME(actualType) = actualTypeOpt else {
        return Option::NONE;
      };

      if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, value.span, localBinding.typeId, actualType)) {
        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, value.span, localBinding.typeId, actualType);
        return Option::NONE;
      }

      Analyzer::Typecheck::recordExprType(state, exprId, localBinding.typeId);
      return Option::SOME(localBinding.typeId);
    }

    function checkCallExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() > 0) {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "generic call type arguments");
        return Option::NONE;
      }

      // Branch 1: `expr.method(args)` — dispatches on the callee's AST shape
      // alone (MemberAccess nodes never carry a resolver ref, ADR-B7), so this
      // never falls through to `checkExpr(callee)`/`checkMemberAccessExpr`.
      if (let Option::SOME(calleeExpr) = module.expressions.get(call.callee)) {
        if (let Ast::Expression::Node::MemberAccess(ma) = calleeExpr) {
          if (ma.operator == Ast::Expression::AccessOperator::Dot) {
            return Analyzer::Typecheck::checkInstanceMethodCallExpr(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              callExprId,
              call,
              call.callee,
              &ma,
            );
          }
        }
      }

      // Branch 2: a path callee that resolved (at resolver time) directly to a
      // static `Definition::Method` — e.g. `Tipo::staticMethod(args)`. Bypasses
      // `checkExpr(callee)` (and therefore the bare method-reference guard,
      // WU3) since this is a legitimate call, not a value use.
      let staticResolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, call.callee);
      if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Definition(staticDefId)) = staticResolvedOpt) {
        let methodInfoOpt: Option<Analyzer::Typecheck::MethodCallInfo> = Analyzer::Typecheck::lookupMethodDefInfo(defStore, staticDefId);

        if (let Option::SOME(methodInfo) = methodInfoOpt) {
          let calleeTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::definitionType(defStore, typeStore, staticDefId);
          let Option::SOME(calleeType) = calleeTypeOpt else {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through non-function definitions");
            return Option::NONE;
          };
          Analyzer::Typecheck::recordExprType(state, call.callee, calleeType);

          if (!methodInfo.isStatic) {
            Analyzer::Typecheck::emitDiagnostic(state, call.span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, "instance method calls require a receiver");
            return Option::NONE;
          }

          let staticSignatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(
            defStore,
            staticDefId,
          );
          let Option::SOME(staticSignature) = staticSignatureOpt else {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through non-function definitions");
            return Option::NONE;
          };

          return Analyzer::Typecheck::checkCallArgumentsAgainstSignature(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            callExprId,
            call,
            &staticSignature,
            0,
          );
        }
      }

      // Branch 3: existing flow, byte-for-byte.
      let _calleeType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        call.callee,
      );

      let resolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, call.callee);
      let Option::SOME(resolved) = resolvedOpt else {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "direct calls without resolved callee");
        return Option::NONE;
      };

      let functionDefId: Analyzer::DefinitionId = match (resolved) {
        Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> defId,
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
          // A local holding a function value carries its whole signature in its type, so the
          // call is checked against that rather than against a definition.
          return Analyzer::Typecheck::checkCallThroughLocal(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            callExprId,
            call,
            localId,
          );
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through type parameters");
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through unresolved callee");
          return Option::NONE;
        },
      };

      let signatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(
        defStore,
        functionDefId,
      );
      let Option::SOME(signature) = signatureOpt else {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through non-function definitions");
        return Option::NONE;
      };

      return Analyzer::Typecheck::checkCallArgumentsAgainstSignature(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        callExprId,
        call,
        &signature,
        0,
      );
    }

    /// Typecheck a call whose callee is a local holding a function value.
    ///
    /// The signature comes from the local's own type instead of from a definition, so the
    /// parameter types are `TypeId`s directly rather than parameter definitions.
    function checkCallThroughLocal(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      localId: Analyzer::ResolverBodies::LocalId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(binding) = Analyzer::Typecheck::lookupLocalBinding(state, localId) else {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through local values");
        return Option::NONE;
      };

      let Option::SOME(calleeType) = typeStore.get(binding.typeId) else {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through local values");
        return Option::NONE;
      };

      let Analyzer::Type::Function(signature) = calleeType else {
        Analyzer::Typecheck::emitCallOnNonCallable(state, typeStore, call.span, binding.typeId);
        return Option::NONE;
      };

      let expectedArity: u64 = signature.params.length();

      if (call.arguments.length() != expectedArity) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), expectedArity);
      }

      let mut argIndex: u64 = 0;

      while (argIndex < call.arguments.length()) {
        let Option::SOME(argExprId) = call.arguments.get(argIndex) else {
          argIndex += 1;
          continue;
        };

        let expectedParam: Option<Analyzer::TypeId> = match (signature.params.get(argIndex)) {
          Option::SOME(paramType) -> Option::SOME(*paramType),
          Option::NONE -> Option::NONE,
        };

        let actualOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          *argExprId,
          expectedParam,
        );

        if (let Option::SOME(expectedType) = expectedParam) {
          if (let Option::SOME(actualType) = actualOpt) {
            if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, call.span, expectedType, actualType)) {
              Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, call.span, expectedType, actualType);
            }
          }
        }

        argIndex += 1;
      }

      Analyzer::Typecheck::recordExprType(state, callExprId, signature.returnType);
      return Option::SOME(signature.returnType);
    }

    /// Typechecks `call.arguments` against `signature.params[firstParamIndex..]`
    /// and records `callExprId`'s type as `signature.returnType`. `firstParamIndex`
    /// skips the receiver (`self`) for instance-method calls (1) and is a no-op
    /// for direct/static calls (0) — behavior-preserving at `firstParamIndex = 0`
    /// relative to the original inline `checkCallExpr` arg loop.
    function checkCallArgumentsAgainstSignature(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      signature: &Analyzer::Typecheck::FunctionSignature,
      firstParamIndex: u64,
    ): Option<Analyzer::TypeId> {
      let expectedArity: u64 = signature.params.length() - firstParamIndex;
      let actualArity: u64 = call.arguments.length();

      if (actualArity != expectedArity) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, actualArity, expectedArity);
        Analyzer::Typecheck::recordExprType(state, callExprId, signature.returnType);
        return Option::SOME(signature.returnType);
      }

      let mut index: u64 = 0;
      while (index < expectedArity) {
        let Option::SOME(argumentId) = call.arguments.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(paramDefId) = signature.params.get(index + firstParamIndex) else {
          index += 1;
          continue;
        };

        let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
          index += 1;
          continue;
        };

        // Only a `Variable` (ordinary parameter) has a declared type worth
        // propagating as the expectation; every other definition kind hits
        // the "non-variable function parameters" wall below regardless of
        // the argument's own type, so no expectation is threaded for them.
        let expectedType: Option<Analyzer::TypeId> = match (paramDef) {
          Analyzer::Definition::Variable(parameter) -> Option::SOME(parameter.declaredType),
          Analyzer::Definition::Function(_) -> Option::NONE,
          Analyzer::Definition::Record(_) -> Option::NONE,
          Analyzer::Definition::Enum(_) -> Option::NONE,
          Analyzer::Definition::Field(_) -> Option::NONE,
          Analyzer::Definition::Variant(_) -> Option::NONE,
          Analyzer::Definition::TypeParam(_) -> Option::NONE,
          Analyzer::Definition::TypeAlias(_) -> Option::NONE,
          Analyzer::Definition::Trait(_) -> Option::NONE,
          Analyzer::Definition::Method(_) -> Option::NONE,
        };

        let argumentTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          *argumentId,
          expectedType,
        );
        let Option::SOME(argumentType) = argumentTypeOpt else {
          index += 1;
          continue;
        };

        match (paramDef) {
          Analyzer::Definition::Variable(parameter) -> {
            if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, call.span, parameter.declaredType, argumentType)) {
              Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, call.span, parameter.declaredType, argumentType);
              Analyzer::Typecheck::recordExprType(state, callExprId, signature.returnType);
              return Option::SOME(signature.returnType);
            }
          },
          Analyzer::Definition::Function(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Record(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Enum(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Field(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Variant(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::TypeParam(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::TypeAlias(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Trait(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Method(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
        };

        index += 1;
      }

      Analyzer::Typecheck::recordExprType(state, callExprId, signature.returnType);
      return Option::SOME(signature.returnType);
    }

    /// Typechecks `expr.method(args)` where `call.callee` is a `MemberAccess`
    /// with `Dot`. Resolves the receiver's owner via `requireNonGenericMethodOwner`,
    /// looks the member up in `instanceMethods` (falling back to `staticMethods`
    /// for the static-through-instance diagnostic, ADR D10), enforces the
    /// mut-self check (ADR D7, Local-only), then typechecks the call arguments
    /// against the method signature with `self` excluded (`firstParamIndex = 1`).
    /// The `MemberAccess` node itself records a receiver-less function type
    /// (ADR D9) — never reaches `checkMemberAccessExpr`.
    function checkInstanceMethodCallExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      memberExprId: Ast::ExpressionId,
      ma: &Ast::Expression::MemberAccess,
    ): Option<Analyzer::TypeId> {
      let objectTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        ma.object,
      );
      let Option::SOME(objectType) = objectTypeOpt else {
        return Option::NONE;
      };

      let receiverType: Analyzer::TypeId = Analyzer::Typecheck::derefReceiverType(defStore, typeStore, objectType);

      let ownerOpt: Option<Analyzer::Typecheck::RequiredMethodOwner> = Analyzer::Typecheck::requireNonGenericMethodOwner(
        state,
        defStore,
        typeStore,
        ma.span,
        receiverType,
        "method call target must be a non-generic record or enum",
        "typecheck does not support generic method receivers",
      );
      let Option::SOME(owner) = ownerOpt else {
        return Option::NONE;
      };

      let memberName: str = ma.member.toStr();

      let instanceOpt: Option<Analyzer::DefinitionId> = Analyzer::ResolverBodies::lookupMethodInTable(
        defStore,
        &owner.instanceMethods,
        memberName,
        symbols,
      );

      let Option::SOME(methodDefId) = instanceOpt else {
        let staticOpt: Option<Analyzer::DefinitionId> = Analyzer::ResolverBodies::lookupMethodInTable(
          defStore,
          &owner.staticMethods,
          memberName,
          symbols,
        );

        if (staticOpt.isSome()) {
          let message: String = String::create("static method `").concat(memberName).concat("` cannot be called through an instance");
          Analyzer::Typecheck::emitDiagnostic(state, ma.span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, message.toStr());
          return Option::NONE;
        }

        Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, ma.span, DiagnosticCode::UNKNOWN_MEMBER, "unknown method", memberName);
        return Option::NONE;
      };

      let infoOpt: Option<Analyzer::Typecheck::MethodCallInfo> = Analyzer::Typecheck::lookupMethodDefInfo(defStore, methodDefId);
      let Option::SOME(info) = infoOpt else {
        Analyzer::Typecheck::emitUnsupported(state, ma.span, "method call through non-method definition");
        return Option::NONE;
      };

      if (info.selfMutable) {
        let receiverRefOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, ma.object);

        if (let Option::SOME(receiverRef) = receiverRefOpt) {
          match (receiverRef) {
            Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
              let bindingOpt: Option<Analyzer::Typecheck::LocalBindingInfo> = Analyzer::Typecheck::lookupLocalBinding(state, localId);

              if (let Option::SOME(binding) = bindingOpt) {
                if (!binding.mutable) {
                  Analyzer::Typecheck::emitDiagnostic(state, ma.span, DiagnosticCode::MUTABILITY_VIOLATION, "cannot call mutable method on immutable receiver");
                  return Option::NONE;
                }
              }
            },
            // TODO(receiver-place-mutability): non-Local receiver places (record
            // fields, call results, etc.) are not checked for mutability here —
            // accepted debt for this slice (ADR D7).
            Analyzer::ResolverBodies::ResolvedRef::Definition(_) -> {},
            Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {},
            Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {},
          };
        }
      }

      let signatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(
        defStore,
        methodDefId,
      );
      let Option::SOME(signature) = signatureOpt else {
        Analyzer::Typecheck::emitUnsupported(state, ma.span, "calls through non-function definitions");
        return Option::NONE;
      };

      let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut paramIndex: u64 = 1;
      while (paramIndex < signature.params.length()) {
        let Option::SOME(paramDefId) = signature.params.get(paramIndex) else {
          paramIndex += 1;
          continue;
        };
        let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
          paramIndex += 1;
          continue;
        };

        match (paramDef) {
          Analyzer::Definition::Variable(parameter) -> {
            paramTypes.push(parameter.declaredType);
          },
          Analyzer::Definition::Function(_) -> {},
          Analyzer::Definition::Record(_) -> {},
          Analyzer::Definition::Enum(_) -> {},
          Analyzer::Definition::Field(_) -> {},
          Analyzer::Definition::Variant(_) -> {},
          Analyzer::Definition::TypeParam(_) -> {},
          Analyzer::Definition::TypeAlias(_) -> {},
          Analyzer::Definition::Trait(_) -> {},
          Analyzer::Definition::Method(_) -> {},
        };

        paramIndex += 1;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let memberAccessType: Analyzer::TypeId = typeStoreRef.functionType(paramTypes, signature.returnType);
      Analyzer::Typecheck::recordExprType(state, memberExprId, memberAccessType);

      return Analyzer::Typecheck::checkCallArgumentsAgainstSignature(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        callExprId,
        call,
        &signature,
        1,
      );
    }

    record RequiredRecordDef {
      public defId: Analyzer::DefinitionId;
      public typeId: Analyzer::TypeId;
      public fields: Vector<Analyzer::DefinitionId>;
    }

    function requireNonGenericRecord(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonRecordMessage: str,
      genericMessage: str,
    ): Option<Analyzer::Typecheck::RequiredRecordDef> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Record(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Record(record_) -> {
              if (record_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
              let mut index: u64 = 0;
              while (index < record_.fields.length()) {
                let Option::SOME(fieldDefId) = record_.fields.get(index) else {
                  index += 1;
                  continue;
                };

                fields.push(*fieldDefId);
                index += 1;
              }

              return Option::SOME(Analyzer::Typecheck::RequiredRecordDef {
                defId: defId,
                typeId: record_.typeId,
                fields: fields,
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Instance(_) -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
          return Option::NONE;
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireNonGenericRecord match did not return");
    }

    function findRecordFieldDef(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      recordDef: &Analyzer::Typecheck::RequiredRecordDef,
      name: str,
    ): Option<Analyzer::FieldDef> {
      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let fieldSymbol: Analyzer::SymbolId = symbolsRef.intern(name);
      let mut index: u64 = 0;

      while (index < recordDef.fields.length()) {
        let Option::SOME(fieldDefId) = recordDef.fields.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(def) = defStore.get(*fieldDefId) else {
          index += 1;
          continue;
        };

        match (def) {
          Analyzer::Definition::Field(fieldDef) -> {
            if (fieldDef.name.raw() == fieldSymbol.raw()) {
              return Option::SOME(Analyzer::FieldDef {
                name: fieldDef.name,
                fieldType: fieldDef.fieldType,
                owner: fieldDef.owner,
                index: fieldDef.index,
              });
            }
          },
          _ -> {},
        };

        index += 1;
      }

      return Option::NONE;
    }

    function emitNamedRecordFieldDiagnostic(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      code: str,
      prefix: str,
      name: str,
    ): void {
      let message: String = String::create(prefix).concat(" `").concat(name).concat("`");
      Analyzer::Typecheck::emitDiagnostic(state, span, code, message.toStr());
    }

    function checkMemberAccessExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::MemberAccess,
    ): Option<Analyzer::TypeId> {
      if (value.operator != Ast::Expression::AccessOperator::Dot) {
        Analyzer::Typecheck::emitUnsupported(state, value.span, "member access");
        return Option::NONE;
      }

      let objectTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.object,
      );
      let Option::SOME(objectType) = objectTypeOpt else {
        return Option::NONE;
      };

      let receiverType: Analyzer::TypeId = Analyzer::Typecheck::derefReceiverType(defStore, typeStore, objectType);

      let recordDefOpt: Option<Analyzer::Typecheck::RequiredRecordDef> = Analyzer::Typecheck::requireNonGenericRecord(
        state,
        defStore,
        typeStore,
        value.span,
        receiverType,
        "member access target must be a non-generic record",
        "member access target must be a non-generic record",
      );
      let Option::SOME(recordDef) = recordDefOpt else {
        return Option::NONE;
      };

      let fieldDefOpt: Option<Analyzer::FieldDef> = Analyzer::Typecheck::findRecordFieldDef(
        defStore,
        symbols,
        &recordDef,
        value.member.toStr(),
      );
      let Option::SOME(fieldDef) = fieldDefOpt else {
        Analyzer::Typecheck::emitBareMethodReferenceOrUnknownField(state, defStore, symbols, value.span, &recordDef, value.member.toStr());
        return Option::NONE;
      };

      Analyzer::Typecheck::recordExprType(state, exprId, fieldDef.fieldType);
      return Option::SOME(fieldDef.fieldType);
    }

    /// Called after a record field-lookup miss (`checkMemberAccessExpr`).
    /// Scans the owner's `instanceMethods`/`staticMethods` tables (record-only,
    /// mirrors `requireNonGenericRecord`'s record-only blast radius, ADR D11's
    /// sibling restriction): a hit means the caller wrote a bare method
    /// reference (`obj.method` without a call) — diagnose that specifically
    /// instead of the generic "unknown record field" message. A miss on both
    /// tables falls back to the existing "unknown record field" diagnostic,
    /// unchanged.
    function emitBareMethodReferenceOrUnknownField(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      span: SourceSpan,
      recordDef: &Analyzer::Typecheck::RequiredRecordDef,
      memberName: str,
    ): void {
      let mut instanceMethods: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut staticMethods: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(ownerDef) = defStore.get(recordDef.defId)) {
        match (ownerDef) {
          Analyzer::Definition::Record(record_) -> {
            instanceMethods = Analyzer::Typecheck::copyDefinitionIdVector(&record_.instanceMethods);
            staticMethods = Analyzer::Typecheck::copyDefinitionIdVector(&record_.staticMethods);
          },
          Analyzer::Definition::Enum(_) -> {},
          Analyzer::Definition::Function(_) -> {},
          Analyzer::Definition::Variable(_) -> {},
          Analyzer::Definition::Field(_) -> {},
          Analyzer::Definition::Variant(_) -> {},
          Analyzer::Definition::TypeParam(_) -> {},
          Analyzer::Definition::TypeAlias(_) -> {},
          Analyzer::Definition::Trait(_) -> {},
          Analyzer::Definition::Method(_) -> {},
        };
      }

      let mut methodHit: Option<Analyzer::DefinitionId> = Analyzer::ResolverBodies::lookupMethodInTable(defStore, &instanceMethods, memberName, symbols);
      if (!methodHit.isSome()) {
        methodHit = Analyzer::ResolverBodies::lookupMethodInTable(defStore, &staticMethods, memberName, symbols);
      }

      if (methodHit.isSome()) {
        let message: String = String::create("method `").concat(memberName).concat("` requires a call");
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, message.toStr());
        return;
      }

      Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, span, DiagnosticCode::UNKNOWN_MEMBER, "unknown record field", memberName);
    }

    function checkRecordInitExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::RecordInit,
    ): Option<Analyzer::TypeId> {
      if (value.typeArguments.length() > 0) {
        Analyzer::Typecheck::emitUnsupported(state, value.span, "generic record initializers");
        return Option::NONE;
      }

      let pathTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.path,
      );
      let Option::SOME(pathType) = pathTypeOpt else {
        return Option::NONE;
      };

      let recordDefOpt: Option<Analyzer::Typecheck::RequiredRecordDef> = Analyzer::Typecheck::requireNonGenericRecord(
        state,
        defStore,
        typeStore,
        value.span,
        pathType,
        "record initializer target must be a non-generic record",
        "typecheck does not support generic record initializers",
      );
      let Option::SOME(recordDef) = recordDefOpt else {
        return Option::NONE;
      };

      let mut seenFieldNames: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();
      let mut fieldIndex: u64 = 0;
      while (fieldIndex < value.fields.length()) {
        let Option::SOME(field) = value.fields.get(fieldIndex) else {
          fieldIndex += 1;
          continue;
        };

        let fieldDefOpt: Option<Analyzer::FieldDef> = Analyzer::Typecheck::findRecordFieldDef(
          defStore,
          symbols,
          &recordDef,
          field.name.toStr(),
        );
        let Option::SOME(fieldDef) = fieldDefOpt else {
          Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, value.span, DiagnosticCode::UNKNOWN_MEMBER, "unknown record field", field.name.toStr());
          return Option::NONE;
        };

        let mut seenIndex: u64 = 0;
        while (seenIndex < seenFieldNames.length()) {
          let Option::SOME(seenFieldName) = seenFieldNames.get(seenIndex) else {
            seenIndex += 1;
            continue;
          };

          if (seenFieldName.raw() == fieldDef.name.raw()) {
            Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, value.span, DiagnosticCode::DUPLICATE_RECORD_FIELD_INIT, "duplicate record field", field.name.toStr());
            return Option::NONE;
          }

          seenIndex += 1;
        }

        seenFieldNames.push(fieldDef.name);

        let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          field.value,
          Option::SOME(fieldDef.fieldType),
        );
        let Option::SOME(actualType) = actualTypeOpt else {
          return Option::NONE;
        };

        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, value.span, fieldDef.fieldType, actualType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, value.span, fieldDef.fieldType, actualType);
          return Option::NONE;
        }

        fieldIndex += 1;
      }

      let mut declaredFieldIndex: u64 = 0;
      while (declaredFieldIndex < recordDef.fields.length()) {
        let Option::SOME(fieldDefId) = recordDef.fields.get(declaredFieldIndex) else {
          declaredFieldIndex += 1;
          continue;
        };

        let Option::SOME(def) = defStore.get(*fieldDefId) else {
          declaredFieldIndex += 1;
          continue;
        };

        match (def) {
          Analyzer::Definition::Field(fieldDef) -> {
            let mut found: boolean = false;
            let mut seenIndex: u64 = 0;
            while (seenIndex < seenFieldNames.length()) {
              let Option::SOME(seenFieldName) = seenFieldNames.get(seenIndex) else {
                seenIndex += 1;
                continue;
              };

              if (seenFieldName.raw() == fieldDef.name.raw()) {
                found = true;
                break;
              }

              seenIndex += 1;
            }

            if (!found) {
              let missingName: String = match (symbols.resolve(fieldDef.name)) {
                Option::SOME(name) -> String::create(name),
                Option::NONE -> String::create("<unknown>"),
              };
              Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, value.span, DiagnosticCode::MISSING_RECORD_FIELD_INIT, "missing record field", missingName.toStr());
              return Option::NONE;
            }
          },
          _ -> {},
        };

        declaredFieldIndex += 1;
      }

      Analyzer::Typecheck::recordExprType(state, exprId, recordDef.typeId);
      return Option::SOME(recordDef.typeId);
    }

    function checkExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::TypeId> {
      return Analyzer::Typecheck::checkExprExpected(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        exprId,
        Option::NONE,
      );
    }

    function checkExprExpected(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return Option::NONE;
      };

      match (expr) {
        Ast::Expression::Node::Literal(literal) -> {
          match (&literal.value) {
            Ast::Expression::LiteralValue::Null -> {
              Analyzer::Typecheck::emitUnsupported(state, literal.span, "null literals");
              return Option::NONE;
            },
            _ -> {},
          };

          let typeId: Analyzer::TypeId = Analyzer::Typecheck::literalType(typeStore, &literal);
          Analyzer::Typecheck::recordExprType(state, exprId, typeId);
          return Option::SOME(typeId);
        },
        Ast::Expression::Node::Variable(variable) -> {
          return Analyzer::Typecheck::checkResolvedValueExpr(
            state,
            defStore,
            typeStore,
            resolvedBodies,
            exprId,
            variable.span,
          );
        },
        Ast::Expression::Node::Path(path) -> {
          return Analyzer::Typecheck::checkResolvedValueExpr(
            state,
            defStore,
            typeStore,
            resolvedBodies,
            exprId,
            path.span,
          );
        },
        Ast::Expression::Node::Grouped(grouped) -> {
          let innerTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            grouped.expression,
            expected,
          );

          let Option::SOME(innerType) = innerTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, innerType);
          return Option::SOME(innerType);
        },
        Ast::Expression::Node::Call(call) -> {
          return Analyzer::Typecheck::checkCallExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &call,
          );
        },
        Ast::Expression::Node::Binary(b) -> {
          return Analyzer::Typecheck::checkBinaryExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &b,
          );
        },
        Ast::Expression::Node::Assignment(value) -> {
          return Analyzer::Typecheck::checkAssignmentExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::Ternary(value) -> {
          let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.condition);
          if (let Option::SOME(conditionType) = conditionTypeOpt) {
            Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
          }

          let thenTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(state, defStore, typeStore, symbols, module, resolvedBodies, value.thenBranch, expected);
          let elseTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(state, defStore, typeStore, symbols, module, resolvedBodies, value.elseBranch, expected);

          let mut candidates: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          if (let Option::SOME(thenType) = thenTypeOpt) {
            candidates.push(thenType);
          }
          if (let Option::SOME(elseType) = elseTypeOpt) {
            candidates.push(elseType);
          }

          let ternaryTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::joinTypes(state, defStore, typeStore, value.span, &candidates, 2, Analyzer::Typecheck::JoinKind::Branches, expected);
          let Option::SOME(ternaryType) = ternaryTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, ternaryType);
          return Option::SOME(ternaryType);
        },
        Ast::Expression::Node::Cast(value) -> {
          let _innerType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.expression);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "cast expressions");
          return Option::NONE;
        },
        Ast::Expression::Node::Dereference(value) -> {
          let _innerType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.operand);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "dereference expressions");
          return Option::NONE;
        },
        Ast::Expression::Node::Tuple(value) -> {
          let mut index: u64 = 0;
          while (index < value.elements.length()) {
            let Option::SOME(elementId) = value.elements.get(index) else {
              index += 1;
              continue;
            };
            let _elementType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, *elementId);
            index += 1;
          }
          Analyzer::Typecheck::emitUnsupported(state, value.span, "tuple expressions");
          return Option::NONE;
        },
        Ast::Expression::Node::Unit(value) -> {
          Analyzer::Typecheck::emitUnsupported(state, value.span, "unit expressions");
          return Option::NONE;
        },
        Ast::Expression::Node::LetCondition(value) -> {
          let _valueType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.value);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "let conditions");
          return Option::NONE;
        },
        Ast::Expression::Node::Reference(value) -> {
          let _targetType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.target);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "reference expressions");
          return Option::NONE;
        },
        Ast::Expression::Node::Unary(value) -> {
          let _operandType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.operand);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "unary expressions");
          return Option::NONE;
        },
        Ast::Expression::Node::Block(value) -> {
          let blockTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkBlockBody(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value.statements,
            value.tail,
            expected,
          );
          let Option::SOME(blockType) = blockTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, blockType);
          return Option::SOME(blockType);
        },
        Ast::Expression::Node::If(value) -> {
          let ifTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkIfExpr(state, defStore, typeStore, symbols, module, resolvedBodies, &value, expected);
          let Option::SOME(ifType) = ifTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, ifType);
          return Option::SOME(ifType);
        },
        Ast::Expression::Node::Match(value) -> {
          let matchTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkMatchExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value,
            expected,
            true,
          );

          let Option::SOME(matchType) = matchTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, matchType);
          return Option::SOME(matchType);
        },
        Ast::Expression::Node::Vector(value) -> {
          let mut index: u64 = 0;
          while (index < value.elements.length()) {
            let Option::SOME(elementId) = value.elements.get(index) else {
              index += 1;
              continue;
            };
            let _elementType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, *elementId);
            index += 1;
          }
          Analyzer::Typecheck::emitUnsupported(state, value.span, "vector literals");
          return Option::NONE;
        },
        Ast::Expression::Node::VectorAccess(value) -> {
          let _vectorType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.vector);
          let _indexType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.index);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "vector access");
          return Option::NONE;
        },
        Ast::Expression::Node::PostfixIncrement(value) -> {
          let _operandType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.operand);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "postfix increment");
          return Option::NONE;
        },
        Ast::Expression::Node::PostfixDecrement(value) -> {
          let _operandType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.operand);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "postfix decrement");
          return Option::NONE;
        },
        Ast::Expression::Node::MemberAccess(value) -> {
          return Analyzer::Typecheck::checkMemberAccessExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::RecordInit(value) -> {
          return Analyzer::Typecheck::checkRecordInitExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::BuiltinCall(value) -> {
          let Option::SOME(builtinType) = Analyzer::Typecheck::checkBuiltinCall(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            &value,
          ) else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, builtinType);
          return Option::SOME(builtinType);
        },
        Ast::Expression::Node::Lambda(value) -> {
          let Option::SOME(lambdaType) = Analyzer::Typecheck::checkLambdaExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value,
          ) else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, lambdaType);
          return Option::SOME(lambdaType);
        },
        Ast::Expression::Node::CaptureOverride(value) -> {
          let _innerType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.expression);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "capture overrides");
          return Option::NONE;
        },
        Ast::Expression::Node::Pipe(value) -> {
          let Option::SOME(pipeType) = Analyzer::Typecheck::checkPipeExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value,
          ) else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, pipeType);
          return Option::SOME(pipeType);
        },
        Ast::Expression::Node::PipePlaceholder(value) -> {
          let Option::SOME(placeholderType) = Analyzer::Typecheck::checkPipePlaceholderExpr(state, &value) else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, placeholderType);
          return Option::SOME(placeholderType);
        },
        Ast::Expression::Node::Try(value) -> {
          let _innerType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.expression);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "try expressions");
          return Option::NONE;
        },
      };

      @panic("unreachable: checkExprExpected match did not return");
    }

    /// Returns `true` when `typeId` resolves (through alias chains) to the
    /// interned `NEVER` type — used by `joinTypes` to exclude diverging arms
    /// (e.g. a `return`-only body) from the cross-arm join without needing a
    /// separate divergence marker.
    function isNeverType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
        return false;
      };

      let Analyzer::Type::NEVER = resolvedNode else {
        return false;
      };

      return true;
    }

    /// Whether an expression of type `actual` may be supplied where `expected` is required.
    ///
    /// A diverging expression never produces a value, so there is no value that could be
    /// of the wrong type: `NEVER` fits every position. Comparing it with `typesEqual`
    /// would reject `return @panic("...")` inside a function returning anything but
    /// `never`, reporting a type error for code that cannot reach the return at all.
    ///
    /// This must be used wherever a value flows into an expected type — return, local
    /// annotation, assignment, argument, field initializer, constant initializer, and the
    /// joined type of an all-diverging `match`. Symmetric comparisons (binary operands, a
    /// pattern against its annotation) stay on `typesEqual`: neither side is a value being
    /// supplied to the other. The reference compiler exempts `never` only at `return`, so
    /// it rejects `let x: u64 = @panic("...")`; accepting it here is deliberate, since a
    /// bottom type that is assignable in one position and not another is not a bottom type.
    function valueSatisfiesType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      expected: Analyzer::TypeId,
      actual: Analyzer::TypeId,
    ): boolean {
      // `typesEqual` reports cyclic aliases as it resolves them, so it runs first even when
      // the answer is already known: testing divergence first would swallow that diagnostic.
      if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, expected, actual)) {
        return true;
      }

      return Analyzer::Typecheck::isNeverType(state, defStore, typeStore, actual);
    }

    /// Selects which pairwise-mismatch diagnostic `joinTypes` emits, so the
    /// same join algorithm serves both match arms (S3) and if/ternary
    /// branches (S4) with their own distinct diagnostic wording (design D5:
    /// `match-arm-type-mismatch` vs `branch-type-mismatch`).
    enum JoinKind {
      MatchArms,
      Branches,
    }

    /// Joins the value-producing candidates of an expression-position
    /// match/if/ternary into a single result type (design D2). `candidates`
    /// holds only the candidate types that were themselves successfully
    /// typechecked — a body/branch that already failed typechecking (and was
    /// diagnosed at its own call site) contributes nothing here. Diverging
    /// (`NEVER`-typed) candidates are excluded from the pairwise comparison
    /// so they never poison the join. `attemptedCount` is the number of
    /// bodies/branches that were attempted regardless of outcome: when it is
    /// positive but every candidate was excluded because none of them
    /// successfully typechecked, the failure was already diagnosed at each
    /// candidate's own call site, so `joinTypes` returns `Option::NONE`
    /// without a further diagnostic (S3 review follow-up — do not conflate
    /// "nothing typed" with "everything diverged"). When candidates exist but
    /// all are excluded as diverging, the join itself types as `NEVER`. The
    /// result (or `NEVER`) is compared against `expected` exactly once, when
    /// present — this is the only place a join vs. `expected` mismatch can be
    /// diagnosed, since no per-candidate leaf checker enforces `expected`
    /// against its synthesized type today.
    function joinTypes(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      candidates: &Vector<Analyzer::TypeId>,
      attemptedCount: u64,
      kind: Analyzer::Typecheck::JoinKind,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let mut accumulated: Option<Analyzer::TypeId> = Option::NONE;

      let mut index: u64 = 0;
      while (index < candidates.length()) {
        let Option::SOME(candidateRef) = candidates.get(index) else {
          index += 1;
          continue;
        };
        let candidate: Analyzer::TypeId = *candidateRef;

        if (Analyzer::Typecheck::isNeverType(state, defStore, typeStore, candidate)) {
          index += 1;
          continue;
        }

        let Option::SOME(current) = accumulated else {
          accumulated = Option::SOME(candidate);
          index += 1;
          continue;
        };

        if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, current, candidate)) {
          match (kind) {
            Analyzer::Typecheck::JoinKind::MatchArms -> Analyzer::Typecheck::emitMatchArmTypeMismatch(state, typeStore, span, current, candidate),
            Analyzer::Typecheck::JoinKind::Branches -> Analyzer::Typecheck::emitBranchTypeMismatch(state, typeStore, span, current, candidate),
          };
          return Option::NONE;
        }

        index += 1;
      }

      if (accumulated.isNone() && candidates.length() == 0 && attemptedCount > 0) {
        return Option::NONE;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let mut joinedType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::NEVER);
      if (let Option::SOME(t) = accumulated) {
        joinedType = t;
      }

      if (let Option::SOME(expectedType) = expected) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, expectedType, joinedType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, span, expectedType, joinedType);
          return Option::NONE;
        }
      }

      return Option::SOME(joinedType);
    }

    function checkMatchExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      value: &Ast::Expression::Match,
      expected: Option<Analyzer::TypeId>,
      valuePosition: boolean,
    ): Option<Analyzer::TypeId> {
      let scrutineeTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.scrutinee);

      let mut armTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

      let mut index: u64 = 0;
      while (index < value.arms.length()) {
        let Option::SOME(arm) = value.arms.get(index) else {
          index += 1;
          continue;
        };

        Analyzer::Typecheck::pushScope(state);
        if (let Option::SOME(scrutineeType) = scrutineeTypeOpt) {
          Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, arm.pattern, scrutineeType, false, value.span);
        }

        if (let Option::SOME(guardId) = arm.guard) {
          let guardTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, guardId);
          if (let Option::SOME(guardType) = guardTypeOpt) {
            Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, guardType);
          }
        }

        // `expected` propagates into arm bodies regardless of position: in
        // statement position it is always `Option::NONE` (see the `checkStmt`
        // call site below), so `checkExprExpected` transparently falls back
        // to synthesis-only checking there.
        let bodyTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(state, defStore, typeStore, symbols, module, resolvedBodies, arm.body, expected);
        if (let Option::SOME(bodyType) = bodyTypeOpt) {
          armTypes.push(bodyType);
        }
        Analyzer::Typecheck::popScope(state);
        index += 1;
      }

      let verdict: Analyzer::Typecheck::ExhaustiveVerdict = Analyzer::Typecheck::analyzeMatchExhaustiveness(defStore, typeStore, symbols, module, resolvedBodies, scrutineeTypeOpt, &value.arms);
      if (let Analyzer::Typecheck::ExhaustiveVerdict::Missing(reason) = verdict) {
        let message: String = String::create("non-exhaustive match: ").concat(reason.toStr());
        if (valuePosition) {
          Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::NON_EXHAUSTIVE_MATCH, message.toStr());
        } else {
          Analyzer::Typecheck::emitWarning(state, value.span, DiagnosticCode::NON_EXHAUSTIVE_MATCH, message.toStr());
        }
      }

      // Statement position discards the match's value: no cross-arm join is
      // imposed (design D2), and the match itself produces no expression
      // type — mirroring how sibling statement forms (`if`, `while`) never
      // record an expression type for themselves.
      if (!valuePosition) {
        return Option::NONE;
      }

      return Analyzer::Typecheck::joinTypes(state, defStore, typeStore, value.span, &armTypes, value.arms.length(), Analyzer::Typecheck::JoinKind::MatchArms, expected);
    }

    /// Types a single if-expression branch as a value, threading `expected`
    /// into it. If-expression branches always arrive as a `Block` statement
    /// (mirroring `if (cond) { ... } else { ... }` syntax) so their value is
    /// the block's tail, checked through `checkBlockBody` exactly like any
    /// other value-producing block. Any other statement shape has no value
    /// to contribute: it is still checked for its own diagnostics via
    /// `checkStmt`, but contributes nothing to the branch join.
    function checkIfBranchExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      stmtId: Ast::StatementId,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(stmt) = module.statements.get(stmtId) else {
        return Option::NONE;
      };

      if (let Ast::Statement::Node::Block(blockStmt) = stmt) {
        return Analyzer::Typecheck::checkBlockBody(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          &blockStmt.statements,
          blockStmt.tail,
          expected,
        );
      }

      Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, stmtId);
      return Option::NONE;
    }

    /// Types an if-expression (design D2/D5, S4): both branches are checked
    /// with `expected` threaded in, then joined via the same `joinTypes`
    /// algorithm as match arms. An if-expression with no `else` branch has no
    /// value to produce, so it is diagnosed instead of falling back to
    /// `void`.
    function checkIfExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      value: &Ast::Expression::If,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.condition);
      if (let Option::SOME(conditionType) = conditionTypeOpt) {
        Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
      }

      let Option::SOME(elseId) = value.elseBranch else {
        let _thenType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkIfBranchExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.thenBranch, Option::NONE);
        Analyzer::Typecheck::emitIfMissingElse(state, value.span);
        return Option::NONE;
      };

      let thenTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkIfBranchExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.thenBranch, expected);
      let elseTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkIfBranchExpr(state, defStore, typeStore, symbols, module, resolvedBodies, elseId, expected);

      let mut candidates: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      if (let Option::SOME(thenType) = thenTypeOpt) {
        candidates.push(thenType);
      }
      if (let Option::SOME(elseType) = elseTypeOpt) {
        candidates.push(elseType);
      }

      return Analyzer::Typecheck::joinTypes(state, defStore, typeStore, value.span, &candidates, 2, Analyzer::Typecheck::JoinKind::Branches, expected);
    }

    function checkLetElse(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      value: &Ast::Statement::LetElse,
    ): void {
      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.value,
      );

      let mut expectedTypeOpt: Option<Analyzer::TypeId> = Option::NONE;
      if (let Option::SOME(annotationId) = value.annotation) {
        expectedTypeOpt = Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, annotationId);
      } else {
        expectedTypeOpt = actualTypeOpt;
      }

      if (let Option::SOME(expectedType) = expectedTypeOpt) {
        if (let Option::SOME(actualType) = actualTypeOpt) {
          if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, value.span, expectedType, actualType)) {
            Analyzer::Typecheck::emitTypeMismatch(state, typeStore, value.span, expectedType, actualType);
          }
        }

        Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, value.pattern, expectedType, false, value.span);
      } else if (value.annotation.isSome()) {
        Analyzer::Typecheck::emitUnsupported(state, value.span, "unsupported local annotation type");
      }

      Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, value.elseBranch);
    }

    function checkLetLike(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
      annotation: Option<Ast::TypeId>,
      value: Option<Ast::ExpressionId>,
      mutable: boolean,
      span: SourceSpan,
    ): void {
      let Option::SOME(annotationId) = annotation else {
        Analyzer::Typecheck::emitUnsupported(state, span, "locals without explicit annotations");
        return;
      };

      let expectedTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        annotationId,
      );
      let Option::SOME(expectedType) = expectedTypeOpt else {
        Analyzer::Typecheck::emitUnsupported(state, span, "unsupported local annotation type");
        return;
      };

      let Option::SOME(valueExprId) = value else {
        Analyzer::Typecheck::emitUnsupported(state, span, "locals without initializers");
        return;
      };

      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        valueExprId,
      );

      if (let Option::SOME(actualType) = actualTypeOpt) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, expectedType, actualType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, span, expectedType, actualType);
        }
      }

      Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, patternId, expectedType, mutable, span);
    }

    /// Type a `@name(...)` builtin call.
    ///
    /// Builtins are not declarations, so there is nothing to resolve a name against: the
    /// name itself selects the signature. Only the ones the self-hosted compiler needs for
    /// its own sources are typed so far; the rest are named in their diagnostic instead of
    /// being reported as one undifferentiated wall.
    function checkBuiltinCall(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      call: &Ast::Expression::BuiltinCall,
    ): Option<Analyzer::TypeId> {
      let name: &String = &call.name;

      if (name.equals("sizeOf") || name.equals("alignOf")) {
        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let resultType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::U64);

        return Analyzer::Typecheck::checkBuiltinWithOneTypeArgument(state, defStore, typeStore, symbols, module, call, resultType);
      }

      if (name.equals("typeName")) {
        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let resultType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::STR);

        return Analyzer::Typecheck::checkBuiltinWithOneTypeArgument(state, defStore, typeStore, symbols, module, call, resultType);
      }

      if (name.equals("panic")) {
        return Analyzer::Typecheck::checkBuiltinPanic(state, typeStore, module, call);
      }

      if (name.equals("trap") || name.equals("unreachable")) {
        return Analyzer::Typecheck::checkBuiltinWithoutArguments(state, typeStore, call);
      }

      if (Analyzer::Typecheck::isKnownBuiltinName(name)) {
        let detail: String = String::create("the `@").concat(name.toStr()).concat("` builtin");
        Analyzer::Typecheck::emitUnsupported(state, call.span, detail.toStr());
        return Option::NONE;
      }

      Analyzer::Typecheck::emitUnknownBuiltin(state, call.span, name.toStr());
      return Option::NONE;
    }

    /// Whether `name` is a builtin the language defines, typed here or not.
    ///
    /// Separating this from the typed set is what lets a misspelling be reported as an
    /// unknown builtin instead of as a construct that is merely unimplemented.
    ///
    /// `configFlag` is a directive rather than a builtin, but the parser turns every
    /// `@ident(...)` in expression position into a `BuiltinCall`, so it arrives here and
    /// belongs in the list — dropping it to match the builtin registry exactly would
    /// report legal source as an unknown builtin.
    function isKnownBuiltinName(name: &String): boolean {
      if (name.equals("typeOf") || name.equals("compileError") || name.equals("configFlag")) {
        return true;
      }

      if (name.equals("bitCast") || name.equals("pointerCast")) {
        return true;
      }

      if (name.equals("integerFromPointer") || name.equals("pointerFromInteger")) {
        return true;
      }

      if (name.equals("sliceFromParts") || name.equals("read") || name.equals("write")) {
        return true;
      }

      if (name.equals("hash") || name.equals("eq")) {
        return true;
      }

      if (name.equals("maxOf") || name.equals("minOf")) {
        return true;
      }

      return name.equals("dropInPlace") || name.equals("dropGlue");
    }

    /// `@name<T>()`: exactly one type argument, no value arguments, fixed result type.
    function checkBuiltinWithOneTypeArgument(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      call: &Ast::Expression::BuiltinCall,
      resultType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() != 1) {
        Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 1, call.typeArguments.length());
        return Option::NONE;
      }

      if (call.arguments.length() != 0) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 0);
        return Option::NONE;
      }

      let Option::SOME(typeArgId) = call.typeArguments.get(0) else {
        return Option::NONE;
      };

      let Option::SOME(_operandType) = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        *typeArgId,
      ) else {
        let detail: String = String::create("the type argument of `@").concat(call.name.toStr()).concat("`");
        Analyzer::Typecheck::emitUnsupported(state, call.span, detail.toStr());
        return Option::NONE;
      };

      return Option::SOME(resultType);
    }

    /// `@panic("literal")`: no type arguments, one string-literal argument, never returns.
    function checkBuiltinPanic(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      call: &Ast::Expression::BuiltinCall,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() != 0) {
        Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 0, call.typeArguments.length());
        return Option::NONE;
      }

      if (call.arguments.length() != 1) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 1);
        return Option::NONE;
      }

      let Option::SOME(messageExprId) = call.arguments.get(0) else {
        return Option::NONE;
      };

      if (!Analyzer::Typecheck::isStringLiteralExpr(module, *messageExprId)) {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "`@panic` messages that are not string literals");
        return Option::NONE;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      return Option::SOME(typeStoreRef.intern(Analyzer::Type::NEVER));
    }

    /// `@name()`: no type arguments, no value arguments, never returns.
    function checkBuiltinWithoutArguments(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      call: &Ast::Expression::BuiltinCall,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() != 0) {
        Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 0, call.typeArguments.length());
        return Option::NONE;
      }

      if (call.arguments.length() != 0) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 0);
        return Option::NONE;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      return Option::SOME(typeStoreRef.intern(Analyzer::Type::NEVER));
    }

    /// Type a pipe whose right side names where the piped value goes with a `_`.
    ///
    /// The placeholder stands for the left side, so the right side is checked as an
    /// ordinary expression with the left side's type made available to whatever `_` it
    /// contains, and the pipe takes the right side's type. Nothing about arity or
    /// parameters is inspected here: the right side already says where the value lands.
    ///
    /// A right side with no `_` means the value is passed implicitly, which is not typed
    /// yet and is reported as unsupported rather than silently accepted.
    function checkPipeExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      pipe: &Ast::Expression::Pipe,
    ): Option<Analyzer::TypeId> {
      let leftTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        pipe.left,
      );

      let placeholderCount: u64 = Analyzer::Typecheck::countPipePlaceholders(module, pipe.right);

      if (placeholderCount > 1) {
        Analyzer::Typecheck::emitPipeMultiplePlaceholders(state, pipe.span);
        return Option::NONE;
      }

      if (placeholderCount == 0) {
        Analyzer::Typecheck::emitUnsupported(state, pipe.span, "pipes whose right side has no `_` placeholder");
        return Option::NONE;
      }

      // A `_` only means "the piped value goes here" inside something that consumes an
      // argument. Anywhere else — `1 |> _ + 2`, `1 |> _.field`, a bare `1 |> _` — it reads
      // as a value the pipe does nothing with, so the shape is rejected rather than
      // quietly accepted with the right side's type.
      if (!Analyzer::Typecheck::pipeRightSideTakesPlaceholder(module, pipe.right)) {
        Analyzer::Typecheck::emitPipePlaceholderNotInCall(state, pipe.span);
        return Option::NONE;
      }

      // Without the left side's type there is nothing to give the placeholder, and pushing
      // a guessed one would report the placeholder's uses against a type never written.
      let Option::SOME(leftType) = leftTypeOpt else {
        return Option::NONE;
      };

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.pipeValueTypes.push(leftType);

      let rightTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        pipe.right,
      );

      let mut stateRef2: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef2.pipeValueTypes.pop();

      return rightTypeOpt;
    }

    /// The type a `_` stands for: the value piped by the innermost enclosing pipe.
    function checkPipePlaceholderExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      placeholder: &Ast::Expression::PipePlaceholder,
    ): Option<Analyzer::TypeId> {
      let depth: u64 = state.pipeValueTypes.length();

      if (depth == 0) {
        Analyzer::Typecheck::emitPipePlaceholderOutsidePipe(state, placeholder.span);
        return Option::NONE;
      }

      let Option::SOME(valueType) = state.pipeValueTypes.get(depth - 1) else {
        return Option::NONE;
      };

      return Option::SOME(*valueType);
    }

    /// Whether a right side of this shape can hold the piped value in a `_`.
    ///
    /// These are the forms that take arguments, so a `_` among them names a position the
    /// value fills. The list is closed on purpose: accepting any right side that merely
    /// contains a `_` somewhere would make `1 |> _ + 2` mean something, and no rule says
    /// what.
    function pipeRightSideTakesPlaceholder(
      module: &Ast::Module,
      exprId: Ast::ExpressionId
    ): boolean {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return false;
      };

      return match (expr) {
        Ast::Expression::Node::Call(_) -> true,
        Ast::Expression::Node::BuiltinCall(_) -> true,
        Ast::Expression::Node::RecordInit(_) -> true,
        Ast::Expression::Node::Vector(_) -> true,
        _ -> false,
      };
    }

    /// How many `_` placeholders belong to the pipe step rooted at `exprId`.
    ///
    /// A lambda body and a nested pipe each own whatever `_` they contain, so the walk
    /// stops at both: counting through them would let an inner `_` decide the outer pipe's
    /// shape. Every other expression is transparent.
    function countPipePlaceholders(module: &Ast::Module, exprId: Ast::ExpressionId): u64 {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return 0;
      };

      return match (expr) {
        Ast::Expression::Node::PipePlaceholder(_) -> 1,
        Ast::Expression::Node::Lambda(_) -> 0,
        Ast::Expression::Node::Pipe(_) -> 0,
        Ast::Expression::Node::Literal(_) -> 0,
        Ast::Expression::Node::Path(_) -> 0,
        Ast::Expression::Node::Variable(_) -> 0,
        Ast::Expression::Node::Unit(_) -> 0,
        Ast::Expression::Node::Block(value) -> Analyzer::Typecheck::countPipePlaceholdersInStatements(module, &value.statements)
          + Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.tail),
        Ast::Expression::Node::If(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.thenBranch)
          + Analyzer::Typecheck::countPipePlaceholdersInOptionalStatement(module, value.elseBranch),
        Ast::Expression::Node::Grouped(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Expression::Node::Cast(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Expression::Node::CaptureOverride(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Expression::Node::Try(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Expression::Node::Dereference(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.operand),
        Ast::Expression::Node::Unary(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.operand),
        Ast::Expression::Node::PostfixIncrement(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.operand),
        Ast::Expression::Node::PostfixDecrement(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.operand),
        Ast::Expression::Node::Reference(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.target),
        Ast::Expression::Node::LetCondition(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.value),
        // The member is a name, not an expression, so only the object can hold a `_`.
        Ast::Expression::Node::MemberAccess(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.object),
        Ast::Expression::Node::Binary(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.left)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.right),
        Ast::Expression::Node::Assignment(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.target)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.value),
        Ast::Expression::Node::VectorAccess(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.vector)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.index),
        Ast::Expression::Node::Ternary(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.thenBranch)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.elseBranch),
        Ast::Expression::Node::Call(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.callee)
          + Analyzer::Typecheck::countPipePlaceholdersIn(module, &value.arguments),
        Ast::Expression::Node::BuiltinCall(value) -> Analyzer::Typecheck::countPipePlaceholdersIn(module, &value.arguments),
        Ast::Expression::Node::Tuple(value) -> Analyzer::Typecheck::countPipePlaceholdersIn(module, &value.elements),
        Ast::Expression::Node::Vector(value) -> Analyzer::Typecheck::countPipePlaceholdersIn(module, &value.elements),
        Ast::Expression::Node::RecordInit(value) -> Analyzer::Typecheck::countPipePlaceholdersInFields(module, &value.fields),
        Ast::Expression::Node::Match(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.scrutinee)
          + Analyzer::Typecheck::countPipePlaceholdersInArms(module, &value.arms),
      };
    }

    /// Placeholders inside a statement, so a `_` in a braced block or an `if` branch is
    /// counted rather than hidden.
    ///
    /// A statement that opens a new function body (an `Item`) is not part of this pipe
    /// step, for the same reason a lambda is not, so it contributes nothing.
    function countPipePlaceholdersInStatement(
      module: &Ast::Module,
      statementId: Ast::StatementId
    ): u64 {
      let Option::SOME(statement) = module.statements.get(statementId) else {
        return 0;
      };

      return match (statement) {
        Ast::Statement::Node::Continue(_) -> 0,
        Ast::Statement::Node::Comment(_) -> 0,
        Ast::Statement::Node::Item(_) -> 0,
        Ast::Statement::Node::Expression(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Statement::Node::Defer(value) -> Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.statement),
        Ast::Statement::Node::Variable(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.value),
        Ast::Statement::Node::Let(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.value),
        Ast::Statement::Node::Return(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.value),
        Ast::Statement::Node::Break(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.value),
        Ast::Statement::Node::LetElse(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.value)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.elseBranch),
        Ast::Statement::Node::While(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.body),
        Ast::Statement::Node::ForOf(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.iterable)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.body),
        Ast::Statement::Node::Block(value) -> Analyzer::Typecheck::countPipePlaceholdersInStatements(module, &value.statements)
          + Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.tail),
        Ast::Statement::Node::If(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.thenBranch)
          + Analyzer::Typecheck::countPipePlaceholdersInOptionalStatement(module, value.elseBranch),
        Ast::Statement::Node::For(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptionalStatement(module, value.initializer)
          + Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.update)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.body),
      };
    }

    function countPipePlaceholdersInStatements(
      module: &Ast::Module,
      statementIds: &Vector<Ast::StatementId>
    ): u64 {
      let mut total: u64 = 0;
      let mut index: u64 = 0;

      while (index < statementIds.length()) {
        if (let Option::SOME(statementId) = statementIds.get(index)) {
          total += Analyzer::Typecheck::countPipePlaceholdersInStatement(module, *statementId);
        }

        index += 1;
      }

      return total;
    }

    function countPipePlaceholdersInOptional(
      module: &Ast::Module,
      exprId: Option<Ast::ExpressionId>
    ): u64 {
      return match (exprId) {
        Option::SOME(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value),
        Option::NONE -> 0,
      };
    }

    function countPipePlaceholdersInOptionalStatement(
      module: &Ast::Module,
      statementId: Option<Ast::StatementId>
    ): u64 {
      return match (statementId) {
        Option::SOME(value) -> Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value),
        Option::NONE -> 0,
      };
    }

    function countPipePlaceholdersIn(
      module: &Ast::Module,
      exprIds: &Vector<Ast::ExpressionId>
    ): u64 {
      let mut total: u64 = 0;
      let mut index: u64 = 0;

      while (index < exprIds.length()) {
        if (let Option::SOME(exprId) = exprIds.get(index)) {
          total += Analyzer::Typecheck::countPipePlaceholders(module, *exprId);
        }

        index += 1;
      }

      return total;
    }

    function countPipePlaceholdersInFields(
      module: &Ast::Module,
      fields: &Vector<Ast::Expression::RecordInitField>,
    ): u64 {
      let mut total: u64 = 0;
      let mut index: u64 = 0;

      while (index < fields.length()) {
        if (let Option::SOME(field) = fields.get(index)) {
          total += Analyzer::Typecheck::countPipePlaceholders(module, field.value);
        }

        index += 1;
      }

      return total;
    }

    function countPipePlaceholdersInArms(
      module: &Ast::Module,
      arms: &Vector<Ast::Expression::MatchArm>,
    ): u64 {
      let mut total: u64 = 0;
      let mut index: u64 = 0;

      while (index < arms.length()) {
        if (let Option::SOME(arm) = arms.get(index)) {
          total += Analyzer::Typecheck::countPipePlaceholders(module, arm.body);

          if (let Option::SOME(guardId) = arm.guard) {
            total += Analyzer::Typecheck::countPipePlaceholders(module, guardId);
          }
        }

        index += 1;
      }

      return total;
    }

    /// Whether `exprId` is a string literal written in place.
    function isStringLiteralExpr(module: &Ast::Module, exprId: Ast::ExpressionId): boolean {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return false;
      };

      let Ast::Expression::Node::Literal(literal) = expr else {
        return false;
      };

      return match (&literal.value) {
        Ast::Expression::LiteralValue::String(_) -> true,
        Ast::Expression::LiteralValue::Int(_) -> false,
        Ast::Expression::LiteralValue::UInt(_) -> false,
        Ast::Expression::LiteralValue::Float(_) -> false,
        Ast::Expression::LiteralValue::Boolean(_) -> false,
        Ast::Expression::LiteralValue::Character(_) -> false,
        Ast::Expression::LiteralValue::Null -> false,
      };
    }

    /// Type a lambda: its parameters bind in a scope of their own, its body is checked
    /// against its declared return type, and the result is the function type it denotes.
    ///
    /// Both the parameter annotations and the return annotation are required. Inferring them
    /// needs an expected type flowing in from the use site, which `checkExprExpected` does not
    /// carry through a lambda yet.
    function checkLambdaExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      lambda: &Ast::Expression::Lambda,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(declaredReturn) = lambda.returnType else {
        Analyzer::Typecheck::emitUnsupported(state, lambda.span, "lambdas without an explicit return type");
        return Option::NONE;
      };

      let Option::SOME(returnType) = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        declaredReturn,
      ) else {
        Analyzer::Typecheck::emitUnsupported(state, lambda.span, "unsupported lambda return type");
        return Option::NONE;
      };

      let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut paramIndex: u64 = 0;

      while (paramIndex < lambda.parameters.length()) {
        let Option::SOME(paramPatternId) = lambda.parameters.get(paramIndex) else {
          return Option::NONE;
        };

        let Option::SOME(paramType) = Analyzer::Typecheck::lambdaParameterType(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          *paramPatternId,
          lambda.span,
        ) else {
          return Option::NONE;
        };

        paramTypes.push(paramType);
        paramIndex += 1;
      }

      // The body is checked in its own scope, against its own return type. Without saving the
      // enclosing one, a `return` inside the lambda would be checked against the function the
      // lambda is written in.
      let enclosingReturnType: Analyzer::TypeId = state.currentReturnType;
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.currentReturnType = returnType;

      Analyzer::Typecheck::pushScope(stateRef);

      let mut boundIndex: u64 = 0;

      while (boundIndex < lambda.parameters.length()) {
        let Option::SOME(paramPatternId) = lambda.parameters.get(boundIndex) else {
          boundIndex += 1;
          continue;
        };

        let Option::SOME(paramType) = paramTypes.get(boundIndex) else {
          boundIndex += 1;
          continue;
        };

        let _bound: boolean = Analyzer::Typecheck::pushPatternLocal(
          stateRef,
          resolvedBodies,
          *paramPatternId,
          *paramType,
          false,
          lambda.span,
        );
        boundIndex += 1;
      }

      Analyzer::Typecheck::checkStmt(stateRef, defStore, typeStore, symbols, module, resolvedBodies, lambda.body);
      Analyzer::Typecheck::popScope(stateRef);

      stateRef.currentReturnType = enclosingReturnType;

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;

      return Option::SOME(typeStoreRef.intern(Analyzer::Type::Function(Analyzer::FunctionType {
        params: paramTypes,
        returnType: returnType,
      })));
    }

    /// The declared type of one lambda parameter.
    ///
    /// The parser only ever produces binding patterns here, and the annotation is what gives
    /// the parameter its type: there is nothing else to infer it from.
    function lambdaParameterType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      patternId: Ast::PatternId,
      span: SourceSpan,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return Option::NONE;
      };

      let Ast::Pattern::Node::Binding(binding) = pattern else {
        Analyzer::Typecheck::emitUnsupported(state, span, "non-binding lambda parameters");
        return Option::NONE;
      };

      let Option::SOME(annotation) = binding.annotation else {
        Analyzer::Typecheck::emitUnsupported(state, span, "lambda parameters without explicit annotations");
        return Option::NONE;
      };

      let Option::SOME(paramType) = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        annotation,
      ) else {
        Analyzer::Typecheck::emitUnsupported(state, span, "unsupported lambda parameter type");
        return Option::NONE;
      };

      return Option::SOME(paramType);
    }

    function checkStmt(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      stmtId: Ast::StatementId,
    ): void {
      let Option::SOME(stmt) = module.statements.get(stmtId) else {
        return;
      };

      match (stmt) {
        Ast::Statement::Node::Let(letStmt) -> {
          Analyzer::Typecheck::checkLetLike(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            letStmt.pattern,
            letStmt.annotation,
            letStmt.value,
            false,
            letStmt.span,
          );
        },
        Ast::Statement::Node::Variable(variableStmt) -> {
          Analyzer::Typecheck::checkLetLike(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            variableStmt.pattern,
            variableStmt.annotation,
            variableStmt.value,
            variableStmt.mutable,
            variableStmt.span,
          );
        },
        Ast::Statement::Node::Expression(expressionStmt) -> {
          let Option::SOME(expressionNode) = module.expressions.get(expressionStmt.expression) else {
            return;
          };

          // A statement-position match is checked directly here so its
          // exhaustiveness diagnostic is a WARNING (`valuePosition = false`).
          // Every other statement expression, including a parenthesised
          // `(match ...)` (which arrives as `Node::Grouped`, not
          // `Node::Match`), falls through to the ordinary expression path,
          // where a nested match is always checked at `valuePosition = true`.
          if (let Ast::Expression::Node::Match(matchValue) = expressionNode) {
            let _matchType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkMatchExpr(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              &matchValue,
              Option::NONE,
              false,
            );
          } else {
            let _expressionType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              expressionStmt.expression,
            );
          }
        },
        Ast::Statement::Node::Block(blockStmt) -> {
          let _blockType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkBlockBody(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &blockStmt.statements,
            blockStmt.tail,
            Option::NONE,
          );
        },
        Ast::Statement::Node::Return(returnStmt) -> {
          if (let Option::SOME(valueExprId) = returnStmt.value) {
            let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              valueExprId,
            );

            if (let Option::SOME(actualType) = actualTypeOpt) {
              if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, returnStmt.span, state.currentReturnType, actualType)) {
                Analyzer::Typecheck::emitTypeMismatch(state, typeStore, returnStmt.span, state.currentReturnType, actualType);
              }
            }
          } else {
            let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
            let voidType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::VOID);
            if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, returnStmt.span, state.currentReturnType, voidType)) {
              Analyzer::Typecheck::emitTypeMismatch(state, typeStore, returnStmt.span, state.currentReturnType, voidType);
            }
          }
        },
        Ast::Statement::Node::Comment(_) -> {},
        Ast::Statement::Node::LetElse(value) -> {
          Analyzer::Typecheck::checkLetElse(state, defStore, typeStore, symbols, module, resolvedBodies, &value);
        },
        Ast::Statement::Node::If(value) -> {
          let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.condition);
          if (let Option::SOME(conditionType) = conditionTypeOpt) {
            Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
          }
          Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, value.thenBranch);
          if (let Option::SOME(elseId) = value.elseBranch) {
            Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, elseId);
          }
        },
        Ast::Statement::Node::While(value) -> {
          let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.condition);
          if (let Option::SOME(conditionType) = conditionTypeOpt) {
            Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
          }
          Analyzer::Typecheck::enterLoop(state);
          Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, value.body);
          Analyzer::Typecheck::exitLoop(state);
        },
        Ast::Statement::Node::For(value) -> {
          Analyzer::Typecheck::pushScope(state);

          if (let Option::SOME(initializerId) = value.initializer) {
            Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, initializerId);
          }

          if (let Option::SOME(conditionId) = value.condition) {
            let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, conditionId);
            if (let Option::SOME(conditionType) = conditionTypeOpt) {
              Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
            }
          }

          if (let Option::SOME(updateId) = value.update) {
            let _updateType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, updateId);
          }

          Analyzer::Typecheck::enterLoop(state);
          Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, value.body);
          Analyzer::Typecheck::exitLoop(state);
          Analyzer::Typecheck::popScope(state);
        },
        Ast::Statement::Node::ForOf(value) -> {
          let _iterableType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.iterable);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "for-of statements");
        },
        Ast::Statement::Node::Break(value) -> {
          if (state.loopDepth == 0) {
            Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::CONTROL_FLOW_OUTSIDE_LOOP, "`break` used outside of loop");
            return;
          }

          if (value.value.isSome()) {
            Analyzer::Typecheck::emitUnsupported(state, value.span, "break values");
            return;
          }
        },
        Ast::Statement::Node::Continue(value) -> {
          if (state.loopDepth == 0) {
            Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::CONTROL_FLOW_OUTSIDE_LOOP, "`continue` used outside of loop");
          }
        },
        Ast::Statement::Node::Defer(value) -> {
          Analyzer::Typecheck::emitUnsupported(state, value.span, "defer statements");
        },
        Ast::Statement::Node::Item(value) -> {
          Analyzer::Typecheck::emitUnsupported(state, value.span, "nested item statements");
        },
      };
    }
  }
}
