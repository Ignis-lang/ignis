import SourceSpan, DiagnosticCode from "@compiler::diagnostics";

import Ast from "@compiler::ast";
import Id from "@compiler::ids";
import Vector from "std::vector";

export namespace Analyzer {
  namespace Typecheck {
    function checkBlockBody(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      statements: &Vector<Ast::StatementId>,
      tail: Option<Ast::ExpressionId>,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      Analyzer::Typecheck::pushScope(state);

      let mut index: u64 = 0;
      while (index < statements.length()) {
        let Option::SOME(stmtId) = statements.get(index) else {
          index += 1;
          continue;
        };
        Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, *stmtId);
        index += 1;
      }

      if (let Option::SOME(tailId) = tail) {
        let tailTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          tailId,
          expected,
        );
        Analyzer::Typecheck::popScope(state);
        return tailTypeOpt;
      }

      Analyzer::Typecheck::popScope(state);

      // A tailless block that cannot fall through — its last statement
      // returns — contributes NEVER, so a match arm ending in `return`
      // joins with the other arms instead of forcing void.
      let mut lastDiverges: boolean = false;
      if (statements.length() > 0) {
        if (let Option::SOME(lastStmtId) = statements.get(statements.length() - 1)) {
          if (let Option::SOME(lastStmt) = module.statements.get(*lastStmtId)) {
            if (let Ast::Statement::Node::Return(_) = lastStmt) {
              lastDiverges = true;
            }
          }
        }
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;

      if (lastDiverges) {
        return Option::SOME(typeStoreRef.intern(Analyzer::Type::NEVER));
      }

      return Option::SOME(typeStoreRef.intern(Analyzer::Type::VOID));
    }

    function checkBinaryExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      b: &Ast::Expression::Binary,
    ): Option<Analyzer::TypeId> {
      let leftTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        b.left,
      );

      // The reference analyzer checks the left operand without an expectation
      // and then checks the right one expecting the left operand's type, so an
      // unsuffixed literal on the right adopts it instead of defaulting.
      let mut rightExpected: Option<Analyzer::TypeId> = Option::NONE;
      if (let Option::SOME(leftType) = leftTypeOpt) {
        if (Analyzer::Typecheck::isNumericTypeQuiet(defStore, typeStore, leftType)) {
          rightExpected = Option::SOME(leftType);
        }

        // A pointer left makes `x == null` well-typed: the null literal
        // adopts the pointer type instead of failing to infer one.
        if (Analyzer::Typecheck::typeIdIsPointer(typeStore, leftType)) {
          rightExpected = Option::SOME(leftType);
        }
      }

      let rightTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        b.right,
        rightExpected,
      );

      let Option::SOME(initialLeftType) = leftTypeOpt else {
        return Option::NONE;
      };
      let Option::SOME(rightType) = rightTypeOpt else {
        return Option::NONE;
      };

      // The expectation pass above only reaches a literal on the RIGHT of a
      // numeric left. `3 - x.length()` needs the mirror: an unsuffixed
      // integer literal on the left re-coerces to the right operand's
      // integer type when it fits, as the host's literal coercion does.
      let mut leftType: Analyzer::TypeId = initialLeftType;
      let literalCoercibleOperator: boolean = Analyzer::Typecheck::isArithmeticBinaryOperator(b.operator) || Analyzer::Typecheck::isEqualityBinaryOperator(b.operator) || Analyzer::Typecheck::isComparisonBinaryOperator(b.operator);

      if (literalCoercibleOperator && !Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, initialLeftType, rightType)) {
        if (Analyzer::Typecheck::coerceIntegerLiteralTo(state, defStore, typeStore, module, b.left, rightType)) {
          leftType = rightType;
        }
      }

      if (Analyzer::Typecheck::isArithmeticBinaryOperator(b.operator)) {
        if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, leftType, rightType) && Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, b.span, leftType)) {
          Analyzer::Typecheck::recordExprType(state, exprId, leftType);
          return Option::SOME(leftType);
        }

        // Operands of different widths unify on the wider one, as the
        // reference analyzer's `typecheck_common_type` does.
        if (let Option::SOME(commonType) = Analyzer::Typecheck::commonIntegerType(defStore, typeStore, leftType, rightType)) {
          Analyzer::Typecheck::recordExprType(state, exprId, commonType);
          return Option::SOME(commonType);
        }

        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, b.span, leftType, rightType);
        return Option::NONE;
      }

      if (Analyzer::Typecheck::isEqualityBinaryOperator(b.operator)) {
        if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, leftType, rightType) && (Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, b.span, leftType) || Analyzer::Typecheck::isBooleanType(state, defStore, typeStore, b.span, leftType))) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        if (Analyzer::Typecheck::commonIntegerType(defStore, typeStore, leftType, rightType).isSome()) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        // The host also accepts char == char, unit-enum == unit-enum of the
        // same enum, and pointer == pointer.
        if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, leftType, rightType)) {
          let leftResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, leftType);

          if (leftResolved.cycleAlias.isNone()) {
            let charOrUnitEnum: boolean = Analyzer::Typecheck::typeIdIsChar(typeStore, leftResolved.typeId) || Analyzer::Typecheck::isUnitEnumType(defStore, typeStore, leftResolved.typeId);

            if (charOrUnitEnum) {
              let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
              Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
              return Option::SOME(booleanType);
            }
          }
        }

        if (Analyzer::Typecheck::typeIdIsPointer(typeStore, leftType) && Analyzer::Typecheck::typeIdIsPointer(typeStore, rightType)) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, b.span, leftType, rightType);
        return Option::NONE;
      }

      if (Analyzer::Typecheck::isComparisonBinaryOperator(b.operator)) {
        if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, leftType, rightType) && Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, b.span, leftType)) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        // The host also orders char operands by scalar value.
        if (Analyzer::Typecheck::typeIdIsChar(typeStore, leftType) && Analyzer::Typecheck::typeIdIsChar(typeStore, rightType)) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        if (Analyzer::Typecheck::commonIntegerType(defStore, typeStore, leftType, rightType).isSome()) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, b.span, leftType, rightType);
        return Option::NONE;
      }

      if (Analyzer::Typecheck::isLogicalBinaryOperator(b.operator)) {
        let leftValid: boolean = Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, b.span, leftType);
        let rightValid: boolean = Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, b.span, rightType);
        if (leftValid && rightValid) {
          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        }

        return Option::NONE;
      }

      if (Analyzer::Typecheck::isShiftOrBitwiseBinaryOperator(b.operator)) {
        let leftIsInteger: boolean = Analyzer::Typecheck::isIntegerType(state, defStore, typeStore, b.span, leftType);
        let rightIsInteger: boolean = Analyzer::Typecheck::isIntegerType(state, defStore, typeStore, b.span, rightType);

        if (!leftIsInteger || !rightIsInteger) {
          Analyzer::Typecheck::emitInvalidBinaryOperandType(state, typeStore, b.span, b.operator, leftType, rightType);
          return Option::NONE;
        }

        // The reference analyzer widens mixed integer operands through its
        // common-type machinery; the selfhost has none, so both sides must
        // name the same type, matching every other binary arm here.
        if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, b.span, leftType, rightType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, b.span, leftType, rightType);
          return Option::NONE;
        }

        Analyzer::Typecheck::recordExprType(state, exprId, leftType);
        return Option::SOME(leftType);
      }

      Analyzer::Typecheck::emitUnsupported(state, b.span, "binary expressions");
      return Option::NONE;
    }

    /// Re-type an unsuffixed integer literal expression as `targetType` when
    /// the target is an integer type the literal's value fits. Mirrors the
    /// host's `try_coerce_integer_literal_to`. Returns whether it applied.
    function coerceIntegerLiteralTo(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      exprId: Ast::ExpressionId,
      targetType: Analyzer::TypeId,
    ): boolean {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return false;
      };

      let Ast::Expression::Node::Literal(literal) = expr else {
        return false;
      };

      let Ast::Expression::LiteralValue::Int(value) = literal.value else {
        return false;
      };

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, targetType);
      if (resolved.cycleAlias.isSome()) {
        return false;
      }

      let Option::SOME(targetNode) = typeStore.get(resolved.typeId) else {
        return false;
      };

      if (!Analyzer::Typecheck::isIntegerTypeNode(targetNode)) {
        return false;
      }

      if (!Analyzer::Typecheck::signedLiteralFits(targetNode, value)) {
        return false;
      }

      Analyzer::Typecheck::recordExprType(state, exprId, targetType);
      return true;
    }

    function checkAssignmentExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::Assignment,
    ): Option<Analyzer::TypeId> {
      // A place target (`*x`, `obj.field`, `v[i]`) carries no resolver ref of
      // its own, so it is typechecked as an expression and its mutability
      // comes from the place walk instead of a local binding.
      if (Analyzer::Typecheck::isPlaceAssignmentTarget(module, value.target)) {
        return Analyzer::Typecheck::checkPlaceAssignment(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          exprId,
          value,
        );
      }

      let resolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, value.target);
      let Option::SOME(resolved) = resolvedOpt else {
        Analyzer::Typecheck::emitDiagnostic(
          state,
          value.span,
          DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
          "assignment target must resolve to a local binding",
        );
        return Option::NONE;
      };

      let localId: Analyzer::ResolverBodies::LocalId = match (resolved) {
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> localId,
        Analyzer::ResolverBodies::ResolvedRef::Definition(_) -> {
          Analyzer::Typecheck::emitDiagnostic(
            state,
            value.span,
            DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
            "assignment target must resolve to a local binding",
          );
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          Analyzer::Typecheck::emitDiagnostic(
            state,
            value.span,
            DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
            "assignment target must resolve to a local binding",
          );
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          Analyzer::Typecheck::emitDiagnostic(
            state,
            value.span,
            DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
            "assignment target must resolve to a local binding",
          );
          return Option::NONE;
        },
      };

      let localBindingOpt: Option<Analyzer::Typecheck::LocalBindingInfo> = Analyzer::Typecheck::lookupLocalBinding(state, localId);
      let Option::SOME(localBinding) = localBindingOpt else {
        Analyzer::Typecheck::emitDiagnostic(
          state,
          value.span,
          DiagnosticCode::INVALID_ASSIGNMENT_TARGET,
          "assignment target must resolve to a local binding",
        );
        return Option::NONE;
      };

      Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, value.target);

      // A binding still waiting for its type takes it from this assignment,
      // which is the only thing that can decide it. The right side is checked
      // with nothing expected of it, exactly as an initializer would be.
      if (localBinding.pending) {
        let pendingActualOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          value.value,
        );
        let Option::SOME(pendingActual) = pendingActualOpt else {
          return Option::NONE;
        };

        Analyzer::Typecheck::resolvePendingLocal(state, localId, pendingActual);
        Analyzer::Typecheck::recordExprType(state, exprId, pendingActual);
        return Option::SOME(pendingActual);
      }

      // `x = v` where `x: &mut T` assigns through the reference: the target
      // type is the referent and the binding's own mutability is irrelevant,
      // mirroring the reference analyzer's implicit mutable-reference
      // assignment target.
      let mut targetType: Analyzer::TypeId = localBinding.typeId;
      let mut targetIsMutable: boolean = localBinding.mutable;

      if (let Option::SOME(referent) = Analyzer::Typecheck::mutableReferenceReferent(defStore, typeStore, localBinding.typeId)) {
        targetType = referent;
        targetIsMutable = true;
      }

      if (!targetIsMutable) {
        Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::MUTABILITY_VIOLATION, "cannot assign to immutable local");
        return Option::NONE;
      }

      // The assignment target's type is the expectation for the right side,
      // mirroring the reference analyzer's `typecheck_assignment_expr`.
      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.value,
        Option::SOME(targetType),
      );
      let Option::SOME(actualType) = actualTypeOpt else {
        return Option::NONE;
      };

      if (!Analyzer::Typecheck::assignmentValueMatchesTarget(state, defStore, typeStore, value.span, value.operator, targetType, actualType)) {
        return Option::NONE;
      }

      Analyzer::Typecheck::recordExprType(state, exprId, targetType);
      return Option::SOME(targetType);
    }

    /// Whether `exprId` is an assignment target that names a place rather than
    /// a binding: a dereference, a `.field` access, or an index.
    function isPlaceAssignmentTarget(module: &Ast::Module, exprId: Ast::ExpressionId): boolean {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return false;
      };

      return match (expr) {
        Ast::Expression::Node::Dereference(_) -> true,
        Ast::Expression::Node::VectorAccess(_) -> true,
        Ast::Expression::Node::MemberAccess(_) -> true,
        _ -> false,
      };
    }

    /// Check the assigned value against the target for the written operator.
    ///
    /// Plain `=` uses the ordinary value-satisfies rule. A compound operator
    /// requires both sides numeric — the host's rule — and of the same type,
    /// because the selfhost has no common-type machinery (the same stand-in
    /// every binary arm applies).
    function assignmentValueMatchesTarget(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      operator: Ast::Expression::AssignmentOperator,
      targetType: Analyzer::TypeId,
      actualType: Analyzer::TypeId,
    ): boolean {
      if (operator == Ast::Expression::AssignmentOperator::Assign) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, targetType, actualType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, span, targetType, actualType);
          return false;
        }

        return true;
      }

      let targetNumeric: boolean = Analyzer::Typecheck::isNumericTypeQuiet(defStore, typeStore, targetType);
      let valueNumeric: boolean = Analyzer::Typecheck::isNumericTypeQuiet(defStore, typeStore, actualType);

      if (!targetNumeric || !valueNumeric) {
        Analyzer::Typecheck::emitDiagnostic(
          state,
          span,
          DiagnosticCode::COMPOUND_ASSIGNMENT_NON_NUMERIC,
          "compound assignment requires numeric operands",
        );
        return false;
      }

      if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, targetType, actualType)) {
        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, span, targetType, actualType);
        return false;
      }

      return true;
    }

    /// The referent of `typeId` when it is a `&mut T`, NONE otherwise.
    function mutableReferenceReferent(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      if (resolved.cycleAlias.isSome()) {
        return Option::NONE;
      }

      let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
        return Option::NONE;
      };

      let mut referentOpt: Option<Analyzer::TypeId> = Option::NONE;

      match (resolvedNode) {
        Analyzer::Type::Reference(reference) -> {
          if (reference.mutable) {
            referentOpt = Option::SOME(reference.referent);
          }
        },
        _ -> {},
      };

      return referentOpt;
    }

    /// Typechecks an assignment whose target names a place: `*x = v`,
    /// `obj.field = v`, `v[i] = v`.
    ///
    /// The target is checked as an expression — which owns every diagnostic
    /// about the place itself (a dereference of a non-pointer, an unknown
    /// field, a non-record receiver) — and its mutability comes from
    /// `isMutablePlaceExpr`, mirroring the reference analyzer's
    /// `is_mutable_expression` gate in `typecheck_assignment_expr`.
    function checkPlaceAssignment(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::Assignment,
    ): Option<Analyzer::TypeId> {
      let targetTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.target,
      );
      let Option::SOME(targetType) = targetTypeOpt else {
        return Option::NONE;
      };

      if (!Analyzer::Typecheck::isMutablePlaceExpr(state, defStore, typeStore, resolvedBodies, module, value.target)) {
        Analyzer::Typecheck::emitDiagnostic(
          state,
          value.span,
          DiagnosticCode::MUTABILITY_VIOLATION,
          "cannot assign to an immutable place",
        );
        return Option::NONE;
      }

      Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, value.target);

      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.value,
        Option::SOME(targetType),
      );
      let Option::SOME(actualType) = actualTypeOpt else {
        return Option::NONE;
      };

      if (!Analyzer::Typecheck::assignmentValueMatchesTarget(state, defStore, typeStore, value.span, value.operator, targetType, actualType)) {
        return Option::NONE;
      }

      Analyzer::Typecheck::recordExprType(state, exprId, targetType);
      return Option::SOME(targetType);
    }

    function checkCallExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      // Branch 1: `expr.method(args)` — dispatches on the callee's AST shape
      // alone (MemberAccess nodes never carry a resolver ref, ADR-B7), so this
      // never falls through to `checkExpr(callee)`/`checkMemberAccessExpr`.
      if (let Option::SOME(calleeExpr) = module.expressions.get(call.callee)) {
        if (let Ast::Expression::Node::MemberAccess(ma) = calleeExpr) {
          if (ma.operator == Ast::Expression::AccessOperator::Dot) {
            return Analyzer::Typecheck::checkInstanceMethodCallExpr(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              callExprId,
              call,
              call.callee,
              &ma,
            );
          }
        }
      }

      // Branch 1b: `minOf<T>()` / `maxOf<T>()` written without `@` — the host
      // types these from the callee name alone, before any resolution.
      let mut bareBuiltinName: String = String::create("");
      if (let Option::SOME(bareCalleeExpr) = module.expressions.get(call.callee)) {
        if (let Ast::Expression::Node::Variable(bareCallee) = bareCalleeExpr) {
          bareBuiltinName = bareCallee.name.clone();
        }

        if (let Ast::Expression::Node::Path(barePath) = bareCalleeExpr) {
          if (barePath.segments.length() == 1) {
            if (let Option::SOME(onlySegment) = barePath.segments.get(0)) {
              bareBuiltinName = onlySegment.clone();
            }
          }
        }
      }

      {
        {
          if (bareBuiltinName.equals("minOf") || bareBuiltinName.equals("maxOf")) {
            if (call.typeArguments.length() != 1) {
              Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, bareBuiltinName.toStr(), 1, call.typeArguments.length());
              return Option::NONE;
            }

            if (call.arguments.length() != 0) {
              Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 0);
              return Option::NONE;
            }

            let Option::SOME(typeArgId) = call.typeArguments.get(0) else {
              return Option::NONE;
            };
            let Option::SOME(resultType) = Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, *typeArgId) else {
              let detail: String = `the type argument of \`${bareBuiltinName.toStr()}\``;
              Analyzer::Typecheck::emitUnsupported(state, call.span, detail.toStr());
              return Option::NONE;
            };

            Analyzer::Typecheck::recordExprType(state, call.callee, resultType);
            Analyzer::Typecheck::recordExprType(state, callExprId, resultType);
            return Option::SOME(resultType);
          }
        }
      }

      // Branch 2: a path callee that resolved (at resolver time) directly to a
      // static `Definition::Method` — e.g. `Tipo::staticMethod(args)`. Bypasses
      // `checkExpr(callee)` (and therefore the bare method-reference guard,
      // WU3) since this is a legitimate call, not a value use.
      let staticResolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, call.callee);
      if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Definition(resolvedStaticDefId)) = staticResolvedOpt) {
        // The resolver stops at the first same-name static; the overload set
        // lives on the owner, and the arguments pick among it here.
        let mut staticDefId: Analyzer::DefinitionId = resolvedStaticDefId;
        let staticCandidates: Vector<Analyzer::DefinitionId> = Analyzer::Typecheck::staticOverloadCandidates(defStore, symbols, resolvedStaticDefId);

        if (staticCandidates.length() > 1) {
          let staticNameOpt: Option<str> = Analyzer::Typecheck::methodDefName(defStore, symbols, resolvedStaticDefId);
          let staticName: str = match (staticNameOpt) {
            Option::SOME(n) -> n,
            Option::NONE -> "static method",
          };
          let selectedOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::selectStaticMethodOverload(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &staticCandidates,
            call,
            call.span,
            staticName,
          );
          let Option::SOME(selected) = selectedOpt else {
            return Option::NONE;
          };
          staticDefId = selected;
        }

        let methodInfoOpt: Option<Analyzer::Typecheck::MethodCallInfo> = Analyzer::Typecheck::lookupMethodDefInfo(defStore, staticDefId);

        if (let Option::SOME(methodInfo) = methodInfoOpt) {
          let calleeTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::definitionType(defStore, typeStore, staticDefId);
          let Option::SOME(calleeType) = calleeTypeOpt else {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through non-function definitions");
            return Option::NONE;
          };
          Analyzer::Typecheck::recordExprType(state, call.callee, calleeType);

          if (!methodInfo.isStatic) {
            Analyzer::Typecheck::emitDiagnostic(state, call.span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, "instance method calls require a receiver");
            return Option::NONE;
          }

          let staticSignatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(
            defStore,
            staticDefId,
          );
          let Option::SOME(staticSignature) = staticSignatureOpt else {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through non-function definitions");
            return Option::NONE;
          };

          if (call.typeArguments.length() > 0) {
            let staticParamTypes: Vector<Analyzer::TypeId> = Analyzer::Typecheck::methodExplicitParamTypes(
              defStore,
              &staticSignature,
              true,
            );

            if (let Option::SOME(specialized) = Analyzer::Typecheck::specializeMethodCallSignature(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              call,
              staticDefId,
              &staticParamTypes,
              staticSignature.returnType,
            )) {
              return Analyzer::Typecheck::checkCallArgumentsAgainstTypes(
                state,
                defStore,
                typeStore,
                symbols,
                module,
                resolvedBodies,
                callExprId,
                call,
                &specialized.paramTypes,
                specialized.returnType,
              );
            }

            // Either nothing was generic to specialize, in which case the written
            // arguments bind nothing and the declared signature stands, or the
            // count was wrong and already reported. Reporting the arguments too
            // would add one mismatch per argument on top of one mistake.
            if (Analyzer::Typecheck::methodCallTypeParamSymbols(defStore, staticDefId).length() > 0) {
              Analyzer::Typecheck::recordExprType(state, callExprId, staticSignature.returnType);
              return Option::SOME(staticSignature.returnType);
            }
          }

          return Analyzer::Typecheck::checkCallArgumentsAgainstSignature(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            callExprId,
            call,
            &staticSignature,
            0,
          );
        }
      }

      // Branch 2b: `Enum::Variant(args)` — a constructor, not a callee. Handled
      // before `checkExpr(callee)` so the bare-variant guard in
      // `checkResolvedValueExpr` never sees an applied constructor.
      let variantResolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, call.callee);
      if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Definition(variantDefId)) = variantResolvedOpt) {
        let constructorOpt: Option<Analyzer::Typecheck::VariantConstructor> = Analyzer::Typecheck::extractVariantConstructor(
          defStore,
          variantDefId,
        );

        if (let Option::SOME(constructor) = constructorOpt) {
          return Analyzer::Typecheck::checkVariantConstructionCall(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            callExprId,
            call,
            &constructor,
            expected,
          );
        }
      }

      // Branch 3: existing flow, byte-for-byte.
      let _calleeType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        call.callee,
      );

      let resolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, call.callee);
      let Option::SOME(resolved) = resolvedOpt else {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "direct calls without resolved callee");
        return Option::NONE;
      };

      let functionDefId: Analyzer::DefinitionId = match (resolved) {
        Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> defId,
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
          // A local holding a function value carries its whole signature in its type, so the
          // call is checked against that rather than against a definition.
          return Analyzer::Typecheck::checkCallThroughLocal(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            callExprId,
            call,
            localId,
          );
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through type parameters");
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through unresolved callee");
          return Option::NONE;
        },
      };

      // The resolver stops at the first same-name function; sibling overloads
      // share the same published path, and the arguments pick among them.
      let mut selectedFunctionDefId: Analyzer::DefinitionId = functionDefId;
      let functionCandidates: Vector<Analyzer::DefinitionId> = Analyzer::Typecheck::freeFunctionOverloadCandidates(defStore, functionDefId);

      if (functionCandidates.length() > 1) {
        let functionNameOpt: Option<str> = Analyzer::Typecheck::functionDefName(defStore, symbols, functionDefId);
        let functionName: str = match (functionNameOpt) {
          Option::SOME(n) -> n,
          Option::NONE -> "function",
        };
        let selectedOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::selectStaticMethodOverload(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          &functionCandidates,
          call,
          call.span,
          functionName,
        );
        let Option::SOME(selected) = selectedOpt else {
          return Option::NONE;
        };
        selectedFunctionDefId = selected;
      }

      let signatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(
        defStore,
        selectedFunctionDefId,
      );
      let Option::SOME(signature) = signatureOpt else {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through non-function definitions");
        return Option::NONE;
      };

      return Analyzer::Typecheck::checkResolvedFunctionCall(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        callExprId,
        call,
        selectedFunctionDefId,
        &signature,
      );
    }

    /// Typecheck `Enum::Variant(args)`.
    ///
    /// The variant's declared payload types play the role of parameter types: arity
    /// comes from the payload length and the expression's type is the owning enum.
    /// For a generic enum the payload types still mention the enum's type parameters,
    /// so they are substituted with whatever the expected type supplies before the
    /// arguments are compared, and the construction produces the corresponding
    /// instance. With nothing to infer from, the payload types stay as written and a
    /// concrete argument is reported against them, which is what the reference does.
    function checkVariantConstructionCall(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      constructor: &Analyzer::Typecheck::VariantConstructor,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      // Type arguments written here bind nothing: the reference infers a variant's
      // arguments from the expected type and never reads the written list, so
      // reporting them would reject a construction it accepts.

      let typeArguments: Vector<Analyzer::TypeId> = Analyzer::Typecheck::inferVariantTypeArguments(
        defStore,
        typeStore,
        constructor,
        expected,
      );

      let mut constructedType: Analyzer::TypeId = constructor.enumType;
      if (typeArguments.length() > 0) {
        let mut typeStoreInstanceRef: &mut Analyzer::TypeStore = typeStore;
        constructedType = typeStoreInstanceRef.instance(constructor.enumDefId, Analyzer::Typecheck::copyTypeIdVector(&typeArguments));
      }

      Analyzer::Typecheck::recordExprType(state, call.callee, constructedType);

      let expectedArity: u64 = constructor.payload.length();

      if (call.arguments.length() != expectedArity) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), expectedArity);
        Analyzer::Typecheck::recordExprType(state, callExprId, constructedType);
        return Option::SOME(constructedType);
      }

      let mut index: u64 = 0;

      while (index < expectedArity) {
        let Option::SOME(argumentId) = call.arguments.get(index) else {
          index += 1;
          continue;
        };

        let mut expectedType: Option<Analyzer::TypeId> = Option::NONE;
        if (let Option::SOME(payloadType) = constructor.payload.get(index)) {
          let mut typeStoreSubstituteRef: &mut Analyzer::TypeStore = typeStore;
          expectedType = Option::SOME(typeStoreSubstituteRef.substitute(*payloadType, &constructor.typeParamSymbols, &typeArguments));
        }

        let actualOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          *argumentId,
          expectedType,
        );

        if (let Option::SOME(expectedPayload) = expectedType) {
          if (let Option::SOME(actual) = actualOpt) {
            if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, call.span, expectedPayload, actual)) {
              Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, call.span, expectedPayload, actual);
            }
          }
        }

        index += 1;
      }

      Analyzer::Typecheck::recordExprType(state, callExprId, constructedType);
      return Option::SOME(constructedType);
    }

    /// Typecheck a call whose callee is a local holding a function value.
    ///
    /// The signature comes from the local's own type instead of from a definition, so the
    /// parameter types are `TypeId`s directly rather than parameter definitions.
    function checkCallThroughLocal(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      localId: Analyzer::ResolverBodies::LocalId,
    ): Option<Analyzer::TypeId> {
      // A local holds a concrete function type with no type parameters left to
      // specialize, so type arguments have nothing to bind to.
      if (call.typeArguments.length() > 0) {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "type arguments on calls through local values");
        return Option::NONE;
      }

      let Option::SOME(binding) = Analyzer::Typecheck::lookupLocalBinding(state, localId) else {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through local values");
        return Option::NONE;
      };

      let Option::SOME(calleeType) = typeStore.get(binding.typeId) else {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "calls through local values");
        return Option::NONE;
      };

      let Analyzer::Type::Function(signature) = calleeType else {
        Analyzer::Typecheck::emitCallOnNonCallable(state, typeStore, call.span, binding.typeId);
        return Option::NONE;
      };

      return Analyzer::Typecheck::checkCallArgumentsAgainstTypes(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        callExprId,
        call,
        &signature.params,
        signature.returnType,
      );
    }

    /// Typechecks `call.arguments` against parameter types already flattened to
    /// `TypeId`s, and records `callExprId`'s type as `returnType`.
    ///
    /// Used where the callee's parameters are no longer definitions: a local holding a
    /// function value, and a generic callee whose signature was specialized from
    /// explicit type arguments. An arity mismatch is reported and the arguments are
    /// still checked, so a wrong count does not hide a wrong type as well.
    function checkCallArgumentsAgainstTypes(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      paramTypes: &Vector<Analyzer::TypeId>,
      returnType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      let expectedArity: u64 = paramTypes.length();

      if (call.arguments.length() != expectedArity) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), expectedArity);
      }

      let mut argIndex: u64 = 0;

      while (argIndex < call.arguments.length()) {
        let Option::SOME(argExprId) = call.arguments.get(argIndex) else {
          argIndex += 1;
          continue;
        };

        let expectedParam: Option<Analyzer::TypeId> = match (paramTypes.get(argIndex)) {
          Option::SOME(paramType) -> Option::SOME(*paramType),
          Option::NONE -> Option::NONE,
        };

        let actualOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          *argExprId,
          expectedParam,
        );

        if (let Option::SOME(expectedType) = expectedParam) {
          if (let Option::SOME(actualType) = actualOpt) {
            if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, call.span, expectedType, actualType)) {
              Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, call.span, expectedType, actualType);
            }
          }
        }

        argIndex += 1;
      }

      Analyzer::Typecheck::recordExprType(state, callExprId, returnType);
      return Option::SOME(returnType);
    }

    /// Resolve the type arguments written at a call site or a record initializer.
    ///
    /// `NONE` means one of them names something this pass cannot resolve to a type, and
    /// is reported before returning. The reference analyzer substitutes its error type
    /// for such an argument and carries on; with no error type to name, refusing outright
    /// is the honest equivalent, the same choice `inferTypeArguments` already documents.
    function resolveWrittenTypeArguments(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      span: SourceSpan,
      typeArgumentIds: &Vector<Ast::TypeId>,
    ): Option<Vector<Analyzer::TypeId>> {
      let mut resolvedArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < typeArgumentIds.length()) {
        let Option::SOME(annotationId) = typeArgumentIds.get(index) else {
          Analyzer::Typecheck::emitUnsupported(state, span, "unresolved type arguments");
          return Option::NONE;
        };

        let resolvedOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::resolveLocalAnnotation(
          defStore,
          typeStore,
          symbols,
          module,
          *annotationId,
        );
        let Option::SOME(resolved) = resolvedOpt else {
          Analyzer::Typecheck::emitUnsupported(state, span, "unsupported type argument");
          return Option::NONE;
        };

        resolvedArguments.push(resolved);
        index += 1;
      }

      return Option::SOME(resolvedArguments);
    }

    /// Resolve the call site's explicit type arguments and substitute them through a
    /// callee's declared signature.
    ///
    /// `paramSymbols` are the callee's type parameters and must already agree in number
    /// with `call.typeArguments`. `NONE` means some part of the signature could not be
    /// specialized — a type argument this pass cannot resolve to a type, or a parameter
    /// that is not an ordinary variable — and is always reported before returning.
    function instantiateCallSignature(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      call: &Ast::Expression::Call,
      paramSymbols: &Vector<Analyzer::SymbolId>,
      signature: &Analyzer::Typecheck::FunctionSignature,
    ): Option<Analyzer::Typecheck::CalleeSignature> {
      let Option::SOME(typeArguments) = Analyzer::Typecheck::resolveWrittenTypeArguments(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        call.span,
        &call.typeArguments,
      ) else {
        return Option::NONE;
      };

      let mut specializedParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut paramIndex: u64 = 0;

      while (paramIndex < signature.params.length()) {
        let Option::SOME(paramDefId) = signature.params.get(paramIndex) else {
          Analyzer::Typecheck::emitUnsupported(state, call.span, "unresolved function parameters");
          return Option::NONE;
        };

        let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
          Analyzer::Typecheck::emitUnsupported(state, call.span, "unresolved function parameters");
          return Option::NONE;
        };

        let declaredTypeOpt: Option<Analyzer::TypeId> = match (paramDef) {
          Analyzer::Definition::Variable(parameter) -> Option::SOME(parameter.declaredType),
          _ -> Option::NONE,
        };
        let Option::SOME(declaredType) = declaredTypeOpt else {
          Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
          return Option::NONE;
        };

        let mut typeStoreParamRef: &mut Analyzer::TypeStore = typeStore;
        specializedParams.push(typeStoreParamRef.substitute(declaredType, paramSymbols, &typeArguments));

        paramIndex += 1;
      }

      let mut typeStoreReturnRef: &mut Analyzer::TypeStore = typeStore;
      let specializedReturn: Analyzer::TypeId = typeStoreReturnRef.substitute(signature.returnType, paramSymbols, &typeArguments);

      return Option::SOME(Analyzer::Typecheck::CalleeSignature {
        paramTypes: specializedParams,
        returnType: specializedReturn,
      });
    }

    /// Substitute written type arguments through a signature already flattened to types.
    ///
    /// The counterpart of `instantiateCallSignature` for callers whose parameters are
    /// `TypeId`s rather than parameter definitions — the pipe path, which flattens them
    /// before it knows whether anything will be specialized. `paramSymbols` must already
    /// agree in number with `typeArgumentIds`. `NONE` means a type argument this pass
    /// cannot resolve to a type, and is reported before returning.
    function specializeSignatureFromWrittenTypeArguments(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      span: SourceSpan,
      typeArgumentIds: &Vector<Ast::TypeId>,
      paramSymbols: &Vector<Analyzer::SymbolId>,
      paramTypes: &Vector<Analyzer::TypeId>,
      returnType: Analyzer::TypeId,
    ): Option<Analyzer::Typecheck::CalleeSignature> {
      let Option::SOME(typeArguments) = Analyzer::Typecheck::resolveWrittenTypeArguments(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        span,
        typeArgumentIds,
      ) else {
        return Option::NONE;
      };

      let mut specializedParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < paramTypes.length()) {
        let Option::SOME(paramType) = paramTypes.get(index) else {
          index += 1;
          continue;
        };

        let declaredType: Analyzer::TypeId = *paramType;
        let mut typeStoreParamRef: &mut Analyzer::TypeStore = typeStore;
        specializedParams.push(typeStoreParamRef.substitute(declaredType, paramSymbols, &typeArguments));

        index += 1;
      }

      let mut typeStoreReturnRef: &mut Analyzer::TypeStore = typeStore;
      let specializedReturn: Analyzer::TypeId = typeStoreReturnRef.substitute(returnType, paramSymbols, &typeArguments);

      return Option::SOME(Analyzer::Typecheck::CalleeSignature {
        paramTypes: specializedParams,
        returnType: specializedReturn,
      });
    }

    /// Typecheck a direct call to a resolved function, specializing its signature first
    /// when the call site wrote explicit type arguments.
    ///
    /// Type arguments on a callee that declares none are ignored rather than reported,
    /// matching the reference analyzer. A count that disagrees with the declared type
    /// parameters is reported and the arguments are left unchecked: every parameter type
    /// still mentions those type parameters, so checking against them would add one
    /// mismatch per argument on top of the real mistake. The call still types as the
    /// declared return type, so the surrounding expression keeps checking.
    function checkResolvedFunctionCall(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      functionDefId: Analyzer::DefinitionId,
      signature: &Analyzer::Typecheck::FunctionSignature,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() == 0) {
        // A generic function called without written type arguments infers
        // them from the argument types, the way the host's unification does:
        // the first argument whose declared/actual pair binds every type
        // parameter decides.
        let inferSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::calleeTypeParamSymbols(defStore, functionDefId);

        if (inferSymbols.length() > 0 && call.arguments.length() > 0) {
          let declaredParams: Vector<Analyzer::TypeId> = Analyzer::Typecheck::staticOverloadParamTypes(defStore, functionDefId)!;

          let mut inferArgTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut inferArgIndex: u64 = 0;
          while (inferArgIndex < call.arguments.length()) {
            let Option::SOME(argExprId) = call.arguments.get(inferArgIndex) else {
              inferArgIndex += 1;
              continue;
            };
            let Option::SOME(argType) = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, *argExprId) else {
              return Option::NONE;
            };
            inferArgTypes.push(argType);
            inferArgIndex += 1;
          }

          let mut pairIndex: u64 = 0;
          while (pairIndex < inferArgTypes.length() && pairIndex < declaredParams.length()) {
            let Option::SOME(declaredParam) = declaredParams.get(pairIndex) else {
              pairIndex += 1;
              continue;
            };
            let Option::SOME(argType) = inferArgTypes.get(pairIndex) else {
              pairIndex += 1;
              continue;
            };

            let mut typeStoreInferRef: &mut Analyzer::TypeStore = typeStore;
            if (let Option::SOME(resolvedArgs) = typeStoreInferRef.inferTypeArguments(*declaredParam, *argType, &inferSymbols)) {
              let mut specializedParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
              let mut substituteIndex: u64 = 0;

              while (substituteIndex < declaredParams.length()) {
                let Option::SOME(paramType) = declaredParams.get(substituteIndex) else {
                  substituteIndex += 1;
                  continue;
                };

                let mut typeStoreSubRef: &mut Analyzer::TypeStore = typeStore;
                specializedParams.push(typeStoreSubRef.substitute(*paramType, &inferSymbols, &resolvedArgs));
                substituteIndex += 1;
              }

              let mut typeStoreRetRef: &mut Analyzer::TypeStore = typeStore;
              let specializedReturn: Analyzer::TypeId = typeStoreRetRef.substitute(signature.returnType, &inferSymbols, &resolvedArgs);

              return Analyzer::Typecheck::checkCallArgumentsAgainstTypes(
                state,
                defStore,
                typeStore,
                symbols,
                module,
                resolvedBodies,
                callExprId,
                call,
                &specializedParams,
                specializedReturn,
              );
            }

            pairIndex += 1;
          }
        }

        return Analyzer::Typecheck::checkCallArgumentsAgainstSignature(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          callExprId,
          call,
          signature,
          0,
        );
      }

      let paramSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::calleeTypeParamSymbols(defStore, functionDefId);

      if (paramSymbols.length() == 0) {
        return Analyzer::Typecheck::checkCallArgumentsAgainstSignature(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          callExprId,
          call,
          signature,
          0,
        );
      }

      if (call.typeArguments.length() != paramSymbols.length()) {
        Analyzer::Typecheck::emitTypeArgumentCountMismatch(
          state,
          call.span,
          call.typeArguments.length(),
          paramSymbols.length(),
        );
        Analyzer::Typecheck::recordExprType(state, callExprId, signature.returnType);
        return Option::SOME(signature.returnType);
      }

      let specializedOpt: Option<Analyzer::Typecheck::CalleeSignature> = Analyzer::Typecheck::instantiateCallSignature(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        call,
        &paramSymbols,
        signature,
      );
      let Option::SOME(specialized) = specializedOpt else {
        return Option::NONE;
      };

      return Analyzer::Typecheck::checkCallArgumentsAgainstTypes(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        callExprId,
        call,
        &specialized.paramTypes,
        specialized.returnType,
      );
    }

    /// Typechecks `call.arguments` against `signature.params[firstParamIndex..]`
    /// and records `callExprId`'s type as `signature.returnType`. `firstParamIndex`
    /// skips the receiver (`self`) for instance-method calls (1) and is a no-op
    /// for direct/static calls (0) — behavior-preserving at `firstParamIndex = 0`
    /// relative to the original inline `checkCallExpr` arg loop.
    function checkCallArgumentsAgainstSignature(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      signature: &Analyzer::Typecheck::FunctionSignature,
      firstParamIndex: u64,
    ): Option<Analyzer::TypeId> {
      let expectedArity: u64 = signature.params.length() - firstParamIndex;
      let actualArity: u64 = call.arguments.length();

      if (actualArity != expectedArity) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, actualArity, expectedArity);
        Analyzer::Typecheck::recordExprType(state, callExprId, signature.returnType);
        return Option::SOME(signature.returnType);
      }

      let mut index: u64 = 0;
      while (index < expectedArity) {
        let Option::SOME(argumentId) = call.arguments.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(paramDefId) = signature.params.get(index + firstParamIndex) else {
          index += 1;
          continue;
        };

        let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
          index += 1;
          continue;
        };

        // Only a `Variable` (ordinary parameter) has a declared type worth
        // propagating as the expectation; every other definition kind hits
        // the "non-variable function parameters" wall below regardless of
        // the argument's own type, so no expectation is threaded for them.
        let expectedType: Option<Analyzer::TypeId> = match (paramDef) {
          Analyzer::Definition::Variable(parameter) -> Option::SOME(parameter.declaredType),
          Analyzer::Definition::Function(_) -> Option::NONE,
          Analyzer::Definition::Record(_) -> Option::NONE,
          Analyzer::Definition::Enum(_) -> Option::NONE,
          Analyzer::Definition::Field(_) -> Option::NONE,
          Analyzer::Definition::Variant(_) -> Option::NONE,
          Analyzer::Definition::TypeParam(_) -> Option::NONE,
          Analyzer::Definition::TypeAlias(_) -> Option::NONE,
          Analyzer::Definition::Trait(_) -> Option::NONE,
          Analyzer::Definition::Method(_) -> Option::NONE,
        };

        let argumentTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          *argumentId,
          expectedType,
        );
        let Option::SOME(argumentType) = argumentTypeOpt else {
          index += 1;
          continue;
        };

        match (paramDef) {
          Analyzer::Definition::Variable(parameter) -> {
            if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, call.span, parameter.declaredType, argumentType)) {
              Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, call.span, parameter.declaredType, argumentType);
              Analyzer::Typecheck::recordExprType(state, callExprId, signature.returnType);
              return Option::SOME(signature.returnType);
            }
          },
          Analyzer::Definition::Function(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Record(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Enum(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Field(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Variant(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::TypeParam(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::TypeAlias(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Trait(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
          Analyzer::Definition::Method(_) -> {
            Analyzer::Typecheck::emitUnsupported(state, call.span, "non-variable function parameters");
            return Option::NONE;
          },
        };

        index += 1;
      }

      Analyzer::Typecheck::recordExprType(state, callExprId, signature.returnType);
      return Option::SOME(signature.returnType);
    }

    /// Typechecks `expr.method(args)` where `call.callee` is a `MemberAccess`
    /// with `Dot`. Resolves the receiver's owner via `requireMethodOwner`,
    /// looks the member up in `instanceMethods` (falling back to `staticMethods`
    /// for the static-through-instance diagnostic, ADR D10), enforces the
    /// mut-self check (ADR D7, Local-only), then typechecks the call arguments
    /// against the method signature with `self` excluded (`firstParamIndex = 1`).
    /// The `MemberAccess` node itself records a receiver-less function type
    /// (ADR D9) — never reaches `checkMemberAccessExpr`.
    function checkInstanceMethodCallExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      memberExprId: Ast::ExpressionId,
      ma: &Ast::Expression::MemberAccess,
    ): Option<Analyzer::TypeId> {
      let objectTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        ma.object,
      );
      let Option::SOME(objectType) = objectTypeOpt else {
        return Option::NONE;
      };

      let receiverType: Analyzer::TypeId = Analyzer::Typecheck::derefReceiverType(defStore, typeStore, objectType);

      // An `@extension(T)` function answers `value.name(args)` for a receiver
      // of type `T`, including the primitives no record or enum owns. Owner
      // methods win: the lookup only runs when the receiver has no owner able
      // to carry the name.
      if (let Option::SOME(extensionDefId) = Analyzer::Typecheck::lookupExtensionFunction(
        defStore,
        typeStore,
        symbols,
        receiverType,
        ma.member.toStr(),
      )) {
        return Analyzer::Typecheck::checkExtensionMethodCall(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          callExprId,
          call,
          memberExprId,
          ma,
          extensionDefId,
          objectType,
        );
      }

      let ownerOpt: Option<Analyzer::Typecheck::RequiredMethodOwner> = Analyzer::Typecheck::requireMethodOwner(
        state,
        defStore,
        typeStore,
        ma.span,
        receiverType,
        "method call target must be a non-generic record or enum",
        "typecheck does not support generic method receivers",
      );
      let Option::SOME(owner) = ownerOpt else {
        return Option::NONE;
      };

      let memberName: str = ma.member.toStr();

      let candidateSet: Vector<Analyzer::DefinitionId> = Analyzer::ResolverBodies::lookupMethodCandidatesInTable(
        defStore,
        &owner.instanceMethods,
        memberName,
        symbols,
      );

      let mut instanceOpt: Option<Analyzer::DefinitionId> = Option::NONE;

      if (candidateSet.length() > 1) {
        let selectedOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::selectMethodOverload(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          &owner,
          &candidateSet,
          call,
          ma.span,
          memberName,
        );
        let Option::SOME(selected) = selectedOpt else {
          return Option::NONE;
        };
        instanceOpt = Option::SOME(selected);
      } else if (let Option::SOME(single) = candidateSet.get(0)) {
        instanceOpt = Option::SOME(*single);
      }

      let Option::SOME(methodDefId) = instanceOpt else {
        let staticOpt: Option<Analyzer::DefinitionId> = Analyzer::ResolverBodies::lookupMethodInTable(
          defStore,
          &owner.staticMethods,
          memberName,
          symbols,
        );

        if (staticOpt.isSome()) {
          let message: String = `static method \`${memberName}\` cannot be called through an instance`;
          Analyzer::Typecheck::emitDiagnostic(state, ma.span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, message.toStr());
          return Option::NONE;
        }

        Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, ma.span, DiagnosticCode::UNKNOWN_MEMBER, "unknown method", memberName);
        return Option::NONE;
      };

      let infoOpt: Option<Analyzer::Typecheck::MethodCallInfo> = Analyzer::Typecheck::lookupMethodDefInfo(defStore, methodDefId);
      let Option::SOME(info) = infoOpt else {
        Analyzer::Typecheck::emitUnsupported(state, ma.span, "method call through non-method definition");
        return Option::NONE;
      };

      if (info.selfMutable) {
        Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, ma.object);

        // A reference receiver carries its mutability in the reference type,
        // not in the local binding: `let mut r: &R` still cannot reach a
        // `mut self` method, while `let r: &mut R` can.
        let referenceMutability: Option<boolean> = Analyzer::Typecheck::receiverReferenceMutability(defStore, typeStore, objectType);

        if (let Option::SOME(referenceMutable) = referenceMutability) {
          if (!referenceMutable) {
            Analyzer::Typecheck::emitDiagnostic(state, ma.span, DiagnosticCode::MUTABILITY_VIOLATION, "cannot call mutable method through a shared reference");
            return Option::NONE;
          }
        } else {
          let receiverRefOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, ma.object);

          if (let Option::SOME(receiverRef) = receiverRefOpt) {
            match (receiverRef) {
              Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
                let bindingOpt: Option<Analyzer::Typecheck::LocalBindingInfo> = Analyzer::Typecheck::lookupLocalBinding(state, localId);

                if (let Option::SOME(binding) = bindingOpt) {
                  if (!binding.mutable) {
                    Analyzer::Typecheck::emitDiagnostic(state, ma.span, DiagnosticCode::MUTABILITY_VIOLATION, "cannot call mutable method on immutable receiver");
                    return Option::NONE;
                  }
                }
              },
              // TODO(receiver-place-mutability): non-Local receiver places (record
              // fields, call results, etc.) are not checked for mutability here —
              // accepted debt for this slice (ADR D7).
              Analyzer::ResolverBodies::ResolvedRef::Definition(_) -> {},
              Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {},
              Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {},
            };
          }
        }
      }

      let signatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(
        defStore,
        methodDefId,
      );
      let Option::SOME(signature) = signatureOpt else {
        Analyzer::Typecheck::emitUnsupported(state, ma.span, "calls through non-function definitions");
        return Option::NONE;
      };

      let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut paramIndex: u64 = 1;
      while (paramIndex < signature.params.length()) {
        let Option::SOME(paramDefId) = signature.params.get(paramIndex) else {
          paramIndex += 1;
          continue;
        };
        let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
          paramIndex += 1;
          continue;
        };

        match (paramDef) {
          Analyzer::Definition::Variable(parameter) -> {
            paramTypes.push(parameter.declaredType);
          },
          Analyzer::Definition::Function(_) -> {},
          Analyzer::Definition::Record(_) -> {},
          Analyzer::Definition::Enum(_) -> {},
          Analyzer::Definition::Field(_) -> {},
          Analyzer::Definition::Variant(_) -> {},
          Analyzer::Definition::TypeParam(_) -> {},
          Analyzer::Definition::TypeAlias(_) -> {},
          Analyzer::Definition::Trait(_) -> {},
          Analyzer::Definition::Method(_) -> {},
        };

        paramIndex += 1;
      }

      // An instantiated receiver says what the owner's type parameters stand for, and
      // type arguments written at the call site say what the method's own stand for.
      // Both are applied, in that order, before the member access is typed and before
      // any argument is compared.
      let mut effective: Analyzer::Typecheck::CalleeSignature = Analyzer::Typecheck::CalleeSignature {
        paramTypes: Analyzer::Typecheck::copyTypeIdVector(&paramTypes),
        returnType: signature.returnType,
      };
      let mut specialized: boolean = false;

      if (owner.typeArguments.length() > 0) {
        effective = Analyzer::Typecheck::substituteOwnerTypeArguments(
          typeStore,
          &owner,
          &effective.paramTypes,
          effective.returnType,
        );
        specialized = true;
      }

      if (call.typeArguments.length() > 0) {
        let writtenOpt: Option<Analyzer::Typecheck::CalleeSignature> = Analyzer::Typecheck::specializeMethodCallSignature(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          call,
          methodDefId,
          &effective.paramTypes,
          effective.returnType,
        );

        if (let Option::SOME(written) = writtenOpt) {
          effective = written;
          specialized = true;
        } else if (Analyzer::Typecheck::methodCallTypeParamSymbols(defStore, methodDefId).length() > 0) {
          // The count was wrong and has been reported. Every parameter type still
          // mentions the type parameters it was meant to bind, so the arguments are
          // left unchecked and the call keeps the method's declared return type.
          let mut typeStoreReportedRef: &mut Analyzer::TypeStore = typeStore;
          let reportedMemberType: Analyzer::TypeId = typeStoreReportedRef.functionType(
            Analyzer::Typecheck::copyTypeIdVector(&effective.paramTypes),
            effective.returnType,
          );
          Analyzer::Typecheck::recordExprType(state, memberExprId, reportedMemberType);
          Analyzer::Typecheck::recordExprType(state, callExprId, effective.returnType);

          return Option::SOME(effective.returnType);
        }
      }

      if (specialized) {
        let mut typeStoreSpecializedRef: &mut Analyzer::TypeStore = typeStore;
        let specializedMemberType: Analyzer::TypeId = typeStoreSpecializedRef.functionType(
          Analyzer::Typecheck::copyTypeIdVector(&effective.paramTypes),
          effective.returnType,
        );
        Analyzer::Typecheck::recordExprType(state, memberExprId, specializedMemberType);

        return Analyzer::Typecheck::checkCallArgumentsAgainstTypes(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          callExprId,
          call,
          &effective.paramTypes,
          effective.returnType,
        );
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let memberAccessType: Analyzer::TypeId = typeStoreRef.functionType(paramTypes, signature.returnType);
      Analyzer::Typecheck::recordExprType(state, memberExprId, memberAccessType);

      return Analyzer::Typecheck::checkCallArgumentsAgainstSignature(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        callExprId,
        call,
        &signature,
        1,
      );
    }

    /// The declared parameter types of `methodDefId` with the owner's type
    /// arguments substituted in, self excluded. NONE when the definition is
    /// not a callable signature.
    function methodOverloadParamTypes(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      owner: &Analyzer::Typecheck::RequiredMethodOwner,
      methodDefId: Analyzer::DefinitionId,
    ): Option<Vector<Analyzer::TypeId>> {
      let signatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(defStore, methodDefId);
      let Option::SOME(signature) = signatureOpt else {
        return Option::NONE;
      };

      let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut paramIndex: u64 = 1;

      while (paramIndex < signature.params.length()) {
        let Option::SOME(paramDefId) = signature.params.get(paramIndex) else {
          paramIndex += 1;
          continue;
        };

        if (let Option::SOME(Analyzer::Definition::Variable(parameter)) = defStore.get(*paramDefId)) {
          paramTypes.push(parameter.declaredType);
        }

        paramIndex += 1;
      }

      if (owner.typeArguments.length() == owner.typeParamSymbols.length() && owner.typeParamSymbols.length() > 0) {
        let substituted: Analyzer::Typecheck::CalleeSignature = Analyzer::Typecheck::substituteOwnerTypeArguments(
          typeStore,
          owner,
          &paramTypes,
          signature.returnType,
        );
        return Option::SOME(substituted.paramTypes);
      }

      return Option::SOME(paramTypes);
    }

    /// The method's declared name, for diagnostics.
    function methodDefName(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      methodDefId: Analyzer::DefinitionId,
    ): Option<str> {
      let Option::SOME(Analyzer::Definition::Method(methodDef)) = defStore.get(methodDefId) else {
        return Option::NONE;
      };

      return symbols.resolve(methodDef.name);
    }

    /// The function's declared name, for diagnostics.
    function functionDefName(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      functionDefId: Analyzer::DefinitionId,
    ): Option<str> {
      let Option::SOME(Analyzer::Definition::Function(functionDef)) = defStore.get(functionDefId) else {
        return Option::NONE;
      };

      return symbols.resolve(functionDef.name);
    }

    /// The free-function overload set: every function definition sharing the
    /// name AND the published written path (`Fs::read`), so same-named
    /// functions in different namespaces stay apart.
    function freeFunctionOverloadCandidates(
      defStore: &mut Analyzer::DefinitionStore,
      functionDefId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      let Option::SOME(Analyzer::Definition::Function(functionDef)) = defStore.get(functionDefId) else {
        out.push(functionDefId);
        return out;
      };

      let nameSym: Analyzer::SymbolId = functionDef.name;

      let mut qualifiedName: String = String::create("");
      if (let Option::SOME(stored) = defStore.qualifiedNameOf(functionDefId)) {
        qualifiedName = stored.clone();
      }

      if (qualifiedName.length() == 0) {
        out.push(functionDefId);
        return out;
      }

      let mut index: u64 = 0;
      while (index < defStore.length()) {
        let candidateDefId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);

        let mut sameName: boolean = false;
        if (let Option::SOME(Analyzer::Definition::Function(candidateDef)) = defStore.get(candidateDefId)) {
          sameName = candidateDef.name.raw() == nameSym.raw();
        }

        if (!sameName) {
          index += 1;
          continue;
        }

        if (let Option::SOME(candidateQualified) = defStore.qualifiedNameOf(candidateDefId)) {
          if (candidateQualified.equals(qualifiedName.toStr())) {
            out.push(candidateDefId);
          }
        }

        index += 1;
      }

      if (out.length() == 0) {
        out.push(functionDefId);
      }

      return out;
    }

    /// The declared parameter types of a static method — no self slot to skip.
    function staticOverloadParamTypes(
      defStore: &mut Analyzer::DefinitionStore,
      methodDefId: Analyzer::DefinitionId,
    ): Option<Vector<Analyzer::TypeId>> {
      let signatureOpt: Option<Analyzer::Typecheck::FunctionSignature> = Analyzer::Typecheck::extractFunctionSignature(defStore, methodDefId);
      let Option::SOME(signature) = signatureOpt else {
        return Option::NONE;
      };

      let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut paramIndex: u64 = 0;

      while (paramIndex < signature.params.length()) {
        let Option::SOME(paramDefId) = signature.params.get(paramIndex) else {
          paramIndex += 1;
          continue;
        };

        if (let Option::SOME(Analyzer::Definition::Variable(parameter)) = defStore.get(*paramDefId)) {
          paramTypes.push(parameter.declaredType);
        }

        paramIndex += 1;
      }

      return Option::SOME(paramTypes);
    }

    /// The static-method overload set sharing `staticDefId`'s name on its
    /// owner. A single-element set means no selection is needed.
    function staticOverloadCandidates(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      staticDefId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      let Option::SOME(Analyzer::Definition::Method(staticMethod)) = defStore.get(staticDefId) else {
        out.push(staticDefId);
        return out;
      };

      let ownerDefId: Analyzer::DefinitionId = staticMethod.owner;
      let nameOpt: Option<str> = symbols.resolve(staticMethod.name);
      let Option::SOME(name) = nameOpt else {
        out.push(staticDefId);
        return out;
      };

      let mut table: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      match (defStore.get(ownerDefId)) {
        Option::SOME(Analyzer::Definition::Record(rec)) -> {
          table = Analyzer::Typecheck::copyDefinitionIdVector(&rec.staticMethods);
        },
        Option::SOME(Analyzer::Definition::Enum(en)) -> {
          table = Analyzer::Typecheck::copyDefinitionIdVector(&en.staticMethods);
        },
        _ -> {
          out.push(staticDefId);
          return out;
        },
      };

      let found: Vector<Analyzer::DefinitionId> = Analyzer::ResolverBodies::lookupMethodCandidatesInTable(defStore, &table, name, symbols);

      if (found.length() == 0) {
        out.push(staticDefId);
        return out;
      }

      return found;
    }

    /// Pick one static method among same-name candidates by arity and
    /// argument types — the static twin of `selectMethodOverload`, with no
    /// self slot and no owner substitution (a generic owner's statics go
    /// through the written-type-argument path instead).
    function selectStaticMethodOverload(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      candidates: &Vector<Analyzer::DefinitionId>,
      call: &Ast::Expression::Call,
      span: SourceSpan,
      memberName: str,
    ): Option<Analyzer::DefinitionId> {
      let mut argTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut argIndex: u64 = 0;

      while (argIndex < call.arguments.length()) {
        let Option::SOME(argExprId) = call.arguments.get(argIndex) else {
          argIndex += 1;
          continue;
        };

        let argTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, *argExprId);
        let Option::SOME(argType) = argTypeOpt else {
          return Option::NONE;
        };

        argTypes.push(argType);
        argIndex += 1;
      }

      let mut bestDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut bestCost: u64 = 0;
      let mut candidateIndex: u64 = 0;

      while (candidateIndex < candidates.length()) {
        let Option::SOME(candidateDefId) = candidates.get(candidateIndex) else {
          candidateIndex += 1;
          continue;
        };

        let paramTypesOpt: Option<Vector<Analyzer::TypeId>> = Analyzer::Typecheck::staticOverloadParamTypes(defStore, *candidateDefId);
        let Option::SOME(paramTypes) = paramTypesOpt else {
          candidateIndex += 1;
          continue;
        };

        if (paramTypes.length() != argTypes.length()) {
          candidateIndex += 1;
          continue;
        }

        let mut cost: u64 = 0;
        let mut matches: boolean = true;
        let mut i: u64 = 0;

        while (i < argTypes.length()) {
          let Option::SOME(argType) = argTypes.get(i) else {
            i += 1;
            continue;
          };
          let Option::SOME(paramType) = paramTypes.get(i) else {
            i += 1;
            continue;
          };

          if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, *paramType, *argType)) {
            i += 1;
            continue;
          }

          if (Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, *paramType, *argType)) {
            cost += 1;
            i += 1;
            continue;
          }

          matches = false;
          break;
        }

        if (matches) {
          if (bestDefIds.length() == 0 || cost < bestCost) {
            bestDefIds = Vector::new<Analyzer::DefinitionId>();
            bestDefIds.push(*candidateDefId);
            bestCost = cost;
          } else if (cost == bestCost) {
            bestDefIds.push(*candidateDefId);
          }
        }

        candidateIndex += 1;
      }

      if (bestDefIds.length() == 0) {
        let message: String = `no overload of \`${memberName}\` matches the call's argument types`;
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::NO_OVERLOAD_MATCHES, message.toStr());
        return Option::NONE;
      }

      if (bestDefIds.length() > 1) {
        let message: String = `ambiguous call to overloaded \`${memberName}\``;
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::AMBIGUOUS_OVERLOAD, message.toStr());
        return Option::NONE;
      }

      let Option::SOME(winner) = bestDefIds.get(0) else {
        return Option::NONE;
      };

      return Option::SOME(*winner);
    }

    /// Pick one method among same-name candidates by arity and argument types,
    /// mirroring the host's `resolve_overload`: an exact type match costs 0, a
    /// value-satisfies match costs 1, anything else disqualifies. A unique
    /// lowest cost wins; a tie is ambiguous (A0101) and no survivor is a
    /// no-match (A0100). Arguments are typed once with no expectation — a
    /// failing argument has already reported itself, so the call just bails.
    function selectMethodOverload(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      owner: &Analyzer::Typecheck::RequiredMethodOwner,
      candidates: &Vector<Analyzer::DefinitionId>,
      call: &Ast::Expression::Call,
      span: SourceSpan,
      memberName: str,
    ): Option<Analyzer::DefinitionId> {
      let mut argTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut argIndex: u64 = 0;

      while (argIndex < call.arguments.length()) {
        let Option::SOME(argExprId) = call.arguments.get(argIndex) else {
          argIndex += 1;
          continue;
        };

        let argTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, *argExprId);
        let Option::SOME(argType) = argTypeOpt else {
          return Option::NONE;
        };

        argTypes.push(argType);
        argIndex += 1;
      }

      let mut bestDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut bestCost: u64 = 0;
      let mut candidateIndex: u64 = 0;

      while (candidateIndex < candidates.length()) {
        let Option::SOME(candidateDefId) = candidates.get(candidateIndex) else {
          candidateIndex += 1;
          continue;
        };

        let paramTypesOpt: Option<Vector<Analyzer::TypeId>> = Analyzer::Typecheck::methodOverloadParamTypes(defStore, typeStore, owner, *candidateDefId);
        let Option::SOME(paramTypes) = paramTypesOpt else {
          candidateIndex += 1;
          continue;
        };

        if (paramTypes.length() != argTypes.length()) {
          candidateIndex += 1;
          continue;
        }

        let mut cost: u64 = 0;
        let mut matches: boolean = true;
        let mut i: u64 = 0;

        while (i < argTypes.length()) {
          let Option::SOME(argType) = argTypes.get(i) else {
            i += 1;
            continue;
          };
          let Option::SOME(paramType) = paramTypes.get(i) else {
            i += 1;
            continue;
          };

          if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, *paramType, *argType)) {
            i += 1;
            continue;
          }

          if (Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, *paramType, *argType)) {
            cost += 1;
            i += 1;
            continue;
          }

          matches = false;
          break;
        }

        if (matches) {
          if (bestDefIds.length() == 0 || cost < bestCost) {
            bestDefIds = Vector::new<Analyzer::DefinitionId>();
            bestDefIds.push(*candidateDefId);
            bestCost = cost;
          } else if (cost == bestCost) {
            bestDefIds.push(*candidateDefId);
          }
        }

        candidateIndex += 1;
      }

      if (bestDefIds.length() == 0) {
        let message: String = `no overload of \`${memberName}\` matches the call's argument types`;
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::NO_OVERLOAD_MATCHES, message.toStr());
        return Option::NONE;
      }

      if (bestDefIds.length() > 1) {
        let message: String = `ambiguous call to overloaded \`${memberName}\``;
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::AMBIGUOUS_OVERLOAD, message.toStr());
        return Option::NONE;
      }

      let Option::SOME(winner) = bestDefIds.get(0) else {
        return Option::NONE;
      };

      return Option::SOME(*winner);
    }

    /// The `@extension` function that answers `name` for a receiver of
    /// `receiverType`, if one is declared.
    ///
    /// The attribute carries its target as raw text, so the match is made on
    /// the receiver type's own name: that is the only form both sides share
    /// without resolving types in the binder.
    function lookupExtensionFunction(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      receiverType: Analyzer::TypeId,
      name: str,
    ): Option<Analyzer::DefinitionId> {
      let receiverName: String = typeStore.nameOf(receiverType);
      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let wanted: Analyzer::SymbolId = symbolsRef.intern(name);
      let mut index: u64 = 0;

      while (index < defStore.length()) {
        let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);
        let Option::SOME(def) = defStore.get(defId) else {
          index += 1;
          continue;
        };

        if (let Analyzer::Definition::Function(function_) = def) {
          if (function_.name.raw() == wanted.raw()) {
            if (let Option::SOME(target) = &function_.extensionTarget) {
              if (target.equals(receiverName.toStr())) {
                return Option::SOME(defId);
              }
            }
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// Typecheck `value.name(args)` against an `@extension` function, which
    /// takes the receiver as its first parameter and the written arguments
    /// after it.
    function checkExtensionMethodCall(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      callExprId: Ast::ExpressionId,
      call: &Ast::Expression::Call,
      memberExprId: Ast::ExpressionId,
      ma: &Ast::Expression::MemberAccess,
      extensionDefId: Analyzer::DefinitionId,
      receiverType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(signature) = Analyzer::Typecheck::extractFunctionSignature(defStore, extensionDefId) else {
        Analyzer::Typecheck::emitUnsupported(state, ma.span, "calls through non-function definitions");
        return Option::NONE;
      };

      let paramTypes: Vector<Analyzer::TypeId> = Analyzer::Typecheck::methodExplicitParamTypes(defStore, &signature, true);

      if (paramTypes.isEmpty()) {
        Analyzer::Typecheck::emitUnsupported(state, ma.span, "extension functions without a receiver parameter");
        return Option::NONE;
      }

      if (let Option::SOME(receiverParam) = paramTypes.get(0)) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, ma.span, *receiverParam, receiverType)) {
          Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, ma.span, *receiverParam, receiverType);
        }
      }

      let mut explicitParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 1;

      while (index < paramTypes.length()) {
        if (let Option::SOME(paramType) = paramTypes.get(index)) {
          explicitParams.push(*paramType);
        }

        index += 1;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let memberAccessType: Analyzer::TypeId = typeStoreRef.functionType(
        Analyzer::Typecheck::copyTypeIdVector(&explicitParams),
        signature.returnType,
      );
      Analyzer::Typecheck::recordExprType(state, memberExprId, memberAccessType);

      return Analyzer::Typecheck::checkCallArgumentsAgainstTypes(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        callExprId,
        call,
        &explicitParams,
        signature.returnType,
      );
    }

    /// The type parameters a written type-argument list on a method call binds.
    ///
    /// The method's own when it declares any; otherwise its owner's, which is what
    /// `Type::staticMethod<T>()` on a generic declaration specializes. Empty when
    /// neither is generic: the arguments then bind nothing, and the reference ignores
    /// them rather than making the call fail.
    function methodCallTypeParamSymbols(
      defStore: &mut Analyzer::DefinitionStore,
      methodDefId: Analyzer::DefinitionId,
    ): Vector<Analyzer::SymbolId> {
      let ownSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::calleeTypeParamSymbols(defStore, methodDefId);
      if (ownSymbols.length() > 0) {
        return ownSymbols;
      }

      let Option::SOME(Analyzer::Definition::Method(method)) = defStore.get(methodDefId) else {
        return Vector::new<Analyzer::SymbolId>();
      };

      let ownerDefId: Analyzer::DefinitionId = method.owner;

      let Option::SOME(ownerDef) = defStore.get(ownerDefId) else {
        return Vector::new<Analyzer::SymbolId>();
      };

      match (ownerDef) {
        Analyzer::Definition::Record(record_) -> {
          return Analyzer::Typecheck::ownerTypeParamSymbols(defStore, &record_.typeParams);
        },
        Analyzer::Definition::Enum(enum_) -> {
          return Analyzer::Typecheck::ownerTypeParamSymbols(defStore, &enum_.typeParams);
        },
        _ -> {
          return Vector::new<Analyzer::SymbolId>();
        },
      };

      @panic("unreachable: methodCallTypeParamSymbols match did not return");
    }

    /// Specialize a method's flattened signature from the type arguments written at
    /// the call site.
    ///
    /// `NONE` means nothing was specialized, and says nothing about whether that was
    /// reported: a callee with no type parameters at all binds nothing and is silently
    /// left as declared, while a wrong argument count is reported here before
    /// returning. The caller tells the two apart by asking for the symbols itself.
    function specializeMethodCallSignature(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      call: &Ast::Expression::Call,
      methodDefId: Analyzer::DefinitionId,
      paramTypes: &Vector<Analyzer::TypeId>,
      returnType: Analyzer::TypeId,
    ): Option<Analyzer::Typecheck::CalleeSignature> {
      let paramSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::methodCallTypeParamSymbols(defStore, methodDefId);

      if (paramSymbols.length() == 0) {
        return Option::NONE;
      }

      if (call.typeArguments.length() != paramSymbols.length()) {
        Analyzer::Typecheck::emitTypeArgumentCountMismatch(
          state,
          call.span,
          call.typeArguments.length(),
          paramSymbols.length(),
        );
        return Option::NONE;
      }

      return Analyzer::Typecheck::specializeSignatureFromWrittenTypeArguments(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        call.span,
        &call.typeArguments,
        &paramSymbols,
        paramTypes,
        returnType,
      );
    }

    /// Specialize a method's flattened signature with the receiver's type arguments.
    ///
    /// The owner's type parameters are what a method on a generic declaration writes,
    /// and the receiver instance is what says which types they stand for. An owner
    /// whose arguments do not match its parameters in number substitutes nothing, so
    /// the declared types are compared as written rather than half-specialized.
    function substituteOwnerTypeArguments(
      typeStore: &mut Analyzer::TypeStore,
      owner: &Analyzer::Typecheck::RequiredMethodOwner,
      paramTypes: &Vector<Analyzer::TypeId>,
      returnType: Analyzer::TypeId,
    ): Analyzer::Typecheck::CalleeSignature {
      if (owner.typeArguments.length() != owner.typeParamSymbols.length()) {
        return Analyzer::Typecheck::CalleeSignature {
          paramTypes: Analyzer::Typecheck::copyTypeIdVector(paramTypes),
          returnType: returnType,
        };
      }

      let mut specializedParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < paramTypes.length()) {
        let Option::SOME(paramType) = paramTypes.get(index) else {
          index += 1;
          continue;
        };

        let declaredType: Analyzer::TypeId = *paramType;
        let mut typeStoreParamRef: &mut Analyzer::TypeStore = typeStore;
        specializedParams.push(typeStoreParamRef.substitute(declaredType, &owner.typeParamSymbols, &owner.typeArguments));

        index += 1;
      }

      let mut typeStoreReturnRef: &mut Analyzer::TypeStore = typeStore;
      let specializedReturn: Analyzer::TypeId = typeStoreReturnRef.substitute(returnType, &owner.typeParamSymbols, &owner.typeArguments);

      return Analyzer::Typecheck::CalleeSignature {
        paramTypes: specializedParams,
        returnType: specializedReturn,
      };
    }

    record RequiredRecordDef {
      public defId: Analyzer::DefinitionId;
      public typeId: Analyzer::TypeId;
      public fields: Vector<Analyzer::DefinitionId>;
      /// Interned names of the record's own declared type parameters, in
      /// declaration order. Empty for a non-generic record. Populated by
      /// `requireRecordAllowingGeneric`; left empty by `requireNonGenericRecord`,
      /// whose only caller never needs substitution.
      public typeParamSymbols: Vector<Analyzer::SymbolId>;
      /// Concrete type arguments matched positionally against `typeParamSymbols`.
      /// Empty unless the receiver was resolved from a `Type::Instance` or
      /// `checkRecordInitExpr` inferred arguments from an `expected` type.
      public typeArguments: Vector<Analyzer::TypeId>;
    }

    function requireNonGenericRecord(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonRecordMessage: str,
      genericMessage: str,
    ): Option<Analyzer::Typecheck::RequiredRecordDef> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Record(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Record(record_) -> {
              if (record_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
              let mut index: u64 = 0;
              while (index < record_.fields.length()) {
                let Option::SOME(fieldDefId) = record_.fields.get(index) else {
                  index += 1;
                  continue;
                };

                fields.push(*fieldDefId);
                index += 1;
              }

              return Option::SOME(Analyzer::Typecheck::RequiredRecordDef {
                defId: defId,
                typeId: record_.typeId,
                fields: fields,
                typeParamSymbols: Vector::new<Analyzer::SymbolId>(),
                typeArguments: Vector::new<Analyzer::TypeId>(),
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Instance(_) -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
          return Option::NONE;
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireNonGenericRecord match did not return");
    }

    /// Resolves a record receiver like `requireNonGenericRecord`, but also
    /// accepts a generic `Type::Record(defId)` (no type parameters bound yet)
    /// and a `Type::Instance(InstanceType)` (already applied to concrete type
    /// arguments). Fills `typeParamSymbols`/`typeArguments` on the result so
    /// callers can substitute field types via `TypeStore.substitute`.
    ///
    /// `requireNonGenericRecord` stays the resolution path for every other
    /// receiver shape (`checkMemberAccessExpr`'s non-`Instance` branch); this
    /// function never emits the generic-record rejection diagnostic.
    function requireRecordAllowingGeneric(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonRecordMessage: str,
    ): Option<Analyzer::Typecheck::RequiredRecordDef> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Record(defId) -> {
          let noTypeArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          return Analyzer::Typecheck::buildRequiredRecordDefForRecord(state, defStore, span, nonRecordMessage, defId, &noTypeArguments);
        },
        Analyzer::Type::Instance(instance) -> {
          return Analyzer::Typecheck::buildRequiredRecordDefForRecord(state, defStore, span, nonRecordMessage, instance.definition, &instance.typeArguments);
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireRecordAllowingGeneric match did not return");
    }

    /// Shared tail of `requireRecordAllowingGeneric`: resolves `defId` to its
    /// `RecordDef`, collects field ids and the record's own declared
    /// type-parameter symbols (in declaration order), and assembles the
    /// `RequiredRecordDef` result. `typeArguments` is passed through unchanged
    /// (empty for a bare generic `Record`, populated for an `Instance`).
    function buildRequiredRecordDefForRecord(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      span: SourceSpan,
      nonRecordMessage: str,
      defId: Analyzer::DefinitionId,
      typeArguments: &Vector<Analyzer::TypeId>,
    ): Option<Analyzer::Typecheck::RequiredRecordDef> {
      let Option::SOME(def) = defStore.get(defId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Record(record_) -> {
          let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let mut fieldIndex: u64 = 0;
          while (fieldIndex < record_.fields.length()) {
            let Option::SOME(fieldDefId) = record_.fields.get(fieldIndex) else {
              fieldIndex += 1;
              continue;
            };

            fields.push(*fieldDefId);
            fieldIndex += 1;
          }

          let mut typeParamSymbols: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();
          let mut typeParamIndex: u64 = 0;
          while (typeParamIndex < record_.typeParams.length()) {
            let Option::SOME(typeParamDefId) = record_.typeParams.get(typeParamIndex) else {
              typeParamIndex += 1;
              continue;
            };

            let Option::SOME(typeParamDef) = defStore.get(*typeParamDefId) else {
              typeParamIndex += 1;
              continue;
            };

            match (typeParamDef) {
              Analyzer::Definition::TypeParam(typeParam) -> {
                typeParamSymbols.push(typeParam.name);
              },
              _ -> {},
            };

            typeParamIndex += 1;
          }

          return Option::SOME(Analyzer::Typecheck::RequiredRecordDef {
            defId: defId,
            typeId: record_.typeId,
            fields: fields,
            typeParamSymbols: typeParamSymbols,
            typeArguments: Analyzer::Typecheck::copyTypeIdVector(typeArguments),
          });
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: buildRequiredRecordDefForRecord match did not return");
    }

    function findRecordFieldDef(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      recordDef: &Analyzer::Typecheck::RequiredRecordDef,
      name: str,
    ): Option<Analyzer::FieldDef> {
      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let fieldSymbol: Analyzer::SymbolId = symbolsRef.intern(name);
      let mut index: u64 = 0;

      while (index < recordDef.fields.length()) {
        let Option::SOME(fieldDefId) = recordDef.fields.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(def) = defStore.get(*fieldDefId) else {
          index += 1;
          continue;
        };

        match (def) {
          Analyzer::Definition::Field(fieldDef) -> {
            if (fieldDef.name.raw() == fieldSymbol.raw()) {
              return Option::SOME(Analyzer::FieldDef {
                name: fieldDef.name,
                fieldType: fieldDef.fieldType,
                owner: fieldDef.owner,
                index: fieldDef.index,
              });
            }
          },
          _ -> {},
        };

        index += 1;
      }

      return Option::NONE;
    }

    function emitNamedRecordFieldDiagnostic(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      code: str,
      prefix: str,
      name: str,
    ): void {
      let message: String = String::create(prefix).concat(" `").concat(name).concat("`");
      Analyzer::Typecheck::emitDiagnostic(state, span, code, message.toStr());
    }

    /// S2 (design D5) branch of `checkMemberAccessExpr` for an `Instance`
    /// receiver: resolves through `requireRecordAllowingGeneric` (which fills
    /// `typeParamSymbols`/`typeArguments` from the instance) and returns the
    /// field's type substituted via `TypeStore.substitute`. Split out so the
    /// non-`Instance` branch in `checkMemberAccessExpr` stays byte-identical
    /// to its pre-S2 shape (`requireNonGenericRecord`, unsubstituted field
    /// type) — see the risk register in design obs #14087 rev 2.
    function checkMemberAccessOnInstanceReceiver(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::MemberAccess,
      receiverType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      let recordDefOpt: Option<Analyzer::Typecheck::RequiredRecordDef> = Analyzer::Typecheck::requireRecordAllowingGeneric(
        state,
        defStore,
        typeStore,
        value.span,
        receiverType,
        "member access target must be a non-generic record",
      );
      let Option::SOME(recordDef) = recordDefOpt else {
        return Option::NONE;
      };

      let fieldDefOpt: Option<Analyzer::FieldDef> = Analyzer::Typecheck::findRecordFieldDef(
        defStore,
        symbols,
        &recordDef,
        value.member.toStr(),
      );
      let Option::SOME(fieldDef) = fieldDefOpt else {
        Analyzer::Typecheck::emitBareMethodReferenceOrUnknownField(state, defStore, symbols, value.span, &recordDef, value.member.toStr());
        return Option::NONE;
      };

      let mut typeStoreSubstituteRef: &mut Analyzer::TypeStore = typeStore;
      let substitutedFieldType: Analyzer::TypeId = typeStoreSubstituteRef.substitute(fieldDef.fieldType, &recordDef.typeParamSymbols, &recordDef.typeArguments);

      Analyzer::Typecheck::recordExprType(state, exprId, substitutedFieldType);
      return Option::SOME(substitutedFieldType);
    }

    function checkMemberAccessExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::MemberAccess,
    ): Option<Analyzer::TypeId> {
      if (value.operator != Ast::Expression::AccessOperator::Dot) {
        Analyzer::Typecheck::emitUnsupported(state, value.span, "member access");
        return Option::NONE;
      }

      let objectTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.object,
      );
      let Option::SOME(objectType) = objectTypeOpt else {
        return Option::NONE;
      };

      let receiverType: Analyzer::TypeId = Analyzer::Typecheck::derefReceiverType(defStore, typeStore, objectType);

      // Non-emitting shape peek (design D5): `resolveAliasChainChecked` emits
      // nothing itself, so this look-ahead cannot double-diagnose. Only a
      // receiver that peeks as `Type::Instance` (no cyclic alias) takes the
      // substituting path; every other shape — cyclic alias, bare generic
      // `Record`, non-generic `Record`, non-record — falls through to
      // `requireNonGenericRecord` on the *original* `receiverType`, so that
      // helper re-resolves and owns every diagnostic it already owns today,
      // unchanged.
      let peeked: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, receiverType);

      let mut isInstanceReceiver: boolean = false;
      let mut isRecordReceiver: boolean = false;
      if (peeked.cycleAlias.isNone()) {
        if (let Option::SOME(peekedType) = typeStore.get(peeked.typeId)) {
          match (peekedType) {
            Analyzer::Type::Instance(_) -> {
              isInstanceReceiver = true;
            },
            Analyzer::Type::Record(_) -> {
              isRecordReceiver = true;
            },
            _ -> {},
          };
        }
      }

      if (isInstanceReceiver) {
        return Analyzer::Typecheck::checkMemberAccessOnInstanceReceiver(state, defStore, typeStore, symbols, exprId, value, receiverType);
      }

      // A receiver that holds no fields at all is a member-access error, not a
      // type mismatch: the reference analyzer reports its own
      // `DotAccessOnNonRecord`/`DotAccessOnEnum` here. Only a cyclic alias and
      // a `Type::Record` receiver fall through to `requireNonGenericRecord`,
      // which keeps owning the cycle and generic-record rejections unchanged.
      if (peeked.cycleAlias.isNone() && !isRecordReceiver) {
        let receiverName: String = typeStore.nameOf(peeked.typeId);
        let message: String = `cannot access a field of non-record type \`${receiverName.toStr()}\``;
        Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::MEMBER_ACCESS_ON_NON_RECORD, message.toStr());
        return Option::NONE;
      }

      let recordDefOpt: Option<Analyzer::Typecheck::RequiredRecordDef> = Analyzer::Typecheck::requireNonGenericRecord(
        state,
        defStore,
        typeStore,
        value.span,
        receiverType,
        "member access target must be a non-generic record",
        "member access target must be a non-generic record",
      );
      let Option::SOME(recordDef) = recordDefOpt else {
        return Option::NONE;
      };

      let fieldDefOpt: Option<Analyzer::FieldDef> = Analyzer::Typecheck::findRecordFieldDef(
        defStore,
        symbols,
        &recordDef,
        value.member.toStr(),
      );
      let Option::SOME(fieldDef) = fieldDefOpt else {
        Analyzer::Typecheck::emitBareMethodReferenceOrUnknownField(state, defStore, symbols, value.span, &recordDef, value.member.toStr());
        return Option::NONE;
      };

      Analyzer::Typecheck::recordExprType(state, exprId, fieldDef.fieldType);
      return Option::SOME(fieldDef.fieldType);
    }

    /// Called after a record field-lookup miss (`checkMemberAccessExpr`).
    /// Scans the owner's `instanceMethods`/`staticMethods` tables (record-only,
    /// mirrors `requireNonGenericRecord`'s record-only blast radius, ADR D11's
    /// sibling restriction): a hit means the caller wrote a bare method
    /// reference (`obj.method` without a call) — diagnose that specifically
    /// instead of the generic "unknown record field" message. A miss on both
    /// tables falls back to the existing "unknown record field" diagnostic,
    /// unchanged.
    function emitBareMethodReferenceOrUnknownField(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      span: SourceSpan,
      recordDef: &Analyzer::Typecheck::RequiredRecordDef,
      memberName: str,
    ): void {
      let mut instanceMethods: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut staticMethods: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(ownerDef) = defStore.get(recordDef.defId)) {
        match (ownerDef) {
          Analyzer::Definition::Record(record_) -> {
            instanceMethods = Analyzer::Typecheck::copyDefinitionIdVector(&record_.instanceMethods);
            staticMethods = Analyzer::Typecheck::copyDefinitionIdVector(&record_.staticMethods);
          },
          Analyzer::Definition::Enum(_) -> {},
          Analyzer::Definition::Function(_) -> {},
          Analyzer::Definition::Variable(_) -> {},
          Analyzer::Definition::Field(_) -> {},
          Analyzer::Definition::Variant(_) -> {},
          Analyzer::Definition::TypeParam(_) -> {},
          Analyzer::Definition::TypeAlias(_) -> {},
          Analyzer::Definition::Trait(_) -> {},
          Analyzer::Definition::Method(_) -> {},
        };
      }

      let mut methodHit: Option<Analyzer::DefinitionId> = Analyzer::ResolverBodies::lookupMethodInTable(defStore, &instanceMethods, memberName, symbols);
      if (!methodHit.isSome()) {
        methodHit = Analyzer::ResolverBodies::lookupMethodInTable(defStore, &staticMethods, memberName, symbols);
      }

      if (methodHit.isSome()) {
        let message: String = `method \`${memberName}\` requires a call`;
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, message.toStr());
        return;
      }

      Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, span, DiagnosticCode::UNKNOWN_MEMBER, "unknown record field", memberName);
    }

    function copyTypeIdVector(source: &Vector<Analyzer::TypeId>): Vector<Analyzer::TypeId> {
      let mut out: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        let Option::SOME(typeId) = source.get(index) else {
          index += 1;
          continue;
        };

        out.push(*typeId);
        index += 1;
      }

      return out;
    }

    /// Implements `checkRecordInitExpr`'s type-argument inference table: a
    /// non-generic record (`typeParamSymbols` empty) always gets no arguments
    /// and ignores `expected` entirely. A generic record only gets arguments
    /// when `expected` alias-resolves to `Type::Instance` naming this exact
    /// record definition (`instance.definition == recordDef.defId`, no
    /// coercion). Every other case — no `expected`, a non-`Instance` expected
    /// type, or an `Instance` naming a different record — falls through to
    /// an empty result without emitting any diagnostic; a resulting arity
    /// mismatch is left to `TypeStore.substitute`'s own passthrough and the
    /// ordinary per-field type comparison.
    /// The type arguments a record initializer is built with: the ones written at the
    /// initializer when there are any, otherwise the ones inferred from the expected type.
    ///
    /// `NONE` means a written argument could not be resolved and was reported; the
    /// initializer has no type to produce.
    ///
    /// Two deliberate divergences from the reference analyzer, both of which stop a
    /// malformed `Type::Instance` from being built. Written arguments on a record that
    /// declares no type parameters are ignored, matching how a call ignores them on a
    /// non-generic callee; the reference instead builds an instance of a record that has
    /// no parameters to fill. A count that disagrees with the declared parameters is
    /// reported and the written arguments are dropped in favour of inference; the
    /// reference builds an instance with the wrong number of arguments and leaves the
    /// consequences to substitution's passthrough.
    function recordInitTypeArguments(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      value: &Ast::Expression::RecordInit,
      recordDef: &Analyzer::Typecheck::RequiredRecordDef,
      expected: Option<Analyzer::TypeId>,
    ): Option<Vector<Analyzer::TypeId>> {
      if (value.typeArguments.length() == 0 || recordDef.typeParamSymbols.length() == 0) {
        return Option::SOME(Analyzer::Typecheck::inferRecordInitTypeArguments(defStore, typeStore, recordDef, expected));
      }

      let Option::SOME(writtenArguments) = Analyzer::Typecheck::resolveWrittenTypeArguments(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        value.span,
        &value.typeArguments,
      ) else {
        return Option::NONE;
      };

      if (writtenArguments.length() != recordDef.typeParamSymbols.length()) {
        Analyzer::Typecheck::emitTypeArgumentCountMismatch(
          state,
          value.span,
          writtenArguments.length(),
          recordDef.typeParamSymbols.length(),
        );
        return Option::SOME(Analyzer::Typecheck::inferRecordInitTypeArguments(defStore, typeStore, recordDef, expected));
      }

      return Option::SOME(writtenArguments);
    }

    function inferRecordInitTypeArguments(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      recordDef: &Analyzer::Typecheck::RequiredRecordDef,
      expected: Option<Analyzer::TypeId>,
    ): Vector<Analyzer::TypeId> {
      if (recordDef.typeParamSymbols.length() == 0) {
        return Vector::new<Analyzer::TypeId>();
      }

      let Option::SOME(expectedType) = expected else {
        return Vector::new<Analyzer::TypeId>();
      };

      let resolvedExpected: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, expectedType);
      if (resolvedExpected.cycleAlias.isSome()) {
        return Vector::new<Analyzer::TypeId>();
      }

      let Option::SOME(resolvedExpectedNode) = typeStore.get(resolvedExpected.typeId) else {
        return Vector::new<Analyzer::TypeId>();
      };

      match (resolvedExpectedNode) {
        Analyzer::Type::Instance(instance) -> {
          if (instance.definition.raw() != recordDef.defId.raw()) {
            return Vector::new<Analyzer::TypeId>();
          }

          return Analyzer::Typecheck::copyTypeIdVector(&instance.typeArguments);
        },
        _ -> {
          return Vector::new<Analyzer::TypeId>();
        },
      };

      @panic("unreachable: inferRecordInitTypeArguments match did not return");
    }

    function checkRecordInitExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::RecordInit,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let pathTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.path,
      );
      let Option::SOME(pathType) = pathTypeOpt else {
        return Option::NONE;
      };

      let recordDefOpt: Option<Analyzer::Typecheck::RequiredRecordDef> = Analyzer::Typecheck::requireRecordAllowingGeneric(
        state,
        defStore,
        typeStore,
        value.span,
        pathType,
        "record initializer target must be a non-generic record",
      );
      let Option::SOME(recordDef) = recordDefOpt else {
        return Option::NONE;
      };

      let typeArgsOpt: Option<Vector<Analyzer::TypeId>> = Analyzer::Typecheck::recordInitTypeArguments(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        value,
        &recordDef,
        expected,
      );
      let Option::SOME(typeArgs) = typeArgsOpt else {
        return Option::NONE;
      };

      let mut seenFieldNames: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();
      let mut fieldIndex: u64 = 0;
      while (fieldIndex < value.fields.length()) {
        let Option::SOME(field) = value.fields.get(fieldIndex) else {
          fieldIndex += 1;
          continue;
        };

        let fieldDefOpt: Option<Analyzer::FieldDef> = Analyzer::Typecheck::findRecordFieldDef(
          defStore,
          symbols,
          &recordDef,
          field.name.toStr(),
        );
        let Option::SOME(fieldDef) = fieldDefOpt else {
          Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, value.span, DiagnosticCode::UNKNOWN_MEMBER, "unknown record field", field.name.toStr());
          return Option::NONE;
        };

        let mut seenIndex: u64 = 0;
        while (seenIndex < seenFieldNames.length()) {
          let Option::SOME(seenFieldName) = seenFieldNames.get(seenIndex) else {
            seenIndex += 1;
            continue;
          };

          if (seenFieldName.raw() == fieldDef.name.raw()) {
            Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, value.span, DiagnosticCode::DUPLICATE_RECORD_FIELD_INIT, "duplicate record field", field.name.toStr());
            return Option::NONE;
          }

          seenIndex += 1;
        }

        seenFieldNames.push(fieldDef.name);

        let mut typeStoreSubstituteRef: &mut Analyzer::TypeStore = typeStore;
        let substitutedFieldType: Analyzer::TypeId = typeStoreSubstituteRef.substitute(fieldDef.fieldType, &recordDef.typeParamSymbols, &typeArgs);

        let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          field.value,
          Option::SOME(substitutedFieldType),
        );
        let Option::SOME(actualType) = actualTypeOpt else {
          return Option::NONE;
        };

        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, value.span, substitutedFieldType, actualType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, value.span, substitutedFieldType, actualType);
          return Option::NONE;
        }

        fieldIndex += 1;
      }

      let mut declaredFieldIndex: u64 = 0;
      while (declaredFieldIndex < recordDef.fields.length()) {
        let Option::SOME(fieldDefId) = recordDef.fields.get(declaredFieldIndex) else {
          declaredFieldIndex += 1;
          continue;
        };

        let Option::SOME(def) = defStore.get(*fieldDefId) else {
          declaredFieldIndex += 1;
          continue;
        };

        match (def) {
          Analyzer::Definition::Field(fieldDef) -> {
            let mut found: boolean = false;
            let mut seenIndex: u64 = 0;
            while (seenIndex < seenFieldNames.length()) {
              let Option::SOME(seenFieldName) = seenFieldNames.get(seenIndex) else {
                seenIndex += 1;
                continue;
              };

              if (seenFieldName.raw() == fieldDef.name.raw()) {
                found = true;
                break;
              }

              seenIndex += 1;
            }

            if (!found) {
              let missingName: String = match (symbols.resolve(fieldDef.name)) {
                Option::SOME(name) -> String::create(name),
                Option::NONE -> String::create("<unknown>"),
              };
              Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, value.span, DiagnosticCode::MISSING_RECORD_FIELD_INIT, "missing record field", missingName.toStr());
              return Option::NONE;
            }
          },
          _ -> {},
        };

        declaredFieldIndex += 1;
      }

      if (typeArgs.length() > 0) {
        let mut typeStoreInstanceRef: &mut Analyzer::TypeStore = typeStore;
        let instanceType: Analyzer::TypeId = typeStoreInstanceRef.instance(recordDef.defId, typeArgs);
        Analyzer::Typecheck::recordExprType(state, exprId, instanceType);
        return Option::SOME(instanceType);
      }

      Analyzer::Typecheck::recordExprType(state, exprId, recordDef.typeId);
      return Option::SOME(recordDef.typeId);
    }

    /// Decomposed view of a try-capable enum type: its definition plus the
    /// ok/err payload types with the instance's type arguments applied.
    record TryEnumView {
      public enumDefId: Analyzer::DefinitionId;
      public okType: Analyzer::TypeId;
      public errType: Analyzer::TypeId;
    }

    /// Payload type carried by `variants[index]`, with `typeParamSymbols` /
    /// `typeArguments` substituted. A variant with zero or several payload
    /// elements yields `void`, mirroring stage0 `typecheck_try`.
    function tryVariantPayloadType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      variants: &Vector<Analyzer::DefinitionId>,
      index: u32,
      typeParamSymbols: &Vector<Analyzer::SymbolId>,
      typeArguments: &Vector<Analyzer::TypeId>,
    ): Analyzer::TypeId {
      let mut typeStoreVoidRef: &mut Analyzer::TypeStore = typeStore;
      let voidType: Analyzer::TypeId = typeStoreVoidRef.intern(Analyzer::Type::VOID);

      let Option::SOME(variantDefId) = variants.get(index as u64) else {
        return voidType;
      };

      let Option::SOME(variantDef) = defStore.get(*variantDefId) else {
        return voidType;
      };

      match (variantDef) {
        Analyzer::Definition::Variant(variant) -> {
          if (variant.payload.length() != 1) {
            return voidType;
          }

          let Option::SOME(payloadType) = variant.payload.get(0) else {
            return voidType;
          };

          let payloadTypeId: Analyzer::TypeId = *payloadType;
          let mut typeStoreSubstituteRef: &mut Analyzer::TypeStore = typeStore;
          return typeStoreSubstituteRef.substitute(payloadTypeId, typeParamSymbols, typeArguments);
        },
        _ -> {
          return voidType;
        },
      };

      @panic("unreachable: tryVariantPayloadType match did not return");
    }

    /// Resolves `typeId` (aliases followed) to a try-capable enum and computes
    /// the substituted payload types of its ok/err variants. On failure emits
    /// `code`/`message` (or the cyclic-alias diagnostic) and returns `NONE`.
    /// Mirrors stage0 `typecheck_try`'s operand and return-type decomposition.
    function requireTryEnumView(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      code: str,
      message: str,
    ): Option<Analyzer::Typecheck::TryEnumView> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(parts) = Analyzer::Typecheck::tryDecomposeEnumType(typeStore, resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, code, message);
        return Option::NONE;
      };

      let Option::SOME(pieces) = Analyzer::Typecheck::tryEnumParts(defStore, parts.enumDefId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, code, message);
        return Option::NONE;
      };

      let mut typeParamSymbols: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();
      let mut typeParamIndex: u64 = 0;

      while (typeParamIndex < pieces.typeParams.length()) {
        let Option::SOME(typeParamDefId) = pieces.typeParams.get(typeParamIndex) else {
          typeParamIndex += 1;
          continue;
        };

        match (defStore.get(*typeParamDefId)) {
          Option::SOME(Analyzer::Definition::TypeParam(typeParam)) -> {
            typeParamSymbols.push(typeParam.name);
          },
          _ -> {},
        };

        typeParamIndex += 1;
      }

      let okType: Analyzer::TypeId = Analyzer::Typecheck::tryVariantPayloadType(
        defStore,
        typeStore,
        &pieces.variants,
        pieces.okVariant,
        &typeParamSymbols,
        &parts.typeArguments,
      );
      let errType: Analyzer::TypeId = Analyzer::Typecheck::tryVariantPayloadType(
        defStore,
        typeStore,
        &pieces.variants,
        pieces.errVariant,
        &typeParamSymbols,
        &parts.typeArguments,
      );

      return Option::SOME(Analyzer::Typecheck::TryEnumView {
        enumDefId: parts.enumDefId,
        okType: okType,
        errType: errType,
      });
    }

    /// Intermediate decomposition of a resolved type into an enum definition
    /// and its applied type arguments (empty for a non-generic enum).
    record TryEnumDecomposition {
      public enumDefId: Analyzer::DefinitionId;
      public typeArguments: Vector<Analyzer::TypeId>;
    }

    /// Owned copy of the enum pieces `requireTryEnumView` needs after the
    /// borrowed `&Definition` match ends.
    record TryEnumParts {
      public variants: Vector<Analyzer::DefinitionId>;
      public typeParams: Vector<Analyzer::DefinitionId>;
      public okVariant: u32;
      public errVariant: u32;
    }

    /// `typeId` (aliases already resolved) as an enum definition plus applied
    /// type arguments: empty for a bare `Enum`, copied from the instance for
    /// `Instance`. `NONE` for every non-enum type.
    function tryDecomposeEnumType(
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Option<Analyzer::Typecheck::TryEnumDecomposition> {
      let typeNode: &Analyzer::Type = typeStore.get(typeId)!;

      match (typeNode) {
        Analyzer::Type::Enum(defId) -> {
          return Option::SOME(Analyzer::Typecheck::TryEnumDecomposition {
            enumDefId: defId,
            typeArguments: Vector::new<Analyzer::TypeId>(),
          });
        },
        Analyzer::Type::Instance(instance) -> {
          return Option::SOME(Analyzer::Typecheck::TryEnumDecomposition {
            enumDefId: instance.definition,
            typeArguments: Analyzer::Typecheck::copyTypeIdVector(&instance.typeArguments),
          });
        },
        _ -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: tryDecomposeEnumType match did not return");
    }

    /// Owned copies of the variant/type-param tables and the ok/err indices of
    /// `enumDefId`, or `NONE` when it is not an enum or not `@lang(try)`.
    function tryEnumParts(
      defStore: &mut Analyzer::DefinitionStore,
      enumDefId: Analyzer::DefinitionId,
    ): Option<Analyzer::Typecheck::TryEnumParts> {
      let def: &Analyzer::Definition = defStore.get(enumDefId)!;

      match (def) {
        Analyzer::Definition::Enum(enum_) -> {
          let Option::SOME(capability) = &enum_.tryCapable else {
            return Option::NONE;
          };

          return Option::SOME(Analyzer::Typecheck::TryEnumParts {
            variants: Analyzer::Typecheck::copyDefinitionIdVector(&enum_.variants),
            typeParams: Analyzer::Typecheck::copyDefinitionIdVector(&enum_.typeParams),
            okVariant: capability.okVariant,
            errVariant: capability.errVariant,
          });
        },
        _ -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: tryEnumParts match did not return");
    }

    /// Types a postfix `!` expression: the operand must be a try-capable enum,
    /// the enclosing function's return type must be the same enum with an equal
    /// error payload (the error propagates unchanged), and the expression's
    /// own type is the operand's ok payload. Mirrors stage0 `typecheck_try`.
    function checkTryExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      value: &Ast::Expression::Try,
    ): Option<Analyzer::TypeId> {
      let operandType: Analyzer::TypeId = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.expression)!;

      let operandView: Analyzer::Typecheck::TryEnumView = Analyzer::Typecheck::requireTryEnumView(
        state,
        defStore,
        typeStore,
        value.span,
        operandType,
        DiagnosticCode::TRY_ON_NON_TRY_TYPE,
        "the `!` operator requires a `@lang(try)` enum operand",
      )!;

      let returnViewOpt: Option<Analyzer::Typecheck::TryEnumView> = Analyzer::Typecheck::requireTryEnumView(
        state,
        defStore,
        typeStore,
        value.span,
        state.currentReturnType,
        DiagnosticCode::TRY_RETURN_TYPE_MISMATCH,
        "`!` propagates its error to the caller, so the enclosing function must return a `@lang(try)` enum",
      );

      if (let Option::SOME(returnView) = returnViewOpt) {
        if (returnView.enumDefId.raw() != operandView.enumDefId.raw()) {
          Analyzer::Typecheck::emitDiagnostic(
            state,
            value.span,
            DiagnosticCode::TRY_RETURN_TYPE_MISMATCH,
            "`!` propagates its error to the caller, so the enclosing function must return the operand's `@lang(try)` enum",
          );
        } else if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, value.span, operandView.errType, returnView.errType)) {
          Analyzer::Typecheck::emitDiagnostic(
            state,
            value.span,
            DiagnosticCode::TRY_ERROR_TYPE_MISMATCH,
            "the operand's error payload does not match the enclosing return type's error payload",
          );
        }
      }

      return Option::SOME(operandView.okType);
    }

    function checkExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::TypeId> {
      return Analyzer::Typecheck::checkExprExpected(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        exprId,
        Option::NONE,
      );
    }

    /// The element type an expected vector-like type asks its elements to have.
    ///
    /// `NONE` when nothing is expected, when the expectation is not a sequence, or
    /// when it alias-resolves through a cycle — in every one of those the elements
    /// are typed on their own and compared to each other, as before.
    function expectedElementType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(expectedType) = expected else {
        return Option::NONE;
      };

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, expectedType);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
        return Option::NONE;
      };

      return match (resolvedNode) {
        Analyzer::Type::FixedArray(element, _) -> Option::SOME(element),
        Analyzer::Type::Slice(element) -> Option::SOME(element),
        _ -> Option::NONE,
      };
    }

    function checkExprExpected(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return Option::NONE;
      };

      match (expr) {
        Ast::Expression::Node::Literal(literal) -> {
          return Analyzer::Typecheck::checkLiteralExprExpected(state, defStore, typeStore, exprId, &literal, expected);
        },
        Ast::Expression::Node::Variable(variable) -> {
          return Analyzer::Typecheck::checkResolvedValueExpr(
            state,
            defStore,
            typeStore,
            resolvedBodies,
            exprId,
            variable.span,
            expected,
          );
        },
        Ast::Expression::Node::Path(path) -> {
          return Analyzer::Typecheck::checkResolvedValueExpr(
            state,
            defStore,
            typeStore,
            resolvedBodies,
            exprId,
            path.span,
            expected,
          );
        },
        Ast::Expression::Node::Grouped(grouped) -> {
          let innerTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            grouped.expression,
            expected,
          );

          let Option::SOME(innerType) = innerTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, innerType);
          return Option::SOME(innerType);
        },
        Ast::Expression::Node::Call(call) -> {
          return Analyzer::Typecheck::checkCallExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &call,
            expected,
          );
        },
        Ast::Expression::Node::Binary(b) -> {
          return Analyzer::Typecheck::checkBinaryExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &b,
          );
        },
        Ast::Expression::Node::Assignment(value) -> {
          return Analyzer::Typecheck::checkAssignmentExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::Ternary(value) -> {
          let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.condition);
          if (let Option::SOME(conditionType) = conditionTypeOpt) {
            Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
          }

          let thenTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(state, defStore, typeStore, symbols, module, resolvedBodies, value.thenBranch, expected);
          let elseTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(state, defStore, typeStore, symbols, module, resolvedBodies, value.elseBranch, expected);

          let mut candidates: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          if (let Option::SOME(thenType) = thenTypeOpt) {
            candidates.push(thenType);
          }
          if (let Option::SOME(elseType) = elseTypeOpt) {
            candidates.push(elseType);
          }

          let ternaryTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::joinTypes(state, defStore, typeStore, value.span, &candidates, 2, Analyzer::Typecheck::JoinKind::Branches, expected);
          let Option::SOME(ternaryType) = ternaryTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, ternaryType);
          return Option::SOME(ternaryType);
        },
        Ast::Expression::Node::Cast(value) -> {
          return Analyzer::Typecheck::checkCastExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::Dereference(value) -> {
          return Analyzer::Typecheck::checkDereferenceExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::Tuple(value) -> {
          let mut elements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut allElementsTyped: boolean = true;
          let mut index: u64 = 0;

          while (index < value.elements.length()) {
            let Option::SOME(elementId) = value.elements.get(index) else {
              index += 1;
              continue;
            };

            let elementTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, *elementId);
            let Option::SOME(elementType) = elementTypeOpt else {
              allElementsTyped = false;
              index += 1;
              continue;
            };

            elements.push(elementType);
            index += 1;
          }

          if (!allElementsTyped) {
            return Option::NONE;
          }

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          let tupleType: Analyzer::TypeId = typeStoreRef.tuple(elements);
          Analyzer::Typecheck::recordExprType(state, exprId, tupleType);
          return Option::SOME(tupleType);
        },
        Ast::Expression::Node::Unit(_) -> {
          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          let unitType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::VOID);
          Analyzer::Typecheck::recordExprType(state, exprId, unitType);
          return Option::SOME(unitType);
        },
        Ast::Expression::Node::LetCondition(value) -> {
          // `let PATTERN = value` in condition position: the scrutinee's type
          // drives the pattern's bindings — visible in the guarded branch, the
          // resolver already scoped them — and the condition itself is boolean.
          let valueTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.value);

          if (let Option::SOME(valueType) = valueTypeOpt) {
            Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, value.pattern, valueType, false, value.span);
          }

          let booleanType: Analyzer::TypeId = Analyzer::Typecheck::binaryBooleanType(typeStore);
          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        },
        Ast::Expression::Node::Reference(value) -> {
          return Analyzer::Typecheck::checkReferenceExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::Unary(value) -> {
          return Analyzer::Typecheck::checkUnaryExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::Block(value) -> {
          let blockTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkBlockBody(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value.statements,
            value.tail,
            expected,
          );
          let Option::SOME(blockType) = blockTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, blockType);
          return Option::SOME(blockType);
        },
        Ast::Expression::Node::If(value) -> {
          let ifTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkIfExpr(state, defStore, typeStore, symbols, module, resolvedBodies, &value, expected);
          let Option::SOME(ifType) = ifTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, ifType);
          return Option::SOME(ifType);
        },
        Ast::Expression::Node::Match(value) -> {
          let matchTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkMatchExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value,
            expected,
            true,
          );

          let Option::SOME(matchType) = matchTypeOpt else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, matchType);
          return Option::SOME(matchType);
        },
        Ast::Expression::Node::Vector(value) -> {
          // The expected type decides what the elements are, exactly as it does for
          // any other argument position: without it an unsuffixed literal keeps its
          // default and a `i32[]` annotation reports a mismatch per element.
          let expectedElement: Option<Analyzer::TypeId> = Analyzer::Typecheck::expectedElementType(
            state,
            defStore,
            typeStore,
            value.span,
            expected,
          );

          let mut firstElementTypeOpt: Option<Analyzer::TypeId> = Option::NONE;
          let mut allElementsTyped: boolean = true;
          let mut allElementsMatch: boolean = true;
          let mut index: u64 = 0;

          while (index < value.elements.length()) {
            let Option::SOME(elementId) = value.elements.get(index) else {
              index += 1;
              continue;
            };

            let elementTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(state, defStore, typeStore, symbols, module, resolvedBodies, *elementId, expectedElement);
            let Option::SOME(elementType) = elementTypeOpt else {
              allElementsTyped = false;
              index += 1;
              continue;
            };

            if (let Option::SOME(firstElementType) = firstElementTypeOpt) {
              if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, value.span, firstElementType, elementType)) {
                Analyzer::Typecheck::emitTypeMismatch(state, typeStore, value.span, firstElementType, elementType);
                allElementsMatch = false;
              }
            } else {
              firstElementTypeOpt = Option::SOME(elementType);
            }

            index += 1;
          }

          if (value.elements.length() == 0) {
            Analyzer::Typecheck::emitCannotInferVectorLiteral(state, value.span);
            return Option::NONE;
          }

          if (!allElementsTyped || !allElementsMatch) {
            return Option::NONE;
          }

          let Option::SOME(elementType) = firstElementTypeOpt else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          let vectorType: Analyzer::TypeId = typeStoreRef.fixedArray(elementType, value.elements.length());
          Analyzer::Typecheck::recordExprType(state, exprId, vectorType);
          return Option::SOME(vectorType);
        },
        Ast::Expression::Node::VectorAccess(value) -> {
          let baseTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.vector);
          let indexTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.index);

          if (let Option::SOME(indexType) = indexTypeOpt) {
            if (!Analyzer::Typecheck::isIntegerType(state, defStore, typeStore, value.span, indexType)) {
              Analyzer::Typecheck::emitVectorIndexNonInteger(state, typeStore, value.span, indexType);
            }
          }

          let Option::SOME(baseType) = baseTypeOpt else {
            return Option::NONE;
          };

          let resolvedBase: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, baseType);
          if (let Option::SOME(aliasDefId) = resolvedBase.cycleAlias) {
            Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, value.span, aliasDefId);
            return Option::NONE;
          }

          let Option::SOME(baseTypeNode) = typeStore.get(resolvedBase.typeId) else {
            return Option::NONE;
          };

          let elementTypeOpt: Option<Analyzer::TypeId> = match (baseTypeNode) {
            Analyzer::Type::Slice(element) -> Option::SOME(element),
            Analyzer::Type::FixedArray(element, _) -> Option::SOME(element),
            Analyzer::Type::Pointer(pointer) -> Option::SOME(pointer.pointee),
            _ -> Option::NONE,
          };

          let Option::SOME(elementType) = elementTypeOpt else {
            Analyzer::Typecheck::emitAccessNonVector(state, typeStore, value.span, baseType);
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, elementType);
          return Option::SOME(elementType);
        },
        Ast::Expression::Node::PostfixIncrement(value) -> {
          let _operandType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.operand);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "postfix increment");
          return Option::NONE;
        },
        Ast::Expression::Node::PostfixDecrement(value) -> {
          let _operandType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.operand);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "postfix decrement");
          return Option::NONE;
        },
        Ast::Expression::Node::MemberAccess(value) -> {
          return Analyzer::Typecheck::checkMemberAccessExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
          );
        },
        Ast::Expression::Node::RecordInit(value) -> {
          return Analyzer::Typecheck::checkRecordInitExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            exprId,
            &value,
            expected,
          );
        },
        Ast::Expression::Node::BuiltinCall(value) -> {
          let Option::SOME(builtinType) = Analyzer::Typecheck::checkBuiltinCall(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value,
          ) else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, builtinType);
          return Option::SOME(builtinType);
        },
        Ast::Expression::Node::Lambda(value) -> {
          let Option::SOME(lambdaType) = Analyzer::Typecheck::checkLambdaExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value,
          ) else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, lambdaType);
          return Option::SOME(lambdaType);
        },
        Ast::Expression::Node::CaptureOverride(value) -> {
          let _innerType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.expression);
          Analyzer::Typecheck::emitUnsupported(state, value.span, "capture overrides");
          return Option::NONE;
        },
        Ast::Expression::Node::Pipe(value) -> {
          let Option::SOME(pipeType) = Analyzer::Typecheck::checkPipeExpr(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &value,
          ) else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, pipeType);
          return Option::SOME(pipeType);
        },
        Ast::Expression::Node::PipePlaceholder(value) -> {
          let Option::SOME(placeholderType) = Analyzer::Typecheck::checkPipePlaceholderExpr(state, &value) else {
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, placeholderType);
          return Option::SOME(placeholderType);
        },
        Ast::Expression::Node::Try(value) -> {
          let tryType: Analyzer::TypeId = Analyzer::Typecheck::checkTryExpr(state, defStore, typeStore, symbols, module, resolvedBodies, &value)!;

          Analyzer::Typecheck::recordExprType(state, exprId, tryType);
          return Option::SOME(tryType);
        },
      };

      @panic("unreachable: checkExprExpected match did not return");
    }

    /// Returns `true` when `typeId` resolves (through alias chains) to the
    /// interned `NEVER` type — used by `joinTypes` to exclude diverging arms
    /// (e.g. a `return`-only body) from the cross-arm join without needing a
    /// separate divergence marker.
    function isNeverType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
        return false;
      };

      let Analyzer::Type::NEVER = resolvedNode else {
        return false;
      };

      return true;
    }

    /// Whether an expression of type `actual` may be supplied where `expected` is required.
    ///
    /// A diverging expression never produces a value, so there is no value that could be
    /// of the wrong type: `NEVER` fits every position. Comparing it with `typesEqual`
    /// would reject `return @panic("...")` inside a function returning anything but
    /// `never`, reporting a type error for code that cannot reach the return at all.
    ///
    /// A same-sign integer also fits a strictly wider one, mirroring the reference
    /// analyzer's `is_assignable`/`is_implicit_widening` pair. Narrowing and any
    /// signed/unsigned crossing remain explicit casts.
    ///
    /// This must be used wherever a value flows into an expected type — return, local
    /// annotation, assignment, argument, field initializer, constant initializer, and the
    /// joined type of an all-diverging `match`. Symmetric comparisons (binary operands, a
    /// pattern against its annotation) stay on `typesEqual`: neither side is a value being
    /// supplied to the other. The reference compiler exempts `never` only at `return`, so
    /// it rejects `let x: u64 = @panic("...")`; accepting it here is deliberate, since a
    /// bottom type that is assignable in one position and not another is not a bottom type.
    function valueSatisfiesType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      expected: Analyzer::TypeId,
      actual: Analyzer::TypeId,
    ): boolean {
      // `typesEqual` reports cyclic aliases as it resolves them, so it runs first even when
      // the answer is already known: testing divergence first would swallow that diagnostic.
      if (Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, expected, actual)) {
        return true;
      }

      if (Analyzer::Typecheck::isImplicitWidening(defStore, typeStore, expected, actual)) {
        return true;
      }

      return Analyzer::Typecheck::isNeverType(state, defStore, typeStore, actual);
    }

    /// Selects which pairwise-mismatch diagnostic `joinTypes` emits, so the
    /// same join algorithm serves both match arms (S3) and if/ternary
    /// branches (S4) with their own distinct diagnostic wording (design D5:
    /// `match-arm-type-mismatch` vs `branch-type-mismatch`).
    enum JoinKind {
      MatchArms,
      Branches,
    }

    /// Joins the value-producing candidates of an expression-position
    /// match/if/ternary into a single result type (design D2). `candidates`
    /// holds only the candidate types that were themselves successfully
    /// typechecked — a body/branch that already failed typechecking (and was
    /// diagnosed at its own call site) contributes nothing here. Diverging
    /// (`NEVER`-typed) candidates are excluded from the pairwise comparison
    /// so they never poison the join. `attemptedCount` is the number of
    /// bodies/branches that were attempted regardless of outcome: when it is
    /// positive but every candidate was excluded because none of them
    /// successfully typechecked, the failure was already diagnosed at each
    /// candidate's own call site, so `joinTypes` returns `Option::NONE`
    /// without a further diagnostic (S3 review follow-up — do not conflate
    /// "nothing typed" with "everything diverged"). When candidates exist but
    /// all are excluded as diverging, the join itself types as `NEVER`. The
    /// result (or `NEVER`) is compared against `expected` exactly once, when
    /// present — this is the only place a join vs. `expected` mismatch can be
    /// diagnosed, since no per-candidate leaf checker enforces `expected`
    /// against its synthesized type today.
    function joinTypes(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      candidates: &Vector<Analyzer::TypeId>,
      attemptedCount: u64,
      kind: Analyzer::Typecheck::JoinKind,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let mut accumulated: Option<Analyzer::TypeId> = Option::NONE;

      let mut index: u64 = 0;
      while (index < candidates.length()) {
        let Option::SOME(candidateRef) = candidates.get(index) else {
          index += 1;
          continue;
        };
        let candidate: Analyzer::TypeId = *candidateRef;

        if (Analyzer::Typecheck::isNeverType(state, defStore, typeStore, candidate)) {
          index += 1;
          continue;
        }

        let Option::SOME(current) = accumulated else {
          accumulated = Option::SOME(candidate);
          index += 1;
          continue;
        };

        if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, current, candidate)) {
          match (kind) {
            Analyzer::Typecheck::JoinKind::MatchArms -> Analyzer::Typecheck::emitMatchArmTypeMismatch(state, typeStore, span, current, candidate),
            Analyzer::Typecheck::JoinKind::Branches -> Analyzer::Typecheck::emitBranchTypeMismatch(state, typeStore, span, current, candidate),
          };
          return Option::NONE;
        }

        index += 1;
      }

      if (accumulated.isNone() && candidates.length() == 0 && attemptedCount > 0) {
        return Option::NONE;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let mut joinedType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::NEVER);
      if (let Option::SOME(t) = accumulated) {
        joinedType = t;
      }

      if (let Option::SOME(expectedType) = expected) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, expectedType, joinedType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, span, expectedType, joinedType);
          return Option::NONE;
        }
      }

      return Option::SOME(joinedType);
    }

    function checkMatchExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      value: &Ast::Expression::Match,
      expected: Option<Analyzer::TypeId>,
      valuePosition: boolean,
    ): Option<Analyzer::TypeId> {
      let scrutineeTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.scrutinee);

      let mut armTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

      let mut index: u64 = 0;
      while (index < value.arms.length()) {
        let Option::SOME(arm) = value.arms.get(index) else {
          index += 1;
          continue;
        };

        Analyzer::Typecheck::pushScope(state);
        if (let Option::SOME(scrutineeType) = scrutineeTypeOpt) {
          Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, arm.pattern, scrutineeType, false, value.span);
        }

        if (let Option::SOME(guardId) = arm.guard) {
          let guardTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, guardId);
          if (let Option::SOME(guardType) = guardTypeOpt) {
            Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, guardType);
          }
        }

        // `expected` propagates into arm bodies regardless of position: in
        // statement position it is always `Option::NONE` (see the `checkStmt`
        // call site below), so `checkExprExpected` transparently falls back
        // to synthesis-only checking there.
        let bodyTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(state, defStore, typeStore, symbols, module, resolvedBodies, arm.body, expected);
        if (let Option::SOME(bodyType) = bodyTypeOpt) {
          armTypes.push(bodyType);
        }
        Analyzer::Typecheck::popScope(state);
        index += 1;
      }

      let verdict: Analyzer::Typecheck::ExhaustiveVerdict = Analyzer::Typecheck::analyzeMatchExhaustiveness(defStore, typeStore, symbols, module, resolvedBodies, scrutineeTypeOpt, &value.arms);
      if (let Analyzer::Typecheck::ExhaustiveVerdict::Missing(reason) = verdict) {
        let message: String = `non-exhaustive match: ${reason.toStr()}`;
        if (valuePosition) {
          Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::NON_EXHAUSTIVE_MATCH, message.toStr());
        } else {
          Analyzer::Typecheck::emitWarning(state, value.span, DiagnosticCode::NON_EXHAUSTIVE_MATCH, message.toStr());
        }
      }

      // Statement position discards the match's value: no cross-arm join is
      // imposed (design D2), and the match itself produces no expression
      // type — mirroring how sibling statement forms (`if`, `while`) never
      // record an expression type for themselves.
      if (!valuePosition) {
        return Option::NONE;
      }

      return Analyzer::Typecheck::joinTypes(state, defStore, typeStore, value.span, &armTypes, value.arms.length(), Analyzer::Typecheck::JoinKind::MatchArms, expected);
    }

    /// Types a single if-expression branch as a value, threading `expected`
    /// into it. If-expression branches always arrive as a `Block` statement
    /// (mirroring `if (cond) { ... } else { ... }` syntax) so their value is
    /// the block's tail, checked through `checkBlockBody` exactly like any
    /// other value-producing block. Any other statement shape has no value
    /// to contribute: it is still checked for its own diagnostics via
    /// `checkStmt`, but contributes nothing to the branch join.
    function checkIfBranchExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      stmtId: Ast::StatementId,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(stmt) = module.statements.get(stmtId) else {
        return Option::NONE;
      };

      if (let Ast::Statement::Node::Block(blockStmt) = stmt) {
        return Analyzer::Typecheck::checkBlockBody(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          &blockStmt.statements,
          blockStmt.tail,
          expected,
        );
      }

      Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, stmtId);
      return Option::NONE;
    }

    /// Types an if-expression (design D2/D5, S4): both branches are checked
    /// with `expected` threaded in, then joined via the same `joinTypes`
    /// algorithm as match arms. An if-expression with no `else` branch has no
    /// value to produce, so it is diagnosed instead of falling back to
    /// `void`.
    function checkIfExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      value: &Ast::Expression::If,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.condition);
      if (let Option::SOME(conditionType) = conditionTypeOpt) {
        Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
      }

      let Option::SOME(elseId) = value.elseBranch else {
        let _thenType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkIfBranchExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.thenBranch, Option::NONE);
        Analyzer::Typecheck::emitIfMissingElse(state, value.span);
        return Option::NONE;
      };

      let thenTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkIfBranchExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.thenBranch, expected);
      let elseTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkIfBranchExpr(state, defStore, typeStore, symbols, module, resolvedBodies, elseId, expected);

      let mut candidates: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      if (let Option::SOME(thenType) = thenTypeOpt) {
        candidates.push(thenType);
      }
      if (let Option::SOME(elseType) = elseTypeOpt) {
        candidates.push(elseType);
      }

      return Analyzer::Typecheck::joinTypes(state, defStore, typeStore, value.span, &candidates, 2, Analyzer::Typecheck::JoinKind::Branches, expected);
    }

    function typeIdIsPointer(
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId
    ): boolean {
      let Option::SOME(typeNode) = typeStore.get(typeId) else {
        return false;
      };

      return match (typeNode) {
        Analyzer::Type::Pointer(_) -> true,
        _ -> false,
      };
    }

    function typeIdIsReference(
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId
    ): boolean {
      let Option::SOME(typeNode) = typeStore.get(typeId) else {
        return false;
      };

      return match (typeNode) {
        Analyzer::Type::Reference(_) -> true,
        _ -> false,
      };
    }

    function typeIdIsStr(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): boolean {
      let Option::SOME(typeNode) = typeStore.get(typeId) else {
        return false;
      };

      return match (typeNode) {
        Analyzer::Type::STR -> true,
        _ -> false,
      };
    }

    function typeIdIsChar(typeStore: &mut Analyzer::TypeStore, typeId: Analyzer::TypeId): boolean {
      let Option::SOME(typeNode) = typeStore.get(typeId) else {
        return false;
      };

      return match (typeNode) {
        Analyzer::Type::CHAR -> true,
        _ -> false,
      };
    }

    /// Whether `typeId` is an enum none of whose variants carries a payload,
    /// which is what makes `==` well-defined on it (host `is_unit_enum`).
    function isUnitEnumType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): boolean {
      let Option::SOME(typeNode) = typeStore.get(typeId) else {
        return false;
      };

      let Analyzer::Type::Enum(enumDefId) = typeNode else {
        return false;
      };

      let Option::SOME(def) = defStore.get(enumDefId) else {
        return false;
      };

      let Analyzer::Definition::Enum(enumDef) = def else {
        return false;
      };

      let mut variantIndex: u64 = 0;

      while (variantIndex < enumDef.variants.length()) {
        let Option::SOME(variantDefId) = enumDef.variants.get(variantIndex) else {
          variantIndex += 1;
          continue;
        };

        let Option::SOME(variantDef) = defStore.get(*variantDefId) else {
          variantIndex += 1;
          continue;
        };

        if (let Analyzer::Definition::Variant(variant) = variantDef) {
          if (variant.payload.length() > 0) {
            return false;
          }
        }

        variantIndex += 1;
      }

      return true;
    }

    /// Validates the `from as to` pair and emits `INVALID_CAST` when no
    /// supported conversion exists. Mirrors the Rust `typecheck_cast` table:
    /// numeric<->numeric, boolean<->integer, char<->integer,
    /// pointer/reference<->pointer/reference, pointer<->integer,
    /// pointer<->str, and identity as the fallback.
    function checkCastValidity(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      fromType: Analyzer::TypeId,
      toType: Analyzer::TypeId,
    ): void {
      let resolvedFrom: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, fromType);
      if (let Option::SOME(aliasDefId) = resolvedFrom.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return;
      }

      let resolvedTo: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, toType);
      if (let Option::SOME(aliasDefId) = resolvedTo.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return;
      }

      let fromId: Analyzer::TypeId = resolvedFrom.typeId;
      let toId: Analyzer::TypeId = resolvedTo.typeId;

      let fromIsNumeric: boolean = Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, span, fromId);
      let toIsNumeric: boolean = Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, span, toId);
      let fromIsInteger: boolean = Analyzer::Typecheck::isIntegerType(state, defStore, typeStore, span, fromId);
      let toIsInteger: boolean = Analyzer::Typecheck::isIntegerType(state, defStore, typeStore, span, toId);
      let fromIsBoolean: boolean = Analyzer::Typecheck::isBooleanType(state, defStore, typeStore, span, fromId);
      let toIsBoolean: boolean = Analyzer::Typecheck::isBooleanType(state, defStore, typeStore, span, toId);
      let fromIsChar: boolean = Analyzer::Typecheck::typeIdIsChar(typeStore, fromId);
      let toIsChar: boolean = Analyzer::Typecheck::typeIdIsChar(typeStore, toId);
      let fromIsPointer: boolean = Analyzer::Typecheck::typeIdIsPointer(typeStore, fromId);
      let toIsPointer: boolean = Analyzer::Typecheck::typeIdIsPointer(typeStore, toId);
      let fromIsReference: boolean = Analyzer::Typecheck::typeIdIsReference(typeStore, fromId);
      let toIsReference: boolean = Analyzer::Typecheck::typeIdIsReference(typeStore, toId);
      let fromIsStr: boolean = Analyzer::Typecheck::typeIdIsStr(typeStore, fromId);
      let toIsStr: boolean = Analyzer::Typecheck::typeIdIsStr(typeStore, toId);

      let mut valid: boolean = false;
      if (fromIsNumeric && toIsNumeric) {
        valid = true;
      } else if (fromIsBoolean && toIsInteger) {
        valid = true;
      } else if (toIsBoolean && fromIsInteger) {
        valid = true;
      } else if (fromIsChar && toIsInteger) {
        valid = true;
      } else if (toIsChar && fromIsInteger) {
        valid = true;
      } else if (fromIsPointer && (toIsPointer || toIsReference)) {
        valid = true;
      } else if (fromIsReference && (toIsPointer || toIsReference)) {
        valid = true;
      } else if (fromIsPointer && toIsInteger) {
        valid = true;
      } else if (toIsPointer && fromIsInteger) {
        valid = true;
      } else if (fromIsPointer && toIsStr) {
        valid = true;
      } else if (toIsPointer && fromIsStr) {
        valid = true;
      } else {
        valid = Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, fromId, toId);
      }

      if (!valid) {
        Analyzer::Typecheck::emitInvalidCast(state, typeStore, span, fromType, toType);
      }
    }

    function checkCastExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::Cast,
    ): Option<Analyzer::TypeId> {
      let operandTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.expression);

      let targetTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        value.targetType,
      );
      let Option::SOME(targetType) = targetTypeOpt else {
        Analyzer::Typecheck::emitUnsupported(state, value.span, "unsupported cast target type");
        return Option::NONE;
      };

      // A failed operand already reported its own diagnostic; casting it would
      // only cascade a second one.
      let Option::SOME(operandType) = operandTypeOpt else {
        return Option::NONE;
      };

      Analyzer::Typecheck::checkCastValidity(state, defStore, typeStore, value.span, operandType, targetType);

      Analyzer::Typecheck::recordExprType(state, exprId, targetType);
      return Option::SOME(targetType);
    }

    function checkDereferenceExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::Dereference,
    ): Option<Analyzer::TypeId> {
      let operandTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.operand);
      let Option::SOME(operandType) = operandTypeOpt else {
        return Option::NONE;
      };

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, operandType);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, value.span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(operandTypeNode) = typeStore.get(resolved.typeId) else {
        return Option::NONE;
      };

      let pointeeTypeOpt: Option<Analyzer::TypeId> = match (operandTypeNode) {
        Analyzer::Type::Pointer(pointer) -> Option::SOME(pointer.pointee),
        Analyzer::Type::Reference(reference) -> Option::SOME(reference.referent),
        _ -> Option::NONE,
      };

      let Option::SOME(pointeeType) = pointeeTypeOpt else {
        Analyzer::Typecheck::emitDereferenceNonPointer(state, typeStore, value.span, operandType);
        return Option::NONE;
      };

      Analyzer::Typecheck::recordExprType(state, exprId, pointeeType);
      return Option::SOME(pointeeType);
    }

    /// Whether an expression names a place a reference can point at:
    /// variables, paths, dereferences, index accesses, and member accesses.
    /// Mirrors the Rust `is_lvalue`.
    function isLvalueExpr(module: &Ast::Module, exprId: Ast::ExpressionId): boolean {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return false;
      };

      return match (expr) {
        Ast::Expression::Node::Variable(_) -> true,
        Ast::Expression::Node::Path(_) -> true,
        Ast::Expression::Node::Dereference(_) -> true,
        Ast::Expression::Node::VectorAccess(_) -> true,
        Ast::Expression::Node::MemberAccess(_) -> true,
        _ -> false,
      };
    }

    /// Whether an expression names a mutable place. Mirrors the Rust
    /// `is_mutable_expression`: bindings answer from their declared
    /// mutability, dereferences look through `&mut`/`*mut` operand types, and
    /// index/member accesses recurse on their base.
    function isMutablePlaceExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      exprId: Ast::ExpressionId,
    ): boolean {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return false;
      };

      match (expr) {
        Ast::Expression::Node::Variable(_) -> {
          return Analyzer::Typecheck::resolvedRefIsMutableBinding(state, defStore, resolvedBodies, exprId);
        },
        Ast::Expression::Node::Path(_) -> {
          return Analyzer::Typecheck::resolvedRefIsMutableBinding(state, defStore, resolvedBodies, exprId);
        },
        Ast::Expression::Node::Dereference(deref) -> {
          if (let Option::SOME(operandType) = Analyzer::Typecheck::lookupRecordedExprType(state, deref.operand)) {
            let Option::SOME(operandTypeNode) = typeStore.get(operandType) else {
              return false;
            };

            match (operandTypeNode) {
              Analyzer::Type::Reference(reference) -> {
                return reference.mutable;
              },
              Analyzer::Type::Pointer(pointer) -> {
                return pointer.mutable;
              },
              _ -> {},
            };
          }

          return Analyzer::Typecheck::isMutablePlaceExpr(state, defStore, typeStore, resolvedBodies, module, deref.operand);
        },
        Ast::Expression::Node::VectorAccess(access) -> {
          return Analyzer::Typecheck::isMutablePlaceExpr(state, defStore, typeStore, resolvedBodies, module, access.vector);
        },
        Ast::Expression::Node::MemberAccess(memberAccess) -> {
          let Ast::Expression::AccessOperator::Dot = memberAccess.operator else {
            return false;
          };

          if (let Option::SOME(objectType) = Analyzer::Typecheck::lookupRecordedExprType(state, memberAccess.object)) {
            let Option::SOME(objectTypeNode) = typeStore.get(objectType) else {
              return false;
            };

            match (objectTypeNode) {
              Analyzer::Type::Reference(reference) -> {
                return reference.mutable;
              },
              Analyzer::Type::Pointer(pointer) -> {
                return pointer.mutable;
              },
              _ -> {},
            };
          }

          return Analyzer::Typecheck::isMutablePlaceExpr(state, defStore, typeStore, resolvedBodies, module, memberAccess.object);
        },
        Ast::Expression::Node::Grouped(grouped) -> {
          return Analyzer::Typecheck::isMutablePlaceExpr(state, defStore, typeStore, resolvedBodies, module, grouped.expression);
        },
        _ -> {
          return false;
        },
      };

      @panic("unreachable: isMutablePlaceExpr match did not return");
    }

    function resolvedRefIsMutableBinding(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
    ): boolean {
      let Option::SOME(resolvedRef) = Analyzer::Typecheck::lookupExprRef(resolvedBodies, exprId) else {
        return false;
      };

      match (resolvedRef) {
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
          let Option::SOME(binding) = Analyzer::Typecheck::lookupLocalBinding(state, localId) else {
            return false;
          };

          return binding.mutable;
        },
        Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            return false;
          };

          return match (def) {
            Analyzer::Definition::Variable(variable) -> variable.mutable,
            _ -> false,
          };
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          return false;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          return false;
        },
      };

      @panic("unreachable: resolvedRefIsMutableBinding match did not return");
    }

    function referenceTargetName(module: &Ast::Module, exprId: Ast::ExpressionId): String {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return String::create("<expression>");
      };

      match (expr) {
        Ast::Expression::Node::Variable(variable) -> {
          return variable.name.clone();
        },
        Ast::Expression::Node::Path(path) -> {
          if (path.segments.length() == 0) {
            return String::create("<expression>");
          }

          let Option::SOME(lastSegment) = path.segments.get(path.segments.length() - 1) else {
            return String::create("<expression>");
          };

          return lastSegment.clone();
        },
        _ -> {
          return String::create("<expression>");
        },
      };

      @panic("unreachable: referenceTargetName match did not return");
    }

    function checkReferenceExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::Reference,
    ): Option<Analyzer::TypeId> {
      let targetTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.target);

      // A failed target already reported its own diagnostic; lvalue and
      // mutability checks on it would only cascade more.
      let Option::SOME(targetType) = targetTypeOpt else {
        return Option::NONE;
      };

      if (!Analyzer::Typecheck::isLvalueExpr(module, value.target)) {
        Analyzer::Typecheck::emitInvalidReferenceTarget(state, value.span);
      }

      if (value.mutable && !Analyzer::Typecheck::isMutablePlaceExpr(state, defStore, typeStore, resolvedBodies, module, value.target)) {
        let targetName: String = Analyzer::Typecheck::referenceTargetName(module, value.target);
        Analyzer::Typecheck::emitMutableReferenceToImmutable(state, value.span, targetName.toStr());
      }

      if (value.mutable) {
        Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, value.target);
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let mut referenceType: Analyzer::TypeId = typeStoreRef.reference(targetType);
      if (value.mutable) {
        referenceType = typeStoreRef.mutableReference(targetType);
      }

      Analyzer::Typecheck::recordExprType(state, exprId, referenceType);
      return Option::SOME(referenceType);
    }

    function checkUnaryExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      value: &Ast::Expression::Unary,
    ): Option<Analyzer::TypeId> {
      let operandTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.operand);
      let Option::SOME(operandType) = operandTypeOpt else {
        return Option::NONE;
      };

      match (value.operator) {
        Ast::Expression::UnaryOperator::Not -> {
          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          let booleanType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::BOOLEAN);

          if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, value.span, booleanType, operandType)) {
            Analyzer::Typecheck::emitInvalidUnaryOperandType(state, typeStore, value.span, "!", operandType);
          }

          Analyzer::Typecheck::recordExprType(state, exprId, booleanType);
          return Option::SOME(booleanType);
        },
        Ast::Expression::UnaryOperator::Negate -> {
          if (!Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, value.span, operandType)) {
            Analyzer::Typecheck::emitInvalidUnaryOperandType(state, typeStore, value.span, "-", operandType);
            return Option::NONE;
          }

          Analyzer::Typecheck::recordExprType(state, exprId, operandType);
          return Option::SOME(operandType);
        },
        Ast::Expression::UnaryOperator::BitNot -> {
          if (!Analyzer::Typecheck::isIntegerType(state, defStore, typeStore, value.span, operandType)) {
            Analyzer::Typecheck::emitInvalidUnaryOperandType(state, typeStore, value.span, "~", operandType);
            return Option::NONE;
          }

          Analyzer::Typecheck::recordExprType(state, exprId, operandType);
          return Option::SOME(operandType);
        },
        Ast::Expression::UnaryOperator::Increment -> {
          if (!Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, value.span, operandType)) {
            Analyzer::Typecheck::emitInvalidUnaryOperandType(state, typeStore, value.span, "++", operandType);
            return Option::NONE;
          }

          Analyzer::Typecheck::recordExprType(state, exprId, operandType);
          return Option::SOME(operandType);
        },
        Ast::Expression::UnaryOperator::Decrement -> {
          if (!Analyzer::Typecheck::isSupportedNumericType(state, defStore, typeStore, value.span, operandType)) {
            Analyzer::Typecheck::emitInvalidUnaryOperandType(state, typeStore, value.span, "--", operandType);
            return Option::NONE;
          }

          Analyzer::Typecheck::recordExprType(state, exprId, operandType);
          return Option::SOME(operandType);
        },
      };

      @panic("unreachable: checkUnaryExpr match did not return");
    }

    function checkLetElse(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      value: &Ast::Statement::LetElse,
    ): void {
      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        value.value,
      );

      let mut expectedTypeOpt: Option<Analyzer::TypeId> = Option::NONE;
      if (let Option::SOME(annotationId) = value.annotation) {
        expectedTypeOpt = Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, annotationId);
      } else {
        expectedTypeOpt = actualTypeOpt;
      }

      if (let Option::SOME(expectedType) = expectedTypeOpt) {
        if (let Option::SOME(actualType) = actualTypeOpt) {
          if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, value.span, expectedType, actualType)) {
            Analyzer::Typecheck::emitTypeMismatch(state, typeStore, value.span, expectedType, actualType);
          }
        }

        Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, value.pattern, expectedType, value.mutable, value.span);
      } else if (value.annotation.isSome()) {
        Analyzer::Typecheck::emitUnsupported(state, value.span, "unsupported local annotation type");
      }

      Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, value.elseBranch);
    }

    function checkLetLike(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
      annotation: Option<Ast::TypeId>,
      value: Option<Ast::ExpressionId>,
      mutable: boolean,
      span: SourceSpan,
    ): void {
      // The inline-let parser (expression blocks) attaches `: T` to the
      // binding pattern rather than the statement, so the effective
      // annotation is whichever of the two was written.
      let mut effectiveAnnotation: Option<Ast::TypeId> = annotation;

      if (effectiveAnnotation.isNone()) {
        if (let Option::SOME(Ast::Pattern::Node::Binding(bindingPattern)) = module.patterns.get(patternId)) {
          effectiveAnnotation = bindingPattern.annotation;
        }
      }

      let Option::SOME(annotationId) = effectiveAnnotation else {
        let Option::SOME(valueExprId) = value else {
          // `let mut x;` waits for its first assignment to say what it holds.
          // An immutable binding has no such assignment coming, so it is still
          // reported here.
          if (mutable) {
            let mut typeStorePlaceholderRef: &mut Analyzer::TypeStore = typeStore;
            let placeholder: Analyzer::TypeId = typeStorePlaceholderRef.intern(Analyzer::Type::VOID);
            Analyzer::Typecheck::pushPendingPatternLocal(state, resolvedBodies, patternId, placeholder, span);
            return;
          }

          Analyzer::Typecheck::emitCannotInferLocal(state, span);
          return;
        };

        let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          valueExprId,
        );

        // A failed initializer already reported its own diagnostic; a second
        // one for the binding would only repeat it.
        let Option::SOME(actualType) = actualTypeOpt else {
          return;
        };

        Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, patternId, actualType, mutable, span);
        return;
      };

      let expectedTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        annotationId,
      );
      let Option::SOME(expectedType) = expectedTypeOpt else {
        Analyzer::Typecheck::emitUnsupported(state, span, "unsupported local annotation type");
        return;
      };

      let Option::SOME(valueExprId) = value else {
        Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, patternId, expectedType, mutable, span);
        return;
      };

      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        valueExprId,
        Option::SOME(expectedType),
      );

      if (let Option::SOME(actualType) = actualTypeOpt) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, expectedType, actualType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, span, expectedType, actualType);
        }
      }

      Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, patternId, expectedType, mutable, span);
    }

    /// Type a `@name(...)` builtin call.
    ///
    /// Builtins are not declarations, so there is nothing to resolve a name against: the
    /// name itself selects the signature. Only the ones the self-hosted compiler needs for
    /// its own sources are typed so far; the rest are named in their diagnostic instead of
    /// being reported as one undifferentiated wall.
    function checkBuiltinCall(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      call: &Ast::Expression::BuiltinCall,
    ): Option<Analyzer::TypeId> {
      let name: &String = &call.name;

      if (name.equals("sizeOf") || name.equals("alignOf")) {
        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let resultType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::U64);

        return Analyzer::Typecheck::checkBuiltinWithOneTypeArgument(state, defStore, typeStore, symbols, module, call, resultType);
      }

      if (name.equals("typeName")) {
        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        let resultType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::STR);

        return Analyzer::Typecheck::checkBuiltinWithOneTypeArgument(state, defStore, typeStore, symbols, module, call, resultType);
      }

      if (name.equals("panic")) {
        return Analyzer::Typecheck::checkBuiltinPanic(state, typeStore, module, call);
      }

      if (name.equals("trap") || name.equals("unreachable")) {
        return Analyzer::Typecheck::checkBuiltinWithoutArguments(state, typeStore, call);
      }

      if (name.equals("pointerFromInteger")) {
        if (call.typeArguments.length() != 1) {
          Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 1, call.typeArguments.length());
          return Option::NONE;
        }

        if (call.arguments.length() != 1) {
          Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 1);
          return Option::NONE;
        }

        let Option::SOME(typeArgId) = call.typeArguments.get(0) else {
          return Option::NONE;
        };
        let Option::SOME(pointerResultType) = Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, *typeArgId) else {
          let detail: String = `the type argument of \`@${call.name.toStr()}\``;
          Analyzer::Typecheck::emitUnsupported(state, call.span, detail.toStr());
          return Option::NONE;
        };

        if (let Option::SOME(argExprId) = call.arguments.get(0)) {
          let _argType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, *argExprId);
        }

        return Option::SOME(pointerResultType);
      }

      if (name.equals("integerFromPointer")) {
        if (call.typeArguments.length() != 0) {
          Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 0, call.typeArguments.length());
          return Option::NONE;
        }

        if (call.arguments.length() != 1) {
          Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 1);
          return Option::NONE;
        }

        if (let Option::SOME(argExprId) = call.arguments.get(0)) {
          let _argType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, *argExprId);
        }

        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        return Option::SOME(typeStoreRef.intern(Analyzer::Type::U64));
      }

      if (name.equals("hash")) {
        if (call.typeArguments.length() != 1) {
          Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 1, call.typeArguments.length());
          return Option::NONE;
        }

        if (call.arguments.length() != 1) {
          Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 1);
          return Option::NONE;
        }

        let Option::SOME(typeArgId) = call.typeArguments.get(0) else {
          return Option::NONE;
        };
        let hashValueTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, *typeArgId);

        if (let Option::SOME(argExprId) = call.arguments.get(0)) {
          let _argType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(state, defStore, typeStore, symbols, module, resolvedBodies, *argExprId, hashValueTypeOpt);
        }

        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        return Option::SOME(typeStoreRef.intern(Analyzer::Type::U64));
      }

      if (name.equals("minOf") || name.equals("maxOf")) {
        return Analyzer::Typecheck::checkBuiltinTypeArgResult(state, defStore, typeStore, symbols, module, call);
      }

      if (name.equals("read") || name.equals("write") || name.equals("dropInPlace") || name.equals("eq")) {
        return Analyzer::Typecheck::checkBuiltinPointerFamily(state, defStore, typeStore, symbols, module, resolvedBodies, call);
      }

      if (Analyzer::Typecheck::isKnownBuiltinName(name)) {
        let detail: String = `the \`@${name.toStr()}\` builtin`;
        Analyzer::Typecheck::emitUnsupported(state, call.span, detail.toStr());
        return Option::NONE;
      }

      Analyzer::Typecheck::emitUnknownBuiltin(state, call.span, name.toStr());
      return Option::NONE;
    }

    /// Whether `name` is a builtin the language defines, typed here or not.
    ///
    /// Separating this from the typed set is what lets a misspelling be reported as an
    /// unknown builtin instead of as a construct that is merely unimplemented.
    ///
    /// `configFlag` is a directive rather than a builtin, but the parser turns every
    /// `@ident(...)` in expression position into a `BuiltinCall`, so it arrives here and
    /// belongs in the list — dropping it to match the builtin registry exactly would
    /// report legal source as an unknown builtin.
    function isKnownBuiltinName(name: &String): boolean {
      if (name.equals("typeOf") || name.equals("compileError") || name.equals("configFlag")) {
        return true;
      }

      if (name.equals("bitCast") || name.equals("pointerCast")) {
        return true;
      }

      if (name.equals("integerFromPointer") || name.equals("pointerFromInteger")) {
        return true;
      }

      if (name.equals("sliceFromParts") || name.equals("read") || name.equals("write")) {
        return true;
      }

      if (name.equals("hash") || name.equals("eq")) {
        return true;
      }

      if (name.equals("maxOf") || name.equals("minOf")) {
        return true;
      }

      return name.equals("dropInPlace") || name.equals("dropGlue");
    }

    /// `@minOf<T>()` / `@maxOf<T>()`: one type argument, no value arguments,
    /// and the result IS the type argument.
    function checkBuiltinTypeArgResult(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      call: &Ast::Expression::BuiltinCall,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() != 1) {
        Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 1, call.typeArguments.length());
        return Option::NONE;
      }

      if (call.arguments.length() != 0) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 0);
        return Option::NONE;
      }

      let Option::SOME(typeArgId) = call.typeArguments.get(0) else {
        return Option::NONE;
      };

      return Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, *typeArgId);
    }

    /// `@read<T>(p)`, `@write<T>(p, v)`, `@dropInPlace<T>(p)`, `@eq<T>(a, b)`:
    /// one type argument driving each argument's expectation.
    function checkBuiltinPointerFamily(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      call: &Ast::Expression::BuiltinCall,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() != 1) {
        Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 1, call.typeArguments.length());
        return Option::NONE;
      }

      let Option::SOME(typeArgId) = call.typeArguments.get(0) else {
        return Option::NONE;
      };
      let Option::SOME(valueType) = Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, *typeArgId) else {
        let detail: String = `the type argument of \`@${call.name.toStr()}\``;
        Analyzer::Typecheck::emitUnsupported(state, call.span, detail.toStr());
        return Option::NONE;
      };

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let pointerType: Analyzer::TypeId = typeStoreRef.mutablePointer(valueType);
      let voidType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::VOID);
      let booleanType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::BOOLEAN);

      let isEq: boolean = call.name.equals("eq");
      let isWrite: boolean = call.name.equals("write");
      let mut expectedCount: u64 = 1;
      if (isEq || isWrite) {
        expectedCount = 2;
      }

      if (call.arguments.length() != expectedCount) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), expectedCount);
        return Option::NONE;
      }

      let mut argIndex: u64 = 0;
      while (argIndex < call.arguments.length()) {
        let Option::SOME(argExprId) = call.arguments.get(argIndex) else {
          argIndex += 1;
          continue;
        };

        // @eq compares two T values; the pointer family points its first
        // argument at T and @write supplies a T second.
        let mut expectedArg: Analyzer::TypeId = pointerType;
        if (isEq || (isWrite && argIndex == 1)) {
          expectedArg = valueType;
        }

        let _argType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          *argExprId,
          Option::SOME(expectedArg),
        );
        argIndex += 1;
      }

      if (call.name.equals("read")) {
        return Option::SOME(valueType);
      }

      if (isEq) {
        return Option::SOME(booleanType);
      }

      return Option::SOME(voidType);
    }

    /// `@name<T>()`: exactly one type argument, no value arguments, fixed result type.
    function checkBuiltinWithOneTypeArgument(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      call: &Ast::Expression::BuiltinCall,
      resultType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() != 1) {
        Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 1, call.typeArguments.length());
        return Option::NONE;
      }

      if (call.arguments.length() != 0) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 0);
        return Option::NONE;
      }

      let Option::SOME(typeArgId) = call.typeArguments.get(0) else {
        return Option::NONE;
      };

      let Option::SOME(_operandType) = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        *typeArgId,
      ) else {
        let detail: String = `the type argument of \`@${call.name.toStr()}\``;
        Analyzer::Typecheck::emitUnsupported(state, call.span, detail.toStr());
        return Option::NONE;
      };

      return Option::SOME(resultType);
    }

    /// `@panic("literal")`: no type arguments, one string-literal argument, never returns.
    function checkBuiltinPanic(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      call: &Ast::Expression::BuiltinCall,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() != 0) {
        Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 0, call.typeArguments.length());
        return Option::NONE;
      }

      if (call.arguments.length() != 1) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 1);
        return Option::NONE;
      }

      let Option::SOME(messageExprId) = call.arguments.get(0) else {
        return Option::NONE;
      };

      if (!Analyzer::Typecheck::isStringLiteralExpr(module, *messageExprId)) {
        Analyzer::Typecheck::emitUnsupported(state, call.span, "`@panic` messages that are not string literals");
        return Option::NONE;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      return Option::SOME(typeStoreRef.intern(Analyzer::Type::NEVER));
    }

    /// `@name()`: no type arguments, no value arguments, never returns.
    function checkBuiltinWithoutArguments(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      call: &Ast::Expression::BuiltinCall,
    ): Option<Analyzer::TypeId> {
      if (call.typeArguments.length() != 0) {
        Analyzer::Typecheck::emitGenericArityMismatch(state, call.span, call.name.toStr(), 0, call.typeArguments.length());
        return Option::NONE;
      }

      if (call.arguments.length() != 0) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, call.span, call.arguments.length(), 0);
        return Option::NONE;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      return Option::SOME(typeStoreRef.intern(Analyzer::Type::NEVER));
    }

    /// Type a pipe whose right side names where the piped value goes with a `_`.
    ///
    /// The placeholder stands for the left side, so the right side is checked as an
    /// ordinary expression with the left side's type made available to whatever `_` it
    /// contains, and the pipe takes the right side's type. Nothing about arity or
    /// parameters is inspected here: the right side already says where the value lands.
    ///
    /// A right side with no `_` passes the value implicitly, as the callee's first
    /// argument.
    function checkPipeExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      pipe: &Ast::Expression::Pipe,
    ): Option<Analyzer::TypeId> {
      let leftTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        pipe.left,
      );

      let placeholderCount: u64 = Analyzer::Typecheck::countPipePlaceholders(module, pipe.right);

      if (placeholderCount > 1) {
        Analyzer::Typecheck::emitPipeMultiplePlaceholders(state, pipe.span);
        return Option::NONE;
      }

      if (placeholderCount == 0) {
        // Without the left side's type there is nothing to pass, and checking the callee
        // against a guessed one would report an argument nobody wrote.
        let Option::SOME(leftTypeForPrepend) = leftTypeOpt else {
          return Option::NONE;
        };

        return Analyzer::Typecheck::checkPipeImplicit(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          pipe,
          leftTypeForPrepend,
        );
      }

      // A `_` only means "the piped value goes here" inside something that consumes an
      // argument. Anywhere else — `1 |> _ + 2`, `1 |> _.field`, a bare `1 |> _` — it reads
      // as a value the pipe does nothing with, so the shape is rejected rather than
      // quietly accepted with the right side's type.
      if (!Analyzer::Typecheck::pipeRightSideTakesPlaceholder(module, pipe.right)) {
        Analyzer::Typecheck::emitPipePlaceholderNotInCall(state, pipe.span);
        return Option::NONE;
      }

      // Without the left side's type there is nothing to give the placeholder, and pushing
      // a guessed one would report the placeholder's uses against a type never written.
      let Option::SOME(leftType) = leftTypeOpt else {
        return Option::NONE;
      };

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.pipeValueTypes.push(leftType);

      let rightTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        pipe.right,
      );

      let mut stateRef2: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef2.pipeValueTypes.pop();

      return rightTypeOpt;
    }

    /// Dispatch a pipe whose right side names no `_`, so the value is passed implicitly.
    ///
    /// A call supplies its own arguments after the piped value; a bare name is called with
    /// the value alone. A form that takes arguments but has no argument list to prepend to
    /// — a record initializer, a vector literal, a builtin call — cannot receive the value
    /// implicitly and has to say where it goes, which is a different mistake from writing
    /// something that cannot be called at all.
    function checkPipeImplicit(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      pipe: &Ast::Expression::Pipe,
      leftType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      // `(f)` is the same callee as `f`. Only this path sees the wrapper — the placeholder
      // path goes through `checkExpr`, which looks past it — so without unwrapping, a pair
      // of parentheses would change the verdict.
      let rightExprId: Ast::ExpressionId = Analyzer::Typecheck::unwrapGroupedExpr(module, pipe.right);

      let Option::SOME(rightExpr) = module.expressions.get(rightExprId) else {
        return Option::NONE;
      };

      // A bare callee writes no arguments of its own; the piped value is the only one.
      let noExtraArgs: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();

      // A bare callee has no place to write type arguments either.
      let noTypeArgs: Vector<Ast::TypeId> = Vector::new<Ast::TypeId>();

      return match (rightExpr) {
        Ast::Expression::Node::Call(call) -> {
          return Analyzer::Typecheck::checkPipePrepend(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            pipe,
            call.callee,
            &call.typeArguments,
            &call.arguments,
            leftType,
          );
        },
        Ast::Expression::Node::Path(_) -> Analyzer::Typecheck::checkPipePrepend(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          pipe,
          rightExprId,
          &noTypeArgs,
          &noExtraArgs,
          leftType,
        ),
        Ast::Expression::Node::Variable(_) -> Analyzer::Typecheck::checkPipePrepend(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          pipe,
          rightExprId,
          &noTypeArgs,
          &noExtraArgs,
          leftType,
        ),
        Ast::Expression::Node::RecordInit(_) -> {
          Analyzer::Typecheck::emitPipeRightNeedsPlaceholder(state, pipe.span);
          return Option::NONE;
        },
        Ast::Expression::Node::Vector(_) -> {
          Analyzer::Typecheck::emitPipeRightNeedsPlaceholder(state, pipe.span);
          return Option::NONE;
        },
        Ast::Expression::Node::BuiltinCall(_) -> {
          Analyzer::Typecheck::emitPipeRightNeedsPlaceholder(state, pipe.span);
          return Option::NONE;
        },
        Ast::Expression::Node::Lambda(_) -> {
          return Analyzer::Typecheck::checkPipeLambda(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            pipe,
            rightExprId,
            leftType,
          );
        },
        Ast::Expression::Node::MemberAccess(ma) -> {
          return Analyzer::Typecheck::checkPipeBareMethod(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            pipe,
            &ma,
            leftType,
          );
        },
        _ -> {
          Analyzer::Typecheck::emitPipeRightNotCallable(state, pipe.span);
          return Option::NONE;
        },
      };
    }

    /// Look past any number of parentheses around `exprId`.
    function unwrapGroupedExpr(module: &Ast::Module, exprId: Ast::ExpressionId): Ast::ExpressionId {
      let mut current: Ast::ExpressionId = exprId;

      while (true) {
        let Option::SOME(expr) = module.expressions.get(current) else {
          return current;
        };

        let Ast::Expression::Node::Grouped(grouped) = expr else {
          return current;
        };

        current = grouped.expression;
      }

      return current;
    }

    /// A callee's parameter types and result, flattened out of whichever form it came in.
    ///
    /// A resolved function carries its parameters as definitions and a local holding a
    /// function value carries them as types; neither the pipe nor explicit type-argument
    /// specialization cares about that distinction, so both are reduced to the same shape
    /// before arity and types are checked.
    record CalleeSignature {
      public paramTypes: Vector<Analyzer::TypeId>;
      public returnType: Analyzer::TypeId;
    }

    /// What a pipe's right side resolved to, and whether its arguments are still
    /// worth checking.
    ///
    /// `checkArguments` is false when the call site wrote the wrong number of type
    /// arguments: every parameter type still mentions the type parameters, so checking
    /// against them would add one mismatch per argument on top of the real mistake. The
    /// signature is still carried so the pipe keeps a type and the surrounding
    /// expression goes on being checked, which is what the direct call path does.
    record PipeCallee {
      public signature: Analyzer::Typecheck::CalleeSignature;
      public checkArguments: boolean;
    }

    /// The type-parameter symbols a callee declares, in declaration order.
    ///
    /// Empty for a non-generic callee, and for anything that is not a function or a
    /// method — nothing else carries type parameters a call can specialize.
    function calleeTypeParamSymbols(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::SymbolId> {
      let mut symbols: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();

      let Option::SOME(def) = defStore.get(defId) else {
        return symbols;
      };

      let typeParams: Vector<Analyzer::DefinitionId> = match (def) {
        Analyzer::Definition::Function(function_) -> Analyzer::Typecheck::copyDefinitionIdVector(&function_.typeParams),
        Analyzer::Definition::Method(method) -> Analyzer::Typecheck::copyDefinitionIdVector(&method.typeParams),
        _ -> Vector::new<Analyzer::DefinitionId>(),
      };

      let mut index: u64 = 0;

      while (index < typeParams.length()) {
        let Option::SOME(typeParamDefId) = typeParams.get(index) else {
          index += 1;
          continue;
        };

        match (defStore.get(*typeParamDefId)) {
          Option::SOME(Analyzer::Definition::TypeParam(typeParam)) -> {
            symbols.push(typeParam.name);
          },
          _ -> {},
        };

        index += 1;
      }

      return symbols;
    }

    /// Specialize a generic callee's signature from the piped value.
    ///
    /// The piped value lands in the first parameter, so that parameter is what the
    /// value's type is unified against; every parameter and the return type are then
    /// substituted with what came out. `NONE` whenever there is nothing sound to
    /// specialize — a non-generic callee, an already-concrete first parameter, a shape
    /// the value does not match, or a type parameter the first parameter never mentions
    /// — and the caller keeps the declared signature.
    function inferPipeSignature(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      defId: Analyzer::DefinitionId,
      paramTypes: &Vector<Analyzer::TypeId>,
      returnType: Analyzer::TypeId,
      leftType: Analyzer::TypeId,
    ): Option<Analyzer::Typecheck::CalleeSignature> {
      let paramSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::calleeTypeParamSymbols(defStore, defId);

      if (paramSymbols.length() == 0) {
        return Option::NONE;
      }

      let Option::SOME(firstParamType) = paramTypes.get(0) else {
        return Option::NONE;
      };

      let targetType: Analyzer::TypeId = *firstParamType;

      if (!typeStore.containsTypeParam(targetType)) {
        return Option::NONE;
      }

      let Option::SOME(typeArguments) = typeStore.inferTypeArguments(targetType, leftType, &paramSymbols) else {
        return Option::NONE;
      };

      let mut specializedParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < paramTypes.length()) {
        let Option::SOME(paramType) = paramTypes.get(index) else {
          index += 1;
          continue;
        };

        let declaredType: Analyzer::TypeId = *paramType;
        let mut typeStoreParamRef: &mut Analyzer::TypeStore = typeStore;
        specializedParams.push(typeStoreParamRef.substitute(declaredType, &paramSymbols, &typeArguments));

        index += 1;
      }

      let mut typeStoreReturnRef: &mut Analyzer::TypeStore = typeStore;
      let specializedReturn: Analyzer::TypeId = typeStoreReturnRef.substitute(returnType, &paramSymbols, &typeArguments);

      return Option::SOME(Analyzer::Typecheck::CalleeSignature {
        paramTypes: specializedParams,
        returnType: specializedReturn,
      });
    }

    /// Resolve what `calleeExprId` names and flatten its signature.
    ///
    /// Reports its own failures, because only here is the reason known: a name that never
    /// resolved, a value that is not callable, and a method needing a receiver are three
    /// different mistakes, and one catch-all would describe two of them wrongly. A name the
    /// resolver already rejected is passed over in silence rather than reported twice.
    function pipeCalleeSignature(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      span: SourceSpan,
      calleeExprId: Ast::ExpressionId,
      typeArgumentIds: &Vector<Ast::TypeId>,
      leftType: Analyzer::TypeId,
    ): Option<Analyzer::Typecheck::PipeCallee> {
      let Option::SOME(resolved) = Analyzer::Typecheck::lookupExprRef(resolvedBodies, calleeExprId) else {
        return Option::NONE;
      };

      match (resolved) {
        Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> {
          // A path naming a method reaches here as `Type::method`, and only a static one
          // ever does: `resolvePathTail` turns an instance method into `Unresolved` after
          // reporting that it requires a receiver (resolver_bodies.ign, `InstanceMethod`
          // arm), so this side never sees one and needs no guard of its own. A static
          // method has no receiver to skip, so its parameters are taken whole, like any
          // other callee's.
          let Option::SOME(signature) = Analyzer::Typecheck::extractFunctionSignature(defStore, defId) else {
            Analyzer::Typecheck::emitPipeRightNotCallable(state, span);
            return Option::NONE;
          };

          let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < signature.params.length()) {
            let Option::SOME(paramDefId) = signature.params.get(index) else {
              return Option::NONE;
            };
            let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
              return Option::NONE;
            };

            // Anything but an ordinary parameter has no declared type to check against, and
            // guessing one would report the piped value against a type nobody wrote.
            let Analyzer::Definition::Variable(parameter) = paramDef else {
              Analyzer::Typecheck::emitUnsupported(state, span, "pipes into a callee with non-variable parameters");
              return Option::NONE;
            };

            paramTypes.push(parameter.declaredType);
            index += 1;
          }

          // Type arguments written at the call site say which types the callee's type
          // parameters stand for, so nothing is left to infer from the piped value.
          // A callee that declares none is specialized by neither, and its written
          // arguments are ignored rather than reported, like the direct call path.
          let writtenParamSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::calleeTypeParamSymbols(defStore, defId);

          if (typeArgumentIds.length() > 0 && writtenParamSymbols.length() > 0) {
            if (typeArgumentIds.length() != writtenParamSymbols.length()) {
              Analyzer::Typecheck::emitTypeArgumentCountMismatch(
                state,
                span,
                typeArgumentIds.length(),
                writtenParamSymbols.length(),
              );

              return Option::SOME(Analyzer::Typecheck::PipeCallee {
                signature: Analyzer::Typecheck::CalleeSignature {
                  paramTypes: paramTypes,
                  returnType: signature.returnType,
                },
                checkArguments: false,
              });
            }

            let Option::SOME(written) = Analyzer::Typecheck::specializeSignatureFromWrittenTypeArguments(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              span,
              typeArgumentIds,
              &writtenParamSymbols,
              &paramTypes,
              signature.returnType,
            ) else {
              return Option::NONE;
            };

            return Option::SOME(Analyzer::Typecheck::PipeCallee {
              signature: written,
              checkArguments: true,
            });
          }

          // A generic callee's declared parameters mention its type parameters, so the
          // piped value is what says which types they stand for. Nothing is inferred
          // when the callee is not generic, when the first parameter is already
          // concrete, or when the value's shape disagrees with it — the declared types
          // are used and the ordinary argument check reports whatever is wrong.
          if (let Option::SOME(specialized) = Analyzer::Typecheck::inferPipeSignature(
            defStore,
            typeStore,
            defId,
            &paramTypes,
            signature.returnType,
            leftType,
          )) {
            return Option::SOME(Analyzer::Typecheck::PipeCallee {
              signature: specialized,
              checkArguments: true,
            });
          }

          return Option::SOME(Analyzer::Typecheck::PipeCallee {
            signature: Analyzer::Typecheck::CalleeSignature {
              paramTypes: paramTypes,
              returnType: signature.returnType,
            },
            checkArguments: true,
          });
        },
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
          // A local holds a concrete function type with no type parameters left to
          // specialize, so type arguments have nothing to bind to. The direct call path
          // refuses these for the same reason.
          if (typeArgumentIds.length() > 0) {
            Analyzer::Typecheck::emitUnsupported(state, span, "type arguments on calls through local values");
            return Option::NONE;
          }

          let Option::SOME(binding) = Analyzer::Typecheck::lookupLocalBinding(state, localId) else {
            return Option::NONE;
          };
          let Option::SOME(bindingType) = typeStore.get(binding.typeId) else {
            return Option::NONE;
          };
          let Analyzer::Type::Function(functionType) = bindingType else {
            Analyzer::Typecheck::emitCallOnNonCallable(state, typeStore, span, binding.typeId);
            return Option::NONE;
          };

          // The parameter list belongs to the interned type, so it is copied rather than
          // handed over: moving it out leaves the store holding freed memory.
          let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut paramIndex: u64 = 0;

          while (paramIndex < functionType.params.length()) {
            let Option::SOME(paramType) = functionType.params.get(paramIndex) else {
              return Option::NONE;
            };

            paramTypes.push(*paramType);
            paramIndex += 1;
          }

          return Option::SOME(Analyzer::Typecheck::PipeCallee {
            signature: Analyzer::Typecheck::CalleeSignature {
              paramTypes: paramTypes,
              returnType: functionType.returnType,
            },
            checkArguments: true,
          });
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, span, "pipes into a type parameter");
          return Option::NONE;
        },
        // The resolver already reported the name; a second diagnostic here would claim the
        // callee's kind was understood when it was never found at all.
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          return Option::NONE;
        },
      };
    }

    /// Type a pipe that passes its value implicitly, as the callee's first argument.
    ///
    /// `extraArgs` are the arguments written at the call site, which follow the piped
    /// value: `x |> f(a)` calls `f(x, a)`. A bare callee (`x |> f`) has none.
    function checkPipePrepend(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      pipe: &Ast::Expression::Pipe,
      calleeExprId: Ast::ExpressionId,
      typeArgumentIds: &Vector<Ast::TypeId>,
      extraArgs: &Vector<Ast::ExpressionId>,
      leftType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      // `pipeCalleeSignature` reports whatever went wrong, so nothing is added here.
      let Option::SOME(callee) = Analyzer::Typecheck::pipeCalleeSignature(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        pipe.span,
        calleeExprId,
        typeArgumentIds,
        leftType,
      ) else {
        return Option::NONE;
      };

      let signature: Analyzer::Typecheck::CalleeSignature = callee.signature;

      // The type arguments were already reported as wrong, and every parameter type
      // still mentions the type parameters they were meant to bind.
      if (!callee.checkArguments) {
        Analyzer::Typecheck::recordExprType(state, pipe.right, signature.returnType);
        return Option::SOME(signature.returnType);
      }

      let suppliedCount: u64 = extraArgs.length() + 1;

      // A wrong count is reported once and then the arguments are still checked against
      // the parameters that do line up, and the pipe still takes the callee's return type.
      // Bailing out instead would hide every other mistake in the same expression behind
      // one recompile, and would strip the type off a pipe whose callee is known.
      if (suppliedCount != signature.paramTypes.length()) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, pipe.span, suppliedCount, signature.paramTypes.length());
      }

      // The piped value fills the first parameter; everything written at the call site
      // shifts one place right.
      if (let Option::SOME(firstParamType) = signature.paramTypes.get(0)) {
        if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, pipe.span, *firstParamType, leftType)) {
          Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, pipe.span, *firstParamType, leftType);
        }
      }

      let mut index: u64 = 0;

      while (index < extraArgs.length()) {
        let Option::SOME(argExprId) = extraArgs.get(index) else {
          index += 1;
          continue;
        };

        let expectedType: Option<Analyzer::TypeId> = match (signature.paramTypes.get(index + 1)) {
          Option::SOME(paramType) -> Option::SOME(*paramType),
          Option::NONE -> Option::NONE,
        };

        let actualOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          *argExprId,
          expectedType,
        );

        if (let Option::SOME(expected) = expectedType) {
          if (let Option::SOME(actual) = actualOpt) {
            if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, pipe.span, expected, actual)) {
              Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, pipe.span, expected, actual);
            }
          }
        }

        index += 1;
      }

      // The right side is the call being made, so it carries the same type as the pipe.
      // Without this the table would hold an entry for `1 |> f(_)` and none for `1 |> f(a)`.
      Analyzer::Typecheck::recordExprType(state, pipe.right, signature.returnType);

      return Option::SOME(signature.returnType);
    }

    /// Check the piped value against the single parameter a bare right side takes.
    ///
    /// A right side that takes no parameter at all has nowhere to put the value, and one
    /// that takes several is reported once and then still checked against its first, so an
    /// arity mistake does not hide a type one. Reporting is all this does: whether the
    /// pipe keeps a type afterwards is the caller's decision, because a callee whose
    /// return type is known can still supply it while a lambda that turned out not to be
    /// callable cannot.
    function checkPipedValueAgainstFirstParam(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      paramTypes: &Vector<Analyzer::TypeId>,
      leftType: Analyzer::TypeId,
    ): void {
      if (paramTypes.length() != 1) {
        Analyzer::Typecheck::emitInvalidNumberOfArguments(state, span, 1, paramTypes.length());
      }

      let Option::SOME(firstParamType) = paramTypes.get(0) else {
        return;
      };

      let expectedType: Analyzer::TypeId = *firstParamType;

      if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, span, expectedType, leftType)) {
        Analyzer::Typecheck::emitInvalidArgumentType(state, typeStore, span, expectedType, leftType);
      }
    }

    /// Type `x |> (v) -> ...`, a lambda written as the right side of a pipe.
    ///
    /// The lambda is typed through the ordinary path and its function type destructured;
    /// nothing is propagated from the piped value into its parameters, so an unannotated
    /// parameter is resolved by the lambda's own rules. A right side whose type is not a
    /// function is the same mistake as any other uncallable right side.
    function checkPipeLambda(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      pipe: &Ast::Expression::Pipe,
      lambdaExprId: Ast::ExpressionId,
      leftType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      let lambdaType: Analyzer::TypeId = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, lambdaExprId)!;

      let Option::SOME(lambdaTypeNode) = typeStore.get(lambdaType) else {
        return Option::NONE;
      };

      let Analyzer::Type::Function(functionType) = lambdaTypeNode else {
        Analyzer::Typecheck::emitPipeRightNotCallable(state, pipe.span);
        return Option::NONE;
      };

      let paramTypes: Vector<Analyzer::TypeId> = Analyzer::Typecheck::copyTypeIdVector(&functionType.params);
      let returnType: Analyzer::TypeId = functionType.returnType;

      Analyzer::Typecheck::checkPipedValueAgainstFirstParam(state, defStore, typeStore, pipe.span, &paramTypes, leftType);

      // A lambda taking no parameter is not a callee this pipe can complete, so the pipe
      // has no type to offer — unlike a named callee, whose return type stands on its own.
      if (paramTypes.length() == 0) {
        return Option::NONE;
      }

      return Option::SOME(returnType);
    }

    /// Type `x |> obj.method`, which calls the method with the piped value as its only
    /// explicit argument.
    ///
    /// Resolution mirrors the direct instance-call path — deref the receiver, require a
    /// non-generic owner, look the member up among the instance methods, and report a
    /// static method reached through an instance as a kind mismatch rather than an unknown
    /// member. The receiver's own mutability is checked here too: piping does not make a
    /// mutating method callable on an immutable binding.
    function checkPipeBareMethod(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      pipe: &Ast::Expression::Pipe,
      ma: &Ast::Expression::MemberAccess,
      leftType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      let objectType: Analyzer::TypeId = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, ma.object)!;

      let receiverType: Analyzer::TypeId = Analyzer::Typecheck::derefReceiverType(defStore, typeStore, objectType);

      let owner: Analyzer::Typecheck::RequiredMethodOwner = Analyzer::Typecheck::requireMethodOwner(
        state,
        defStore,
        typeStore,
        ma.span,
        receiverType,
        "method call target must be a non-generic record or enum",
        "typecheck does not support generic method receivers",
      )!;

      let memberName: str = ma.member.toStr();

      let Option::SOME(methodDefId) = Analyzer::ResolverBodies::lookupMethodInTable(defStore, &owner.instanceMethods, memberName, symbols) else {
        let staticOpt: Option<Analyzer::DefinitionId> = Analyzer::ResolverBodies::lookupMethodInTable(
          defStore,
          &owner.staticMethods,
          memberName,
          symbols,
        );

        if (staticOpt.isSome()) {
          let message: String = `static method \`${memberName}\` cannot be called through an instance`;
          Analyzer::Typecheck::emitDiagnostic(state, ma.span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, message.toStr());
          return Option::NONE;
        }

        Analyzer::Typecheck::emitNamedRecordFieldDiagnostic(state, ma.span, DiagnosticCode::UNKNOWN_MEMBER, "unknown method", memberName);
        return Option::NONE;
      };

      let info: Analyzer::Typecheck::MethodCallInfo = Analyzer::Typecheck::lookupMethodDefInfo(defStore, methodDefId)!;

      if (info.selfMutable) {
        Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, ma.object);

        // Same reference-first rule as the direct call path: the reference
        // type's mutability decides before the binding's.
        let referenceMutability: Option<boolean> = Analyzer::Typecheck::receiverReferenceMutability(defStore, typeStore, objectType);

        if (let Option::SOME(referenceMutable) = referenceMutability) {
          if (!referenceMutable) {
            Analyzer::Typecheck::emitDiagnostic(state, ma.span, DiagnosticCode::MUTABILITY_VIOLATION, "cannot call mutable method through a shared reference");
            return Option::NONE;
          }
        } else if (!Analyzer::Typecheck::pipeReceiverIsMutable(state, resolvedBodies, ma.object)) {
          Analyzer::Typecheck::emitDiagnostic(state, ma.span, DiagnosticCode::MUTABILITY_VIOLATION, "cannot call mutable method on immutable receiver");
          return Option::NONE;
        }
      }

      let signature: Analyzer::Typecheck::FunctionSignature = Analyzer::Typecheck::extractFunctionSignature(defStore, methodDefId)!;

      let declaredParamTypes: Vector<Analyzer::TypeId> = Analyzer::Typecheck::methodExplicitParamTypes(defStore, &signature, info.isStatic);

      // Same specialization as the direct method call path: an instantiated receiver
      // decides what the owner's type parameters stand for before the piped value is
      // compared against the first one.
      let specialized: Analyzer::Typecheck::CalleeSignature = Analyzer::Typecheck::substituteOwnerTypeArguments(
        typeStore,
        &owner,
        &declaredParamTypes,
        signature.returnType,
      );

      // A wrong count is reported and the pipe still takes the method's return type, the
      // same way `checkPipePrepend` treats a miscounted call: the method is known, so
      // stripping the type would hide every later mistake behind one recompile.
      Analyzer::Typecheck::checkPipedValueAgainstFirstParam(state, defStore, typeStore, pipe.span, &specialized.paramTypes, leftType);

      Analyzer::Typecheck::recordExprType(state, pipe.right, specialized.returnType);

      return Option::SOME(specialized.returnType);
    }

    /// Whether the receiver place a piped method call mutates is a mutable binding.
    ///
    /// Only a local binding carries mutability the checker can see; a field or a call
    /// result is the same accepted debt as on the direct call path (ADR D7).
    function pipeReceiverIsMutable(
      state: &mut Analyzer::Typecheck::TypecheckState,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      receiverExprId: Ast::ExpressionId,
    ): boolean {
      let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Local(localId)) = Analyzer::Typecheck::lookupExprRef(resolvedBodies, receiverExprId) else {
        return true;
      };

      let Option::SOME(binding) = Analyzer::Typecheck::lookupLocalBinding(state, localId) else {
        return true;
      };

      return binding.mutable;
    }

    /// A method's parameter types with the receiver removed: an instance method's first
    /// parameter is `self`, which the caller never supplies.
    function methodExplicitParamTypes(
      defStore: &mut Analyzer::DefinitionStore,
      signature: &Analyzer::Typecheck::FunctionSignature,
      isStatic: boolean,
    ): Vector<Analyzer::TypeId> {
      let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      if (!isStatic) {
        index = 1;
      }

      while (index < signature.params.length()) {
        let Option::SOME(paramDefId) = signature.params.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
          index += 1;
          continue;
        };

        match (paramDef) {
          Analyzer::Definition::Variable(parameter) -> {
            paramTypes.push(parameter.declaredType);
          },
          _ -> {},
        };

        index += 1;
      }

      return paramTypes;
    }

    /// The type a `_` stands for: the value piped by the innermost enclosing pipe.
    function checkPipePlaceholderExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      placeholder: &Ast::Expression::PipePlaceholder,
    ): Option<Analyzer::TypeId> {
      let depth: u64 = state.pipeValueTypes.length();

      if (depth == 0) {
        Analyzer::Typecheck::emitPipePlaceholderOutsidePipe(state, placeholder.span);
        return Option::NONE;
      }

      let Option::SOME(valueType) = state.pipeValueTypes.get(depth - 1) else {
        return Option::NONE;
      };

      return Option::SOME(*valueType);
    }

    /// Whether a right side of this shape can hold the piped value in a `_`.
    ///
    /// These are the forms that take arguments, so a `_` among them names a position the
    /// value fills. The list is closed on purpose: accepting any right side that merely
    /// contains a `_` somewhere would make `1 |> _ + 2` mean something, and no rule says
    /// what.
    function pipeRightSideTakesPlaceholder(
      module: &Ast::Module,
      exprId: Ast::ExpressionId
    ): boolean {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return false;
      };

      return match (expr) {
        Ast::Expression::Node::Call(_) -> true,
        Ast::Expression::Node::BuiltinCall(_) -> true,
        Ast::Expression::Node::RecordInit(_) -> true,
        Ast::Expression::Node::Vector(_) -> true,
        _ -> false,
      };
    }

    /// How many `_` placeholders belong to the pipe step rooted at `exprId`.
    ///
    /// A lambda body and a nested pipe each own whatever `_` they contain, so the walk
    /// stops at both: counting through them would let an inner `_` decide the outer pipe's
    /// shape. Every other expression is transparent.
    function countPipePlaceholders(module: &Ast::Module, exprId: Ast::ExpressionId): u64 {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return 0;
      };

      return match (expr) {
        Ast::Expression::Node::PipePlaceholder(_) -> 1,
        Ast::Expression::Node::Lambda(_) -> 0,
        Ast::Expression::Node::Pipe(_) -> 0,
        Ast::Expression::Node::Literal(_) -> 0,
        Ast::Expression::Node::Path(_) -> 0,
        Ast::Expression::Node::Variable(_) -> 0,
        Ast::Expression::Node::Unit(_) -> 0,
        Ast::Expression::Node::Block(value) -> Analyzer::Typecheck::countPipePlaceholdersInStatements(module, &value.statements)
          + Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.tail),
        Ast::Expression::Node::If(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.thenBranch)
          + Analyzer::Typecheck::countPipePlaceholdersInOptionalStatement(module, value.elseBranch),
        Ast::Expression::Node::Grouped(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Expression::Node::Cast(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Expression::Node::CaptureOverride(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Expression::Node::Try(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Expression::Node::Dereference(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.operand),
        Ast::Expression::Node::Unary(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.operand),
        Ast::Expression::Node::PostfixIncrement(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.operand),
        Ast::Expression::Node::PostfixDecrement(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.operand),
        Ast::Expression::Node::Reference(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.target),
        Ast::Expression::Node::LetCondition(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.value),
        // The member is a name, not an expression, so only the object can hold a `_`.
        Ast::Expression::Node::MemberAccess(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.object),
        Ast::Expression::Node::Binary(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.left)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.right),
        Ast::Expression::Node::Assignment(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.target)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.value),
        Ast::Expression::Node::VectorAccess(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.vector)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.index),
        Ast::Expression::Node::Ternary(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.thenBranch)
          + Analyzer::Typecheck::countPipePlaceholders(module, value.elseBranch),
        Ast::Expression::Node::Call(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.callee)
          + Analyzer::Typecheck::countPipePlaceholdersIn(module, &value.arguments),
        Ast::Expression::Node::BuiltinCall(value) -> Analyzer::Typecheck::countPipePlaceholdersIn(module, &value.arguments),
        Ast::Expression::Node::Tuple(value) -> Analyzer::Typecheck::countPipePlaceholdersIn(module, &value.elements),
        Ast::Expression::Node::Vector(value) -> Analyzer::Typecheck::countPipePlaceholdersIn(module, &value.elements),
        Ast::Expression::Node::RecordInit(value) -> Analyzer::Typecheck::countPipePlaceholdersInFields(module, &value.fields),
        Ast::Expression::Node::Match(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.scrutinee)
          + Analyzer::Typecheck::countPipePlaceholdersInArms(module, &value.arms),
      };
    }

    /// Placeholders inside a statement, so a `_` in a braced block or an `if` branch is
    /// counted rather than hidden.
    ///
    /// A statement that opens a new function body (an `Item`) is not part of this pipe
    /// step, for the same reason a lambda is not, so it contributes nothing.
    function countPipePlaceholdersInStatement(
      module: &Ast::Module,
      statementId: Ast::StatementId
    ): u64 {
      let Option::SOME(statement) = module.statements.get(statementId) else {
        return 0;
      };

      return match (statement) {
        Ast::Statement::Node::Continue(_) -> 0,
        Ast::Statement::Node::Comment(_) -> 0,
        Ast::Statement::Node::Item(_) -> 0,
        Ast::Statement::Node::Expression(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.expression),
        Ast::Statement::Node::Defer(value) -> Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.statement),
        Ast::Statement::Node::Variable(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.value),
        Ast::Statement::Node::Let(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.value),
        Ast::Statement::Node::Return(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.value),
        Ast::Statement::Node::Break(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.value),
        Ast::Statement::Node::LetElse(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.value)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.elseBranch),
        Ast::Statement::Node::While(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.body),
        Ast::Statement::Node::ForOf(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.iterable)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.body),
        Ast::Statement::Node::Block(value) -> Analyzer::Typecheck::countPipePlaceholdersInStatements(module, &value.statements)
          + Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.tail),
        Ast::Statement::Node::If(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.thenBranch)
          + Analyzer::Typecheck::countPipePlaceholdersInOptionalStatement(module, value.elseBranch),
        Ast::Statement::Node::For(value) -> Analyzer::Typecheck::countPipePlaceholdersInOptionalStatement(module, value.initializer)
          + Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.condition)
          + Analyzer::Typecheck::countPipePlaceholdersInOptional(module, value.update)
          + Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value.body),
      };
    }

    function countPipePlaceholdersInStatements(
      module: &Ast::Module,
      statementIds: &Vector<Ast::StatementId>
    ): u64 {
      let mut total: u64 = 0;
      let mut index: u64 = 0;

      while (index < statementIds.length()) {
        if (let Option::SOME(statementId) = statementIds.get(index)) {
          total += Analyzer::Typecheck::countPipePlaceholdersInStatement(module, *statementId);
        }

        index += 1;
      }

      return total;
    }

    function countPipePlaceholdersInOptional(
      module: &Ast::Module,
      exprId: Option<Ast::ExpressionId>
    ): u64 {
      return match (exprId) {
        Option::SOME(value) -> Analyzer::Typecheck::countPipePlaceholders(module, value),
        Option::NONE -> 0,
      };
    }

    function countPipePlaceholdersInOptionalStatement(
      module: &Ast::Module,
      statementId: Option<Ast::StatementId>
    ): u64 {
      return match (statementId) {
        Option::SOME(value) -> Analyzer::Typecheck::countPipePlaceholdersInStatement(module, value),
        Option::NONE -> 0,
      };
    }

    function countPipePlaceholdersIn(
      module: &Ast::Module,
      exprIds: &Vector<Ast::ExpressionId>
    ): u64 {
      let mut total: u64 = 0;
      let mut index: u64 = 0;

      while (index < exprIds.length()) {
        if (let Option::SOME(exprId) = exprIds.get(index)) {
          total += Analyzer::Typecheck::countPipePlaceholders(module, *exprId);
        }

        index += 1;
      }

      return total;
    }

    function countPipePlaceholdersInFields(
      module: &Ast::Module,
      fields: &Vector<Ast::Expression::RecordInitField>,
    ): u64 {
      let mut total: u64 = 0;
      let mut index: u64 = 0;

      while (index < fields.length()) {
        if (let Option::SOME(field) = fields.get(index)) {
          total += Analyzer::Typecheck::countPipePlaceholders(module, field.value);
        }

        index += 1;
      }

      return total;
    }

    function countPipePlaceholdersInArms(
      module: &Ast::Module,
      arms: &Vector<Ast::Expression::MatchArm>,
    ): u64 {
      let mut total: u64 = 0;
      let mut index: u64 = 0;

      while (index < arms.length()) {
        if (let Option::SOME(arm) = arms.get(index)) {
          total += Analyzer::Typecheck::countPipePlaceholders(module, arm.body);

          if (let Option::SOME(guardId) = arm.guard) {
            total += Analyzer::Typecheck::countPipePlaceholders(module, guardId);
          }
        }

        index += 1;
      }

      return total;
    }

    /// Whether `exprId` is a string literal written in place.
    function isStringLiteralExpr(module: &Ast::Module, exprId: Ast::ExpressionId): boolean {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return false;
      };

      let Ast::Expression::Node::Literal(literal) = expr else {
        return false;
      };

      return match (&literal.value) {
        Ast::Expression::LiteralValue::String(_) -> true,
        Ast::Expression::LiteralValue::Int(_) -> false,
        Ast::Expression::LiteralValue::UInt(_) -> false,
        Ast::Expression::LiteralValue::Float(_) -> false,
        Ast::Expression::LiteralValue::Boolean(_) -> false,
        Ast::Expression::LiteralValue::Character(_) -> false,
        Ast::Expression::LiteralValue::Null -> false,
      };
    }

    /// Type a lambda: its parameters bind in a scope of their own, its body is checked
    /// against its declared return type, and the result is the function type it denotes.
    ///
    /// Both the parameter annotations and the return annotation are required. Inferring them
    /// needs an expected type flowing in from the use site, which `checkExprExpected` does not
    /// carry through a lambda yet.
    function checkLambdaExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      lambda: &Ast::Expression::Lambda,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(declaredReturn) = lambda.returnType else {
        Analyzer::Typecheck::emitUnsupported(state, lambda.span, "lambdas without an explicit return type");
        return Option::NONE;
      };

      let Option::SOME(returnType) = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        declaredReturn,
      ) else {
        Analyzer::Typecheck::emitUnsupported(state, lambda.span, "unsupported lambda return type");
        return Option::NONE;
      };

      let mut paramTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut paramIndex: u64 = 0;

      while (paramIndex < lambda.parameters.length()) {
        let Option::SOME(paramPatternId) = lambda.parameters.get(paramIndex) else {
          return Option::NONE;
        };

        let Option::SOME(paramType) = Analyzer::Typecheck::lambdaParameterType(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          *paramPatternId,
          lambda.span,
        ) else {
          return Option::NONE;
        };

        paramTypes.push(paramType);
        paramIndex += 1;
      }

      // The body is checked in its own scope, against its own return type. Without saving the
      // enclosing one, a `return` inside the lambda would be checked against the function the
      // lambda is written in.
      let enclosingReturnType: Analyzer::TypeId = state.currentReturnType;
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.currentReturnType = returnType;

      Analyzer::Typecheck::pushScope(stateRef);

      let mut boundIndex: u64 = 0;

      while (boundIndex < lambda.parameters.length()) {
        let Option::SOME(paramPatternId) = lambda.parameters.get(boundIndex) else {
          boundIndex += 1;
          continue;
        };

        let Option::SOME(paramType) = paramTypes.get(boundIndex) else {
          boundIndex += 1;
          continue;
        };

        let _bound: boolean = Analyzer::Typecheck::pushPatternLocal(
          stateRef,
          resolvedBodies,
          *paramPatternId,
          *paramType,
          false,
          lambda.span,
        );
        boundIndex += 1;
      }

      Analyzer::Typecheck::checkStmt(stateRef, defStore, typeStore, symbols, module, resolvedBodies, lambda.body);
      Analyzer::Typecheck::popScope(stateRef);

      stateRef.currentReturnType = enclosingReturnType;

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;

      return Option::SOME(typeStoreRef.intern(Analyzer::Type::Function(Analyzer::FunctionType {
        params: paramTypes,
        returnType: returnType,
      })));
    }

    /// The declared type of one lambda parameter.
    ///
    /// The parser only ever produces binding patterns here, and the annotation is what gives
    /// the parameter its type: there is nothing else to infer it from.
    function lambdaParameterType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      patternId: Ast::PatternId,
      span: SourceSpan,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return Option::NONE;
      };

      let Ast::Pattern::Node::Binding(binding) = pattern else {
        Analyzer::Typecheck::emitUnsupported(state, span, "non-binding lambda parameters");
        return Option::NONE;
      };

      let Option::SOME(annotation) = binding.annotation else {
        Analyzer::Typecheck::emitUnsupported(state, span, "lambda parameters without explicit annotations");
        return Option::NONE;
      };

      let Option::SOME(paramType) = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        annotation,
      ) else {
        Analyzer::Typecheck::emitUnsupported(state, span, "unsupported lambda parameter type");
        return Option::NONE;
      };

      return Option::SOME(paramType);
    }

    /// The iterable-record protocol behind `for..of`: a record iterates when
    /// it declares a `data` field of pointer type and a `length` field of
    /// type `u64`; the element type is the `data` pointee. Mirrors the Rust
    /// `extract_record_iterable_element_type`.
    function recordIterableElementType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      defId: Analyzer::DefinitionId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Option::NONE;
      };

      let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      match (def) {
        Analyzer::Definition::Record(recordDef) -> {
          let mut fieldIndex: u64 = 0;
          while (fieldIndex < recordDef.fields.length()) {
            let Option::SOME(fieldDefId) = recordDef.fields.get(fieldIndex) else {
              fieldIndex += 1;
              continue;
            };

            fields.push(*fieldDefId);
            fieldIndex += 1;
          }
        },
        _ -> {
          return Option::NONE;
        },
      };

      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let dataSymbol: Analyzer::SymbolId = symbolsRef.intern("data");
      let lengthSymbol: Analyzer::SymbolId = symbolsRef.intern("length");

      let mut dataFieldType: Option<Analyzer::TypeId> = Option::NONE;
      let mut lengthFieldType: Option<Analyzer::TypeId> = Option::NONE;

      let mut index: u64 = 0;
      while (index < fields.length()) {
        let Option::SOME(fieldDefId) = fields.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(fieldDefNode) = defStore.get(*fieldDefId) else {
          index += 1;
          continue;
        };

        match (fieldDefNode) {
          Analyzer::Definition::Field(fieldDef) -> {
            if (fieldDef.name.raw() == dataSymbol.raw()) {
              dataFieldType = Option::SOME(fieldDef.fieldType);
            } else if (fieldDef.name.raw() == lengthSymbol.raw()) {
              lengthFieldType = Option::SOME(fieldDef.fieldType);
            }
          },
          _ -> {},
        };

        index += 1;
      }

      // Field types are matched behind their alias chains so a
      // `type Len = u64;` length field still qualifies, mirroring the
      // post-resolution types the Rust analyzer stores on fields.
      let mut dataElementType: Option<Analyzer::TypeId> = Option::NONE;
      if (let Option::SOME(fieldType) = dataFieldType) {
        if (let Option::SOME(resolvedType) = Analyzer::Typecheck::nonCyclicAliasResolvedType(defStore, typeStore, fieldType)) {
          if (let Option::SOME(fieldTypeNode) = typeStore.get(resolvedType)) {
            if (let Analyzer::Type::Pointer(pointer) = fieldTypeNode) {
              dataElementType = Option::SOME(pointer.pointee);
            }
          }
        }
      }

      let mut hasLength: boolean = false;
      if (let Option::SOME(fieldType) = lengthFieldType) {
        if (let Option::SOME(resolvedType) = Analyzer::Typecheck::nonCyclicAliasResolvedType(defStore, typeStore, fieldType)) {
          if (let Option::SOME(fieldTypeNode) = typeStore.get(resolvedType)) {
            if (let Analyzer::Type::U64 = fieldTypeNode) {
              hasLength = true;
            }
          }
        }
      }

      if (!hasLength) {
        return Option::NONE;
      }

      return dataElementType;
    }

    /// Alias-resolved type id, or `NONE` when the chain is cyclic. Cyclic
    /// aliases are diagnosed where they are declared, so callers here simply
    /// treat them as non-matching.
    function nonCyclicAliasResolvedType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(_) = resolved.cycleAlias) {
        return Option::NONE;
      }

      return Option::SOME(resolved.typeId);
    }

    /// Extract the element type a `for..of` iterable yields, or emit
    /// `FOR_OF_EXPECTS_VECTOR`. Slices and fixed arrays yield their element;
    /// records qualify through the iterable-record protocol.
    function forOfElementType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      span: SourceSpan,
      iterableType: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, iterableType);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
        return Option::NONE;
      };

      let mut elementTypeOpt: Option<Analyzer::TypeId> = Option::NONE;
      let mut recordDefId: Option<Analyzer::DefinitionId> = Option::NONE;

      match (typeNode) {
        Analyzer::Type::Slice(element) -> {
          elementTypeOpt = Option::SOME(element);
        },
        Analyzer::Type::FixedArray(element, _) -> {
          elementTypeOpt = Option::SOME(element);
        },
        Analyzer::Type::Record(defId) -> {
          recordDefId = Option::SOME(defId);
        },
        _ -> {},
      };

      if (let Option::SOME(defId) = recordDefId) {
        elementTypeOpt = Analyzer::Typecheck::recordIterableElementType(defStore, typeStore, symbols, defId);
      }

      let Option::SOME(elementType) = elementTypeOpt else {
        Analyzer::Typecheck::emitForOfExpectsVector(state, typeStore, span, iterableType);
        return Option::NONE;
      };

      return Option::SOME(elementType);
    }

    /// Mirror of the Rust `resolve_for_of_binding_type`: an unannotated
    /// binding takes the element by value and requires it to be Copy; a
    /// reference annotation must name the element type and binds `&T` /
    /// `&mut T`, with `&mut` additionally requiring the iterable to be a
    /// mutable place; a by-value annotation must name the element type and
    /// also requires Copy. `NONE` means no binding should be introduced.
    function resolveForOfBindingType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
      elementType: Analyzer::TypeId,
      iterableExprId: Ast::ExpressionId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return Option::SOME(elementType);
      };

      let Ast::Pattern::Node::Binding(binding) = pattern else {
        return Option::SOME(elementType);
      };

      let bindingSpan: SourceSpan = binding.span;

      let Option::SOME(annotationId) = binding.annotation else {
        if (Analyzer::Typecheck::isCopyType(state, defStore, typeStore, bindingSpan, elementType)) {
          return Option::SOME(elementType);
        }

        Analyzer::Typecheck::emitForOfRequiresCopyOrRef(state, typeStore, bindingSpan, elementType);
        return Option::NONE;
      };

      let Option::SOME(annotationNode) = module.types.get(annotationId) else {
        return Option::SOME(elementType);
      };

      if (let Ast::Type::Node::Reference(reference) = annotationNode) {
        let referentTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::resolveLocalAnnotation(
          defStore,
          typeStore,
          symbols,
          module,
          reference.target,
        );
        let Option::SOME(referentType) = referentTypeOpt else {
          Analyzer::Typecheck::emitUnsupported(state, bindingSpan, "unsupported local annotation type");
          return Option::NONE;
        };

        if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, bindingSpan, referentType, elementType)) {
          Analyzer::Typecheck::emitTypeMismatch(state, typeStore, bindingSpan, elementType, referentType);
        }

        if (reference.mutable && !Analyzer::Typecheck::isMutablePlaceExpr(state, defStore, typeStore, resolvedBodies, module, iterableExprId)) {
          Analyzer::Typecheck::emitForOfMutRequiresMutableIter(state, bindingSpan);
        }

        let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
        if (reference.mutable) {
          return Option::SOME(typeStoreRef.mutableReference(elementType));
        }

        return Option::SOME(typeStoreRef.reference(elementType));
      }

      let annotatedTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::resolveLocalAnnotation(
        defStore,
        typeStore,
        symbols,
        module,
        annotationId,
      );
      let Option::SOME(annotatedType) = annotatedTypeOpt else {
        Analyzer::Typecheck::emitUnsupported(state, bindingSpan, "unsupported local annotation type");
        return Option::NONE;
      };

      if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, bindingSpan, annotatedType, elementType)) {
        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, bindingSpan, elementType, annotatedType);
      }

      if (!Analyzer::Typecheck::isCopyType(state, defStore, typeStore, bindingSpan, elementType)) {
        Analyzer::Typecheck::emitForOfRequiresCopyOrRef(state, typeStore, bindingSpan, elementType);
      }

      return Option::SOME(elementType);
    }

    /// Typecheck a `for..of` statement: iterable first, element extraction,
    /// binding-type resolution, then the body inside the loop scope. Unlike
    /// the Rust checker, the body is still walked when the iterable is not
    /// iterable so its own errors surface; the binding is simply skipped.
    function checkForOfStmt(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      forOfStmt: &Ast::Statement::ForOf,
    ): void {
      Analyzer::Typecheck::pushScope(state);

      let iterableTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        forOfStmt.iterable,
      );

      let iterableSpan: SourceSpan = match (module.expressions.get(forOfStmt.iterable)) {
        Option::SOME(node) -> Ast::Serializer::expressionSpan(node),
        Option::NONE -> forOfStmt.span,
      };

      let mut elementTypeOpt: Option<Analyzer::TypeId> = Option::NONE;
      if (let Option::SOME(iterableType) = iterableTypeOpt) {
        elementTypeOpt = Analyzer::Typecheck::forOfElementType(state, defStore, typeStore, symbols, iterableSpan, iterableType);
      }

      if (let Option::SOME(elementType) = elementTypeOpt) {
        let bindingTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::resolveForOfBindingType(
          state,
          defStore,
          typeStore,
          symbols,
          module,
          resolvedBodies,
          forOfStmt.pattern,
          elementType,
          forOfStmt.iterable,
        );

        if (let Option::SOME(bindingType) = bindingTypeOpt) {
          Analyzer::Typecheck::bindPatternType(state, defStore, typeStore, symbols, resolvedBodies, module, forOfStmt.pattern, bindingType, false, forOfStmt.span);
        }
      }

      Analyzer::Typecheck::enterLoop(state);
      Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, forOfStmt.body);
      Analyzer::Typecheck::exitLoop(state);

      Analyzer::Typecheck::popScope(state);
    }

    /// Typecheck a `defer` statement. The parser wraps the deferred
    /// expression in an `Expression` statement; its type must be `void`
    /// (`never` and failed expressions are exempt), mirroring the Rust
    /// `Defer` arm. Any other wrapped statement form is walked as-is.
    function checkDeferStmt(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      deferStmt: &Ast::Statement::Defer,
    ): void {
      let Option::SOME(innerStmt) = module.statements.get(deferStmt.statement) else {
        return;
      };

      let Ast::Statement::Node::Expression(expressionStmt) = innerStmt else {
        Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, deferStmt.statement);
        return;
      };

      let expressionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
        state,
        defStore,
        typeStore,
        symbols,
        module,
        resolvedBodies,
        expressionStmt.expression,
      );
      let Option::SOME(expressionType) = expressionTypeOpt else {
        return;
      };

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, expressionType);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, deferStmt.span, aliasDefId);
        return;
      }

      let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
        return;
      };

      let mut isExempt: boolean = false;
      match (typeNode) {
        Analyzer::Type::VOID -> {
          isExempt = true;
        },
        Analyzer::Type::NEVER -> {
          isExempt = true;
        },
        _ -> {},
      };

      if (!isExempt) {
        Analyzer::Typecheck::emitDeferExpressionMustBeVoid(state, typeStore, deferStmt.span, expressionType);
      }
    }

    function checkStmt(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      stmtId: Ast::StatementId,
    ): void {
      let Option::SOME(stmt) = module.statements.get(stmtId) else {
        return;
      };

      match (stmt) {
        Ast::Statement::Node::Let(letStmt) -> {
          Analyzer::Typecheck::checkLetLike(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            letStmt.pattern,
            letStmt.annotation,
            letStmt.value,
            false,
            letStmt.span,
          );
        },
        Ast::Statement::Node::Variable(variableStmt) -> {
          Analyzer::Typecheck::checkLetLike(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            variableStmt.pattern,
            variableStmt.annotation,
            variableStmt.value,
            variableStmt.mutable,
            variableStmt.span,
          );
        },
        Ast::Statement::Node::Expression(expressionStmt) -> {
          let Option::SOME(expressionNode) = module.expressions.get(expressionStmt.expression) else {
            return;
          };

          // A statement-position match is checked directly here so its
          // exhaustiveness diagnostic is a WARNING (`valuePosition = false`).
          // Every other statement expression, including a parenthesised
          // `(match ...)` (which arrives as `Node::Grouped`, not
          // `Node::Match`), falls through to the ordinary expression path,
          // where a nested match is always checked at `valuePosition = true`.
          if (let Ast::Expression::Node::Match(matchValue) = expressionNode) {
            let _matchType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkMatchExpr(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              &matchValue,
              Option::NONE,
              false,
            );
          } else {
            let _expressionType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              expressionStmt.expression,
            );
          }
        },
        Ast::Statement::Node::Block(blockStmt) -> {
          let _blockType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkBlockBody(
            state,
            defStore,
            typeStore,
            symbols,
            module,
            resolvedBodies,
            &blockStmt.statements,
            blockStmt.tail,
            Option::NONE,
          );
        },
        Ast::Statement::Node::Return(returnStmt) -> {
          if (let Option::SOME(valueExprId) = returnStmt.value) {
            // The enclosing return type is the expectation for the returned
            // value, mirroring the reference analyzer's `ASTStatement::Return`
            // arm, which checks it under `InferContext::expecting`.
            let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExprExpected(
              state,
              defStore,
              typeStore,
              symbols,
              module,
              resolvedBodies,
              valueExprId,
              Option::SOME(state.currentReturnType),
            );

            if (let Option::SOME(actualType) = actualTypeOpt) {
              if (!Analyzer::Typecheck::valueSatisfiesType(state, defStore, typeStore, returnStmt.span, state.currentReturnType, actualType)) {
                Analyzer::Typecheck::emitTypeMismatch(state, typeStore, returnStmt.span, state.currentReturnType, actualType);
              }
            }
          } else {
            let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
            let voidType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::VOID);
            if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, returnStmt.span, state.currentReturnType, voidType)) {
              Analyzer::Typecheck::emitTypeMismatch(state, typeStore, returnStmt.span, state.currentReturnType, voidType);
            }
          }
        },
        Ast::Statement::Node::Comment(_) -> {},
        Ast::Statement::Node::LetElse(value) -> {
          Analyzer::Typecheck::checkLetElse(state, defStore, typeStore, symbols, module, resolvedBodies, &value);
        },
        Ast::Statement::Node::If(value) -> {
          let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.condition);
          if (let Option::SOME(conditionType) = conditionTypeOpt) {
            Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
          }
          Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, value.thenBranch);
          if (let Option::SOME(elseId) = value.elseBranch) {
            Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, elseId);
          }
        },
        Ast::Statement::Node::While(value) -> {
          let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, value.condition);
          if (let Option::SOME(conditionType) = conditionTypeOpt) {
            Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
          }
          Analyzer::Typecheck::enterLoop(state);
          Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, value.body);
          Analyzer::Typecheck::exitLoop(state);
        },
        Ast::Statement::Node::For(value) -> {
          Analyzer::Typecheck::pushScope(state);

          if (let Option::SOME(initializerId) = value.initializer) {
            Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, initializerId);
          }

          if (let Option::SOME(conditionId) = value.condition) {
            let conditionTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, conditionId);
            if (let Option::SOME(conditionType) = conditionTypeOpt) {
              Analyzer::Typecheck::requireBooleanType(state, defStore, typeStore, value.span, conditionType);
            }
          }

          if (let Option::SOME(updateId) = value.update) {
            let _updateType: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkExpr(state, defStore, typeStore, symbols, module, resolvedBodies, updateId);
          }

          Analyzer::Typecheck::enterLoop(state);
          Analyzer::Typecheck::checkStmt(state, defStore, typeStore, symbols, module, resolvedBodies, value.body);
          Analyzer::Typecheck::exitLoop(state);
          Analyzer::Typecheck::popScope(state);
        },
        Ast::Statement::Node::ForOf(value) -> {
          Analyzer::Typecheck::checkForOfStmt(state, defStore, typeStore, symbols, module, resolvedBodies, &value);
        },
        Ast::Statement::Node::Break(value) -> {
          if (state.loopDepth == 0) {
            Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::CONTROL_FLOW_OUTSIDE_LOOP, "`break` used outside of loop");
            return;
          }

          if (value.value.isSome()) {
            Analyzer::Typecheck::emitUnsupported(state, value.span, "break values");
            return;
          }
        },
        Ast::Statement::Node::Continue(value) -> {
          if (state.loopDepth == 0) {
            Analyzer::Typecheck::emitDiagnostic(state, value.span, DiagnosticCode::CONTROL_FLOW_OUTSIDE_LOOP, "`continue` used outside of loop");
          }
        },
        Ast::Statement::Node::Defer(value) -> {
          Analyzer::Typecheck::checkDeferStmt(state, defStore, typeStore, symbols, module, resolvedBodies, &value);
        },
        Ast::Statement::Node::Item(value) -> {
          Analyzer::Typecheck::emitUnsupported(state, value.span, "nested item statements");
        },
      };
    }
  }
}
