import _ from "./imports";

import
  SourceSpan,
  Diagnostic,
  DiagnosticBag,
  Severity,
  DiagnosticCode,
  LabelKind,
from "@compiler::diagnostics";

import Ast from "@compiler::ast";
import HashMap from "std::collections";

/// Type-syntax resolver for the Ignis selfhost compiler.
///
/// `Resolver::resolveTypes` fills every VOID-sentinel type slot left by the
/// pass-1 and pass-2 binder by walking `Ast::Type::Node` annotations on
/// top-level Definitions and interning the corresponding `Analyzer::Type` via
/// `TypeStore` helpers. Definitions are patched in-place via
/// `DefinitionStore::replace` (ADR-R4).
///
/// Supported items: Record (fields + method signatures), Enum (type params +
/// variant payloads + method signatures), Function
/// (params + return type), Constant (annotation), Trait (method signatures).
/// Method signatures resolve with an owner-local `Self` entry mapped to the
/// owner nominal type (or VOID for traits); see `resolveOwnerMethodSignatures`.
///
/// Supported type nodes: Path (primitives, type params, nominals), Pointer,
/// Reference, Tuple, Slice, FixedArray, Function, Generic.
///
/// All helper functions are defined before their callers (no forward references).
/// `resolveTypeNode` is self-recursive. Generic resolution is inlined into
/// the `Generic(g)` match arm of `resolveTypeNode` to break the mutual-recursion
/// cycle that would otherwise require forward references.
export namespace Analyzer {
  namespace Resolver {
    /// Per-run mutable state threaded through the resolver walk.
    ///
    /// Per ADR-4: stores hold &mut borrow-style state via explicit parameter
    /// threading because Ignis borrow checker rejects &mut fields inside records.
    ///
    /// `globalNameIndex` / `importNameIndex` map interned name symbols (keyed
    /// by `SymbolId.raw()`) to every `DefinitionId` of that name, in the order
    /// they were indexed. `globalNameIndex` covers Records, Enums, TypeAliases,
    /// and Traits; `importNameIndex` covers the direct-import overlay. A bare
    /// lookup takes the candidate the current namespace chain reaches, the
    /// innermost first, and the first one indexed among equals.
    record ResolverState {
      public diagnostics: DiagnosticBag;
      public globalNameIndex: HashMap<u32, Vector<Analyzer::DefinitionId>>;
      public importNameIndex: HashMap<u32, Vector<Analyzer::DefinitionId>>;
      /// Parallel to the buckets of `globalNameIndex` and `importNameIndex`:
      /// the path each candidate is published or imported under, which
      /// decides whether a bare name reaches it from the current namespace.
      public globalNamePaths: HashMap<u32, Vector<String>>;
      public importNamePaths: HashMap<u32, Vector<String>>;
      /// Program-wide qualified declarations (host NamespaceStore mirror).
      public programSyms: Vector<Analyzer::SymbolId>;
      public programDefs: Vector<Analyzer::DefinitionId>;
      public programQualifiedNames: Vector<String>;
      /// Namespaces entered by the item walk, outermost first. A bare type
      /// name is read against this chain before the flat index answers, so
      /// two namespaces may each declare a `Point` and keep them apart.
      public namespaceChain: Vector<String>;
      /// `@sendable` parameters waiting for their type to be judged, with the
      /// span and name of each. They are judged once every alias in the
      /// module is resolved, since a parameter may name an alias declared
      /// after it.
      public sendableParams: Vector<Analyzer::DefinitionId>;
      public sendableSpans: Vector<SourceSpan>;
      public sendableNames: Vector<String>;
      /// Every type alias the module declares, with the item that declares
      /// it, the namespace chain around it and how far its body got: 0
      /// pending, 1 resolving, 2 resolved. An instance of a generic alias
      /// resolves the alias body where it is written, so it expands whatever
      /// order the declarations come in.
      public aliasDefs: Vector<Analyzer::DefinitionId>;
      public aliasItems: Vector<Ast::ItemId>;
      public aliasChains: Vector<Vector<String>>;
      public aliasStatuses: Vector<u8>;
      /// The names of every module whose trait defaults this module holds
      /// copies of, and the one the copy being resolved reads, as index + 1;
      /// 0 while no copy of another module's default is.
      public foreignNames: Vector<Analyzer::Resolver::ForeignNames>;
      public activeForeign: u64;
    }

    /// The bare-name tables of another module, laid out as `ResolverState`
    /// holds its own. A copy of a trait default that module declares reads its
    /// names through them, with the same reach rules.
    record ForeignNames {
      public modulePath: String;
      public globalNameIndex: HashMap<u32, Vector<Analyzer::DefinitionId>>;
      public globalNamePaths: HashMap<u32, Vector<String>>;
      public importNameIndex: HashMap<u32, Vector<Analyzer::DefinitionId>>;
      public importNamePaths: HashMap<u32, Vector<String>>;
    }

    /// Type-parameter scope for one item walk (Record, Enum, or Function).
    ///
    /// Parallel vectors per binder ADR-1 (HashMap on SymbolId unavailable).
    /// `syms[i]` is the interned name of the i-th type parameter;
    /// `typeIds[i]` is the corresponding `Type::Param(sym)` interned in TypeStore.
    /// Lookup is innermost-first (linear scan). Scope is discarded on item exit.
    record TypeParamScope {
      public syms: Vector<Analyzer::SymbolId>;
      public typeIds: Vector<Analyzer::TypeId>;
    }

    /// Output produced by `resolveTypes`.
    ///
    /// `diagnostics` carries all resolver-emitted errors. Callers merge with
    /// binder diagnostics as needed — resolver does not re-emit binder errors.
    record ResolverOutput {
      public diagnostics: DiagnosticBag;
    }

    // =========================================================================
    // Leaf helpers — no calls to other resolver functions.
    // =========================================================================

    /// Emit an ERROR diagnostic with the class-specific `code` for the
    /// resolver failure being reported (ADR-R2: Diagnostic Code Catalog).
    /// Like `emitUndefinedType`, but with a label that says more than the
    /// message. The reference compiler's message is fixed for conditions the
    /// selfhost can describe more precisely; the message stays identical so a
    /// host-written baseline matches, and the detail moves to the label.
    function emitTypeDiagnosticLabeled(
      state: &mut Analyzer::Resolver::ResolverState,
      span: SourceSpan,
      code: str,
      message: str,
      label: str,
    ): void {
      let mut diag: Diagnostic = Diagnostic::new(
        Severity::ERROR,
        code,
        message,
        span,
      );
      diag.addLabel(LabelKind::PRIMARY, span, label);
      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      stateRef.diagnostics.push(diag);
    }

    function emitUndefinedType(
      state: &mut Analyzer::Resolver::ResolverState,
      span: SourceSpan,
      code: str,
      message: str,
    ): void {
      let mut diag: Diagnostic = Diagnostic::new(
        Severity::ERROR,
        code,
        message,
        span,
      );
      diag.addLabel(LabelKind::PRIMARY, span, message);
      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      stateRef.diagnostics.push(diag);
    }

    /// Linear scan of `scope.syms` for a matching symbol.
    /// Returns the index (for `scope.typeIds.get(idx)`) on match, NONE otherwise.
    function scopeLookup(
      scope: &Analyzer::Resolver::TypeParamScope,
      sym: Analyzer::SymbolId,
    ): Option<u64> {
      let mut index: u64 = 0;

      while (index < scope.syms.length()) {
        let Option::SOME(stored) = scope.syms.get(index) else {
          index += 1;
          continue;
        };

        if (stored.raw() == sym.raw()) {
          return Option::SOME(index);
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// The namespace part of a written path: everything before its last `::`,
    /// or the empty string for a bare name.
    function namespaceOfPath(path: &String): String {
      let mut separator: u64 = 0;
      let mut found: boolean = false;
      let mut index: u64 = 0;

      while (index + 1 < path.length()) {
        let mut first: u8 = 0;
        let mut second: u8 = 0;

        if (let Option::SOME(byte) = path.byteAt(index)) {
          first = byte;
        }
        if (let Option::SOME(byte) = path.byteAt(index + 1)) {
          second = byte;
        }

        if (first == 58 && second == 58) {
          separator = index;
          found = true;
        }

        index += 1;
      }

      if (!found) {
        return String::create("");
      }

      return path.substringBytes(0, separator);
    }

    /// How deep in `chain` a declaration published as `path` is reachable by
    /// its bare name: 0 for a top-level declaration, the depth of its
    /// namespace when `chain` is inside that namespace, NONE when it is
    /// declared in a namespace or extern block the chain is not inside.
    function bareNameReach(path: &String, chain: &Vector<String>): Option<u64> {
      let declaredIn: String = Analyzer::Resolver::namespaceOfPath(path);

      if (declaredIn.length() == 0) {
        return Option::SOME(0);
      }

      let mut enclosing: String = String::create("");
      let mut depth: u64 = 0;

      while (depth < chain.length()) {
        if (let Option::SOME(segment) = chain.get(depth)) {
          if (depth > 0) {
            enclosing.pushStr("::");
          }
          enclosing.pushStr(segment.toStr());
        }

        depth += 1;

        if (enclosing.equals(declaredIn.toStr())) {
          return Option::SOME(depth);
        }
      }

      return Option::NONE;
    }

    /// What declares `defId`, as a diagnostic names it: an extern block for a
    /// declaration made inside one, a namespace otherwise.
    function declaringContainer(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId
    ): str {
      let Option::SOME(definition) = defStore.get(defId) else {
        return "namespace";
      };

      let inExtern: boolean = match (definition) {
        Analyzer::Definition::Function(function_) -> function_.isExtern,
        Analyzer::Definition::Variable(variable) -> variable.isExtern,
        Analyzer::Definition::Record(record_) -> record_.isExtern,
        _ -> false,
      };

      return inExtern ? "extern block" : "namespace";
    }

    /// The error for a bare name, or the leading segment of a path, that names
    /// a declaration of a namespace or extern block the use is not inside.
    ///
    /// `written` is what the use wrote; the suggestion prefixes it with the
    /// namespace the leading segment is declared in.
    function namespaceMemberDiagnostic(
      span: SourceSpan,
      leadingName: str,
      publishedPath: &String,
      container: str,
      written: str,
    ): Diagnostic {
      let declaredIn: String = Analyzer::Resolver::namespaceOfPath(publishedPath);
      let message: String = `'${leadingName}' is declared in ${container} '${declaredIn.toStr()}'; write '${declaredIn.toStr()}::${written}'`;
      let mut diag: Diagnostic = Diagnostic::new(
        Severity::ERROR,
        DiagnosticCode::NAMESPACE_MEMBER_REQUIRES_PATH,
        message.toStr(),
        span,
      );
      diag.addLabel(LabelKind::PRIMARY, span, "outside its namespace, a member is reached only by its path");
      return diag;
    }

    /// A declaration a bare name finds, and whether the namespaces the walk
    /// is in reach it by that name.
    record BareCandidate {
      public defId: Analyzer::DefinitionId;
      public reachable: boolean;
      public path: String;
    }

    /// The candidate of `defs` (published under `paths`) a bare name written
    /// inside `chain` names: the reachable one declared deepest, the first
    /// indexed among equals. When none is reachable, the first candidate comes
    /// back marked unreachable, so the caller can report it and keep going.
    function pickBareCandidate(
      defs: Option<&Vector<Analyzer::DefinitionId>>,
      paths: Option<&Vector<String>>,
      chain: &Vector<String>,
    ): Option<Analyzer::Resolver::BareCandidate> {
      let Option::SOME(candidates) = defs else {
        return Option::NONE;
      };

      let empty: Vector<String> = Vector::new<String>();
      let mut candidatePaths: &Vector<String> = &empty;
      if (let Option::SOME(stored) = paths) {
        candidatePaths = stored;
      }

      let mut bestIndex: u64 = 0;
      let mut bestDepth: u64 = 0;
      let mut bestFound: boolean = false;
      let mut index: u64 = 0;

      while (index < candidates.length()) {
        let mut path: String = String::create("");
        if (let Option::SOME(stored) = candidatePaths.get(index)) {
          path = stored.clone();
        }

        if (let Option::SOME(depth) = Analyzer::Resolver::bareNameReach(&path, chain)) {
          if (!bestFound || depth > bestDepth) {
            bestIndex = index;
            bestDepth = depth;
            bestFound = true;
          }
        }

        index += 1;
      }

      let Option::SOME(defId) = candidates.get(bestIndex) else {
        return Option::NONE;
      };

      let mut path: String = String::create("");
      if (let Option::SOME(stored) = candidatePaths.get(bestIndex)) {
        path = stored.clone();
      }

      return Option::SOME(Analyzer::Resolver::BareCandidate { defId: *defId, reachable: bestFound, path: path });
    }

    function globalCandidate(
      state: &mut Analyzer::Resolver::ResolverState,
      sym: Analyzer::SymbolId,
    ): Option<Analyzer::Resolver::BareCandidate> {
      let key: u32 = sym.raw();

      if (state.activeForeign > 0) {
        let Option::SOME(foreign) = state.foreignNames.get(state.activeForeign - 1) else {
          return Option::NONE;
        };

        return Analyzer::Resolver::pickBareCandidate(foreign.globalNameIndex.get(&key), foreign.globalNamePaths.get(&key), &state.namespaceChain);
      }

      return Analyzer::Resolver::pickBareCandidate(state.globalNameIndex.get(&key), state.globalNamePaths.get(&key), &state.namespaceChain);
    }

    function importCandidate(
      state: &mut Analyzer::Resolver::ResolverState,
      sym: Analyzer::SymbolId,
    ): Option<Analyzer::Resolver::BareCandidate> {
      let key: u32 = sym.raw();

      if (state.activeForeign > 0) {
        let Option::SOME(foreign) = state.foreignNames.get(state.activeForeign - 1) else {
          return Option::NONE;
        };

        return Analyzer::Resolver::pickBareCandidate(foreign.importNameIndex.get(&key), foreign.importNamePaths.get(&key), &state.namespaceChain);
      }

      return Analyzer::Resolver::pickBareCandidate(state.importNameIndex.get(&key), state.importNamePaths.get(&key), &state.namespaceChain);
    }

    /// The declaration `sym` names in `state.globalNameIndex`, preferring one
    /// the current namespace chain reaches.
    ///
    /// Takes `&mut` per binder ADR-4 pattern (no auto-coercion of &mut to &).
    function globalLookup(
      state: &mut Analyzer::Resolver::ResolverState,
      sym: Analyzer::SymbolId,
    ): Option<Analyzer::DefinitionId> {
      return match (Analyzer::Resolver::globalCandidate(state, sym)) {
        Option::SOME(candidate) -> Option::SOME(candidate.defId),
        Option::NONE -> Option::NONE,
      };
    }

    function candidateReachable(candidate: &Option<Analyzer::Resolver::BareCandidate>): boolean {
      if (let Option::SOME(found) = candidate) {
        return found.reachable;
      }

      return false;
    }

    /// The declaration a bare type name finds: one the current namespace
    /// chain reaches, declared here before imported, and only past those a
    /// declaration it does not reach, which the caller reports.
    function bareCandidate(
      state: &mut Analyzer::Resolver::ResolverState,
      sym: Analyzer::SymbolId,
    ): Option<Analyzer::Resolver::BareCandidate> {
      let globalOpt: Option<Analyzer::Resolver::BareCandidate> = Analyzer::Resolver::globalCandidate(state, sym);
      let importOpt: Option<Analyzer::Resolver::BareCandidate> = Analyzer::Resolver::importCandidate(state, sym);

      if (Analyzer::Resolver::candidateReachable(&globalOpt)) {
        return globalOpt;
      }

      if (Analyzer::Resolver::candidateReachable(&importOpt)) {
        return importOpt;
      }

      if (globalOpt.isSome()) {
        return globalOpt;
      }

      return importOpt;
    }

    /// Report `candidate` when the bare name `name` reached it only by
    /// ignoring the namespace it is declared in.
    function reportUnreachableCandidate(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      candidate: &Analyzer::Resolver::BareCandidate,
      name: str,
      written: str,
      span: SourceSpan,
    ): void {
      if (candidate.reachable) {
        return;
      }

      let container: str = Analyzer::Resolver::declaringContainer(defStore, candidate.defId);
      let diag: Diagnostic = Analyzer::Resolver::namespaceMemberDiagnostic(span, name, &candidate.path, container, written);
      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      stateRef.diagnostics.push(diag);
    }

    /// Whether a program-index entry named `sym` is reachable by its bare
    /// name from inside `chain`.
    function programNameReachable(
      syms: &Vector<Analyzer::SymbolId>,
      paths: &Vector<String>,
      sym: Analyzer::SymbolId,
      chain: &Vector<String>,
    ): boolean {
      let mut index: u64 = 0;

      while (index < syms.length()) {
        if (let Option::SOME(candidateSym) = syms.get(index)) {
          if (candidateSym.raw() == sym.raw()) {
            if (let Option::SOME(path) = paths.get(index)) {
              if (Analyzer::Resolver::bareNameReach(path, chain).isSome()) {
                return true;
              }
            }
          }
        }

        index += 1;
      }

      return false;
    }

    /// The position of the first program-index entry named `sym`.
    function programFirstEntry(
      syms: &Vector<Analyzer::SymbolId>,
      sym: Analyzer::SymbolId
    ): Option<u64> {
      let mut index: u64 = 0;

      while (index < syms.length()) {
        if (let Option::SOME(candidateSym) = syms.get(index)) {
          if (candidateSym.raw() == sym.raw()) {
            return Option::SOME(index);
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// The segments of a written path joined with `::`.
    function joinSegments(segments: &Vector<String>): String {
      let mut written: String = String::create("");
      let mut index: u64 = 0;

      while (index < segments.length()) {
        if (let Option::SOME(segment) = segments.get(index)) {
          if (index > 0) {
            written.pushStr("::");
          }
          written.pushStr(segment.toStr());
        }
        index += 1;
      }

      return written;
    }

    /// Report a qualified path whose leading segment names a namespace member
    /// the current namespace chain does not reach: `Inner::Point` written
    /// outside `Outer` has to be `Outer::Inner::Point`.
    function reportUnreachableLeadingSegment(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      segments: &Vector<String>,
      span: SourceSpan,
    ): void {
      let Option::SOME(leading) = segments.get(0) else {
        return;
      };

      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let sym: Analyzer::SymbolId = symbolsRef.intern(leading.toStr());
      let bareOpt: Option<Analyzer::Resolver::BareCandidate> = Analyzer::Resolver::bareCandidate(state, sym);

      if (Analyzer::Resolver::candidateReachable(&bareOpt)) {
        return;
      }

      if (Analyzer::Resolver::programNameReachable(&state.programSyms, &state.programQualifiedNames, sym, &state.namespaceChain)) {
        return;
      }

      let mut path: String = String::create("");
      let mut defId: Option<Analyzer::DefinitionId> = Option::NONE;

      if (let Option::SOME(candidate) = bareOpt) {
        path = candidate.path.clone();
        defId = Option::SOME(candidate.defId);
      } else if (let Option::SOME(entry) = Analyzer::Resolver::programFirstEntry(&state.programSyms, sym)) {
        if (let Option::SOME(stored) = state.programQualifiedNames.get(entry)) {
          path = stored.clone();
        }
        if (let Option::SOME(stored) = state.programDefs.get(entry)) {
          defId = Option::SOME(*stored);
        }
      }

      let Option::SOME(declared) = defId else {
        return;
      };

      let container: str = Analyzer::Resolver::declaringContainer(defStore, declared);
      let written: String = Analyzer::Resolver::joinSegments(segments);
      let diag: Diagnostic = Analyzer::Resolver::namespaceMemberDiagnostic(span, leading.toStr(), &path, container, written.toStr());
      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      stateRef.diagnostics.push(diag);
    }

    /// Map a primitive type name string to its pre-interned `TypeId`.
    ///
    /// Returns NONE for non-primitive names. All 15 primitive names are handled
    /// with `String::create(name).equals("prim")` comparisons — `str == str`
    /// is not supported in Ignis selfhost. TypeStore does not grow.
    ///
    /// A `mut` local alias is required per Ignis borrow conventions (ADR-4)
    /// to call `&mut self` methods on the `typeStore` parameter.
    function primitiveForName(
      typeStore: &mut Analyzer::TypeStore,
      name: str,
    ): Option<Analyzer::TypeId> {
      let nameStr: String = String::create(name);
      let mut tsRef: &mut Analyzer::TypeStore = typeStore;

      if (nameStr.equals("i8")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::I8));
      }
      if (nameStr.equals("i16")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::I16));
      }
      if (nameStr.equals("i32")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::I32));
      }
      if (nameStr.equals("i64")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::I64));
      }
      if (nameStr.equals("u8")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::U8));
      }
      if (nameStr.equals("u16")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::U16));
      }
      if (nameStr.equals("u32")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::U32));
      }
      if (nameStr.equals("u64")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::U64));
      }
      if (nameStr.equals("f32")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::F32));
      }
      if (nameStr.equals("f64")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::F64));
      }
      if (nameStr.equals("boolean")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::BOOLEAN));
      }
      if (nameStr.equals("char")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::CHAR));
      }
      if (nameStr.equals("str")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::STR));
      }
      if (nameStr.equals("static str")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::STATIC_STR));
      }
      if (nameStr.equals("void")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::VOID));
      }
      if (nameStr.equals("never")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::NEVER));
      }
      if (nameStr.equals("atom")) {
        return Option::SOME(tsRef.intern(Analyzer::Type::ATOM));
      }

      return Option::NONE;
    }

    /// Extract the annotation TypeId from a Pattern::Binding node.
    /// Returns NONE for all other pattern kinds or if the pattern is absent.
    function patternAnnotation(module: &Ast::Module, patId: Ast::PatternId): Option<Ast::TypeId> {
      let Option::SOME(pat) = module.patterns.get(patId) else {
        return Option::NONE;
      };

      match (pat) {
        Ast::Pattern::Node::Binding(b) -> {
          return b.annotation;
        },
        Ast::Pattern::Node::Wildcard(_) -> {
          return Option::NONE;
        },
        Ast::Pattern::Node::Path(_) -> {
          return Option::NONE;
        },
        Ast::Pattern::Node::Literal(_) -> {
          return Option::NONE;
        },
        Ast::Pattern::Node::Tuple(_) -> {
          return Option::NONE;
        },
        Ast::Pattern::Node::Or(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: patternAnnotation match did not return");
    }

    /// Look up the DefinitionId for a given raw ItemId, searching pass-1 then pass-2.
    function lookupDef(
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      rawId: u32,
    ): Option<Analyzer::DefinitionId> {
      let pass1Result: Option<Analyzer::DefinitionId> = Analyzer::Binder::findDef(pass1, rawId);

      if (pass1Result.isSome()) {
        return pass1Result;
      }

      return Analyzer::Binder::findDef(pass2, rawId);
    }

    /// Return true if `defId` resolves to a `Definition::Trait` in `defStore`.
    function isTraitDef(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): boolean {
      let Option::SOME(def) = defStore.get(defId) else {
        return false;
      };

      match (def) {
        Analyzer::Definition::Trait(_) -> {
          return true;
        },
        Analyzer::Definition::Record(_) -> {
          return false;
        },
        Analyzer::Definition::Enum(_) -> {
          return false;
        },
        Analyzer::Definition::Function(_) -> {
          return false;
        },
        Analyzer::Definition::Variable(_) -> {
          return false;
        },
        Analyzer::Definition::Field(_) -> {
          return false;
        },
        Analyzer::Definition::Variant(_) -> {
          return false;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return false;
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return false;
        },
        Analyzer::Definition::Method(_) -> {
          return false;
        },
      };

      @panic("unreachable: isTraitDef match did not return");
    }

    function isTypeNameDef(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): boolean {
      let Option::SOME(def) = defStore.get(defId) else {
        return false;
      };

      match (def) {
        Analyzer::Definition::Record(_) -> {
          return true;
        },
        Analyzer::Definition::Enum(_) -> {
          return true;
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return true;
        },
        Analyzer::Definition::Trait(_) -> {
          return true;
        },
        Analyzer::Definition::Function(_) -> {
          return false;
        },
        Analyzer::Definition::Variable(_) -> {
          return false;
        },
        Analyzer::Definition::Field(_) -> {
          return false;
        },
        Analyzer::Definition::Variant(_) -> {
          return false;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return false;
        },
        Analyzer::Definition::Method(_) -> {
          return false;
        },
      };

      @panic("unreachable: isTypeNameDef match did not return");
    }

    /// Map a `DefinitionId` known to be a Record or Enum to the corresponding
    /// `Type::Record(defId)` or `Type::Enum(defId)` interned in TypeStore.
    function nominalTypeFor(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      defId: Analyzer::DefinitionId,
    ): Analyzer::TypeId {
      let Option::SOME(def) = defStore.get(defId) else {
        @panic("nominalTypeFor: defId not in store — invariant broken");
      };

      match (def) {
        Analyzer::Definition::Record(_) -> {
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.recordType(defId);
        },
        Analyzer::Definition::Enum(_) -> {
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.enumType(defId);
        },
        Analyzer::Definition::Function(_) -> {
          @panic("nominalTypeFor: Function in global index — invariant broken");
        },
        Analyzer::Definition::Variable(_) -> {
          @panic("nominalTypeFor: Variable in global index — invariant broken");
        },
        Analyzer::Definition::Field(_) -> {
          @panic("nominalTypeFor: Field in global index — invariant broken");
        },
        Analyzer::Definition::Variant(_) -> {
          @panic("nominalTypeFor: Variant in global index — invariant broken");
        },
        Analyzer::Definition::TypeParam(_) -> {
          @panic("nominalTypeFor: TypeParam in global index — invariant broken");
        },
        Analyzer::Definition::TypeAlias(_) -> {
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.aliasType(defId);
        },
        Analyzer::Definition::Trait(_) -> {
          // Trait used in type position: return VOID; caller emits the diagnostic.
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.intern(Analyzer::Type::VOID);
        },
        Analyzer::Definition::Method(_) -> {
          @panic("nominalTypeFor: Method in global index — invariant broken");
        },
      };

      @panic("unreachable: nominalTypeFor match did not return");
    }

    /// Return the type-parameter arity of a definition.
    function arityOf(defStore: &mut Analyzer::DefinitionStore, defId: Analyzer::DefinitionId): u64 {
      let Option::SOME(def) = defStore.get(defId) else {
        return 0;
      };

      match (def) {
        Analyzer::Definition::Record(rec) -> {
          return rec.typeParams.length();
        },
        Analyzer::Definition::Enum(en) -> {
          return en.typeParams.length();
        },
        Analyzer::Definition::Function(_) -> {
          return 0;
        },
        Analyzer::Definition::Variable(_) -> {
          return 0;
        },
        Analyzer::Definition::Field(_) -> {
          return 0;
        },
        Analyzer::Definition::Variant(_) -> {
          return 0;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return 0;
        },
        Analyzer::Definition::TypeAlias(alias) -> {
          return alias.typeParams.length();
        },
        Analyzer::Definition::Trait(trait_) -> {
          return trait_.typeParams.length();
        },
        Analyzer::Definition::Method(_) -> {
          return 0;
        },
      };

      @panic("unreachable: arityOf match did not return");
    }

    /// Return the Path node at `typeId` as an owned `Option<Path>`, deep-copying
    /// the segments Vector so the caller owns its own backing storage.
    ///
    /// Used by the Generic arm to validate that the base is a single-segment Path
    /// and to recover its name + span.
    function extractBasePath(module: &Ast::Module, typeId: Ast::TypeId): Option<Ast::Type::Path> {
      let Option::SOME(node) = module.types.get(typeId) else {
        return Option::NONE;
      };

      match (node) {
        Ast::Type::Node::Path(p) -> {
          let mut newSegs: Vector<String> = Vector::new<String>();
          let mut i: u64 = 0;
          while (i < p.segments.length()) {
            let Option::SOME(s) = p.segments.get(i) else {
              i += 1;
              continue;
            };
            newSegs.push(s.clone());
            i += 1;
          }
          let newPath: Ast::Type::Path = Ast::Type::Path { span: p.span, segments: newSegs };
          return Option::SOME(newPath);
        },
        Ast::Type::Node::Pointer(_) -> { return Option::NONE; },
        Ast::Type::Node::Reference(_) -> { return Option::NONE; },
        Ast::Type::Node::Tuple(_) -> { return Option::NONE; },
        Ast::Type::Node::Slice(_) -> { return Option::NONE; },
        Ast::Type::Node::FixedArray(_) -> { return Option::NONE; },
        Ast::Type::Node::Function(_) -> { return Option::NONE; },
        Ast::Type::Node::Generic(_) -> { return Option::NONE; },
      };

      @panic("unreachable: extractBasePath match did not return");
    }

    /// Build a `TypeParamScope` for one item's generic parameters.
    function buildTypeParamScope(
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      genericParams: &Vector<Ast::GenericParam>,
    ): Analyzer::Resolver::TypeParamScope {
      let mut syms: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();
      let mut typeIds: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < genericParams.length()) {
        let Option::SOME(param) = genericParams.get(index) else {
          index += 1;
          continue;
        };

        let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
        let sym: Analyzer::SymbolId = symbolsRef.intern(param.name.toStr());

        let mut tsRef: &mut Analyzer::TypeStore = typeStore;
        let typeId: Analyzer::TypeId = tsRef.param(sym);

        syms.push(sym);
        typeIds.push(typeId);
        index += 1;
      }

      return Analyzer::Resolver::TypeParamScope { syms: syms, typeIds: typeIds };
    }

    function copyChain(chain: &Vector<String>): Vector<String> {
      let mut copy: Vector<String> = Vector::new<String>();
      let mut index: u64 = 0;
      while (index < chain.length()) {
        if (let Option::SOME(segment) = chain.get(index)) {
          copy.push(segment.clone());
        }
        index += 1;
      }
      return copy;
    }

    // =========================================================================
    // Patch helpers — mutate DefinitionStore in-place (ADR-R4).
    // =========================================================================

    /// Patch `FieldDef.fieldType` at `fieldDefId` via `DefinitionStore::replace`.
    function patchFieldType(
      defStore: &mut Analyzer::DefinitionStore,
      fieldDefId: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
    ): void {
      let Option::SOME(existing) = defStore.get(fieldDefId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::Field(f) -> {
          let updated: Analyzer::FieldDef = Analyzer::FieldDef {
            name: f.name,
            fieldType: typeId,
            owner: f.owner,
            index: f.index,
            alignment: f.alignment,
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(fieldDefId, Analyzer::Definition::Field(updated));
        },
        Analyzer::Definition::Record(_) -> {},
        Analyzer::Definition::Enum(_) -> {},
        Analyzer::Definition::Function(_) -> {},
        Analyzer::Definition::Variable(_) -> {},
        Analyzer::Definition::Variant(_) -> {},
        Analyzer::Definition::TypeParam(_) -> {},
        Analyzer::Definition::TypeAlias(_) -> {},
        Analyzer::Definition::Trait(_) -> {},
        Analyzer::Definition::Method(_) -> {},
      };
    }

    /// Patch `VariantDef.payload` at `variantDefId` via `DefinitionStore::replace`.
    ///
    /// The binder allocates one VOID placeholder per declared payload slot; this
    /// replaces the whole vector with the resolved slot types, keeping arity.
    function patchVariantPayload(
      defStore: &mut Analyzer::DefinitionStore,
      variantDefId: Analyzer::DefinitionId,
      payload: &Vector<Analyzer::TypeId>,
    ): void {
      let Option::SOME(existing) = defStore.get(variantDefId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::Variant(v) -> {
          let updated: Analyzer::VariantDef = Analyzer::VariantDef {
            name: v.name,
            payload: Analyzer::Resolver::copyTypeIdVector(payload),
            owner: v.owner,
            tagValue: v.tagValue,
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(variantDefId, Analyzer::Definition::Variant(updated));
        },
        Analyzer::Definition::Record(_) -> {},
        Analyzer::Definition::Enum(_) -> {},
        Analyzer::Definition::Function(_) -> {},
        Analyzer::Definition::Variable(_) -> {},
        Analyzer::Definition::Field(_) -> {},
        Analyzer::Definition::TypeParam(_) -> {},
        Analyzer::Definition::TypeAlias(_) -> {},
        Analyzer::Definition::Trait(_) -> {},
        Analyzer::Definition::Method(_) -> {},
      };
    }

    /// Queues a `@sendable` parameter for `checkSendableParameters`.
    function checkSendableParameter(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      module: &Ast::Module,
      paramDefId: Analyzer::DefinitionId,
      paramPatId: Ast::PatternId,
    ): void {
      if (!defStore.isSendable(paramDefId)) {
        return;
      }

      let Option::SOME(Ast::Pattern::Node::Binding(binding)) = module.patterns.get(paramPatId) else {
        return;
      };

      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      stateRef.sendableParams.push(paramDefId);
      stateRef.sendableSpans.push(binding.span);
      stateRef.sendableNames.push(binding.name.clone());
    }

    /// Rejects `@sendable` on a parameter whose declared type, with aliases
    /// followed, is not a function type: the attribute judges what a closure
    /// captures, and only a function value can carry captures. A cyclic alias
    /// is reported where it is declared and is not judged here.
    function checkSendableParameters(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
    ): void {
      let mut index: u64 = 0;

      while (index < state.sendableParams.length()) {
        let Option::SOME(paramDefId) = state.sendableParams.get(index) else {
          index += 1;
          continue;
        };
        let mut declaredType: Option<Analyzer::TypeId> = Option::NONE;

        if (let Option::SOME(Analyzer::Definition::Variable(variable)) = defStore.get(*paramDefId)) {
          declaredType = Option::SOME(variable.declaredType);
        }

        let Option::SOME(typeId) = declaredType else {
          index += 1;
          continue;
        };

        let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
        let mut accepted: boolean = resolved.cycleAlias.isSome();

        match (typeStore.get(resolved.typeId)) {
          Option::SOME(Analyzer::Type::Function(_)) | Option::NONE -> {
            accepted = true;
          },
          _ -> {},
        };

        if (!accepted) {
          let Option::SOME(span) = state.sendableSpans.get(index) else {
            index += 1;
            continue;
          };
          let Option::SOME(name) = state.sendableNames.get(index) else {
            index += 1;
            continue;
          };
          let message: String = `\`@sendable\` on parameter '${name.toStr()}', whose type is not a function type`;
          emitTypeDiagnosticLabeled(
            state,
            *span,
            DiagnosticCode::SENDABLE_PARAMETER_NOT_FUNCTION,
            message.toStr(),
            "`@sendable` only applies to a parameter of function type",
          );
        }

        index += 1;
      }
    }

    /// Patch `VariableDef.declaredType` at `varDefId` via `DefinitionStore::replace`.
    function patchVariableType(
      defStore: &mut Analyzer::DefinitionStore,
      varDefId: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
    ): void {
      let Option::SOME(existing) = defStore.get(varDefId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::Variable(v) -> {
          let updated: Analyzer::VariableDef = Analyzer::VariableDef {
            name: v.name,
            visibility: v.visibility,
            declaredType: typeId,
            mutable: v.mutable,
            takes: v.takes,
            noEscape: v.noEscape,
            isExtern: v.isExtern,
            alignment: v.alignment,
            threadLocal: v.threadLocal,
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(varDefId, Analyzer::Definition::Variable(updated));
        },
        Analyzer::Definition::Record(_) -> {},
        Analyzer::Definition::Enum(_) -> {},
        Analyzer::Definition::Function(_) -> {},
        Analyzer::Definition::Field(_) -> {},
        Analyzer::Definition::Variant(_) -> {},
        Analyzer::Definition::TypeParam(_) -> {},
        Analyzer::Definition::TypeAlias(_) -> {},
        Analyzer::Definition::Trait(_) -> {},
        Analyzer::Definition::Method(_) -> {},
      };
    }

    /// Copies a `Vector<DefinitionId>` element-by-element. `Vector` has no
    /// `clone()`, and matching a `&Definition` binds its payload by reference,
    /// so rebuilding a definition for `DefinitionStore::replace` must copy the
    /// id vectors out instead of moving them from the borrowed entry (mirrors
    /// `Analyzer::Typecheck::copyDefinitionIdVector`).
    function copyDefinitionIdVector(
      source: &Vector<Analyzer::DefinitionId>
    ): Vector<Analyzer::DefinitionId> {
      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        let Option::SOME(defId) = source.get(index) else {
          index += 1;
          continue;
        };

        out.push(*defId);
        index += 1;
      }

      return out;
    }

    /// Copies a `Vector<String>`, cloning each element.
    function copyStringVector(source: &Vector<String>): Vector<String> {
      let mut out: Vector<String> = Vector::new<String>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        if (let Option::SOME(entry) = source.get(index)) {
          out.push(entry.clone());
        }

        index += 1;
      }

      return out;
    }

    /// Copies a `Vector<TypeId>` element-by-element, for the same reason
    /// `copyDefinitionIdVector` exists.
    function copyTypeIdVector(source: &Vector<Analyzer::TypeId>): Vector<Analyzer::TypeId> {
      let mut out: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        let Option::SOME(typeId) = source.get(index) else {
          index += 1;
          continue;
        };

        out.push(*typeId);
        index += 1;
      }

      return out;
    }

    /// Copies an optional deprecation message out of a borrowed definition so
    /// the rebuilt definition for `DefinitionStore::replace` does not move
    /// from the borrowed entry (same rationale as `copyDefinitionIdVector`).
    function copyOptionalMessage(source: &Option<String>): Option<String> {
      return match (source) {
        Option::SOME(message) -> Option::SOME(message.clone()),
        Option::NONE -> Option::NONE,
      };
    }

    /// Copies an optional resolved type out of a borrowed definition, for the
    /// same reason `copyOptionalMessage` exists.
    function copyOptionalTypeId(source: &Option<Analyzer::TypeId>): Option<Analyzer::TypeId> {
      return match (source) {
        Option::SOME(typeId) -> Option::SOME(typeId),
        Option::NONE -> Option::NONE,
      };
    }

    /// Patch `FunctionDef.returnType` at `fnDefId` via `DefinitionStore::replace`.
    function patchReturnType(
      defStore: &mut Analyzer::DefinitionStore,
      fnDefId: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
    ): void {
      let Option::SOME(existing) = defStore.get(fnDefId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::Function(fn_) -> {
          let updated: Analyzer::FunctionDef = Analyzer::FunctionDef {
            name: fn_.name,
            visibility: fn_.visibility,
            typeParams: Analyzer::Resolver::copyDefinitionIdVector(&fn_.typeParams),
            params: Analyzer::Resolver::copyDefinitionIdVector(&fn_.params),
            returnType: typeId,
            isDeprecated: fn_.isDeprecated,
            deprecatedMessage: Analyzer::Resolver::copyOptionalMessage(&fn_.deprecatedMessage),
            extensionTarget: Analyzer::Resolver::copyOptionalTypeId(&fn_.extensionTarget),
            extensionMutable: fn_.extensionMutable,
            isExtern: fn_.isExtern,
            externName: Analyzer::Resolver::copyOptionalMessage(&fn_.externName),
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(fnDefId, Analyzer::Definition::Function(updated));
        },
        Analyzer::Definition::Record(_) -> {},
        Analyzer::Definition::Enum(_) -> {},
        Analyzer::Definition::Variable(_) -> {},
        Analyzer::Definition::Field(_) -> {},
        Analyzer::Definition::Variant(_) -> {},
        Analyzer::Definition::TypeParam(_) -> {},
        Analyzer::Definition::TypeAlias(_) -> {},
        Analyzer::Definition::Trait(_) -> {},
        Analyzer::Definition::Method(_) -> {},
      };
    }

    /// Patch `FunctionDef.extensionTarget` at `fnDefId` via `DefinitionStore::replace`.
    function patchExtensionTarget(
      defStore: &mut Analyzer::DefinitionStore,
      fnDefId: Analyzer::DefinitionId,
      targetType: Analyzer::TypeId,
    ): void {
      let Option::SOME(existing) = defStore.get(fnDefId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::Function(fn_) -> {
          let updated: Analyzer::FunctionDef = Analyzer::FunctionDef {
            name: fn_.name,
            visibility: fn_.visibility,
            typeParams: Analyzer::Resolver::copyDefinitionIdVector(&fn_.typeParams),
            params: Analyzer::Resolver::copyDefinitionIdVector(&fn_.params),
            returnType: fn_.returnType,
            isDeprecated: fn_.isDeprecated,
            deprecatedMessage: Analyzer::Resolver::copyOptionalMessage(&fn_.deprecatedMessage),
            extensionTarget: Option::SOME(targetType),
            extensionMutable: fn_.extensionMutable,
            isExtern: fn_.isExtern,
            externName: Analyzer::Resolver::copyOptionalMessage(&fn_.externName),
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(fnDefId, Analyzer::Definition::Function(updated));
        },
        Analyzer::Definition::Record(_) -> {},
        Analyzer::Definition::Enum(_) -> {},
        Analyzer::Definition::Variable(_) -> {},
        Analyzer::Definition::Field(_) -> {},
        Analyzer::Definition::Variant(_) -> {},
        Analyzer::Definition::TypeParam(_) -> {},
        Analyzer::Definition::TypeAlias(_) -> {},
        Analyzer::Definition::Trait(_) -> {},
        Analyzer::Definition::Method(_) -> {},
      };
    }

    /// Patch `MethodDef.returnType` at `methodDefId` via `DefinitionStore::replace`.
    function patchMethodReturnType(
      defStore: &mut Analyzer::DefinitionStore,
      methodDefId: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
    ): void {
      let Option::SOME(existing) = defStore.get(methodDefId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::Method(method) -> {
          let updated: Analyzer::MethodDef = Analyzer::MethodDef {
            name: method.name,
            visibility: method.visibility,
            owner: method.owner,
            typeParams: Analyzer::Resolver::copyDefinitionIdVector(&method.typeParams),
            params: Analyzer::Resolver::copyDefinitionIdVector(&method.params),
            returnType: typeId,
            isStatic: method.isStatic,
            selfMutable: method.selfMutable,
            selfByValue: method.selfByValue,
            isDeprecated: method.isDeprecated,
            deprecatedMessage: Analyzer::Resolver::copyOptionalMessage(&method.deprecatedMessage),
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(methodDefId, Analyzer::Definition::Method(updated));
        },
        Analyzer::Definition::Record(_) -> {},
        Analyzer::Definition::Enum(_) -> {},
        Analyzer::Definition::Function(_) -> {},
        Analyzer::Definition::Variable(_) -> {},
        Analyzer::Definition::Field(_) -> {},
        Analyzer::Definition::Variant(_) -> {},
        Analyzer::Definition::TypeParam(_) -> {},
        Analyzer::Definition::TypeAlias(_) -> {},
        Analyzer::Definition::Trait(_) -> {},
      };
    }

    // =========================================================================
    // Extract helpers — copy sub-vecs to release borrows before mutable ops.
    // =========================================================================

    /// Extract a copy of RecordDef.fields, releasing the immutable borrow.
    /// The enum's static field definitions, in declaration order.
    function extractEnumStaticFields(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      let Analyzer::Definition::Enum(en) = def else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut index: u64 = 0;

      while (index < en.staticFields.length()) {
        let Option::SOME(staticId) = en.staticFields.get(index) else {
          index += 1;
          continue;
        };

        out.push(*staticId);
        index += 1;
      }

      return out;
    }

    /// The record's static field definitions, in declaration order.
    function extractRecordStaticFields(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      let Analyzer::Definition::Record(rec) = def else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut index: u64 = 0;

      while (index < rec.staticFields.length()) {
        let Option::SOME(staticId) = rec.staticFields.get(index) else {
          index += 1;
          continue;
        };

        out.push(*staticId);
        index += 1;
      }

      return out;
    }

    function extractRecordFields(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      match (def) {
        Analyzer::Definition::Record(rec) -> {
          let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let mut index: u64 = 0;

          while (index < rec.fields.length()) {
            let Option::SOME(fieldId) = rec.fields.get(index) else {
              index += 1;
              continue;
            };

            out.push(*fieldId);
            index += 1;
          }

          return out;
        },
        Analyzer::Definition::Enum(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Function(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Variable(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Field(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Variant(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Trait(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Method(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
      };

      @panic("unreachable: extractRecordFields match did not return");
    }

    /// Extract a copy of EnumDef.variants, releasing the immutable borrow.
    function extractEnumVariants(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      let Analyzer::Definition::Enum(enumDef) = def else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut index: u64 = 0;

      while (index < enumDef.variants.length()) {
        let Option::SOME(variantId) = enumDef.variants.get(index) else {
          index += 1;
          continue;
        };

        out.push(*variantId);
        index += 1;
      }

      return out;
    }

    /// Payload slot patterns of a variant declaration, in declaration order.
    ///
    /// The parser models a payload variant as a `Pattern::Path` whose arguments
    /// are the declared slots; a unit variant is a `Pattern::Binding` and yields
    /// no slots.
    function variantPayloadSlotPatterns(
      module: &Ast::Module,
      variantPatternId: Ast::PatternId,
    ): Vector<Ast::PatternId> {
      let mut out: Vector<Ast::PatternId> = Vector::new<Ast::PatternId>();

      let Option::SOME(pattern) = module.patterns.get(variantPatternId) else {
        return out;
      };

      let Ast::Pattern::Node::Path(declaration) = pattern else {
        return out;
      };

      let mut index: u64 = 0;

      while (index < declaration.arguments.length()) {
        let Option::SOME(slotPatternId) = declaration.arguments.get(index) else {
          index += 1;
          continue;
        };

        out.push(*slotPatternId);
        index += 1;
      }

      return out;
    }

    /// Extract a copy of FunctionDef.params, releasing the immutable borrow.
    function extractFunctionParams(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      match (def) {
        Analyzer::Definition::Function(fn_) -> {
          let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let mut index: u64 = 0;

          while (index < fn_.params.length()) {
            let Option::SOME(paramId) = fn_.params.get(index) else {
              index += 1;
              continue;
            };

            out.push(*paramId);
            index += 1;
          }

          return out;
        },
        Analyzer::Definition::Record(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Enum(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Variable(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Field(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Variant(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Trait(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Method(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
      };

      @panic("unreachable: extractFunctionParams match did not return");
    }

    /// Extract a copy of MethodDef.params, releasing the immutable borrow.
    function extractMethodParams(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Vector::new<Analyzer::DefinitionId>();
      };

      match (def) {
        Analyzer::Definition::Method(method) -> {
          let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let mut index: u64 = 0;

          while (index < method.params.length()) {
            let Option::SOME(paramId) = method.params.get(index) else {
              index += 1;
              continue;
            };

            out.push(*paramId);
            index += 1;
          }

          return out;
        },
        Analyzer::Definition::Record(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Enum(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Function(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Variable(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Field(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Variant(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
        Analyzer::Definition::Trait(_) -> {
          return Vector::new<Analyzer::DefinitionId>();
        },
      };

      @panic("unreachable: extractMethodParams match did not return");
    }

    // =========================================================================
    // Type resolution — resolvePath is a leaf; resolveTypeNode is self-recursive
    // with generic resolution inlined to avoid mutual-recursion forward refs.
    // =========================================================================

    /// Copy the program-wide qualified index into resolver state.
    function copyProgramQualifiedIndex(
      state: &mut Analyzer::Resolver::ResolverState,
      programIndex: &Analyzer::Imports::ProgramQualifiedIndex,
    ): void {
      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      let mut i: u64 = 0;

      while (i < programIndex.syms.length()) {
        let Option::SOME(sym) = programIndex.syms.get(i) else {
          i += 1;
          continue;
        };
        let Option::SOME(defId) = programIndex.defs.get(i) else {
          i += 1;
          continue;
        };
        let Option::SOME(qualifiedName) = programIndex.qualifiedNames.get(i) else {
          i += 1;
          continue;
        };

        stateRef.programSyms.push(*sym);
        stateRef.programDefs.push(*defId);
        stateRef.programQualifiedNames.push(qualifiedName.clone());
        i += 1;
      }
    }

    /// The segments of a type path joined with `::`, as written.
    function qualifiedPathText(p: &Ast::Type::Path): String {
      let mut writtenPath: String = String::create("");
      let mut segIndex: u64 = 0;

      while (segIndex < p.segments.length()) {
        let Option::SOME(seg) = p.segments.get(segIndex) else {
          segIndex += 1;
          continue;
        };

        if (segIndex > 0) {
          writtenPath.pushStr("::");
        }
        writtenPath.pushStr(seg.toStr());
        segIndex += 1;
      }

      return writtenPath;
    }

    /// The program-index declaration a written qualified type path names.
    function programLookupForPath(
      state: &mut Analyzer::Resolver::ResolverState,
      sym: Analyzer::SymbolId,
      p: &Ast::Type::Path,
    ): Option<Analyzer::DefinitionId> {
      let writtenPath: String = qualifiedPathText(p);
      let suffix: String = `::${writtenPath.toStr()}`;
      let mut i: u64 = 0;

      while (i < state.programSyms.length()) {
        let Option::SOME(candidateSym) = state.programSyms.get(i) else {
          i += 1;
          continue;
        };

        if (candidateSym.raw() != sym.raw()) {
          i += 1;
          continue;
        }

        let Option::SOME(candidate) = state.programQualifiedNames.get(i) else {
          i += 1;
          continue;
        };

        if (candidate.equals(writtenPath.toStr()) || Analyzer::Imports::programPathEndsWith(candidate, &suffix)) {
          let Option::SOME(defId) = state.programDefs.get(i) else {
            i += 1;
            continue;
          };

          return Option::SOME(*defId);
        }

        i += 1;
      }

      return Option::NONE;
    }

    /// The program-index declaration a bare type name refers to when read from
    /// inside the namespaces currently entered.
    ///
    /// The enclosing chain is tried innermost first, so `Point` written inside
    /// `namespace Second` finds `Second::Point` before an outer or top-level
    /// declaration of that name. Only type declarations answer: a namespace
    /// constant or function sharing the name is not what a type position wants.
    function namespaceScopedTypeLookup(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      sym: Analyzer::SymbolId,
      name: str,
    ): Option<Analyzer::DefinitionId> {
      return namespaceScopedLookup(state, defStore, sym, name, false);
    }

    /// `namespaceScopedTypeLookup` for a trait name: only trait declarations
    /// answer.
    function namespaceScopedTraitLookup(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      sym: Analyzer::SymbolId,
      name: str,
    ): Option<Analyzer::DefinitionId> {
      return namespaceScopedLookup(state, defStore, sym, name, true);
    }

    /// The declaration a bare name written inside the entered namespaces
    /// refers to, innermost namespace first: a trait when `wantTrait` is set,
    /// otherwise a type that is not a trait.
    function namespaceScopedLookup(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      sym: Analyzer::SymbolId,
      name: str,
      wantTrait: boolean,
    ): Option<Analyzer::DefinitionId> {
      let mut depth: u64 = state.namespaceChain.length();

      while (depth > 0) {
        let mut writtenPath: String = String::create("");
        let mut segIndex: u64 = 0;

        while (segIndex < depth) {
          if (let Option::SOME(seg) = state.namespaceChain.get(segIndex)) {
            writtenPath.pushStr(seg.toStr());
            writtenPath.pushStr("::");
          }
          segIndex += 1;
        }
        writtenPath.pushStr(name);

        let suffix: String = `::${writtenPath.toStr()}`;
        let mut i: u64 = 0;

        while (i < state.programSyms.length()) {
          let Option::SOME(candidateSym) = state.programSyms.get(i) else {
            i += 1;
            continue;
          };

          if (candidateSym.raw() != sym.raw()) {
            i += 1;
            continue;
          }

          let Option::SOME(candidate) = state.programQualifiedNames.get(i) else {
            i += 1;
            continue;
          };

          if (candidate.equals(writtenPath.toStr()) || Analyzer::Imports::programPathEndsWith(candidate, &suffix)) {
            let Option::SOME(defId) = state.programDefs.get(i) else {
              i += 1;
              continue;
            };

            let isTrait: boolean = isTraitDef(defStore, *defId);

            if (wantTrait && isTrait) {
              return Option::SOME(*defId);
            }

            if (!wantTrait && isTypeNameDef(defStore, *defId) && !isTrait) {
              return Option::SOME(*defId);
            }
          }

          i += 1;
        }

        depth -= 1;
      }

      return Option::NONE;
    }

    /// Resolve a single-segment `Ast::Type::Path` to an `Analyzer::TypeId`.
    ///
    /// Resolution order:
    ///   1. Primitive names (15 `String::create().equals()` compares).
    ///   2. Type-param scope (innermost-first linear scan).
    ///   3. Enclosing namespace chain, innermost first.
    ///   4. Global type-name index (linear scan).
    ///   5. Import overlay (linear scan).
    ///   6. Unknown: emit UNDEFINED_TYPE + return VOID.
    ///
    /// A multi-segment path resolves only through the program-wide qualified
    /// index, so every leading namespace segment has to match the namespace the
    /// type is declared in; a path that matches no declaration is UNDEFINED_TYPE.
    function resolvePath(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      scope: &Analyzer::Resolver::TypeParamScope,
      p: &Ast::Type::Path,
    ): Analyzer::TypeId {
      if (p.segments.length() == 0) {
        emitTypeDiagnosticLabeled(state, p.span, DiagnosticCode::UNDEFINED_TYPE, "Undefined type ''", "type path has no segments");
        let mut tsRef: &mut Analyzer::TypeStore = typeStore;
        return tsRef.intern(Analyzer::Type::VOID);
      }

      // A qualified path names its type in the last segment; the leading ones
      // are the namespace it lives in.
      let qualified: boolean = p.segments.length() > 1;

      let Option::SOME(nameStr) = p.segments.get(p.segments.length() - 1) else {
        let mut tsRef: &mut Analyzer::TypeStore = typeStore;
        return tsRef.intern(Analyzer::Type::VOID);
      };

      // 1. Primitive check. A primitive is never written qualified.
      if (!qualified) {
        let primOpt: Option<Analyzer::TypeId> = primitiveForName(typeStore, nameStr.toStr());

        if (let Option::SOME(primId) = primOpt) {
          return primId;
        }
      }

      // 2. Type-param scope, which a qualified path never names either.
      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let sym: Analyzer::SymbolId = symbolsRef.intern(nameStr.toStr());

      if (!qualified) {
        let scopeIdxOpt: Option<u64> = scopeLookup(scope, sym);

        if (let Option::SOME(idx) = scopeIdxOpt) {
          let Option::SOME(tid) = scope.typeIds.get(idx) else {
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          };
          return *tid;
        }
      }

      // 3. A qualified path resolves by written path alone — the program-wide
      // index validates the prefix — so `Analyzer::TypeId` and `Ast::TypeId`
      // stay apart even though both end in `TypeId`. Falling back to the bare
      // last segment would accept any prefix, including one naming no namespace.
      if (qualified) {
        Analyzer::Resolver::reportUnreachableLeadingSegment(state, defStore, symbols, &p.segments, p.span);
        let programFirstOpt: Option<Analyzer::DefinitionId> = programLookupForPath(state, sym, p);

        if (let Option::SOME(defId) = programFirstOpt) {
          if (isTraitDef(defStore, defId)) {
            let message: String = `Expected a type, but '${nameStr.toStr()}' refers to a trait`;
            emitUndefinedType(state, p.span, DiagnosticCode::INVALID_ENTITY_POSITION, message.toStr());
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          }

          if (isTypeNameDef(defStore, defId)) {
            return nominalTypeFor(defStore, typeStore, defId);
          }
        }

        let message: String = `Undefined type '${qualifiedPathText(p).toStr()}'`;
        emitUndefinedType(state, p.span, DiagnosticCode::UNDEFINED_TYPE, message.toStr());
        let mut tsRef: &mut Analyzer::TypeStore = typeStore;
        return tsRef.intern(Analyzer::Type::VOID);
      }

      // 4. The namespaces this annotation is written inside, innermost first.
      // The flat index below keys on the bare name alone and would hand every
      // namespace the same `Point`.
      if (!qualified) {
        let scopedOpt: Option<Analyzer::DefinitionId> = namespaceScopedTypeLookup(state, defStore, sym, nameStr.toStr());

        if (let Option::SOME(scopedDefId) = scopedOpt) {
          return nominalTypeFor(defStore, typeStore, scopedDefId);
        }
      }

      // 5. This module's declarations, then imports: the ones the current
      // namespace chain reaches by a bare name first.
      let bareOpt: Option<Analyzer::Resolver::BareCandidate> = Analyzer::Resolver::bareCandidate(state, sym);

      if (let Option::SOME(candidate) = bareOpt) {
        let defId: Analyzer::DefinitionId = candidate.defId;

        // Trait names are not valid in type position.
        if (isTraitDef(defStore, defId)) {
          let message: String = `Expected a type, but '${nameStr.toStr()}' refers to a trait`;
          emitUndefinedType(state, p.span, DiagnosticCode::INVALID_ENTITY_POSITION, message.toStr());
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.intern(Analyzer::Type::VOID);
        }

        if (!isTypeNameDef(defStore, defId)) {
          let message: String = `Undefined type '${nameStr.toStr()}'`;
          emitUndefinedType(state, p.span, DiagnosticCode::UNDEFINED_TYPE, message.toStr());
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.intern(Analyzer::Type::VOID);
        }

        Analyzer::Resolver::reportUnreachableCandidate(state, defStore, &candidate, nameStr.toStr(), nameStr.toStr(), p.span);
        return nominalTypeFor(defStore, typeStore, defId);
      }

      // 6. Unknown.
      let message: String = `Undefined type '${nameStr.toStr()}'`;
      emitUndefinedType(state, p.span, DiagnosticCode::UNDEFINED_TYPE, message.toStr());
      let mut tsRef: &mut Analyzer::TypeStore = typeStore;
      return tsRef.intern(Analyzer::Type::VOID);
    }

    /// `Range<T>` and `RangeInclusive<T>`, the builtin types of `a..b` and
    /// `a..=b`, once no declaration of that name was found. The element has to
    /// be an integer, or an alias that is checked where it is used, since an
    /// alias is not resolved yet while signatures are.
    function resolveBuiltinRangeType(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      span: SourceSpan,
      name: str,
      inclusive: boolean,
      args: &Vector<Analyzer::TypeId>,
    ): Analyzer::TypeId {
      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;

      if (args.length() != 1) {
        let message: String = `Wrong number of type arguments for '${name}': expected 1, got ${args.length()}`;
        emitUndefinedType(state, span, DiagnosticCode::GENERIC_ARITY_MISMATCH, message.toStr());
        return typeStoreRef.intern(Analyzer::Type::VOID);
      }

      let Option::SOME(element) = args.get(0) else {
        return typeStoreRef.intern(Analyzer::Type::VOID);
      };

      let mut acceptable: boolean = false;

      if (let Option::SOME(elementNode) = typeStoreRef.get(*element)) {
        acceptable = match (elementNode) {
          Analyzer::Type::I8
          | Analyzer::Type::I16
          | Analyzer::Type::I32
          | Analyzer::Type::I64
          | Analyzer::Type::U8
          | Analyzer::Type::U16
          | Analyzer::Type::U32
          | Analyzer::Type::U64
          | Analyzer::Type::Alias(_) -> true,
          _ -> false,
        };
      }

      if (!acceptable) {
        let elementName: String = typeStoreRef.nameOfResolved(*element, &*defStore, &*symbols);
        let message: String = `the element type of '${name}' must be an integer type, found '${elementName.toStr()}'`;
        emitUndefinedType(state, span, DiagnosticCode::RANGE_ELEMENT_NOT_INTEGER, message.toStr());
        return typeStoreRef.intern(Analyzer::Type::VOID);
      }

      return typeStoreRef.range(*element, inclusive);
    }

    /// Dispatch an `Ast::Type::Node` to the appropriate resolution logic.
    ///
    /// Self-recursive. Generic resolution is inlined in the `Generic(g)` arm to
    /// break the mutual-recursion cycle that would require a forward reference.
    ///
    /// On any error, emits a diagnostic and returns `Type::VOID` so callers always
    /// receive a well-formed TypeId.
    function resolveTypeNode(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      scope: &Analyzer::Resolver::TypeParamScope,
      typeId: Ast::TypeId,
    ): Analyzer::TypeId {
      let Option::SOME(node) = module.types.get(typeId) else {
        let mut tsRef: &mut Analyzer::TypeStore = typeStore;
        return tsRef.intern(Analyzer::Type::VOID);
      };

      match (node) {
        Ast::Type::Node::Path(p) -> {
          return resolvePath(state, defStore, typeStore, symbols, module, scope, &p);
        },
        Ast::Type::Node::Pointer(p) -> {
          let inner: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, scope, p.pointee);
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          if (p.mutable) {
            return tsRef.mutablePointer(inner);
          }
          return tsRef.pointer(inner);
        },
        Ast::Type::Node::Reference(r) -> {
          let inner: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, scope, r.target);
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          if (r.mutable) {
            return tsRef.mutableReference(inner);
          }
          return tsRef.reference(inner);
        },
        Ast::Type::Node::Tuple(t) -> {
          let mut elements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < t.elements.length()) {
            let Option::SOME(elemId) = t.elements.get(index) else {
              index += 1;
              continue;
            };

            let elem: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, scope, *elemId);
            elements.push(elem);
            index += 1;
          }

          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.tuple(elements);
        },
        Ast::Type::Node::Slice(s) -> {
          let inner: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, scope, s.element);
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.slice(inner);
        },
        Ast::Type::Node::FixedArray(a) -> {
          let inner: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, scope, a.element);
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.fixedArray(inner, a.size);
        },
        Ast::Type::Node::Function(f) -> {
          let mut params: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < f.parameters.length()) {
            let Option::SOME(paramId) = f.parameters.get(index) else {
              index += 1;
              continue;
            };

            let param: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, scope, *paramId);
            params.push(param);
            index += 1;
          }

          let ret: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, scope, f.returnType);
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;

          if (f.pointer) {
            return tsRef.rawFunctionType(params, ret);
          }

          return tsRef.functionType(params, ret);
        },
        Ast::Type::Node::Generic(g) -> {
          // ---- Inlined generic resolution (breaks mutual-recursion cycle) ----

          // Resolve arguments first — collect recursive diagnostics in source order.
          let mut args: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut argIndex: u64 = 0;

          while (argIndex < g.arguments.length()) {
            let Option::SOME(argId) = g.arguments.get(argIndex) else {
              argIndex += 1;
              continue;
            };

            let argType: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, scope, *argId);
            args.push(argType);
            argIndex += 1;
          }

          // Validate base: must be a single-segment Path.
          let gSpan: SourceSpan = g.span;

          let Option::SOME(basePath) = extractBasePath(module, g.base) else {
            emitUndefinedType(state, gSpan, DiagnosticCode::UNSUPPORTED_CONSTRUCT, "generic base must be a single-segment path");
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          };

          let baseQualified: boolean = basePath.segments.length() > 1;

          let Option::SOME(lastSeg) = basePath.segments.get(basePath.segments.length() - 1) else {
            emitUndefinedType(state, gSpan, DiagnosticCode::UNSUPPORTED_CONSTRUCT, "generic base path is empty");
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          };

          let baseNameStr: String = lastSeg.clone();
          let basePathSpan: SourceSpan = basePath.span;

          let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
          let sym: Analyzer::SymbolId = symbolsRef.intern(baseNameStr.toStr());

          // Type-param in generic position is invalid; never written qualified.
          if (!baseQualified && scopeLookup(scope, sym).isSome()) {
            let message: String = `Type '${baseNameStr.toStr()}' cannot be parameterized`;
            emitTypeDiagnosticLabeled(state, gSpan, DiagnosticCode::GENERIC_ARGS_NOT_ALLOWED, message.toStr(), "a type parameter takes no generic arguments");
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          }

          // Primitive in generic position is invalid; never written qualified.
          if (!baseQualified) {
            let primCheck: Option<Analyzer::TypeId> = primitiveForName(typeStore, baseNameStr.toStr());

            if (primCheck.isSome()) {
              let message: String = `Type '${baseNameStr.toStr()}' cannot be parameterized`;
              emitTypeDiagnosticLabeled(state, gSpan, DiagnosticCode::GENERIC_ARGS_NOT_ALLOWED, message.toStr(), "a primitive type takes no generic arguments");
              let mut tsRef: &mut Analyzer::TypeStore = typeStore;
              return tsRef.intern(Analyzer::Type::VOID);
            }
          }

          // A qualified base picks its declaration by written path first, the
          // same rule `resolvePath` applies.
          let mut defIdOpt: Option<Analyzer::DefinitionId> = Option::NONE;

          if (baseQualified) {
            Analyzer::Resolver::reportUnreachableLeadingSegment(state, defStore, symbols, &basePath.segments, basePathSpan);
            defIdOpt = programLookupForPath(state, sym, &basePath);
          }

          if (defIdOpt.isNone()) {
            if (let Option::SOME(candidate) = Analyzer::Resolver::bareCandidate(state, sym)) {
              if (!baseQualified) {
                Analyzer::Resolver::reportUnreachableCandidate(state, defStore, &candidate, baseNameStr.toStr(), baseNameStr.toStr(), basePathSpan);
              }
              defIdOpt = Option::SOME(candidate.defId);
            }
          }

          let Option::SOME(defId) = defIdOpt else {
            if (!baseQualified) {
              if (let Option::SOME(inclusive) = Analyzer::builtinRangeTypeName(baseNameStr.toStr())) {
                return resolveBuiltinRangeType(state, defStore, typeStore, symbols, gSpan, baseNameStr.toStr(), inclusive, &args);
              }
            }

            let message: String = `Undefined type '${baseNameStr.toStr()}'`;
            emitUndefinedType(state, basePathSpan, DiagnosticCode::UNDEFINED_TYPE, message.toStr());
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          };

          if (isTraitDef(defStore, defId)) {
            let message: String = `Expected a type, but '${baseNameStr.toStr()}' refers to a trait`;
            emitUndefinedType(state, basePathSpan, DiagnosticCode::INVALID_ENTITY_POSITION, message.toStr());
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          }

          if (!isTypeNameDef(defStore, defId)) {
            let message: String = `Undefined type '${baseNameStr.toStr()}'`;
            emitUndefinedType(state, basePathSpan, DiagnosticCode::UNDEFINED_TYPE, message.toStr());
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          }

          // Arity check.
          let expectedArity: u64 = arityOf(defStore, defId);
          let actualArity: u64 = args.length();

          if (actualArity != expectedArity) {
            let message: String = `Wrong number of type arguments for '${baseNameStr.toStr()}': expected ${expectedArity}, got ${actualArity}`;
            emitUndefinedType(state, gSpan, DiagnosticCode::GENERIC_ARITY_MISMATCH, message.toStr());
            let mut tsRef: &mut Analyzer::TypeStore = typeStore;
            return tsRef.intern(Analyzer::Type::VOID);
          }

          // An instance of a generic alias is the type the alias names, with
          // the arguments in place of its parameters: every later phase then
          // sees the nominal instance, and its bounds, and never the alias.
          if (let Option::SOME(Analyzer::Definition::TypeAlias(_)) = defStore.get(defId)) {
            Analyzer::Resolver::resolveCollectedAlias(state, defStore, typeStore, symbols, module, defId);

            if (let Option::SOME(expanded) = Analyzer::Typecheck::expandGenericAlias(defStore, typeStore, defId, &args)) {
              return expanded;
            }
          }

          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.instance(defId, args);
        },
      };

      @panic("unreachable: resolveTypeNode match did not return");
    }

    // =========================================================================
    // Item-level resolution — calls resolveTypeNode.
    // =========================================================================

    /// Compute the owner `Self` `TypeId` for a method-signature scope.
    ///
    /// For a generic owner the receiver maps to `Instance(ownerDefId, ownerParams)`;
    /// for a non-generic owner it maps to the nominal `Record(defId)` or `Enum(defId)`.
    /// The `isEnum` flag selects the nominal base record/enum variant.
    function selfTypeFor(
      typeStore: &mut Analyzer::TypeStore,
      ownerDefId: Analyzer::DefinitionId,
      ownerScope: &Analyzer::Resolver::TypeParamScope,
      isEnum: boolean,
    ): Analyzer::TypeId {
      if (ownerScope.typeIds.length() > 0) {
        let mut args: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
        let mut index: u64 = 0;

        while (index < ownerScope.typeIds.length()) {
          let Option::SOME(tid) = ownerScope.typeIds.get(index) else {
            index += 1;
            continue;
          };

          args.push(*tid);
          index += 1;
        }

        let mut tsRef: &mut Analyzer::TypeStore = typeStore;
        return tsRef.instance(ownerDefId, args);
      }

      let mut tsRef: &mut Analyzer::TypeStore = typeStore;
      if (isEnum) {
        return tsRef.enumType(ownerDefId);
      }
      return tsRef.recordType(ownerDefId);
    }

    /// Whether `name` is a language trait, which `@implements` and bounds
    /// accept without a declaration in scope: the lang traits, and `Eq` and
    /// `Hash`, which the compiler recognizes by name for primitives and
    /// canonical equality.
    function isUndeclaredTraitName(name: &String): boolean {
      return name.equals("Drop") || name.equals("Clone") || name.equals("Copy") || name.equals("Send") || name.equals("Sync") || name.equals("Eq") || name.equals("Hash");
    }

    /// The label of an unknown-trait diagnostic: what the written path names
    /// instead, when it names a declaration that is not a trait, and whether a
    /// trait of that name exists out of scope.
    function unknownTraitLabel(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      segments: &Vector<String>,
      written: &String,
      span: SourceSpan,
    ): String {
      let Option::SOME(name) = segments.get(segments.length() - 1) else {
        return `no trait named '${written.toStr()}' is in scope`;
      };

      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let sym: Analyzer::SymbolId = symbolsRef.intern(name.toStr());
      let mut named: Option<Analyzer::DefinitionId> = Option::NONE;

      if (segments.length() > 1) {
        let path: Ast::Type::Path = Ast::Type::Path {
          span: span,
          segments: Analyzer::Resolver::copyStringVector(segments),
        };
        named = programLookupForPath(state, sym, &path);
      } else {
        named = namespaceScopedTypeLookup(state, defStore, sym, name.toStr());

        if (named.isNone()) {
          if (let Option::SOME(candidate) = Analyzer::Resolver::bareCandidate(state, sym)) {
            named = Option::SOME(candidate.defId);
          }
        }
      }

      if (let Option::SOME(defId) = named) {
        if (!isTraitDef(defStore, defId)) {
          return `'${written.toStr()}' is not a trait`;
        }
      }

      let candidates: Vector<Analyzer::DefinitionId> = defStore.definitionsNamed(sym);
      let mut index: u64 = 0;

      while (index < candidates.length()) {
        if (let Option::SOME(candidate) = candidates.get(index)) {
          if (isTraitDef(defStore, *candidate)) {
            return `no trait named '${written.toStr()}' is in scope; import it or write its path`;
          }
        }

        index += 1;
      }

      return `no trait named '${written.toStr()}' is in scope`;
    }

    /// The trait a written trait path names, read the way a type path is: a
    /// qualified path through the program-wide index, a bare name through the
    /// entered namespaces, the module's declarations and its imports. A trait
    /// that is not in scope answers nothing, even when it is the only trait of
    /// that name in the program.
    function lookupTraitPath(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      segments: &Vector<String>,
      span: SourceSpan,
    ): Option<Analyzer::DefinitionId> {
      if (segments.length() == 0) {
        return Option::NONE;
      }

      let Option::SOME(name) = segments.get(segments.length() - 1) else {
        return Option::NONE;
      };

      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let sym: Analyzer::SymbolId = symbolsRef.intern(name.toStr());

      if (segments.length() > 1) {
        Analyzer::Resolver::reportUnreachableLeadingSegment(state, defStore, symbols, segments, span);

        let path: Ast::Type::Path = Ast::Type::Path {
          span: span,
          segments: Analyzer::Resolver::copyStringVector(segments),
        };

        if (let Option::SOME(defId) = programLookupForPath(state, sym, &path)) {
          if (isTraitDef(defStore, defId)) {
            return Option::SOME(defId);
          }
        }

        return Option::NONE;
      }

      if (let Option::SOME(scoped) = namespaceScopedTraitLookup(state, defStore, sym, name.toStr())) {
        return Option::SOME(scoped);
      }

      // A trait the entered namespaces do not reach by this name still
      // answers, reported as A0263 with the path to write, so the use is not
      // also an unknown trait.
      let Option::SOME(candidate) = Analyzer::Resolver::bareCandidate(state, sym) else {
        return Option::NONE;
      };

      if (!isTraitDef(defStore, candidate.defId)) {
        return Option::NONE;
      }

      // A language trait needs no declaration, so a namespaced trait sharing
      // its name is not what an outside use means.
      if (!candidate.reachable && isUndeclaredTraitName(name)) {
        return Option::NONE;
      }

      if (!Analyzer::Resolver::programNameReachable(&state.programSyms, &state.programQualifiedNames, sym, &state.namespaceChain)) {
        Analyzer::Resolver::reportUnreachableCandidate(state, defStore, &candidate, name.toStr(), name.toStr(), span);
      }

      return Option::SOME(candidate.defId);
    }

    /// The trimmed `::`-separated segments of a trait path written as an
    /// attribute argument.
    function traitArgumentSegments(argument: &String): Vector<String> {
      let raw: Vector<String> = Analyzer::Binder::typePathSegments(argument);
      let mut segments: Vector<String> = Vector::new<String>();
      let mut index: u64 = 0;

      while (index < raw.length()) {
        if (let Option::SOME(segment) = raw.get(index)) {
          let trimmed: String = segment.trimAsciiWhitespace();

          if (trimmed.length() > 0) {
            segments.push(trimmed.clone());
          }
        }

        index += 1;
      }

      return segments;
    }

    /// Resolves each trait the record or enum `defId` names in `@implements`,
    /// in the order `RecordDef::implementedTraits` lists them, and records
    /// the result on the definition store.
    ///
    /// A name that resolves to no trait is A0142, unless it is a language trait
    /// (`isUndeclaredTraitName`).
    function resolveImplementedTraits(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      defId: Analyzer::DefinitionId,
      metadata: &Ast::Metadata,
    ): void {
      let mut references: Vector<Option<Analyzer::DefinitionId>> = Vector::new<Option<Analyzer::DefinitionId>>();
      let mut index: u64 = 0;

      while (index < metadata.attributes.length()) {
        let Option::SOME(attribute) = metadata.attributes.get(index) else {
          index += 1;
          continue;
        };

        if (!attribute.name.equals("implements")) {
          index += 1;
          continue;
        }

        let mut argumentIndex: u64 = 0;

        while (argumentIndex < attribute.arguments.length()) {
          let Option::SOME(argument) = attribute.arguments.get(argumentIndex) else {
            argumentIndex += 1;
            continue;
          };

          let segments: Vector<String> = traitArgumentSegments(argument);
          let traitId: Option<Analyzer::DefinitionId> = lookupTraitPath(state, defStore, symbols, &segments, attribute.span);
          let unresolved: boolean = traitId.isNone();
          references.push(traitId);

          if (unresolved) {
            let written: String = argument.trimAsciiWhitespace();

            if (!(segments.length() == 1 && isUndeclaredTraitName(&written))) {
              let message: String = `Unknown trait '${written.toStr()}' in @implements`;
              let label: String = unknownTraitLabel(state, defStore, symbols, &segments, &written, attribute.span);
              emitTypeDiagnosticLabeled(state, attribute.span, DiagnosticCode::UNKNOWN_IMPLEMENTED_TRAIT, message.toStr(), label.toStr());
            }
          }

          argumentIndex += 1;
        }

        index += 1;
      }

      let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
      defsRef.setTraitReferences(defId, references);
    }

    /// The type parameters `defId` declares, when it is a declaration that
    /// takes any.
    function declaredTypeParamIds(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      return match (defStore.get(defId)) {
        Option::SOME(Analyzer::Definition::Record(record_)) -> Analyzer::Resolver::copyDefinitionIdVector(&record_.typeParams),
        Option::SOME(Analyzer::Definition::Enum(enum_)) -> Analyzer::Resolver::copyDefinitionIdVector(&enum_.typeParams),
        Option::SOME(Analyzer::Definition::Function(function_)) -> Analyzer::Resolver::copyDefinitionIdVector(&function_.typeParams),
        Option::SOME(Analyzer::Definition::Method(method)) -> Analyzer::Resolver::copyDefinitionIdVector(&method.typeParams),
        Option::SOME(Analyzer::Definition::Trait(trait_)) -> Analyzer::Resolver::copyDefinitionIdVector(&trait_.typeParams),
        Option::SOME(Analyzer::Definition::TypeAlias(alias)) -> Analyzer::Resolver::copyDefinitionIdVector(&alias.typeParams),
        _ -> Vector::new<Analyzer::DefinitionId>(),
      };
    }

    /// Resolves the bounds of every type parameter `defId` declares, in the
    /// order `TypeParamDef::bounds` lists them, and records the result on the
    /// definition store. A bound naming no trait is A0142, unless it is a
    /// language trait, which is recorded as `NONE` and matched by name.
    function resolveBoundTraits(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      defId: Analyzer::DefinitionId,
      generics: &Vector<Ast::GenericParam>,
    ): void {
      let typeParamIds: Vector<Analyzer::DefinitionId> = declaredTypeParamIds(defStore, defId);
      let mut index: u64 = 0;

      while (index < typeParamIds.length()) {
        let Option::SOME(typeParamId) = typeParamIds.get(index) else {
          index += 1;
          continue;
        };

        let mut position: u64 = 0;
        let mut found: boolean = false;

        if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*typeParamId)) {
          position = typeParam.index as u64;
          found = true;
        }

        let Option::SOME(generic) = generics.get(position) else {
          index += 1;
          continue;
        };

        if (!found) {
          index += 1;
          continue;
        }

        let mut references: Vector<Option<Analyzer::DefinitionId>> = Vector::new<Option<Analyzer::DefinitionId>>();
        let mut boundIndex: u64 = 0;

        while (boundIndex < generic.bounds.length()) {
          if (let Option::SOME(bound) = generic.bounds.get(boundIndex)) {
            if (bound.segments.length() > 0) {
              let traitId: Option<Analyzer::DefinitionId> = lookupTraitPath(state, defStore, symbols, &bound.segments, bound.span);
              let unresolved: boolean = traitId.isNone();
              references.push(traitId);

              if (unresolved) {
                let boundPath: Ast::Type::Path = Ast::Type::Path {
                  span: bound.span,
                  segments: Analyzer::Resolver::copyStringVector(&bound.segments),
                };
                let written: String = qualifiedPathText(&boundPath);

                if (!(bound.segments.length() == 1 && isUndeclaredTraitName(&written))) {
                  let message: String = `Unknown trait '${written.toStr()}' in the bound of '${generic.name.toStr()}'`;
                  let label: String = unknownTraitLabel(state, defStore, symbols, &bound.segments, &written, bound.span);
                  emitTypeDiagnosticLabeled(state, bound.span, DiagnosticCode::UNKNOWN_IMPLEMENTED_TRAIT, message.toStr(), label.toStr());
                }
              }
            }
          }

          boundIndex += 1;
        }

        let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
        defsRef.setTraitReferences(*typeParamId, references);
        index += 1;
      }
    }

    /// Resolve parameter and return-type annotations for owner-local methods.
    ///
    /// Walks `methodItemIds` (AST function items) positionally against each
    /// `Definition::Method`'s params. A per-method `TypeParamScope` is built from
    /// the method's own type parameters, the owner's type-parameter scope, and a
    /// `Self` entry mapping to the owner nominal type (or VOID for traits).
    /// Parameters (including the `self` receiver) and the return type are
    /// resolved and patched in-place. Signature-only methods whose return-type
    /// annotation is absent patch only their parameters.
    function resolveOwnerMethodSignatures(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      methodItemIds: &Vector<Ast::ItemId>,
      ownerScope: &Analyzer::Resolver::TypeParamScope,
      selfTypeId: Analyzer::TypeId,
    ): void {
      let mut index: u64 = 0;

      while (index < methodItemIds.length()) {
        let Option::SOME(methodItemId) = methodItemIds.get(index) else {
          index += 1;
          continue;
        };

        let methodDefIdOpt: Option<Analyzer::DefinitionId> = lookupDef(pass1, pass2, methodItemId.raw());
        let Option::SOME(methodDefId) = methodDefIdOpt else {
          index += 1;
          continue;
        };

        let Option::SOME(item) = module.items.get(*methodItemId) else {
          index += 1;
          continue;
        };

        match (item) {
          Ast::Item::Node::Function(fn_) -> {
            let savedChain: Option<Vector<String>> = Analyzer::Resolver::enterInheritedScope(state, module, *methodItemId);

            resolveBoundTraits(state, defStore, symbols, methodDefId, &fn_.genericParameters);

            // Method's own type params (innermost) then owner scope, then Self.
            let mut scope: Analyzer::Resolver::TypeParamScope = buildTypeParamScope(
              typeStore,
              symbols,
              &fn_.genericParameters,
            );

            let mut ownerIndex: u64 = 0;
            while (ownerIndex < ownerScope.syms.length()) {
              let Option::SOME(ownerSym) = ownerScope.syms.get(ownerIndex) else {
                ownerIndex += 1;
                continue;
              };
              let Option::SOME(ownerTid) = ownerScope.typeIds.get(ownerIndex) else {
                ownerIndex += 1;
                continue;
              };
              scope.syms.push(*ownerSym);
              scope.typeIds.push(*ownerTid);
              ownerIndex += 1;
            }

            let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
            let selfSym: Analyzer::SymbolId = symbolsRef.intern("Self");
            scope.syms.push(selfSym);
            scope.typeIds.push(selfTypeId);

            let paramDefIds: Vector<Analyzer::DefinitionId> = extractMethodParams(defStore, methodDefId);
            let mut paramIndex: u64 = 0;
            while (paramIndex < paramDefIds.length()) {
              let Option::SOME(paramDefId) = paramDefIds.get(paramIndex) else {
                paramIndex += 1;
                continue;
              };
              let Option::SOME(paramPatId) = fn_.parameters.get(paramIndex) else {
                paramIndex += 1;
                continue;
              };

              let annotationOpt: Option<Ast::TypeId> = patternAnnotation(module, *paramPatId);
              if (let Option::SOME(annotationTypeId) = annotationOpt) {
                let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, annotationTypeId);
                patchVariableType(defStore, *paramDefId, resolved);
                checkSendableParameter(state, defStore, module, *paramDefId, *paramPatId);
              }
              paramIndex += 1;
            }

            if (let Option::SOME(retTypeId) = fn_.returnType) {
              let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, retTypeId);
              patchMethodReturnType(defStore, methodDefId, resolved);
            }

            Analyzer::Resolver::leaveInheritedScope(state, savedChain);
          },
          Ast::Item::Node::Record(_) -> {},
          Ast::Item::Node::Enum(_) -> {},
          Ast::Item::Node::Namespace(_) -> {},
          Ast::Item::Node::Import(_) -> {},
          Ast::Item::Node::Extern(_) -> {},
          Ast::Item::Node::Constant(_) -> {},
          Ast::Item::Node::Export(_) -> {},
          Ast::Item::Node::TypeAlias(_) -> {},
          Ast::Item::Node::Trait(_) -> {},
        };

        index += 1;
      }
    }

    /// Resolve the declared type annotation on a module-level constant.
    function resolveConstant(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      c: &Ast::Item::Constant,
    ): void {
      let defIdOpt: Option<Analyzer::DefinitionId> = lookupDef(pass1, pass2, itemId.raw());
      let Option::SOME(defId) = defIdOpt else {
        return;
      };

      if (let Option::SOME(annotationTypeId) = c.annotation) {
        let scope: Analyzer::Resolver::TypeParamScope = Analyzer::Resolver::TypeParamScope {
          syms: Vector::new<Analyzer::SymbolId>(),
          typeIds: Vector::new<Analyzer::TypeId>(),
        };

        let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, annotationTypeId);
        patchVariableType(defStore, defId, resolved);
      }
    }

    /// Resolve an Enum item.
    ///
    /// Walks variants[i] (PatternId) positionally against EnumDef.variants[i]
    /// (DefinitionId) per ADR-R1, resolving each declared payload slot's
    /// annotation and replacing the binder's VOID placeholders with the real
    /// types. A slot without an annotation keeps its placeholder so payload
    /// arity is preserved. Instance and static method signatures (with owner
    /// `Self`) are resolved via `resolveOwnerMethodSignatures`.
    function resolveEnum(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      e: &Ast::Item::Enum,
    ): void {
      let defIdOpt: Option<Analyzer::DefinitionId> = lookupDef(pass1, pass2, itemId.raw());
      let Option::SOME(defId) = defIdOpt else {
        return;
      };

      resolveImplementedTraits(state, defStore, symbols, defId, &e.metadata);
      resolveBoundTraits(state, defStore, symbols, defId, &e.genericParameters);

      let scope: Analyzer::Resolver::TypeParamScope = buildTypeParamScope(typeStore, symbols, &e.genericParameters);
      let variantDefIds: Vector<Analyzer::DefinitionId> = extractEnumVariants(defStore, defId);
      let staticDefIds: Vector<Analyzer::DefinitionId> = extractEnumStaticFields(defStore, defId);

      // The written members carry variants and static fields, so each
      // definition table advances on its own counter.
      let mut patternIndex: u64 = 0;
      let mut variantIndex: u64 = 0;
      let mut staticIndex: u64 = 0;

      while (patternIndex < e.variants.length()) {
        let Option::SOME(variantPatternId) = e.variants.get(patternIndex) else {
          patternIndex += 1;
          continue;
        };

        if (Analyzer::Binder::variantPatternIsStaticField(module, *variantPatternId)) {
          if (let Option::SOME(staticDefId) = staticDefIds.get(staticIndex)) {
            if (let Option::SOME(annotationTypeId) = patternAnnotation(module, *variantPatternId)) {
              let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, annotationTypeId);
              patchVariableType(defStore, *staticDefId, resolved);
            }
          }

          staticIndex += 1;
          patternIndex += 1;
          continue;
        }

        let Option::SOME(variantDefId) = variantDefIds.get(variantIndex) else {
          variantIndex += 1;
          patternIndex += 1;
          continue;
        };

        let slotPatternIds: Vector<Ast::PatternId> = variantPayloadSlotPatterns(module, *variantPatternId);

        if (slotPatternIds.length() > 0) {
          let mut payload: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut slotIndex: u64 = 0;

          while (slotIndex < slotPatternIds.length()) {
            let Option::SOME(slotPatternId) = slotPatternIds.get(slotIndex) else {
              slotIndex += 1;
              continue;
            };

            let annotationOpt: Option<Ast::TypeId> = patternAnnotation(module, *slotPatternId);

            match (annotationOpt) {
              Option::SOME(annotationTypeId) -> {
                payload.push(resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, annotationTypeId));
              },
              Option::NONE -> {
                let mut typesRef: &mut Analyzer::TypeStore = typeStore;
                payload.push(typesRef.intern(Analyzer::Type::VOID));
              },
            };

            slotIndex += 1;
          }

          patchVariantPayload(defStore, *variantDefId, &payload);
        }

        variantIndex += 1;
        patternIndex += 1;
      }

      let selfTypeId: Analyzer::TypeId = selfTypeFor(typeStore, defId, &scope, true);
      resolveOwnerMethodSignatures(state, defStore, typeStore, symbols, module, pass1, pass2, &e.methods, &scope, selfTypeId);
    }

    /// Resolve all field type annotations in a Record item.
    ///
    /// Walks fields[i] (PatternId) positionally against RecordDef.fields[i]
    /// (DefinitionId) per ADR-R1.
    function resolveRecord(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      r: &Ast::Item::Record,
    ): void {
      let defIdOpt: Option<Analyzer::DefinitionId> = lookupDef(pass1, pass2, itemId.raw());
      let Option::SOME(defId) = defIdOpt else {
        return;
      };

      resolveImplementedTraits(state, defStore, symbols, defId, &r.metadata);
      resolveBoundTraits(state, defStore, symbols, defId, &r.genericParameters);

      let scope: Analyzer::Resolver::TypeParamScope = buildTypeParamScope(typeStore, symbols, &r.genericParameters);
      let fieldDefIds: Vector<Analyzer::DefinitionId> = extractRecordFields(defStore, defId);
      let staticDefIds: Vector<Analyzer::DefinitionId> = extractRecordStaticFields(defStore, defId);

      // The written fields carry both kinds, so each definition table advances
      // on its own counter as the patterns are walked in declaration order.
      let mut patternIndex: u64 = 0;
      let mut fieldIndex: u64 = 0;
      let mut staticIndex: u64 = 0;

      while (patternIndex < r.fields.length()) {
        let Option::SOME(fieldPatId) = r.fields.get(patternIndex) else {
          patternIndex += 1;
          continue;
        };

        let isStatic: boolean = Analyzer::Binder::fieldPatternIsStatic(module, *fieldPatId);
        let annotationOpt: Option<Ast::TypeId> = patternAnnotation(module, *fieldPatId);

        if (isStatic) {
          if (let Option::SOME(staticDefId) = staticDefIds.get(staticIndex)) {
            if (let Option::SOME(annotationTypeId) = annotationOpt) {
              let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, annotationTypeId);
              patchVariableType(defStore, *staticDefId, resolved);
            }
          }

          staticIndex += 1;
          patternIndex += 1;
          continue;
        }

        if (let Option::SOME(fieldDefId) = fieldDefIds.get(fieldIndex)) {
          if (let Option::SOME(annotationTypeId) = annotationOpt) {
            let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, annotationTypeId);
            patchFieldType(defStore, *fieldDefId, resolved);
          }
        }

        fieldIndex += 1;
        patternIndex += 1;
      }

      let selfTypeId: Analyzer::TypeId = selfTypeFor(typeStore, defId, &scope, false);
      resolveOwnerMethodSignatures(state, defStore, typeStore, symbols, module, pass1, pass2, &r.methods, &scope, selfTypeId);
    }

    /// Resolve function parameter declared types and return type.
    ///
    /// Walks params[i] (PatternId) against FunctionDef.params[i] (DefinitionId)
    /// positionally per ADR-R1. No diagnostic if return type annotation absent.
    function resolveFunction(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      f: &Ast::Item::Function,
    ): void {
      let defIdOpt: Option<Analyzer::DefinitionId> = lookupDef(pass1, pass2, itemId.raw());
      let Option::SOME(defId) = defIdOpt else {
        return;
      };

      resolveBoundTraits(state, defStore, symbols, defId, &f.genericParameters);

      let scope: Analyzer::Resolver::TypeParamScope = buildTypeParamScope(typeStore, symbols, &f.genericParameters);
      let paramDefIds: Vector<Analyzer::DefinitionId> = extractFunctionParams(defStore, defId);

      let mut paramIndex: u64 = 0;

      while (paramIndex < paramDefIds.length()) {
        let Option::SOME(paramDefId) = paramDefIds.get(paramIndex) else {
          paramIndex += 1;
          continue;
        };

        let Option::SOME(paramPatId) = f.parameters.get(paramIndex) else {
          paramIndex += 1;
          continue;
        };

        let annotationOpt: Option<Ast::TypeId> = patternAnnotation(module, *paramPatId);

        if (let Option::SOME(annotationTypeId) = annotationOpt) {
          let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, annotationTypeId);
          patchVariableType(defStore, *paramDefId, resolved);
          checkSendableParameter(state, defStore, module, *paramDefId, *paramPatId);
        }

        paramIndex += 1;
      }

      if (let Option::SOME(retTypeId) = f.returnType) {
        let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, retTypeId);
        patchReturnType(defStore, defId, resolved);
      }

      // `@extension(Type)` names the receiver's type in attribute text. It is
      // resolved here, once, so the call site matches receivers by type rather
      // than by the name a rendering happens to give them.
      if (let Option::SOME(targetPath) = Analyzer::Binder::extensionAttributeTarget(&f.metadata)) {
        let resolvedTarget: Analyzer::TypeId = resolvePath(state, defStore, typeStore, symbols, module, &scope, &targetPath);
        let mut voidRef: &mut Analyzer::TypeStore = typeStore;
        let voidId: Analyzer::TypeId = voidRef.intern(Analyzer::Type::VOID);

        if (resolvedTarget.raw() != voidId.raw()) {
          patchExtensionTarget(defStore, defId, resolvedTarget);
        }
      }
    }

    /// Resolve the alias body of a TypeAlias item and patch `TypeAliasDef.aliasedType`.
    ///
    /// Looks up the DefinitionId from pass-1/pass-2 output, resolves `a.value`
    /// via `resolveTypeNode` (with the alias's own type-param scope), then
    /// reconstructs the `TypeAliasDef` with `aliasedType` filled and replaces it.
    function resolveTypeAliasBody(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      a: &Ast::Item::TypeAlias,
    ): void {
      let defIdOpt: Option<Analyzer::DefinitionId> = lookupDef(pass1, pass2, itemId.raw());
      let Option::SOME(defId) = defIdOpt else {
        return;
      };

      if (Analyzer::Resolver::collectedAliasIndex(state, defId).isSome()) {
        Analyzer::Resolver::resolveCollectedAlias(state, defStore, typeStore, symbols, module, defId);
        return;
      }

      Analyzer::Resolver::resolveTypeAliasBodyOf(state, defStore, typeStore, symbols, module, defId, a);
    }

    /// The position of `defId` among the aliases the module declares.
    function collectedAliasIndex(
      state: &mut Analyzer::Resolver::ResolverState,
      defId: Analyzer::DefinitionId,
    ): Option<u64> {
      let mut index: u64 = 0;

      while (index < state.aliasDefs.length()) {
        if (let Option::SOME(candidate) = state.aliasDefs.get(index)) {
          if (candidate.raw() == defId.raw()) {
            return Option::SOME(index);
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    /// Resolve the body of an alias the module declares, once, under the
    /// namespace chain it is declared in. An alias already resolving is left
    /// as it is: its expansion reaches itself, and the instance stays.
    /// Aliases declared by another module are resolved with it already.
    function resolveCollectedAlias(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      defId: Analyzer::DefinitionId,
    ): void {
      let Option::SOME(index) = Analyzer::Resolver::collectedAliasIndex(state, defId) else {
        return;
      };

      let mut pending: boolean = false;
      if (let Option::SOME(status) = state.aliasStatuses.get(index)) {
        pending = *status == 0;
      }

      let mut itemIdOpt: Option<Ast::ItemId> = Option::NONE;
      if (let Option::SOME(itemRef) = state.aliasItems.get(index)) {
        itemIdOpt = Option::SOME(*itemRef);
      }

      let mut chain: Vector<String> = Vector::new<String>();
      if (let Option::SOME(declaredChain) = state.aliasChains.get(index)) {
        chain = Analyzer::Resolver::copyStringVector(declaredChain);
      }

      let Option::SOME(itemId) = itemIdOpt else {
        return;
      };

      if (!pending) {
        return;
      }

      let Option::SOME(node) = module.items.get(itemId) else {
        return;
      };

      let Ast::Item::Node::TypeAlias(a) = node else {
        return;
      };

      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      stateRef.aliasStatuses.set(index, 1);
      let savedChain: Vector<String> = Analyzer::Resolver::copyStringVector(&stateRef.namespaceChain);
      stateRef.namespaceChain = chain;

      // The alias body names resolve in this module even when the alias is
      // first written inside a copy of another module's trait default.
      let savedForeign: u64 = stateRef.activeForeign;
      stateRef.activeForeign = 0;

      Analyzer::Resolver::resolveTypeAliasBodyOf(state, defStore, typeStore, symbols, module, defId, &a);

      let mut restoreRef: &mut Analyzer::Resolver::ResolverState = state;
      restoreRef.namespaceChain = savedChain;
      restoreRef.activeForeign = savedForeign;
      restoreRef.aliasStatuses.set(index, 2);
    }

    /// Record every type alias `itemId` declares, recursing into namespaces,
    /// exports and externs like `resolveItem`.
    function collectAliasItems(
      state: &mut Analyzer::Resolver::ResolverState,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
    ): void {
      let Option::SOME(node) = module.items.get(itemId) else {
        return;
      };

      match (node) {
        Ast::Item::Node::TypeAlias(_) -> {
          let Option::SOME(defId) = lookupDef(pass1, pass2, itemId.raw()) else {
            return;
          };

          let chain: Vector<String> = Analyzer::Resolver::copyStringVector(&state.namespaceChain);
          let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
          stateRef.aliasDefs.push(defId);
          stateRef.aliasItems.push(itemId);
          stateRef.aliasChains.push(chain);
          stateRef.aliasStatuses.push(0);
        },
        Ast::Item::Node::Namespace(ns) -> {
          Analyzer::Resolver::collectAliasItemsIn(state, module, pass1, pass2, ns.name.clone(), &ns.items);
        },
        Ast::Item::Node::Extern(externItem) -> {
          Analyzer::Resolver::collectAliasItemsIn(state, module, pass1, pass2, externItem.name.clone(), &externItem.items);
        },
        Ast::Item::Node::Export(ex) -> {
          if (let Option::SOME(innerItemId) = ex.declaration) {
            Analyzer::Resolver::collectAliasItems(state, module, pass1, pass2, innerItemId);
          }
        },
        _ -> {},
      };
    }

    function collectAliasItemsIn(
      state: &mut Analyzer::Resolver::ResolverState,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      name: String,
      items: &Vector<Ast::ItemId>,
    ): void {
      let mut enterRef: &mut Analyzer::Resolver::ResolverState = state;
      enterRef.namespaceChain.push(name);

      let mut childIndex: u64 = 0;

      while (childIndex < items.length()) {
        if (let Option::SOME(childId) = items.get(childIndex)) {
          Analyzer::Resolver::collectAliasItems(state, module, pass1, pass2, *childId);
        }

        childIndex += 1;
      }

      let mut leaveRef: &mut Analyzer::Resolver::ResolverState = state;
      let _left: Option<String> = leaveRef.namespaceChain.pop();
    }

    function resolveTypeAliasBodyOf(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      defId: Analyzer::DefinitionId,
      a: &Ast::Item::TypeAlias,
    ): void {
      resolveBoundTraits(state, defStore, symbols, defId, &a.genericParameters);

      let scope: Analyzer::Resolver::TypeParamScope = buildTypeParamScope(typeStore, symbols, &a.genericParameters);
      let resolved: Analyzer::TypeId = resolveTypeNode(state, defStore, typeStore, symbols, module, &scope, a.value);

      let Option::SOME(existing) = defStore.get(defId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::TypeAlias(old) -> {
          let updated: Analyzer::TypeAliasDef = Analyzer::TypeAliasDef {
            name: old.name,
            visibility: old.visibility,
            typeParams: Analyzer::Resolver::copyDefinitionIdVector(&old.typeParams),
            aliasedType: resolved,
            typeId: old.typeId,
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(defId, Analyzer::Definition::TypeAlias(updated));
        },
        Analyzer::Definition::Record(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
        Analyzer::Definition::Enum(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
        Analyzer::Definition::Function(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
        Analyzer::Definition::Variable(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
        Analyzer::Definition::Field(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
        Analyzer::Definition::Variant(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
        Analyzer::Definition::TypeParam(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
        Analyzer::Definition::Trait(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
        Analyzer::Definition::Method(_) -> {
          @panic("resolveTypeAliasBody: invariant broken — expected TypeAlias at defId");
        },
      };
    }

    /// Resolve a Trait item's method signatures.
    ///
    /// Trait method signatures resolve with the trait's own type parameters and a
    /// `Self` entry mapped to VOID (no `Type::Trait` in this slice per ADR-C6).
    /// Required (body-less in source) trait methods resolve only their parameter
    /// and return-type annotations; default-method bodies are deferred to
    /// the body-resolution phase (PR5).
    function resolveTrait(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      t: &Ast::Item::Trait,
    ): void {
      let defIdOpt: Option<Analyzer::DefinitionId> = lookupDef(pass1, pass2, itemId.raw());
      let Option::SOME(defId) = defIdOpt else {
        return;
      };

      resolveBoundTraits(state, defStore, symbols, defId, &t.genericParameters);

      let scope: Analyzer::Resolver::TypeParamScope = buildTypeParamScope(typeStore, symbols, &t.genericParameters);

      // Inside a trait, `Self` is the abstract implementing type: a parameter
      // bounded by the trait itself, so a default body sees exactly the
      // methods the trait declares (`Typecheck::traitBoundOwnerFor`).
      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let selfSymbol: Analyzer::SymbolId = symbolsRef.intern("Self");
      let mut tsRef: &mut Analyzer::TypeStore = typeStore;
      let selfTypeId: Analyzer::TypeId = tsRef.param(selfSymbol);
      resolveOwnerMethodSignatures(state, defStore, typeStore, symbols, module, pass1, pass2, &t.methods, &scope, selfTypeId);
    }

    // =========================================================================
    // Top-level walk — buildGlobalNameIndex, resolveItem, resolveTypes.
    // =========================================================================

    /// Append `defId`, published under `path`, to the `sym` buckets of `index`
    /// and `paths`, unless the bucket already holds it: pass-1 and pass-2 can
    /// both list the same declaration.
    function appendNameCandidate(
      index: &mut HashMap<u32, Vector<Analyzer::DefinitionId>>,
      paths: &mut HashMap<u32, Vector<String>>,
      sym: Analyzer::SymbolId,
      defId: Analyzer::DefinitionId,
      path: String,
    ): void {
      let key: u32 = sym.raw();
      let mut indexRef: &mut HashMap<u32, Vector<Analyzer::DefinitionId>> = index;
      let mut pathsRef: &mut HashMap<u32, Vector<String>> = paths;

      if (let Option::SOME(bucket) = indexRef.getMut(&key)) {
        let mut position: u64 = 0;

        while (position < bucket.length()) {
          if (let Option::SOME(existing) = bucket.get(position)) {
            if (existing.raw() == defId.raw()) {
              return;
            }
          }
          position += 1;
        }

        let mut bucketRef: &mut Vector<Analyzer::DefinitionId> = bucket;
        bucketRef.push(defId);
      } else {
        let mut bucket: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
        bucket.push(defId);
        indexRef.insert(key, bucket);
        pathsRef.insert(key, Vector::new<String>());
      }

      let Option::SOME(pathBucket) = pathsRef.getMut(&key) else {
        return;
      };

      let mut pathBucketRef: &mut Vector<String> = pathBucket;
      pathBucketRef.push(path);
    }

    /// Index `defId` under `sym` with the path it is published under.
    function insertGlobalName(
      index: &mut HashMap<u32, Vector<Analyzer::DefinitionId>>,
      paths: &mut HashMap<u32, Vector<String>>,
      defStore: &mut Analyzer::DefinitionStore,
      sym: Analyzer::SymbolId,
      defId: Analyzer::DefinitionId,
    ): void {
      let mut path: String = String::create("");
      if (let Option::SOME(stored) = defStore.qualifiedNameOf(defId)) {
        path = stored.clone();
      }

      Analyzer::Resolver::appendNameCandidate(index, paths, sym, defId, path);
    }

    /// Populate `state.globalNameIndex` from one `BinderOutput`. Records and
    /// Enums only — these are the only types addressable as type names.
    ///
    /// Called twice (pass-1 then pass-2); a declaration both list is indexed once.
    function buildGlobalNameIndex(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      binderOutput: &Analyzer::Binder::BinderOutput,
    ): void {
      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      Analyzer::Resolver::indexGlobalNames(&mut stateRef.globalNameIndex, &mut stateRef.globalNamePaths, defStore, binderOutput);
    }

    /// `buildGlobalNameIndex` into the tables `names` and `paths`.
    function indexGlobalNames(
      names: &mut HashMap<u32, Vector<Analyzer::DefinitionId>>,
      paths: &mut HashMap<u32, Vector<String>>,
      defStore: &mut Analyzer::DefinitionStore,
      binderOutput: &Analyzer::Binder::BinderOutput,
    ): void {
      let mut index: u64 = 0;

      while (index < binderOutput.defIds.length()) {
        let Option::SOME(defId) = binderOutput.defIds.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(def) = defStore.get(*defId) else {
          index += 1;
          continue;
        };

        match (def) {
          Analyzer::Definition::Record(rec) -> {
            Analyzer::Resolver::insertGlobalName(names, paths, defStore, rec.name, *defId);
          },
          Analyzer::Definition::Enum(en) -> {
            Analyzer::Resolver::insertGlobalName(names, paths, defStore, en.name, *defId);
          },
          Analyzer::Definition::Function(_) -> {},
          Analyzer::Definition::Variable(_) -> {},
          Analyzer::Definition::Field(_) -> {},
          Analyzer::Definition::Variant(_) -> {},
          Analyzer::Definition::TypeParam(_) -> {},
          // Methods are owner-table-only (RecordDef/EnumDef method tables) and
          // are never addressable as type names — excluded from the flat index.
          Analyzer::Definition::Method(_) -> {},
          Analyzer::Definition::TypeAlias(alias) -> {
            Analyzer::Resolver::insertGlobalName(names, paths, defStore, alias.name, *defId);
          },
          Analyzer::Definition::Trait(trait_) -> {
            Analyzer::Resolver::insertGlobalName(names, paths, defStore, trait_.name, *defId);
          },
        };

        index += 1;
      }
    }

    /// The bare-name tables of the module at `modulePath`, bound as `pass1`
    /// and `pass2` and importing `overlay`.
    function foreignNamesOf(
      defStore: &mut Analyzer::DefinitionStore,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      overlay: &Analyzer::Imports::ImportOverlay,
      modulePath: String,
    ): Analyzer::Resolver::ForeignNames {
      let mut globalNameIndex: HashMap<u32, Vector<Analyzer::DefinitionId>> = HashMap::new<u32, Vector<Analyzer::DefinitionId>>();
      let mut globalNamePaths: HashMap<u32, Vector<String>> = HashMap::new<u32, Vector<String>>();
      let mut importNameIndex: HashMap<u32, Vector<Analyzer::DefinitionId>> = HashMap::new<u32, Vector<Analyzer::DefinitionId>>();
      let mut importNamePaths: HashMap<u32, Vector<String>> = HashMap::new<u32, Vector<String>>();

      Analyzer::Resolver::indexGlobalNames(&mut globalNameIndex, &mut globalNamePaths, defStore, pass1);
      Analyzer::Resolver::indexGlobalNames(&mut globalNameIndex, &mut globalNamePaths, defStore, pass2);
      Analyzer::Resolver::indexImportOverlay(&mut importNameIndex, &mut importNamePaths, overlay);

      return Analyzer::Resolver::ForeignNames {
        modulePath: modulePath,
        globalNameIndex: globalNameIndex,
        globalNamePaths: globalNamePaths,
        importNameIndex: importNameIndex,
        importNamePaths: importNamePaths,
      };
    }

    /// Reads the names of `methodItemId`, when it is a copy of a trait
    /// default, where the trait is declared: inside the trait's namespaces
    /// and, for a trait of another module, through that module's tables, so
    /// the reach rules judge a bare name from the trait's side. Returns the
    /// namespace chain `leaveInheritedScope` restores.
    function enterInheritedScope(
      state: &mut Analyzer::Resolver::ResolverState,
      module: &Ast::Module,
      methodItemId: Ast::ItemId,
    ): Option<Vector<String>> {
      let Option::SOME(scope) = module.inheritedScopeOf(methodItemId) else {
        return Option::NONE;
      };

      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      let saved: Vector<String> = Analyzer::Resolver::copyChain(&stateRef.namespaceChain);
      stateRef.namespaceChain = Analyzer::Resolver::copyChain(&scope.namespaces);

      if (let Option::SOME(sourcePath) = &scope.sourceModule) {
        let mut index: u64 = 0;

        while (index < stateRef.foreignNames.length()) {
          let mut matches: boolean = false;

          if (let Option::SOME(foreign) = stateRef.foreignNames.get(index)) {
            matches = foreign.modulePath.equals(sourcePath.toStr());
          }

          if (matches) {
            stateRef.activeForeign = index + 1;
            break;
          }

          index += 1;
        }
      }

      return Option::SOME(saved);
    }

    /// Undoes `enterInheritedScope`.
    function leaveInheritedScope(
      state: &mut Analyzer::Resolver::ResolverState,
      saved: Option<Vector<String>>,
    ): void {
      let Option::SOME(chain) = saved else {
        return;
      };

      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      stateRef.namespaceChain = chain;
      stateRef.activeForeign = 0;
    }

    /// Dispatch a single item to the appropriate resolver handler.
    ///
    /// Self-recursive for Namespace and Export. TypeAlias/Trait deferred (ADR-R6).
    function resolveItem(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
    ): void {
      let Option::SOME(node) = module.items.get(itemId) else {
        return;
      };

      match (node) {
        Ast::Item::Node::Record(r) -> {
          resolveRecord(state, defStore, typeStore, symbols, module, pass1, pass2, itemId, &r);
        },
        Ast::Item::Node::Enum(e) -> {
          resolveEnum(state, defStore, typeStore, symbols, module, pass1, pass2, itemId, &e);
        },
        Ast::Item::Node::Function(f) -> {
          resolveFunction(state, defStore, typeStore, symbols, module, pass1, pass2, itemId, &f);
        },
        Ast::Item::Node::Constant(c) -> {
          resolveConstant(state, defStore, typeStore, symbols, module, pass1, pass2, itemId, &c);
        },
        Ast::Item::Node::Namespace(ns) -> {
          let mut enterRef: &mut Analyzer::Resolver::ResolverState = state;
          enterRef.namespaceChain.push(ns.name.clone());

          let mut childIndex: u64 = 0;

          while (childIndex < ns.items.length()) {
            let Option::SOME(childId) = ns.items.get(childIndex) else {
              childIndex += 1;
              continue;
            };

            resolveItem(state, defStore, typeStore, symbols, module, pass1, pass2, *childId);
            childIndex += 1;
          }

          let mut leaveRef: &mut Analyzer::Resolver::ResolverState = state;
          let _left: Option<String> = leaveRef.namespaceChain.pop();
        },
        Ast::Item::Node::Export(ex) -> {
          if (let Option::SOME(innerItemId) = ex.declaration) {
            resolveItem(state, defStore, typeStore, symbols, module, pass1, pass2, innerItemId);
          }
        },
        Ast::Item::Node::TypeAlias(a) -> {
          resolveTypeAliasBody(state, defStore, typeStore, symbols, module, pass1, pass2, itemId, &a);
        },
        Ast::Item::Node::Trait(t) -> {
          resolveTrait(state, defStore, typeStore, symbols, module, pass1, pass2, itemId, &t);
        },
        Ast::Item::Node::Import(_) -> {},
        Ast::Item::Node::Extern(externItem) -> {
          // Extern signatures resolve like any other function's, or every
          // call through them would compare against VOID placeholders.
          let mut enterRef: &mut Analyzer::Resolver::ResolverState = state;
          enterRef.namespaceChain.push(externItem.name.clone());
          let mut externChildIndex: u64 = 0;

          while (externChildIndex < externItem.items.length()) {
            if (let Option::SOME(childId) = externItem.items.get(externChildIndex)) {
              resolveItem(state, defStore, typeStore, symbols, module, pass1, pass2, *childId);
            }
            externChildIndex += 1;
          }

          let mut leaveRef: &mut Analyzer::Resolver::ResolverState = state;
          let _left: Option<String> = leaveRef.namespaceChain.pop();
        },
      };
    }

    /// Whether `defIds` already holds `defId`.
    ///
    /// Takes `&mut` only because Ignis has no `&mut` to `&` reborrow: every
    /// caller holds the vector mutably.
    function containsDefinitionId(
      defIds: &mut Vector<Analyzer::DefinitionId>,
      defId: Analyzer::DefinitionId
    ): boolean {
      let mut index: u64 = 0;

      while (index < defIds.length()) {
        let Option::SOME(candidate) = defIds.get(index) else {
          index += 1;
          continue;
        };

        if (candidate.raw() == defId.raw()) {
          return true;
        }

        index += 1;
      }

      return false;
    }

    /// Follow the alias chain that starts at `aliasDefId`, pushing every alias
    /// definition it reaches into `visited`.
    ///
    /// Returns the alias the chain closes back on when it cycles, and NONE
    /// when the chain ends in a concrete type. Runs after the whole type walk,
    /// so every `TypeAliasDef.aliasedType` is already patched and the chase is
    /// independent of declaration order.
    function findAliasCycle(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      aliasDefId: Analyzer::DefinitionId,
      visited: &mut Vector<Analyzer::DefinitionId>,
    ): Option<Analyzer::DefinitionId> {
      let mut currentAlias: Analyzer::DefinitionId = aliasDefId;

      while (true) {
        if (containsDefinitionId(visited, currentAlias)) {
          return Option::SOME(currentAlias);
        }

        let mut visitedRef: &mut Vector<Analyzer::DefinitionId> = visited;
        visitedRef.push(currentAlias);

        let Option::SOME(def) = defStore.get(currentAlias) else {
          return Option::NONE;
        };

        let mut aliasedTypeOpt: Option<Analyzer::TypeId> = Option::NONE;

        match (def) {
          Analyzer::Definition::TypeAlias(alias) -> {
            aliasedTypeOpt = Option::SOME(alias.aliasedType);
          },
          _ -> {},
        };

        let Option::SOME(aliasedType) = aliasedTypeOpt else {
          return Option::NONE;
        };

        let Option::SOME(aliasedTypeNode) = typeStore.get(aliasedType) else {
          return Option::NONE;
        };

        let mut nextAliasOpt: Option<Analyzer::DefinitionId> = Option::NONE;

        match (aliasedTypeNode) {
          Analyzer::Type::Alias(nextAlias) -> {
            nextAliasOpt = Option::SOME(nextAlias);
          },
          _ -> {},
        };

        let Option::SOME(nextAlias) = nextAliasOpt else {
          return Option::NONE;
        };

        currentAlias = nextAlias;
      }

      return Option::NONE;
    }

    /// Report a cyclic alias declaration, naming the alias the chain closes
    /// back on at the span of the declaration the walk started from.
    ///
    /// Mirrors the Rust oracle's `typecheck_type_alias`, which reports one
    /// diagnostic per cycle: the alias whose resolution re-enters the
    /// in-progress set, spanned at the declaration that began the resolution.
    function emitCyclicTypeAliasDeclaration(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      span: SourceSpan,
      closingAlias: Analyzer::DefinitionId,
    ): void {
      let mut name: String = String::create("<alias>");

      if (let Option::SOME(def) = defStore.get(closingAlias)) {
        match (def) {
          Analyzer::Definition::TypeAlias(alias) -> {
            if (let Option::SOME(resolved) = symbols.resolve(alias.name)) {
              name = String::create(resolved);
            }
          },
          _ -> {},
        };
      }

      let message: String = `Type alias '${name.toStr()}' creates a cycle`;
      emitUndefinedType(state, span, DiagnosticCode::CYCLIC_TYPE_ALIAS, message.toStr());
    }

    /// Walk `itemId` looking for TypeAlias declarations whose alias chain
    /// cycles, recursing into namespaces and exports like `resolveItem`.
    ///
    /// `reported` carries every alias already implicated in a reported cycle,
    /// so each cycle yields exactly one diagnostic no matter how many
    /// declarations it runs through.
    function reportAliasCyclesInItem(
      state: &mut Analyzer::Resolver::ResolverState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      reported: &mut Vector<Analyzer::DefinitionId>,
      itemId: Ast::ItemId,
    ): void {
      let Option::SOME(node) = module.items.get(itemId) else {
        return;
      };

      match (node) {
        Ast::Item::Node::Namespace(ns) -> {
          let mut childIndex: u64 = 0;

          while (childIndex < ns.items.length()) {
            let Option::SOME(childId) = ns.items.get(childIndex) else {
              childIndex += 1;
              continue;
            };

            reportAliasCyclesInItem(state, defStore, typeStore, symbols, module, pass1, pass2, reported, *childId);
            childIndex += 1;
          }
        },
        Ast::Item::Node::Export(ex) -> {
          if (let Option::SOME(innerItemId) = ex.declaration) {
            reportAliasCyclesInItem(state, defStore, typeStore, symbols, module, pass1, pass2, reported, innerItemId);
          }
        },
        Ast::Item::Node::TypeAlias(a) -> {
          let Option::SOME(defId) = lookupDef(pass1, pass2, itemId.raw()) else {
            return;
          };

          if (containsDefinitionId(reported, defId)) {
            return;
          }

          let mut visited: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let closingOpt: Option<Analyzer::DefinitionId> = findAliasCycle(defStore, typeStore, defId, &mut visited);
          let Option::SOME(closingAlias) = closingOpt else {
            return;
          };

          emitCyclicTypeAliasDeclaration(state, defStore, symbols, a.span, closingAlias);

          let mut visitedIndex: u64 = 0;
          while (visitedIndex < visited.length()) {
            let Option::SOME(visitedAlias) = visited.get(visitedIndex) else {
              visitedIndex += 1;
              continue;
            };

            let mut reportedRef: &mut Vector<Analyzer::DefinitionId> = reported;
            reportedRef.push(*visitedAlias);
            visitedIndex += 1;
          }
        },
        _ -> {},
      };
    }

    /// Populate `state.importNameIndex` from the direct-import overlay, each
    /// entry with the path it is written as: empty for a name an import lists,
    /// `Ns::Name` for a member brought in with its namespace.
    function appendImportOverlayToState(
      state: &mut Analyzer::Resolver::ResolverState,
      overlay: &Analyzer::Imports::ImportOverlay,
    ): void {
      let mut stateRef: &mut Analyzer::Resolver::ResolverState = state;
      Analyzer::Resolver::indexImportOverlay(&mut stateRef.importNameIndex, &mut stateRef.importNamePaths, overlay);
    }

    /// `appendImportOverlayToState` into the tables `names` and `paths`.
    function indexImportOverlay(
      names: &mut HashMap<u32, Vector<Analyzer::DefinitionId>>,
      paths: &mut HashMap<u32, Vector<String>>,
      overlay: &Analyzer::Imports::ImportOverlay,
    ): void {
      let mut index: u64 = 0;

      while (index < overlay.syms.length()) {
        let Option::SOME(sym) = overlay.syms.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(defId) = overlay.defs.get(index) else {
          index += 1;
          continue;
        };

        let mut path: String = String::create("");
        if (let Option::SOME(stored) = overlay.qualifiedNames.get(index)) {
          path = stored.clone();
        }

        Analyzer::Resolver::appendNameCandidate(names, paths, *sym, *defId, path);
        index += 1;
      }
    }

    /// Resolve all type-syntax annotations in `module` against `defStore` and
    /// `typeStore`, patching Definitions in-place.
    ///
    /// Must be called after both `predeclareRoots` (pass-1) and `completeRoots`
    /// (pass-2). Returns a `ResolverOutput` with resolver-only diagnostics.
    function resolveTypesWithImports(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      overlay: &Analyzer::Imports::ImportOverlay,
      programIndex: &Analyzer::Imports::ProgramQualifiedIndex,
    ): Analyzer::Resolver::ResolverOutput {
      return Analyzer::Resolver::resolveTypesInProgram(
        defStore,
        typeStore,
        symbols,
        module,
        pass1,
        pass2,
        overlay,
        programIndex,
        Vector::new<Analyzer::Resolver::ForeignNames>(),
      );
    }

    /// `resolveTypesWithImports` for a module that holds copies of trait
    /// defaults other modules declare: `foreignNames` holds the bare-name
    /// tables of each of those modules, which the copies' signatures read.
    function resolveTypesInProgram(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      overlay: &Analyzer::Imports::ImportOverlay,
      programIndex: &Analyzer::Imports::ProgramQualifiedIndex,
      foreignNames: Vector<Analyzer::Resolver::ForeignNames>,
    ): Analyzer::Resolver::ResolverOutput {
      let mut state: Analyzer::Resolver::ResolverState = Analyzer::Resolver::ResolverState {
        diagnostics: DiagnosticBag::init(),
        globalNameIndex: HashMap::new<u32, Vector<Analyzer::DefinitionId>>(),
        importNameIndex: HashMap::new<u32, Vector<Analyzer::DefinitionId>>(),
        globalNamePaths: HashMap::new<u32, Vector<String>>(),
        importNamePaths: HashMap::new<u32, Vector<String>>(),
        programSyms: Vector::new<Analyzer::SymbolId>(),
        programDefs: Vector::new<Analyzer::DefinitionId>(),
        programQualifiedNames: Vector::new<String>(),
        namespaceChain: Vector::new<String>(),
        sendableParams: Vector::new<Analyzer::DefinitionId>(),
        sendableSpans: Vector::new<SourceSpan>(),
        sendableNames: Vector::new<String>(),
        aliasDefs: Vector::new<Analyzer::DefinitionId>(),
        aliasItems: Vector::new<Ast::ItemId>(),
        aliasChains: Vector::new<Vector<String>>(),
        aliasStatuses: Vector::new<u8>(),
        foreignNames: foreignNames,
        activeForeign: 0,
      };

      buildGlobalNameIndex(&mut state, defStore, pass1);
      buildGlobalNameIndex(&mut state, defStore, pass2);
      appendImportOverlayToState(&mut state, overlay);
      copyProgramQualifiedIndex(&mut state, programIndex);

      let mut aliasIndex: u64 = 0;

      while (aliasIndex < module.roots.length()) {
        if (let Option::SOME(itemId) = module.roots.get(aliasIndex)) {
          collectAliasItems(&mut state, module, pass1, pass2, *itemId);
        }

        aliasIndex += 1;
      }

      let mut index: u64 = 0;

      while (index < module.roots.length()) {
        let Option::SOME(itemId) = module.roots.get(index) else {
          index += 1;
          continue;
        };

        resolveItem(&mut state, defStore, typeStore, symbols, module, pass1, pass2, *itemId);
        index += 1;
      }

      // Alias cycles are only visible once every alias body is patched: a
      // two-hop cycle reaches an unresolved partner while the walk above is
      // still running.
      let mut reportedCycleAliases: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut cycleIndex: u64 = 0;

      while (cycleIndex < module.roots.length()) {
        let Option::SOME(itemId) = module.roots.get(cycleIndex) else {
          cycleIndex += 1;
          continue;
        };

        reportAliasCyclesInItem(
          &mut state,
          defStore,
          typeStore,
          symbols,
          module,
          pass1,
          pass2,
          &mut reportedCycleAliases,
          *itemId,
        );
        cycleIndex += 1;
      }

      checkSendableParameters(&mut state, defStore, typeStore);

      return Analyzer::Resolver::ResolverOutput { diagnostics: state.diagnostics };
    }

    function resolveTypes(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
    ): Analyzer::Resolver::ResolverOutput {
      let overlay: Analyzer::Imports::ImportOverlay = Analyzer::Imports::emptyOverlay();
      let programIndex: Analyzer::Imports::ProgramQualifiedIndex = Analyzer::Imports::emptyProgramQualifiedIndex();
      return Analyzer::Resolver::resolveTypesWithImports(
        defStore,
        typeStore,
        symbols,
        module,
        pass1,
        pass2,
        &overlay,
        &programIndex,
      );
    }
  }
}
