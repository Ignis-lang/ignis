import _ from "./ids";
import _ from "./types";
import _ from "./symbols";
import _ from "./definitions";
import _ from "./binder";
import _ from "./resolver";
import _ from "./resolver_bodies";
import _ from "./typecheck";
import _ from "./const_eval";
import _ from "./checks";
import _ from "./lint";
import _ from "./imports";

import Diagnostic, DiagnosticBag, NoteKind, SourceSpan from "@compiler::diagnostics";
import Id from "@compiler::ids";
import Ast from "@compiler::ast";

export namespace Analyzer {
  record AnalyzerOutput {
    public pass1: Analyzer::Binder::BinderOutput;
    public pass2: Analyzer::Binder::BinderOutput;
    public resolvedTypes: Analyzer::Resolver::ResolverOutput;
    public resolvedBodies: Analyzer::ResolverBodies::ResolverBodiesOutput;
    public typecheck: Analyzer::Typecheck::TypecheckOutput;
    public constValues: Analyzer::ConstEval::ConstEvalOutput;
    public checks: Analyzer::Checks::ChecksOutput;
    public lints: Analyzer::Lint::LintOutput;
    public diagnostics: DiagnosticBag;
  }

  record ModuleAnalysisRecord {
    public info: Analyzer::Imports::ModuleInfo;
    public direct: Analyzer::Imports::DirectDeclarationIndex;
    public imports: Analyzer::Imports::ImportOverlay;
    /// Owns the binder passes too (`output.pass1` / `output.pass2`).
    /// Duplicating them as record fields read the same moved value twice,
    /// which the runtime's drop check flags on first use after analysis.
    public output: Analyzer::AnalyzerOutput;
  }

  function importRecordIndexForSource(
    records: &Vector<Analyzer::ModuleAnalysisRecord>,
    source: &String,
  ): Option<u64> {
    let mut index: u64 = 0;

    while (index < records.length()) {
      let Option::SOME(analysisRecord) = records.get(index) else {
        index += 1;
        continue;
      };

      if (analysisRecord.info.pathText.equals(source.toStr())) {
        return Option::SOME(index);
      }

      index += 1;
    }

    return Option::NONE;
  }

  /// The module-vector position whose path equals `source`, from the info
  /// list — usable before any analysis record exists.
  function importModuleIndexForSource(
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
    source: &String,
  ): Option<u64> {
    let mut index: u64 = 0;

    while (index < infos.length()) {
      let Option::SOME(info) = infos.get(index) else {
        index += 1;
        continue;
      };

      if (info.pathText.equals(source.toStr())) {
        return Option::SOME(index);
      }

      index += 1;
    }

    return Option::NONE;
  }

  function buildImportOverlay(
    module: &Ast::Module,
    currentDirect: &Analyzer::Imports::DirectDeclarationIndex,
    directs: &Vector<Analyzer::Imports::DirectDeclarationIndex>,
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
    symbols: &mut Analyzer::SymbolTable,
    diagnostics: &mut DiagnosticBag,
  ): Analyzer::Imports::ImportOverlay {
    let mut overlay: Analyzer::Imports::ImportOverlay = Analyzer::Imports::emptyOverlay();
    let mut rootIndex: u64 = 0;
    let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;

    while (rootIndex < module.roots.length()) {
      let Option::SOME(rootId) = module.roots.get(rootIndex) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(item) = module.items.get(*rootId) else {
        rootIndex += 1;
        continue;
      };
      let Ast::Item::Node::Import(importItem) = item else {
        rootIndex += 1;
        continue;
      };

      let Option::SOME(recordIndex) = Analyzer::importModuleIndexForSource(infos, &importItem.source) else {
        Analyzer::Imports::appendImportSourceDiagnostic(
          diagnostics,
          importItem.source.toStr(),
          importItem.sourceSpan,
        );
        rootIndex += 1;
        continue;
      };
      let Option::SOME(targetDirect) = directs.get(recordIndex) else {
        rootIndex += 1;
        continue;
      };
      let targetModuleIndex: u64 = Analyzer::moduleInfoAt(infos, recordIndex).index;

      let mut bindingIndex: u64 = 0;
      while (bindingIndex < importItem.items.length()) {
        let Option::SOME(binding) = importItem.items.get(bindingIndex) else {
          bindingIndex += 1;
          continue;
        };

        if (binding.kind == Ast::ImportBindingKind::Discard) {
          // `import _` binds no name, but the corpus writes it to bring a
          // sibling part file in whole and refer to its declarations by
          // qualified path afterwards.
          Analyzer::appendDiscardImportedDeclarations(
            &mut overlay,
            currentDirect,
            targetDirect,
            binding.span,
            targetModuleIndex,
          );
          bindingIndex += 1;
          continue;
        }

        let Option::SOME(sourceNameText) = Ast::copyOptionalString(&binding.name) else {
          bindingIndex += 1;
          continue;
        };
        let localNameText: String = match (Ast::copyOptionalString(&binding.alias)) {
          Option::SOME(alias) -> alias,
          Option::NONE -> sourceNameText.clone(),
        };
        let sourceName: Analyzer::SymbolId = symbolsRef.intern(sourceNameText.toStr());
        let localName: Analyzer::SymbolId = symbolsRef.intern(localNameText.toStr());

        if (let Option::SOME(localSpan) = Analyzer::Imports::directIndexSpan(currentDirect, localName)) {
          Analyzer::Imports::appendImportConflictDiagnostic(
            diagnostics,
            localNameText.toStr(),
            binding.span,
            localSpan,
            "import conflicts with local declaration",
          );
          bindingIndex += 1;
          continue;
        }

        if (let Option::SOME(firstImportSpan) = Analyzer::Imports::overlaySpan(&overlay, localName)) {
          Analyzer::Imports::appendImportConflictDiagnostic(
            diagnostics,
            localNameText.toStr(),
            binding.span,
            firstImportSpan,
            "duplicate import binding here",
          );
          bindingIndex += 1;
          continue;
        }

        let Option::SOME(targetDef) = Analyzer::Imports::directIndexFind(targetDirect, sourceName) else {
          Analyzer::Imports::appendImportMissingDiagnostic(
            diagnostics,
            sourceNameText.toStr(),
            importItem.source.toStr(),
            binding.span,
          );
          bindingIndex += 1;
          continue;
        };

        Analyzer::Imports::appendOverlayEntry(
          &mut overlay,
          localName,
          targetDef,
          binding.span,
          targetModuleIndex,
        );

        // Importing a namespace brings what it declares: the corpus writes
        // `Ast::Item::Node::Function` after importing `Ast`, and the member is
        // never listed on the import line. Each member carries the path it is
        // written as, so the five declarations named `Node` stay apart.
        Analyzer::appendNamespaceMembers(
          &mut overlay,
          currentDirect,
          targetDirect,
          sourceNameText.toStr(),
          localNameText.toStr(),
          binding.span,
          targetModuleIndex,
        );
        bindingIndex += 1;
      }

      rootIndex += 1;
    }

    Analyzer::seedNamedReExportOverlay(&mut overlay, module, currentDirect, directs, infos);

    return overlay;
  }

  /// Add every declaration the imported namespace `sourceName` contains.
  ///
  /// A member is recognised by its path starting with `sourceName::`, and is
  /// rewritten to start with the local name so an aliased import reads the way
  /// it was written. Names the importing module declares itself are left alone.
  /// Re-export what `import _ from "..."` pulls in.
  ///
  /// The corpus splits one namespace across files and gathers them in an
  /// aggregate module that imports each part with a discarded binding and
  /// declares nothing itself. Everyone imports the aggregate, so unless the
  /// parts pass through it, none of them is ever reachable.
  function appendReExportedDeclarations(
    direct: &mut Analyzer::Imports::DirectDeclarationIndex,
    module: &Ast::Module,
    directs: &Vector<Analyzer::Imports::DirectDeclarationIndex>,
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
  ): void {
    let mut rootIndex: u64 = 0;

    while (rootIndex < module.roots.length()) {
      let Option::SOME(rootId) = module.roots.get(rootIndex) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(item) = module.items.get(*rootId) else {
        rootIndex += 1;
        continue;
      };
      let Ast::Item::Node::Import(importItem) = item else {
        rootIndex += 1;
        continue;
      };

      if (!Analyzer::importDiscardsItsBindings(&importItem)) {
        rootIndex += 1;
        continue;
      }

      let Option::SOME(recordIndex) = Analyzer::importModuleIndexForSource(infos, &importItem.source) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(targetDirect) = directs.get(recordIndex) else {
        rootIndex += 1;
        continue;
      };

      let mut declIndex: u64 = 0;

      while (declIndex < targetDirect.syms.length()) {
        let Option::SOME(name) = targetDirect.syms.get(declIndex) else {
          declIndex += 1;
          continue;
        };
        let Option::SOME(defId) = targetDirect.defs.get(declIndex) else {
          declIndex += 1;
          continue;
        };
        let Option::SOME(span) = targetDirect.spans.get(declIndex) else {
          declIndex += 1;
          continue;
        };

        let mut qualifiedName: String = String::create("");
        if (let Option::SOME(stored) = targetDirect.qualifiedNames.get(declIndex)) {
          qualifiedName = stored.clone();
        }

        Analyzer::Imports::appendDirectIndexEntryIfMissing(direct, *name, *defId, *span, qualifiedName);
        declIndex += 1;
      }

      rootIndex += 1;
    }
  }

  /// Whether every binding an import writes is discarded, which is how the
  /// corpus spells "bring this module in whole".
  /// Stamp each published declaration's written path onto the definition
  /// store, so phases without the program index (typecheck's local-annotation
  /// resolution) can still pick between same-named declarations by path.
  function recordQualifiedNamesInDefStore(
    defStore: &mut Analyzer::DefinitionStore,
    direct: &Analyzer::Imports::DirectDeclarationIndex,
    moduleIndex: u64,
  ): void {
    let mut declIndex: u64 = 0;

    while (declIndex < direct.syms.length()) {
      let Option::SOME(defId) = direct.defs.get(declIndex) else {
        declIndex += 1;
        continue;
      };
      let Option::SOME(qualifiedName) = direct.qualifiedNames.get(declIndex) else {
        declIndex += 1;
        continue;
      };

      if (qualifiedName.length() > 0) {
        let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
        defsRef.setQualifiedName(*defId, qualifiedName.clone());
      }

      let mut defsModuleRef: &mut Analyzer::DefinitionStore = defStore;
      defsModuleRef.setDefModule(*defId, moduleIndex);

      declIndex += 1;
    }
  }

  /// Re-publish what `export Name from "path"` names: the declaration itself
  /// and, when it is a namespace, everything written under `Name::`.
  function appendNamedReExports(
    direct: &mut Analyzer::Imports::DirectDeclarationIndex,
    module: &Ast::Module,
    directs: &Vector<Analyzer::Imports::DirectDeclarationIndex>,
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
  ): void {
    let mut rootIndex: u64 = 0;

    while (rootIndex < module.roots.length()) {
      let Option::SOME(rootId) = module.roots.get(rootIndex) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(item) = module.items.get(*rootId) else {
        rootIndex += 1;
        continue;
      };
      let Ast::Item::Node::Export(exportItem) = item else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(sourceText) = Ast::copyOptionalString(&exportItem.source) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(recordIndex) = Analyzer::importModuleIndexForSource(infos, &sourceText) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(targetDirect) = directs.get(recordIndex) else {
        rootIndex += 1;
        continue;
      };

      let mut bindingIndex: u64 = 0;
      while (bindingIndex < exportItem.items.length()) {
        let Option::SOME(binding) = exportItem.items.get(bindingIndex) else {
          bindingIndex += 1;
          continue;
        };
        let Option::SOME(nameText) = Ast::copyOptionalString(&binding.name) else {
          bindingIndex += 1;
          continue;
        };

        let prefix: String = `${nameText.toStr()}::`;
        let mut declIndex: u64 = 0;

        while (declIndex < targetDirect.qualifiedNames.length()) {
          let Option::SOME(qualifiedName) = targetDirect.qualifiedNames.get(declIndex) else {
            declIndex += 1;
            continue;
          };

          let matchesName: boolean = qualifiedName.equals(nameText.toStr()) || qualifiedName.startsWith(prefix.toStr());

          if (!matchesName) {
            declIndex += 1;
            continue;
          }

          let Option::SOME(sym) = targetDirect.syms.get(declIndex) else {
            declIndex += 1;
            continue;
          };
          let Option::SOME(defId) = targetDirect.defs.get(declIndex) else {
            declIndex += 1;
            continue;
          };
          let Option::SOME(span) = targetDirect.spans.get(declIndex) else {
            declIndex += 1;
            continue;
          };

          Analyzer::Imports::appendDirectIndexEntryIfMissing(direct, *sym, *defId, *span, qualifiedName.clone());
          declIndex += 1;
        }

        bindingIndex += 1;
      }

      rootIndex += 1;
    }
  }

  /// Feed one module's declarations into the program-wide qualified index.
  function appendDirectToProgramIndex(
    programIndex: &mut Analyzer::Imports::ProgramQualifiedIndex,
    direct: &Analyzer::Imports::DirectDeclarationIndex,
  ): void {
    let mut declIndex: u64 = 0;

    while (declIndex < direct.syms.length()) {
      let Option::SOME(sym) = direct.syms.get(declIndex) else {
        declIndex += 1;
        continue;
      };
      let Option::SOME(defId) = direct.defs.get(declIndex) else {
        declIndex += 1;
        continue;
      };
      let Option::SOME(qualifiedName) = direct.qualifiedNames.get(declIndex) else {
        declIndex += 1;
        continue;
      };

      Analyzer::Imports::appendProgramQualifiedEntry(programIndex, *sym, *defId, qualifiedName.clone());
      declIndex += 1;
    }
  }

  function importDiscardsItsBindings(importItem: &Ast::Item::Import): boolean {
    if (importItem.items.isEmpty()) {
      return false;
    }

    let mut index: u64 = 0;

    while (index < importItem.items.length()) {
      let Option::SOME(binding) = importItem.items.get(index) else {
        return false;
      };

      if (binding.kind != Ast::ImportBindingKind::Discard) {
        return false;
      }

      index += 1;
    }

    return true;
  }

  /// Bring every declaration of a discard-imported module into the overlay.
  ///
  /// Each entry keeps the path it is written as in the target, so a qualified
  /// reference like `Analyzer::Definition` still tells apart declarations that
  /// share a bare name. Names the importing module declares itself are left
  /// alone, and an entry already brought in (same name, same written path) is
  /// not repeated.
  function appendDiscardImportedDeclarations(
    overlay: &mut Analyzer::Imports::ImportOverlay,
    currentDirect: &Analyzer::Imports::DirectDeclarationIndex,
    targetDirect: &Analyzer::Imports::DirectDeclarationIndex,
    importSpan: SourceSpan,
    targetModule: u64,
  ): void {
    let mut index: u64 = 0;

    while (index < targetDirect.syms.length()) {
      let Option::SOME(memberSym) = targetDirect.syms.get(index) else {
        index += 1;
        continue;
      };
      let Option::SOME(memberDef) = targetDirect.defs.get(index) else {
        index += 1;
        continue;
      };

      if (Analyzer::Imports::directIndexSpan(currentDirect, *memberSym).isSome()) {
        index += 1;
        continue;
      }

      let mut qualifiedName: String = String::create("");
      if (let Option::SOME(stored) = targetDirect.qualifiedNames.get(index)) {
        qualifiedName = stored.clone();
      }

      if (Analyzer::overlayHasQualifiedEntry(overlay, *memberSym, &qualifiedName)) {
        index += 1;
        continue;
      }

      Analyzer::Imports::appendQualifiedOverlayEntry(
        overlay,
        *memberSym,
        *memberDef,
        importSpan,
        targetModule,
        qualifiedName.clone(),
        true,
      );
      index += 1;
    }
  }

  /// Bind locally what `export Name from "path"` re-publishes.
  ///
  /// The re-exporting module names the declaration itself — `std/toml/mod.ign`
  /// re-exports `TomlDocument` and then writes it in its own signatures — so
  /// the re-export has to seed the overlay the same way an import would.
  /// Entries are implicit: no import line names them, so the unused-import
  /// lint has nothing to report.
  function seedNamedReExportOverlay(
    overlay: &mut Analyzer::Imports::ImportOverlay,
    module: &Ast::Module,
    currentDirect: &Analyzer::Imports::DirectDeclarationIndex,
    directs: &Vector<Analyzer::Imports::DirectDeclarationIndex>,
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
  ): void {
    let mut rootIndex: u64 = 0;

    while (rootIndex < module.roots.length()) {
      let Option::SOME(rootId) = module.roots.get(rootIndex) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(item) = module.items.get(*rootId) else {
        rootIndex += 1;
        continue;
      };
      let Ast::Item::Node::Export(exportItem) = item else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(sourceText) = Ast::copyOptionalString(&exportItem.source) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(recordIndex) = Analyzer::importModuleIndexForSource(infos, &sourceText) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(targetDirect) = directs.get(recordIndex) else {
        rootIndex += 1;
        continue;
      };
      let targetModuleIndex: u64 = Analyzer::moduleInfoAt(infos, recordIndex).index;

      let mut bindingIndex: u64 = 0;
      while (bindingIndex < exportItem.items.length()) {
        let Option::SOME(binding) = exportItem.items.get(bindingIndex) else {
          bindingIndex += 1;
          continue;
        };
        let Option::SOME(nameText) = Ast::copyOptionalString(&binding.name) else {
          bindingIndex += 1;
          continue;
        };

        let prefix: String = `${nameText.toStr()}::`;
        let mut declIndex: u64 = 0;

        while (declIndex < targetDirect.qualifiedNames.length()) {
          let Option::SOME(qualifiedName) = targetDirect.qualifiedNames.get(declIndex) else {
            declIndex += 1;
            continue;
          };

          let matchesName: boolean = qualifiedName.equals(nameText.toStr()) || qualifiedName.startsWith(prefix.toStr());

          if (!matchesName) {
            declIndex += 1;
            continue;
          }

          let Option::SOME(memberSym) = targetDirect.syms.get(declIndex) else {
            declIndex += 1;
            continue;
          };
          let Option::SOME(memberDef) = targetDirect.defs.get(declIndex) else {
            declIndex += 1;
            continue;
          };

          if (Analyzer::Imports::directIndexSpan(currentDirect, *memberSym).isSome()) {
            declIndex += 1;
            continue;
          }

          if (Analyzer::overlayHasQualifiedEntry(overlay, *memberSym, qualifiedName)) {
            declIndex += 1;
            continue;
          }

          Analyzer::Imports::appendQualifiedOverlayEntry(
            overlay,
            *memberSym,
            *memberDef,
            binding.span,
            targetModuleIndex,
            qualifiedName.clone(),
            true,
          );
          declIndex += 1;
        }

        bindingIndex += 1;
      }

      rootIndex += 1;
    }
  }

  /// Whether the overlay already carries an entry with this name and written
  /// path, which is what repeating a discard import of the same module would
  /// produce.
  function overlayHasQualifiedEntry(
    overlay: &mut Analyzer::Imports::ImportOverlay,
    name: Analyzer::SymbolId,
    qualifiedName: &String,
  ): boolean {
    let mut index: u64 = 0;

    while (index < overlay.syms.length()) {
      let Option::SOME(candidate) = overlay.syms.get(index) else {
        index += 1;
        continue;
      };

      if (candidate.raw() != name.raw()) {
        index += 1;
        continue;
      }

      let Option::SOME(storedQualified) = overlay.qualifiedNames.get(index) else {
        index += 1;
        continue;
      };

      if (storedQualified.equals(qualifiedName.toStr())) {
        return true;
      }

      index += 1;
    }

    return false;
  }

  function appendNamespaceMembers(
    overlay: &mut Analyzer::Imports::ImportOverlay,
    currentDirect: &Analyzer::Imports::DirectDeclarationIndex,
    targetDirect: &Analyzer::Imports::DirectDeclarationIndex,
    sourceName: str,
    localName: str,
    importSpan: SourceSpan,
    targetModule: u64,
  ): void {
    let prefix: String = `${sourceName}::`;
    let mut index: u64 = 0;

    while (index < targetDirect.qualifiedNames.length()) {
      let Option::SOME(qualifiedName) = targetDirect.qualifiedNames.get(index) else {
        index += 1;
        continue;
      };

      if (!qualifiedName.startsWith(prefix.toStr())) {
        index += 1;
        continue;
      }

      let Option::SOME(memberSym) = targetDirect.syms.get(index) else {
        index += 1;
        continue;
      };
      let Option::SOME(memberDef) = targetDirect.defs.get(index) else {
        index += 1;
        continue;
      };

      if (Analyzer::Imports::directIndexSpan(currentDirect, *memberSym).isSome()) {
        index += 1;
        continue;
      }

      let suffix: String = qualifiedName.substringBytes(prefix.length(), qualifiedName.length());
      let localPath: String = `${localName}::${suffix.toStr()}`;

      Analyzer::Imports::appendQualifiedOverlayEntry(
        overlay,
        *memberSym,
        *memberDef,
        importSpan,
        targetModule,
        localPath,
        true,
      );
      index += 1;
    }
  }

  function copyDiagnostic(source: &Diagnostic): Diagnostic {
    let mut copy: Diagnostic = Diagnostic::new(
      source.severity,
      source.code,
      source.messageText(),
      source.primarySpan,
    );

    let mut labelIndex: u64 = 0;
    while (labelIndex < source.labels.length()) {
      let Option::SOME(label) = source.labels.get(labelIndex) else {
        labelIndex += 1;
        continue;
      };

      copy.addLabel(label.kind, label.span, label.messageText());
      labelIndex += 1;
    }

    let mut noteIndex: u64 = 0;
    while (noteIndex < source.notes.length()) {
      let Option::SOME(note) = source.notes.get(noteIndex) else {
        noteIndex += 1;
        continue;
      };

      match (note.kind) {
        NoteKind::NOTE -> copy.addNote(note.messageText()),
        NoteKind::HELP -> copy.setHelp(note.messageText()),
      };

      noteIndex += 1;
    }

    if (let Option::SOME(help) = source.helpText()) {
      copy.setHelp(help);
    }

    return copy;
  }

  function appendDiagnostics(target: &mut DiagnosticBag, source: &DiagnosticBag): void {
    let mut index: u64 = 0;
    let mut targetRef: &mut DiagnosticBag = target;

    while (index < source.length()) {
      let Option::SOME(diagnostic) = source.get(index) else {
        index += 1;
        continue;
      };

      targetRef.push(Analyzer::copyDiagnostic(diagnostic));
      index += 1;
    }
  }

  /// Whether `rawId` names an item another module can refer to.
  ///
  /// A root, the declaration an `export` wraps, or anything declared inside a
  /// namespace at any depth: the corpus writes `Ast::Expression::Node` and
  /// means the `Node` declared two namespaces deep, so the index has to carry
  /// it. The qualifier is not validated here, the same debt the resolvers
  /// already carry for the segments before the last.
  function moduleHasRootItemRaw(module: &Ast::Module, rawId: u32): boolean {
    let mut index: u64 = 0;

    while (index < module.roots.length()) {
      let Option::SOME(rootId) = module.roots.get(index) else {
        index += 1;
        continue;
      };

      if (rootId.raw() == rawId) {
        return true;
      }

      if (Analyzer::itemContainsDeclarationRaw(module, *rootId, rawId, 0)) {
        return true;
      }

      index += 1;
    }

    return false;
  }

  /// Whether `rawId` is declared inside `itemId`, following namespace and
  /// export nesting. `depth` guards against a malformed tree pointing at
  /// itself; the corpus nests three deep at most.
  function itemContainsDeclarationRaw(
    module: &Ast::Module,
    itemId: Ast::ItemId,
    rawId: u32,
    depth: u64,
  ): boolean {
    if (depth > 16) {
      return false;
    }

    let Option::SOME(item) = module.items.get(itemId) else {
      return false;
    };

    match (item) {
      Ast::Item::Node::Export(exported) -> {
        let Option::SOME(innerItemId) = exported.declaration else {
          return false;
        };

        if (innerItemId.raw() == rawId) {
          return true;
        }

        return Analyzer::itemContainsDeclarationRaw(module, innerItemId, rawId, depth + 1);
      },
      Ast::Item::Node::Extern(externItem) -> {
        let mut externChildIndex: u64 = 0;

        while (externChildIndex < externItem.items.length()) {
          let Option::SOME(childId) = externItem.items.get(externChildIndex) else {
            externChildIndex += 1;
            continue;
          };

          if (childId.raw() == rawId) {
            return true;
          }

          if (Analyzer::itemContainsDeclarationRaw(module, *childId, rawId, depth + 1)) {
            return true;
          }

          externChildIndex += 1;
        }

        return false;
      },
      Ast::Item::Node::Namespace(namespaceItem) -> {
        let mut childIndex: u64 = 0;

        while (childIndex < namespaceItem.items.length()) {
          let Option::SOME(childId) = namespaceItem.items.get(childIndex) else {
            childIndex += 1;
            continue;
          };

          if (childId.raw() == rawId) {
            return true;
          }

          if (Analyzer::itemContainsDeclarationRaw(module, *childId, rawId, depth + 1)) {
            return true;
          }

          childIndex += 1;
        }

        return false;
      },
      _ -> {
        return false;
      },
    };

    @panic("unreachable: itemContainsDeclarationRaw match did not return");
  }

  function itemSpanOrEmpty(module: &Ast::Module, rawId: u32): SourceSpan {
    let itemId: Ast::ItemId = Id::fromRaw<Ast::ItemTag>(rawId);
    let Option::SOME(item) = module.items.get(itemId) else {
      return SourceSpan::new("", 0, 0);
    };

    return match (item) {
      Ast::Item::Node::Function(f) -> f.span,
      Ast::Item::Node::Record(r) -> r.span,
      Ast::Item::Node::Enum(e) -> e.span,
      Ast::Item::Node::Namespace(n) -> n.span,
      Ast::Item::Node::Import(i) -> i.span,
      Ast::Item::Node::Extern(e) -> e.span,
      Ast::Item::Node::Constant(c) -> c.span,
      Ast::Item::Node::Export(e) -> e.span,
      Ast::Item::Node::TypeAlias(a) -> a.span,
      Ast::Item::Node::Trait(t) -> t.span,
    };
  }

  /// The path a declaration is written as inside its module, `Outer::Inner::Name`.
  ///
  /// Built by walking the roots and remembering the namespaces entered on the
  /// way, which is the only place that nesting is recorded once the binder has
  /// flattened its outputs.
  function qualifiedNameForItemRaw(module: &Ast::Module, rawId: u32): String {
    let mut index: u64 = 0;

    while (index < module.roots.length()) {
      let Option::SOME(rootId) = module.roots.get(index) else {
        index += 1;
        continue;
      };

      let prefix: String = String::create("");
      if (let Option::SOME(found) = Analyzer::qualifiedNameWithin(module, *rootId, rawId, &prefix, 0)) {
        return found;
      }

      index += 1;
    }

    return String::create("");
  }

  /// The path to `rawId` inside `itemId`, given the prefix already walked.
  function qualifiedNameWithin(
    module: &Ast::Module,
    itemId: Ast::ItemId,
    rawId: u32,
    prefix: &String,
    depth: u64,
  ): Option<String> {
    if (depth > 16) {
      return Option::NONE;
    }

    let Option::SOME(item) = module.items.get(itemId) else {
      return Option::NONE;
    };

    let ownName: String = Analyzer::itemDeclaredName(item);

    let mut ownPath: String = ownName.clone();
    if (prefix.length() > 0) {
      ownPath = `${prefix.toStr()}::${ownName.toStr()}`;
    }

    if (itemId.raw() == rawId) {
      return Option::SOME(ownPath);
    }

    match (item) {
      Ast::Item::Node::Namespace(namespaceItem) -> {
        let mut childIndex: u64 = 0;

        while (childIndex < namespaceItem.items.length()) {
          if (let Option::SOME(childId) = namespaceItem.items.get(childIndex)) {
            if (let Option::SOME(found) = Analyzer::qualifiedNameWithin(module, *childId, rawId, &ownPath, depth + 1)) {
              return Option::SOME(found);
            }
          }

          childIndex += 1;
        }

        return Option::NONE;
      },
      Ast::Item::Node::Export(exported) -> {
        let Option::SOME(innerItemId) = exported.declaration else {
          return Option::NONE;
        };

        return Analyzer::qualifiedNameWithin(module, innerItemId, rawId, prefix, depth + 1);
      },
      Ast::Item::Node::Extern(externItem) -> {
        let mut externChildIndex: u64 = 0;

        while (externChildIndex < externItem.items.length()) {
          if (let Option::SOME(childId) = externItem.items.get(externChildIndex)) {
            if (let Option::SOME(found) = Analyzer::qualifiedNameWithin(module, *childId, rawId, &ownPath, depth + 1)) {
              return Option::SOME(found);
            }
          }

          externChildIndex += 1;
        }

        return Option::NONE;
      },
      _ -> {
        return Option::NONE;
      },
    };

    @panic("unreachable: qualifiedNameWithin match did not return");
  }

  /// The name a declaration item carries, or the empty string for the wrappers
  /// that declare nothing of their own.
  function itemDeclaredName(item: &Ast::Item::Node): String {
    return match (item) {
      Ast::Item::Node::Function(f) -> f.name.clone(),
      Ast::Item::Node::Record(r) -> r.name.clone(),
      Ast::Item::Node::Enum(e) -> e.name.clone(),
      Ast::Item::Node::Namespace(n) -> n.name.clone(),
      Ast::Item::Node::Constant(c) -> c.name.clone(),
      Ast::Item::Node::TypeAlias(a) -> a.name.clone(),
      Ast::Item::Node::Trait(t) -> t.name.clone(),
      Ast::Item::Node::Extern(e) -> e.name.clone(),
      Ast::Item::Node::Import(_) -> String::create(""),
      Ast::Item::Node::Export(_) -> String::create(""),
    };
  }

  function directIndexAppendOutput(
    direct: &mut Analyzer::Imports::DirectDeclarationIndex,
    defStore: &mut Analyzer::DefinitionStore,
    module: &Ast::Module,
    output: &Analyzer::Binder::BinderOutput,
  ): void {
    let mut index: u64 = 0;

    while (index < output.defIds.length()) {
      let Option::SOME(rawId) = output.nodeIds.get(index) else {
        index += 1;
        continue;
      };
      if (!Analyzer::moduleHasRootItemRaw(module, *rawId)) {
        index += 1;
        continue;
      }

      let Option::SOME(defId) = output.defIds.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(definition) = defStore.get(*defId) else {
        index += 1;
        continue;
      };

      Analyzer::Imports::appendDirectIndexEntryIfMissing(
        direct,
        definition.name(),
        *defId,
        Analyzer::itemSpanOrEmpty(module, *rawId),
        Analyzer::qualifiedNameForItemRaw(module, *rawId),
      );
      index += 1;
    }
  }

  /// Every declaration a module can name without writing a qualified path:
  /// what it declares or re-exports, plus what its imports bind.
  function moduleVisibleDefinitions(
    direct: &Analyzer::Imports::DirectDeclarationIndex,
    overlay: &Analyzer::Imports::ImportOverlay,
  ): Vector<Analyzer::DefinitionId> {
    let mut visible: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut index: u64 = 0;

    while (index < direct.defs.length()) {
      if (let Option::SOME(defId) = direct.defs.get(index)) {
        visible.push(*defId);
      }

      index += 1;
    }

    let mut overlayIndex: u64 = 0;

    while (overlayIndex < overlay.defs.length()) {
      if (let Option::SOME(defId) = overlay.defs.get(overlayIndex)) {
        visible.push(*defId);
      }

      overlayIndex += 1;
    }

    return visible;
  }

  function buildDirectDeclarationIndex(
    defStore: &mut Analyzer::DefinitionStore,
    module: &Ast::Module,
    pass1: &Analyzer::Binder::BinderOutput,
    pass2: &Analyzer::Binder::BinderOutput,
  ): Analyzer::Imports::DirectDeclarationIndex {
    let mut direct: Analyzer::Imports::DirectDeclarationIndex = Analyzer::Imports::emptyDirectDeclarationIndex();
    Analyzer::directIndexAppendOutput(&mut direct, defStore, module, pass1);
    Analyzer::directIndexAppendOutput(&mut direct, defStore, module, pass2);
    return direct;
  }

  function analyzeModuleWithImports(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    overlay: &Analyzer::Imports::ImportOverlay,
  ): Analyzer::AnalyzerOutput {
    let pass1: Analyzer::Binder::BinderOutput = Analyzer::Binder::predeclareRoots(
      &module.roots,
      defStore,
      typeStore,
      symbols,
      module,
    );

    let pass2: Analyzer::Binder::BinderOutput = Analyzer::Binder::completeRoots(
      &module.roots,
      defStore,
      typeStore,
      symbols,
      module,
      &pass1,
    );

    // Same stamping the program path performs, so overload sets — which are
    // keyed by published written path — exist in single-module analysis too.
    let stampDirect: Analyzer::Imports::DirectDeclarationIndex = Analyzer::buildDirectDeclarationIndex(
      defStore,
      module,
      &pass1,
      &pass2,
    );
    Analyzer::recordQualifiedNamesInDefStore(defStore, &stampDirect, 0);

    let emptyProgramIndex: Analyzer::Imports::ProgramQualifiedIndex = Analyzer::Imports::emptyProgramQualifiedIndex();

    let resolvedTypes: Analyzer::Resolver::ResolverOutput = Analyzer::Resolver::resolveTypesWithImports(
      defStore,
      typeStore,
      symbols,
      module,
      &pass1,
      &pass2,
      overlay,
      &emptyProgramIndex,
    );

    let resolvedBodies: Analyzer::ResolverBodies::ResolverBodiesOutput = Analyzer::ResolverBodies::resolveBodiesWithImports(
      defStore,
      typeStore,
      symbols,
      module,
      &pass1,
      &pass2,
      overlay,
      &emptyProgramIndex,
    );

    let typecheck: Analyzer::Typecheck::TypecheckOutput = Analyzer::Typecheck::checkModule(
      defStore,
      typeStore,
      symbols,
      module,
      &pass1,
      &pass2,
      &resolvedTypes,
      &resolvedBodies,
    );

    let constValues: Analyzer::ConstEval::ConstEvalOutput = Analyzer::ConstEval::evalModule(
      defStore,
      typeStore,
      module,
      &pass1,
      &pass2,
      &resolvedBodies,
      &typecheck,
    );

    let checks: Analyzer::Checks::ChecksOutput = Analyzer::Checks::checkModule(
      defStore,
      typeStore,
      module,
      &pass1,
      &pass2,
      &typecheck,
    );

    let lints: Analyzer::Lint::LintOutput = Analyzer::Lint::lintModule(
      defStore,
      symbols,
      module,
      &resolvedBodies,
      &typecheck,
      overlay,
    );

    let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
    Analyzer::appendDiagnostics(&mut diagnostics, &pass1.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &pass2.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &resolvedTypes.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &resolvedBodies.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &typecheck.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &constValues.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &checks.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &lints.diagnostics);

    return Analyzer::AnalyzerOutput {
      pass1: pass1,
      pass2: pass2,
      resolvedTypes: resolvedTypes,
      resolvedBodies: resolvedBodies,
      typecheck: typecheck,
      constValues: constValues,
      checks: checks,
      lints: lints,
      diagnostics: diagnostics,
    };
  }

  function analyzeModule(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
  ): Analyzer::AnalyzerOutput {
    let overlay: Analyzer::Imports::ImportOverlay = Analyzer::Imports::emptyOverlay();
    return Analyzer::analyzeModuleWithImports(
      defStore,
      typeStore,
      symbols,
      module,
      &overlay,
    );
  }

  function moduleInfoAt(
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
    index: u64,
  ): Analyzer::Imports::ModuleInfo {
    if (let Option::SOME(info) = infos.get(index)) {
      return Analyzer::Imports::ModuleInfo {
        index: info.index,
        pathText: info.pathText.clone(),
        kind: info.kind,
      };
    }

    return Analyzer::Imports::ModuleInfo {
      index: index,
      pathText: String::create(""),
      kind: Analyzer::Imports::ModuleKind::PROJECT,
    };
  }

  /// Whether `pathText` names one of the auto-loaded prelude modules.
  function isPreludePath(preludePaths: &Vector<String>, pathText: &String): boolean {
    let mut index: u64 = 0;

    while (index < preludePaths.length()) {
      if (let Option::SOME(candidate) = preludePaths.get(index)) {
        if (candidate.equals(pathText.toStr())) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// Add every declaration of the already-analyzed prelude modules to `overlay`.
  ///
  /// A module's own declarations win, and so does an explicit import: both are
  /// written where the prelude is not, so neither is overridden here. The first
  /// prelude module to declare a name keeps it, which mirrors the order the
  /// manifest lists them in.
  function seedPreludeOverlay(
    overlay: &mut Analyzer::Imports::ImportOverlay,
    currentDirect: &Analyzer::Imports::DirectDeclarationIndex,
    directs: &Vector<Analyzer::Imports::DirectDeclarationIndex>,
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
    preludePaths: &Vector<String>,
    currentPath: &String,
  ): void {
    let mut recordIndex: u64 = 0;

    while (recordIndex < directs.length()) {
      let Option::SOME(preludeDirect) = directs.get(recordIndex) else {
        recordIndex += 1;
        continue;
      };
      let preludeInfo: Analyzer::Imports::ModuleInfo = Analyzer::moduleInfoAt(infos, recordIndex);

      if (!Analyzer::isPreludePath(preludePaths, &preludeInfo.pathText)) {
        recordIndex += 1;
        continue;
      }

      if (preludeInfo.pathText.equals(currentPath.toStr())) {
        recordIndex += 1;
        continue;
      }

      let mut declIndex: u64 = 0;

      while (declIndex < preludeDirect.syms.length()) {
        let Option::SOME(name) = preludeDirect.syms.get(declIndex) else {
          declIndex += 1;
          continue;
        };
        let Option::SOME(defId) = preludeDirect.defs.get(declIndex) else {
          declIndex += 1;
          continue;
        };
        let Option::SOME(span) = preludeDirect.spans.get(declIndex) else {
          declIndex += 1;
          continue;
        };

        if (Analyzer::Imports::directIndexSpan(currentDirect, *name).isSome()) {
          declIndex += 1;
          continue;
        }

        if (Analyzer::Imports::overlayHasName(overlay, *name)) {
          declIndex += 1;
          continue;
        }

        let overlayRef: &mut Analyzer::Imports::ImportOverlay = overlay;
        Analyzer::Imports::appendQualifiedOverlayEntry(
          overlayRef,
          *name,
          *defId,
          *span,
          preludeInfo.index,
          String::create(""),
          true,
        );
        declIndex += 1;
      }

      recordIndex += 1;
    }
  }

  function analyzeProgram(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    modules: &Vector<Ast::Module>,
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
    preludePaths: &Vector<String>,
  ): Vector<Analyzer::ModuleAnalysisRecord> {
    let mut programIndex: Analyzer::Imports::ProgramQualifiedIndex = Analyzer::Imports::emptyProgramQualifiedIndex();
    let mut pass1s: Vector<Analyzer::Binder::BinderOutput> = Vector::new<Analyzer::Binder::BinderOutput>();
    let mut pass2s: Vector<Analyzer::Binder::BinderOutput> = Vector::new<Analyzer::Binder::BinderOutput>();
    let mut directs: Vector<Analyzer::Imports::DirectDeclarationIndex> = Vector::new<Analyzer::Imports::DirectDeclarationIndex>();

    // Phase 1: bind every module before resolving any of them. The prelude
    // modules use each other (String returns Option, Option prints through
    // String), so no single analysis order lets one see the other unless all
    // declarations exist first — the host gets this from its shared stores.
    let mut bindIndex: u64 = 0;

    while (bindIndex < modules.length()) {
      let Option::SOME(module) = modules.get(bindIndex) else {
        bindIndex += 1;
        continue;
      };

      let pass1: Analyzer::Binder::BinderOutput = Analyzer::Binder::predeclareRoots(
        &module.roots,
        defStore,
        typeStore,
        symbols,
        module,
      );

      let pass2: Analyzer::Binder::BinderOutput = Analyzer::Binder::completeRoots(
        &module.roots,
        defStore,
        typeStore,
        symbols,
        module,
        &pass1,
      );

      let mut direct: Analyzer::Imports::DirectDeclarationIndex = Analyzer::buildDirectDeclarationIndex(
        defStore,
        module,
        &pass1,
        &pass2,
      );

      // The shared index a module publishes includes what its discarded
      // imports pull in, or a named import against an aggregator module
      // would find nothing. Targets are dependencies, so they are already
      // in `directs` when their importer binds.
      Analyzer::appendReExportedDeclarations(&mut direct, module, &directs, infos);
      Analyzer::appendNamedReExports(&mut direct, module, &directs, infos);
      Analyzer::appendDirectToProgramIndex(&mut programIndex, &direct);
      Analyzer::recordQualifiedNamesInDefStore(defStore, &direct, bindIndex);

      pass1s.push(pass1);
      pass2s.push(pass2);
      directs.push(direct);
      bindIndex += 1;
    }

    // Phase 2a: resolve every module's signatures before any module's
    // bodies typecheck. The prelude is mutually recursive one level above
    // binding too — String's methods mention Vector while Vector's mention
    // String — so no single order lets one typecheck against the other's
    // resolved signatures unless all signatures resolve first.
    let mut overlays: Vector<Analyzer::Imports::ImportOverlay> = Vector::new<Analyzer::Imports::ImportOverlay>();
    let mut importDiagnosticsList: Vector<DiagnosticBag> = Vector::new<DiagnosticBag>();
    let mut resolvedTypesList: Vector<Analyzer::Resolver::ResolverOutput> = Vector::new<Analyzer::Resolver::ResolverOutput>();
    let mut signatureIndex: u64 = 0;

    while (signatureIndex < modules.length()) {
      let Option::SOME(module) = modules.get(signatureIndex) else {
        signatureIndex += 1;
        continue;
      };
      let info: Analyzer::Imports::ModuleInfo = Analyzer::moduleInfoAt(infos, signatureIndex);
      let Option::SOME(pass1) = pass1s.get(signatureIndex) else {
        signatureIndex += 1;
        continue;
      };
      let Option::SOME(pass2) = pass2s.get(signatureIndex) else {
        signatureIndex += 1;
        continue;
      };

      // The shared entry in `directs` already carries re-exports; the overlay
      // build needs the module's own declarations only, or every
      // discard-imported name would be skipped as if declared here.
      let ownDirect: Analyzer::Imports::DirectDeclarationIndex = Analyzer::buildDirectDeclarationIndex(
        defStore,
        module,
        pass1,
        pass2,
      );

      let mut activeRef2a: &mut Analyzer::DefinitionStore = defStore;
      activeRef2a.setActiveModule(signatureIndex);

      let mut importDiagnostics: DiagnosticBag = DiagnosticBag::init();
      let mut overlay: Analyzer::Imports::ImportOverlay = Analyzer::buildImportOverlay(
        module,
        &ownDirect,
        &directs,
        infos,
        symbols,
        &mut importDiagnostics,
      );

      Analyzer::seedPreludeOverlay(&mut overlay, &ownDirect, &directs, infos, preludePaths, &info.pathText);

      let resolvedTypes: Analyzer::Resolver::ResolverOutput = Analyzer::Resolver::resolveTypesWithImports(
        defStore,
        typeStore,
        symbols,
        module,
        pass1,
        pass2,
        &overlay,
        &programIndex,
      );

      overlays.push(overlay);
      importDiagnosticsList.push(importDiagnostics);
      resolvedTypesList.push(resolvedTypes);
      signatureIndex += 1;
    }

    // Phase 2b walks in dependency order too, popping the stored outputs into
    // each record. The vectors are inverted once so popping them walks the
    // modules forward.
    let mut pass1sReversed: Vector<Analyzer::Binder::BinderOutput> = Vector::new<Analyzer::Binder::BinderOutput>();
    let mut pass2sReversed: Vector<Analyzer::Binder::BinderOutput> = Vector::new<Analyzer::Binder::BinderOutput>();
    let mut overlaysReversed: Vector<Analyzer::Imports::ImportOverlay> = Vector::new<Analyzer::Imports::ImportOverlay>();
    let mut importDiagnosticsReversed: Vector<DiagnosticBag> = Vector::new<DiagnosticBag>();
    let mut resolvedTypesReversed: Vector<Analyzer::Resolver::ResolverOutput> = Vector::new<Analyzer::Resolver::ResolverOutput>();
    let mut invertIndex: u64 = modules.length();

    while (invertIndex > 0) {
      invertIndex -= 1;

      let Option::SOME(pass1Entry) = pass1s.pop() else {
        continue;
      };
      pass1sReversed.push(pass1Entry);

      let Option::SOME(pass2Entry) = pass2s.pop() else {
        continue;
      };
      pass2sReversed.push(pass2Entry);

      let Option::SOME(overlayEntry) = overlays.pop() else {
        continue;
      };
      overlaysReversed.push(overlayEntry);

      let Option::SOME(importDiagnosticsEntry) = importDiagnosticsList.pop() else {
        continue;
      };
      importDiagnosticsReversed.push(importDiagnosticsEntry);

      let Option::SOME(resolvedTypesEntry) = resolvedTypesList.pop() else {
        continue;
      };
      resolvedTypesReversed.push(resolvedTypesEntry);
    }

    let mut records: Vector<Analyzer::ModuleAnalysisRecord> = Vector::new<Analyzer::ModuleAnalysisRecord>();
    let mut index: u64 = 0;

    while (index < modules.length()) {
      let pass2Popped: Option<Analyzer::Binder::BinderOutput> = pass2sReversed.pop();
      let pass1Popped: Option<Analyzer::Binder::BinderOutput> = pass1sReversed.pop();
      let overlayPopped: Option<Analyzer::Imports::ImportOverlay> = overlaysReversed.pop();
      let importDiagnosticsPopped: Option<DiagnosticBag> = importDiagnosticsReversed.pop();
      let resolvedTypesPopped: Option<Analyzer::Resolver::ResolverOutput> = resolvedTypesReversed.pop();

      let Option::SOME(module) = modules.get(index) else {
        index += 1;
        continue;
      };
      let info: Analyzer::Imports::ModuleInfo = Analyzer::moduleInfoAt(infos, index);
      let Option::SOME(pass1) = pass1Popped else {
        index += 1;
        continue;
      };
      let Option::SOME(pass2) = pass2Popped else {
        index += 1;
        continue;
      };
      let Option::SOME(overlay) = overlayPopped else {
        index += 1;
        continue;
      };
      let Option::SOME(importDiagnostics) = importDiagnosticsPopped else {
        index += 1;
        continue;
      };
      let Option::SOME(resolvedTypes) = resolvedTypesPopped else {
        index += 1;
        continue;
      };

      // The record's own direct index is rebuilt (it is pure derived data),
      // then extended with re-exports now that every module's declarations
      // are visible. The overlay is built against the module's own
      // declarations only: re-exported names are appended afterwards, or the
      // own-declaration skip inside the overlay build would drop every
      // discard-imported name as if this module had declared it.
      let mut activeRef2b: &mut Analyzer::DefinitionStore = defStore;
      activeRef2b.setActiveModule(index);

      let mut direct: Analyzer::Imports::DirectDeclarationIndex = Analyzer::buildDirectDeclarationIndex(
        defStore,
        module,
        &pass1,
        &pass2,
      );

      Analyzer::appendReExportedDeclarations(&mut direct, module, &directs, infos);

      let visibleDefs: Vector<Analyzer::DefinitionId> = Analyzer::moduleVisibleDefinitions(&direct, &overlay);
      let mut visibleRef2b: &mut Analyzer::DefinitionStore = defStore;
      visibleRef2b.setActiveModuleVisibleDefs(&visibleDefs);

      let resolvedBodies: Analyzer::ResolverBodies::ResolverBodiesOutput = Analyzer::ResolverBodies::resolveBodiesWithImports(
        defStore,
        typeStore,
        symbols,
        module,
        &pass1,
        &pass2,
        &overlay,
        &programIndex,
      );

      let typecheck: Analyzer::Typecheck::TypecheckOutput = Analyzer::Typecheck::checkModule(
        defStore,
        typeStore,
        symbols,
        module,
        &pass1,
        &pass2,
        &resolvedTypes,
        &resolvedBodies,
      );

      let constValues: Analyzer::ConstEval::ConstEvalOutput = Analyzer::ConstEval::evalModule(
        defStore,
        typeStore,
        module,
        &pass1,
        &pass2,
        &resolvedBodies,
        &typecheck,
      );

      let checks: Analyzer::Checks::ChecksOutput = Analyzer::Checks::checkModule(
        defStore,
        typeStore,
        module,
        &pass1,
        &pass2,
        &typecheck,
      );

      let lints: Analyzer::Lint::LintOutput = Analyzer::Lint::lintModule(
        defStore,
        symbols,
        module,
        &resolvedBodies,
        &typecheck,
        &overlay,
      );

      let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
      Analyzer::appendDiagnostics(&mut diagnostics, &pass1.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &pass2.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &importDiagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &resolvedTypes.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &resolvedBodies.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &typecheck.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &constValues.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &checks.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &lints.diagnostics);

      let output: Analyzer::AnalyzerOutput = Analyzer::AnalyzerOutput {
        pass1: pass1,
        pass2: pass2,
        resolvedTypes: resolvedTypes,
        resolvedBodies: resolvedBodies,
        typecheck: typecheck,
        constValues: constValues,
        checks: checks,
        lints: lints,
        diagnostics: diagnostics,
      };

      records.push(Analyzer::ModuleAnalysisRecord {
        info: info,
        direct: direct,
        imports: overlay,
        output: output,
      });
      index += 1;
    }

    return records;
  }
}
