import _ from "./ids";
import _ from "./types";
import _ from "./symbols";
import _ from "./definitions";
import _ from "./binder";
import _ from "./resolver";
import _ from "./resolver_bodies";
import _ from "./typecheck";
import _ from "./const_eval";
import _ from "./checks";
import _ from "./lint";
import _ from "./imports";

import Diagnostic, DiagnosticBag, NoteKind, SourceSpan from "@compiler::diagnostics";
import Id from "@compiler::ids";
import Ast from "@compiler::ast";

export namespace Analyzer {
  record AnalyzerOutput {
    public pass1: Analyzer::Binder::BinderOutput;
    public pass2: Analyzer::Binder::BinderOutput;
    public resolvedTypes: Analyzer::Resolver::ResolverOutput;
    public resolvedBodies: Analyzer::ResolverBodies::ResolverBodiesOutput;
    public typecheck: Analyzer::Typecheck::TypecheckOutput;
    public constValues: Analyzer::ConstEval::ConstEvalOutput;
    public checks: Analyzer::Checks::ChecksOutput;
    public lints: Analyzer::Lint::LintOutput;
    public diagnostics: DiagnosticBag;
  }

  record ModuleAnalysisRecord {
    public info: Analyzer::Imports::ModuleInfo;
    public pass1: Analyzer::Binder::BinderOutput;
    public pass2: Analyzer::Binder::BinderOutput;
    public direct: Analyzer::Imports::DirectDeclarationIndex;
    public imports: Analyzer::Imports::ImportOverlay;
    public output: Analyzer::AnalyzerOutput;
  }

  function importRecordIndexForSource(
    records: &Vector<Analyzer::ModuleAnalysisRecord>,
    source: &String,
  ): Option<u64> {
    let mut index: u64 = 0;

    while (index < records.length()) {
      let Option::SOME(analysisRecord) = records.get(index) else {
        index += 1;
        continue;
      };

      if (analysisRecord.info.pathText.equals(source.toStr())) {
        return Option::SOME(index);
      }

      index += 1;
    }

    return Option::NONE;
  }

  function buildImportOverlay(
    module: &Ast::Module,
    currentDirect: &Analyzer::Imports::DirectDeclarationIndex,
    records: &Vector<Analyzer::ModuleAnalysisRecord>,
    symbols: &mut Analyzer::SymbolTable,
    diagnostics: &mut DiagnosticBag,
  ): Analyzer::Imports::ImportOverlay {
    let mut overlay: Analyzer::Imports::ImportOverlay = Analyzer::Imports::emptyOverlay();
    let mut rootIndex: u64 = 0;
    let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;

    while (rootIndex < module.roots.length()) {
      let Option::SOME(rootId) = module.roots.get(rootIndex) else {
        rootIndex += 1;
        continue;
      };
      let Option::SOME(item) = module.items.get(*rootId) else {
        rootIndex += 1;
        continue;
      };
      let Ast::Item::Node::Import(importItem) = item else {
        rootIndex += 1;
        continue;
      };

      let Option::SOME(recordIndex) = Analyzer::importRecordIndexForSource(records, &importItem.source) else {
        Analyzer::Imports::appendImportSourceDiagnostic(
          diagnostics,
          importItem.source.toStr(),
          importItem.sourceSpan,
        );
        rootIndex += 1;
        continue;
      };
      let Option::SOME(targetRecord) = records.get(recordIndex) else {
        rootIndex += 1;
        continue;
      };

      let mut bindingIndex: u64 = 0;
      while (bindingIndex < importItem.items.length()) {
        let Option::SOME(binding) = importItem.items.get(bindingIndex) else {
          bindingIndex += 1;
          continue;
        };

        if (binding.kind == Ast::ImportBindingKind::Discard) {
          bindingIndex += 1;
          continue;
        }

        let Option::SOME(sourceNameText) = Ast::copyOptionalString(&binding.name) else {
          bindingIndex += 1;
          continue;
        };
        let localNameText: String = match (Ast::copyOptionalString(&binding.alias)) {
          Option::SOME(alias) -> alias,
          Option::NONE -> sourceNameText.clone(),
        };
        let sourceName: Analyzer::SymbolId = symbolsRef.intern(sourceNameText.toStr());
        let localName: Analyzer::SymbolId = symbolsRef.intern(localNameText.toStr());

        if (let Option::SOME(localSpan) = Analyzer::Imports::directIndexSpan(currentDirect, localName)) {
          Analyzer::Imports::appendImportConflictDiagnostic(
            diagnostics,
            localNameText.toStr(),
            binding.span,
            localSpan,
            "import conflicts with local declaration",
          );
          bindingIndex += 1;
          continue;
        }

        if (let Option::SOME(firstImportSpan) = Analyzer::Imports::overlaySpan(&overlay, localName)) {
          Analyzer::Imports::appendImportConflictDiagnostic(
            diagnostics,
            localNameText.toStr(),
            binding.span,
            firstImportSpan,
            "duplicate import binding here",
          );
          bindingIndex += 1;
          continue;
        }

        let Option::SOME(targetDef) = Analyzer::Imports::directIndexFind(&targetRecord.direct, sourceName) else {
          Analyzer::Imports::appendImportMissingDiagnostic(
            diagnostics,
            sourceNameText.toStr(),
            importItem.source.toStr(),
            binding.span,
          );
          bindingIndex += 1;
          continue;
        };

        Analyzer::Imports::appendOverlayEntry(
          &mut overlay,
          localName,
          targetDef,
          binding.span,
          targetRecord.info.index,
        );
        bindingIndex += 1;
      }

      rootIndex += 1;
    }

    return overlay;
  }

  function copyDiagnostic(source: &Diagnostic): Diagnostic {
    let mut copy: Diagnostic = Diagnostic::new(
      source.severity,
      source.code,
      source.messageText(),
      source.primarySpan,
    );

    let mut labelIndex: u64 = 0;
    while (labelIndex < source.labels.length()) {
      let Option::SOME(label) = source.labels.get(labelIndex) else {
        labelIndex += 1;
        continue;
      };

      copy.addLabel(label.kind, label.span, label.messageText());
      labelIndex += 1;
    }

    let mut noteIndex: u64 = 0;
    while (noteIndex < source.notes.length()) {
      let Option::SOME(note) = source.notes.get(noteIndex) else {
        noteIndex += 1;
        continue;
      };

      match (note.kind) {
        NoteKind::NOTE -> copy.addNote(note.messageText()),
        NoteKind::HELP -> copy.setHelp(note.messageText()),
      };

      noteIndex += 1;
    }

    if (let Option::SOME(help) = source.helpText()) {
      copy.setHelp(help);
    }

    return copy;
  }

  function appendDiagnostics(target: &mut DiagnosticBag, source: &DiagnosticBag): void {
    let mut index: u64 = 0;
    let mut targetRef: &mut DiagnosticBag = target;

    while (index < source.length()) {
      let Option::SOME(diagnostic) = source.get(index) else {
        index += 1;
        continue;
      };

      targetRef.push(Analyzer::copyDiagnostic(diagnostic));
      index += 1;
    }
  }

  /// Whether `rawId` names an item another module can refer to.
  ///
  /// A root, the declaration an `export` wraps, or anything declared inside a
  /// namespace at any depth: the corpus writes `Ast::Expression::Node` and
  /// means the `Node` declared two namespaces deep, so the index has to carry
  /// it. The qualifier is not validated here, the same debt the resolvers
  /// already carry for the segments before the last.
  function moduleHasRootItemRaw(module: &Ast::Module, rawId: u32): boolean {
    let mut index: u64 = 0;

    while (index < module.roots.length()) {
      let Option::SOME(rootId) = module.roots.get(index) else {
        index += 1;
        continue;
      };

      if (rootId.raw() == rawId) {
        return true;
      }

      if (Analyzer::itemContainsDeclarationRaw(module, *rootId, rawId, 0)) {
        return true;
      }

      index += 1;
    }

    return false;
  }

  /// Whether `rawId` is declared inside `itemId`, following namespace and
  /// export nesting. `depth` guards against a malformed tree pointing at
  /// itself; the corpus nests three deep at most.
  function itemContainsDeclarationRaw(
    module: &Ast::Module,
    itemId: Ast::ItemId,
    rawId: u32,
    depth: u64,
  ): boolean {
    if (depth > 16) {
      return false;
    }

    let Option::SOME(item) = module.items.get(itemId) else {
      return false;
    };

    match (item) {
      Ast::Item::Node::Export(exported) -> {
        let Option::SOME(innerItemId) = exported.declaration else {
          return false;
        };

        if (innerItemId.raw() == rawId) {
          return true;
        }

        return Analyzer::itemContainsDeclarationRaw(module, innerItemId, rawId, depth + 1);
      },
      Ast::Item::Node::Namespace(namespaceItem) -> {
        let mut childIndex: u64 = 0;

        while (childIndex < namespaceItem.items.length()) {
          let Option::SOME(childId) = namespaceItem.items.get(childIndex) else {
            childIndex += 1;
            continue;
          };

          if (childId.raw() == rawId) {
            return true;
          }

          if (Analyzer::itemContainsDeclarationRaw(module, *childId, rawId, depth + 1)) {
            return true;
          }

          childIndex += 1;
        }

        return false;
      },
      _ -> {
        return false;
      },
    };

    @panic("unreachable: itemContainsDeclarationRaw match did not return");
  }

  function itemSpanOrEmpty(module: &Ast::Module, rawId: u32): SourceSpan {
    let itemId: Ast::ItemId = Id::fromRaw<Ast::ItemTag>(rawId);
    let Option::SOME(item) = module.items.get(itemId) else {
      return SourceSpan::new("", 0, 0);
    };

    return match (item) {
      Ast::Item::Node::Function(f) -> f.span,
      Ast::Item::Node::Record(r) -> r.span,
      Ast::Item::Node::Enum(e) -> e.span,
      Ast::Item::Node::Namespace(n) -> n.span,
      Ast::Item::Node::Import(i) -> i.span,
      Ast::Item::Node::Extern(e) -> e.span,
      Ast::Item::Node::Constant(c) -> c.span,
      Ast::Item::Node::Export(e) -> e.span,
      Ast::Item::Node::TypeAlias(a) -> a.span,
      Ast::Item::Node::Trait(t) -> t.span,
    };
  }

  function directIndexAppendOutput(
    direct: &mut Analyzer::Imports::DirectDeclarationIndex,
    defStore: &mut Analyzer::DefinitionStore,
    module: &Ast::Module,
    output: &Analyzer::Binder::BinderOutput,
  ): void {
    let mut index: u64 = 0;

    while (index < output.defIds.length()) {
      let Option::SOME(rawId) = output.nodeIds.get(index) else {
        index += 1;
        continue;
      };
      if (!Analyzer::moduleHasRootItemRaw(module, *rawId)) {
        index += 1;
        continue;
      }

      let Option::SOME(defId) = output.defIds.get(index) else {
        index += 1;
        continue;
      };

      let Option::SOME(definition) = defStore.get(*defId) else {
        index += 1;
        continue;
      };

      Analyzer::Imports::appendDirectIndexEntryIfMissing(
        direct,
        definition.name(),
        *defId,
        Analyzer::itemSpanOrEmpty(module, *rawId),
      );
      index += 1;
    }
  }

  function buildDirectDeclarationIndex(
    defStore: &mut Analyzer::DefinitionStore,
    module: &Ast::Module,
    pass1: &Analyzer::Binder::BinderOutput,
    pass2: &Analyzer::Binder::BinderOutput,
  ): Analyzer::Imports::DirectDeclarationIndex {
    let mut direct: Analyzer::Imports::DirectDeclarationIndex = Analyzer::Imports::emptyDirectDeclarationIndex();
    Analyzer::directIndexAppendOutput(&mut direct, defStore, module, pass1);
    Analyzer::directIndexAppendOutput(&mut direct, defStore, module, pass2);
    return direct;
  }

  function analyzeModuleWithImports(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
    overlay: &Analyzer::Imports::ImportOverlay,
  ): Analyzer::AnalyzerOutput {
    let pass1: Analyzer::Binder::BinderOutput = Analyzer::Binder::predeclareRoots(
      &module.roots,
      defStore,
      typeStore,
      symbols,
      module,
    );

    let pass2: Analyzer::Binder::BinderOutput = Analyzer::Binder::completeRoots(
      &module.roots,
      defStore,
      typeStore,
      symbols,
      module,
      &pass1,
    );

    let resolvedTypes: Analyzer::Resolver::ResolverOutput = Analyzer::Resolver::resolveTypesWithImports(
      defStore,
      typeStore,
      symbols,
      module,
      &pass1,
      &pass2,
      overlay,
    );

    let resolvedBodies: Analyzer::ResolverBodies::ResolverBodiesOutput = Analyzer::ResolverBodies::resolveBodiesWithImports(
      defStore,
      typeStore,
      symbols,
      module,
      &pass1,
      &pass2,
      overlay,
    );

    let typecheck: Analyzer::Typecheck::TypecheckOutput = Analyzer::Typecheck::checkModule(
      defStore,
      typeStore,
      symbols,
      module,
      &pass1,
      &pass2,
      &resolvedTypes,
      &resolvedBodies,
    );

    let constValues: Analyzer::ConstEval::ConstEvalOutput = Analyzer::ConstEval::evalModule(
      defStore,
      typeStore,
      module,
      &pass1,
      &pass2,
      &resolvedBodies,
      &typecheck,
    );

    let checks: Analyzer::Checks::ChecksOutput = Analyzer::Checks::checkModule(
      defStore,
      typeStore,
      module,
      &pass1,
      &pass2,
      &typecheck,
    );

    let lints: Analyzer::Lint::LintOutput = Analyzer::Lint::lintModule(
      defStore,
      symbols,
      module,
      &resolvedBodies,
      &typecheck,
      overlay,
    );

    let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
    Analyzer::appendDiagnostics(&mut diagnostics, &pass1.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &pass2.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &resolvedTypes.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &resolvedBodies.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &typecheck.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &constValues.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &checks.diagnostics);
    Analyzer::appendDiagnostics(&mut diagnostics, &lints.diagnostics);

    return Analyzer::AnalyzerOutput {
      pass1: pass1,
      pass2: pass2,
      resolvedTypes: resolvedTypes,
      resolvedBodies: resolvedBodies,
      typecheck: typecheck,
      constValues: constValues,
      checks: checks,
      lints: lints,
      diagnostics: diagnostics,
    };
  }

  function analyzeModule(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    module: &Ast::Module,
  ): Analyzer::AnalyzerOutput {
    let overlay: Analyzer::Imports::ImportOverlay = Analyzer::Imports::emptyOverlay();
    return Analyzer::analyzeModuleWithImports(
      defStore,
      typeStore,
      symbols,
      module,
      &overlay,
    );
  }

  function moduleInfoAt(
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
    index: u64,
  ): Analyzer::Imports::ModuleInfo {
    if (let Option::SOME(info) = infos.get(index)) {
      return Analyzer::Imports::ModuleInfo {
        index: info.index,
        pathText: info.pathText.clone(),
        kind: info.kind,
      };
    }

    return Analyzer::Imports::ModuleInfo {
      index: index,
      pathText: String::create(""),
      kind: Analyzer::Imports::ModuleKind::PROJECT,
    };
  }

  /// Whether `pathText` names one of the auto-loaded prelude modules.
  function isPreludePath(preludePaths: &Vector<String>, pathText: &String): boolean {
    let mut index: u64 = 0;

    while (index < preludePaths.length()) {
      if (let Option::SOME(candidate) = preludePaths.get(index)) {
        if (candidate.equals(pathText.toStr())) {
          return true;
        }
      }

      index += 1;
    }

    return false;
  }

  /// Add every declaration of the already-analyzed prelude modules to `overlay`.
  ///
  /// A module's own declarations win, and so does an explicit import: both are
  /// written where the prelude is not, so neither is overridden here. The first
  /// prelude module to declare a name keeps it, which mirrors the order the
  /// manifest lists them in.
  function seedPreludeOverlay(
    overlay: &mut Analyzer::Imports::ImportOverlay,
    currentDirect: &Analyzer::Imports::DirectDeclarationIndex,
    records: &Vector<Analyzer::ModuleAnalysisRecord>,
    preludePaths: &Vector<String>,
    currentPath: &String,
  ): void {
    let mut recordIndex: u64 = 0;

    while (recordIndex < records.length()) {
      let Option::SOME(preludeRecord) = records.get(recordIndex) else {
        recordIndex += 1;
        continue;
      };

      if (!Analyzer::isPreludePath(preludePaths, &preludeRecord.info.pathText)) {
        recordIndex += 1;
        continue;
      }

      if (preludeRecord.info.pathText.equals(currentPath.toStr())) {
        recordIndex += 1;
        continue;
      }

      let mut declIndex: u64 = 0;

      while (declIndex < preludeRecord.direct.syms.length()) {
        let Option::SOME(name) = preludeRecord.direct.syms.get(declIndex) else {
          declIndex += 1;
          continue;
        };
        let Option::SOME(defId) = preludeRecord.direct.defs.get(declIndex) else {
          declIndex += 1;
          continue;
        };
        let Option::SOME(span) = preludeRecord.direct.spans.get(declIndex) else {
          declIndex += 1;
          continue;
        };

        if (Analyzer::Imports::directIndexSpan(currentDirect, *name).isSome()) {
          declIndex += 1;
          continue;
        }

        if (Analyzer::Imports::overlayHasName(overlay, *name)) {
          declIndex += 1;
          continue;
        }

        let mut overlayRef: &mut Analyzer::Imports::ImportOverlay = overlay;
        Analyzer::Imports::appendOverlayEntry(
          overlayRef,
          *name,
          *defId,
          *span,
          preludeRecord.info.index,
        );
        declIndex += 1;
      }

      recordIndex += 1;
    }
  }

  function analyzeProgram(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    modules: &Vector<Ast::Module>,
    infos: &Vector<Analyzer::Imports::ModuleInfo>,
    preludePaths: &Vector<String>,
  ): Vector<Analyzer::ModuleAnalysisRecord> {
    let mut records: Vector<Analyzer::ModuleAnalysisRecord> = Vector::new<Analyzer::ModuleAnalysisRecord>();
    let mut index: u64 = 0;

    while (index < modules.length()) {
      let Option::SOME(module) = modules.get(index) else {
        index += 1;
        continue;
      };
      let info: Analyzer::Imports::ModuleInfo = Analyzer::moduleInfoAt(infos, index);

      let pass1: Analyzer::Binder::BinderOutput = Analyzer::Binder::predeclareRoots(
        &module.roots,
        defStore,
        typeStore,
        symbols,
        module,
      );

      let pass2: Analyzer::Binder::BinderOutput = Analyzer::Binder::completeRoots(
        &module.roots,
        defStore,
        typeStore,
        symbols,
        module,
        &pass1,
      );

      let direct: Analyzer::Imports::DirectDeclarationIndex = Analyzer::buildDirectDeclarationIndex(
        defStore,
        module,
        &pass1,
        &pass2,
      );
      let mut importDiagnostics: DiagnosticBag = DiagnosticBag::init();
      let mut overlay: Analyzer::Imports::ImportOverlay = Analyzer::buildImportOverlay(
        module,
        &direct,
        &records,
        symbols,
        &mut importDiagnostics,
      );

      Analyzer::seedPreludeOverlay(&mut overlay, &direct, &records, preludePaths, &info.pathText);

      let resolvedTypes: Analyzer::Resolver::ResolverOutput = Analyzer::Resolver::resolveTypesWithImports(
        defStore,
        typeStore,
        symbols,
        module,
        &pass1,
        &pass2,
        &overlay,
      );

      let resolvedBodies: Analyzer::ResolverBodies::ResolverBodiesOutput = Analyzer::ResolverBodies::resolveBodiesWithImports(
        defStore,
        typeStore,
        symbols,
        module,
        &pass1,
        &pass2,
        &overlay,
      );

      let typecheck: Analyzer::Typecheck::TypecheckOutput = Analyzer::Typecheck::checkModule(
        defStore,
        typeStore,
        symbols,
        module,
        &pass1,
        &pass2,
        &resolvedTypes,
        &resolvedBodies,
      );

      let constValues: Analyzer::ConstEval::ConstEvalOutput = Analyzer::ConstEval::evalModule(
        defStore,
        typeStore,
        module,
        &pass1,
        &pass2,
        &resolvedBodies,
        &typecheck,
      );

      let checks: Analyzer::Checks::ChecksOutput = Analyzer::Checks::checkModule(
        defStore,
        typeStore,
        module,
        &pass1,
        &pass2,
        &typecheck,
      );

      let lints: Analyzer::Lint::LintOutput = Analyzer::Lint::lintModule(
        defStore,
        symbols,
        module,
        &resolvedBodies,
        &typecheck,
        &overlay,
      );

      let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
      Analyzer::appendDiagnostics(&mut diagnostics, &pass1.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &pass2.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &importDiagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &resolvedTypes.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &resolvedBodies.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &typecheck.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &constValues.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &checks.diagnostics);
      Analyzer::appendDiagnostics(&mut diagnostics, &lints.diagnostics);

      let output: Analyzer::AnalyzerOutput = Analyzer::AnalyzerOutput {
        pass1: pass1,
        pass2: pass2,
        resolvedTypes: resolvedTypes,
        resolvedBodies: resolvedBodies,
        typecheck: typecheck,
        constValues: constValues,
        checks: checks,
        lints: lints,
        diagnostics: diagnostics,
      };

      records.push(Analyzer::ModuleAnalysisRecord {
        info: info,
        pass1: output.pass1,
        pass2: output.pass2,
        direct: direct,
        imports: overlay,
        output: output,
      });
      index += 1;
    }

    return records;
  }
}
