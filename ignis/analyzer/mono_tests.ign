import Test from "std::test";
import Vector from "std::vector";

import DiagnosticBag, Severity, SourceFile from "@compiler::diagnostics";
import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import Id from "@compiler::ids";
import ParseOutput, Parser from "@compiler::parser";
import Capture from "./capture";
import Lowering from "./lowering";
import Mono from "./mono";

function monoCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

function monoContains(haystack: &String, needle: str): boolean {
  let target: String = String::create(needle);

  return haystack.contains(&target);
}

/// Parses, analyzes and lowers `source`, runs monomorphization over the
/// resulting HIR and renders the monomorphized store.
///
/// `withCaptures` runs capture analysis first, the order the driver uses:
/// closures reach monomorphization already carrying an environment layout.
function monoRenderWith(source: str, withCaptures: boolean): String {
  let file: SourceFile = SourceFile::create("mono_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(monoCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(monoCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(monoCountErrors(&output.diagnostics), 0);

  let mut hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  if (withCaptures) {
    let captureDiagnostics: DiagnosticBag = Capture::populateClosureCaptures(
      &mut defStore,
      &mut typeStore,
      &mut symbols,
      &mut hir,
    );

    Test::assertEq<u64>(monoCountErrors(&captureDiagnostics), 0);
  }

  let monoResult: Mono::MonoOutput = Mono::run(&mut defStore, &mut typeStore, &mut symbols, &hir);

  return Hir::Display::printHir(&monoResult.hir, &typeStore, &defStore, &symbols);
}

function monoRender(source: str): String {
  return monoRenderWith(source, false);
}

@test
function monoResolvesBuiltinEqToRecordMethod(): void {
  let rendered: String = monoRender(
    "@implements(Eq)\n@implements(Copy)\nrecord Point {\n  public x: i32;\n\n  public equals(&self, other: &Point): boolean {\n    return self.x == other.x;\n  }\n}\n\nfunction samePoint(a: Point, b: Point): boolean {\n  return @eq<Point>(a, b);\n}\n\nfunction main(): i32 {\n  return samePoint(Point { x: 1 }, Point { x: 2 }) ? 1 : 0;\n}\n",
  );

  Test::assert(monoContains(&rendered, "BuiltinEq"));
  Test::assert(monoContains(&rendered, "method("));
  Test::assert(!monoContains(&rendered, "pending"));
}

@test
function monoLeavesBuiltinEqPendingWithoutEqualsMethod(): void {
  let rendered: String = monoRender(
    "@implements(Copy)\nrecord Plain {\n  public x: i32;\n}\n\nfunction samePlain(a: Plain, b: Plain): boolean {\n  return @eq<Plain>(a, b);\n}\n\nfunction main(): i32 {\n  return samePlain(Plain { x: 1 }, Plain { x: 2 }) ? 1 : 0;\n}\n",
  );

  Test::assert(monoContains(&rendered, "BuiltinEq"));
  Test::assert(monoContains(&rendered, "pending"));
}

@test
function monoLeavesBuiltinEqPendingWithoutEqTrait(): void {
  let rendered: String = monoRender(
    "@implements(Copy)\nrecord Loose {\n  public x: i32;\n\n  public equals(&self, other: &Loose): boolean {\n    return self.x == other.x;\n  }\n}\n\nfunction sameLoose(a: Loose, b: Loose): boolean {\n  return @eq<Loose>(a, b);\n}\n\nfunction main(): i32 {\n  return sameLoose(Loose { x: 1 }, Loose { x: 2 }) ? 1 : 0;\n}\n",
  );

  Test::assert(monoContains(&rendered, "BuiltinEq"));
  Test::assert(monoContains(&rendered, "pending"));
}

@test
function monoKeepsClosureCapturesAcrossTheClone(): void {
  let rendered: String = monoRenderWith(
    "function main(): i32 {\n  let x: i32 = 10;\n  let addX = (y: i32): i32 -> x + y;\n\n  return addX(32);\n}\n",
    true,
  );

  Test::assert(monoContains(&rendered, "captures: 1"));
  Test::assert(!monoContains(&rendered, "captures: 0"));
}

@test
function monoLeavesAModuleConstantOutOfTheEnvironment(): void {
  let rendered: String = monoRenderWith(
    "const DOT: u8 = 46;\n\nfunction main(): boolean {\n  let matches = (b: u8): boolean -> b == DOT;\n\n  return matches(46);\n}\n",
    true,
  );

  Test::assert(monoContains(&rendered, "captures: 0"));
}

/// Analyze `source` and return the store it filled, for tests that inspect
/// definitions directly rather than the rendered HIR.
function monoAnalyzeDefinitions(source: str): Analyzer::DefinitionStore {
  let file: SourceFile = SourceFile::create("mono_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(monoCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(monoCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(monoCountErrors(&output.diagnostics), 0);

  return defStore;
}

/// The method the single trait in `defStore` declares at `methodIndex`.
function monoTraitMethodAt(
  defStore: &mut Analyzer::DefinitionStore,
  methodIndex: u64,
): Analyzer::DefinitionId {
  let mut index: u64 = 0;

  while (index < defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);

    if (let Option::SOME(Analyzer::Definition::Trait(trait_)) = defStore.get(defId)) {
      let Option::SOME(methodId) = trait_.methods.get(methodIndex) else {
        @panic("trait declares no method at that index");
      };

      return *methodId;
    }

    index += 1;
  }

  @panic("no trait definition found");
}

/// The first record in `defStore`, which every trait-bound test declares once.
function monoOnlyRecordDef(defStore: &mut Analyzer::DefinitionStore): Analyzer::DefinitionId {
  let mut index: u64 = 0;

  while (index < defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);

    if (let Option::SOME(Analyzer::Definition::Record(_)) = defStore.get(defId)) {
      return defId;
    }

    index += 1;
  }

  @panic("no record definition found");
}

/// Scenario: a call through a trait bound names the trait's declaration, and
/// the re-dispatch resolves it to the implementing record's own method instead
/// of leaving the trait stub as the callee.
@test
function monoRedispatchesATraitBoundCallToTheImplementation(): void {
  let mut defStore: Analyzer::DefinitionStore = monoAnalyzeDefinitions(
    "trait Weigh {\n  weigh(&self): i32;\n}\n\n@implements(Weigh)\nrecord Stone {\n  public grams: i32;\n\n  weigh(&self): i32 {\n    return self.grams * 2;\n  }\n}\n\nfunction total<T: Weigh>(value: &T): i32 {\n  return value.weigh();\n}\n",
  );

  let traitMethod: Analyzer::DefinitionId = monoTraitMethodAt(&mut defStore, 0);
  let recordDef: Analyzer::DefinitionId = monoOnlyRecordDef(&mut defStore);

  let Option::SOME(implementation) = Mono::traitImplementationMethod(&mut defStore, recordDef, traitMethod) else {
    @panic("expected the record's own implementation");
  };

  Test::assertEq<boolean>(implementation.raw() == traitMethod.raw(), false);

  let Option::SOME(Analyzer::Definition::Method(method)) = defStore.get(implementation) else {
    @panic("expected a method definition");
  };

  Test::assertEq<u32>(method.owner.raw(), recordDef.raw());
}

/// Scenario: with two same-named overloads on the implementing record, the
/// re-dispatch picks the one whose parameter count matches the trait's.
@test
function monoRedispatchPicksTheOverloadMatchingTheTraitArity(): void {
  let mut defStore: Analyzer::DefinitionStore = monoAnalyzeDefinitions(
    "trait Weigh {\n  weigh(&self): i32;\n}\n\n@implements(Weigh)\nrecord Stone {\n  public grams: i32;\n\n  weigh(&self): i32 {\n    return self.grams * 2;\n  }\n\n  weigh(&self, factor: i32): i32 {\n    return self.grams * factor;\n  }\n}\n\nfunction total<T: Weigh>(value: &T): i32 {\n  return value.weigh();\n}\n",
  );

  let traitMethod: Analyzer::DefinitionId = monoTraitMethodAt(&mut defStore, 0);
  let recordDef: Analyzer::DefinitionId = monoOnlyRecordDef(&mut defStore);

  let Option::SOME(implementation) = Mono::traitImplementationMethod(&mut defStore, recordDef, traitMethod) else {
    @panic("expected the record's own implementation");
  };

  let Option::SOME(Analyzer::Definition::Method(method)) = defStore.get(implementation) else {
    @panic("expected a method definition");
  };

  Test::assertEq<u64>(method.params.length(), 1);
}

/// Scenario: an ordinary method call already names a record's own method, so
/// the re-dispatch leaves it alone instead of rewriting every method call.
@test
function monoRedispatchIgnoresANonTraitMethod(): void {
  let mut defStore: Analyzer::DefinitionStore = monoAnalyzeDefinitions(
    "record Stone {\n  public grams: i32;\n\n  weigh(&self): i32 {\n    return self.grams * 2;\n  }\n}\n",
  );

  let recordDef: Analyzer::DefinitionId = monoOnlyRecordDef(&mut defStore);

  let Option::SOME(Analyzer::Definition::Record(record_)) = defStore.get(recordDef) else {
    @panic("expected a record definition");
  };

  let Option::SOME(ownMethod) = record_.instanceMethods.get(0) else {
    @panic("expected the record to declare a method");
  };

  Test::assertEq<boolean>(Mono::traitImplementationMethod(&mut defStore, recordDef, *ownMethod).isSome(), false);
}

/// Scenario: a method type parameter inferred from the argument reaches
/// monomorphization, so the call is keyed on the concrete return type and no
/// type parameter survives the clone.
@test
function monoSpecializesAMethodTypeParameterInferredFromTheArgument(): void {
  let rendered: String = monoRenderWith(
    "record Box<T> {\n  value: T;\n\n  transform<U>(&self, f: (T) -> U): U {\n    return f(self.value);\n  }\n}\n\nfunction main(): i32 {\n  let b: Box<i32> = Box { value: 7 };\n  let result: i64 = b.transform((x: i32): i64 -> x as i64 * 6);\n\n  return result as i32;\n}\n",
    true,
  );

  Test::assert(monoContains(&rendered, "i64"));
  Test::assert(!monoContains(&rendered, "param:"));
}

/// The stores one monomorphization run filled, for tests that inspect the
/// definitions it produced rather than the rendered HIR.
record MonoRun {
  public defStore: Analyzer::DefinitionStore;
  public symbols: Analyzer::SymbolTable;
}

/// Analyzes, lowers and monomorphizes `source`, returning the stores the run
/// filled.
function monoRunDefinitions(source: str): MonoRun {
  let file: SourceFile = SourceFile::create("mono_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(monoCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(monoCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(monoCountErrors(&output.diagnostics), 0);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let _ = Mono::run(&mut defStore, &mut typeStore, &mut symbols, &hir);

  return MonoRun {
    defStore: defStore,
    symbols: symbols,
  };
}

/// The definition written with exactly this name, if the run produced one.
function monoDefNamed(run: &mut MonoRun, name: str): Option<Analyzer::DefinitionId> {
  let mut rawId: u64 = 0;

  while (rawId < run.defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(rawId as u32);
    let mut nameSym: Option<Analyzer::SymbolId> = Option::NONE;

    if (let Option::SOME(definition) = run.defStore.get(defId)) {
      nameSym = Option::SOME(definition.name());
    }

    if (let Option::SOME(defName) = nameSym) {
      if (let Option::SOME(text) = run.symbols.resolve(defName)) {
        if (String::create(text).equals(name)) {
          return Option::SOME(defId);
        }
      }
    }

    rawId += 1;
  }

  return Option::NONE;
}

/// Scenario: no call site names the destructor of a value a scope drops, so
/// instantiating a `@implements(Drop)` generic has to specialize its `drop`
/// method itself and point the specialization back at the instantiation.
@test
function monoSpecializesTheDropMethodOfAnInstantiatedNominal(): void {
  let mut run: MonoRun = monoRunDefinitions(
    "@implements(Drop)\nrecord Box<T> {\n  public value: T;\n\n  public drop(&mut self): void {\n    return;\n  }\n}\n\nfunction main(): i32 {\n  let b: Box<i32> = Box { value: 7 };\n\n  return b.value;\n}\n",
  );

  let Option::SOME(shellId) = monoDefNamed(&mut run, "Box__i32") else {
    @panic("monomorphization produced no Box<i32> instantiation");
  };

  let Option::SOME(dropId) = monoDefNamed(&mut run, "Box__i32__drop") else {
    @panic("monomorphization specialized no drop method");
  };

  let Option::SOME(Analyzer::Definition::Method(methodDef)) = run.defStore.get(dropId) else {
    @panic("expected a method definition");
  };

  Test::assertEq<u64>(methodDef.owner.raw() as u64, shellId.raw() as u64);
}

/// The stores and HIR one analysis pass produced, for tests that call
/// `Mono::runWithRoots` directly instead of going through `Mono::run`.
record MonoInputs {
  public defStore: Analyzer::DefinitionStore;
  public typeStore: Analyzer::TypeStore;
  public symbols: Analyzer::SymbolTable;
  public hir: Hir::HirStore;
}

/// Parses and analyzes `source`, returning the stores and HIR before
/// monomorphization runs.
function monoAnalyze(source: str): MonoInputs {
  let file: SourceFile = SourceFile::create("mono_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(monoCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(monoCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(monoCountErrors(&output.diagnostics), 0);

  let hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  return MonoInputs {
    defStore: defStore,
    typeStore: typeStore,
    symbols: symbols,
    hir: hir,
  };
}

/// The definition written with exactly this name in `inputs`, before
/// monomorphization runs. Mirrors `monoDefNamed`, scanning the pre-mono
/// definition store instead of a completed `MonoRun`.
function monoInputDefNamed(inputs: &mut MonoInputs, name: str): Option<Analyzer::DefinitionId> {
  let mut rawId: u64 = 0;

  while (rawId < inputs.defStore.length()) {
    let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(rawId as u32);
    let mut nameSym: Option<Analyzer::SymbolId> = Option::NONE;

    if (let Option::SOME(definition) = inputs.defStore.get(defId)) {
      nameSym = Option::SOME(definition.name());
    }

    if (let Option::SOME(defName) = nameSym) {
      if (let Option::SOME(text) = inputs.symbols.resolve(defName)) {
        if (String::create(text).equals(name)) {
          return Option::SOME(defId);
        }
      }
    }

    rawId += 1;
  }

  return Option::NONE;
}

/// Scenario: another translation unit calls a function only by its C symbol —
/// exactly what the `@test` harness dispatch table does — so no Ignis call
/// site reaches it from `main`. `runWithRoots` must still emit it once its
/// `DefinitionId` is passed in as an external root, the way the driver's
/// `collect_test_mono_roots` feeds harness definitions in as roots.
///
/// `trulyDeadGeneric` pins the other half of "only what the roots reach is
/// emitted": every non-generic top-level function is already a root by
/// itself (`collectRoots`'s public-function arm), so a generic definition is
/// the one shape `copyIfNonGeneric` still excludes on its own merits — it
/// stays pending until something instantiates it — and it names no call
/// site and no external root here, so it never does.
@test
function monoRunWithRootsEmitsAnExternalRootUnreachableFromMain(): void {
  let mut inputs: MonoInputs = monoAnalyze(
    "function calledOnlyByExternalRoot(): i32 {\n  return 9;\n}\n\nfunction trulyDeadGeneric<T>(value: T): T {\n  return value;\n}\n\nfunction main(): i32 {\n  return 1;\n}\n",
  );

  let Option::SOME(externalDefId) = monoInputDefNamed(&mut inputs, "calledOnlyByExternalRoot") else {
    @panic("expected to find calledOnlyByExternalRoot in the definition store");
  };

  let mut externalRoots: Vector<u32> = Vector::new<u32>();
  externalRoots.push(externalDefId.raw());

  let monoResult: Mono::MonoOutput = Mono::runWithRoots(
    &mut inputs.defStore,
    &mut inputs.typeStore,
    &mut inputs.symbols,
    &inputs.hir,
    false,
    &externalRoots,
  );

  let rendered: String = Hir::Display::printHir(&monoResult.hir, &inputs.typeStore, &inputs.defStore, &inputs.symbols);

  Test::assert(monoContains(&rendered, "fn calledOnlyByExternalRoot("));
  Test::assert(!monoContains(&rendered, "fn trulyDeadGeneric("));
}

/// Scenario: a standard-library build mirrors the driver's
/// `collect_mono_roots_for_std` — the archive it produces links into
/// translation units this build never sees, so `exportAll` must root every
/// non-generic function and method by itself, without any `main` calling
/// them and without any external root naming them.
@test
function monoRunWithRootsExportAllRootsEveryNonGenericFunctionAndMethod(): void {
  let mut inputs: MonoInputs = monoAnalyze(
    "function neverCalledButExported(): i32 {\n  return 4;\n}\n\nrecord Widget {\n  public value: i32;\n\n  public read(&self): i32 {\n    return self.value;\n  }\n}\n",
  );

  let externalRoots: Vector<u32> = Vector::new<u32>();

  let monoResult: Mono::MonoOutput = Mono::runWithRoots(
    &mut inputs.defStore,
    &mut inputs.typeStore,
    &mut inputs.symbols,
    &inputs.hir,
    true,
    &externalRoots,
  );

  let rendered: String = Hir::Display::printHir(&monoResult.hir, &inputs.typeStore, &inputs.defStore, &inputs.symbols);

  Test::assert(monoContains(&rendered, "fn neverCalledButExported("));

  // `printDefinitions` only renders `Definition::Function`, so a method's
  // presence is checked the way `monoSpecializesTheDropMethodOfAnInstantiatedNominal`
  // does: look the method definition up and confirm mono copied its body.
  let Option::SOME(readMethodId) = monoInputDefNamed(&mut inputs, "read") else {
    @panic("expected to find the read method in the definition store");
  };

  Test::assert(monoResult.hir.functionBodies.get(readMethodId).isSome());
}
