import Test from "std::test";

import DiagnosticBag, DiagnosticCode, Severity, SourceFile from "@compiler::diagnostics";
import Analyzer from "@compiler::analyzer";
import ParseOutput, Parser from "@compiler::parser";

/// Parses `source` and runs the analyzer over it, asserting the parser stayed
/// silent so every diagnostic a test sees comes from analysis.
function zeroAnalyze(source: str): DiagnosticBag {
  let file: SourceFile = SourceFile::create("zero_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(parsed.lexDiagnostics.length(), 0);
  Test::assertEq<u64>(parsed.parseDiagnostics.length(), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  return output.diagnostics;
}

function zeroCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

function zeroFirstErrorCode(bag: &DiagnosticBag): String {
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      return String::create(diagnostic.code);
    }

    index += 1;
  }

  return String::create("");
}

function zeroAssertAccepted(source: str): void {
  let diagnostics: DiagnosticBag = zeroAnalyze(source);
  Test::assertEq<u64>(zeroCountErrors(&diagnostics), 0);
}

function zeroAssertRejected(source: str, code: str): void {
  let diagnostics: DiagnosticBag = zeroAnalyze(source);
  Test::assertEq<u64>(zeroCountErrors(&diagnostics), 1);
  Test::assertEq<str>(zeroFirstErrorCode(&diagnostics).toStr(), code);
}

@test
function zeroStaticMutWithoutInitializerAcceptsScalars(): void {
  zeroAssertAccepted(
    "record Zeroed {\n  static mut A: i32;\n  static mut B: u8;\n  static mut C: u64;\n  static mut D: f32;\n  static mut E: f64;\n  static mut F: boolean;\n  static mut G: char;\n  static mut H: *mut u8;\n  static mut I: *i32;\n}\n\nfunction main(): i32 {\n  return Zeroed::A + (Zeroed::B as i32);\n}\n",
  );
}

@test
function zeroStaticMutWithoutInitializerAcceptsArraysRecordsAndPlainEnums(): void {
  zeroAssertAccepted(
    "@cLayout\nrecord Point {\n  public x: i32;\n  public y: i32;\n}\n\n@cLayout\nrecord Entry {\n  public offset: u16;\n  public gate: u8[8];\n  public origin: Point;\n}\n\nenum Level {\n  LOW,\n  HIGH,\n}\n\nrecord Zeroed {\n  static mut TABLE: Entry[256];\n  static mut ORIGIN: Point;\n  static mut LEVEL: Level;\n}\n\nfunction main(): i32 {\n  return Zeroed::ORIGIN.x;\n}\n",
  );
}

@test
function zeroStaticMutKeepsItsInitializerWhenItHasOne(): void {
  zeroAssertAccepted("record Zeroed {\n  static mut A: i32 = 5;\n  static mut B: u8[2] = [1, 2];\n}\n\nfunction main(): i32 {\n  return Zeroed::A;\n}\n");
}

@test
function zeroStaticMutWithoutInitializerRejectsStrings(): void {
  zeroAssertRejected("record Zeroed {\n  static mut NAME: str;\n}\n\nfunction main(): i32 {\n  return 0;\n}\n", "A0239");
}

@test
function zeroStaticMutWithoutInitializerRejectsReferences(): void {
  zeroAssertRejected("record Zeroed {\n  static mut LINK: &i32;\n}\n\nfunction main(): i32 {\n  return 0;\n}\n", "A0239");
}

@test
function zeroStaticMutWithoutInitializerRejectsValuesThatDrop(): void {
  zeroAssertRejected(
    "@implements(Drop)\nrecord Handle {\n  public id: i32;\n\n  public drop(&mut self): void {\n    return;\n  }\n}\n\nrecord Zeroed {\n  static mut HANDLE: Handle;\n}\n\nfunction main(): i32 {\n  return 0;\n}\n",
    "A0239",
  );
}

@test
function zeroStaticMutWithoutInitializerRejectsArraysOfValuesThatDrop(): void {
  zeroAssertRejected(
    "@implements(Drop)\nrecord Handle {\n  public id: i32;\n\n  public drop(&mut self): void {\n    return;\n  }\n}\n\nrecord Zeroed {\n  static mut HANDLES: Handle[2];\n}\n\nfunction main(): i32 {\n  return 0;\n}\n",
    "A0239",
  );
}

@test
function zeroStaticMutWithoutInitializerRejectsRecordsWithANonZeroableField(): void {
  zeroAssertRejected(
    "record Named {\n  public id: i32;\n  public name: str;\n}\n\nrecord Zeroed {\n  static mut ENTRY: Named;\n}\n\nfunction main(): i32 {\n  return 0;\n}\n",
    "A0239",
  );
}

@test
function zeroStaticMutWithoutInitializerRejectsEnumsWithPayloads(): void {
  zeroAssertRejected(
    "enum Shape {\n  CIRCLE(i32),\n  EMPTY,\n}\n\nrecord Zeroed {\n  static mut SHAPE: Shape;\n}\n\nfunction main(): i32 {\n  return 0;\n}\n",
    "A0239",
  );
}

@test
function zeroStaticMutWithoutInitializerRejectsRanges(): void {
  zeroAssertRejected("record Zeroed {\n  static mut SPAN: Range<i32>;\n}\n\nfunction main(): i32 {\n  return 0;\n}\n", "A0239");
}

@test
function zeroedAcceptsScalarsArraysRecordsAndPlainEnums(): void {
  zeroAssertAccepted(
    "record Point {\n  public x: i32;\n  public y: i32;\n}\n\nenum Level {\n  LOW,\n  HIGH,\n}\n\nfunction main(): i32 {\n  let a: u32 = @zeroed<u32>();\n  let b: f64 = @zeroed<f64>();\n  let c: boolean = @zeroed<boolean>();\n  let d: *mut u8 = @zeroed<*mut u8>();\n  let e: u8[32] = @zeroed<u8[32]>();\n  let f: Point = @zeroed<Point>();\n  let g: Level = @zeroed<Level>();\n\n  return a as i32;\n}\n",
  );
}

@test
function zeroedTakesTheTypeOfItsTypeArgument(): void {
  zeroAssertRejected("function main(): i32 {\n  let value: u8 = @zeroed<u32>();\n\n  return 0;\n}\n", DiagnosticCode::TYPE_MISMATCH);
}

@test
function zeroedAcceptsStaticInitializers(): void {
  zeroAssertAccepted(
    "record Point {\n  public x: i32;\n  public y: i32;\n}\n\nrecord Tables {\n  static mut STACK: u8[64] = @zeroed<u8[64]>();\n  static mut ORIGIN: Point = @zeroed<Point>();\n  static mut COUNT: u32 = @zeroed<u32>();\n  static ROWS: u8[4] = @zeroed<u8[4]>();\n}\n\nfunction main(): i32 {\n  return Tables::ORIGIN.x;\n}\n",
  );
}

@test
function zeroedRejectsStrings(): void {
  zeroAssertRejected("function main(): i32 {\n  let name: str = @zeroed<str>();\n\n  return 0;\n}\n", "A0239");
}

@test
function zeroedRejectsReferences(): void {
  zeroAssertRejected("function main(): i32 {\n  let link: &i32 = @zeroed<&i32>();\n\n  return 0;\n}\n", "A0239");
}

@test
function zeroedRejectsValuesThatDrop(): void {
  zeroAssertRejected(
    "@implements(Drop)\nrecord Handle {\n  public id: i32;\n\n  public drop(&mut self): void {\n    return;\n  }\n}\n\nfunction main(): i32 {\n  let handle: Handle = @zeroed<Handle>();\n\n  return 0;\n}\n",
    "A0239",
  );
}

@test
function zeroedRejectsEnumsWithPayloads(): void {
  zeroAssertRejected(
    "enum Shape {\n  CIRCLE(i32),\n  EMPTY,\n}\n\nfunction main(): i32 {\n  let shape: Shape = @zeroed<Shape>();\n\n  return 0;\n}\n",
    "A0239",
  );
}

@test
function zeroedTakesOneTypeArgumentAndNoValueArguments(): void {
  zeroAssertRejected("function main(): i32 {\n  let value: i32 = @zeroed<i32>(1);\n\n  return value;\n}\n", DiagnosticCode::BUILTIN_ARG_COUNT);
  zeroAssertRejected("function main(): i32 {\n  let value: i32 = @zeroed();\n\n  return value;\n}\n", DiagnosticCode::GENERIC_ARITY_MISMATCH);
}

@test
function splatAcceptsArraysOfCopyElements(): void {
  zeroAssertAccepted(
    "@cLayout\nrecord Gate {\n  public offset: u16;\n  public flags: u8;\n}\n\nfunction main(): i32 {\n  let a: u8[8] = @splat<u8[8]>(1);\n  let b: u32[3] = @splat<u32[3]>(7);\n  let c: Gate[2] = @splat<Gate[2]>(Gate { offset: 1, flags: 2 });\n  let d: f64[2] = @splat<f64[2]>(0.5);\n\n  return a[0] as i32;\n}\n",
  );
}

@test
function splatAcceptsStaticInitializersAtTheElementLimit(): void {
  zeroAssertAccepted(
    "record Tables {\n  static mut BIG: u8[65536] = @splat<u8[65536]>(1);\n  static mut ZEROS: u16[100000] = @splat<u16[100000]>(0);\n  static ROWS: u8[3] = @splat<u8[3]>(9);\n}\n\nfunction main(): i32 {\n  return Tables::BIG[0] as i32;\n}\n",
  );
}

@test
function splatRejectsATypeArgumentThatIsNotAnArray(): void {
  zeroAssertRejected("function main(): i32 {\n  let value: u8 = @splat<u8>(1);\n\n  return 0;\n}\n", "A0241");
}

@test
function splatRejectsAValueOfTheWrongType(): void {
  zeroAssertRejected("function main(): i32 {\n  let value: u8[4] = @splat<u8[4]>(true);\n\n  return 0;\n}\n", DiagnosticCode::TYPE_MISMATCH);
}

@test
function splatRejectsElementsThatAreNotCopy(): void {
  zeroAssertRejected(
    "@implements(Drop)\nrecord Handle {\n  public id: i32;\n\n  public drop(&mut self): void {\n    return;\n  }\n}\n\nfunction main(): i32 {\n  let handles: Handle[2] = @splat<Handle[2]>(Handle { id: 1 });\n\n  return 0;\n}\n",
    "A0242",
  );
}

@test
function splatTakesOneTypeArgumentAndOneValueArgument(): void {
  zeroAssertRejected("function main(): i32 {\n  let value: u8[4] = @splat<u8[4]>();\n\n  return 0;\n}\n", DiagnosticCode::BUILTIN_ARG_COUNT);
  zeroAssertRejected("function main(): i32 {\n  let value: u8[4] = @splat<u8[4]>(1, 2);\n\n  return 0;\n}\n", DiagnosticCode::BUILTIN_ARG_COUNT);
  zeroAssertRejected("function main(): i32 {\n  let value: u8[4] = @splat(1);\n\n  return 0;\n}\n", DiagnosticCode::GENERIC_ARITY_MISMATCH);
}

@test
function splatRejectsANonZeroStaticInitializerOverTheElementLimit(): void {
  zeroAssertRejected("record Tables {\n  static mut HUGE: u8[65537] = @splat<u8[65537]>(1);\n}\n\nfunction main(): i32 {\n  return 0;\n}\n", "A0240");
}

@test
function splatRejectsANonConstantValueInAStaticMutInitializer(): void {
  zeroAssertRejected(
    "function pick(): u8 {\n  return 1;\n}\n\nrecord Tables {\n  static mut MARKS: u8[4] = @splat<u8[4]>(pick());\n}\n\nfunction main(): i32 {\n  return 0;\n}\n",
    DiagnosticCode::STATIC_MUT_NON_CONSTANT_INITIALIZER,
  );
}
