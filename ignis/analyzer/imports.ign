import
  Diagnostic,
  DiagnosticBag,
  DiagnosticCode,
  LabelKind,
  Severity,
  SourceSpan,
from "@compiler::diagnostics";
import HashMap from "std::collections";

export namespace Analyzer {
  namespace Imports {
    enum ModuleKind {
      PROJECT,
      STD,
    }

    record ModuleInfo {
      public index: u64;
      public pathText: String;
      public kind: Analyzer::Imports::ModuleKind;
    }

    record ImportedName {
      public localName: Analyzer::SymbolId;
      public sourceName: Analyzer::SymbolId;
      public targetModule: u64;
      public targetDef: Analyzer::DefinitionId;
      public importSpan: SourceSpan;
      public sourceSpan: SourceSpan;
    }

    record ImportOverlay {
      public syms: Vector<Analyzer::SymbolId>;
      public defs: Vector<Analyzer::DefinitionId>;
      public spans: Vector<SourceSpan>;
      public targets: Vector<u64>;
      /// The path each entry is written as, `Outer::Inner::Name`, so a
      /// qualified reference can tell apart declarations that share a bare
      /// name across namespaces. Empty for an entry bound by a plain import.
      public qualifiedNames: Vector<String>;
      /// True for an entry no import line names: a namespace member, a
      /// discard-imported declaration, or a prelude seed. Implicit entries
      /// are exempt from the unused-import lint — the writer never wrote
      /// them, so there is nothing for them to remove.
      public implicit: Vector<boolean>;
    }

    record DirectDeclarationIndex {
      public syms: Vector<Analyzer::SymbolId>;
      public defs: Vector<Analyzer::DefinitionId>;
      public spans: Vector<SourceSpan>;
      /// `Outer::Inner::Name` for a nested declaration, the bare name for a
      /// top-level one. Parallel to `syms`.
      public qualifiedNames: Vector<String>;
    }

    /// Whether the overlay already binds `name`, readable through a mutable
    /// borrow so a seeding walk can ask while it is still filling the overlay.
    function overlayHasName(
      overlay: &mut Analyzer::Imports::ImportOverlay,
      name: Analyzer::SymbolId
    ): boolean {
      let mut index: u64 = 0;

      while (index < overlay.syms.length()) {
        if (let Option::SOME(candidate) = overlay.syms.get(index)) {
          if (candidate.raw() == name.raw()) {
            return true;
          }
        }

        index += 1;
      }

      return false;
    }

    /// Program-wide index of every module's declarations by qualified name.
    ///
    /// Mirrors the host compiler's shared `NamespaceStore`: a namespace is one
    /// entity re-opened across files, so `Analyzer::Definition` written in a
    /// part file resolves even though that file imports nothing. Only
    /// qualified references consult this index — a bare name still needs an
    /// import or a local declaration.
    record ProgramQualifiedIndex {
      public syms: Vector<Analyzer::SymbolId>;
      public defs: Vector<Analyzer::DefinitionId>;
      public qualifiedNames: Vector<String>;
      /// Entry positions grouped by the raw symbol of the name they declare,
      /// in insertion order. Every lookup by symbol filters on that symbol
      /// first, so the bucket holds the same candidates the parallel vectors
      /// would have been scanned for, in the same order.
      public entriesBySym: HashMap<u32, Vector<u64>>;
    }

    function emptyProgramQualifiedIndex(): Analyzer::Imports::ProgramQualifiedIndex {
      return Analyzer::Imports::ProgramQualifiedIndex {
        syms: Vector::new<Analyzer::SymbolId>(),
        defs: Vector::new<Analyzer::DefinitionId>(),
        qualifiedNames: Vector::new<String>(),
        entriesBySym: HashMap::new<u32, Vector<u64>>(),
      };
    }

    /// Append one declaration, skipping an entry already present under the
    /// same name and written path (a re-export duplicates its original).
    function appendProgramQualifiedEntry(
      index: &mut Analyzer::Imports::ProgramQualifiedIndex,
      sym: Analyzer::SymbolId,
      def: Analyzer::DefinitionId,
      qualifiedName: String,
    ): void {
      if (qualifiedName.length() == 0) {
        return;
      }

      let symRaw: u32 = sym.raw();

      if (let Option::SOME(bucket) = index.entriesBySym.get(&symRaw)) {
        let mut i: u64 = 0;

        while (i < bucket.length()) {
          let mut entry: u64 = 0;

          if (let Option::SOME(position) = bucket.get(i)) {
            entry = *position;
          }

          if (let Option::SOME(existingQualified) = index.qualifiedNames.get(entry)) {
            if (existingQualified.equals(qualifiedName.toStr())) {
              return;
            }
          }

          i += 1;
        }
      }

      let mut indexRef: &mut Analyzer::Imports::ProgramQualifiedIndex = index;
      let position: u64 = indexRef.syms.length();

      indexRef.syms.push(sym);
      indexRef.defs.push(def);
      indexRef.qualifiedNames.push(qualifiedName);

      if (let Option::SOME(bucket) = indexRef.entriesBySym.getMut(&symRaw)) {
        let mut bucketRef: &mut Vector<u64> = bucket;
        bucketRef.push(position);
        return;
      }

      let mut bucket: Vector<u64> = Vector::new<u64>();
      bucket.push(position);
      indexRef.entriesBySym.insert(symRaw, bucket);
    }

    /// Whether `candidate` ends with `suffix`, byte for byte.
    function programPathEndsWith(candidate: &String, suffix: &String): boolean {
      if (suffix.length() > candidate.length()) {
        return false;
      }

      let tail: String = candidate.substringBytes(candidate.length() - suffix.length(), candidate.length());
      return tail.equals(suffix.toStr());
    }

    /// The declaration a written qualified path names in the program index.
    ///
    /// `writtenPath` may omit leading namespaces: `Typecheck::TypecheckState`
    /// matches `Analyzer::Typecheck::TypecheckState` the same way the import
    /// overlay's partial qualification does.
    function programQualifiedFind(
      index: &Analyzer::Imports::ProgramQualifiedIndex,
      sym: Analyzer::SymbolId,
      writtenPath: &String,
    ): Option<Analyzer::DefinitionId> {
      let suffix: String = `::${writtenPath.toStr()}`;
      let symRaw: u32 = sym.raw();

      let Option::SOME(bucket) = index.entriesBySym.get(&symRaw) else {
        return Option::NONE;
      };

      let mut position: u64 = 0;

      while (position < bucket.length()) {
        let mut i: u64 = 0;

        if (let Option::SOME(entry) = bucket.get(position)) {
          i = *entry;
        }

        position += 1;

        let Option::SOME(candidate) = index.qualifiedNames.get(i) else {
          continue;
        };

        if (candidate.equals(writtenPath.toStr()) || Analyzer::Imports::programPathEndsWith(candidate, &suffix)) {
          let Option::SOME(defId) = index.defs.get(i) else {
            continue;
          };

          return Option::SOME(*defId);
        }
      }

      return Option::NONE;
    }

    function emptyOverlay(): Analyzer::Imports::ImportOverlay {
      return Analyzer::Imports::ImportOverlay {
        syms: Vector::new<Analyzer::SymbolId>(),
        defs: Vector::new<Analyzer::DefinitionId>(),
        spans: Vector::new<SourceSpan>(),
        targets: Vector::new<u64>(),
        qualifiedNames: Vector::new<String>(),
        implicit: Vector::new<boolean>(),
      };
    }

    function emptyDirectDeclarationIndex(): Analyzer::Imports::DirectDeclarationIndex {
      return Analyzer::Imports::DirectDeclarationIndex {
        syms: Vector::new<Analyzer::SymbolId>(),
        defs: Vector::new<Analyzer::DefinitionId>(),
        spans: Vector::new<SourceSpan>(),
        qualifiedNames: Vector::new<String>(),
      };
    }

    function directIndexFind(
      direct: &Analyzer::Imports::DirectDeclarationIndex,
      sym: Analyzer::SymbolId,
    ): Option<Analyzer::DefinitionId> {
      let mut index: u64 = 0;

      while (index < direct.syms.length()) {
        let Option::SOME(existing) = direct.syms.get(index) else {
          index += 1;
          continue;
        };

        if (existing.raw() == sym.raw()) {
          let Option::SOME(defId) = direct.defs.get(index) else {
            return Option::NONE;
          };
          return Option::SOME(*defId);
        }

        index += 1;
      }

      return Option::NONE;
    }

    function directIndexSpan(
      direct: &Analyzer::Imports::DirectDeclarationIndex,
      sym: Analyzer::SymbolId,
    ): Option<SourceSpan> {
      let mut index: u64 = 0;

      while (index < direct.syms.length()) {
        let Option::SOME(existing) = direct.syms.get(index) else {
          index += 1;
          continue;
        };

        if (existing.raw() == sym.raw()) {
          let Option::SOME(span) = direct.spans.get(index) else {
            return Option::NONE;
          };
          return Option::SOME(*span);
        }

        index += 1;
      }

      return Option::NONE;
    }

    function overlayContains(
      overlay: &Analyzer::Imports::ImportOverlay,
      sym: Analyzer::SymbolId,
    ): boolean {
      return Analyzer::Imports::overlaySpan(overlay, sym).isSome();
    }

    function overlaySpan(
      overlay: &Analyzer::Imports::ImportOverlay,
      sym: Analyzer::SymbolId,
    ): Option<SourceSpan> {
      let mut index: u64 = 0;

      while (index < overlay.syms.length()) {
        let Option::SOME(existing) = overlay.syms.get(index) else {
          index += 1;
          continue;
        };

        if (existing.raw() != sym.raw()) {
          index += 1;
          continue;
        }

        // Only an explicitly written binding counts for duplicate reporting:
        // an implicit entry (namespace member, discard import, prelude seed)
        // is shadowed silently by a written import of the same name.
        let mut entryImplicit: boolean = false;
        if (let Option::SOME(implicitFlag) = overlay.implicit.get(index)) {
          entryImplicit = *implicitFlag;
        }

        if (entryImplicit) {
          index += 1;
          continue;
        }

        let Option::SOME(span) = overlay.spans.get(index) else {
          return Option::NONE;
        };
        return Option::SOME(*span);
      }

      return Option::NONE;
    }

    function appendOverlayEntry(
      overlay: &mut Analyzer::Imports::ImportOverlay,
      localName: Analyzer::SymbolId,
      targetDef: Analyzer::DefinitionId,
      importSpan: SourceSpan,
      targetModule: u64,
    ): void {
      Analyzer::Imports::appendQualifiedOverlayEntry(
        overlay,
        localName,
        targetDef,
        importSpan,
        targetModule,
        String::create(""),
        false,
      );
    }

    /// Append an overlay entry that also records the path it is written as.
    ///
    /// A member brought in with its namespace carries `Outer::Inner::Name`; a
    /// name an import statement lists carries nothing, because the writer
    /// refers to it by that bare name.
    function appendQualifiedOverlayEntry(
      overlay: &mut Analyzer::Imports::ImportOverlay,
      localName: Analyzer::SymbolId,
      targetDef: Analyzer::DefinitionId,
      importSpan: SourceSpan,
      targetModule: u64,
      qualifiedName: String,
      implicit: boolean,
    ): void {
      let mut overlayRef: &mut Analyzer::Imports::ImportOverlay = overlay;
      overlayRef.syms.push(localName);
      overlayRef.defs.push(targetDef);
      overlayRef.spans.push(importSpan);
      overlayRef.targets.push(targetModule);
      overlayRef.qualifiedNames.push(qualifiedName);
      overlayRef.implicit.push(implicit);
    }

    function appendDirectIndexEntryIfMissing(
      direct: &mut Analyzer::Imports::DirectDeclarationIndex,
      sym: Analyzer::SymbolId,
      def: Analyzer::DefinitionId,
      span: SourceSpan,
      qualifiedName: String,
    ): void {
      // Same bare name under different written paths must coexist —
      // `__fcntl::fcntl` and `LibC::File::fcntl` are distinct declarations.
      // Only an entry repeating both the name and the path is a duplicate.
      let mut index: u64 = 0;
      while (index < direct.syms.length()) {
        let Option::SOME(existing) = direct.syms.get(index) else {
          index += 1;
          continue;
        };

        if (existing.raw() != sym.raw()) {
          index += 1;
          continue;
        }

        // Overloads share both the name and the path; only the exact same
        // definition arriving twice is a duplicate.
        let mut sameDef: boolean = false;
        if (let Option::SOME(existingDef) = direct.defs.get(index)) {
          sameDef = existingDef.raw() == def.raw();
        }

        if (sameDef) {
          if (let Option::SOME(existingQualified) = direct.qualifiedNames.get(index)) {
            if (existingQualified.equals(qualifiedName.toStr())) {
              return;
            }
          }
        }

        index += 1;
      }

      let mut directRef: &mut Analyzer::Imports::DirectDeclarationIndex = direct;
      directRef.syms.push(sym);
      directRef.defs.push(def);
      directRef.spans.push(span);
      directRef.qualifiedNames.push(qualifiedName);
    }

    function appendImportMissingDiagnostic(
      diagnostics: &mut DiagnosticBag,
      name: str,
      modulePath: str,
      span: SourceSpan,
    ): void {
      let message: String = `Symbol '${name}' is not exported from module '${modulePath}'`;
      let mut diagnostic: Diagnostic = Diagnostic::new(
        Severity::ERROR,
        DiagnosticCode::SYMBOL_NOT_EXPORTED,
        message.toStr(),
        span,
      );
      diagnostic.addLabel(LabelKind::PRIMARY, span, "import binding not found in target module");
      diagnostic.addNote(`target module: ${modulePath}`.toStr());

      let mut diagnosticsRef: &mut DiagnosticBag = diagnostics;
      diagnosticsRef.push(diagnostic);
    }

    function appendImportSourceDiagnostic(
      diagnostics: &mut DiagnosticBag,
      modulePath: str,
      span: SourceSpan,
    ): void {
      let message: String = `Module '${modulePath}' not found`;
      let mut diagnostic: Diagnostic = Diagnostic::new(
        Severity::ERROR,
        DiagnosticCode::MODULE_NOT_FOUND,
        message.toStr(),
        span,
      );
      diagnostic.addLabel(LabelKind::PRIMARY, span, "import source did not resolve to a prior module");

      let mut diagnosticsRef: &mut DiagnosticBag = diagnostics;
      diagnosticsRef.push(diagnostic);
    }

    function appendImportConflictDiagnostic(
      diagnostics: &mut DiagnosticBag,
      name: str,
      span: SourceSpan,
      previousSpan: SourceSpan,
      label: str,
    ): void {
      let message: String = `Import '${name}' shadows a local definition`;
      let mut diagnostic: Diagnostic = Diagnostic::new(
        Severity::ERROR,
        DiagnosticCode::DUPLICATE_IMPORT_NAME,
        message.toStr(),
        span,
      );
      diagnostic.addLabel(LabelKind::PRIMARY, span, label);
      diagnostic.addLabel(LabelKind::SECONDARY, previousSpan, "first binding here");

      let mut diagnosticsRef: &mut DiagnosticBag = diagnostics;
      diagnosticsRef.push(diagnostic);
    }
  }
}
