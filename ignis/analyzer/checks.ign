import
  SourceSpan,
  Diagnostic,
  DiagnosticBag,
  Severity,
  DiagnosticCode,
  LabelKind,
from "@compiler::diagnostics";

import Ast from "@compiler::ast";
import CodegenReserved from "@compiler::codegen::reserved";
import Vector from "std::vector";

/// Extra-checks phase for the Ignis selfhost compiler.
///
/// Port of `crates/ignis_analyzer/src/checks.rs`. Runs after const-eval
/// (mirroring the Rust phase order typecheck -> const_eval -> extra_checks)
/// because divergence detection reads checked expression types from
/// `TypecheckOutput.exprTypes`: an expression whose checked type is `NEVER`
/// (today `@panic`/`@trap`/`@unreachable` and fully-diverging joins) always
/// terminates.
///
/// Ported checks:
///   - missing return (A0039): a function or record/enum method whose
///     resolved return type is neither `void` nor `never` must have a body
///     whose termination is `ALWAYS`,
///   - `let else` must diverge (A0168): the else block's termination must be
///     `ALWAYS`,
///   - unreachable code (A0025): every statement after a terminator
///     (`return`/`break`/`continue` or a `NEVER`-typed expression statement)
///     inside a block, one diagnostic per unreachable statement like the
///     Rust oracle,
///   - try operator inside `defer` (A0184): a postfix `!` anywhere inside a
///     deferred statement.
///
/// Scoped out relative to the Rust oracle:
///   - break/continue outside a loop (the selfhost typechecker already emits
///     `BREAK_OUTSIDE_LOOP` A0040 and `CONTINUE_OUTSIDE_LOOP` A0041;
///     porting them here would
///     double-diagnose),
///   - the `UndeclaredVariable` re-check (the body resolver owns it),
///   - `@test`/directive function-shape validation (the selfhost has no
///     directive metadata on definitions),
///   - extern-with-body and extern-const-initializer (the selfhost
///     `Ast::Item::Extern` carries only a name; extern members are parsed
///     signature-only, so neither shape is expressible),
///   - static/enum field initializer checks (the Rust code A0065 collides
///     with the selfhost `MISSING_RECORD_FIELD_INIT` A0065),
///   - return outside a function (A0042) and defer outside a function
///     (A0183): the selfhost grammar has no top-level statements — module
///     roots are items — so neither shape is expressible; A0183 stays
///     reserved in `DiagnosticCode` for numbering parity,
///   - trait method missing-return: the selfhost parser accepts trait
///     methods signature-only and synthesizes an empty block body, so there
///     are no trait default bodies to check (checking them would flag every
///     non-void trait signature),
///   - the Rust `while (true)` handling: the oracle treats every loop as
///     `SOMETIMES` terminating, and this port mirrors that.
export namespace Analyzer {
  namespace Checks {
    /// Control-flow termination status. `ALWAYS` means every path through
    /// the statement diverges (returns, breaks, continues, or panics).
    enum Termination {
      ALWAYS,
      SOMETIMES,
    }

    /// Output of the extra-checks phase.
    record ChecksOutput {
      public diagnostics: DiagnosticBag;
    }

    /// Once a sequence has diverged it stays diverged.
    function mergeSequential(
      first: Analyzer::Checks::Termination,
      second: Analyzer::Checks::Termination,
    ): Analyzer::Checks::Termination {
      if (first == Analyzer::Checks::Termination::ALWAYS) {
        return Analyzer::Checks::Termination::ALWAYS;
      }

      return second;
    }

    /// Both branches must diverge for the parallel merge to diverge.
    function mergeParallel(
      first: Analyzer::Checks::Termination,
      second: Analyzer::Checks::Termination,
    ): Analyzer::Checks::Termination {
      if (first == Analyzer::Checks::Termination::ALWAYS && second == Analyzer::Checks::Termination::ALWAYS) {
        return Analyzer::Checks::Termination::ALWAYS;
      }

      return Analyzer::Checks::Termination::SOMETIMES;
    }

    function emitError(
      diagnostics: &mut DiagnosticBag,
      span: SourceSpan,
      code: str,
      message: str,
      labelMessage: str,
    ): void {
      let mut diagnostic: Diagnostic = Diagnostic::new(
        Severity::ERROR,
        code,
        message,
        span,
      );
      diagnostic.addLabel(LabelKind::PRIMARY, span, labelMessage);

      let mut bag: &mut DiagnosticBag = diagnostics;
      bag.push(diagnostic);
    }

    function emitWarning(
      diagnostics: &mut DiagnosticBag,
      span: SourceSpan,
      code: str,
      message: str,
      labelMessage: str,
    ): void {
      let mut diagnostic: Diagnostic = Diagnostic::new(
        Severity::WARNING,
        code,
        message,
        span,
      );
      diagnostic.addLabel(LabelKind::PRIMARY, span, labelMessage);

      let mut bag: &mut DiagnosticBag = diagnostics;
      bag.push(diagnostic);
    }

    /// Whether an expression's checked type is `NEVER`, using the
    /// last-write-wins lookup convention shared with `ConstEval` and the
    /// typechecker's own `lookupRecordedExprType`.
    function exprIsNever(
      typeStore: &mut Analyzer::TypeStore,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprId: Ast::ExpressionId,
    ): boolean {
      let Option::SOME(typeId) = typecheck.exprTypes.lookup(exprId.raw()) else {
        return false;
      };
      let Option::SOME(typeNode) = typeStore.get(typeId) else {
        return false;
      };

      return match (typeNode) {
        Analyzer::Type::NEVER -> true,
        _ -> false,
      };
    }

    function stmtSpan(module: &Ast::Module, stmtId: Ast::StatementId): SourceSpan {
      let Option::SOME(stmt) = module.statements.get(stmtId) else {
        return SourceSpan::detached(0, 0);
      };

      return Ast::Serializer::statementSpan(stmt);
    }

    /// Whether a statement is a terminator for the unreachable-code scan:
    /// `return`/`break`/`continue`, or an expression statement whose checked
    /// type is `NEVER` (mirroring the Rust `is_terminator`).
    function stmtIsTerminator(
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      stmtId: Ast::StatementId,
    ): boolean {
      let Option::SOME(stmt) = module.statements.get(stmtId) else {
        return false;
      };

      match (stmt) {
        Ast::Statement::Node::Return(_) -> {
          return true;
        },
        Ast::Statement::Node::Break(_) -> {
          return true;
        },
        Ast::Statement::Node::Continue(_) -> {
          return true;
        },
        Ast::Statement::Node::Expression(exprStmt) -> {
          return Analyzer::Checks::exprIsNever(typeStore, typecheck, exprStmt.expression);
        },
        _ -> {},
      };

      return false;
    }

    /// Sequential fold over a block's statements. A `NEVER`-typed tail
    /// expression also diverges: the Rust AST has no block tails, but a
    /// diverging tail is the tail-position spelling of the oracle's
    /// `NEVER`-typed expression statement.
    function blockTermination(
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      statements: &Vector<Ast::StatementId>,
      tail: &Option<Ast::ExpressionId>,
    ): Analyzer::Checks::Termination {
      let mut result: Analyzer::Checks::Termination = Analyzer::Checks::Termination::SOMETIMES;
      let mut index: u64 = 0;

      while (index < statements.length()) {
        let Option::SOME(stmtId) = statements.get(index) else {
          index += 1;
          continue;
        };

        let term: Analyzer::Checks::Termination = Analyzer::Checks::stmtTermination(
          typeStore,
          module,
          typecheck,
          *stmtId,
        );
        result = Analyzer::Checks::mergeSequential(result, term);

        if (result == Analyzer::Checks::Termination::ALWAYS) {
          return Analyzer::Checks::Termination::ALWAYS;
        }

        index += 1;
      }

      if (let Option::SOME(tailId) = tail) {
        if (Analyzer::Checks::exprIsNever(typeStore, typecheck, tailId)) {
          return Analyzer::Checks::Termination::ALWAYS;
        }
      }

      return result;
    }

    /// Mirrors the Rust `statement_termination` plus its `check_termination`
    /// never-typed entry check: `return`/`break`/`continue` always diverge,
    /// blocks fold sequentially, `if` merges branches in parallel (no `else`
    /// is `SOMETIMES`), loops and everything else are `SOMETIMES`, and an
    /// expression statement diverges exactly when its expression types
    /// `NEVER`.
    function stmtTermination(
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      stmtId: Ast::StatementId,
    ): Analyzer::Checks::Termination {
      let Option::SOME(stmt) = module.statements.get(stmtId) else {
        return Analyzer::Checks::Termination::SOMETIMES;
      };

      match (stmt) {
        Ast::Statement::Node::Return(_) -> {
          return Analyzer::Checks::Termination::ALWAYS;
        },
        Ast::Statement::Node::Break(_) -> {
          return Analyzer::Checks::Termination::ALWAYS;
        },
        Ast::Statement::Node::Continue(_) -> {
          return Analyzer::Checks::Termination::ALWAYS;
        },
        Ast::Statement::Node::Block(block) -> {
          return Analyzer::Checks::blockTermination(
            typeStore,
            module,
            typecheck,
            &block.statements,
            &block.tail,
          );
        },
        Ast::Statement::Node::If(ifStmt) -> {
          let thenTerm: Analyzer::Checks::Termination = Analyzer::Checks::stmtTermination(
            typeStore,
            module,
            typecheck,
            ifStmt.thenBranch,
          );

          if (let Option::SOME(elseId) = ifStmt.elseBranch) {
            let elseTerm: Analyzer::Checks::Termination = Analyzer::Checks::stmtTermination(
              typeStore,
              module,
              typecheck,
              elseId,
            );

            return Analyzer::Checks::mergeParallel(thenTerm, elseTerm);
          }

          return Analyzer::Checks::Termination::SOMETIMES;
        },
        Ast::Statement::Node::Expression(exprStmt) -> {
          if (Analyzer::Checks::exprIsNever(typeStore, typecheck, exprStmt.expression)) {
            return Analyzer::Checks::Termination::ALWAYS;
          }

          // A statement-position match whose every unguarded arm always
          // terminates cannot fall through — statement matches record no
          // expression type, so the never-check above cannot see them.
          if (let Option::SOME(exprNode) = module.expressions.get(exprStmt.expression)) {
            if (let Ast::Expression::Node::Match(matchExpr) = exprNode) {
              if (Analyzer::Checks::matchAlwaysTerminates(typeStore, module, typecheck, &matchExpr)) {
                return Analyzer::Checks::Termination::ALWAYS;
              }
            }
          }

          return Analyzer::Checks::Termination::SOMETIMES;
        },
        _ -> {},
      };

      return Analyzer::Checks::Termination::SOMETIMES;
    }

    // =========================================================================
    // Walkers
    // =========================================================================

    /// Shared unreachable-code scan and recursion for statement blocks and
    /// expression blocks. Emits one A0025 per statement after a terminator,
    /// like the Rust oracle's per-statement loop.
    function walkBlockParts(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      statements: &Vector<Ast::StatementId>,
      tail: &Option<Ast::ExpressionId>,
      inDefer: boolean,
    ): void {
      let mut foundTerminator: boolean = false;
      let mut index: u64 = 0;

      while (index < statements.length()) {
        let Option::SOME(stmtId) = statements.get(index) else {
          index += 1;
          continue;
        };

        if (foundTerminator) {
          Analyzer::Checks::emitWarning(
            diagnostics,
            Analyzer::Checks::stmtSpan(module, *stmtId),
            DiagnosticCode::UNREACHABLE_CODE,
            "Unreachable code detected",
            "Unreachable code detected",
          );
        }

        Analyzer::Checks::walkStmt(
          diagnostics,
          defStore,
          typeStore,
          module,
          pass1,
          pass2,
          typecheck,
          *stmtId,
          inDefer,
        );

        if (Analyzer::Checks::stmtIsTerminator(typeStore, module, typecheck, *stmtId)) {
          foundTerminator = true;
        }

        index += 1;
      }

      if (let Option::SOME(tailId) = tail) {
        Analyzer::Checks::walkExpr(
          diagnostics,
          defStore,
          typeStore,
          module,
          pass1,
          pass2,
          typecheck,
          tailId,
          inDefer,
        );
      }
    }

    function walkOptionalExpr(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprIdOpt: &Option<Ast::ExpressionId>,
      inDefer: boolean,
    ): void {
      if (let Option::SOME(exprId) = exprIdOpt) {
        Analyzer::Checks::walkExpr(
          diagnostics,
          defStore,
          typeStore,
          module,
          pass1,
          pass2,
          typecheck,
          exprId,
          inDefer,
        );
      }
    }

    function walkExprList(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprIds: &Vector<Ast::ExpressionId>,
      inDefer: boolean,
    ): void {
      let mut index: u64 = 0;

      while (index < exprIds.length()) {
        let Option::SOME(exprId) = exprIds.get(index) else {
          index += 1;
          continue;
        };

        Analyzer::Checks::walkExpr(
          diagnostics,
          defStore,
          typeStore,
          module,
          pass1,
          pass2,
          typecheck,
          *exprId,
          inDefer,
        );

        index += 1;
      }
    }

    function walkStmt(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      stmtId: Ast::StatementId,
      inDefer: boolean,
    ): void {
      let Option::SOME(stmt) = module.statements.get(stmtId) else {
        return;
      };

      match (stmt) {
        Ast::Statement::Node::Variable(variable) -> {
          Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &variable.value, inDefer);
        },
        Ast::Statement::Node::Let(letStmt) -> {
          Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &letStmt.value, inDefer);
        },
        Ast::Statement::Node::LetElse(letElse) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, letElse.value, inDefer);
          Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, letElse.elseBranch, inDefer);

          let elseTerm: Analyzer::Checks::Termination = Analyzer::Checks::stmtTermination(
            typeStore,
            module,
            typecheck,
            letElse.elseBranch,
          );

          if (elseTerm != Analyzer::Checks::Termination::ALWAYS) {
            Analyzer::Checks::emitError(
              diagnostics,
              Analyzer::Checks::stmtSpan(module, letElse.elseBranch),
              DiagnosticCode::LET_ELSE_MUST_DIVERGE,
              "`let else` requires an else block that always diverges",
              "`let else` requires an else block that always diverges",
            );
          }
        },
        Ast::Statement::Node::Expression(exprStmt) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, exprStmt.expression, inDefer);
        },
        Ast::Statement::Node::Block(block) -> {
          Analyzer::Checks::walkBlockParts(
            diagnostics,
            defStore,
            typeStore,
            module,
            pass1,
            pass2,
            typecheck,
            &block.statements,
            &block.tail,
            inDefer,
          );
        },
        Ast::Statement::Node::If(ifStmt) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, ifStmt.condition, inDefer);
          Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, ifStmt.thenBranch, inDefer);

          if (let Option::SOME(elseId) = ifStmt.elseBranch) {
            Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, elseId, inDefer);
          }
        },
        Ast::Statement::Node::While(whileStmt) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, whileStmt.condition, inDefer);
          Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, whileStmt.body, inDefer);
        },
        Ast::Statement::Node::For(forStmt) -> {
          if (let Option::SOME(initializerId) = forStmt.initializer) {
            Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, initializerId, inDefer);
          }

          Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &forStmt.condition, inDefer);
          Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &forStmt.update, inDefer);
          Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, forStmt.body, inDefer);
        },
        Ast::Statement::Node::ForOf(forOf) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, forOf.iterable, inDefer);
          Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, forOf.body, inDefer);
        },
        Ast::Statement::Node::Return(returnStmt) -> {
          Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &returnStmt.value, inDefer);
        },
        Ast::Statement::Node::Break(breakStmt) -> {
          Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &breakStmt.value, inDefer);
        },
        Ast::Statement::Node::Continue(_) -> {},
        Ast::Statement::Node::Defer(deferStmt) -> {
          Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, deferStmt.statement, true);
        },
        Ast::Statement::Node::Item(itemStmt) -> {
          Analyzer::Checks::checkItem(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, itemStmt.item);
        },
        Ast::Statement::Node::Comment(_) -> {},
        Ast::Statement::Node::Asm(asmNode) -> {
          Analyzer::Checks::walkAsmInputs(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &asmNode, inDefer);
        },
      };
    }

    /// Walks the input expressions of an `asm`, the only expressions it holds.
    function walkAsmInputs(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      asmNode: &Ast::Expression::Asm,
      inDefer: boolean,
    ): void {
      let mut index: u64 = 0;

      while (index < asmNode.inputs.length()) {
        if (let Option::SOME(input) = asmNode.inputs.get(index)) {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, input.expression, inDefer);
        }

        index += 1;
      }
    }

    function walkExpr(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      exprId: Ast::ExpressionId,
      inDefer: boolean,
    ): void {
      let Option::SOME(expression) = module.expressions.get(exprId) else {
        return;
      };

      match (expression) {
        Ast::Expression::Node::Assignment(assignment) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, assignment.target, inDefer);
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, assignment.value, inDefer);
        },
        Ast::Expression::Node::Ternary(ternary) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, ternary.condition, inDefer);
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, ternary.thenBranch, inDefer);
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, ternary.elseBranch, inDefer);
        },
        Ast::Expression::Node::Cast(cast) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, cast.expression, inDefer);
        },
        Ast::Expression::Node::Literal(_) -> {},
        Ast::Expression::Node::Path(_) -> {},
        Ast::Expression::Node::Call(call) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, call.callee, inDefer);
          Analyzer::Checks::walkExprList(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &call.arguments, inDefer);
        },
        Ast::Expression::Node::Binary(binaryExpr) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, binaryExpr.left, inDefer);
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, binaryExpr.right, inDefer);
        },
        Ast::Expression::Node::Dereference(dereference) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, dereference.operand, inDefer);
        },
        Ast::Expression::Node::Grouped(grouped) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, grouped.expression, inDefer);
        },
        Ast::Expression::Node::Tuple(tuple) -> {
          Analyzer::Checks::walkExprList(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &tuple.elements, inDefer);
        },
        Ast::Expression::Node::Unit(_) -> {},
        Ast::Expression::Node::LetCondition(letCondition) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, letCondition.value, inDefer);
        },
        Ast::Expression::Node::Reference(reference) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, reference.target, inDefer);
        },
        Ast::Expression::Node::Unary(unary) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, unary.operand, inDefer);
        },
        Ast::Expression::Node::Block(block) -> {
          Analyzer::Checks::walkBlockParts(
            diagnostics,
            defStore,
            typeStore,
            module,
            pass1,
            pass2,
            typecheck,
            &block.statements,
            &block.tail,
            inDefer,
          );
        },
        Ast::Expression::Node::If(ifExpr) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, ifExpr.condition, inDefer);
          Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, ifExpr.thenBranch, inDefer);

          if (let Option::SOME(elseId) = ifExpr.elseBranch) {
            Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, elseId, inDefer);
          }
        },
        Ast::Expression::Node::Match(matchExpr) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, matchExpr.scrutinee, inDefer);

          let mut armIndex: u64 = 0;
          while (armIndex < matchExpr.arms.length()) {
            let Option::SOME(arm) = matchExpr.arms.get(armIndex) else {
              armIndex += 1;
              continue;
            };

            Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &arm.guard, inDefer);
            Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, arm.body, inDefer);
            armIndex += 1;
          }
        },
        Ast::Expression::Node::Variable(_) -> {},
        Ast::Expression::Node::Vector(vectorLiteral) -> {
          Analyzer::Checks::walkExprList(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &vectorLiteral.elements, inDefer);
        },
        Ast::Expression::Node::VectorAccess(access) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, access.vector, inDefer);
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, access.index, inDefer);
        },
        Ast::Expression::Node::PostfixIncrement(postfix) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, postfix.operand, inDefer);
        },
        Ast::Expression::Node::PostfixDecrement(postfix) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, postfix.operand, inDefer);
        },
        Ast::Expression::Node::MemberAccess(memberAccess) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, memberAccess.object, inDefer);
        },
        Ast::Expression::Node::RecordInit(recordInit) -> {
          let mut fieldIndex: u64 = 0;
          while (fieldIndex < recordInit.fields.length()) {
            let Option::SOME(field) = recordInit.fields.get(fieldIndex) else {
              fieldIndex += 1;
              continue;
            };

            Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, field.value, inDefer);
            fieldIndex += 1;
          }
        },
        Ast::Expression::Node::BuiltinCall(builtinCall) -> {
          Analyzer::Checks::walkExprList(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &builtinCall.arguments, inDefer);
        },
        Ast::Expression::Node::Lambda(lambda) -> {
          // A lambda body starts a fresh function context, so the defer flag
          // resets exactly like the Rust oracle's lambda arm.
          Analyzer::Checks::walkStmt(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, lambda.body, false);
        },
        Ast::Expression::Node::CaptureOverride(captureOverride) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, captureOverride.expression, inDefer);
        },
        Ast::Expression::Node::Pipe(pipe) -> {
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, pipe.left, inDefer);
          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, pipe.right, inDefer);
        },
        Ast::Expression::Node::PipePlaceholder(_) -> {},
        Ast::Expression::Node::Try(tryExpr) -> {
          if (inDefer) {
            Analyzer::Checks::emitError(
              diagnostics,
              tryExpr.span,
              DiagnosticCode::TRY_OPERATOR_IN_DEFER,
              "try operator `!` cannot be used inside a `defer` expression",
              "try operator `!` cannot be used inside a `defer` expression",
            );
          }

          Analyzer::Checks::walkExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, tryExpr.expression, inDefer);
        },
        Ast::Expression::Node::Range(range) -> {
          Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &range.start, inDefer);
          Analyzer::Checks::walkOptionalExpr(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &range.end, inDefer);
        },
        Ast::Expression::Node::Asm(asmNode) -> {
          Analyzer::Checks::walkAsmInputs(diagnostics, defStore, typeStore, module, pass1, pass2, typecheck, &asmNode, inDefer);
        },
      };
    }

    // =========================================================================
    // Item walk
    // =========================================================================

    /// `DefinitionId` for an item, consulting binder pass 2 first (methods
    /// and function completions live there) and falling back to pass 1.
    function findItemDef(
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
    ): Option<Analyzer::DefinitionId> {
      let pass2Result: Option<Analyzer::DefinitionId> = Analyzer::Binder::findDef(pass2, itemId.raw());
      if (pass2Result.isSome()) {
        return pass2Result;
      }

      return Analyzer::Binder::findDef(pass1, itemId.raw());
    }

    /// Resolved return type of a function or method definition.
    function definitionReturnType(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Function(functionDef) -> {
          return Option::SOME(functionDef.returnType);
        },
        Analyzer::Definition::Method(methodDef) -> {
          return Option::SOME(methodDef.returnType);
        },
        _ -> {
          return Option::NONE;
        },
      };

      return Option::NONE;
    }

    /// Whether a resolved return type exempts its function from the
    /// missing-return check: `void` never needs a return, and a `never`
    /// function is not expected to reach one. An unannotated return type
    /// keeps the binder's `VOID` sentinel and is therefore exempt too.
    function returnTypeIsExempt(
      typeStore: &mut Analyzer::TypeStore,
      returnTypeId: Analyzer::TypeId,
    ): boolean {
      let Option::SOME(typeNode) = typeStore.get(returnTypeId) else {
        return true;
      };

      return match (typeNode) {
        Analyzer::Type::VOID -> true,
        Analyzer::Type::NEVER -> true,
        _ -> false,
      };
    }

    /// Whether every arm of a match always terminates, so control cannot
    /// continue past the match. A guarded arm may not run, so any guard
    /// forfeits the guarantee.
    function matchAlwaysTerminates(
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      matchExpr: &Ast::Expression::Match,
    ): boolean {
      if (matchExpr.arms.length() == 0) {
        return false;
      }

      let mut armIndex: u64 = 0;

      while (armIndex < matchExpr.arms.length()) {
        let Option::SOME(arm) = matchExpr.arms.get(armIndex) else {
          return false;
        };

        if (arm.guard.isSome()) {
          return false;
        }

        if (!Analyzer::Checks::armBodyAlwaysTerminates(typeStore, module, typecheck, arm.body)) {
          return false;
        }

        armIndex += 1;
      }

      return true;
    }

    /// Whether one match-arm body always terminates: a never-typed
    /// expression, or a block one of whose statements always terminates.
    function armBodyAlwaysTerminates(
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      bodyExprId: Ast::ExpressionId,
    ): boolean {
      if (Analyzer::Checks::exprIsNever(typeStore, typecheck, bodyExprId)) {
        return true;
      }

      let Option::SOME(bodyNode) = module.expressions.get(bodyExprId) else {
        return false;
      };

      let Ast::Expression::Node::Block(block) = bodyNode else {
        return false;
      };

      let mut statementIndex: u64 = 0;

      while (statementIndex < block.statements.length()) {
        let Option::SOME(statementId) = block.statements.get(statementIndex) else {
          statementIndex += 1;
          continue;
        };

        if (Analyzer::Checks::stmtTermination(typeStore, module, typecheck, *statementId) == Analyzer::Checks::Termination::ALWAYS) {
          return true;
        }

        statementIndex += 1;
      }

      if (let Option::SOME(tailId) = block.tail) {
        return Analyzer::Checks::exprIsNever(typeStore, typecheck, tailId);
      }

      return false;
    }

    /// Missing-return check plus body walk for a function or method item.
    /// The diagnostic span is the whole item span — the closest selfhost
    /// equivalent of the Rust signature span.
    function checkFunction(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      itemId: Ast::ItemId,
      function_: &Ast::Item::Function,
    ): void {
      if (let Option::SOME(defId) = Analyzer::Checks::findItemDef(pass1, pass2, itemId)) {
        if (let Option::SOME(returnTypeId) = Analyzer::Checks::definitionReturnType(defStore, defId)) {
          let exempt: boolean = Analyzer::Checks::returnTypeIsExempt(typeStore, returnTypeId);
          let bodyTerm: Analyzer::Checks::Termination = Analyzer::Checks::stmtTermination(
            typeStore,
            module,
            typecheck,
            function_.body,
          );

          if (!exempt && bodyTerm != Analyzer::Checks::Termination::ALWAYS) {
            Analyzer::Checks::emitError(
              diagnostics,
              function_.span,
              DiagnosticCode::MISSING_RETURN_STATEMENT,
              "Missing return statement",
              "Function should return a value",
            );
          }
        }
      }

      Analyzer::Checks::walkStmt(
        diagnostics,
        defStore,
        typeStore,
        module,
        pass1,
        pass2,
        typecheck,
        function_.body,
        false,
      );
    }

    /// Run `checkFunction` over an owner's method items (records and enums).
    /// Trait methods are intentionally not visited: the selfhost parser is
    /// signature-only for traits and synthesizes empty block bodies.
    function checkMethods(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      methodItemIds: &Vector<Ast::ItemId>,
    ): void {
      let mut index: u64 = 0;

      while (index < methodItemIds.length()) {
        let Option::SOME(methodItemId) = methodItemIds.get(index) else {
          index += 1;
          continue;
        };

        let Option::SOME(item) = module.items.get(*methodItemId) else {
          index += 1;
          continue;
        };

        if (let Ast::Item::Node::Function(function_) = item) {
          Analyzer::Checks::checkFunction(
            diagnostics,
            defStore,
            typeStore,
            module,
            pass1,
            pass2,
            typecheck,
            *methodItemId,
            &function_,
          );
        }

        index += 1;
      }
    }

    // =========================================================================
    // C-layout records
    // =========================================================================

    /// Whether a value of `typeId` has a C representation a C-layout record
    /// can hold: an integer, a float, a boolean, a pointer, a function type, a
    /// C-layout record, or a fixed array of one of those. Aliases are followed;
    /// `depth` bounds a cyclic alias, which the resolver reports on its own.
    function hasCRepresentation(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
      depth: u64,
    ): boolean {
      if (depth > 64) {
        return false;
      }

      let mut verdict: boolean = false;
      let mut nested: Option<Analyzer::TypeId> = Option::NONE;
      let mut nominal: Option<Analyzer::DefinitionId> = Option::NONE;

      if (let Option::SOME(type_) = typeStore.get(typeId)) {
        verdict = match (type_) {
          Analyzer::Type::I8 -> true,
          Analyzer::Type::I16 -> true,
          Analyzer::Type::I32 -> true,
          Analyzer::Type::I64 -> true,
          Analyzer::Type::U8 -> true,
          Analyzer::Type::U16 -> true,
          Analyzer::Type::U32 -> true,
          Analyzer::Type::U64 -> true,
          Analyzer::Type::F32 -> true,
          Analyzer::Type::F64 -> true,
          Analyzer::Type::BOOLEAN -> true,
          Analyzer::Type::Pointer(_) -> true,
          Analyzer::Type::Function(_) -> true,
          _ -> false,
        };

        if (let Analyzer::Type::FixedArray(element, _) = type_) {
          nested = Option::SOME(element);
        }

        if (let Analyzer::Type::Record(defId) = type_) {
          nominal = Option::SOME(defId);
        }

        if (let Analyzer::Type::Alias(aliasDefId) = type_) {
          if (let Option::SOME(Analyzer::Definition::TypeAlias(aliasDef)) = defStore.get(aliasDefId)) {
            nested = Option::SOME(aliasDef.aliasedType);
          }
        }
      }

      if (let Option::SOME(defId) = nominal) {
        if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(defId)) {
          return recordDef.cLayout;
        }

        return false;
      }

      if (let Option::SOME(inner) = nested) {
        return Analyzer::Checks::hasCRepresentation(defStore, typeStore, inner, depth + 1);
      }

      return verdict;
    }

    /// Report each field of a C-layout record whose type has no C
    /// representation. `fieldIds` are the record's instance fields, in the
    /// order its non-static field bindings declare them.
    function checkCLayoutFields(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      record_: &Ast::Item::Record,
      fieldIds: &Vector<Analyzer::DefinitionId>,
      isExtern: boolean,
    ): void {
      let kind: str = isExtern ? "extern record" : "@cLayout record";
      let mut fieldPosition: u64 = 0;
      let mut patternIndex: u64 = 0;

      while (patternIndex < record_.fields.length()) {
        let Option::SOME(patternId) = record_.fields.get(patternIndex) else {
          patternIndex += 1;
          continue;
        };

        let Option::SOME(Ast::Pattern::Node::Binding(binding)) = module.patterns.get(*patternId) else {
          patternIndex += 1;
          continue;
        };

        if (Analyzer::Binder::fieldBindingIsStatic(&binding)) {
          patternIndex += 1;
          continue;
        }

        let fieldName: String = String::create(binding.name.toStr());

        if (CodegenReserved::isCKeyword(&fieldName)) {
          let message: String = `field '${binding.name.toStr()}' of ${kind} '${record_.name.toStr()}' is named by a C keyword`;
          Analyzer::Checks::emitError(
            diagnostics,
            binding.span,
            DiagnosticCode::C_LAYOUT_FIELD_RESERVED_NAME,
            message.toStr(),
            "a C-layout record keeps its written field names in C, so a field cannot be named by a C keyword",
          );
        }

        let mut fieldType: Option<Analyzer::TypeId> = Option::NONE;

        if (let Option::SOME(fieldId) = fieldIds.get(fieldPosition)) {
          if (let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldId)) {
            fieldType = Option::SOME(fieldDef.fieldType);
          }
        }

        if (let Option::SOME(typeId) = fieldType) {
          if (!Analyzer::Checks::hasCRepresentation(defStore, typeStore, typeId, 0)) {
            let message: String = `field '${binding.name.toStr()}' of ${kind} '${record_.name.toStr()}' has no C representation`;
            Analyzer::Checks::emitError(
              diagnostics,
              binding.span,
              DiagnosticCode::C_LAYOUT_FIELD_TYPE,
              message.toStr(),
              "a C-layout field must be an integer, float, boolean, pointer, function, C-layout record or fixed array of those",
            );
          }
        }

        fieldPosition += 1;
        patternIndex += 1;
      }
    }

    /// Check a record with a C layout once its field types are resolved.
    ///
    /// Every field needs a C representation. An extern record defines a C
    /// struct under its written name, which is global in C, so a second extern
    /// record with that name is reported wherever it is declared.
    function checkCLayoutRecord(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      record_: &Ast::Item::Record,
    ): void {
      let Option::SOME(defId) = Analyzer::Checks::findItemDef(pass1, pass2, itemId) else {
        return;
      };

      let mut fieldIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut cLayout: boolean = false;
      let mut isExtern: boolean = false;
      let mut nameSymbol: Option<Analyzer::SymbolId> = Option::NONE;

      if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(defId)) {
        cLayout = recordDef.cLayout;
        isExtern = recordDef.isExtern;
        nameSymbol = Option::SOME(recordDef.name);

        let mut copyIndex: u64 = 0;

        while (copyIndex < recordDef.fields.length()) {
          if (let Option::SOME(fieldId) = recordDef.fields.get(copyIndex)) {
            fieldIds.push(*fieldId);
          }

          copyIndex += 1;
        }
      }

      if (!cLayout) {
        return;
      }

      // A generic C-layout record is already an error, and its type
      // parameters have no C representation of their own to report.
      if (record_.genericParameters.isEmpty()) {
        Analyzer::Checks::checkCLayoutFields(diagnostics, defStore, typeStore, module, record_, &fieldIds, isExtern);
      }

      let Option::SOME(symbol) = nameSymbol else {
        return;
      };

      if (!isExtern) {
        return;
      }

      let candidates: Vector<Analyzer::DefinitionId> = defStore.definitionsNamed(symbol);
      let mut candidateIndex: u64 = 0;

      while (candidateIndex < candidates.length()) {
        let Option::SOME(candidate) = candidates.get(candidateIndex) else {
          candidateIndex += 1;
          continue;
        };

        if (candidate.raw() >= defId.raw()) {
          candidateIndex += 1;
          continue;
        }

        if (let Option::SOME(Analyzer::Definition::Record(other)) = defStore.get(*candidate)) {
          if (other.isExtern) {
            let message: String = `extern record '${record_.name.toStr()}' is already defined by another extern block`;
            Analyzer::Checks::emitError(
              diagnostics,
              record_.span,
              DiagnosticCode::DUPLICATE_EXTERN_RECORD,
              message.toStr(),
              "an extern record defines a C struct under its written name, which is global in C",
            );
            return;
          }
        }

        candidateIndex += 1;
      }
    }

    /// Check the records an extern block declares. Its functions and
    /// constants are signatures with nothing to check here.
    function checkExternRecords(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemIds: &Vector<Ast::ItemId>,
    ): void {
      let mut index: u64 = 0;

      while (index < itemIds.length()) {
        if (let Option::SOME(itemId) = itemIds.get(index)) {
          if (let Option::SOME(Ast::Item::Node::Record(record_)) = module.items.get(*itemId)) {
            Analyzer::Checks::checkCLayoutRecord(diagnostics, defStore, typeStore, module, pass1, pass2, *itemId, &record_);
          }
        }

        index += 1;
      }
    }

    function copyDefinitionIds(
      source: &Vector<Analyzer::DefinitionId>
    ): Vector<Analyzer::DefinitionId> {
      let mut copied: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        if (let Option::SOME(definition) = source.get(index)) {
          copied.push(*definition);
        }

        index += 1;
      }

      return copied;
    }

    /// The types a record's fields or an enum's variant payloads hold inline,
    /// with the owner's type parameters replaced by `typeArguments` when given.
    function nominalMemberTypes(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      owner: Analyzer::DefinitionId,
      typeArguments: &Vector<Analyzer::TypeId>,
    ): Vector<Analyzer::TypeId> {
      let mut memberIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut typeParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      match (defStore.get(owner)) {
        Option::SOME(Analyzer::Definition::Record(recordDef)) -> {
          memberIds = Analyzer::Checks::copyDefinitionIds(&recordDef.fields);
          typeParams = Analyzer::Checks::copyDefinitionIds(&recordDef.typeParams);
        },
        Option::SOME(Analyzer::Definition::Enum(enumDef)) -> {
          memberIds = Analyzer::Checks::copyDefinitionIds(&enumDef.variants);
          typeParams = Analyzer::Checks::copyDefinitionIds(&enumDef.typeParams);
        },
        _ -> {},
      };

      let mut declared: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut memberIndex: u64 = 0;

      while (memberIndex < memberIds.length()) {
        if (let Option::SOME(memberId) = memberIds.get(memberIndex)) {
          match (defStore.get(*memberId)) {
            Option::SOME(Analyzer::Definition::Field(fieldDef)) -> {
              declared.push(fieldDef.fieldType);
            },
            Option::SOME(Analyzer::Definition::Variant(variantDef)) -> {
              let mut payloadIndex: u64 = 0;

              while (payloadIndex < variantDef.payload.length()) {
                if (let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex)) {
                  declared.push(*payloadType);
                }

                payloadIndex += 1;
              }
            },
            _ -> {},
          };
        }

        memberIndex += 1;
      }

      let typeParamSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::ownerTypeParamSymbols(defStore, &typeParams);

      if (typeArguments.isEmpty() || typeParamSymbols.length() != typeArguments.length()) {
        return declared;
      }

      let mut substituted: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut declaredIndex: u64 = 0;

      while (declaredIndex < declared.length()) {
        if (let Option::SOME(declaredType) = declared.get(declaredIndex)) {
          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          substituted.push(typeStoreRef.substitute(*declaredType, &typeParamSymbols, typeArguments));
        }

        declaredIndex += 1;
      }

      return substituted;
    }

    /// Whether a value of `typeId` holds a value of the record or enum
    /// `target` inline, through fields, payloads, tuples, arrays and aliases.
    /// Pointers, references, slices and functions hold it out of line.
    ///
    /// `visited` keeps every other nominal from being expanded twice, so a
    /// different recursive type met on the way ends the walk instead of
    /// looping; `depth` bounds generic types whose arguments grow.
    function typeHoldsInline(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
      target: Analyzer::DefinitionId,
      visited: &mut Vector<u32>,
      depth: u64,
    ): boolean {
      if (depth > 64) {
        return false;
      }

      let mut visitedIndex: u64 = 0;

      while (visitedIndex < visited.length()) {
        if (let Option::SOME(seen) = visited.get(visitedIndex)) {
          if (*seen == typeId.raw()) {
            return false;
          }
        }

        visitedIndex += 1;
      }

      let mut visitedRef: &mut Vector<u32> = visited;
      visitedRef.push(typeId.raw());

      let mut inner: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut owner: Option<Analyzer::DefinitionId> = Option::NONE;
      let mut typeArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

      match (typeStore.get(typeId)) {
        Option::SOME(Analyzer::Type::Record(definition)) -> {
          owner = Option::SOME(definition);
        },
        Option::SOME(Analyzer::Type::Enum(definition)) -> {
          owner = Option::SOME(definition);
        },
        Option::SOME(Analyzer::Type::Instance(instance)) -> {
          owner = Option::SOME(instance.definition);
          typeArguments = Analyzer::Typecheck::copyVariantPayloadTypeIds(&instance.typeArguments);
        },
        Option::SOME(Analyzer::Type::Tuple(tuple)) -> {
          inner = Analyzer::Typecheck::copyVariantPayloadTypeIds(&tuple.elements);
        },
        Option::SOME(Analyzer::Type::FixedArray(element, _)) -> {
          inner.push(element);
        },
        Option::SOME(Analyzer::Type::Alias(definition)) -> {
          if (let Option::SOME(Analyzer::Definition::TypeAlias(aliasDef)) = defStore.get(definition)) {
            inner.push(aliasDef.aliasedType);
          }
        },
        _ -> {},
      };

      if (let Option::SOME(definition) = owner) {
        if (definition.raw() == target.raw()) {
          return true;
        }

        inner = Analyzer::Checks::nominalMemberTypes(defStore, typeStore, definition, &typeArguments);
      }

      let mut innerIndex: u64 = 0;

      while (innerIndex < inner.length()) {
        if (let Option::SOME(innerType) = inner.get(innerIndex)) {
          if (Analyzer::Checks::typeHoldsInline(defStore, typeStore, *innerType, target, visited, depth + 1)) {
            return true;
          }
        }

        innerIndex += 1;
      }

      return false;
    }

    /// Reject a record or enum that holds itself inline: its size would be
    /// infinite, so it has no layout to emit.
    function checkInlineRecursion(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      name: &String,
      span: SourceSpan,
    ): void {
      let Option::SOME(defId) = Analyzer::Checks::findItemDef(pass1, pass2, itemId) else {
        return;
      };

      let noTypeArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let memberTypes: Vector<Analyzer::TypeId> = Analyzer::Checks::nominalMemberTypes(
        defStore,
        typeStore,
        defId,
        &noTypeArguments,
      );
      let mut visited: Vector<u32> = Vector::new<u32>();
      let mut memberIndex: u64 = 0;

      while (memberIndex < memberTypes.length()) {
        if (let Option::SOME(memberType) = memberTypes.get(memberIndex)) {
          if (Analyzer::Checks::typeHoldsInline(defStore, typeStore, *memberType, defId, &mut visited, 0)) {
            let message: String = `type '${name.toStr()}' contains itself without indirection`;
            Analyzer::Checks::emitError(
              diagnostics,
              span,
              DiagnosticCode::RECURSIVE_TYPE_WITHOUT_INDIRECTION,
              message.toStr(),
              "its size would be infinite; hold the recursive value through a pointer",
            );
            return;
          }
        }

        memberIndex += 1;
      }
    }

    /// Reject a record whose instance method and function-typed field share a
    /// name: `value.name(args)` calls a function-typed field as well as a
    /// method, so the call would be ambiguous.
    function checkMethodFieldNameClash(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
      record_: &Ast::Item::Record,
    ): void {
      let Option::SOME(recordDefId) = Analyzer::Checks::findItemDef(pass1, pass2, itemId) else {
        return;
      };

      let mut fieldIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(Analyzer::Definition::Record(recordDef)) = defStore.get(recordDefId)) {
        fieldIds = Analyzer::Checks::copyDefinitionIds(&recordDef.fields);
      }

      let mut methodIndex: u64 = 0;

      while (methodIndex < record_.methods.length()) {
        let Option::SOME(methodItemId) = record_.methods.get(methodIndex) else {
          methodIndex += 1;
          continue;
        };

        let Option::SOME(Ast::Item::Node::Function(function_)) = module.items.get(*methodItemId) else {
          methodIndex += 1;
          continue;
        };

        let mut methodName: Option<Analyzer::SymbolId> = Option::NONE;

        if (let Option::SOME(methodDefId) = Analyzer::Checks::findItemDef(pass1, pass2, *methodItemId)) {
          if (let Option::SOME(Analyzer::Definition::Method(methodDef)) = defStore.get(methodDefId)) {
            if (!methodDef.isStatic) {
              methodName = Option::SOME(methodDef.name);
            }
          }
        }

        if (let Option::SOME(name) = methodName) {
          if (Analyzer::Checks::hasFunctionFieldNamed(defStore, typeStore, &fieldIds, name)) {
            let message: String = `record '${record_.name.toStr()}' has both a method and a field of function type named '${function_.name.toStr()}'`;
            Analyzer::Checks::emitError(
              diagnostics,
              function_.span,
              DiagnosticCode::METHOD_AND_FUNCTION_FIELD_SHARE_NAME,
              message.toStr(),
              "a call through this name could mean either; rename the method or the field",
            );
          }
        }

        methodIndex += 1;
      }
    }

    /// Whether one of `fieldIds` is named `name` and has a function type,
    /// aliases resolved.
    function hasFunctionFieldNamed(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      fieldIds: &Vector<Analyzer::DefinitionId>,
      name: Analyzer::SymbolId,
    ): boolean {
      let mut index: u64 = 0;

      while (index < fieldIds.length()) {
        let mut fieldType: Option<Analyzer::TypeId> = Option::NONE;

        if (let Option::SOME(fieldId) = fieldIds.get(index)) {
          if (let Option::SOME(Analyzer::Definition::Field(fieldDef)) = defStore.get(*fieldId)) {
            if (fieldDef.name.raw() == name.raw()) {
              fieldType = Option::SOME(fieldDef.fieldType);
            }
          }
        }

        if (let Option::SOME(found) = fieldType) {
          return Analyzer::Typecheck::functionTypeThroughAliases(defStore, typeStore, found).isSome();
        }

        index += 1;
      }

      return false;
    }

    /// Check one item: functions and methods get the missing-return check
    /// and body walk, namespaces recurse, exports unwrap, constants walk
    /// their value, and everything else is skipped.
    function checkItem(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      itemId: Ast::ItemId,
    ): void {
      let Option::SOME(item) = module.items.get(itemId) else {
        return;
      };

      match (item) {
        Ast::Item::Node::Function(function_) -> {
          Analyzer::Checks::checkFunction(
            diagnostics,
            defStore,
            typeStore,
            module,
            pass1,
            pass2,
            typecheck,
            itemId,
            &function_,
          );
        },
        Ast::Item::Node::Record(record_) -> {
          Analyzer::Checks::checkCLayoutRecord(diagnostics, defStore, typeStore, module, pass1, pass2, itemId, &record_);
          Analyzer::Checks::checkInlineRecursion(diagnostics, defStore, typeStore, pass1, pass2, itemId, &record_.name, record_.span);
          Analyzer::Checks::checkMethodFieldNameClash(diagnostics, defStore, typeStore, module, pass1, pass2, itemId, &record_);
          Analyzer::Checks::checkMethods(
            diagnostics,
            defStore,
            typeStore,
            module,
            pass1,
            pass2,
            typecheck,
            &record_.methods,
          );
        },
        Ast::Item::Node::Extern(externItem) -> {
          Analyzer::Checks::checkExternRecords(diagnostics, defStore, typeStore, module, pass1, pass2, &externItem.items);
        },
        Ast::Item::Node::Enum(enum_) -> {
          Analyzer::Checks::checkInlineRecursion(diagnostics, defStore, typeStore, pass1, pass2, itemId, &enum_.name, enum_.span);
          Analyzer::Checks::checkMethods(
            diagnostics,
            defStore,
            typeStore,
            module,
            pass1,
            pass2,
            typecheck,
            &enum_.methods,
          );
        },
        Ast::Item::Node::Namespace(namespaceItem) -> {
          Analyzer::Checks::checkItems(
            diagnostics,
            defStore,
            typeStore,
            module,
            pass1,
            pass2,
            typecheck,
            &namespaceItem.items,
          );
        },
        Ast::Item::Node::Export(exportItem) -> {
          if (let Option::SOME(innerItemId) = exportItem.declaration) {
            Analyzer::Checks::checkItem(
              diagnostics,
              defStore,
              typeStore,
              module,
              pass1,
              pass2,
              typecheck,
              innerItemId,
            );
          }
        },
        Ast::Item::Node::Constant(constant) -> {
          Analyzer::Checks::walkExpr(
            diagnostics,
            defStore,
            typeStore,
            module,
            pass1,
            pass2,
            typecheck,
            constant.value,
            false,
          );
        },
        _ -> {},
      };
    }

    function checkItems(
      diagnostics: &mut DiagnosticBag,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
      itemIds: &Vector<Ast::ItemId>,
    ): void {
      let mut index: u64 = 0;

      while (index < itemIds.length()) {
        let Option::SOME(itemId) = itemIds.get(index) else {
          index += 1;
          continue;
        };

        Analyzer::Checks::checkItem(
          diagnostics,
          defStore,
          typeStore,
          module,
          pass1,
          pass2,
          typecheck,
          *itemId,
        );

        index += 1;
      }
    }

    /// Extra-checks phase entry point. Walks the module's root items in
    /// declaration order.
    function checkModule(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      typecheck: &Analyzer::Typecheck::TypecheckOutput,
    ): Analyzer::Checks::ChecksOutput {
      let mut diagnostics: DiagnosticBag = DiagnosticBag::init();

      Analyzer::Checks::checkItems(
        &mut diagnostics,
        defStore,
        typeStore,
        module,
        pass1,
        pass2,
        typecheck,
        &module.roots,
      );

      return Analyzer::Checks::ChecksOutput {
        diagnostics: diagnostics,
      };
    }
  }
}
