    function emitForOfRequiresCopyOrRef(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      elementType: Analyzer::TypeId,
    ): void {
      let name: String = typeStore.nameOf(elementType);
      let message: String = String::create("for-of by value requires Copy element type; '")
        .concat(name.toStr())
        .concat("' is not Copy, use '&")
        .concat(name.toStr())
        .concat("'");
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::FOR_OF_REQUIRES_COPY_OR_REF, message.toStr());
    }

