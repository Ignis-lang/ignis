    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::PIPE_RIGHT_NEEDS_PLACEHOLDER,
        "this pipe right side cannot take the value implicitly; write `_` where it goes",
