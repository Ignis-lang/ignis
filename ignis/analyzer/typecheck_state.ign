import
  SourceSpan,
  Diagnostic,
  DiagnosticBag,
  Severity,
  DiagnosticCode,
  LabelKind,
from "@compiler::diagnostics";

import Ast from "@compiler::ast";
import Id from "@compiler::ids";
import Vector from "std::vector";

export namespace Analyzer {
  namespace Typecheck {
    record ExprTypeMap {
      public nodeIds: Vector<u32>;
      public typeIds: Vector<Analyzer::TypeId>;
    }

    /// Side map from a call expression's raw id to the overload the
    /// arguments selected. The resolver stops at the first same-name
    /// definition, so lowering needs this to call the right sibling.
    record CallTargetMap {
      public nodeIds: Vector<u32>;
      public defIds: Vector<Analyzer::DefinitionId>;
    }

    /// Side map from a call expression's raw id to the type arguments the
    /// typechecker inferred for a generic callee called without written
    /// ones. Monomorphization needs them to instantiate the callee.
    record CallTypeArgsMap {
      public nodeIds: Vector<u32>;
      public typeArgs: Vector<Vector<Analyzer::TypeId>>;
    }

    /// Side map from a local binding's binding-site raw `PatternId` to the
    /// type the checker settled on for it.
    ///
    /// The Rust oracle reads this off the local's `DefinitionKind::Variable`,
    /// which its binder creates. The selfhost binder creates no definition
    /// for a local, and the checker's own scope stack is popped when the
    /// scope closes, so the settled type is logged here for HIR lowering: it
    /// is the annotation when one is written, and the type the first
    /// assignment supplied for a `let mut x;`, neither of which the
    /// initializer expression's own type answers.
    record LocalTypeMap {
      public patterns: Vector<u32>;
      public typeIds: Vector<Analyzer::TypeId>;
    }

    /// Declaration and use log for local bindings, produced by typecheck and
    /// consumed by the lint phase.
    ///
    /// Bindings are identified by the raw value of their binding-site
    /// `PatternId`. `LocalId.index` is reused across sibling scopes (ADR-B10),
    /// so it cannot serve as a canonical binding identity; the binding-site
    /// PatternId can.
    ///
    /// The Rust oracle reads the same information off `DefinitionStore` —
    /// locals are `DefinitionKind::Variable` definitions there — plus the
    /// `referenced_defs` / `mutated_defs` sets. The selfhost binder creates no
    /// definitions for locals, so typecheck records them here instead.
    record LocalBindingUses {
      /// One entry per binding site, in declaration order. Function and lambda
      /// parameters are logged as well; the lint phase filters them out, since
      /// the oracle models them as `DefinitionKind::Parameter` and never
      /// reports them.
      public patterns: Vector<u32>;
      /// Declaration span of the entry at the same index — the whole `let`
      /// statement for a local, mirroring the oracle's `def.span`.
      public spans: Vector<SourceSpan>;
      /// Whether the entry at the same index was declared `mut`.
      public mutableFlags: Vector<boolean>;
      /// Binding sites whose value is read at least once.
      public referenced: Vector<u32>;
      /// Binding sites that are the mutation root of an assignment, a `&mut`
      /// borrow, or a `mut self` method receiver.
      public mutated: Vector<u32>;
    }

    record TypecheckOutput {
      public diagnostics: DiagnosticBag;
      public exprTypes: Analyzer::Typecheck::ExprTypeMap;
      public callTargets: Analyzer::Typecheck::CallTargetMap;
      public callTypeArgs: Analyzer::Typecheck::CallTypeArgsMap;
      public localUses: Analyzer::Typecheck::LocalBindingUses;
      public localTypes: Analyzer::Typecheck::LocalTypeMap;
    }

    record TypecheckState {
      public diagnostics: DiagnosticBag;
      public exprTypes: Analyzer::Typecheck::ExprTypeMap;
      public callTargets: Analyzer::Typecheck::CallTargetMap;
      public callTypeArgs: Analyzer::Typecheck::CallTypeArgsMap;
      public currentFunction: Analyzer::DefinitionId;
      public currentReturnType: Analyzer::TypeId;
      public loopDepth: u64;
      public scopeMarks: Vector<u64>;
      public localPatternIds: Vector<Ast::PatternId>;
      public localFunctionIds: Vector<Analyzer::DefinitionId>;
      public localIndexes: Vector<u32>;
      public localTypeIds: Vector<Analyzer::TypeId>;
      public localMutableFlags: Vector<boolean>;
      /// Parallel to `localTypeIds`: true while the binding is waiting for its
      /// first assignment to decide its type.
      public localPendingFlags: Vector<boolean>;
      /// Binding-site log feeding `LocalTypeMap`. Like `declaredBindings`
      /// below, these two vectors survive the scope stack being popped.
      public bindingTypePatterns: Vector<u32>;
      public bindingTypeIds: Vector<Analyzer::TypeId>;
      /// Binding-site log feeding `LocalBindingUses`. Unlike the `local*`
      /// scope stack above, these five vectors are never reset per function:
      /// the lint phase reports module-wide.
      public declaredBindings: Vector<u32>;
      public declaredBindingSpans: Vector<SourceSpan>;
      public declaredBindingMutable: Vector<boolean>;
      public referencedBindings: Vector<u32>;
      public mutatedBindings: Vector<u32>;
      /// Type of the piped value for each pipe currently being checked, innermost last.
      ///
      /// A `_` placeholder has no declaration to resolve against, so it reads its type from
      /// the pipe enclosing it. A stack rather than a single slot because a pipe's right
      /// side may itself contain a pipe.
      public pipeValueTypes: Vector<Analyzer::TypeId>;
    }

    record AliasResolutionResult {
      public typeId: Analyzer::TypeId;
      public cycleAlias: Option<Analyzer::DefinitionId>;
    }

    record LocalBindingInfo {
      public typeId: Analyzer::TypeId;
      public mutable: boolean;
      /// True while the binding was declared without an annotation and without
      /// an initializer, so `typeId` is a placeholder the first assignment
      /// replaces. Reading such a binding before that assignment is an error.
      public pending: boolean;
    }

    function emitDiagnostic(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      code: str,
      message: str,
    ): void {
      let mut diagnostic: Diagnostic = Diagnostic::new(
        Severity::ERROR,
        code,
        message,
        span,
      );
      diagnostic.addLabel(LabelKind::PRIMARY, span, message);
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.diagnostics.push(diagnostic);
    }

    function emitWarning(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      code: str,
      message: str,
    ): void {
      let mut diagnostic: Diagnostic = Diagnostic::new(
        Severity::WARNING,
        code,
        message,
        span,
      );
      diagnostic.addLabel(LabelKind::PRIMARY, span, message);
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.diagnostics.push(diagnostic);
    }

    function emitTypeMismatch(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      expected: Analyzer::TypeId,
      actual: Analyzer::TypeId,
    ): void {
      let message: String = `Type mismatch: expected '${typeStore.nameOf(expected).toStr()}', found '${typeStore.nameOf(actual).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, message.toStr());
    }

    /// Reports a pattern whose shape cannot describe the scrutinee type.
    /// `got` is a shape description rather than a type name, because the
    /// pattern side of the comparison has no type of its own.
    function emitPatternTypeMismatch(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      expected: Analyzer::TypeId,
      got: str,
    ): void {
      let message: String = `pattern type mismatch: expected \`${typeStore.nameOf(expected).toStr()}\`, got \`${got}\``;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, message.toStr());
    }

    function emitOrPatternBindingsDisallowed(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::OR_PATTERN_BINDINGS_DISALLOWED,
        "bindings are not allowed in OR patterns",
      );
    }

    function emitMatchArmTypeMismatch(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      expected: Analyzer::TypeId,
      actual: Analyzer::TypeId,
    ): void {
      let message: String = `match arm type mismatch: expected \`${typeStore.nameOf(expected).toStr()}\`, found \`${typeStore.nameOf(actual).toStr()}\``;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::ARM_OR_BRANCH_TYPE_MISMATCH, message.toStr());
    }

    function emitBranchTypeMismatch(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      expected: Analyzer::TypeId,
      actual: Analyzer::TypeId,
    ): void {
      let message: String = `branch type mismatch: expected \`${typeStore.nameOf(expected).toStr()}\`, found \`${typeStore.nameOf(actual).toStr()}\``;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::ARM_OR_BRANCH_TYPE_MISMATCH, message.toStr());
    }

    function emitIfMissingElse(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::IF_MISSING_ELSE, "if expression requires an else branch");
    }

    function emitGenericArityMismatch(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      name: str,
      expected: u64,
      actual: u64,
    ): void {
      let message: String = `\`@${name}\` expects ${expected} type arguments, found ${actual}`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::GENERIC_ARITY_MISMATCH, message.toStr());
    }

    function emitPipePlaceholderOutsidePipe(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::PIPE_PLACEHOLDER_OUTSIDE_PIPE,
        "`_` placeholder is only valid inside pipe (|>) call arguments",
      );
    }

    function emitPipeMultiplePlaceholders(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::PIPE_MULTIPLE_PLACEHOLDERS,
        "only one `_` placeholder is allowed per pipe step",
      );
    }

    function emitPipePlaceholderNotInCall(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::PIPE_PLACEHOLDER_NOT_IN_CALL,
        "`_` placeholder must appear inside a function call on the RHS of |>",
      );
    }

    /// `rhsDescription` names the shape the right side was written as, so the
    /// message says which expression is the one that cannot be called.
    function emitPipeRightNotCallable(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      rhsDescription: str,
    ): void {
      let message: String = `invalid pipe RHS: ${rhsDescription} is not callable`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::PIPE_RIGHT_NOT_CALLABLE, message.toStr());
    }

    function emitPipeRightNeedsPlaceholder(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      rhsDescription: str,
    ): void {
      let message: String = `${rhsDescription} as pipe RHS requires a \`_\` placeholder`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::PIPE_RIGHT_NEEDS_PLACEHOLDER, message.toStr());
    }

    function emitUnknownBuiltin(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      name: str,
    ): void {
      let message: String = `Unknown builtin '@${name}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNKNOWN_BUILTIN, message.toStr());
    }

    function emitBuiltinTypeConstraint(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      name: str,
      constraint: str,
    ): void {
      let message: String = `@${name}: ${constraint}`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::BUILTIN_TYPE_CONSTRAINT, message.toStr());
    }

    function emitCallOnNonCallable(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      calleeType: Analyzer::TypeId,
    ): void {
      let message: String = `cannot call a value of type \`${typeStore.nameOf(calleeType).toStr()}\``;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::CALL_ON_NON_CALLABLE, message.toStr());
    }

    function emitInvalidNumberOfArguments(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      actual: u64,
      expected: u64,
    ): void {
      let message: String = `expected ${expected} arguments, found ${actual}`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_NUMBER_OF_ARGUMENTS, message.toStr());
    }

    /// The arity mismatch of a call whose callee has a written name. Callers that
    /// cannot name their callee pass `<function>`, as the reference analyzer does.
    function emitArgumentCountMismatch(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      calleeName: str,
      expected: u64,
      actual: u64,
    ): void {
      let message: String = `Function '${calleeName}' expects ${expected} arguments, got ${actual}`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_NUMBER_OF_ARGUMENTS, message.toStr());
    }

    /// The arity mismatch of a builtin, which is named after the `@` form the
    /// source writes rather than after a declaration.
    function emitBuiltinArgumentCountMismatch(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      name: str,
      expected: u64,
      actual: u64,
    ): void {
      let message: String = `@${name} expects ${expected} argument(s), got ${actual}`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_NUMBER_OF_ARGUMENTS, message.toStr());
    }

    /// `argumentIndex` is one-based, counting the piped value of a pipe as the
    /// first argument, so the number matches what the source wrote.
    function emitInvalidArgumentType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      argumentIndex: u64,
      expected: Analyzer::TypeId,
      actual: Analyzer::TypeId,
    ): void {
      let message: String = `Argument ${argumentIndex} type mismatch: expected '${typeStore.nameOf(expected).toStr()}', got '${typeStore.nameOf(actual).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_ARGUMENT_TYPE, message.toStr());
    }

    function emitTypeArgumentCountMismatch(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      actual: u64,
      expected: u64,
    ): void {
      let message: String = `expected ${expected} type arguments, found ${actual}`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_ARGUMENT_COUNT_MISMATCH, message.toStr());
    }

    function emitUnsupported(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      detail: str,
    ): void {
      let message: String = `typecheck does not support ${detail}`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, message.toStr());
    }

    function emitForOfExpectsVector(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      got: Analyzer::TypeId,
    ): void {
      let message: String = `for-of expects vector type, got '${typeStore.nameOf(got).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::FOR_OF_EXPECTS_VECTOR, message.toStr());
    }

    function emitForOfRequiresCopyOrRef(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      elementType: Analyzer::TypeId,
    ): void {
      let name: String = typeStore.nameOf(elementType);
      let message: String = `for-of by value requires Copy element type; '${name.toStr()}' is not Copy, use '&${name.toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::FOR_OF_REQUIRES_COPY_OR_REF, message.toStr());
    }

    function emitForOfMutRequiresMutableIter(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::FOR_OF_MUT_REQUIRES_MUTABLE_ITER,
        "cannot take mutable reference in for-of over immutable vector",
      );
    }

    function emitDeferExpressionMustBeVoid(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      foundType: Analyzer::TypeId,
    ): void {
      let message: String = `deferred expression must be of type 'void', found '${typeStore.nameOf(foundType).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::DEFER_EXPRESSION_MUST_BE_VOID, message.toStr());
    }

    function emitVectorIndexNonInteger(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      indexType: Analyzer::TypeId,
    ): void {
      let message: String = `Vector index must be integer type, got '${typeStore.nameOf(indexType).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::VECTOR_INDEX_NON_INTEGER, message.toStr());
    }

    function emitAccessNonVector(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      baseType: Analyzer::TypeId,
    ): void {
      let message: String = `Cannot index non-vector type '${typeStore.nameOf(baseType).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::ACCESS_NON_VECTOR, message.toStr());
    }

    function emitIndexOutOfBounds(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      index: i64,
      size: u64,
    ): void {
      let message: String = `Index ${index} is out of bounds for array of size ${size}`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INDEX_OUT_OF_BOUNDS, message.toStr());
    }

    function emitCannotInferVectorLiteral(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::CANNOT_INFER_TYPE,
        "cannot infer the element type of an empty vector literal",
      );
    }

    function emitCannotInferLocal(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::CANNOT_INFER_TYPE,
        "cannot infer the type of this local; add a type annotation or an initializer",
      );
    }

    /// The declaration form of `emitCannotInferLocal`, which names the binding
    /// because the declaration is where the annotation or initializer belongs.
    function emitCannotInferVariableType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      name: str,
    ): void {
      let message: String = `Cannot infer type for variable '${name}' - add a type annotation or initializer`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::CANNOT_INFER_TYPE, message.toStr());
    }

    function emitCannotInferNullLiteral(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::CANNOT_INFER_TYPE,
        "Cannot infer pointer type for null literal",
      );
    }

    function emitInvalidNullLiteral(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      expected: Analyzer::TypeId,
    ): void {
      let message: String = `Null literal can only be used with pointer types, expected '${typeStore.nameOf(expected).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_NULL_LITERAL, message.toStr());
    }

    function emitInvalidCast(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      fromType: Analyzer::TypeId,
      toType: Analyzer::TypeId,
    ): void {
      let message: String = `Cannot cast from '${typeStore.nameOf(fromType).toStr()}' to '${typeStore.nameOf(toType).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_CAST, message.toStr());
    }

    function emitDereferenceNonPointer(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      operandType: Analyzer::TypeId,
    ): void {
      let message: String = `Cannot dereference non-pointer type '${typeStore.nameOf(operandType).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::DEREFERENCE_NON_POINTER, message.toStr());
    }

    function emitInvalidReferenceTarget(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
    ): void {
      Analyzer::Typecheck::emitDiagnostic(
        state,
        span,
        DiagnosticCode::INVALID_REFERENCE_TARGET,
        "Cannot take reference of non-lvalue expression",
      );
    }

    function emitMutableReferenceToImmutable(
      state: &mut Analyzer::Typecheck::TypecheckState,
      span: SourceSpan,
      varName: str,
    ): void {
      let message: String = `Cannot create mutable reference to immutable variable '${varName}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::MUTABLE_REFERENCE_TO_IMMUTABLE, message.toStr());
    }

    function emitIntegerOverflow(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      targetType: Analyzer::TypeId,
    ): void {
      let message: String = `Integer literal overflows type '${typeStore.nameOf(targetType).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INTEGER_OVERFLOW, message.toStr());
    }

    /// Display symbol for a shift/bitwise operator in diagnostics.
    function shiftOrBitwiseOperatorSymbol(operator: Ast::Expression::BinaryOperator): str {
      return match (operator) {
        Ast::Expression::BinaryOperator::BitAnd -> "&",
        Ast::Expression::BinaryOperator::BitOr -> "|",
        Ast::Expression::BinaryOperator::BitXor -> "^",
        Ast::Expression::BinaryOperator::ShiftLeft -> "<<",
        Ast::Expression::BinaryOperator::ShiftRight -> ">>",
        _ -> "?",
      };
    }

    function emitInvalidBinaryOperandType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      operator: Ast::Expression::BinaryOperator,
      leftType: Analyzer::TypeId,
      rightType: Analyzer::TypeId,
    ): void {
      let message: String = String::create("Binary operator '")
        .concat(Analyzer::Typecheck::shiftOrBitwiseOperatorSymbol(operator))
        .concat("' cannot be applied to types '")
        .concat(typeStore.nameOf(leftType).toStr())
        .concat("' and '")
        .concat(typeStore.nameOf(rightType).toStr())
        .concat("'");
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_BINARY_OPERAND_TYPE, message.toStr());
    }

    function emitInvalidUnaryOperandType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      operator: str,
      operandType: Analyzer::TypeId,
    ): void {
      let message: String = `Unary operator '${operator}' cannot be applied to type '${typeStore.nameOf(operandType).toStr()}'`;
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_UNARY_OPERAND_TYPE, message.toStr());
    }

    /// Patch `VariableDef.declaredType` at `varDefId` via `DefinitionStore::replace`.
    ///
    /// Local mirror of the resolver's `patchVariableType`, used when an
    /// unannotated constant's type is inferred from its value: the binder left
    /// the `VOID` sentinel there and the resolver had no annotation to patch.
    function patchVariableDeclaredType(
      defStore: &mut Analyzer::DefinitionStore,
      varDefId: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
    ): void {
      let Option::SOME(existing) = defStore.get(varDefId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::Variable(v) -> {
          let updated: Analyzer::VariableDef = Analyzer::VariableDef {
            name: v.name,
            visibility: v.visibility,
            declaredType: typeId,
            mutable: v.mutable,
            takes: false,
            noEscape: false,
            isExtern: false,
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(varDefId, Analyzer::Definition::Variable(updated));
        },
        Analyzer::Definition::Record(_) -> {},
        Analyzer::Definition::Enum(_) -> {},
        Analyzer::Definition::Function(_) -> {},
        Analyzer::Definition::Field(_) -> {},
        Analyzer::Definition::Variant(_) -> {},
        Analyzer::Definition::TypeParam(_) -> {},
        Analyzer::Definition::TypeAlias(_) -> {},
        Analyzer::Definition::Trait(_) -> {},
        Analyzer::Definition::Method(_) -> {},
      };
    }

    function recordExprType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      exprId: Ast::ExpressionId,
      typeId: Analyzer::TypeId,
    ): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.exprTypes.nodeIds.push(exprId.raw());
      stateRef.exprTypes.typeIds.push(typeId);
    }

    function recordCallTarget(
      state: &mut Analyzer::Typecheck::TypecheckState,
      exprId: Ast::ExpressionId,
      defId: Analyzer::DefinitionId,
    ): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.callTargets.nodeIds.push(exprId.raw());
      stateRef.callTargets.defIds.push(defId);
    }

    function recordCallTypeArgs(
      state: &mut Analyzer::Typecheck::TypecheckState,
      exprId: Ast::ExpressionId,
      typeArgs: &Vector<Analyzer::TypeId>,
    ): void {
      let mut copied: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < typeArgs.length()) {
        if (let Option::SOME(typeArg) = typeArgs.get(index)) {
          copied.push(*typeArg);
        }

        index += 1;
      }

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.callTypeArgs.nodeIds.push(exprId.raw());
      stateRef.callTypeArgs.typeArgs.push(copied);
    }

    function lookupRecordedExprType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::TypeId> {
      let mut index: u64 = state.exprTypes.nodeIds.length();

      while (index > 0) {
        index -= 1;

        let Option::SOME(nodeId) = state.exprTypes.nodeIds.get(index) else {
          continue;
        };

        if (*nodeId == exprId.raw()) {
          let Option::SOME(typeId) = state.exprTypes.typeIds.get(index) else {
            return Option::NONE;
          };

          return Option::SOME(*typeId);
        }
      }

      return Option::NONE;
    }

    function pushScope(state: &mut Analyzer::Typecheck::TypecheckState): void {
      let mark: u64 = state.localPatternIds.length();
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.scopeMarks.push(mark);
    }

    function popScope(state: &mut Analyzer::Typecheck::TypecheckState): void {
      let Option::SOME(mark) = state.scopeMarks.pop() else {
        return;
      };

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      while (stateRef.localPatternIds.length() > mark) {
        stateRef.localPatternIds.pop();
        stateRef.localFunctionIds.pop();
        stateRef.localIndexes.pop();
        stateRef.localTypeIds.pop();
        stateRef.localMutableFlags.pop();
        stateRef.localPendingFlags.pop();
      }
    }

    function enterLoop(state: &mut Analyzer::Typecheck::TypecheckState): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.loopDepth += 1;
    }

    function exitLoop(state: &mut Analyzer::Typecheck::TypecheckState): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      if (stateRef.loopDepth > 0) {
        stateRef.loopDepth -= 1;
      }
    }

    function resolveAliasChainChecked(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Analyzer::Typecheck::AliasResolutionResult {
      let mut current: Analyzer::TypeId = typeId;
      let mut visited: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      while (true) {
        let Option::SOME(type_) = typeStore.get(current) else {
          return Analyzer::Typecheck::AliasResolutionResult {
            typeId: current,
            cycleAlias: Option::NONE,
          };
        };

        match (type_) {
          Analyzer::Type::Alias(aliasDefId) -> {
            let mut seenIndex: u64 = 0;
            while (seenIndex < visited.length()) {
              let Option::SOME(seen) = visited.get(seenIndex) else {
                seenIndex += 1;
                continue;
              };

              if (seen.raw() == aliasDefId.raw()) {
                return Analyzer::Typecheck::AliasResolutionResult {
                  typeId: current,
                  cycleAlias: Option::SOME(aliasDefId),
                };
              }

              seenIndex += 1;
            }

            visited.push(aliasDefId);

            let Option::SOME(def) = defStore.get(aliasDefId) else {
              return Analyzer::Typecheck::AliasResolutionResult {
                typeId: current,
                cycleAlias: Option::NONE,
              };
            };

            match (def) {
              Analyzer::Definition::TypeAlias(aliasDef) -> {
                current = aliasDef.aliasedType;
              },
              _ -> {
                return Analyzer::Typecheck::AliasResolutionResult {
                  typeId: current,
                  cycleAlias: Option::NONE,
                };
              },
            };
          },
          _ -> {
            return Analyzer::Typecheck::AliasResolutionResult {
              typeId: current,
              cycleAlias: Option::NONE,
            };
          },
        };
      }

      return Analyzer::Typecheck::AliasResolutionResult {
        typeId: current,
        cycleAlias: Option::NONE,
      };
    }

    /// Cycle diagnostics are owned by the resolver's declaration pass, which
    /// reports every alias cycle exactly once at the declaration the chain
    /// starts from, mirroring the reference analyzer. Use-site chasing stays
    /// silent on a cycle: emitting here would double-report every used cyclic
    /// alias. The hook is kept so every call site preserves its poisoned
    /// control flow unchanged.
    function emitCyclicTypeAlias(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      aliasDefId: Analyzer::DefinitionId,
    ): void {
      return;
    }

    /// Deep alias normalization: rewrites `typeId` replacing every alias —
    /// at any depth: under references, pointers, slices, arrays, tuples,
    /// instance arguments, and function types — with what it resolves to, so
    /// `&IdVector` and `&Vector<ExpressionId>` compare equal.
    function normalizeAliasesDeep(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
      depth: u64,
    ): Analyzer::TypeId {
      if (depth > 16) {
        return typeId;
      }

      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (resolved.cycleAlias.isSome()) {
        return typeId;
      }

      let Option::SOME(node) = typeStore.get(resolved.typeId) else {
        return resolved.typeId;
      };

      match (node) {
        Analyzer::Type::Reference(reference) -> {
          let inner: Analyzer::TypeId = Analyzer::Typecheck::normalizeAliasesDeep(defStore, typeStore, reference.referent, depth + 1);
          let mutable: boolean = reference.mutable;

          // The host collapses a reference to a reference: `& &T` is `&T`.
          if (let Option::SOME(innerNode) = typeStore.get(inner)) {
            if (let Analyzer::Type::Reference(_) = innerNode) {
              return inner;
            }
          }

          let mut tsRef: &mut Analyzer::TypeStore = typeStore;

          if (mutable) {
            return tsRef.mutableReference(inner);
          }

          return tsRef.reference(inner);
        },
        Analyzer::Type::Pointer(pointer) -> {
          let inner: Analyzer::TypeId = Analyzer::Typecheck::normalizeAliasesDeep(defStore, typeStore, pointer.pointee, depth + 1);
          let mutable: boolean = pointer.mutable;
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;

          if (mutable) {
            return tsRef.mutablePointer(inner);
          }

          return tsRef.pointer(inner);
        },
        Analyzer::Type::Slice(element) -> {
          let inner: Analyzer::TypeId = Analyzer::Typecheck::normalizeAliasesDeep(defStore, typeStore, element, depth + 1);
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.slice(inner);
        },
        Analyzer::Type::Instance(instance) -> {
          let mut normalizedArguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut argIndex: u64 = 0;

          while (argIndex < instance.typeArguments.length()) {
            let Option::SOME(argument) = instance.typeArguments.get(argIndex) else {
              argIndex += 1;
              continue;
            };

            normalizedArguments.push(Analyzer::Typecheck::normalizeAliasesDeep(defStore, typeStore, *argument, depth + 1));
            argIndex += 1;
          }

          let definition: Analyzer::DefinitionId = instance.definition;
          let mut tsRef: &mut Analyzer::TypeStore = typeStore;
          return tsRef.instance(definition, normalizedArguments);
        },
        _ -> {
          return resolved.typeId;
        },
      };

      @panic("unreachable: normalizeAliasesDeep match did not return");
    }

    function typesEqual(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      left: Analyzer::TypeId,
      right: Analyzer::TypeId,
    ): boolean {
      let leftResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, left);
      if (let Option::SOME(aliasDefId) = leftResolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return true;
      }

      let rightResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, right);
      if (let Option::SOME(aliasDefId) = rightResolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return true;
      }

      if (leftResolved.typeId.raw() == rightResolved.typeId.raw()) {
        return true;
      }

      // Aliases can hide at any depth (`&IdVector` vs `&Vector<Id>`); a deep
      // normalization decides what the shallow chain above could not.
      let leftDeep: Analyzer::TypeId = Analyzer::Typecheck::normalizeAliasesDeep(defStore, typeStore, leftResolved.typeId, 0);
      let rightDeep: Analyzer::TypeId = Analyzer::Typecheck::normalizeAliasesDeep(defStore, typeStore, rightResolved.typeId, 0);
      return leftDeep.raw() == rightDeep.raw();
    }

    function isSupportedNumericType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return false;
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return false;
      };

      return match (type_) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64
        | Analyzer::Type::F32
        | Analyzer::Type::F64 -> true,
        _ -> false,
      };
    }

    function isIntegerType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return false;
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return false;
      };

      return match (type_) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64 -> true,
        _ -> false,
      };
    }

    function isBooleanType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return false;
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return false;
      };

      return match (type_) {
        Analyzer::Type::BOOLEAN -> true,
        _ -> false,
      };
    }

    /// Whether a type has Copy semantics. Mirrors the Rust
    /// `TypeStore::is_copy_with_defs`: primitives, pointers, references,
    /// slices, and function types copy; fixed arrays, tuples, and generic
    /// instances copy when their components do; records and enums honor
    /// `@implements(Drop)`/`@implements(Copy)` and otherwise copy when their
    /// fields or variant payloads do; unresolved type parameters
    /// conservatively are not.
    function isCopyType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): boolean {
      let mut visited: Vector<u32> = Vector::new<u32>();
      return Analyzer::Typecheck::isCopyTypeInner(defStore, typeStore, typeId, &mut visited);
    }

    /// Recursive worker for `isCopyType`. `visited` holds the raw type ids of
    /// the record/enum types currently being examined so a recursive type
    /// answers non-Copy on revisit instead of looping, like the Rust
    /// `is_copy_with_defs_inner`.
    function isCopyTypeInner(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
      visited: &mut Vector<u32>,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      // A cyclic alias is reported where it is declared; here it only answers
      // non-Copy, so the predicate needs neither a span nor the check state
      // and post-analysis passes can call it.
      if (resolved.cycleAlias.isSome()) {
        return false;
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return false;
      };

      // Compound kinds defer their answer to their component types, gathered
      // first so the store borrow ends before the recursive calls.
      let mut directAnswer: Option<boolean> = Option::NONE;
      let mut components: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut recordDefId: Option<Analyzer::DefinitionId> = Option::NONE;
      let mut enumDefId: Option<Analyzer::DefinitionId> = Option::NONE;

      match (type_) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64
        | Analyzer::Type::F32
        | Analyzer::Type::F64
        | Analyzer::Type::BOOLEAN
        | Analyzer::Type::CHAR
        | Analyzer::Type::STR
        | Analyzer::Type::VOID
        | Analyzer::Type::NEVER
        | Analyzer::Type::ATOM -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Pointer(_) -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Reference(_) -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Slice(_) -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Function(_) -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Record(defId) -> {
          recordDefId = Option::SOME(defId);
        },
        Analyzer::Type::Enum(defId) -> {
          enumDefId = Option::SOME(defId);
        },
        Analyzer::Type::Param(_) -> {
          directAnswer = Option::SOME(false);
        },
        Analyzer::Type::Alias(_) -> {
          directAnswer = Option::SOME(false);
        },
        Analyzer::Type::FixedArray(element, _) -> {
          components.push(element);
        },
        Analyzer::Type::Tuple(tuple) -> {
          let mut elementIndex: u64 = 0;
          while (elementIndex < tuple.elements.length()) {
            let Option::SOME(elementId) = tuple.elements.get(elementIndex) else {
              elementIndex += 1;
              continue;
            };

            components.push(*elementId);
            elementIndex += 1;
          }
        },
        Analyzer::Type::Instance(instance) -> {
          let mut argumentIndex: u64 = 0;
          while (argumentIndex < instance.typeArguments.length()) {
            let Option::SOME(argumentId) = instance.typeArguments.get(argumentIndex) else {
              argumentIndex += 1;
              continue;
            };

            components.push(*argumentId);
            argumentIndex += 1;
          }
        },
      };

      if (let Option::SOME(answer) = directAnswer) {
        return answer;
      }

      if (let Option::SOME(defId) = recordDefId) {
        return Analyzer::Typecheck::recordCopyAnswer(defStore, typeStore, resolved.typeId, defId, visited);
      }

      if (let Option::SOME(defId) = enumDefId) {
        return Analyzer::Typecheck::enumCopyAnswer(defStore, typeStore, resolved.typeId, defId, visited);
      }

      let mut componentIndex: u64 = 0;
      while (componentIndex < components.length()) {
        let Option::SOME(component) = components.get(componentIndex) else {
          componentIndex += 1;
          continue;
        };

        if (!Analyzer::Typecheck::isCopyTypeInner(defStore, typeStore, *component, visited)) {
          return false;
        }

        componentIndex += 1;
      }

      return true;
    }

    /// Whether `typeRaw` is already on the `visited` stack.
    function copyVisitAlreadySeen(visited: &mut Vector<u32>, typeRaw: u32): boolean {
      let mut seenIndex: u64 = 0;

      while (seenIndex < visited.length()) {
        let Option::SOME(seen) = visited.get(seenIndex) else {
          seenIndex += 1;
          continue;
        };

        if (*seen == typeRaw) {
          return true;
        }

        seenIndex += 1;
      }

      return false;
    }

    /// Copy answer for a record type, honoring `@implements(...)` metadata.
    /// Mirrors the Rust `is_copy_with_defs_inner`: `Drop` forces non-Copy,
    /// `Copy` forces Copy, otherwise the record copies when every field type
    /// does. A revisit through `visited` answers non-Copy to break cycles.
    function recordCopyAnswer(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
      defId: Analyzer::DefinitionId,
      visited: &mut Vector<u32>,
    ): boolean {
      let typeRaw: u32 = typeId.raw();
      if (Analyzer::Typecheck::copyVisitAlreadySeen(visited, typeRaw)) {
        return false;
      }

      let mut visitedRef: &mut Vector<u32> = visited;
      visitedRef.push(typeRaw);

      let mut implementsCopy: boolean = false;
      let mut implementsDrop: boolean = false;
      let mut fieldDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(def) = defStore.get(defId)) {
        match (def) {
          Analyzer::Definition::Record(recordDef) -> {
            implementsCopy = recordDef.implementsCopy;
            implementsDrop = recordDef.implementsDrop;

            let mut fieldIndex: u64 = 0;
            while (fieldIndex < recordDef.fields.length()) {
              let Option::SOME(fieldDefId) = recordDef.fields.get(fieldIndex) else {
                fieldIndex += 1;
                continue;
              };

              fieldDefIds.push(*fieldDefId);
              fieldIndex += 1;
            }
          },
          _ -> {},
        };
      }

      let mut fieldTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut fieldDefIndex: u64 = 0;
      while (fieldDefIndex < fieldDefIds.length()) {
        let Option::SOME(fieldDefId) = fieldDefIds.get(fieldDefIndex) else {
          fieldDefIndex += 1;
          continue;
        };

        if (let Option::SOME(fieldDefNode) = defStore.get(*fieldDefId)) {
          if (let Analyzer::Definition::Field(fieldDef) = fieldDefNode) {
            fieldTypes.push(fieldDef.fieldType);
          }
        }

        fieldDefIndex += 1;
      }

      let answer: boolean = Analyzer::Typecheck::copyAnswerFromTraitFlagsAndComponents(
        defStore,
        typeStore,
        implementsCopy,
        implementsDrop,
        &fieldTypes,
        visited,
      );

      let mut popRef: &mut Vector<u32> = visited;
      popRef.pop();
      return answer;
    }

    /// Copy answer for an enum type, honoring `@implements(...)` metadata.
    /// Same shape as `recordCopyAnswer` with variant payload types standing
    /// in for record field types.
    function enumCopyAnswer(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
      defId: Analyzer::DefinitionId,
      visited: &mut Vector<u32>,
    ): boolean {
      let typeRaw: u32 = typeId.raw();
      if (Analyzer::Typecheck::copyVisitAlreadySeen(visited, typeRaw)) {
        return false;
      }

      let mut visitedRef: &mut Vector<u32> = visited;
      visitedRef.push(typeRaw);

      let mut implementsCopy: boolean = false;
      let mut implementsDrop: boolean = false;
      let mut variantDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(def) = defStore.get(defId)) {
        match (def) {
          Analyzer::Definition::Enum(enumDef) -> {
            implementsCopy = enumDef.implementsCopy;
            implementsDrop = enumDef.implementsDrop;

            let mut variantIndex: u64 = 0;
            while (variantIndex < enumDef.variants.length()) {
              let Option::SOME(variantDefId) = enumDef.variants.get(variantIndex) else {
                variantIndex += 1;
                continue;
              };

              variantDefIds.push(*variantDefId);
              variantIndex += 1;
            }
          },
          _ -> {},
        };
      }

      let mut payloadTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut variantDefIndex: u64 = 0;
      while (variantDefIndex < variantDefIds.length()) {
        let Option::SOME(variantDefId) = variantDefIds.get(variantDefIndex) else {
          variantDefIndex += 1;
          continue;
        };

        if (let Option::SOME(variantDefNode) = defStore.get(*variantDefId)) {
          if (let Analyzer::Definition::Variant(variantDef) = variantDefNode) {
            let mut payloadIndex: u64 = 0;
            while (payloadIndex < variantDef.payload.length()) {
              let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex) else {
                payloadIndex += 1;
                continue;
              };

              payloadTypes.push(*payloadType);
              payloadIndex += 1;
            }
          }
        }

        variantDefIndex += 1;
      }

      let answer: boolean = Analyzer::Typecheck::copyAnswerFromTraitFlagsAndComponents(
        defStore,
        typeStore,
        implementsCopy,
        implementsDrop,
        &payloadTypes,
        visited,
      );

      let mut popRef: &mut Vector<u32> = visited;
      popRef.pop();
      return answer;
    }

    /// Shared tail of `recordCopyAnswer`/`enumCopyAnswer`: `Drop` wins over
    /// `Copy`, and without either flag the answer is structural over the
    /// gathered component types.
    function copyAnswerFromTraitFlagsAndComponents(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      implementsCopy: boolean,
      implementsDrop: boolean,
      componentTypes: &Vector<Analyzer::TypeId>,
      visited: &mut Vector<u32>,
    ): boolean {
      if (implementsDrop) {
        return false;
      }

      if (implementsCopy) {
        return true;
      }

      let mut componentIndex: u64 = 0;
      while (componentIndex < componentTypes.length()) {
        let Option::SOME(componentType) = componentTypes.get(componentIndex) else {
          componentIndex += 1;
          continue;
        };

        if (!Analyzer::Typecheck::isCopyTypeInner(defStore, typeStore, *componentType, visited)) {
          return false;
        }

        componentIndex += 1;
      }

      return true;
    }

    function requireBooleanType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      actual: Analyzer::TypeId,
    ): boolean {
      if (Analyzer::Typecheck::isBooleanType(state, defStore, typeStore, span, actual)) {
        return true;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let booleanType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::BOOLEAN);
      if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, booleanType, actual)) {
        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, span, booleanType, actual);
      }
      return false;
    }

    function binaryBooleanType(typeStore: &mut Analyzer::TypeStore): Analyzer::TypeId {
      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      return typeStoreRef.intern(Analyzer::Type::BOOLEAN);
    }

    function isArithmeticBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::Add
        | Ast::Expression::BinaryOperator::Subtract
        | Ast::Expression::BinaryOperator::Multiply
        | Ast::Expression::BinaryOperator::Divide
        | Ast::Expression::BinaryOperator::Modulo -> true,
        _ -> false,
      };
    }

    function isSubtractBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::Subtract -> true,
        _ -> false,
      };
    }

    function isEqualityBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::Equal
        | Ast::Expression::BinaryOperator::NotEqual -> true,
        _ -> false,
      };
    }

    function isComparisonBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::LessThan
        | Ast::Expression::BinaryOperator::LessThanOrEqual
        | Ast::Expression::BinaryOperator::GreaterThan
        | Ast::Expression::BinaryOperator::GreaterThanOrEqual -> true,
        _ -> false,
      };
    }

    function isLogicalBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::And
        | Ast::Expression::BinaryOperator::Or -> true,
        _ -> false,
      };
    }

    /// Whether an alias-resolved type node names one of the eight integer
    /// primitives.
    function isIntegerTypeNode(typeNode: &Analyzer::Type): boolean {
      return match (typeNode) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64 -> true,
        _ -> false,
      };
    }

    /// Whether an alias-resolved type node names a float primitive.
    function isFloatTypeNode(typeNode: &Analyzer::Type): boolean {
      return match (typeNode) {
        Analyzer::Type::F32 | Analyzer::Type::F64 -> true,
        _ -> false,
      };
    }

    /// Width rank of an integer type node, ordered so that a same-sign
    /// widening is exactly a move to a strictly higher rank. `0` means the
    /// node is not an integer primitive.
    function integerWideningRankOfNode(typeNode: &Analyzer::Type): u32 {
      return match (typeNode) {
        Analyzer::Type::I8 | Analyzer::Type::U8 -> 1,
        Analyzer::Type::I16 | Analyzer::Type::U16 -> 2,
        Analyzer::Type::I32 | Analyzer::Type::U32 -> 3,
        Analyzer::Type::I64 | Analyzer::Type::U64 -> 4,
        _ -> 0,
      };
    }

    /// Whether an alias-resolved type node names a signed integer primitive.
    function isSignedIntegerTypeNode(typeNode: &Analyzer::Type): boolean {
      return match (typeNode) {
        Analyzer::Type::I8 | Analyzer::Type::I16 | Analyzer::Type::I32 | Analyzer::Type::I64 -> true,
        _ -> false,
      };
    }

    /// Resolves `typeId` through its alias chain and reports its integer width
    /// rank, or `0` when it is not an integer. Returning a scalar keeps the
    /// type store borrow local, so two types can be classified in sequence.
    function integerWideningRank(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): u32 {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (resolved.cycleAlias.isSome()) {
        return 0;
      }

      let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
        return 0;
      };

      return Analyzer::Typecheck::integerWideningRankOfNode(typeNode);
    }

    /// Resolves `typeId` through its alias chain and reports whether it is a
    /// signed integer primitive.
    function isSignedIntegerType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (resolved.cycleAlias.isSome()) {
        return false;
      }

      let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
        return false;
      };

      return Analyzer::Typecheck::isSignedIntegerTypeNode(typeNode);
    }

    /// Whether a value of `source` implicitly widens to `target`.
    ///
    /// Mirrors the reference analyzer's `TypeStore::is_implicit_widening`:
    /// only a same-sign integer conversion to a strictly wider type is
    /// implicit. Narrowing and any signed/unsigned crossing stay explicit.
    function isImplicitWidening(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      target: Analyzer::TypeId,
      source: Analyzer::TypeId,
    ): boolean {
      let targetRank: u32 = Analyzer::Typecheck::integerWideningRank(defStore, typeStore, target);
      let sourceRank: u32 = Analyzer::Typecheck::integerWideningRank(defStore, typeStore, source);

      if (targetRank == 0 || sourceRank == 0 || targetRank <= sourceRank) {
        return false;
      }

      let targetSigned: boolean = Analyzer::Typecheck::isSignedIntegerType(defStore, typeStore, target);
      let sourceSigned: boolean = Analyzer::Typecheck::isSignedIntegerType(defStore, typeStore, source);

      return targetSigned == sourceSigned;
    }

    /// Whether an array value may be supplied where a slice of the same
    /// element type is required.
    ///
    /// Mirrors the reference analyzer's `TypeStore::is_assignable`: an array
    /// knows its own length, so the slice is built from the array's data
    /// pointer and that length at the coercion site. The reverse never holds,
    /// because a slice carries no static size.
    function fixedArrayCoercesToSlice(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      target: Analyzer::TypeId,
      source: Analyzer::TypeId,
    ): boolean {
      let targetResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, target);
      if (targetResolved.cycleAlias.isSome()) {
        return false;
      }

      let sourceResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, source);
      if (sourceResolved.cycleAlias.isSome()) {
        return false;
      }

      let mut targetElement: Option<Analyzer::TypeId> = Option::NONE;

      if (let Option::SOME(targetNode) = typeStore.get(targetResolved.typeId)) {
        if (let Analyzer::Type::Slice(element) = targetNode) {
          targetElement = Option::SOME(element);
        }
      }

      let mut sourceElement: Option<Analyzer::TypeId> = Option::NONE;

      if (let Option::SOME(sourceNode) = typeStore.get(sourceResolved.typeId)) {
        if (let Analyzer::Type::FixedArray(element, _) = sourceNode) {
          sourceElement = Option::SOME(element);
        }
      }

      let Option::SOME(targetElementId) = targetElement else {
        return false;
      };
      let Option::SOME(sourceElementId) = sourceElement else {
        return false;
      };

      return Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, targetElementId, sourceElementId);
    }

    /// The type two integer operands share, or `Option::NONE` when they share
    /// none.
    ///
    /// Mirrors the integer half of the reference analyzer's
    /// `integer_common_type`: same-sign integers widen to the wider operand.
    /// A mixed signed/unsigned pair has no common type, and a float operand is
    /// not handled here, so both keep reporting a mismatch.
    function commonIntegerType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      left: Analyzer::TypeId,
      right: Analyzer::TypeId,
    ): Option<Analyzer::TypeId> {
      if (Analyzer::Typecheck::isImplicitWidening(defStore, typeStore, left, right)) {
        return Option::SOME(left);
      }

      if (Analyzer::Typecheck::isImplicitWidening(defStore, typeStore, right, left)) {
        return Option::SOME(right);
      }

      return Option::NONE;
    }

    /// Whether `typeId` resolves to a numeric primitive without reporting a
    /// cyclic alias. The binary arms report such a cycle once through
    /// `isSupportedNumericType`, so this pre-pass must stay silent.
    function isNumericTypeQuiet(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (resolved.cycleAlias.isSome()) {
        return false;
      }

      let Option::SOME(typeNode) = typeStore.get(resolved.typeId) else {
        return false;
      };

      if (Analyzer::Typecheck::isIntegerTypeNode(typeNode)) {
        return true;
      }

      return Analyzer::Typecheck::isFloatTypeNode(typeNode);
    }

    /// Whether a signed literal value fits the integer type node. Mirrors the
    /// Rust `signed_fits_in_type`.
    function signedLiteralFits(typeNode: &Analyzer::Type, value: i64): boolean {
      return match (typeNode) {
        Analyzer::Type::I8 -> value >= -128 && value <= 127,
        Analyzer::Type::I16 -> value >= -32768 && value <= 32767,
        Analyzer::Type::I32 -> value >= -2147483648 && value <= 2147483647,
        Analyzer::Type::I64 -> true,
        Analyzer::Type::U8 -> value >= 0 && value <= 255,
        Analyzer::Type::U16 -> value >= 0 && value <= 65535,
        Analyzer::Type::U32 -> value >= 0 && value <= 4294967295,
        Analyzer::Type::U64 -> value >= 0,
        _ -> false,
      };
    }

    /// Whether an unsigned literal value fits the integer type node. Mirrors
    /// the Rust `unsigned_fits_in_type`.
    function unsignedLiteralFits(typeNode: &Analyzer::Type, value: u64): boolean {
      return match (typeNode) {
        Analyzer::Type::I8 -> value <= 127,
        Analyzer::Type::I16 -> value <= 32767,
        Analyzer::Type::I32 -> value <= 2147483647,
        Analyzer::Type::I64 -> value <= 9223372036854775807,
        Analyzer::Type::U8 -> value <= 255,
        Analyzer::Type::U16 -> value <= 65535,
        Analyzer::Type::U32 -> value <= 4294967295,
        Analyzer::Type::U64 -> true,
        _ -> false,
      };
    }

    function isShiftOrBitwiseBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::BitAnd
        | Ast::Expression::BinaryOperator::BitOr
        | Ast::Expression::BinaryOperator::BitXor
        | Ast::Expression::BinaryOperator::ShiftLeft
        | Ast::Expression::BinaryOperator::ShiftRight -> true,
        _ -> false,
      };
    }

    function lookupItemDef(
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
    ): Option<Analyzer::DefinitionId> {
      let pass2Result: Option<Analyzer::DefinitionId> = Analyzer::Binder::findDef(pass2, itemId.raw());
      if (pass2Result.isSome()) {
        return pass2Result;
      }

      return Analyzer::Binder::findDef(pass1, itemId.raw());
    }

    function lookupPatternLocal(
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
    ): Option<Analyzer::ResolverBodies::LocalId> {
      let resolved: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::ResolverBodies::findPatternRef(
        &resolvedBodies.bodyResolution,
        patternId.raw(),
      );

      let Option::SOME(ref_) = resolved else {
        return Option::NONE;
      };

      match (ref_) {
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
          return Option::SOME(localId);
        },
        Analyzer::ResolverBodies::ResolvedRef::Definition(_) -> {
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: lookupPatternLocal match did not return");
    }

    function lookupExprRef(
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::ResolverBodies::ResolvedRef> {
      return Analyzer::ResolverBodies::findExprRef(&resolvedBodies.bodyResolution, exprId.raw());
    }

    function lookupLocalBinding(
      state: &mut Analyzer::Typecheck::TypecheckState,
      localId: Analyzer::ResolverBodies::LocalId,
    ): Option<Analyzer::Typecheck::LocalBindingInfo> {
      let count: u64 = state.localTypeIds.length();

      if (count == 0) {
        return Option::NONE;
      }

      let mut index: u64 = count;
      while (index > 0) {
        index -= 1;

        let Option::SOME(functionId) = state.localFunctionIds.get(index) else {
          continue;
        };
        let Option::SOME(localIndex) = state.localIndexes.get(index) else {
          continue;
        };
        let Option::SOME(typeId) = state.localTypeIds.get(index) else {
          continue;
        };
        let Option::SOME(mutable) = state.localMutableFlags.get(index) else {
          continue;
        };

        if (functionId.raw() == localId.enclosingFn.raw() && *localIndex == localId.index) {
          let mut pendingFlag: boolean = false;
          if (let Option::SOME(pending) = state.localPendingFlags.get(index)) {
            pendingFlag = *pending;
          }

          let info: Analyzer::Typecheck::LocalBindingInfo = Analyzer::Typecheck::LocalBindingInfo {
            typeId: *typeId,
            mutable: *mutable,
            pending: pendingFlag,
          };

          // Every consultation of a binding is a use: the oracle marks a
          // definition referenced at name-resolution time, which covers reads,
          // assignment targets and method receivers alike.
          let mut referencedRaw: u32 = 0;
          let mut hasReferenced: boolean = false;
          if (let Option::SOME(patternId) = state.localPatternIds.get(index)) {
            referencedRaw = patternId.raw();
            hasReferenced = true;
          }

          if (hasReferenced) {
            Analyzer::Typecheck::markBindingReferenced(state, referencedRaw);
          }

          return Option::SOME(info);
        }
      }

      return Option::NONE;
    }

    /// Record a binding site as read at least once. Idempotent.
    function markBindingReferenced(
      state: &mut Analyzer::Typecheck::TypecheckState,
      bindingRaw: u32,
    ): void {
      let mut index: u64 = 0;

      while (index < state.referencedBindings.length()) {
        let Option::SOME(existing) = state.referencedBindings.get(index) else {
          index += 1;
          continue;
        };

        if (*existing == bindingRaw) {
          return;
        }

        index += 1;
      }

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.referencedBindings.push(bindingRaw);
    }

    /// Record a binding site as mutated. Idempotent.
    function markBindingMutated(
      state: &mut Analyzer::Typecheck::TypecheckState,
      bindingRaw: u32,
    ): void {
      let mut index: u64 = 0;

      while (index < state.mutatedBindings.length()) {
        let Option::SOME(existing) = state.mutatedBindings.get(index) else {
          index += 1;
          continue;
        };

        if (*existing == bindingRaw) {
          return;
        }

        index += 1;
      }

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.mutatedBindings.push(bindingRaw);
    }

    /// Log a binding site with its declaration span and declared mutability.
    /// Idempotent, so a binding reached twice is reported once.
    /// Log the settled type of the binding site `bindingRaw`, replacing an
    /// earlier entry so a pending binding ends up with the type its first
    /// assignment supplied rather than the placeholder.
    function recordBindingType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      bindingRaw: u32,
      typeId: Analyzer::TypeId,
    ): void {
      let mut index: u64 = 0;

      while (index < state.bindingTypePatterns.length()) {
        let Option::SOME(existing) = state.bindingTypePatterns.get(index) else {
          index += 1;
          continue;
        };

        if (*existing == bindingRaw) {
          let mut foundRef: &mut Analyzer::Typecheck::TypecheckState = state;
          foundRef.bindingTypeIds.set(index, typeId);
          return;
        }

        index += 1;
      }

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.bindingTypePatterns.push(bindingRaw);
      stateRef.bindingTypeIds.push(typeId);
    }

    function markBindingDeclared(
      state: &mut Analyzer::Typecheck::TypecheckState,
      bindingRaw: u32,
      span: SourceSpan,
      mutable: boolean,
    ): void {
      let mut index: u64 = 0;

      while (index < state.declaredBindings.length()) {
        let Option::SOME(existing) = state.declaredBindings.get(index) else {
          index += 1;
          continue;
        };

        if (*existing == bindingRaw) {
          return;
        }

        index += 1;
      }

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.declaredBindings.push(bindingRaw);
      stateRef.declaredBindingSpans.push(span);
      stateRef.declaredBindingMutable.push(mutable);
    }

    /// Mark the binding at the root of a mutated place as mutated.
    ///
    /// Mirrors the oracle's `def_id_of_mutable_root`: peel `.field`, `[index]`,
    /// `*deref` and grouping down to the base name, and record it only when
    /// that base is a local declared `mut`. A `&mut T` binding that is not
    /// itself `mut` is deliberately left unmarked — it can never be reported
    /// by the unused-mut lint, so marking it would change nothing.
    function markMutationTarget(
      state: &mut Analyzer::Typecheck::TypecheckState,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      exprId: Ast::ExpressionId,
    ): void {
      let Option::SOME(expr) = module.expressions.get(exprId) else {
        return;
      };

      match (expr) {
        Ast::Expression::Node::Variable(_) -> {
          Analyzer::Typecheck::markMutationRootRef(state, resolvedBodies, exprId);
        },
        Ast::Expression::Node::Path(_) -> {
          Analyzer::Typecheck::markMutationRootRef(state, resolvedBodies, exprId);
        },
        Ast::Expression::Node::MemberAccess(memberAccess) -> {
          if (memberAccess.operator == Ast::Expression::AccessOperator::Dot) {
            Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, memberAccess.object);
          }
        },
        Ast::Expression::Node::VectorAccess(access) -> {
          Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, access.vector);
        },
        Ast::Expression::Node::Dereference(deref) -> {
          Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, deref.operand);
        },
        Ast::Expression::Node::Grouped(grouped) -> {
          Analyzer::Typecheck::markMutationTarget(state, resolvedBodies, module, grouped.expression);
        },
        _ -> {},
      };
    }

    /// Record the binding a name expression resolves to as mutated, when that
    /// binding is a local declared `mut`.
    function markMutationRootRef(
      state: &mut Analyzer::Typecheck::TypecheckState,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
    ): void {
      let Option::SOME(resolved) = Analyzer::Typecheck::lookupExprRef(resolvedBodies, exprId) else {
        return;
      };
      let Analyzer::ResolverBodies::ResolvedRef::Local(localId) = resolved else {
        return;
      };

      let count: u64 = state.localPatternIds.length();
      let mut index: u64 = count;

      while (index > 0) {
        index -= 1;

        let Option::SOME(functionId) = state.localFunctionIds.get(index) else {
          continue;
        };
        let Option::SOME(localIndex) = state.localIndexes.get(index) else {
          continue;
        };

        if (functionId.raw() != localId.enclosingFn.raw() || *localIndex != localId.index) {
          continue;
        }

        let Option::SOME(mutable) = state.localMutableFlags.get(index) else {
          return;
        };
        if (!*mutable) {
          return;
        }

        let mut bindingRaw: u32 = 0;
        let mut hasBinding: boolean = false;
        if (let Option::SOME(patternId) = state.localPatternIds.get(index)) {
          bindingRaw = patternId.raw();
          hasBinding = true;
        }

        if (hasBinding) {
          Analyzer::Typecheck::markBindingMutated(state, bindingRaw);
        }

        return;
      }
    }

    function truncateLocalBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      mark: u64
    ): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      while (stateRef.localPatternIds.length() > mark) {
        stateRef.localPatternIds.pop();
        stateRef.localFunctionIds.pop();
        stateRef.localIndexes.pop();
        stateRef.localTypeIds.pop();
        stateRef.localMutableFlags.pop();
      }
    }

    function pushPatternLocal(
      state: &mut Analyzer::Typecheck::TypecheckState,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): boolean {
      let localOpt: Option<Analyzer::ResolverBodies::LocalId> = Analyzer::Typecheck::lookupPatternLocal(resolvedBodies, patternId);
      let Option::SOME(localId) = localOpt else {
        Analyzer::Typecheck::emitUnsupported(state, span, "unresolved local binding");
        return false;
      };

      Analyzer::Typecheck::markBindingDeclared(state, patternId.raw(), span, mutable);

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.localPatternIds.push(patternId);
      stateRef.localFunctionIds.push(localId.enclosingFn);
      stateRef.localIndexes.push(localId.index);
      stateRef.localTypeIds.push(typeId);
      stateRef.localMutableFlags.push(mutable);
      stateRef.localPendingFlags.push(false);
      Analyzer::Typecheck::recordBindingType(state, patternId.raw(), typeId);
      return true;
    }

    /// Register a binding whose type the first assignment will decide.
    ///
    /// `placeholder` stands in until then and is never compared against
    /// anything: `readPendingLocal` reports a read that happens first, and
    /// `resolvePendingLocal` replaces it when the assignment arrives.
    function pushPendingPatternLocal(
      state: &mut Analyzer::Typecheck::TypecheckState,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
      placeholder: Analyzer::TypeId,
      span: SourceSpan,
    ): boolean {
      if (!Analyzer::Typecheck::pushPatternLocal(state, resolvedBodies, patternId, placeholder, true, span)) {
        return false;
      }

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      let last: u64 = stateRef.localPendingFlags.length() - 1;
      stateRef.localPendingFlags.set(last, true);
      return true;
    }

    /// Give a pending binding the type its first assignment supplies.
    ///
    /// Answers false when the id names no live binding or when that binding is
    /// not pending, which is every ordinary assignment.
    function resolvePendingLocal(
      state: &mut Analyzer::Typecheck::TypecheckState,
      localId: Analyzer::ResolverBodies::LocalId,
      typeId: Analyzer::TypeId,
    ): boolean {
      let count: u64 = state.localTypeIds.length();
      let mut index: u64 = count;

      while (index > 0) {
        index -= 1;

        let Option::SOME(functionId) = state.localFunctionIds.get(index) else {
          continue;
        };
        let Option::SOME(localIndex) = state.localIndexes.get(index) else {
          continue;
        };

        if (functionId.raw() != localId.enclosingFn.raw() || *localIndex != localId.index) {
          continue;
        }

        let Option::SOME(pending) = state.localPendingFlags.get(index) else {
          return false;
        };

        if (!*pending) {
          return false;
        }

        let mut patternRaw: u32 = 0;
        let mut havePattern: boolean = false;

        if (let Option::SOME(patternId) = state.localPatternIds.get(index)) {
          patternRaw = patternId.raw();
          havePattern = true;
        }

        let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
        stateRef.localTypeIds.set(index, typeId);
        stateRef.localPendingFlags.set(index, false);

        if (havePattern) {
          Analyzer::Typecheck::recordBindingType(state, patternRaw, typeId);
        }

        return true;
      }

      return false;
    }

    function lookupPatternRef(
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
    ): Option<Analyzer::ResolverBodies::ResolvedRef> {
      return Analyzer::ResolverBodies::findPatternRef(&resolvedBodies.bodyResolution, patternId.raw());
    }

    /// Strips a single `&T` / `&mut T` layer from a receiver type so member
    /// access and method calls reach the referent's record or enum.
    ///
    /// `self` inside a method body has type `Reference(Owner)` because the
    /// parser emits `&self` / `&mut self` as a reference pattern, so without
    /// this every `self.field` and `self.method()` fails to resolve.
    ///
    /// Aliases are chased before and after the strip so `&Alias` reaches the
    /// aliased type. Exactly one layer is removed, matching the reference
    /// compiler: chasing further would silently accept a `&&T` receiver that
    /// nothing in the language produces.
    ///
    /// Applied at receiver sites only. Record initializers and enum patterns
    /// share the `require*` helpers and must keep rejecting a reference.
    function derefReceiverType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Analyzer::TypeId {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      if (resolved.cycleAlias.isSome()) {
        return typeId;
      }

      let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
        return typeId;
      };

      let mut referentOpt: Option<Analyzer::TypeId> = Option::NONE;

      match (resolvedNode) {
        Analyzer::Type::Reference(reference) -> {
          referentOpt = Option::SOME(reference.referent);
        },
        _ -> {},
      };

      let Option::SOME(referent) = referentOpt else {
        return typeId;
      };

      let referentResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, referent);

      if (referentResolved.cycleAlias.isSome()) {
        return typeId;
      }

      return referentResolved.typeId;
    }

    /// Mutability of the receiver's reference layer, when it has one.
    ///
    /// `SOME(true)` for `&mut T`, `SOME(false)` for `&T`, `NONE` when the
    /// receiver is not a reference (after alias resolution). Mut-self checks
    /// consult this before the binding: a reference receiver's mutability
    /// lives in the reference type, not in the local binding that holds it.
    function receiverReferenceMutability(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Option<boolean> {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      if (resolved.cycleAlias.isSome()) {
        return Option::NONE;
      }

      let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
        return Option::NONE;
      };

      return match (resolvedNode) {
        Analyzer::Type::Reference(reference) -> Option::SOME(reference.mutable),
        _ -> Option::NONE,
      };
    }

    function requireNonGenericRecordDefId(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonRecordMessage: str,
      genericMessage: str,
    ): Option<Analyzer::DefinitionId> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Record(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Record(record_) -> {
              if (record_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(defId);
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Instance(_) -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
          return Option::NONE;
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireNonGenericRecordDefId match did not return");
    }

    function requireNonGenericEnumDefId(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonEnumMessage: str,
      genericMessage: str,
    ): Option<Analyzer::DefinitionId> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Enum(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Enum(enum_) -> {
              if (enum_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(defId);
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Instance(_) -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
          return Option::NONE;
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireNonGenericEnumDefId match did not return");
    }

    /// The enum a variant pattern destructures, together with what its type
    /// parameters stand for when the scrutinee is an instantiated generic
    /// (`Option<String>`); both vectors are empty for a plain enum.
    record PatternEnumOwner {
      public defId: Analyzer::DefinitionId;
      public typeParamSymbols: Vector<Analyzer::SymbolId>;
      public typeArguments: Vector<Analyzer::TypeId>;
    }

    /// The enum behind a variant-pattern scrutinee. Accepts a plain enum and
    /// an instantiated generic enum; a bare generic enum — nothing to bind its
    /// parameters to — and every non-enum type are rejected with the caller's
    /// messages, mirroring `requireMethodOwner`'s owner handling.
    function requireEnumOwnerForPattern(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonEnumMessage: str,
      genericMessage: str,
    ): Option<Analyzer::Typecheck::PatternEnumOwner> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Enum(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Enum(enum_) -> {
              if (enum_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(Analyzer::Typecheck::PatternEnumOwner {
                defId: defId,
                typeParamSymbols: Vector::new<Analyzer::SymbolId>(),
                typeArguments: Vector::new<Analyzer::TypeId>(),
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Instance(instance) -> {
          let instanceDefId: Analyzer::DefinitionId = instance.definition;
          let Option::SOME(def) = defStore.get(instanceDefId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Enum(enum_) -> {
              let typeParamSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::ownerTypeParamSymbols(defStore, &enum_.typeParams);

              return Option::SOME(Analyzer::Typecheck::PatternEnumOwner {
                defId: instanceDefId,
                typeParamSymbols: typeParamSymbols,
                typeArguments: Analyzer::Typecheck::copyVariantPayloadTypeIds(&instance.typeArguments),
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
              return Option::NONE;
            },
          };
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireEnumOwnerForPattern match did not return");
    }

    record RequiredMethodOwner {
      public defId: Analyzer::DefinitionId;
      public typeId: Analyzer::TypeId;
      public instanceMethods: Vector<Analyzer::DefinitionId>;
      public staticMethods: Vector<Analyzer::DefinitionId>;
      /// Interned names of the owner's declared type parameters, in declaration
      /// order. Empty for a non-generic owner.
      public typeParamSymbols: Vector<Analyzer::SymbolId>;
      /// What the receiver instantiates those parameters with. Empty when the
      /// receiver names the declaration itself rather than an instance of it,
      /// in which case the method's declared types are used as written.
      public typeArguments: Vector<Analyzer::TypeId>;
    }

    /// Copies a `Vector<DefinitionId>` element-by-element. `Vector` has no
    /// `clone()`, and matching a `&Definition` binds its payload by reference,
    /// so owner method tables must be copied out one id at a time (mirrors how
    /// `requireNonGenericRecord` collects `RequiredRecordDef.fields`).
    function copyDefinitionIdVector(
      source: &Vector<Analyzer::DefinitionId>
    ): Vector<Analyzer::DefinitionId> {
      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        let Option::SOME(defId) = source.get(index) else {
          index += 1;
          continue;
        };

        out.push(*defId);
        index += 1;
      }

      return out;
    }

    /// Copies a variant's `Vector<TypeId>` payload element-by-element, for the
    /// same reason as `copyDefinitionIdVector`: `Vector` has no `clone()`, and
    /// matching a `&Definition` binds its payload by reference. Named apart from
    /// `copyTypeIdVector` in typecheck_exprs.ign, which is not visible from this
    /// module and would collide if redeclared.
    function copyVariantPayloadTypeIds(
      source: &Vector<Analyzer::TypeId>
    ): Vector<Analyzer::TypeId> {
      let mut out: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        let Option::SOME(typeId) = source.get(index) else {
          index += 1;
          continue;
        };

        out.push(*typeId);
        index += 1;
      }

      return out;
    }

    /// Parallel to `requireNonGenericRecord` (ADR A4 — that helper is NOT
    /// modified, its record-init/destructuring callers rely on its record-only
    /// rejection). Accepts non-generic Record OR Enum owners for method-call
    /// resolution, copying their `instanceMethods`/`staticMethods` tables.
    function requireMethodOwner(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonOwnerMessage: str,
      genericMessage: str,
    ): Option<Analyzer::Typecheck::RequiredMethodOwner> {
      let enclosing: Analyzer::DefinitionId = state.currentFunction;
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Record(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Record(record_) -> {
              if (record_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(Analyzer::Typecheck::RequiredMethodOwner {
                defId: defId,
                typeId: record_.typeId,
                instanceMethods: Analyzer::Typecheck::copyDefinitionIdVector(&record_.instanceMethods),
                staticMethods: Analyzer::Typecheck::copyDefinitionIdVector(&record_.staticMethods),
                typeParamSymbols: Vector::new<Analyzer::SymbolId>(),
                typeArguments: Vector::new<Analyzer::TypeId>(),
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Enum(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Enum(enum_) -> {
              if (enum_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(Analyzer::Typecheck::RequiredMethodOwner {
                defId: defId,
                typeId: enum_.typeId,
                instanceMethods: Analyzer::Typecheck::copyDefinitionIdVector(&enum_.instanceMethods),
                staticMethods: Analyzer::Typecheck::copyDefinitionIdVector(&enum_.staticMethods),
                typeParamSymbols: Vector::new<Analyzer::SymbolId>(),
                typeArguments: Vector::new<Analyzer::TypeId>(),
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
              return Option::NONE;
            },
          };
        },
        // An instantiated owner carries what its type parameters stand for, so the
        // method's declared types can be substituted before anything is compared.
        // Only the bare declaration, matched above, still has nothing to bind them to.
        Analyzer::Type::Instance(instance) -> {
          let instanceDefId: Analyzer::DefinitionId = instance.definition;
          let Option::SOME(def) = defStore.get(instanceDefId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Record(record_) -> {
              let typeParamSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::ownerTypeParamSymbols(defStore, &record_.typeParams);

              return Option::SOME(Analyzer::Typecheck::RequiredMethodOwner {
                defId: instanceDefId,
                typeId: resolvedType.typeId,
                instanceMethods: Analyzer::Typecheck::copyDefinitionIdVector(&record_.instanceMethods),
                staticMethods: Analyzer::Typecheck::copyDefinitionIdVector(&record_.staticMethods),
                typeParamSymbols: typeParamSymbols,
                typeArguments: Analyzer::Typecheck::copyVariantPayloadTypeIds(&instance.typeArguments),
              });
            },
            Analyzer::Definition::Enum(enum_) -> {
              let typeParamSymbols: Vector<Analyzer::SymbolId> = Analyzer::Typecheck::ownerTypeParamSymbols(defStore, &enum_.typeParams);

              return Option::SOME(Analyzer::Typecheck::RequiredMethodOwner {
                defId: instanceDefId,
                typeId: resolvedType.typeId,
                instanceMethods: Analyzer::Typecheck::copyDefinitionIdVector(&enum_.instanceMethods),
                staticMethods: Analyzer::Typecheck::copyDefinitionIdVector(&enum_.staticMethods),
                typeParamSymbols: typeParamSymbols,
                typeArguments: Analyzer::Typecheck::copyVariantPayloadTypeIds(&instance.typeArguments),
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
              return Option::NONE;
            },
          };
        },
        // A bounded type parameter answers the methods its bounds declare. The
        // trait stands in as the owner here; monomorphization re-dispatches the
        // call to the concrete implementation once the parameter is substituted.
        Analyzer::Type::Param(symbol) -> {
          let Option::SOME(traitDefId) = Analyzer::Typecheck::traitBoundOwnerFor(defStore, symbols, enclosing, symbol) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
            return Option::NONE;
          };

          let Option::SOME(Analyzer::Definition::Trait(trait_)) = defStore.get(traitDefId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
            return Option::NONE;
          };

          return Option::SOME(Analyzer::Typecheck::RequiredMethodOwner {
            defId: traitDefId,
            typeId: resolvedType.typeId,
            instanceMethods: Analyzer::Typecheck::copyDefinitionIdVector(&trait_.methods),
            staticMethods: Vector::new<Analyzer::DefinitionId>(),
            typeParamSymbols: Vector::new<Analyzer::SymbolId>(),
            typeArguments: Vector::new<Analyzer::TypeId>(),
          });
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireMethodOwner match did not return");
    }

    /// The type-parameter definitions nameable inside `enclosing`: the callable's
    /// own parameters first, then those of the record, enum or trait declaring it,
    /// so an inner parameter shadows an outer one written with the same name.
    function typeParamsInScope(
      defStore: &mut Analyzer::DefinitionStore,
      enclosing: Analyzer::DefinitionId,
    ): Vector<Analyzer::DefinitionId> {
      let mut scoped: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut ownerOpt: Option<Analyzer::DefinitionId> = Option::NONE;

      if (let Option::SOME(def) = defStore.get(enclosing)) {
        match (def) {
          Analyzer::Definition::Function(function_) -> {
            scoped = Analyzer::Typecheck::copyDefinitionIdVector(&function_.typeParams);
          },
          Analyzer::Definition::Method(method) -> {
            scoped = Analyzer::Typecheck::copyDefinitionIdVector(&method.typeParams);
            ownerOpt = Option::SOME(method.owner);
          },
          _ -> {},
        };
      }

      if (let Option::SOME(ownerDefId) = ownerOpt) {
        let mut ownerParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

        if (let Option::SOME(ownerDef) = defStore.get(ownerDefId)) {
          match (ownerDef) {
            Analyzer::Definition::Record(record_) -> {
              ownerParams = Analyzer::Typecheck::copyDefinitionIdVector(&record_.typeParams);
            },
            Analyzer::Definition::Enum(enum_) -> {
              ownerParams = Analyzer::Typecheck::copyDefinitionIdVector(&enum_.typeParams);
            },
            Analyzer::Definition::Trait(trait_) -> {
              ownerParams = Analyzer::Typecheck::copyDefinitionIdVector(&trait_.typeParams);
            },
            _ -> {},
          };
        }

        let mut ownerIndex: u64 = 0;

        while (ownerIndex < ownerParams.length()) {
          if (let Option::SOME(paramDefId) = ownerParams.get(ownerIndex)) {
            scoped.push(*paramDefId);
          }

          ownerIndex += 1;
        }
      }

      return scoped;
    }

    /// The first trait the type parameter named `symbol` is bounded by, as seen
    /// from `enclosing` — the callable whose body is being checked.
    ///
    /// Only the parameters in scope can answer: two generic declarations may both
    /// name a parameter `T` and bound it by different traits, so a store-wide
    /// search by name would let one declaration's bound decide another's method
    /// lookup. Bounds themselves are held as written names, so the bound is still
    /// matched by name against the trait declarations in the store. A parameter
    /// with no bound, or a bound naming something that is not a trait, has no
    /// owner to answer methods.
    function traitBoundOwnerFor(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      enclosing: Analyzer::DefinitionId,
      symbol: Analyzer::SymbolId,
    ): Option<Analyzer::DefinitionId> {
      let scoped: Vector<Analyzer::DefinitionId> = Analyzer::Typecheck::typeParamsInScope(defStore, enclosing);
      let mut boundNames: Vector<String> = Vector::new<String>();
      let mut index: u64 = 0;

      while (index < scoped.length()) {
        let Option::SOME(paramDefId) = scoped.get(index) else {
          index += 1;
          continue;
        };

        if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*paramDefId)) {
          if (typeParam.name.raw() == symbol.raw()) {
            boundNames = Analyzer::Typecheck::copyStringVector(&typeParam.bounds);
            index = scoped.length();
            continue;
          }
        }

        index += 1;
      }

      let mut boundIndex: u64 = 0;

      while (boundIndex < boundNames.length()) {
        let Option::SOME(boundName) = boundNames.get(boundIndex) else {
          boundIndex += 1;
          continue;
        };

        let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
        let boundSymbol: Analyzer::SymbolId = symbolsRef.intern(boundName.toStr());
        let mut traitIndex: u64 = 0;

        while (traitIndex < defStore.length()) {
          let candidateId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(traitIndex as u32);

          if (let Option::SOME(Analyzer::Definition::Trait(trait_)) = defStore.get(candidateId)) {
            if (trait_.name.raw() == boundSymbol.raw()) {
              return Option::SOME(candidateId);
            }
          }

          traitIndex += 1;
        }

        boundIndex += 1;
      }

      return Option::NONE;
    }

    function copyStringVector(source: &Vector<String>): Vector<String> {
      let mut copy: Vector<String> = Vector::new<String>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        if (let Option::SOME(entry) = source.get(index)) {
          copy.push(entry.clone());
        }

        index += 1;
      }

      return copy;
    }

    function recordFieldCount(
      defStore: &mut Analyzer::DefinitionStore,
      recordDefId: Analyzer::DefinitionId
    ): u64 {
      let Option::SOME(def) = defStore.get(recordDefId) else {
        return 0;
      };

      match (def) {
        Analyzer::Definition::Record(record_) -> {
          return record_.fields.length();
        },
        _ -> {
          return 0;
        },
      };

      @panic("unreachable: recordFieldCount match did not return");
    }

    function astRecordFieldTypeAt(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pattern: &Ast::Pattern::Path,
      index: u64,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(recordName) = pattern.segments.get(0) else {
        return Option::NONE;
      };

      let mut rootIndex: u64 = 0;
      while (rootIndex < module.roots.length()) {
        let Option::SOME(itemId) = module.roots.get(rootIndex) else {
          rootIndex += 1;
          continue;
        };
        let Option::SOME(item) = module.items.get(*itemId) else {
          rootIndex += 1;
          continue;
        };

        if (let Ast::Item::Node::Record(record_) = item) {
          if (record_.name.equals(recordName.toStr())) {
            let Option::SOME(fieldPatternId) = record_.fields.get(index) else {
              return Option::NONE;
            };
            let Option::SOME(fieldPattern) = module.patterns.get(*fieldPatternId) else {
              return Option::NONE;
            };
            if (let Ast::Pattern::Node::Binding(binding) = fieldPattern) {
              let Option::SOME(annotationId) = binding.annotation else {
                return Option::NONE;
              };
              return Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, annotationId);
            }
            return Option::NONE;
          }
        }

        rootIndex += 1;
      }

      return Option::NONE;
    }

    function collectRecordPathPatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      patternId: Ast::PatternId,
      pattern: &Ast::Pattern::Path,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): boolean {
      let expectedRecordDefIdOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::requireNonGenericRecordDefId(
        state,
        defStore,
        typeStore,
        span,
        typeId,
        "record destructure annotation must be a non-generic record",
        "typecheck does not support generic record destructuring",
      );
      let Option::SOME(expectedRecordDefId) = expectedRecordDefIdOpt else {
        return false;
      };

      let refOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupPatternRef(resolvedBodies, patternId);
      let Option::SOME(ref_) = refOpt else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure pattern must resolve to a non-generic record");
        return false;
      };

      let constructorDefId: Analyzer::DefinitionId = match (ref_) {
        Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> defId,
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure pattern must resolve to a non-generic record");
          return false;
        },
      };

      let constructorTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::definitionType(defStore, typeStore, constructorDefId);
      let Option::SOME(constructorType) = constructorTypeOpt else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure pattern must resolve to a non-generic record");
        return false;
      };

      let constructorRecordDefIdOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::requireNonGenericRecordDefId(
        state,
        defStore,
        typeStore,
        span,
        constructorType,
        "record destructure pattern must resolve to a non-generic record",
        "typecheck does not support generic record destructuring",
      );
      let Option::SOME(_) = constructorRecordDefIdOpt else {
        return false;
      };

      if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, typeId, constructorType)) {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure pattern does not match annotated record type");
        return false;
      }

      let expectedFieldCount: u64 = Analyzer::Typecheck::recordFieldCount(defStore, expectedRecordDefId);
      if (pattern.arguments.length() != expectedFieldCount) {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::PATTERN_ARITY_MISMATCH, "record destructure field count mismatch");
        return false;
      }

      let mut index: u64 = 0;
      while (index < expectedFieldCount) {
        let Option::SOME(argPatternId) = pattern.arguments.get(index) else {
          index += 1;
          continue;
        };
        let fieldTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::astRecordFieldTypeAt(defStore, typeStore, symbols, module, pattern, index);
        let Option::SOME(fieldType) = fieldTypeOpt else {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure field type is unavailable");
          return false;
        };

        if (!Analyzer::Typecheck::collectPatternBindings(state, defStore, typeStore, symbols, resolvedBodies, module, *argPatternId, fieldType, mutable, span)) {
          return false;
        }

        index += 1;
      }

      return true;
    }

    /// Binds an enum-variant path pattern (`EnumName::Variant` or
    /// `EnumName::Variant(args...)`) against a scrutinee type. Parallel to
    /// `collectRecordPathPatternBindings`, but the constructor's kind is
    /// resolved once by the caller (`collectPatternBindings`) via the
    /// `BodyResolutionMap`, so this function receives `variantDefId` directly
    /// instead of re-deriving it from `pattern`.
    ///
    /// Payload sub-patterns are bound against `VariantDef.payload`, which the
    /// resolver fills with the declared slot types.
    function collectEnumVariantPatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      pattern: &Ast::Pattern::Path,
      variantDefId: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): boolean {
      // Matching through a reference destructures the referent: `match (src)`
      // on a `&Source` names the same variants as on a `Source`. The payload
      // sub-patterns still bind the declared types, so handing one on by value
      // moves out of borrowed storage, which is the borrow checker's call.
      let scrutineeType: Analyzer::TypeId = Analyzer::Typecheck::derefReceiverType(defStore, typeStore, typeId);

      let ownerOpt: Option<Analyzer::Typecheck::PatternEnumOwner> = Analyzer::Typecheck::requireEnumOwnerForPattern(
        state,
        defStore,
        typeStore,
        span,
        scrutineeType,
        "enum variant pattern must match an enum",
        "typecheck does not support generic enum destructuring",
      );
      let Option::SOME(enumOwner) = ownerOpt else {
        return false;
      };
      let expectedEnumDefId: Analyzer::DefinitionId = enumOwner.defId;

      let Option::SOME(variantDefNode) = defStore.get(variantDefId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "enum variant pattern must resolve to a variant of the scrutinee's enum");
        return false;
      };

      let variant: Analyzer::VariantDef = match (variantDefNode) {
        Analyzer::Definition::Variant(v) -> Analyzer::VariantDef {
          name: v.name,
          payload: Analyzer::Typecheck::copyVariantPayloadTypeIds(&v.payload),
          owner: v.owner,
          tagValue: v.tagValue,
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "enum variant pattern must resolve to a variant of the scrutinee's enum");
          return false;
        },
      };

      if (variant.owner.raw() != expectedEnumDefId.raw()) {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "enum variant pattern does not belong to the scrutinee's enum");
        return false;
      }

      let expectedArity: u64 = variant.payload.length();
      if (pattern.arguments.length() != expectedArity) {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::PATTERN_ARITY_MISMATCH, "enum variant pattern arity does not match the variant's declared payload");
        return false;
      }

      let mut index: u64 = 0;
      while (index < expectedArity) {
        let Option::SOME(argPatternId) = pattern.arguments.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(payloadType) = variant.payload.get(index) else {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "enum variant payload type is unavailable");
          return false;
        };

        let mut boundType: Analyzer::TypeId = *payloadType;
        if (enumOwner.typeArguments.length() == enumOwner.typeParamSymbols.length() && enumOwner.typeParamSymbols.length() > 0) {
          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          boundType = typeStoreRef.substitute(boundType, &enumOwner.typeParamSymbols, &enumOwner.typeArguments);
        }

        if (!Analyzer::Typecheck::collectPatternBindings(state, defStore, typeStore, symbols, resolvedBodies, module, *argPatternId, boundType, mutable, span)) {
          return false;
        }

        index += 1;
      }

      return true;
    }

    /// Reports whether `patternId` introduces any binding. Mirrors the
    /// reference analyzer's `pattern_has_bindings`; the selfhost AST spells a
    /// binding as its own `Pattern::Node::Binding`, so unlike the reference
    /// analyzer no name resolution is needed to tell a binding apart from a
    /// payload-less enum-variant path.
    function patternHasBindings(module: &Ast::Module, patternId: Ast::PatternId): boolean {
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return false;
      };

      match (pattern) {
        Ast::Pattern::Node::Binding(_) -> {
          return true;
        },
        Ast::Pattern::Node::Wildcard(_) -> {
          return false;
        },
        Ast::Pattern::Node::Literal(_) -> {
          return false;
        },
        Ast::Pattern::Node::Path(path) -> {
          return Analyzer::Typecheck::anyPatternHasBindings(module, &path.arguments);
        },
        Ast::Pattern::Node::Tuple(tuple) -> {
          return Analyzer::Typecheck::anyPatternHasBindings(module, &tuple.elements);
        },
        Ast::Pattern::Node::Or(orPattern) -> {
          return Analyzer::Typecheck::anyPatternHasBindings(module, &orPattern.alternatives);
        },
      };

      @panic("unreachable: patternHasBindings match did not return");
    }

    function anyPatternHasBindings(
      module: &Ast::Module,
      patterns: &Vector<Ast::PatternId>,
    ): boolean {
      let mut index: u64 = 0;
      while (index < patterns.length()) {
        let Option::SOME(patternId) = patterns.get(index) else {
          index += 1;
          continue;
        };

        if (Analyzer::Typecheck::patternHasBindings(module, *patternId)) {
          return true;
        }

        index += 1;
      }

      return false;
    }

    /// Typechecks a literal pattern against the scrutinee type. A literal
    /// pattern binds nothing, so its only obligation is that its value could
    /// have the scrutinee's type.
    ///
    /// The literal itself goes through `checkLiteralExprExpected`, the same
    /// path expression position uses, so a literal pattern adopts an integer
    /// or float scrutinee type and reports overflow exactly as the reference
    /// analyzer does. The remaining comparison is symmetric — neither side is
    /// a value being supplied to the other — so it stays on `typesEqual`.
    function collectLiteralPatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      module: &Ast::Module,
      pattern: &Ast::Pattern::Literal,
      typeId: Analyzer::TypeId,
    ): boolean {
      let Option::SOME(expression) = module.expressions.get(pattern.expression) else {
        return true;
      };

      // The parser only ever builds a literal pattern around a literal
      // expression, so anything else is a malformed module rather than a
      // language construct that needs its own diagnostic.
      let Ast::Expression::Node::Literal(literal) = expression else {
        Analyzer::Typecheck::emitUnsupported(state, pattern.span, "non-literal expressions in literal patterns");
        return false;
      };

      let actualTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::checkLiteralExprExpected(
        state,
        defStore,
        typeStore,
        pattern.expression,
        &literal,
        Option::SOME(typeId),
      );

      // A rejected literal (integer overflow, or `null` against a non-pointer)
      // already reported itself; a second diagnostic would only repeat it.
      let Option::SOME(actualType) = actualTypeOpt else {
        return false;
      };

      if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, pattern.span, typeId, actualType)) {
        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, pattern.span, typeId, actualType);
        return false;
      }

      return true;
    }

    /// Typechecks a tuple pattern against the scrutinee type: the scrutinee
    /// must be a tuple of the same arity, and each sub-pattern binds against
    /// the element type in the same position.
    function collectTuplePatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      pattern: &Ast::Pattern::Tuple,
      typeId: Analyzer::TypeId,
      mutable: boolean,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      // Element types are copied out first so the store borrow ends before the
      // recursive calls, which need the store mutably.
      let mut elementTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut scrutineeIsTuple: boolean = false;

      if (let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId)) {
        if (let Analyzer::Type::Tuple(tupleType) = resolvedNode) {
          scrutineeIsTuple = true;

          let mut elementIndex: u64 = 0;
          while (elementIndex < tupleType.elements.length()) {
            let Option::SOME(elementTypeId) = tupleType.elements.get(elementIndex) else {
              elementIndex += 1;
              continue;
            };

            elementTypes.push(*elementTypeId);
            elementIndex += 1;
          }
        }
      }

      if (!scrutineeIsTuple) {
        Analyzer::Typecheck::emitPatternTypeMismatch(state, typeStore, pattern.span, typeId, "tuple");
        return false;
      }

      if (pattern.elements.length() != elementTypes.length()) {
        let got: String = `tuple with ${pattern.elements.length()} elements`;
        Analyzer::Typecheck::emitPatternTypeMismatch(state, typeStore, pattern.span, typeId, got.toStr());
        return false;
      }

      let mut index: u64 = 0;
      while (index < elementTypes.length()) {
        let Option::SOME(elementPatternId) = pattern.elements.get(index) else {
          index += 1;
          continue;
        };
        let Option::SOME(elementType) = elementTypes.get(index) else {
          index += 1;
          continue;
        };

        if (!Analyzer::Typecheck::collectPatternBindings(state, defStore, typeStore, symbols, resolvedBodies, module, *elementPatternId, *elementType, mutable, pattern.span)) {
          return false;
        }

        index += 1;
      }

      return true;
    }

    /// Typechecks an or-pattern: every alternative is checked against the same
    /// scrutinee type.
    ///
    /// Alternatives that introduce bindings are rejected. Matching an
    /// alternative that binds requires the resolver to merge the binding sets
    /// of every alternative into one, which it does not do yet (IGN-15): it
    /// walks each alternative and truncates its locals before the next. The
    /// reference analyzer draws the same line for the same reason, so
    /// accepting them here would bind names that no alternative can be
    /// guaranteed to have produced.
    function collectOrPatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      pattern: &Ast::Pattern::Or,
      typeId: Analyzer::TypeId,
      mutable: boolean,
    ): boolean {
      let mut accepted: boolean = true;

      if (Analyzer::Typecheck::anyPatternHasBindings(module, &pattern.alternatives)) {
        Analyzer::Typecheck::emitOrPatternBindingsDisallowed(state, pattern.span);
        accepted = false;
      }

      // Every alternative is still checked after a rejected binding set, so a
      // type error in a later alternative is not hidden by the first problem.
      let mut index: u64 = 0;
      while (index < pattern.alternatives.length()) {
        let Option::SOME(alternativeId) = pattern.alternatives.get(index) else {
          index += 1;
          continue;
        };

        if (!Analyzer::Typecheck::collectPatternBindings(state, defStore, typeStore, symbols, resolvedBodies, module, *alternativeId, typeId, mutable, pattern.span)) {
          accepted = false;
        }

        index += 1;
      }

      return accepted;
    }

    function collectPatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      patternId: Ast::PatternId,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): boolean {
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return true;
      };

      match (pattern) {
        Ast::Pattern::Node::Binding(_) -> {
          return Analyzer::Typecheck::pushPatternLocal(state, resolvedBodies, patternId, typeId, mutable, span);
        },
        Ast::Pattern::Node::Wildcard(_) -> {
          return true;
        },
        Ast::Pattern::Node::Path(path) -> {
          let patternRefOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupPatternRef(resolvedBodies, patternId);

          // A single-segment path the resolver bound as a LOCAL is a plain
          // binding wearing path syntax — it takes the scrutinee's type,
          // never the record-destructure machinery.
          let mut pathBindsLocal: boolean = false;
          if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Local(_)) = Analyzer::Typecheck::lookupPatternRef(resolvedBodies, patternId)) {
            pathBindsLocal = true;
          }

          if (pathBindsLocal) {
            return Analyzer::Typecheck::pushPatternLocal(state, resolvedBodies, patternId, typeId, mutable, span);
          }

          if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Definition(defId)) = patternRefOpt) {
            if (let Option::SOME(def) = defStore.get(defId)) {
              // A constant pattern binds nothing; its only obligation — value
              // comparability with the scrutinee — is checked at lowering.
              if (let Analyzer::Definition::Variable(_) = def) {
                return true;
              }

              if (let Analyzer::Definition::Variant(_) = def) {
                return Analyzer::Typecheck::collectEnumVariantPatternBindings(
                  state,
                  defStore,
                  typeStore,
                  symbols,
                  resolvedBodies,
                  module,
                  &path,
                  defId,
                  typeId,
                  mutable,
                  span,
                );
              }
            }
          }

          return Analyzer::Typecheck::collectRecordPathPatternBindings(
            state,
            defStore,
            typeStore,
            symbols,
            resolvedBodies,
            module,
            patternId,
            &path,
            typeId,
            mutable,
            span,
          );
        },
        Ast::Pattern::Node::Literal(literal) -> {
          return Analyzer::Typecheck::collectLiteralPatternBindings(
            state,
            defStore,
            typeStore,
            module,
            &literal,
            typeId,
          );
        },
        Ast::Pattern::Node::Tuple(tuple) -> {
          return Analyzer::Typecheck::collectTuplePatternBindings(
            state,
            defStore,
            typeStore,
            symbols,
            resolvedBodies,
            module,
            &tuple,
            typeId,
            mutable,
          );
        },
        Ast::Pattern::Node::Or(orPattern) -> {
          return Analyzer::Typecheck::collectOrPatternBindings(
            state,
            defStore,
            typeStore,
            symbols,
            resolvedBodies,
            module,
            &orPattern,
            typeId,
            mutable,
          );
        },
      };

      @panic("unreachable: collectPatternBindings match did not return");
    }

    function bindPatternType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      patternId: Ast::PatternId,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): void {
      let mark: u64 = state.localPatternIds.length();
      if (!Analyzer::Typecheck::collectPatternBindings(state, defStore, typeStore, symbols, resolvedBodies, module, patternId, typeId, mutable, span)) {
        Analyzer::Typecheck::truncateLocalBindings(state, mark);
      }
    }

    function definitionType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      defId: Analyzer::DefinitionId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Variable(variable) -> {
          return Option::SOME(variable.declaredType);
        },
        Analyzer::Definition::Function(function_) -> {
          let mut params: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < function_.params.length()) {
            let Option::SOME(paramDefId) = function_.params.get(index) else {
              index += 1;
              continue;
            };

            let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
              index += 1;
              continue;
            };

            match (paramDef) {
              Analyzer::Definition::Variable(parameter) -> {
                params.push(parameter.declaredType);
              },
              Analyzer::Definition::Function(_) -> {},
              Analyzer::Definition::Record(_) -> {},
              Analyzer::Definition::Enum(_) -> {},
              Analyzer::Definition::Field(_) -> {},
              Analyzer::Definition::Variant(_) -> {},
              Analyzer::Definition::TypeParam(_) -> {},
              Analyzer::Definition::TypeAlias(_) -> {},
              Analyzer::Definition::Trait(_) -> {},
              Analyzer::Definition::Method(_) -> {},
            };

            index += 1;
          }

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.functionType(params, function_.returnType));
        },
        Analyzer::Definition::Method(method) -> {
          // A method's callable type mirrors a function: parameter types from
          // its `Variable` sub-definitions (including `self` for instance
          // methods) plus the resolved return type. `checkCallExpr` and
          // `checkInstanceMethodCallExpr` are the actual call-resolution
          // consumers; this keeps `definitionType` total over `Definition::Method`.
          let mut params: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < method.params.length()) {
            let Option::SOME(paramDefId) = method.params.get(index) else {
              index += 1;
              continue;
            };

            let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
              index += 1;
              continue;
            };

            match (paramDef) {
              Analyzer::Definition::Variable(parameter) -> {
                params.push(parameter.declaredType);
              },
              Analyzer::Definition::Function(_) -> {},
              Analyzer::Definition::Record(_) -> {},
              Analyzer::Definition::Enum(_) -> {},
              Analyzer::Definition::Field(_) -> {},
              Analyzer::Definition::Variant(_) -> {},
              Analyzer::Definition::TypeParam(_) -> {},
              Analyzer::Definition::TypeAlias(_) -> {},
              Analyzer::Definition::Trait(_) -> {},
              Analyzer::Definition::Method(_) -> {},
            };

            index += 1;
          }

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.functionType(params, method.returnType));
        },
        Analyzer::Definition::Record(record_) -> {
          return Option::SOME(record_.typeId);
        },
        Analyzer::Definition::Enum(enum_) -> {
          return Option::SOME(enum_.typeId);
        },
        Analyzer::Definition::TypeAlias(alias_) -> {
          return Option::SOME(alias_.typeId);
        },
        Analyzer::Definition::Field(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Variant(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Trait(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: definitionType match did not return");
    }

    record FunctionSignature {
      public params: Vector<Analyzer::DefinitionId>;
      public returnType: Analyzer::TypeId;
    }

    function extractFunctionSignature(
      defStore: &mut Analyzer::DefinitionStore,
      functionDefId: Analyzer::DefinitionId,
    ): Option<Analyzer::Typecheck::FunctionSignature> {
      let Option::SOME(def) = defStore.get(functionDefId) else {
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Function(function_) -> {
          let mut params: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let mut index: u64 = 0;

          while (index < function_.params.length()) {
            let Option::SOME(paramDefId) = function_.params.get(index) else {
              index += 1;
              continue;
            };

            params.push(*paramDefId);
            index += 1;
          }

          return Option::SOME(Analyzer::Typecheck::FunctionSignature {
            params: params,
            returnType: function_.returnType,
          });
        },
        Analyzer::Definition::Method(method) -> {
          // Methods reuse the function-signature shape: `MethodDef.params` are
          // `Variable` sub-definitions in source order, and `returnType` is the
          // resolver-patched method return type. This lets `checkFunctionItem`
          // typecheck method bodies exactly like function bodies.
          let mut params: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let mut index: u64 = 0;

          while (index < method.params.length()) {
            let Option::SOME(paramDefId) = method.params.get(index) else {
              index += 1;
              continue;
            };

            params.push(*paramDefId);
            index += 1;
          }

          return Option::SOME(Analyzer::Typecheck::FunctionSignature {
            params: params,
            returnType: method.returnType,
          });
        },
        Analyzer::Definition::Variable(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Record(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Enum(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Field(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Variant(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Trait(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: extractFunctionSignature match did not return");
    }

    /// The type arguments a generic enum's variant construction is built with,
    /// inferred from the expected type.
    ///
    /// Only an `expected` that alias-resolves to a `Type::Instance` naming this exact
    /// enum contributes anything; every other case yields no arguments and leaves the
    /// payload types unsubstituted, which the ordinary per-argument comparison then
    /// reports. This mirrors the reference analyzer, which infers variant type
    /// arguments from the expected type and from nowhere else.
    function inferVariantTypeArguments(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      constructor: &Analyzer::Typecheck::VariantConstructor,
      expected: Option<Analyzer::TypeId>,
    ): Vector<Analyzer::TypeId> {
      if (constructor.typeParamSymbols.length() == 0) {
        return Vector::new<Analyzer::TypeId>();
      }

      let Option::SOME(expectedType) = expected else {
        return Vector::new<Analyzer::TypeId>();
      };

      let resolvedExpected: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, expectedType);
      if (resolvedExpected.cycleAlias.isSome()) {
        return Vector::new<Analyzer::TypeId>();
      }

      let Option::SOME(resolvedExpectedNode) = typeStore.get(resolvedExpected.typeId) else {
        return Vector::new<Analyzer::TypeId>();
      };

      match (resolvedExpectedNode) {
        Analyzer::Type::Instance(instance) -> {
          if (instance.definition.raw() != constructor.enumDefId.raw()) {
            return Vector::new<Analyzer::TypeId>();
          }

          if (instance.typeArguments.length() != constructor.typeParamSymbols.length()) {
            return Vector::new<Analyzer::TypeId>();
          }

          return Analyzer::Typecheck::copyVariantPayloadTypeIds(&instance.typeArguments);
        },
        _ -> {
          return Vector::new<Analyzer::TypeId>();
        },
      };

      @panic("unreachable: inferVariantTypeArguments match did not return");
    }

    /// Everything `Enum::Variant` needs to be typed, whether it is used bare
    /// (unit variant) or applied to arguments (payload variant): the declared
    /// payload types, the owning enum's type, and whether that enum is generic.
    record VariantConstructor {
      public payload: Vector<Analyzer::TypeId>;
      public enumType: Analyzer::TypeId;
      public generic: boolean;
      /// The owning enum, needed to build the `Type::Instance` a generic
      /// construction produces.
      public enumDefId: Analyzer::DefinitionId;
      /// Interned names of the owning enum's type parameters, in declaration
      /// order. Empty for a non-generic enum.
      public typeParamSymbols: Vector<Analyzer::SymbolId>;
    }

    /// Interned names of a declaration's type parameters, in declaration order.
    /// Takes the parameter list itself, so it serves records and enums alike.
    ///
    /// Lives here rather than beside the callee-side equivalent in `typecheck_exprs`
    /// because `typecheck.ign` merges the typecheck files in import order and this file
    /// comes first, so it cannot reach anything declared there.
    function ownerTypeParamSymbols(
      defStore: &mut Analyzer::DefinitionStore,
      typeParams: &Vector<Analyzer::DefinitionId>,
    ): Vector<Analyzer::SymbolId> {
      let mut symbols: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();
      let mut index: u64 = 0;

      while (index < typeParams.length()) {
        let Option::SOME(typeParamDefId) = typeParams.get(index) else {
          index += 1;
          continue;
        };

        match (defStore.get(*typeParamDefId)) {
          Option::SOME(Analyzer::Definition::TypeParam(typeParam)) -> {
            symbols.push(typeParam.name);
          },
          _ -> {},
        };

        index += 1;
      }

      return symbols;
    }

    /// Variant constructor view of `defId`, or `NONE` when it is not a variant
    /// (or its owner is not an enum, which the binder never produces).
    function extractVariantConstructor(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Option<Analyzer::Typecheck::VariantConstructor> {
      let mut payload: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut ownerOpt: Option<Analyzer::DefinitionId> = Option::NONE;

      if (let Option::SOME(def) = defStore.get(defId)) {
        if (let Analyzer::Definition::Variant(variant) = def) {
          payload = Analyzer::Typecheck::copyVariantPayloadTypeIds(&variant.payload);
          ownerOpt = Option::SOME(variant.owner);
        }
      }

      let Option::SOME(owner) = ownerOpt else {
        return Option::NONE;
      };

      let mut enumTypeOpt: Option<Analyzer::TypeId> = Option::NONE;
      let mut generic: boolean = false;
      let mut typeParamSymbols: Vector<Analyzer::SymbolId> = Vector::new<Analyzer::SymbolId>();

      if (let Option::SOME(ownerDef) = defStore.get(owner)) {
        if (let Analyzer::Definition::Enum(enumDef) = ownerDef) {
          enumTypeOpt = Option::SOME(enumDef.typeId);
          generic = enumDef.typeParams.length() > 0;
          typeParamSymbols = Analyzer::Typecheck::ownerTypeParamSymbols(defStore, &enumDef.typeParams);
        }
      }

      let Option::SOME(enumType) = enumTypeOpt else {
        return Option::NONE;
      };

      return Option::SOME(Analyzer::Typecheck::VariantConstructor {
        payload: payload,
        enumType: enumType,
        generic: generic,
        enumDefId: owner,
        typeParamSymbols: typeParamSymbols,
      });
    }

    record MethodCallInfo {
      public isStatic: boolean;
      public selfMutable: boolean;
      public returnType: Analyzer::TypeId;
    }

    /// Centralizes `Definition::Method` detection so only one new `Definition`
    /// match is introduced here — consumed by `checkCallExpr`'s static-path
    /// branch, the instance-call mut-self check, and (WU3) the bare
    /// method-reference guard.
    function lookupMethodDefInfo(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Option<Analyzer::Typecheck::MethodCallInfo> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Method(method) -> {
          return Option::SOME(Analyzer::Typecheck::MethodCallInfo {
            isStatic: method.isStatic,
            selfMutable: method.selfMutable,
            returnType: method.returnType,
          });
        },
        Analyzer::Definition::Function(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Record(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Enum(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Variable(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Field(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Variant(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Trait(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: lookupMethodDefInfo match did not return");
    }

    /// Names resolved by `resolveLocalAnnotation`'s 1-segment branch as
    /// primitives via literal comparison. Shared with the N>=2 branch so a
    /// qualified path ending in a primitive name (e.g. `Ns::i32`) is skipped
    /// rather than incorrectly resolved.
    function isPrimitiveAnnotationName(name: str): boolean {
      if (name.equals("i8")) {
        return true;
      }
      if (name.equals("i16")) {
        return true;
      }
      if (name.equals("i32")) {
        return true;
      }
      if (name.equals("i64")) {
        return true;
      }
      if (name.equals("u8")) {
        return true;
      }
      if (name.equals("u16")) {
        return true;
      }
      if (name.equals("u32")) {
        return true;
      }
      if (name.equals("u64")) {
        return true;
      }
      if (name.equals("f32")) {
        return true;
      }
      if (name.equals("f64")) {
        return true;
      }
      if (name.equals("boolean")) {
        return true;
      }
      if (name.equals("char")) {
        return true;
      }
      if (name.equals("str")) {
        return true;
      }
      if (name.equals("void")) {
        return true;
      }
      if (name.equals("never")) {
        return true;
      }
      if (name.equals("atom")) {
        return true;
      }

      return false;
    }

    /// The declaration a generic annotation's base path names.
    ///
    /// Only a record or an enum answers: those are what `Type::Instance` instantiates.
    /// A parameterized type alias resolves to nothing here, so an annotation written
    /// over one stays unresolved rather than producing an instance of the alias itself.
    /// Like the `Path` arm of `resolveLocalAnnotation`, a qualified path is matched on
    /// its last segment alone — TODO(namespace-path-validation), the same debt tracked
    /// at `resolvePathTail` in resolver_bodies.ign.
    function lookupAnnotationBaseDefinition(
      defStore: &mut Analyzer::DefinitionStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      baseTypeId: Ast::TypeId,
    ): Option<Analyzer::DefinitionId> {
      let Option::SOME(baseNode) = module.types.get(baseTypeId) else {
        return Option::NONE;
      };

      let Ast::Type::Node::Path(path) = baseNode else {
        return Option::NONE;
      };

      if (path.segments.length() == 0) {
        return Option::NONE;
      }

      let Option::SOME(lastSegment) = path.segments.get(path.segments.length() - 1) else {
        return Option::NONE;
      };

      let name: String = lastSegment.clone();
      let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
      let symbol: Analyzer::SymbolId = symbolsRef.intern(name.toStr());

      // The store holds every module's declarations, so a plain first-hit scan
      // hands a name the prelude also publishes to the prelude. A declaration
      // in the module being analyzed shadows it.
      if (let Option::SOME(ownDefId) = Analyzer::Typecheck::findNamedTypeDefinition(defStore, symbol, true)) {
        return Option::SOME(ownDefId);
      }

      return Analyzer::Typecheck::findNamedTypeDefinition(defStore, symbol, false);
    }

    /// First record or enum in the store named `symbol`. When `activeModuleOnly`
    /// is set, only declarations published by the module being analyzed count.
    function findNamedTypeDefinition(
      defStore: &mut Analyzer::DefinitionStore,
      symbol: Analyzer::SymbolId,
      activeModuleOnly: boolean,
    ): Option<Analyzer::DefinitionId> {
      let mut index: u64 = 0;

      while (index < defStore.length()) {
        let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);
        let Option::SOME(def) = defStore.get(defId) else {
          index += 1;
          continue;
        };

        if (def.name().raw() != symbol.raw()) {
          index += 1;
          continue;
        }

        if (activeModuleOnly && !defStore.defBelongsToActiveModule(defId)) {
          index += 1;
          continue;
        }

        match (def) {
          Analyzer::Definition::Record(_) -> {
            return Option::SOME(defId);
          },
          Analyzer::Definition::Enum(_) -> {
            return Option::SOME(defId);
          },
          _ -> {},
        };

        index += 1;
      }

      return Option::NONE;
    }

    /// The name a type parameter called `symbol` stands for, when any
    /// declaration in the store carries one.
    ///
    /// `Type::Param` is keyed by the written name alone, so which declaration
    /// owns the parameter does not change the type this produces.
    function lookupTypeParameterNamed(
      defStore: &mut Analyzer::DefinitionStore,
      symbol: Analyzer::SymbolId,
    ): Option<Analyzer::SymbolId> {
      let mut index: u64 = 0;

      while (index < defStore.length()) {
        let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);
        let Option::SOME(def) = defStore.get(defId) else {
          index += 1;
          continue;
        };

        if (def.name().raw() == symbol.raw()) {
          if (let Analyzer::Definition::TypeParam(typeParam) = def) {
            return Option::SOME(typeParam.name);
          }
        }

        index += 1;
      }

      return Option::NONE;
    }

    function resolveLocalAnnotation(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      typeId: Ast::TypeId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(typeNode) = module.types.get(typeId) else {
        return Option::NONE;
      };

      match (typeNode) {
        Ast::Type::Node::Path(path) -> {
          if (path.segments.length() == 0) {
            return Option::NONE;
          }

          // N >= 2 segments (ADR D11): the leading segments form an
          // unvalidated namespace-qualifier prefix — TODO(namespace-path-validation),
          // the same debt tracked at `resolvePathTail` in resolver_bodies.ign.
          // Only the last segment is resolved, and only against
          // Record/Enum/TypeAlias names — deliberately narrower than the
          // 1-segment scan below, which also matches functions/variables/etc.
          if (path.segments.length() >= 2) {
            let Option::SOME(lastSegment) = path.segments.get(path.segments.length() - 1) else {
              return Option::NONE;
            };

            let lastName: String = lastSegment.clone();
            if (Analyzer::Typecheck::isPrimitiveAnnotationName(lastName.toStr())) {
              return Option::NONE;
            }

            // The written path decides between same-named declarations:
            // `Analyzer::TypeId` and `Ast::TypeId` both end in `TypeId`, and
            // first-match by bare name picks whichever bound first.
            let mut writtenPath: String = String::create("");
            let mut writtenIndex: u64 = 0;
            while (writtenIndex < path.segments.length()) {
              if (let Option::SOME(writtenSegment) = path.segments.get(writtenIndex)) {
                if (writtenIndex > 0) {
                  writtenPath.pushStr("::");
                }
                writtenPath.pushStr(writtenSegment.toStr());
              }
              writtenIndex += 1;
            }
            let writtenSuffix: String = `::${writtenPath.toStr()}`;

            let mut qualifiedSymbolsRef: &mut Analyzer::SymbolTable = symbols;
            let lastSymbol: Analyzer::SymbolId = qualifiedSymbolsRef.intern(lastName.toStr());
            let mut qualifiedIndex: u64 = 0;
            while (qualifiedIndex < defStore.length()) {
              let qualifiedDefId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(qualifiedIndex as u32);

              let mut pathMatches: boolean = false;
              if (let Option::SOME(storedQualified) = defStore.qualifiedNameOf(qualifiedDefId)) {
                pathMatches = storedQualified.equals(writtenPath.toStr())
                  || Analyzer::Imports::programPathEndsWith(storedQualified, &writtenSuffix);
              }

              if (!pathMatches) {
                qualifiedIndex += 1;
                continue;
              }

              let Option::SOME(qualifiedDef) = defStore.get(qualifiedDefId) else {
                qualifiedIndex += 1;
                continue;
              };

              if (qualifiedDef.name().raw() != lastSymbol.raw()) {
                qualifiedIndex += 1;
                continue;
              }

              match (qualifiedDef) {
                Analyzer::Definition::Record(record_) -> {
                  return Option::SOME(record_.typeId);
                },
                Analyzer::Definition::Enum(enum_) -> {
                  return Option::SOME(enum_.typeId);
                },
                Analyzer::Definition::TypeAlias(alias_) -> {
                  return Option::SOME(alias_.typeId);
                },
                Analyzer::Definition::Function(_) -> {},
                Analyzer::Definition::Variable(_) -> {},
                Analyzer::Definition::Field(_) -> {},
                Analyzer::Definition::Variant(_) -> {},
                Analyzer::Definition::TypeParam(_) -> {},
                Analyzer::Definition::Trait(_) -> {},
                Analyzer::Definition::Method(_) -> {},
              };

              qualifiedIndex += 1;
            }

            // No stamped path matched — fall back to the bare last-segment
            // scan (ADR D11's unvalidated-prefix leniency), which also covers
            // single-module analysis, where no qualified name is stamped.
            let mut bareIndex: u64 = 0;
            while (bareIndex < defStore.length()) {
              let bareDefId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(bareIndex as u32);
              let Option::SOME(bareDef) = defStore.get(bareDefId) else {
                bareIndex += 1;
                continue;
              };

              if (bareDef.name().raw() != lastSymbol.raw()) {
                bareIndex += 1;
                continue;
              }

              match (bareDef) {
                Analyzer::Definition::Record(record_) -> {
                  return Option::SOME(record_.typeId);
                },
                Analyzer::Definition::Enum(enum_) -> {
                  return Option::SOME(enum_.typeId);
                },
                Analyzer::Definition::TypeAlias(alias_) -> {
                  return Option::SOME(alias_.typeId);
                },
                _ -> {},
              };

              bareIndex += 1;
            }

            return Option::NONE;
          }

          let Option::SOME(segment) = path.segments.get(0) else {
            return Option::NONE;
          };

          let name: String = segment.clone();
          let primitiveType: Option<Analyzer::TypeId> = Analyzer::Resolver::primitiveForName(typeStore, name.toStr());
          if (let Option::SOME(_) = primitiveType) {
            return primitiveType;
          }

          let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
          let symbol: Analyzer::SymbolId = symbolsRef.intern(name.toStr());

          // A type parameter is bound nearer than any declaration a namespace
          // holds, so it decides first. Without that, a record sharing the
          // name of some generic's parameter takes the parameter's place
          // inside the generic's own body, and the instantiation is built
          // over the wrong type.
          if (let Option::SOME(typeParamSymbol) = Analyzer::Typecheck::lookupTypeParameterNamed(defStore, symbol)) {
            let mut typeStoreParamRef: &mut Analyzer::TypeStore = typeStore;
            return Option::SOME(typeStoreParamRef.param(typeParamSymbol));
          }

          // The current module's own declaration wins over a same-named one
          // from elsewhere — the two ParsedCondition records must not
          // cross-wire — so the scan runs module-local first, then global.
          let mut localPass: u64 = 0;
          while (localPass < 2) {
            let mut index: u64 = 0;
            while (index < defStore.length()) {
              let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);

              if (localPass == 0 && !defStore.defBelongsToActiveModule(defId)) {
                index += 1;
                continue;
              }

              let Option::SOME(def) = defStore.get(defId) else {
                index += 1;
                continue;
              };

              if (def.name().raw() == symbol.raw()) {
                return Analyzer::Typecheck::definitionType(defStore, typeStore, defId);
              }

              index += 1;
            }

            localPass += 1;
          }

          return Option::NONE;
        },
        Ast::Type::Node::Pointer(pointer) -> {
          let Option::SOME(pointee) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            pointer.pointee,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          if (pointer.mutable) {
            return Option::SOME(typeStoreRef.mutablePointer(pointee));
          }

          return Option::SOME(typeStoreRef.pointer(pointee));
        },
        Ast::Type::Node::Reference(reference) -> {
          let Option::SOME(referent) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            reference.target,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          if (reference.mutable) {
            return Option::SOME(typeStoreRef.mutableReference(referent));
          }

          return Option::SOME(typeStoreRef.reference(referent));
        },
        Ast::Type::Node::Tuple(tuple) -> {
          let mut elements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut elementIndex: u64 = 0;

          while (elementIndex < tuple.elements.length()) {
            let Option::SOME(elementTypeId) = tuple.elements.get(elementIndex) else {
              return Option::NONE;
            };

            // One unresolvable element makes the whole tuple unusable: a partial
            // tuple type would compare equal to a different one.
            let Option::SOME(resolvedElement) = Analyzer::Typecheck::resolveLocalAnnotation(
              defStore,
              typeStore,
              symbols,
              module,
              *elementTypeId,
            ) else {
              return Option::NONE;
            };

            elements.push(resolvedElement);
            elementIndex += 1;
          }

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.tuple(elements));
        },
        Ast::Type::Node::Slice(slice) -> {
          let Option::SOME(element) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            slice.element,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.slice(element));
        },
        Ast::Type::Node::FixedArray(fixedArray) -> {
          let Option::SOME(element) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            fixedArray.element,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.fixedArray(element, fixedArray.size));
        },
        Ast::Type::Node::Function(functionType) -> {
          let mut params: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut paramIndex: u64 = 0;

          while (paramIndex < functionType.parameters.length()) {
            let Option::SOME(paramTypeId) = functionType.parameters.get(paramIndex) else {
              return Option::NONE;
            };

            // One unresolvable parameter makes the whole signature unusable: a partial
            // function type would compare equal to a different one.
            let Option::SOME(resolvedParam) = Analyzer::Typecheck::resolveLocalAnnotation(
              defStore,
              typeStore,
              symbols,
              module,
              *paramTypeId,
            ) else {
              return Option::NONE;
            };

            params.push(resolvedParam);
            paramIndex += 1;
          }

          let Option::SOME(resolvedReturn) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            functionType.returnType,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;

          return Option::SOME(typeStoreRef.intern(Analyzer::Type::Function(Analyzer::FunctionType {
            params: params,
            returnType: resolvedReturn,
          })));
        },
        Ast::Type::Node::Generic(generic) -> {
          let baseOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::lookupAnnotationBaseDefinition(
            defStore,
            symbols,
            module,
            generic.base,
          );
          let Option::SOME(baseDefId) = baseOpt else {
            return Option::NONE;
          };

          let mut arguments: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut argumentIndex: u64 = 0;

          while (argumentIndex < generic.arguments.length()) {
            let Option::SOME(argumentTypeId) = generic.arguments.get(argumentIndex) else {
              return Option::NONE;
            };

            // One unresolvable argument makes the whole instance unusable: a partial
            // argument list would compare equal to a different instantiation.
            let Option::SOME(resolvedArgument) = Analyzer::Typecheck::resolveLocalAnnotation(
              defStore,
              typeStore,
              symbols,
              module,
              *argumentTypeId,
            ) else {
              return Option::NONE;
            };

            arguments.push(resolvedArgument);
            argumentIndex += 1;
          }

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.instance(baseDefId, arguments));
        },
      };

      @panic("unreachable: resolveLocalAnnotation match did not return");
    }

    function literalType(
      typeStore: &mut Analyzer::TypeStore,
      literal: &Ast::Expression::Literal,
    ): Analyzer::TypeId {
      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      match (&literal.value) {
        Ast::Expression::LiteralValue::Int(_) -> {
          return typeStoreRef.intern(Analyzer::Type::I32);
        },
        Ast::Expression::LiteralValue::UInt(_) -> {
          return typeStoreRef.intern(Analyzer::Type::U32);
        },
        Ast::Expression::LiteralValue::Float(_) -> {
          return typeStoreRef.intern(Analyzer::Type::F64);
        },
        Ast::Expression::LiteralValue::Boolean(_) -> {
          return typeStoreRef.intern(Analyzer::Type::BOOLEAN);
        },
        Ast::Expression::LiteralValue::Character(_) -> {
          return typeStoreRef.intern(Analyzer::Type::CHAR);
        },
        Ast::Expression::LiteralValue::String(_) -> {
          return typeStoreRef.intern(Analyzer::Type::STR);
        },
        Ast::Expression::LiteralValue::Atom(_) -> {
          return typeStoreRef.intern(Analyzer::Type::ATOM);
        },
        Ast::Expression::LiteralValue::Null -> {
          return typeStoreRef.intern(Analyzer::Type::VOID);
        },
      };

      @panic("unreachable: literalType match did not return");
    }

    /// Types a literal against an optional expected type and records the
    /// result for `exprId`.
    ///
    /// Shared by expression position (`checkExprExpected`) and literal
    /// patterns, which the reference analyzer also puts under the same rules:
    /// an integer or float literal adopts the expected type when the value
    /// fits, `null` needs a pointer expectation, and everything else keeps its
    /// default literal type.
    function checkLiteralExprExpected(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      exprId: Ast::ExpressionId,
      literal: &Ast::Expression::Literal,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      match (&literal.value) {
        Ast::Expression::LiteralValue::Null -> {
          let Option::SOME(expectedType) = expected else {
            Analyzer::Typecheck::emitCannotInferNullLiteral(state, literal.span);
            return Option::NONE;
          };

          let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, expectedType);
          let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
            Analyzer::Typecheck::emitInvalidNullLiteral(state, typeStore, literal.span, expectedType);
            return Option::NONE;
          };

          let Analyzer::Type::Pointer(_) = resolvedNode else {
            Analyzer::Typecheck::emitInvalidNullLiteral(state, typeStore, literal.span, expectedType);
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, expectedType);
          return Option::SOME(expectedType);
        },
        _ -> {},
      };

      if (let Option::SOME(expectedType) = expected) {
        let resolvedExpected: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, expectedType);

        if (resolvedExpected.cycleAlias.isNone()) {
          if (let Option::SOME(expectedNode) = typeStore.get(resolvedExpected.typeId)) {
            match (&literal.value) {
              Ast::Expression::LiteralValue::Int(value) -> {
                if (Analyzer::Typecheck::isIntegerTypeNode(expectedNode)) {
                  if (!Analyzer::Typecheck::signedLiteralFits(expectedNode, value)) {
                    Analyzer::Typecheck::emitIntegerOverflow(state, typeStore, literal.span, expectedType);
                    return Option::NONE;
                  }

                  Analyzer::Typecheck::recordExprType(state, exprId, expectedType);
                  return Option::SOME(expectedType);
                }
              },
              Ast::Expression::LiteralValue::UInt(value) -> {
                if (Analyzer::Typecheck::isIntegerTypeNode(expectedNode)) {
                  if (!Analyzer::Typecheck::unsignedLiteralFits(expectedNode, value)) {
                    Analyzer::Typecheck::emitIntegerOverflow(state, typeStore, literal.span, expectedType);
                    return Option::NONE;
                  }

                  Analyzer::Typecheck::recordExprType(state, exprId, expectedType);
                  return Option::SOME(expectedType);
                }
              },
              Ast::Expression::LiteralValue::Float(_) -> {
                if (Analyzer::Typecheck::isFloatTypeNode(expectedNode)) {
                  Analyzer::Typecheck::recordExprType(state, exprId, expectedType);
                  return Option::SOME(expectedType);
                }
              },
              _ -> {},
            };
          }
        }
      }

      let typeId: Analyzer::TypeId = Analyzer::Typecheck::literalType(typeStore, literal);
      Analyzer::Typecheck::recordExprType(state, exprId, typeId);
      return Option::SOME(typeId);
    }

    function checkResolvedValueExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      span: SourceSpan,
      expected: Option<Analyzer::TypeId>,
    ): Option<Analyzer::TypeId> {
      let resolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, exprId);
      let Option::SOME(resolved) = resolvedOpt else {
        Analyzer::Typecheck::emitUnsupported(state, span, "unresolved name lookup");
        return Option::NONE;
      };

      match (resolved) {
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
          let localBindingOpt: Option<Analyzer::Typecheck::LocalBindingInfo> = Analyzer::Typecheck::lookupLocalBinding(state, localId);
          let Option::SOME(localBinding) = localBindingOpt else {
            Analyzer::Typecheck::emitUnsupported(state, span, "unknown local binding type");
            return Option::NONE;
          };

          // A binding declared without an annotation and without an initializer
          // has no type until something assigns to it, and reading it here is
          // what would otherwise silently take the placeholder.
          if (localBinding.pending) {
            Analyzer::Typecheck::emitCannotInferLocal(state, span);
            return Option::NONE;
          }

          Analyzer::Typecheck::recordExprType(state, exprId, localBinding.typeId);
          return Option::SOME(localBinding.typeId);
        },
        Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> {
          let methodInfoOpt: Option<Analyzer::Typecheck::MethodCallInfo> = Analyzer::Typecheck::lookupMethodDefInfo(defStore, defId);
          if (methodInfoOpt.isSome()) {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, "method references are not values; call the method instead");
            return Option::NONE;
          }

          // `Enum::VARIANT` is a value only when the variant carries no payload;
          // with a payload it is a constructor and must be applied, which
          // `checkCallExpr` handles before the callee ever reaches here.
          if (let Option::SOME(constructor) = Analyzer::Typecheck::extractVariantConstructor(defStore, defId)) {
            if (constructor.payload.length() > 0) {
              Analyzer::Typecheck::emitInvalidNumberOfArguments(state, span, 0, constructor.payload.length());
              return Option::NONE;
            }

            // A generic enum's variant carries the enum's type parameters, and only the
            // expected type says what they stand for. With nothing to infer from, the
            // declared type is kept as written, which is what applying a generic variant
            // constructor without an expected type already does.
            let mut variantType: Analyzer::TypeId = constructor.enumType;
            let typeArguments: Vector<Analyzer::TypeId> = Analyzer::Typecheck::inferVariantTypeArguments(
              defStore,
              typeStore,
              &constructor,
              expected,
            );

            if (typeArguments.length() > 0) {
              let mut typeStoreInstanceRef: &mut Analyzer::TypeStore = typeStore;
              variantType = typeStoreInstanceRef.instance(
                constructor.enumDefId,
                Analyzer::Typecheck::copyVariantPayloadTypeIds(&typeArguments),
              );
            }

            Analyzer::Typecheck::recordExprType(state, exprId, variantType);
            return Option::SOME(variantType);
          }

          let defTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::definitionType(defStore, typeStore, defId);
          let Option::SOME(typeId) = defTypeOpt else {
            Analyzer::Typecheck::emitUnsupported(state, span, "definition kind in expression position");
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, typeId);
          return Option::SOME(typeId);
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, span, "type parameters in expression position");
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, span, "unresolved expression reference");
          return Option::NONE;
        },
      };

      @panic("unreachable: checkResolvedValueExpr match did not return");
    }
  }
}
