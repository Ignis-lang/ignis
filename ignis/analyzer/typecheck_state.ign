      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INTEGER_OVERFLOW, message.toStr());
    }

    /// Display symbol for a shift/bitwise operator in diagnostics.
    function shiftOrBitwiseOperatorSymbol(operator: Ast::Expression::BinaryOperator): str {
      return match (operator) {
        Ast::Expression::BinaryOperator::BitAnd -> "&",
        Ast::Expression::BinaryOperator::BitOr -> "|",
        Ast::Expression::BinaryOperator::BitXor -> "^",
        Ast::Expression::BinaryOperator::ShiftLeft -> "<<",
        Ast::Expression::BinaryOperator::ShiftRight -> ">>",
        _ -> "?",
      };
    }

    function emitInvalidBinaryOperandType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      operator: Ast::Expression::BinaryOperator,
      leftType: Analyzer::TypeId,
      rightType: Analyzer::TypeId,
    ): void {
      let message: String = String::create("Binary operator '")
        .concat(Analyzer::Typecheck::shiftOrBitwiseOperatorSymbol(operator))
        .concat("' cannot be applied to types '")
        .concat(typeStore.nameOf(leftType).toStr())
        .concat("' and '")
        .concat(typeStore.nameOf(rightType).toStr())
        .concat("'");
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_BINARY_OPERAND_TYPE, message.toStr());
    }

    function emitInvalidUnaryOperandType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      operator: str,
      operandType: Analyzer::TypeId,
    ): void {
      let message: String = String::create("Unary operator '")
        .concat(operator)
        .concat("' cannot be applied to type '")
        .concat(typeStore.nameOf(operandType).toStr())
        .concat("'");
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::INVALID_UNARY_OPERAND_TYPE, message.toStr());
    }

    /// Patch `VariableDef.declaredType` at `varDefId` via `DefinitionStore::replace`.
    ///
    /// Local mirror of the resolver's `patchVariableType`, used when an
    /// unannotated constant's type is inferred from its value: the binder left
    /// the `VOID` sentinel there and the resolver had no annotation to patch.
    function patchVariableDeclaredType(
      defStore: &mut Analyzer::DefinitionStore,
      varDefId: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
    ): void {
      let Option::SOME(existing) = defStore.get(varDefId) else {
        return;
      };

      match (existing) {
        Analyzer::Definition::Variable(v) -> {
          let updated: Analyzer::VariableDef = Analyzer::VariableDef {
            name: v.name,
            visibility: v.visibility,
            declaredType: typeId,
            mutable: v.mutable,
          };
          let mut defsRef: &mut Analyzer::DefinitionStore = defStore;
          defsRef.replace(varDefId, Analyzer::Definition::Variable(updated));
        },
        Analyzer::Definition::Record(_) -> {},
        Analyzer::Definition::Enum(_) -> {},
        Analyzer::Definition::Function(_) -> {},
        Analyzer::Definition::Field(_) -> {},
        Analyzer::Definition::Variant(_) -> {},
        Analyzer::Definition::TypeParam(_) -> {},
        Analyzer::Definition::TypeAlias(_) -> {},
        Analyzer::Definition::Trait(_) -> {},
        Analyzer::Definition::Method(_) -> {},
      };
    }

    function recordExprType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      exprId: Ast::ExpressionId,
      typeId: Analyzer::TypeId,
    ): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.exprTypes.nodeIds.push(exprId.raw());
      stateRef.exprTypes.typeIds.push(typeId);
    }

    function lookupRecordedExprType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::TypeId> {
      let mut index: u64 = state.exprTypes.nodeIds.length();

      while (index > 0) {
        index -= 1;

        let Option::SOME(nodeId) = state.exprTypes.nodeIds.get(index) else {
          continue;
        };

        if (*nodeId == exprId.raw()) {
          let Option::SOME(typeId) = state.exprTypes.typeIds.get(index) else {
            return Option::NONE;
          };

          return Option::SOME(*typeId);
        }
      }

      return Option::NONE;
    }

    function pushScope(state: &mut Analyzer::Typecheck::TypecheckState): void {
      let mark: u64 = state.localPatternIds.length();
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.scopeMarks.push(mark);
    }

    function popScope(state: &mut Analyzer::Typecheck::TypecheckState): void {
      let Option::SOME(mark) = state.scopeMarks.pop() else {
        return;
      };

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      while (stateRef.localPatternIds.length() > mark) {
        stateRef.localPatternIds.pop();
        stateRef.localFunctionIds.pop();
        stateRef.localIndexes.pop();
        stateRef.localTypeIds.pop();
        stateRef.localMutableFlags.pop();
      }
    }

    function enterLoop(state: &mut Analyzer::Typecheck::TypecheckState): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.loopDepth += 1;
    }

    function exitLoop(state: &mut Analyzer::Typecheck::TypecheckState): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      if (stateRef.loopDepth > 0) {
        stateRef.loopDepth -= 1;
      }
    }

    function resolveAliasChainChecked(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Analyzer::Typecheck::AliasResolutionResult {
      let mut current: Analyzer::TypeId = typeId;
      let mut visited: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      while (true) {
        let Option::SOME(type_) = typeStore.get(current) else {
          return Analyzer::Typecheck::AliasResolutionResult {
            typeId: current,
            cycleAlias: Option::NONE,
          };
        };

        match (type_) {
          Analyzer::Type::Alias(aliasDefId) -> {
            let mut seenIndex: u64 = 0;
            while (seenIndex < visited.length()) {
              let Option::SOME(seen) = visited.get(seenIndex) else {
                seenIndex += 1;
                continue;
              };

              if (seen.raw() == aliasDefId.raw()) {
                return Analyzer::Typecheck::AliasResolutionResult {
                  typeId: current,
                  cycleAlias: Option::SOME(aliasDefId),
                };
              }

              seenIndex += 1;
            }

            visited.push(aliasDefId);

            let Option::SOME(def) = defStore.get(aliasDefId) else {
              return Analyzer::Typecheck::AliasResolutionResult {
                typeId: current,
                cycleAlias: Option::NONE,
              };
            };

            match (def) {
              Analyzer::Definition::TypeAlias(aliasDef) -> {
                current = aliasDef.aliasedType;
              },
              _ -> {
                return Analyzer::Typecheck::AliasResolutionResult {
                  typeId: current,
                  cycleAlias: Option::NONE,
                };
              },
            };
          },
          _ -> {
            return Analyzer::Typecheck::AliasResolutionResult {
              typeId: current,
              cycleAlias: Option::NONE,
            };
          },
        };
      }

      return Analyzer::Typecheck::AliasResolutionResult {
        typeId: current,
        cycleAlias: Option::NONE,
      };
    }

    function emitCyclicTypeAlias(
      state: &mut Analyzer::Typecheck::TypecheckState,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      aliasDefId: Analyzer::DefinitionId,
    ): void {
      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let aliasTypeId: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::Alias(aliasDefId));
      let message: String = String::create("cyclic type alias `")
        .concat(typeStore.nameOf(aliasTypeId).toStr())
        .concat("`");
      Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::CYCLIC_TYPE_ALIAS, message.toStr());
    }

    function typesEqual(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      left: Analyzer::TypeId,
      right: Analyzer::TypeId,
    ): boolean {
      let leftResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, left);
      if (let Option::SOME(aliasDefId) = leftResolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return true;
      }

      let rightResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, right);
      if (let Option::SOME(aliasDefId) = rightResolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return true;
      }

      return leftResolved.typeId.raw() == rightResolved.typeId.raw();
    }

    function isSupportedNumericType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return false;
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return false;
      };

      return match (type_) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64
        | Analyzer::Type::F32
        | Analyzer::Type::F64 -> true,
        _ -> false,
      };
    }

    function isIntegerType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return false;
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return false;
      };

      return match (type_) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64 -> true,
        _ -> false,
      };
    }

    function isBooleanType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return false;
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return false;
      };

      return match (type_) {
        Analyzer::Type::BOOLEAN -> true,
        _ -> false,
      };
    }

    /// Whether a type has Copy semantics. Mirrors the Rust
    /// `TypeStore::is_copy_with_defs`: primitives, pointers, references,
    /// slices, and function types copy; fixed arrays, tuples, and generic
    /// instances copy when their components do; records and enums honor
    /// `@implements(Drop)`/`@implements(Copy)` and otherwise copy when their
    /// fields or variant payloads do; unresolved type parameters
    /// conservatively are not.
    function isCopyType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
    ): boolean {
      let mut visited: Vector<u32> = Vector::new<u32>();
      return Analyzer::Typecheck::isCopyTypeInner(state, defStore, typeStore, span, typeId, &mut visited);
    }

    /// Recursive worker for `isCopyType`. `visited` holds the raw type ids of
    /// the record/enum types currently being examined so a recursive type
    /// answers non-Copy on revisit instead of looping, like the Rust
    /// `is_copy_with_defs_inner`.
    function isCopyTypeInner(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      visited: &mut Vector<u32>,
    ): boolean {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolved.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return false;
      }

      let Option::SOME(type_) = typeStore.get(resolved.typeId) else {
        return false;
      };

      // Compound kinds defer their answer to their component types, gathered
      // first so the store borrow ends before the recursive calls.
      let mut directAnswer: Option<boolean> = Option::NONE;
      let mut components: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut recordDefId: Option<Analyzer::DefinitionId> = Option::NONE;
      let mut enumDefId: Option<Analyzer::DefinitionId> = Option::NONE;

      match (type_) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64
        | Analyzer::Type::F32
        | Analyzer::Type::F64
        | Analyzer::Type::BOOLEAN
        | Analyzer::Type::CHAR
        | Analyzer::Type::STR
        | Analyzer::Type::VOID
        | Analyzer::Type::NEVER -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Pointer(_) -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Reference(_) -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Slice(_) -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Function(_) -> {
          directAnswer = Option::SOME(true);
        },
        Analyzer::Type::Record(defId) -> {
          recordDefId = Option::SOME(defId);
        },
        Analyzer::Type::Enum(defId) -> {
          enumDefId = Option::SOME(defId);
        },
        Analyzer::Type::Param(_) -> {
          directAnswer = Option::SOME(false);
        },
        Analyzer::Type::Alias(_) -> {
          directAnswer = Option::SOME(false);
        },
        Analyzer::Type::FixedArray(element, _) -> {
          components.push(element);
        },
        Analyzer::Type::Tuple(tuple) -> {
          let mut elementIndex: u64 = 0;
          while (elementIndex < tuple.elements.length()) {
            let Option::SOME(elementId) = tuple.elements.get(elementIndex) else {
              elementIndex += 1;
              continue;
            };

            components.push(*elementId);
            elementIndex += 1;
          }
        },
        Analyzer::Type::Instance(instance) -> {
          let mut argumentIndex: u64 = 0;
          while (argumentIndex < instance.typeArguments.length()) {
            let Option::SOME(argumentId) = instance.typeArguments.get(argumentIndex) else {
              argumentIndex += 1;
              continue;
            };

            components.push(*argumentId);
            argumentIndex += 1;
          }
        },
      };

      if (let Option::SOME(answer) = directAnswer) {
        return answer;
      }

      if (let Option::SOME(defId) = recordDefId) {
        return Analyzer::Typecheck::recordCopyAnswer(state, defStore, typeStore, span, resolved.typeId, defId, visited);
      }

      if (let Option::SOME(defId) = enumDefId) {
        return Analyzer::Typecheck::enumCopyAnswer(state, defStore, typeStore, span, resolved.typeId, defId, visited);
      }

      let mut componentIndex: u64 = 0;
      while (componentIndex < components.length()) {
        let Option::SOME(component) = components.get(componentIndex) else {
          componentIndex += 1;
          continue;
        };

        if (!Analyzer::Typecheck::isCopyTypeInner(state, defStore, typeStore, span, *component, visited)) {
          return false;
        }

        componentIndex += 1;
      }

      return true;
    }

    /// Whether `typeRaw` is already on the `visited` stack.
    function copyVisitAlreadySeen(visited: &mut Vector<u32>, typeRaw: u32): boolean {
      let mut seenIndex: u64 = 0;

      while (seenIndex < visited.length()) {
        let Option::SOME(seen) = visited.get(seenIndex) else {
          seenIndex += 1;
          continue;
        };

        if (*seen == typeRaw) {
          return true;
        }

        seenIndex += 1;
      }

      return false;
    }

    /// Copy answer for a record type, honoring `@implements(...)` metadata.
    /// Mirrors the Rust `is_copy_with_defs_inner`: `Drop` forces non-Copy,
    /// `Copy` forces Copy, otherwise the record copies when every field type
    /// does. A revisit through `visited` answers non-Copy to break cycles.
    function recordCopyAnswer(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      defId: Analyzer::DefinitionId,
      visited: &mut Vector<u32>,
    ): boolean {
      let typeRaw: u32 = typeId.raw();
      if (Analyzer::Typecheck::copyVisitAlreadySeen(visited, typeRaw)) {
        return false;
      }

      let mut visitedRef: &mut Vector<u32> = visited;
      visitedRef.push(typeRaw);

      let mut implementsCopy: boolean = false;
      let mut implementsDrop: boolean = false;
      let mut fieldDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(def) = defStore.get(defId)) {
        match (def) {
          Analyzer::Definition::Record(recordDef) -> {
            implementsCopy = recordDef.implementsCopy;
            implementsDrop = recordDef.implementsDrop;

            let mut fieldIndex: u64 = 0;
            while (fieldIndex < recordDef.fields.length()) {
              let Option::SOME(fieldDefId) = recordDef.fields.get(fieldIndex) else {
                fieldIndex += 1;
                continue;
              };

              fieldDefIds.push(*fieldDefId);
              fieldIndex += 1;
            }
          },
          _ -> {},
        };
      }

      let mut fieldTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut fieldDefIndex: u64 = 0;
      while (fieldDefIndex < fieldDefIds.length()) {
        let Option::SOME(fieldDefId) = fieldDefIds.get(fieldDefIndex) else {
          fieldDefIndex += 1;
          continue;
        };

        if (let Option::SOME(fieldDefNode) = defStore.get(*fieldDefId)) {
          if (let Analyzer::Definition::Field(fieldDef) = fieldDefNode) {
            fieldTypes.push(fieldDef.fieldType);
          }
        }

        fieldDefIndex += 1;
      }

      let answer: boolean = Analyzer::Typecheck::copyAnswerFromTraitFlagsAndComponents(
        state,
        defStore,
        typeStore,
        span,
        implementsCopy,
        implementsDrop,
        &fieldTypes,
        visited,
      );

      let mut popRef: &mut Vector<u32> = visited;
      popRef.pop();
      return answer;
    }

    /// Copy answer for an enum type, honoring `@implements(...)` metadata.
    /// Same shape as `recordCopyAnswer` with variant payload types standing
    /// in for record field types.
    function enumCopyAnswer(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      defId: Analyzer::DefinitionId,
      visited: &mut Vector<u32>,
    ): boolean {
      let typeRaw: u32 = typeId.raw();
      if (Analyzer::Typecheck::copyVisitAlreadySeen(visited, typeRaw)) {
        return false;
      }

      let mut visitedRef: &mut Vector<u32> = visited;
      visitedRef.push(typeRaw);

      let mut implementsCopy: boolean = false;
      let mut implementsDrop: boolean = false;
      let mut variantDefIds: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();

      if (let Option::SOME(def) = defStore.get(defId)) {
        match (def) {
          Analyzer::Definition::Enum(enumDef) -> {
            implementsCopy = enumDef.implementsCopy;
            implementsDrop = enumDef.implementsDrop;

            let mut variantIndex: u64 = 0;
            while (variantIndex < enumDef.variants.length()) {
              let Option::SOME(variantDefId) = enumDef.variants.get(variantIndex) else {
                variantIndex += 1;
                continue;
              };

              variantDefIds.push(*variantDefId);
              variantIndex += 1;
            }
          },
          _ -> {},
        };
      }

      let mut payloadTypes: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut variantDefIndex: u64 = 0;
      while (variantDefIndex < variantDefIds.length()) {
        let Option::SOME(variantDefId) = variantDefIds.get(variantDefIndex) else {
          variantDefIndex += 1;
          continue;
        };

        if (let Option::SOME(variantDefNode) = defStore.get(*variantDefId)) {
          if (let Analyzer::Definition::Variant(variantDef) = variantDefNode) {
            let mut payloadIndex: u64 = 0;
            while (payloadIndex < variantDef.payload.length()) {
              let Option::SOME(payloadType) = variantDef.payload.get(payloadIndex) else {
                payloadIndex += 1;
                continue;
              };

              payloadTypes.push(*payloadType);
              payloadIndex += 1;
            }
          }
        }

        variantDefIndex += 1;
      }

      let answer: boolean = Analyzer::Typecheck::copyAnswerFromTraitFlagsAndComponents(
        state,
        defStore,
        typeStore,
        span,
        implementsCopy,
        implementsDrop,
        &payloadTypes,
        visited,
      );

      let mut popRef: &mut Vector<u32> = visited;
      popRef.pop();
      return answer;
    }

    /// Shared tail of `recordCopyAnswer`/`enumCopyAnswer`: `Drop` wins over
    /// `Copy`, and without either flag the answer is structural over the
    /// gathered component types.
    function copyAnswerFromTraitFlagsAndComponents(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      implementsCopy: boolean,
      implementsDrop: boolean,
      componentTypes: &Vector<Analyzer::TypeId>,
      visited: &mut Vector<u32>,
    ): boolean {
      if (implementsDrop) {
        return false;
      }

      if (implementsCopy) {
        return true;
      }

      let mut componentIndex: u64 = 0;
      while (componentIndex < componentTypes.length()) {
        let Option::SOME(componentType) = componentTypes.get(componentIndex) else {
          componentIndex += 1;
          continue;
        };

        if (!Analyzer::Typecheck::isCopyTypeInner(state, defStore, typeStore, span, *componentType, visited)) {
          return false;
        }

        componentIndex += 1;
      }

      return true;
    }

    function requireBooleanType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      actual: Analyzer::TypeId,
    ): boolean {
      if (Analyzer::Typecheck::isBooleanType(state, defStore, typeStore, span, actual)) {
        return true;
      }

      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      let booleanType: Analyzer::TypeId = typeStoreRef.intern(Analyzer::Type::BOOLEAN);
      if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, booleanType, actual)) {
        Analyzer::Typecheck::emitTypeMismatch(state, typeStore, span, booleanType, actual);
      }
      return false;
    }

    function binaryBooleanType(typeStore: &mut Analyzer::TypeStore): Analyzer::TypeId {
      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      return typeStoreRef.intern(Analyzer::Type::BOOLEAN);
    }

    function isArithmeticBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::Add
        | Ast::Expression::BinaryOperator::Subtract
        | Ast::Expression::BinaryOperator::Multiply
        | Ast::Expression::BinaryOperator::Divide
        | Ast::Expression::BinaryOperator::Modulo -> true,
        _ -> false,
      };
    }

    function isEqualityBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::Equal
        | Ast::Expression::BinaryOperator::NotEqual -> true,
        _ -> false,
      };
    }

    function isComparisonBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::LessThan
        | Ast::Expression::BinaryOperator::LessThanOrEqual
        | Ast::Expression::BinaryOperator::GreaterThan
        | Ast::Expression::BinaryOperator::GreaterThanOrEqual -> true,
        _ -> false,
      };
    }

    function isLogicalBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::And
        | Ast::Expression::BinaryOperator::Or -> true,
        _ -> false,
      };
    }

    /// Whether an alias-resolved type node names one of the eight integer
    /// primitives.
    function isIntegerTypeNode(typeNode: &Analyzer::Type): boolean {
      return match (typeNode) {
        Analyzer::Type::I8
        | Analyzer::Type::I16
        | Analyzer::Type::I32
        | Analyzer::Type::I64
        | Analyzer::Type::U8
        | Analyzer::Type::U16
        | Analyzer::Type::U32
        | Analyzer::Type::U64 -> true,
        _ -> false,
      };
    }

    /// Whether an alias-resolved type node names a float primitive.
    function isFloatTypeNode(typeNode: &Analyzer::Type): boolean {
      return match (typeNode) {
        Analyzer::Type::F32 | Analyzer::Type::F64 -> true,
        _ -> false,
      };
    }

    /// Whether a signed literal value fits the integer type node. Mirrors the
    /// Rust `signed_fits_in_type`.
    function signedLiteralFits(typeNode: &Analyzer::Type, value: i64): boolean {
      return match (typeNode) {
        Analyzer::Type::I8 -> value >= -128 && value <= 127,
        Analyzer::Type::I16 -> value >= -32768 && value <= 32767,
        Analyzer::Type::I32 -> value >= -2147483648 && value <= 2147483647,
        Analyzer::Type::I64 -> true,
        Analyzer::Type::U8 -> value >= 0 && value <= 255,
        Analyzer::Type::U16 -> value >= 0 && value <= 65535,
        Analyzer::Type::U32 -> value >= 0 && value <= 4294967295,
        Analyzer::Type::U64 -> value >= 0,
        _ -> false,
      };
    }

    /// Whether an unsigned literal value fits the integer type node. Mirrors
    /// the Rust `unsigned_fits_in_type`.
    function unsignedLiteralFits(typeNode: &Analyzer::Type, value: u64): boolean {
      return match (typeNode) {
        Analyzer::Type::I8 -> value <= 127,
        Analyzer::Type::I16 -> value <= 32767,
        Analyzer::Type::I32 -> value <= 2147483647,
        Analyzer::Type::I64 -> value <= 9223372036854775807,
        Analyzer::Type::U8 -> value <= 255,
        Analyzer::Type::U16 -> value <= 65535,
        Analyzer::Type::U32 -> value <= 4294967295,
        Analyzer::Type::U64 -> true,
        _ -> false,
      };
    }

    function isShiftOrBitwiseBinaryOperator(operator: Ast::Expression::BinaryOperator): boolean {
      return match (operator) {
        Ast::Expression::BinaryOperator::BitAnd
        | Ast::Expression::BinaryOperator::BitOr
        | Ast::Expression::BinaryOperator::BitXor
        | Ast::Expression::BinaryOperator::ShiftLeft
        | Ast::Expression::BinaryOperator::ShiftRight -> true,
        _ -> false,
      };
    }

    function lookupItemDef(
      pass1: &Analyzer::Binder::BinderOutput,
      pass2: &Analyzer::Binder::BinderOutput,
      itemId: Ast::ItemId,
    ): Option<Analyzer::DefinitionId> {
      let pass2Result: Option<Analyzer::DefinitionId> = Analyzer::Binder::findDef(pass2, itemId.raw());
      if (pass2Result.isSome()) {
        return pass2Result;
      }

      return Analyzer::Binder::findDef(pass1, itemId.raw());
    }

    function lookupPatternLocal(
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
    ): Option<Analyzer::ResolverBodies::LocalId> {
      let resolved: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::ResolverBodies::findPatternRef(
        &resolvedBodies.bodyResolution,
        patternId.raw(),
      );

      let Option::SOME(ref_) = resolved else {
        return Option::NONE;
      };

      match (ref_) {
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
          return Option::SOME(localId);
        },
        Analyzer::ResolverBodies::ResolvedRef::Definition(_) -> {
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: lookupPatternLocal match did not return");
    }

    function lookupExprRef(
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
    ): Option<Analyzer::ResolverBodies::ResolvedRef> {
      return Analyzer::ResolverBodies::findExprRef(&resolvedBodies.bodyResolution, exprId.raw());
    }

    function lookupLocalBinding(
      state: &mut Analyzer::Typecheck::TypecheckState,
      localId: Analyzer::ResolverBodies::LocalId,
    ): Option<Analyzer::Typecheck::LocalBindingInfo> {
      let count: u64 = state.localTypeIds.length();

      if (count == 0) {
        return Option::NONE;
      }

      let mut index: u64 = count;
      while (index > 0) {
        index -= 1;

        let Option::SOME(functionId) = state.localFunctionIds.get(index) else {
          continue;
        };
        let Option::SOME(localIndex) = state.localIndexes.get(index) else {
          continue;
        };
        let Option::SOME(typeId) = state.localTypeIds.get(index) else {
          continue;
        };
        let Option::SOME(mutable) = state.localMutableFlags.get(index) else {
          continue;
        };

        if (functionId.raw() == localId.enclosingFn.raw() && *localIndex == localId.index) {
          return Option::SOME(Analyzer::Typecheck::LocalBindingInfo {
            typeId: *typeId,
            mutable: *mutable,
          });
        }
      }

      return Option::NONE;
    }

    function truncateLocalBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      mark: u64
    ): void {
      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      while (stateRef.localPatternIds.length() > mark) {
        stateRef.localPatternIds.pop();
        stateRef.localFunctionIds.pop();
        stateRef.localIndexes.pop();
        stateRef.localTypeIds.pop();
        stateRef.localMutableFlags.pop();
      }
    }

    function pushPatternLocal(
      state: &mut Analyzer::Typecheck::TypecheckState,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): boolean {
      let localOpt: Option<Analyzer::ResolverBodies::LocalId> = Analyzer::Typecheck::lookupPatternLocal(resolvedBodies, patternId);
      let Option::SOME(localId) = localOpt else {
        Analyzer::Typecheck::emitUnsupported(state, span, "unresolved local binding");
        return false;
      };

      let mut stateRef: &mut Analyzer::Typecheck::TypecheckState = state;
      stateRef.localPatternIds.push(patternId);
      stateRef.localFunctionIds.push(localId.enclosingFn);
      stateRef.localIndexes.push(localId.index);
      stateRef.localTypeIds.push(typeId);
      stateRef.localMutableFlags.push(mutable);
      return true;
    }

    function lookupPatternRef(
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      patternId: Ast::PatternId,
    ): Option<Analyzer::ResolverBodies::ResolvedRef> {
      return Analyzer::ResolverBodies::findPatternRef(&resolvedBodies.bodyResolution, patternId.raw());
    }

    /// Strips a single `&T` / `&mut T` layer from a receiver type so member
    /// access and method calls reach the referent's record or enum.
    ///
    /// `self` inside a method body has type `Reference(Owner)` because the
    /// parser emits `&self` / `&mut self` as a reference pattern, so without
    /// this every `self.field` and `self.method()` fails to resolve.
    ///
    /// Aliases are chased before and after the strip so `&Alias` reaches the
    /// aliased type. Exactly one layer is removed, matching the reference
    /// compiler: chasing further would silently accept a `&&T` receiver that
    /// nothing in the language produces.
    ///
    /// Applied at receiver sites only. Record initializers and enum patterns
    /// share the `require*` helpers and must keep rejecting a reference.
    function derefReceiverType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Analyzer::TypeId {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      if (resolved.cycleAlias.isSome()) {
        return typeId;
      }

      let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
        return typeId;
      };

      let mut referentOpt: Option<Analyzer::TypeId> = Option::NONE;

      match (resolvedNode) {
        Analyzer::Type::Reference(reference) -> {
          referentOpt = Option::SOME(reference.referent);
        },
        _ -> {},
      };

      let Option::SOME(referent) = referentOpt else {
        return typeId;
      };

      let referentResolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, referent);

      if (referentResolved.cycleAlias.isSome()) {
        return typeId;
      }

      return referentResolved.typeId;
    }

    /// Mutability of the receiver's reference layer, when it has one.
    ///
    /// `SOME(true)` for `&mut T`, `SOME(false)` for `&T`, `NONE` when the
    /// receiver is not a reference (after alias resolution). Mut-self checks
    /// consult this before the binding: a reference receiver's mutability
    /// lives in the reference type, not in the local binding that holds it.
    function receiverReferenceMutability(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      typeId: Analyzer::TypeId,
    ): Option<boolean> {
      let resolved: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);

      if (resolved.cycleAlias.isSome()) {
        return Option::NONE;
      }

      let Option::SOME(resolvedNode) = typeStore.get(resolved.typeId) else {
        return Option::NONE;
      };

      return match (resolvedNode) {
        Analyzer::Type::Reference(reference) -> Option::SOME(reference.mutable),
        _ -> Option::NONE,
      };
    }

    function requireNonGenericRecordDefId(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonRecordMessage: str,
      genericMessage: str,
    ): Option<Analyzer::DefinitionId> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Record(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Record(record_) -> {
              if (record_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(defId);
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Instance(_) -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
          return Option::NONE;
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonRecordMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireNonGenericRecordDefId match did not return");
    }

    function requireNonGenericEnumDefId(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonEnumMessage: str,
      genericMessage: str,
    ): Option<Analyzer::DefinitionId> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Enum(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Enum(enum_) -> {
              if (enum_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(defId);
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Instance(_) -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
          return Option::NONE;
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonEnumMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireNonGenericEnumDefId match did not return");
    }

    record RequiredMethodOwner {
      public defId: Analyzer::DefinitionId;
      public typeId: Analyzer::TypeId;
      public instanceMethods: Vector<Analyzer::DefinitionId>;
      public staticMethods: Vector<Analyzer::DefinitionId>;
    }

    /// Copies a `Vector<DefinitionId>` element-by-element. `Vector` has no
    /// `clone()`, and matching a `&Definition` binds its payload by reference,
    /// so owner method tables must be copied out one id at a time (mirrors how
    /// `requireNonGenericRecord` collects `RequiredRecordDef.fields`).
    function copyDefinitionIdVector(
      source: &Vector<Analyzer::DefinitionId>
    ): Vector<Analyzer::DefinitionId> {
      let mut out: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        let Option::SOME(defId) = source.get(index) else {
          index += 1;
          continue;
        };

        out.push(*defId);
        index += 1;
      }

      return out;
    }

    /// Copies a variant's `Vector<TypeId>` payload element-by-element, for the
    /// same reason as `copyDefinitionIdVector`: `Vector` has no `clone()`, and
    /// matching a `&Definition` binds its payload by reference. Named apart from
    /// `copyTypeIdVector` in typecheck_exprs.ign, which is not visible from this
    /// module and would collide if redeclared.
    function copyVariantPayloadTypeIds(
      source: &Vector<Analyzer::TypeId>
    ): Vector<Analyzer::TypeId> {
      let mut out: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      let mut index: u64 = 0;

      while (index < source.length()) {
        let Option::SOME(typeId) = source.get(index) else {
          index += 1;
          continue;
        };

        out.push(*typeId);
        index += 1;
      }

      return out;
    }

    /// Parallel to `requireNonGenericRecord` (ADR A4 — that helper is NOT
    /// modified, its record-init/destructuring callers rely on its record-only
    /// rejection). Accepts non-generic Record OR Enum owners for method-call
    /// resolution, copying their `instanceMethods`/`staticMethods` tables.
    function requireNonGenericMethodOwner(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      span: SourceSpan,
      typeId: Analyzer::TypeId,
      nonOwnerMessage: str,
      genericMessage: str,
    ): Option<Analyzer::Typecheck::RequiredMethodOwner> {
      let resolvedType: Analyzer::Typecheck::AliasResolutionResult = Analyzer::Typecheck::resolveAliasChainChecked(defStore, typeStore, typeId);
      if (let Option::SOME(aliasDefId) = resolvedType.cycleAlias) {
        Analyzer::Typecheck::emitCyclicTypeAlias(state, typeStore, span, aliasDefId);
        return Option::NONE;
      }

      let Option::SOME(resolvedTypeNode) = typeStore.get(resolvedType.typeId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
        return Option::NONE;
      };

      match (resolvedTypeNode) {
        Analyzer::Type::Record(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Record(record_) -> {
              if (record_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(Analyzer::Typecheck::RequiredMethodOwner {
                defId: defId,
                typeId: record_.typeId,
                instanceMethods: Analyzer::Typecheck::copyDefinitionIdVector(&record_.instanceMethods),
                staticMethods: Analyzer::Typecheck::copyDefinitionIdVector(&record_.staticMethods),
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Enum(defId) -> {
          let Option::SOME(def) = defStore.get(defId) else {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
            return Option::NONE;
          };

          match (def) {
            Analyzer::Definition::Enum(enum_) -> {
              if (enum_.typeParams.length() > 0) {
                Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
                return Option::NONE;
              }

              return Option::SOME(Analyzer::Typecheck::RequiredMethodOwner {
                defId: defId,
                typeId: enum_.typeId,
                instanceMethods: Analyzer::Typecheck::copyDefinitionIdVector(&enum_.instanceMethods),
                staticMethods: Analyzer::Typecheck::copyDefinitionIdVector(&enum_.staticMethods),
              });
            },
            _ -> {
              Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
              return Option::NONE;
            },
          };
        },
        Analyzer::Type::Instance(_) -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::UNSUPPORTED_CONSTRUCT, genericMessage);
          return Option::NONE;
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, nonOwnerMessage);
          return Option::NONE;
        },
      };

      @panic("unreachable: requireNonGenericMethodOwner match did not return");
    }

    function recordFieldCount(
      defStore: &mut Analyzer::DefinitionStore,
      recordDefId: Analyzer::DefinitionId
    ): u64 {
      let Option::SOME(def) = defStore.get(recordDefId) else {
        return 0;
      };

      match (def) {
        Analyzer::Definition::Record(record_) -> {
          return record_.fields.length();
        },
        _ -> {
          return 0;
        },
      };

      @panic("unreachable: recordFieldCount match did not return");
    }

    /// Type annotation of the `index`-th payload slot of `variantName` inside an
    /// enum declaration, or `NONE` when the variant or the slot is missing.
    ///
    /// The parser models each declared payload slot as a `Pattern::Binding`
    /// named `_` whose annotation carries the payload type.
    function astVariantPayloadAnnotationAt(
      module: &Ast::Module,
      enumItem: &Ast::Item::Enum,
      variantName: str,
      index: u64,
    ): Option<Ast::TypeId> {
      let mut variantIndex: u64 = 0;

      while (variantIndex < enumItem.variants.length()) {
        let Option::SOME(variantPatternId) = enumItem.variants.get(variantIndex) else {
          variantIndex += 1;
          continue;
        };
        let Option::SOME(variantPattern) = module.patterns.get(*variantPatternId) else {
          variantIndex += 1;
          continue;
        };

        if (let Ast::Pattern::Node::Path(declaration) = variantPattern) {
          let segmentCount: u64 = declaration.segments.length();

          if (segmentCount > 0) {
            if (let Option::SOME(declaredName) = declaration.segments.get(segmentCount - 1)) {
              if (declaredName.equals(variantName)) {
                let Option::SOME(slotPatternId) = declaration.arguments.get(index) else {
                  return Option::NONE;
                };
                let Option::SOME(slotPattern) = module.patterns.get(*slotPatternId) else {
                  return Option::NONE;
                };

                if (let Ast::Pattern::Node::Binding(slot) = slotPattern) {
                  return slot.annotation;
                }

                return Option::NONE;
              }
            }
          }
        }

        variantIndex += 1;
      }

      return Option::NONE;
    }

    /// Declared type of the `index`-th payload slot of the variant a pattern
    /// like `Shape::CIRCLE(radius)` names.
    ///
    /// `VariantDef.payload` only records payload *arity*: its entries are VOID
    /// sentinels because variant payload types stay unresolved (ADR-R5). The
    /// binding type is therefore read back from the enum declaration in the AST,
    /// mirroring `astRecordFieldTypeAt`.
    function astVariantPayloadTypeAt(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pattern: &Ast::Pattern::Path,
      index: u64,
    ): Option<Analyzer::TypeId> {
      let segmentCount: u64 = pattern.segments.length();

      if (segmentCount < 2) {
        return Option::NONE;
      }

      let Option::SOME(enumName) = pattern.segments.get(segmentCount - 2) else {
        return Option::NONE;
      };
      let Option::SOME(variantName) = pattern.segments.get(segmentCount - 1) else {
        return Option::NONE;
      };

      let mut rootIndex: u64 = 0;

      while (rootIndex < module.roots.length()) {
        let Option::SOME(itemId) = module.roots.get(rootIndex) else {
          rootIndex += 1;
          continue;
        };
        let Option::SOME(item) = module.items.get(*itemId) else {
          rootIndex += 1;
          continue;
        };

        if (let Ast::Item::Node::Enum(enumItem) = item) {
          if (enumItem.name.equals(enumName.toStr())) {
            let Option::SOME(annotationId) = Analyzer::Typecheck::astVariantPayloadAnnotationAt(
              module,
              &enumItem,
              variantName.toStr(),
              index,
            ) else {
              return Option::NONE;
            };

            return Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, annotationId);
          }
        }

        rootIndex += 1;
      }

      return Option::NONE;
    }

    function astRecordFieldTypeAt(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      pattern: &Ast::Pattern::Path,
      index: u64,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(recordName) = pattern.segments.get(0) else {
        return Option::NONE;
      };

      let mut rootIndex: u64 = 0;
      while (rootIndex < module.roots.length()) {
        let Option::SOME(itemId) = module.roots.get(rootIndex) else {
          rootIndex += 1;
          continue;
        };
        let Option::SOME(item) = module.items.get(*itemId) else {
          rootIndex += 1;
          continue;
        };

        if (let Ast::Item::Node::Record(record_) = item) {
          if (record_.name.equals(recordName.toStr())) {
            let Option::SOME(fieldPatternId) = record_.fields.get(index) else {
              return Option::NONE;
            };
            let Option::SOME(fieldPattern) = module.patterns.get(*fieldPatternId) else {
              return Option::NONE;
            };
            if (let Ast::Pattern::Node::Binding(binding) = fieldPattern) {
              let Option::SOME(annotationId) = binding.annotation else {
                return Option::NONE;
              };
              return Analyzer::Typecheck::resolveLocalAnnotation(defStore, typeStore, symbols, module, annotationId);
            }
            return Option::NONE;
          }
        }

        rootIndex += 1;
      }

      return Option::NONE;
    }

    function collectRecordPathPatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      patternId: Ast::PatternId,
      pattern: &Ast::Pattern::Path,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): boolean {
      let expectedRecordDefIdOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::requireNonGenericRecordDefId(
        state,
        defStore,
        typeStore,
        span,
        typeId,
        "record destructure annotation must be a non-generic record",
        "typecheck does not support generic record destructuring",
      );
      let Option::SOME(expectedRecordDefId) = expectedRecordDefIdOpt else {
        return false;
      };

      let refOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupPatternRef(resolvedBodies, patternId);
      let Option::SOME(ref_) = refOpt else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure pattern must resolve to a non-generic record");
        return false;
      };

      let constructorDefId: Analyzer::DefinitionId = match (ref_) {
        Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> defId,
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure pattern must resolve to a non-generic record");
          return false;
        },
      };

      let constructorTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::definitionType(defStore, typeStore, constructorDefId);
      let Option::SOME(constructorType) = constructorTypeOpt else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure pattern must resolve to a non-generic record");
        return false;
      };

      let constructorRecordDefIdOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::requireNonGenericRecordDefId(
        state,
        defStore,
        typeStore,
        span,
        constructorType,
        "record destructure pattern must resolve to a non-generic record",
        "typecheck does not support generic record destructuring",
      );
      let Option::SOME(_) = constructorRecordDefIdOpt else {
        return false;
      };

      if (!Analyzer::Typecheck::typesEqual(state, defStore, typeStore, span, typeId, constructorType)) {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure pattern does not match annotated record type");
        return false;
      }

      let expectedFieldCount: u64 = Analyzer::Typecheck::recordFieldCount(defStore, expectedRecordDefId);
      if (pattern.arguments.length() != expectedFieldCount) {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::PATTERN_ARITY_MISMATCH, "record destructure field count mismatch");
        return false;
      }

      let mut index: u64 = 0;
      while (index < expectedFieldCount) {
        let Option::SOME(argPatternId) = pattern.arguments.get(index) else {
          index += 1;
          continue;
        };
        let fieldTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::astRecordFieldTypeAt(defStore, typeStore, symbols, module, pattern, index);
        let Option::SOME(fieldType) = fieldTypeOpt else {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "record destructure field type is unavailable");
          return false;
        };

        if (!Analyzer::Typecheck::collectPatternBindings(state, defStore, typeStore, symbols, resolvedBodies, module, *argPatternId, fieldType, mutable, span)) {
          return false;
        }

        index += 1;
      }

      return true;
    }

    /// Binds an enum-variant path pattern (`EnumName::Variant` or
    /// `EnumName::Variant(args...)`) against a scrutinee type. Parallel to
    /// `collectRecordPathPatternBindings`, but the constructor's kind is
    /// resolved once by the caller (`collectPatternBindings`) via the
    /// `BodyResolutionMap`, so this function receives `variantDefId` directly
    /// instead of re-deriving it from `pattern`.
    ///
    /// Payload sub-patterns are bound against the payload types read back from
    /// the enum declaration (`astVariantPayloadTypeAt`), because `VariantDef`
    /// stores payload arity but keeps the types as VOID sentinels (ADR-R5).
    function collectEnumVariantPatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      pattern: &Ast::Pattern::Path,
      variantDefId: Analyzer::DefinitionId,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): boolean {
      let expectedEnumDefIdOpt: Option<Analyzer::DefinitionId> = Analyzer::Typecheck::requireNonGenericEnumDefId(
        state,
        defStore,
        typeStore,
        span,
        typeId,
        "enum variant pattern must match a non-generic enum",
        "typecheck does not support generic enum destructuring",
      );
      let Option::SOME(expectedEnumDefId) = expectedEnumDefIdOpt else {
        return false;
      };

      let Option::SOME(variantDefNode) = defStore.get(variantDefId) else {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "enum variant pattern must resolve to a variant of the scrutinee's enum");
        return false;
      };

      let variant: Analyzer::VariantDef = match (variantDefNode) {
        Analyzer::Definition::Variant(v) -> Analyzer::VariantDef {
          name: v.name,
          payload: Analyzer::Typecheck::copyVariantPayloadTypeIds(&v.payload),
          owner: v.owner,
          tagValue: v.tagValue,
        },
        _ -> {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "enum variant pattern must resolve to a variant of the scrutinee's enum");
          return false;
        },
      };

      if (variant.owner.raw() != expectedEnumDefId.raw()) {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "enum variant pattern does not belong to the scrutinee's enum");
        return false;
      }

      let expectedArity: u64 = variant.payload.length();
      if (pattern.arguments.length() != expectedArity) {
        Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::PATTERN_ARITY_MISMATCH, "enum variant pattern arity does not match the variant's declared payload");
        return false;
      }

      let mut index: u64 = 0;
      while (index < expectedArity) {
        let Option::SOME(argPatternId) = pattern.arguments.get(index) else {
          index += 1;
          continue;
        };
        let payloadTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::astVariantPayloadTypeAt(
          defStore,
          typeStore,
          symbols,
          module,
          pattern,
          index,
        );
        let Option::SOME(payloadType) = payloadTypeOpt else {
          Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::TYPE_MISMATCH, "enum variant payload type is unavailable");
          return false;
        };

        if (!Analyzer::Typecheck::collectPatternBindings(state, defStore, typeStore, symbols, resolvedBodies, module, *argPatternId, payloadType, mutable, span)) {
          return false;
        }

        index += 1;
      }

      return true;
    }

    function collectPatternBindings(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      patternId: Ast::PatternId,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): boolean {
      let Option::SOME(pattern) = module.patterns.get(patternId) else {
        return true;
      };

      match (pattern) {
        Ast::Pattern::Node::Binding(_) -> {
          return Analyzer::Typecheck::pushPatternLocal(state, resolvedBodies, patternId, typeId, mutable, span);
        },
        Ast::Pattern::Node::Wildcard(_) -> {
          return true;
        },
        Ast::Pattern::Node::Path(path) -> {
          let patternRefOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupPatternRef(resolvedBodies, patternId);
          if (let Option::SOME(Analyzer::ResolverBodies::ResolvedRef::Definition(defId)) = patternRefOpt) {
            if (let Option::SOME(def) = defStore.get(defId)) {
              if (let Analyzer::Definition::Variant(_) = def) {
                return Analyzer::Typecheck::collectEnumVariantPatternBindings(
                  state,
                  defStore,
                  typeStore,
                  symbols,
                  resolvedBodies,
                  module,
                  &path,
                  defId,
                  typeId,
                  mutable,
                  span,
                );
              }
            }
          }

          return Analyzer::Typecheck::collectRecordPathPatternBindings(
            state,
            defStore,
            typeStore,
            symbols,
            resolvedBodies,
            module,
            patternId,
            &path,
            typeId,
            mutable,
            span,
          );
        },
        Ast::Pattern::Node::Literal(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, span, "literal patterns");
          return false;
        },
        Ast::Pattern::Node::Tuple(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, span, "tuple patterns");
          return false;
        },
        Ast::Pattern::Node::Or(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, span, "or patterns");
          return false;
        },
      };

      @panic("unreachable: collectPatternBindings match did not return");
    }

    function bindPatternType(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      module: &Ast::Module,
      patternId: Ast::PatternId,
      typeId: Analyzer::TypeId,
      mutable: boolean,
      span: SourceSpan,
    ): void {
      let mark: u64 = state.localPatternIds.length();
      if (!Analyzer::Typecheck::collectPatternBindings(state, defStore, typeStore, symbols, resolvedBodies, module, patternId, typeId, mutable, span)) {
        Analyzer::Typecheck::truncateLocalBindings(state, mark);
      }
    }

    function definitionType(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      defId: Analyzer::DefinitionId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Variable(variable) -> {
          return Option::SOME(variable.declaredType);
        },
        Analyzer::Definition::Function(function_) -> {
          let mut params: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < function_.params.length()) {
            let Option::SOME(paramDefId) = function_.params.get(index) else {
              index += 1;
              continue;
            };

            let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
              index += 1;
              continue;
            };

            match (paramDef) {
              Analyzer::Definition::Variable(parameter) -> {
                params.push(parameter.declaredType);
              },
              Analyzer::Definition::Function(_) -> {},
              Analyzer::Definition::Record(_) -> {},
              Analyzer::Definition::Enum(_) -> {},
              Analyzer::Definition::Field(_) -> {},
              Analyzer::Definition::Variant(_) -> {},
              Analyzer::Definition::TypeParam(_) -> {},
              Analyzer::Definition::TypeAlias(_) -> {},
              Analyzer::Definition::Trait(_) -> {},
              Analyzer::Definition::Method(_) -> {},
            };

            index += 1;
          }

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.functionType(params, function_.returnType));
        },
        Analyzer::Definition::Method(method) -> {
          // A method's callable type mirrors a function: parameter types from
          // its `Variable` sub-definitions (including `self` for instance
          // methods) plus the resolved return type. `checkCallExpr` and
          // `checkInstanceMethodCallExpr` are the actual call-resolution
          // consumers; this keeps `definitionType` total over `Definition::Method`.
          let mut params: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut index: u64 = 0;

          while (index < method.params.length()) {
            let Option::SOME(paramDefId) = method.params.get(index) else {
              index += 1;
              continue;
            };

            let Option::SOME(paramDef) = defStore.get(*paramDefId) else {
              index += 1;
              continue;
            };

            match (paramDef) {
              Analyzer::Definition::Variable(parameter) -> {
                params.push(parameter.declaredType);
              },
              Analyzer::Definition::Function(_) -> {},
              Analyzer::Definition::Record(_) -> {},
              Analyzer::Definition::Enum(_) -> {},
              Analyzer::Definition::Field(_) -> {},
              Analyzer::Definition::Variant(_) -> {},
              Analyzer::Definition::TypeParam(_) -> {},
              Analyzer::Definition::TypeAlias(_) -> {},
              Analyzer::Definition::Trait(_) -> {},
              Analyzer::Definition::Method(_) -> {},
            };

            index += 1;
          }

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.functionType(params, method.returnType));
        },
        Analyzer::Definition::Record(record_) -> {
          return Option::SOME(record_.typeId);
        },
        Analyzer::Definition::Enum(enum_) -> {
          return Option::SOME(enum_.typeId);
        },
        Analyzer::Definition::TypeAlias(alias_) -> {
          return Option::SOME(alias_.typeId);
        },
        Analyzer::Definition::Field(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Variant(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Trait(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: definitionType match did not return");
    }

    record FunctionSignature {
      public params: Vector<Analyzer::DefinitionId>;
      public returnType: Analyzer::TypeId;
    }

    function extractFunctionSignature(
      defStore: &mut Analyzer::DefinitionStore,
      functionDefId: Analyzer::DefinitionId,
    ): Option<Analyzer::Typecheck::FunctionSignature> {
      let Option::SOME(def) = defStore.get(functionDefId) else {
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Function(function_) -> {
          let mut params: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let mut index: u64 = 0;

          while (index < function_.params.length()) {
            let Option::SOME(paramDefId) = function_.params.get(index) else {
              index += 1;
              continue;
            };

            params.push(*paramDefId);
            index += 1;
          }

          return Option::SOME(Analyzer::Typecheck::FunctionSignature {
            params: params,
            returnType: function_.returnType,
          });
        },
        Analyzer::Definition::Method(method) -> {
          // Methods reuse the function-signature shape: `MethodDef.params` are
          // `Variable` sub-definitions in source order, and `returnType` is the
          // resolver-patched method return type. This lets `checkFunctionItem`
          // typecheck method bodies exactly like function bodies.
          let mut params: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
          let mut index: u64 = 0;

          while (index < method.params.length()) {
            let Option::SOME(paramDefId) = method.params.get(index) else {
              index += 1;
              continue;
            };

            params.push(*paramDefId);
            index += 1;
          }

          return Option::SOME(Analyzer::Typecheck::FunctionSignature {
            params: params,
            returnType: method.returnType,
          });
        },
        Analyzer::Definition::Variable(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Record(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Enum(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Field(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Variant(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Trait(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: extractFunctionSignature match did not return");
    }

    record MethodCallInfo {
      public isStatic: boolean;
      public selfMutable: boolean;
      public returnType: Analyzer::TypeId;
    }

    /// Centralizes `Definition::Method` detection so only one new `Definition`
    /// match is introduced here — consumed by `checkCallExpr`'s static-path
    /// branch, the instance-call mut-self check, and (WU3) the bare
    /// method-reference guard.
    function lookupMethodDefInfo(
      defStore: &mut Analyzer::DefinitionStore,
      defId: Analyzer::DefinitionId,
    ): Option<Analyzer::Typecheck::MethodCallInfo> {
      let Option::SOME(def) = defStore.get(defId) else {
        return Option::NONE;
      };

      match (def) {
        Analyzer::Definition::Method(method) -> {
          return Option::SOME(Analyzer::Typecheck::MethodCallInfo {
            isStatic: method.isStatic,
            selfMutable: method.selfMutable,
            returnType: method.returnType,
          });
        },
        Analyzer::Definition::Function(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Record(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Enum(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Variable(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Field(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Variant(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeParam(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::TypeAlias(_) -> {
          return Option::NONE;
        },
        Analyzer::Definition::Trait(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: lookupMethodDefInfo match did not return");
    }

    /// Names resolved by `resolveLocalAnnotation`'s 1-segment branch as
    /// primitives via literal comparison. Shared with the N>=2 branch so a
    /// qualified path ending in a primitive name (e.g. `Ns::i32`) is skipped
    /// rather than incorrectly resolved.
    function isPrimitiveAnnotationName(name: str): boolean {
      if (name.equals("i8")) {
        return true;
      }
      if (name.equals("i16")) {
        return true;
      }
      if (name.equals("i32")) {
        return true;
      }
      if (name.equals("i64")) {
        return true;
      }
      if (name.equals("u8")) {
        return true;
      }
      if (name.equals("u16")) {
        return true;
      }
      if (name.equals("u32")) {
        return true;
      }
      if (name.equals("u64")) {
        return true;
      }
      if (name.equals("f32")) {
        return true;
      }
      if (name.equals("f64")) {
        return true;
      }
      if (name.equals("boolean")) {
        return true;
      }
      if (name.equals("char")) {
        return true;
      }
      if (name.equals("str")) {
        return true;
      }
      if (name.equals("void")) {
        return true;
      }
      if (name.equals("never")) {
        return true;
      }

      return false;
    }

    function resolveLocalAnnotation(
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      symbols: &mut Analyzer::SymbolTable,
      module: &Ast::Module,
      typeId: Ast::TypeId,
    ): Option<Analyzer::TypeId> {
      let Option::SOME(typeNode) = module.types.get(typeId) else {
        return Option::NONE;
      };

      match (typeNode) {
        Ast::Type::Node::Path(path) -> {
          if (path.segments.length() == 0) {
            return Option::NONE;
          }

          // N >= 2 segments (ADR D11): the leading segments form an
          // unvalidated namespace-qualifier prefix — TODO(namespace-path-validation),
          // the same debt tracked at `resolvePathTail` in resolver_bodies.ign.
          // Only the last segment is resolved, and only against
          // Record/Enum/TypeAlias names — deliberately narrower than the
          // 1-segment scan below, which also matches functions/variables/etc.
          if (path.segments.length() >= 2) {
            let Option::SOME(lastSegment) = path.segments.get(path.segments.length() - 1) else {
              return Option::NONE;
            };

            let lastName: String = lastSegment.clone();
            if (Analyzer::Typecheck::isPrimitiveAnnotationName(lastName.toStr())) {
              return Option::NONE;
            }

            let mut qualifiedSymbolsRef: &mut Analyzer::SymbolTable = symbols;
            let lastSymbol: Analyzer::SymbolId = qualifiedSymbolsRef.intern(lastName.toStr());
            let mut qualifiedIndex: u64 = 0;
            while (qualifiedIndex < defStore.length()) {
              let qualifiedDefId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(qualifiedIndex as u32);
              let Option::SOME(qualifiedDef) = defStore.get(qualifiedDefId) else {
                qualifiedIndex += 1;
                continue;
              };

              if (qualifiedDef.name().raw() != lastSymbol.raw()) {
                qualifiedIndex += 1;
                continue;
              }

              match (qualifiedDef) {
                Analyzer::Definition::Record(record_) -> {
                  return Option::SOME(record_.typeId);
                },
                Analyzer::Definition::Enum(enum_) -> {
                  return Option::SOME(enum_.typeId);
                },
                Analyzer::Definition::TypeAlias(alias_) -> {
                  return Option::SOME(alias_.typeId);
                },
                Analyzer::Definition::Function(_) -> {},
                Analyzer::Definition::Variable(_) -> {},
                Analyzer::Definition::Field(_) -> {},
                Analyzer::Definition::Variant(_) -> {},
                Analyzer::Definition::TypeParam(_) -> {},
                Analyzer::Definition::Trait(_) -> {},
                Analyzer::Definition::Method(_) -> {},
              };

              qualifiedIndex += 1;
            }

            return Option::NONE;
          }

          let Option::SOME(segment) = path.segments.get(0) else {
            return Option::NONE;
          };

          let name: String = segment.clone();
          let primitiveType: Option<Analyzer::TypeId> = Analyzer::Resolver::primitiveForName(typeStore, name.toStr());
          if (let Option::SOME(_) = primitiveType) {
            return primitiveType;
          }

          let mut symbolsRef: &mut Analyzer::SymbolTable = symbols;
          let symbol: Analyzer::SymbolId = symbolsRef.intern(name.toStr());
          let mut index: u64 = 0;
          while (index < defStore.length()) {
            let defId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>(index as u32);
            let Option::SOME(def) = defStore.get(defId) else {
              index += 1;
              continue;
            };

            if (def.name().raw() == symbol.raw()) {
              return Analyzer::Typecheck::definitionType(defStore, typeStore, defId);
            }

            index += 1;
          }

          return Option::NONE;
        },
        Ast::Type::Node::Pointer(pointer) -> {
          let Option::SOME(pointee) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            pointer.pointee,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          if (pointer.mutable) {
            return Option::SOME(typeStoreRef.mutablePointer(pointee));
          }

          return Option::SOME(typeStoreRef.pointer(pointee));
        },
        Ast::Type::Node::Reference(reference) -> {
          let Option::SOME(referent) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            reference.target,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          if (reference.mutable) {
            return Option::SOME(typeStoreRef.mutableReference(referent));
          }

          return Option::SOME(typeStoreRef.reference(referent));
        },
        Ast::Type::Node::Tuple(tuple) -> {
          let mut elements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut elementIndex: u64 = 0;

          while (elementIndex < tuple.elements.length()) {
            let Option::SOME(elementTypeId) = tuple.elements.get(elementIndex) else {
              return Option::NONE;
            };

            // One unresolvable element makes the whole tuple unusable: a partial
            // tuple type would compare equal to a different one.
            let Option::SOME(resolvedElement) = Analyzer::Typecheck::resolveLocalAnnotation(
              defStore,
              typeStore,
              symbols,
              module,
              *elementTypeId,
            ) else {
              return Option::NONE;
            };

            elements.push(resolvedElement);
            elementIndex += 1;
          }

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.tuple(elements));
        },
        Ast::Type::Node::Slice(slice) -> {
          let Option::SOME(element) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            slice.element,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.slice(element));
        },
        Ast::Type::Node::FixedArray(fixedArray) -> {
          let Option::SOME(element) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            fixedArray.element,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
          return Option::SOME(typeStoreRef.fixedArray(element, fixedArray.size));
        },
        Ast::Type::Node::Function(functionType) -> {
          let mut params: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
          let mut paramIndex: u64 = 0;

          while (paramIndex < functionType.parameters.length()) {
            let Option::SOME(paramTypeId) = functionType.parameters.get(paramIndex) else {
              return Option::NONE;
            };

            // One unresolvable parameter makes the whole signature unusable: a partial
            // function type would compare equal to a different one.
            let Option::SOME(resolvedParam) = Analyzer::Typecheck::resolveLocalAnnotation(
              defStore,
              typeStore,
              symbols,
              module,
              *paramTypeId,
            ) else {
              return Option::NONE;
            };

            params.push(resolvedParam);
            paramIndex += 1;
          }

          let Option::SOME(resolvedReturn) = Analyzer::Typecheck::resolveLocalAnnotation(
            defStore,
            typeStore,
            symbols,
            module,
            functionType.returnType,
          ) else {
            return Option::NONE;
          };

          let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;

          return Option::SOME(typeStoreRef.intern(Analyzer::Type::Function(Analyzer::FunctionType {
            params: params,
            returnType: resolvedReturn,
          })));
        },
        Ast::Type::Node::Generic(_) -> {
          return Option::NONE;
        },
      };

      @panic("unreachable: resolveLocalAnnotation match did not return");
    }

    function literalType(
      typeStore: &mut Analyzer::TypeStore,
      literal: &Ast::Expression::Literal,
    ): Analyzer::TypeId {
      let mut typeStoreRef: &mut Analyzer::TypeStore = typeStore;
      match (&literal.value) {
        Ast::Expression::LiteralValue::Int(_) -> {
          return typeStoreRef.intern(Analyzer::Type::I32);
        },
        Ast::Expression::LiteralValue::UInt(_) -> {
          return typeStoreRef.intern(Analyzer::Type::U32);
        },
        Ast::Expression::LiteralValue::Float(_) -> {
          return typeStoreRef.intern(Analyzer::Type::F64);
        },
        Ast::Expression::LiteralValue::Boolean(_) -> {
          return typeStoreRef.intern(Analyzer::Type::BOOLEAN);
        },
        Ast::Expression::LiteralValue::Character(_) -> {
          return typeStoreRef.intern(Analyzer::Type::CHAR);
        },
        Ast::Expression::LiteralValue::String(_) -> {
          return typeStoreRef.intern(Analyzer::Type::STR);
        },
        Ast::Expression::LiteralValue::Null -> {
          return typeStoreRef.intern(Analyzer::Type::VOID);
        },
      };

      @panic("unreachable: literalType match did not return");
    }

    function checkResolvedValueExpr(
      state: &mut Analyzer::Typecheck::TypecheckState,
      defStore: &mut Analyzer::DefinitionStore,
      typeStore: &mut Analyzer::TypeStore,
      resolvedBodies: &Analyzer::ResolverBodies::ResolverBodiesOutput,
      exprId: Ast::ExpressionId,
      span: SourceSpan,
    ): Option<Analyzer::TypeId> {
      let resolvedOpt: Option<Analyzer::ResolverBodies::ResolvedRef> = Analyzer::Typecheck::lookupExprRef(resolvedBodies, exprId);
      let Option::SOME(resolved) = resolvedOpt else {
        Analyzer::Typecheck::emitUnsupported(state, span, "unresolved name lookup");
        return Option::NONE;
      };

      match (resolved) {
        Analyzer::ResolverBodies::ResolvedRef::Local(localId) -> {
          let localBindingOpt: Option<Analyzer::Typecheck::LocalBindingInfo> = Analyzer::Typecheck::lookupLocalBinding(state, localId);
          let Option::SOME(localBinding) = localBindingOpt else {
            Analyzer::Typecheck::emitUnsupported(state, span, "unknown local binding type");
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, localBinding.typeId);
          return Option::SOME(localBinding.typeId);
        },
        Analyzer::ResolverBodies::ResolvedRef::Definition(defId) -> {
          let methodInfoOpt: Option<Analyzer::Typecheck::MethodCallInfo> = Analyzer::Typecheck::lookupMethodDefInfo(defStore, defId);
          if (methodInfoOpt.isSome()) {
            Analyzer::Typecheck::emitDiagnostic(state, span, DiagnosticCode::METHOD_CALL_KIND_MISMATCH, "method references are not values; call the method instead");
            return Option::NONE;
          }

          let defTypeOpt: Option<Analyzer::TypeId> = Analyzer::Typecheck::definitionType(defStore, typeStore, defId);
          let Option::SOME(typeId) = defTypeOpt else {
            Analyzer::Typecheck::emitUnsupported(state, span, "definition kind in expression position");
            return Option::NONE;
          };

          Analyzer::Typecheck::recordExprType(state, exprId, typeId);
          return Option::SOME(typeId);
        },
        Analyzer::ResolverBodies::ResolvedRef::TypeParam(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, span, "type parameters in expression position");
          return Option::NONE;
        },
        Analyzer::ResolverBodies::ResolvedRef::Unresolved(_) -> {
          Analyzer::Typecheck::emitUnsupported(state, span, "unresolved expression reference");
          return Option::NONE;
        },
      };

      @panic("unreachable: checkResolvedValueExpr match did not return");
    }
  }
}
