/// Scenario: a generic instance with a view type argument is a view
/// (`Option<&T>`).
/// Spec: S2.
@test
function viewTypeInstanceWithViewArgumentIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut syms: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let idRef: Analyzer::TypeId = store.reference(idI32);

  let defId: Analyzer::DefinitionId = viewTestRecordDef(&mut syms, &mut defs, &mut store, "Box", Vector::new<Analyzer::TypeId>());

  let mut args: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  args.push(idRef);

  let id: Analyzer::TypeId = store.instance(defId, args);

  Test::assert(Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

/// Scenario: a generic instance with a `static str` argument is not a view:
/// the instance's own view-ness follows its arguments, and `static str` owns
/// its bytes (`Vector<static str>` of literals is storable anywhere).
/// Spec: S2.
@test
function viewTypeInstanceWithStaticStrArgumentIsNotAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut syms: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let idStaticStr: Analyzer::TypeId = store.intern(Analyzer::Type::STATIC_STR);

  let defId: Analyzer::DefinitionId = viewTestRecordDef(&mut syms, &mut defs, &mut store, "Vector", Vector::new<Analyzer::TypeId>());

  let mut args: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  args.push(idStaticStr);

  let id: Analyzer::TypeId = store.instance(defId, args);

  Test::assert(!Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

