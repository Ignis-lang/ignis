// ─── Fixture helpers ──────────────────────────────────────────────────────────

/// Creates a record definition whose fields have the given types, and returns
/// the record's definition id. The fields are pushed first (their owner is the
/// id the record definition is about to get) and the record definition last.
function viewTestRecordDef(
  syms: &mut Analyzer::SymbolTable,
  defs: &mut Analyzer::DefinitionStore,
  store: &mut Analyzer::TypeStore,
  name: str,
  fieldTypes: Vector<Analyzer::TypeId>,
): Analyzer::DefinitionId {
  let recordId: Analyzer::DefinitionId = Id::fromRaw<Analyzer::DefinitionTag>((defs.length() + fieldTypes.length()) as u32);
  let typeId: Analyzer::TypeId = store.recordType(recordId);
  let sym: Analyzer::SymbolId = syms.intern(name);

  let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
  let mut index: u64 = 0;

  while (index < fieldTypes.length()) {
    if (let Option::SOME(fieldType) = fieldTypes.get(index)) {
      fields.push(defs.push(Analyzer::Definition::Field(Analyzer::FieldDef {
        name: syms.intern("field"),
        fieldType: *fieldType,
        owner: recordId,
        index: index as u32,
        alignment: Option::NONE,
      })));
    }

    index += 1;
  }

  let pushedId: Analyzer::DefinitionId = defs.push(Analyzer::Definition::Record(Analyzer::RecordDef {
    name: sym,
    visibility: Analyzer::Visibility::PUBLIC,
    typeParams: Vector::new<Analyzer::DefinitionId>(),
    fields: fields,
    instanceMethods: Vector::new<Analyzer::DefinitionId>(),
    staticMethods: Vector::new<Analyzer::DefinitionId>(),
    staticFields: Vector::new<Analyzer::DefinitionId>(),
    typeId: typeId,
    implementsCopy: false,
    implementsDrop: false,
    implementedTraits: Vector::new<String>(),
    packed: false,
    alignment: Option::NONE,
    cLayout: false,
    isExtern: false,
  }));

  Test::assertEq<u32>(pushedId.raw(), recordId.raw());

  return pushedId;
}

/// Replaces an existing record definition's fields (used for recursive
/// records, whose self-referential field type needs the record's own type id).
function viewTestSetRecordFields(
  syms: &mut Analyzer::SymbolTable,
  defs: &mut Analyzer::DefinitionStore,
  store: &mut Analyzer::TypeStore,
  name: str,
  defId: Analyzer::DefinitionId,
  fieldTypes: Vector<Analyzer::TypeId>,
): void {
  let sym: Analyzer::SymbolId = syms.intern(name);

  let mut fields: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
  let mut index: u64 = 0;

  while (index < fieldTypes.length()) {
    if (let Option::SOME(fieldType) = fieldTypes.get(index)) {
      fields.push(defs.push(Analyzer::Definition::Field(Analyzer::FieldDef {
        name: syms.intern("field"),
        fieldType: *fieldType,
        owner: defId,
        index: index as u32,
        alignment: Option::NONE,
      })));
    }

    index += 1;
  }

  defs.replace(defId, Analyzer::Definition::Record(Analyzer::RecordDef {
    name: sym,
    visibility: Analyzer::Visibility::PUBLIC,
    typeParams: Vector::new<Analyzer::DefinitionId>(),
    fields: fields,
    instanceMethods: Vector::new<Analyzer::DefinitionId>(),
    staticMethods: Vector::new<Analyzer::DefinitionId>(),
    staticFields: Vector::new<Analyzer::DefinitionId>(),
    typeId: store.recordType(defId),
    implementsCopy: false,
    implementsDrop: false,
    implementedTraits: Vector::new<String>(),
    packed: false,
    alignment: Option::NONE,
    cLayout: false,
    isExtern: false,
  }));
}

/// Creates an enum definition whose variants carry the given payload types
/// (one variant per entry), and returns the enum's definition id.
function viewTestEnumDef(
  syms: &mut Analyzer::SymbolTable,
  defs: &mut Analyzer::DefinitionStore,
  store: &mut Analyzer::TypeStore,
  name: str,
  variantPayloads: Vector<Vector<Analyzer::TypeId>>,
): Analyzer::DefinitionId {
  let sym: Analyzer::SymbolId = syms.intern(name);
  let defId: Analyzer::DefinitionId = defs.push(Analyzer::Definition::Enum(Analyzer::EnumDef {
    name: sym,
    visibility: Analyzer::Visibility::PUBLIC,
    typeParams: Vector::new<Analyzer::DefinitionId>(),
    variants: Vector::new<Analyzer::DefinitionId>(),
    tryCapable: Option::NONE,
    instanceMethods: Vector::new<Analyzer::DefinitionId>(),
    staticMethods: Vector::new<Analyzer::DefinitionId>(),
    staticFields: Vector::new<Analyzer::DefinitionId>(),
    typeId: store.enumType(Id::fromRaw<Analyzer::DefinitionTag>(defs.length() as u32)),
    implementsCopy: false,
    implementsDrop: false,
    implementedTraits: Vector::new<String>(),
  }));

  let mut variants: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
  let mut tagValue: u32 = 0;
  let mut index: u64 = 0;

  while (index < variantPayloads.length()) {
    let mut payload: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

    if (let Option::SOME(entry) = variantPayloads.get(index)) {
      let mut payloadIndex: u64 = 0;

      while (payloadIndex < entry.length()) {
        if (let Option::SOME(payloadType) = entry.get(payloadIndex)) {
          payload.push(*payloadType);
        }

        payloadIndex += 1;
      }
    }

    variants.push(defs.push(Analyzer::Definition::Variant(Analyzer::VariantDef {
      name: syms.intern("VARIANT"),
      payload: payload,
      owner: defId,
      tagValue: tagValue,
    })));

    tagValue += 1;
    index += 1;
  }

  defs.replace(defId, Analyzer::Definition::Enum(Analyzer::EnumDef {
    name: sym,
    visibility: Analyzer::Visibility::PUBLIC,
    typeParams: Vector::new<Analyzer::DefinitionId>(),
    variants: variants,
    tryCapable: Option::NONE,
    instanceMethods: Vector::new<Analyzer::DefinitionId>(),
    staticMethods: Vector::new<Analyzer::DefinitionId>(),
    staticFields: Vector::new<Analyzer::DefinitionId>(),
    typeId: store.enumType(defId),
    implementsCopy: false,
    implementsDrop: false,
    implementedTraits: Vector::new<String>(),
  }));

  return defId;
}

/// Creates a type alias definition targeting `aliasedType`.
function viewTestAliasDef(
  syms: &mut Analyzer::SymbolTable,
  defs: &mut Analyzer::DefinitionStore,
  store: &mut Analyzer::TypeStore,
  name: str,
  aliasedType: Analyzer::TypeId,
): Analyzer::DefinitionId {
  return defs.push(Analyzer::Definition::TypeAlias(Analyzer::TypeAliasDef {
    name: syms.intern(name),
    visibility: Analyzer::Visibility::PUBLIC,
    typeParams: Vector::new<Analyzer::DefinitionId>(),
    aliasedType: aliasedType,
    typeId: store.aliasType(Id::fromRaw<Analyzer::DefinitionTag>(defs.length() as u32)),
  }));
}

// ─── Type shapes ──────────────────────────────────────────────────────────────

/// Scenario: `str` — what `toStr()` and slicing produce — is a view.
/// Spec: S2.
@test
function viewTypeStrIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let id: Analyzer::TypeId = store.intern(Analyzer::Type::STR);

  Test::assert(Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

/// Scenario: `static str` is not a view: a static string owns its bytes, so a
/// record holding only one is storable anywhere.
/// Spec: S2.
@test
function viewTypeStaticStrIsNotAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let id: Analyzer::TypeId = store.intern(Analyzer::Type::STATIC_STR);

  Test::assert(!Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

