/// Scenario: a tuple with a view element is a view.
/// Spec: S2.
@test
function viewTypeTupleWithViewElementIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let idStr: Analyzer::TypeId = store.intern(Analyzer::Type::STR);

  let mut elements: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  elements.push(idI32);
  elements.push(idStr);

  let id: Analyzer::TypeId = store.tuple(elements);

  Test::assert(Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

