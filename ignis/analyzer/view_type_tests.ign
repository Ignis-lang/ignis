/// Scenario: `*mut str` can hold a view.
/// Spec: S3, L19.
@test
function holdingPointerToStrReaches(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut syms: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let idU8: Analyzer::TypeId = store.intern(Analyzer::Type::U8);
  let idStr: Analyzer::TypeId = store.intern(Analyzer::Type::STR);
  let idMutStr: Analyzer::TypeId = store.intern(Analyzer::Type::Reference(Analyzer::ReferenceType {
    referent: idStr,
    mutable: true,
  }));
  let id: Analyzer::TypeId = store.pointer(idStr);
