// ─── Closure values ───────────────────────────────────────────────────────────

/// Builds a closure value with the given captures.
function viewTestClosure(captures: Vector<Hir::HirCapture>): Hir::HirClosure {
  return Hir::HirClosure {
    params: Vector::new<Analyzer::DefinitionId>(),
    returnType: Id::fromRaw<Analyzer::TypeTag>(0),
    body: Id::fromRaw<Hir::NodeTag>(0),
    captures: captures,
    escapes: false,
    thunkDef: Option::NONE,
    dropDef: Option::NONE,
    captureOverrides: Vector::new<Hir::HirCaptureOverride>(),
  };
}

function viewTestCapture(mode: Hir::CaptureMode): Hir::HirCapture {
  return viewTestCaptureOfType(mode, Id::fromRaw<Analyzer::TypeTag>(0));
}

function viewTestCaptureOfType(
  mode: Hir::CaptureMode,
  typeInEnv: Analyzer::TypeId
): Hir::HirCapture {
  return Hir::HirCapture {
    sourceDef: Id::fromRaw<Analyzer::DefinitionTag>(0),
    fieldIndex: 0,
    mode: mode,
    typeInEnv: typeInEnv,
  };
}

/// Scenario: a closure that captures nothing is not a view.
/// Spec: S2, L14.
@test
function viewTypeClosureWithoutCapturesIsNotAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let closure: Hir::HirClosure = viewTestClosure(Vector::new<Hir::HirCapture>());

  Test::assert(!Analyzer::ViewType::closureIsView(&mut defs, &mut store, &closure));
}

/// Scenario: a closure capturing by value is not a view: the closure owns its
/// copy of the capture.
/// Spec: S2, L14.
@test
function viewTypeClosureWithByValueCaptureIsNotAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut captures: Vector<Hir::HirCapture> = Vector::new<Hir::HirCapture>();
  captures.push(viewTestCapture(Hir::CaptureMode::ByValue));

  let closure: Hir::HirClosure = viewTestClosure(captures);

  Test::assert(!Analyzer::ViewType::closureIsView(&mut defs, &mut store, &closure));
}

/// Scenario: a closure capturing a view type by value is a view: the
/// environment holds storage it does not own, be it a `str` or a `&T` read
/// of a `Copy` local.
/// Spec: S2, T4b.
@test
function viewTypeClosureWithByValueViewCaptureIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let idStr: Analyzer::TypeId = store.intern(Analyzer::Type::STR);
  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let idRef: Analyzer::TypeId = store.reference(idI32);

  let mut strCaptures: Vector<Hir::HirCapture> = Vector::new<Hir::HirCapture>();
  strCaptures.push(viewTestCaptureOfType(Hir::CaptureMode::ByValue, idStr));

  let strClosure: Hir::HirClosure = viewTestClosure(strCaptures);

  Test::assert(Analyzer::ViewType::closureIsView(&mut defs, &mut store, &strClosure));

  let mut refCaptures: Vector<Hir::HirCapture> = Vector::new<Hir::HirCapture>();
  refCaptures.push(viewTestCaptureOfType(Hir::CaptureMode::ByValue, idRef));

  let refClosure: Hir::HirClosure = viewTestClosure(refCaptures);

  Test::assert(Analyzer::ViewType::closureIsView(&mut defs, &mut store, &refClosure));
}

/// Scenario: a closure capturing by shared reference is a view.
/// Spec: S2, L14.
@test
function viewTypeClosureWithByRefCaptureIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut captures: Vector<Hir::HirCapture> = Vector::new<Hir::HirCapture>();
  captures.push(viewTestCapture(Hir::CaptureMode::ByRef));

  let closure: Hir::HirClosure = viewTestClosure(captures);

  Test::assert(Analyzer::ViewType::closureIsView(&mut defs, &mut store, &closure));
}

/// Scenario: a closure capturing by mutable reference is a view.
/// Spec: S2, L14.
@test
function viewTypeClosureWithByMutRefCaptureIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut captures: Vector<Hir::HirCapture> = Vector::new<Hir::HirCapture>();
  captures.push(viewTestCapture(Hir::CaptureMode::ByMutRef));

  let closure: Hir::HirClosure = viewTestClosure(captures);

  Test::assert(Analyzer::ViewType::closureIsView(&mut defs, &mut store, &closure));
}

// ─── Pipeline: real closures through capture analysis ─────────────────────────

record ViewTypePipelineClosures {
  public total: u64;
  public viewCount: u64;
  public captureTotal: u64;
  public byRefCount: u64;
  public byMutRefCount: u64;
  public byValueCount: u64;
}

/// Parses, analyzes, lowers and capture-analyzes `source`, then counts the
/// closures in the resulting HIR and how many of them `closureIsView` flags.
function viewTypePipelineClosures(source: str): ViewTypePipelineClosures {
  let mut sourceMap: SourceMap = SourceMap::new();
  let file: SourceFile = SourceFile::create(&mut sourceMap, "view_type_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  let lexErrors: u64 = countErrors(&parsed.lexDiagnostics);
  let parseErrors: u64 = countErrors(&parsed.parseDiagnostics);

  Test::assertEq<u64>(lexErrors, 0);
  Test::assertEq<u64>(parseErrors, 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(countErrors(&output.diagnostics), 0);

  let mut hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let captureDiagnostics: DiagnosticBag = Capture::populateClosureCaptures(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &mut hir,
  );

  Test::assertEq<u64>(countErrors(&captureDiagnostics), 0);

  let mut total: u64 = 0;
  let mut viewCount: u64 = 0;
  let mut captureTotal: u64 = 0;
  let mut byRefCount: u64 = 0;
  let mut byMutRefCount: u64 = 0;
  let mut byValueCount: u64 = 0;
  let mut index: u64 = 0;

  while (index < hir.length()) {
    if (let Option::SOME(node) = hir.get(Id::fromRaw<Hir::NodeTag>(index as u32))) {
      if (let Hir::HirKind::Closure(closure) = &node.kind) {
        total += 1;

        if (Analyzer::ViewType::closureIsView(&mut defStore, &mut typeStore, &closure)) {
          viewCount += 1;
        }

        let mut captureIndex: u64 = 0;

        while (captureIndex < closure.captures.length()) {
          if (let Option::SOME(capture) = closure.captures.get(captureIndex)) {
            captureTotal += 1;

            match (&capture.mode) {
              Hir::CaptureMode::ByRef -> {
                byRefCount += 1;
              },
              Hir::CaptureMode::ByMutRef -> {
                byMutRefCount += 1;
              },
              _ -> {
                byValueCount += 1;
              },
            };
          }

          captureIndex += 1;
        }
      }
    }

    index += 1;
  }

  return ViewTypePipelineClosures {
    total: total,
    viewCount: viewCount,
    captureTotal: captureTotal,
    byRefCount: byRefCount,
    byMutRefCount: byMutRefCount,
    byValueCount: byValueCount,
  };
}

function countErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    if (let Option::SOME(diagnostic) = bag.get(index)) {
      if (diagnostic.severity == Severity::ERROR) {
        count += 1;
      }
    }

    index += 1;
  }

  return count;
}

/// Scenario: the by-ref fixture is a clean program through parse, analysis,
/// lowering and capture analysis.
/// Spec: S2, L14.
@test
function viewTypePipelineByRefFixtureIsClean(): void {
  let closures: ViewTypePipelineClosures = viewTypePipelineClosures(
    "@implements(Drop)\nrecord Payload {\n  public id: u64;\n}\n\nfunction run(): u64 {\n  let payload: Payload = Payload { id: 7 };\n  let read = (): u64 -> {\n    return payload.id;\n  };\n\n  return read();\n}\n",
  );

  Test::assertEq<u64>(closures.total, 1);
}

/// Scenario: `closureIsView` flags the closure as a view.
/// Spec: S2, L14.
@test
function viewTypePipelineByRefCaptureIsAView(): void {
  let closures: ViewTypePipelineClosures = viewTypePipelineClosures(
    "@implements(Drop)\nrecord Payload {\n  public id: u64;\n}\n\nfunction run(): u64 {\n  let payload: Payload = Payload { id: 7 };\n  let read = (): u64 -> {\n    return payload.id;\n  };\n\n  return read();\n}\n",
  );

  Test::assertEq<u64>(closures.viewCount, 1);
}

/// Scenario: capture analysis records the read of the non-Copy local as a
/// by-reference capture.
/// Spec: S2, L14.
@test
function viewTypePipelineByRefCaptureModeIsByRef(): void {
  let closures: ViewTypePipelineClosures = viewTypePipelineClosures(
    "@implements(Drop)\nrecord Payload {\n  public id: u64;\n}\n\nfunction run(): u64 {\n  let payload: Payload = Payload { id: 7 };\n  let read = (): u64 -> {\n    return payload.id;\n  };\n\n  return read();\n}\n",
  );

  Test::assertEq<u64>(closures.byRefCount, 1);
  Test::assertEq<u64>(closures.byMutRefCount, 0);
  Test::assertEq<u64>(closures.byValueCount, 0);
}

/// Scenario: a closure that captures nothing is not a view through the real
/// pipeline.
/// Spec: S2, L14.
@test
function viewTypePipelineClosureCapturingNothingIsNotAView(): void {
  let closures: ViewTypePipelineClosures = viewTypePipelineClosures(
    "function run(): u32 {\n  let read = (): u32 -> {\n    return 7;\n  };\n\n  return read();\n}\n",
  );

  Test::assertEq<u64>(closures.total, 1);
  Test::assertEq<u64>(closures.viewCount, 0);
}
