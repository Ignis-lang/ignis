/// Scenario: a fixed array of views is a view, since its elements are views
/// the aggregate carries.
/// Spec: S2.
@test
function viewTypeFixedArrayOfViewsIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let idRef: Analyzer::TypeId = store.reference(idI32);
  let id: Analyzer::TypeId = store.fixedArray(idRef, 4);

  Test::assert(Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

/// Scenario: a raw pointer is not a view: raw pointers and `extern` functions
/// are the unchecked boundary (S5), and the predicate must not follow them.
/// Spec: S2, S5.
@test
function viewTypePointerIsNotAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let id: Analyzer::TypeId = store.pointer(idI32);

  Test::assert(!Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

/// Scenario: a function type is not a view at the type level. Capture
/// information is a property of the closure value, not of the type (function
/// types are interned structurally, so two same-signature closures share one
/// type id); whether a concrete closure value is a view is
/// `Analyzer::ViewType::closureIsView`, and aggregates with function-typed
/// fields are decided at the node level by the enforcement passes (T4b/T4c).
/// Spec: S2, L14.
@test
function viewTypeFunctionTypeIsNotAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);

  let mut params: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  params.push(idI32);

  let id: Analyzer::TypeId = store.functionType(params, idI32);

  Test::assert(!Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

/// Scenario: a plain C function pointer is not a view either.
/// Spec: S2, L14.
@test
function viewTypeRawFunctionTypeIsNotAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);

  let id: Analyzer::TypeId = store.rawFunctionType(Vector::new<Analyzer::TypeId>(), idI32);

  Test::assert(!Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

/// Scenario: an unresolved generic parameter is not a view; the substituted
/// type is what the predicate answers on after monomorphization.
/// Spec: S2.
@test
function viewTypeParamIsNotAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let mut syms: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let sym: Analyzer::SymbolId = syms.intern("T");
  let id: Analyzer::TypeId = store.param(sym);

  Test::assert(!Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

/// Scenario: an alias to a view is a view: aliases are transparent.
/// Spec: S2.
@test
function viewTypeAliasToViewIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut syms: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let idRef: Analyzer::TypeId = store.reference(idI32);

  let aliasDefId: Analyzer::DefinitionId = viewTestAliasDef(&mut syms, &mut defs, &mut store, "RefOf", idRef);
  let id: Analyzer::TypeId = store.aliasType(aliasDefId);

  Test::assert(Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

/// Scenario: an alias to `static str` is not a view.
