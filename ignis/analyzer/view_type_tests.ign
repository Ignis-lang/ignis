/// Scenario: an enum payload holding a reference makes the enum a view
/// (`Option<&T>`).
/// Spec: S2.
@test
function viewTypeEnumWithViewPayloadIsAView(): void {
  let mut store: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defs: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut syms: Analyzer::SymbolTable = Analyzer::SymbolTable::init();

  let idI32: Analyzer::TypeId = store.intern(Analyzer::Type::I32);
  let idRef: Analyzer::TypeId = store.reference(idI32);

  let mut somePayload: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  somePayload.push(idRef);

  let mut payloads: Vector<Vector<Analyzer::TypeId>> = Vector::new<Vector<Analyzer::TypeId>>();
  payloads.push(somePayload);
  payloads.push(Vector::new<Analyzer::TypeId>());

  let defId: Analyzer::DefinitionId = viewTestEnumDef(&mut syms, &mut defs, &mut store, "OptRef", payloads);
  let id: Analyzer::TypeId = store.enumType(defId);

  Test::assert(Analyzer::ViewType::isView(&mut defs, &mut store, id));
}

