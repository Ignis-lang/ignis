import
  Diagnostic,
  DiagnosticBag,
  DiagnosticCode,
  LabelKind,
  Severity,
  SourceSpan,
from "@compiler::diagnostics";
import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import HashSet from "std::collections";

/// Generic bound checking: every type argument has to satisfy the bounds of
/// the type parameter it binds.
///
/// The pass reads lowered HIR rather than the typechecker's many call paths,
/// because HIR is where every instantiation has settled: a call node carries
/// its effective type arguments, written or inferred, and every node carries
/// its resolved type, so a generic record or enum instantiated anywhere shows
/// up as an `Instance` type. Type parameters are still visible here, which is
/// what lets a generic body be judged by its own bounds instead of by each
/// later instantiation.
///
/// A bound is satisfied in one of three ways:
///   - by a type parameter that declares the same bound itself,
///   - structurally, for the traits the compiler can judge from a type's
///     shape: `Copy` through the Copy classification, and `Eq` and `Hash` for
///     the integer primitives, `boolean`, `char` and `str`, which have no
///     declaration to write `@implements` on, and `Send` and `Sync` for
///     every type through `Typecheck::isThreadSafeType`,
///   - nominally, by a record or enum whose `@implements` names the trait.
///
/// A function type passed to a `Send` or `Sync` bound at a call is left to
/// `checkClosureCaptures`, which judges the argument by what it captures.
///
/// Bounds are held as the written trait name, so they are matched by name.
export namespace Bounds {
  /// Checks the function bodies `hir` gained from body index `firstBody` on.
  ///
  /// Runs on one module's bodies right after lowering and before closure
  /// conversion, while each closure body is still part of the function that
  /// declares it and so sees that function's type parameters.
  function checkBodies(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    firstBody: u64,
  ): DiagnosticBag {
    let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
    let mut index: u64 = firstBody;

    while (index < hir.functionBodies.length()) {
      let Option::SOME(enclosing) = hir.functionBodies.keyAt(index) else {
        index += 1;
        continue;
      };
      let Option::SOME(bodyId) = hir.functionBodies.valueAt(index) else {
        index += 1;
        continue;
      };

      Bounds::checkBody(defStore, typeStore, symbols, hir, enclosing, bodyId, &mut diagnostics);
      index += 1;
    }

    return diagnostics;
  }

  /// Checks the closures passed where a type parameter bounded by `Send` or
  /// `Sync`, or a `@sendable` parameter, is expected, in the function bodies `hir` gained from body index
  /// `firstBody` on.
  ///
  /// Runs after capture analysis, the first point where a closure knows what
  /// it captures. A closure's thunk takes the closure's body as its own, so
  /// a node is judged once, from the first body that reaches it: the function
  /// that declares the closure, whose type parameters are still in scope.
  function checkClosureCaptures(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    firstBody: u64,
  ): DiagnosticBag {
    let mut diagnostics: DiagnosticBag = DiagnosticBag::init();
    let mut visited: HashSet<u32> = HashSet::new<u32>();
    let mut index: u64 = firstBody;

    while (index < hir.functionBodies.length()) {
      let Option::SOME(enclosing) = hir.functionBodies.keyAt(index) else {
        index += 1;
        continue;
      };
      let Option::SOME(bodyId) = hir.functionBodies.valueAt(index) else {
        index += 1;
        continue;
      };

      let scope: Vector<Analyzer::DefinitionId> = Analyzer::Typecheck::typeParamsInScope(defStore, enclosing);
      let mut pending: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
      pending.push(bodyId);

      while (pending.length() > 0) {
        let Option::SOME(nodeId) = pending.pop() else {
          break;
        };

        if (!visited.insert(nodeId.raw())) {
          continue;
        }

        let Option::SOME(node) = hir.get(nodeId) else {
          continue;
        };

        let mut callee: Option<Analyzer::DefinitionId> = Option::NONE;
        let mut typeArgs: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
        let mut args: Vector<Hir::HirId> = Vector::new<Hir::HirId>();

        match (&node.kind) {
          Hir::HirKind::Call(call) -> {
            callee = Option::SOME(call.callee);
            typeArgs = Analyzer::TypeBounds::copyTypeIds(&call.typeArgs);
            args = Bounds::copyHirIds(&call.args);
          },
          Hir::HirKind::MethodCall(call) -> {
            callee = Option::SOME(call.method);
            typeArgs = Analyzer::TypeBounds::copyTypeIds(&call.typeArgs);
            args = Bounds::copyHirIds(&call.args);
          },
          _ -> {},
        };

        let children: Vector<Hir::HirId> = Hir::childIds(&node.kind);
        let mut childIndex: u64 = children.length();

        while (childIndex > 0) {
          childIndex -= 1;

          if (let Option::SOME(child) = children.get(childIndex)) {
            pending.push(*child);
          }
        }

        if (let Option::SOME(calleeDefId) = callee) {
          Bounds::checkThreadSafeArguments(defStore, typeStore, symbols, hir, &scope, calleeDefId, &typeArgs, &args, node.span, &mut diagnostics);
          Bounds::checkSendableArguments(defStore, typeStore, symbols, hir, &scope, calleeDefId, &args, &mut diagnostics);
        }
      }

      index += 1;
    }

    return diagnostics;
  }

  /// Judges the function-typed arguments a call binds to a type parameter
  /// bounded by `Send` or `Sync`: a closure literal by its captures, a named
  /// function as having nothing to capture, and any other function value as
  /// unknowable. A bounded parameter bound to a function type with no value
  /// parameter of exactly that type cannot be judged either.
  function checkThreadSafeArguments(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    scope: &Vector<Analyzer::DefinitionId>,
    calleeDefId: Analyzer::DefinitionId,
    typeArgs: &Vector<Analyzer::TypeId>,
    args: &Vector<Hir::HirId>,
    span: SourceSpan,
    diagnostics: &mut DiagnosticBag,
  ): void {
    if (typeArgs.length() == 0) {
      return;
    }

    let mut typeParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut valueParams: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut ownerOpt: Option<Analyzer::DefinitionId> = Option::NONE;

    match (defStore.get(calleeDefId)) {
      Option::SOME(Analyzer::Definition::Function(function_)) -> {
        typeParams = Analyzer::TypeBounds::copyDefinitionIds(&function_.typeParams);
        valueParams = Analyzer::TypeBounds::copyDefinitionIds(&function_.params);
      },
      Option::SOME(Analyzer::Definition::Method(method)) -> {
        typeParams = Analyzer::TypeBounds::copyDefinitionIds(&method.typeParams);
        valueParams = Analyzer::TypeBounds::copyDefinitionIds(&method.params);
        ownerOpt = Option::SOME(method.owner);
      },
      _ -> {},
    };

    if (typeParams.length() == 0) {
      if (let Option::SOME(ownerDefId) = ownerOpt) {
        typeParams = Analyzer::TypeBounds::declaredTypeParams(defStore, ownerDefId);
      }
    }

    if (typeParams.length() != typeArgs.length()) {
      return;
    }

    // A method's parameter list may lead with its receiver, which the call
    // keeps apart from its arguments.
    let mut paramOffset: u64 = 0;

    if (valueParams.length() > args.length()) {
      paramOffset = valueParams.length() - args.length();
    }

    let mut index: u64 = 0;

    while (index < typeParams.length()) {
      let Option::SOME(typeParamDefId) = typeParams.get(index) else {
        index += 1;
        continue;
      };
      let Option::SOME(typeArg) = typeArgs.get(index) else {
        index += 1;
        continue;
      };

      let mut paramSymbol: Option<Analyzer::SymbolId> = Option::NONE;
      let mut requiresSend: boolean = false;
      let mut requiresSync: boolean = false;

      if (let Option::SOME(Analyzer::Definition::TypeParam(typeParam)) = defStore.get(*typeParamDefId)) {
        paramSymbol = Option::SOME(typeParam.name);
        requiresSend = Analyzer::TypeBounds::containsName(&typeParam.bounds, "Send");
        requiresSync = Analyzer::TypeBounds::containsName(&typeParam.bounds, "Sync");
      }

      let Option::SOME(symbol) = paramSymbol else {
        index += 1;
        continue;
      };

      if ((!requiresSend && !requiresSync) || !Analyzer::TypeBounds::isFunctionType(defStore, typeStore, *typeArg)) {
        index += 1;
        continue;
      }

      let mut judged: boolean = false;
      let mut argIndex: u64 = 0;

      while (argIndex < args.length()) {
        let Option::SOME(argId) = args.get(argIndex) else {
          argIndex += 1;
          continue;
        };
        let Option::SOME(valueParam) = valueParams.get(argIndex + paramOffset) else {
          argIndex += 1;
          continue;
        };

        if (Bounds::isParamType(defStore, typeStore, *valueParam, symbol)) {
          judged = true;

          if (requiresSend) {
            let target: String = `${Bounds::symbolName(symbols, symbol)}: Send`;
            Bounds::checkFunctionArgument(defStore, typeStore, symbols, hir, scope, calleeDefId, target.toStr(), *argId, false, diagnostics);
          }

          if (requiresSync) {
            let target: String = `${Bounds::symbolName(symbols, symbol)}: Sync`;
            Bounds::checkFunctionArgument(defStore, typeStore, symbols, hir, scope, calleeDefId, target.toStr(), *argId, true, diagnostics);
          }
        }

        argIndex += 1;
      }

      if (!judged) {
        let bound: str = Analyzer::Typecheck::threadSafetyTraitName(requiresSync && !requiresSend);
        let target: String = `${Bounds::symbolName(symbols, symbol)}: ${bound}`;
        Bounds::reportFunctionValue(defStore, symbols, calleeDefId, target.toStr(), span, diagnostics);
      }

      index += 1;
    }
  }

  /// Judges the arguments a call passes to `@sendable` parameters with the
  /// `Send` closure rules.
  function checkSendableArguments(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    scope: &Vector<Analyzer::DefinitionId>,
    calleeDefId: Analyzer::DefinitionId,
    args: &Vector<Hir::HirId>,
    diagnostics: &mut DiagnosticBag,
  ): void {
    let valueParams: Vector<Analyzer::DefinitionId> = match (defStore.get(calleeDefId)) {
      Option::SOME(Analyzer::Definition::Function(function_)) -> Analyzer::TypeBounds::copyDefinitionIds(&function_.params),
      Option::SOME(Analyzer::Definition::Method(method)) -> Analyzer::TypeBounds::copyDefinitionIds(&method.params),
      _ -> Vector::new<Analyzer::DefinitionId>(),
    };

    // A method's parameter list may lead with its receiver, which the call
    // keeps apart from its arguments.
    let mut paramOffset: u64 = 0;

    if (valueParams.length() > args.length()) {
      paramOffset = valueParams.length() - args.length();
    }

    let mut argIndex: u64 = 0;

    while (argIndex < args.length()) {
      if (let Option::SOME(valueParam) = valueParams.get(argIndex + paramOffset)) {
        if (defStore.isSendable(*valueParam)) {
          if (let Option::SOME(argId) = args.get(argIndex)) {
            let target: String = `@sendable ${Bounds::definitionName(defStore, symbols, *valueParam)}`;
            Bounds::checkFunctionArgument(defStore, typeStore, symbols, hir, scope, calleeDefId, target.toStr(), *argId, false, diagnostics);
          }
        }
      }

      argIndex += 1;
    }
  }

  /// Judges one function-typed argument against `Send` (`sync` false) or
  /// `Sync` (`sync` true). `target` names what the argument is passed as.
  function checkFunctionArgument(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    scope: &Vector<Analyzer::DefinitionId>,
    calleeDefId: Analyzer::DefinitionId,
    target: str,
    argId: Hir::HirId,
    sync: boolean,
    diagnostics: &mut DiagnosticBag,
  ): void {
    let Option::SOME(argNode) = hir.get(argId) else {
      return;
    };

    // A function pointer has no environment, so it is always Send and Sync.
    if (let Option::SOME(Analyzer::Type::RawFunction(_)) = typeStore.get(argNode.typeId)) {
      return;
    }

    let argSpan: SourceSpan = argNode.span;

    match (&argNode.kind) {
      Hir::HirKind::Closure(closure) -> {
        let mut captureIndex: u64 = 0;

        while (captureIndex < closure.captures.length()) {
          let Option::SOME(capture) = closure.captures.get(captureIndex) else {
            captureIndex += 1;
            continue;
          };
          let Option::SOME(capturedType) = Hir::declaredTypeOf(defStore, capture.sourceDef) else {
            captureIndex += 1;
            continue;
          };

          // A value moved into the closure has to be Send; one the closure
          // reads through a shared reference has to be Sync, since both
          // threads can reach it. A Sync closure is shared as a whole, so
          // everything it holds has to be Sync, and it may not mutate what
          // it captured: several threads can run it at once.
          let mut requiredSync: boolean = sync;
          let mut access: str = "by value";

          match (capture.mode) {
            Hir::CaptureMode::ByValue -> {},
            Hir::CaptureMode::ByRef -> {
              requiredSync = true;
              access = "by reference";
            },
            Hir::CaptureMode::ByMutRef -> {
              access = "by mutable reference";
            },
          };

          if (sync && capture.mode == Hir::CaptureMode::ByMutRef) {
            let name: str = Bounds::definitionName(defStore, symbols, capture.sourceDef);
            let message: String = `closure passed as '${target}' captures '${name}' by mutable reference, and a closure shared between threads may not mutate what it captures`;
            let label: String = `'${name}' is mutated through the capture`;

            let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::CLOSURE_CAPTURE_NOT_THREAD_SAFE, message.toStr(), argSpan);
            diagnostic.addLabel(LabelKind::PRIMARY, argSpan, label.toStr());

            let mut bag: &mut DiagnosticBag = diagnostics;
            bag.push(diagnostic);
            captureIndex += 1;
            continue;
          }

          let mut visitedTypes: Vector<u32> = Vector::new<u32>();

          if (!Analyzer::Typecheck::isThreadSafeType(defStore, typeStore, capturedType, requiredSync, scope, &mut visitedTypes)) {
            let name: str = Bounds::definitionName(defStore, symbols, capture.sourceDef);
            let typeName: String = typeStore.nameOfResolved(capturedType, &*defStore, &*symbols);
            let required: str = Analyzer::Typecheck::threadSafetyTraitName(requiredSync);
            let message: String = `closure passed as '${target}' captures '${name}' ${access}, and '${typeName.toStr()}' is not ${required}`;
            let label: String = `'${name}' is captured here`;

            let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::CLOSURE_CAPTURE_NOT_THREAD_SAFE, message.toStr(), argSpan);
            diagnostic.addLabel(LabelKind::PRIMARY, argSpan, label.toStr());

            let mut bag: &mut DiagnosticBag = diagnostics;
            bag.push(diagnostic);
          }

          captureIndex += 1;
        }
      },
      Hir::HirKind::Variable(defId) -> {
        // A `@sendable` parameter forwarded as is was judged where its own
        // caller passed it.
        if (!Bounds::isNamedFunction(defStore, defId) && !defStore.isSendable(defId)) {
          Bounds::reportFunctionValue(defStore, symbols, calleeDefId, target, argSpan, diagnostics);
        }
      },
      Hir::HirKind::StaticAccess(defId) -> {
        if (!Bounds::isNamedFunction(defStore, defId)) {
          Bounds::reportFunctionValue(defStore, symbols, calleeDefId, target, argSpan, diagnostics);
        }
      },
      _ -> {
        Bounds::reportFunctionValue(defStore, symbols, calleeDefId, target, argSpan, diagnostics);
      },
    };
  }

  function reportFunctionValue(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    calleeDefId: Analyzer::DefinitionId,
    target: str,
    span: SourceSpan,
    diagnostics: &mut DiagnosticBag,
  ): void {
    let mut calleeName: str = "?";

    if (let Option::SOME(definition) = defStore.get(calleeDefId)) {
      if (let Option::SOME(name) = symbols.resolve(definition.name())) {
        calleeName = name;
      }
    }

    let message: String = `function value passed as '${target}' of '${calleeName}' cannot be checked: only a closure written at the call or a named function shows what it captures`;

    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::FUNCTION_VALUE_NOT_THREAD_SAFE, message.toStr(), span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, "pass a closure literal or a named function here");

    let mut bag: &mut DiagnosticBag = diagnostics;
    bag.push(diagnostic);
  }

  function isNamedFunction(
    defStore: &mut Analyzer::DefinitionStore,
    defId: Analyzer::DefinitionId
  ): boolean {
    return match (defStore.get(defId)) {
      Option::SOME(Analyzer::Definition::Function(_)) | Option::SOME(Analyzer::Definition::Method(_)) -> true,
      _ -> false,
    };
  }

  function definitionName(
    defStore: &mut Analyzer::DefinitionStore,
    symbols: &mut Analyzer::SymbolTable,
    defId: Analyzer::DefinitionId,
  ): str {
    if (let Option::SOME(definition) = defStore.get(defId)) {
      if (let Option::SOME(name) = symbols.resolve(definition.name())) {
        return name;
      }
    }

    return "?";
  }

  function symbolName(symbols: &mut Analyzer::SymbolTable, symbol: Analyzer::SymbolId): str {
    if (let Option::SOME(name) = symbols.resolve(symbol)) {
      return name;
    }

    return "?";
  }

  /// Whether the value parameter is declared with exactly the type parameter
  /// named `symbol` as its type.
  function isParamType(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    valueParam: Analyzer::DefinitionId,
    symbol: Analyzer::SymbolId,
  ): boolean {
    let Option::SOME(declared) = Hir::declaredTypeOf(defStore, valueParam) else {
      return false;
    };

    return match (typeStore.get(declared)) {
      Option::SOME(Analyzer::Type::Param(paramSymbol)) -> paramSymbol.raw() == symbol.raw(),
      _ -> false,
    };
  }

  /// Walks one body in source order. A type that fails is reported once per
  /// body, at its first node, rather than at every expression that has it.
  function checkBody(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    hir: &Hir::HirStore,
    enclosing: Analyzer::DefinitionId,
    bodyId: Hir::HirId,
    diagnostics: &mut DiagnosticBag,
  ): void {
    let mut checkedTypes: HashSet<u32> = HashSet::new<u32>();
    let mut pending: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    pending.push(bodyId);

    while (pending.length() > 0) {
      let Option::SOME(nodeId) = pending.pop() else {
        break;
      };
      let Option::SOME(node) = hir.get(nodeId) else {
        continue;
      };

      let span: SourceSpan = node.span;
      let mut types: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
      types.push(node.typeId);

      let mut callee: Option<Analyzer::DefinitionId> = Option::NONE;
      let mut typeArgs: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();

      match (&node.kind) {
        Hir::HirKind::Call(call) -> {
          callee = Option::SOME(call.callee);
          typeArgs = Analyzer::TypeBounds::copyTypeIds(&call.typeArgs);
        },
        Hir::HirKind::MethodCall(call) -> {
          callee = Option::SOME(call.method);
          typeArgs = Analyzer::TypeBounds::copyTypeIds(&call.typeArgs);
        },
        Hir::HirKind::Let(letNode) -> {
          if (let Option::SOME(Analyzer::Definition::Variable(variable)) = defStore.get(letNode.name)) {
            types.push(variable.declaredType);
          }
        },
        _ -> {},
      };

      let children: Vector<Hir::HirId> = Hir::childIds(&node.kind);
      let mut childIndex: u64 = children.length();

      while (childIndex > 0) {
        childIndex -= 1;

        if (let Option::SOME(child) = children.get(childIndex)) {
          pending.push(*child);
        }
      }

      if (let Option::SOME(calleeDefId) = callee) {
        Bounds::checkCall(defStore, typeStore, symbols, enclosing, calleeDefId, &typeArgs, span, diagnostics);
      }

      let mut typeIndex: u64 = 0;

      while (typeIndex < types.length()) {
        if (let Option::SOME(typeId) = types.get(typeIndex)) {
          if (checkedTypes.insert(typeId.raw())) {
            Analyzer::TypeBounds::checkType(defStore, typeStore, symbols, enclosing, *typeId, span, diagnostics);
          }
        }

        typeIndex += 1;
      }
    }
  }

  /// Checks a call's type arguments against the callee's type parameters: a
  /// method's own, or its owner's when it declares none, which is what
  /// `Type::staticMethod<T>()` on a generic declaration binds. A count that
  /// does not match was already reported by the typechecker.
  function checkCall(
    defStore: &mut Analyzer::DefinitionStore,
    typeStore: &mut Analyzer::TypeStore,
    symbols: &mut Analyzer::SymbolTable,
    enclosing: Analyzer::DefinitionId,
    calleeDefId: Analyzer::DefinitionId,
    typeArgs: &Vector<Analyzer::TypeId>,
    span: SourceSpan,
    diagnostics: &mut DiagnosticBag,
  ): void {
    if (typeArgs.length() == 0) {
      return;
    }

    let mut params: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
    let mut ownerOpt: Option<Analyzer::DefinitionId> = Option::NONE;

    if (let Option::SOME(definition) = defStore.get(calleeDefId)) {
      match (definition) {
        Analyzer::Definition::Function(function_) -> {
          params = Analyzer::TypeBounds::copyDefinitionIds(&function_.typeParams);
        },
        Analyzer::Definition::Method(method) -> {
          params = Analyzer::TypeBounds::copyDefinitionIds(&method.typeParams);
          ownerOpt = Option::SOME(method.owner);
        },
        _ -> {},
      };
    }

    if (params.length() == 0) {
      if (let Option::SOME(ownerDefId) = ownerOpt) {
        params = Analyzer::TypeBounds::declaredTypeParams(defStore, ownerDefId);
      }
    }

    if (params.length() != typeArgs.length()) {
      return;
    }

    Analyzer::TypeBounds::checkArguments(defStore, typeStore, symbols, enclosing, calleeDefId, &params, typeArgs, true, span, diagnostics);
  }

  function copyHirIds(source: &Vector<Hir::HirId>): Vector<Hir::HirId> {
    let mut copy: Vector<Hir::HirId> = Vector::new<Hir::HirId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(entry) = source.get(index)) {
        copy.push(*entry);
      }

      index += 1;
    }

    return copy;
  }
}
