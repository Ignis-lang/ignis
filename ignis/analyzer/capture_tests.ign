import Test from "std::test";

import DiagnosticBag, DiagnosticCode, Severity, SourceFile, SourceMap from "@compiler::diagnostics";
import Analyzer from "@compiler::analyzer";
import Hir from "@compiler::hir";
import ParseOutput, Parser from "@compiler::parser";
import Lowering from "./lowering";
import Capture from "./capture";

function captureCountErrors(bag: &DiagnosticBag): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity == Severity::ERROR) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

/// Run `source` through parse, analysis, HIR lowering and capture analysis,
/// and return what capture analysis reported.
function captureDiagnosticsFor(source: str): DiagnosticBag {
  let mut sourceMap: SourceMap = SourceMap::new();
  let file: SourceFile = SourceFile::create(&mut sourceMap, "capture_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(captureCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(captureCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(captureCountErrors(&output.diagnostics), 0);

  let mut hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  return Capture::populateClosureCaptures(&mut defStore, &mut typeStore, &mut symbols, &mut hir);
}

/// Assert that `bag` carries `code` with exactly `message`.
function captureAssertDiagnostic(bag: &DiagnosticBag, code: str, message: str): void {
  let expectedCode: String = String::create(code);
  let expectedMessage: String = String::create(message);
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (expectedCode.equals(diagnostic.code) && expectedMessage.equals(diagnostic.messageText())) {
      return;
    }

    index += 1;
  }

  @panic("captureAssertDiagnostic: no diagnostic with the expected code and message");
}

/// Scenario: a closure returned out of the function that defines it, holding
/// a reference to that function's local. The reference outlives the frame it
/// points into.
@test
function captureRejectsReturnedClosureHoldingARefCapture(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function makeCounter(): () -> i32 {\n  let mut count: i32 = 0;\n  let inc = (): i32 -> {\n    count = count + 1;\n    return count;\n  };\n  return inc;\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::CLOSURE_ESCAPES_WITH_REF_CAPTURE,
    "closure escapes its scope while capturing `count` by reference",
  );
}

/// Scenario: the same closure handed to a parameter that is not `@noescape`,
/// so the callee may keep it.
@test
function captureRejectsEscapingClosureArgumentHoldingARefCapture(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function apply(f: (i32) -> i32, x: i32): i32 {\n  return f(x);\n}\n\nfunction main(): i32 {\n  let mut val: i32 = 10;\n  let inc = (n: i32): i32 -> {\n    val = val + 1;\n    return n + val;\n  };\n  return apply(inc, 5);\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::CLOSURE_ESCAPES_WITH_REF_CAPTURE,
    "closure escapes its scope while capturing `val` by reference",
  );
}

/// Scenario: the same closure handed to a `@noescape` parameter, which cannot
/// outlive the call, so the reference capture stays sound.
@test
function captureAcceptsRefCaptureThroughANoescapeParameter(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function apply(@noescape f: (i32) -> i32, x: i32): i32 {\n  return f(x);\n}\n\nfunction main(): i32 {\n  let mut val: i32 = 10;\n  let inc = (n: i32): i32 -> {\n    val = val + 1;\n    return n + val;\n  };\n  return apply(inc, 5);\n}\n",
  );

  Test::assertEq<u64>(captureCountErrors(&bag), 0);
}

/// Run `source` through parse, analysis, HIR lowering and capture analysis,
/// then answer whether the `let` binding named `bindingName` owns the closure
/// environment its initializer produces, as `Hir::bindingOwnsClosureEnv` decides.
function captureLetOwnsClosureEnv(source: str, bindingName: str): boolean {
  let mut sourceMap: SourceMap = SourceMap::new();
  let file: SourceFile = SourceFile::create(&mut sourceMap, "capture_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(captureCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(captureCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(captureCountErrors(&output.diagnostics), 0);

  let mut hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let captureBag: DiagnosticBag = Capture::populateClosureCaptures(&mut defStore, &mut typeStore, &mut symbols, &mut hir);
  Test::assertEq<u64>(captureCountErrors(&captureBag), 0);

  let expectedName: String = String::create(bindingName);
  let mut nodeIndex: u64 = 0;

  while (nodeIndex < hir.nodes.length()) {
    let mut letName: Option<Analyzer::DefinitionId> = Option::NONE;
    let mut letValue: Option<Hir::HirId> = Option::NONE;

    if (let Option::SOME(node) = hir.nodes.get(nodeIndex)) {
      if (let Hir::HirKind::Let(letNode) = &node.kind) {
        letName = Option::SOME(letNode.name);
        letValue = letNode.value;
      }
    }

    if (let Option::SOME(nameDef) = letName) {
      if (let Option::SOME(valueId) = letValue) {
        let mut matchesName: boolean = false;
        let mut valueType: Option<Analyzer::TypeId> = Option::NONE;

        if (let Option::SOME(definition) = defStore.get(nameDef)) {
          if (let Option::SOME(resolved) = symbols.resolve(definition.name())) {
            matchesName = expectedName.equals(resolved);
          }

          if (let Analyzer::Definition::Variable(variableDef) = definition) {
            valueType = Option::SOME(variableDef.declaredType);
          }
        }

        if (matchesName) {
          let Option::SOME(declaredType) = valueType else {
            @panic("captureLetOwnsClosureEnv: the binding is not a variable");
          };

          return Hir::bindingOwnsClosureEnv(&hir, valueId, declaredType, &mut typeStore, &mut defStore);
        }
      }
    }

    nodeIndex += 1;
  }

  @panic("captureLetOwnsClosureEnv: no let binding with the expected name");
}

/// Scenario: every arm of the `match` is a closure literal, so the binding
/// that receives the chosen closure owns its environment.
@test
function captureBindingOwnsClosureChosenByMatchOfLiterals(): void {
  Test::assert(captureLetOwnsClosureEnv(
    "function pick(flag: boolean, a: i32): (i32) -> i32 {\n  let chosen = match (flag) {\n    true -> (x: i32): i32 -> x + a,\n    false -> (x: i32): i32 -> x - a,\n  };\n  return chosen;\n}\n",
    "chosen",
  ));
}

/// Scenario: one arm diverges and the other is a closure literal. The
/// diverging arm produces no value, so the binding still owns the environment.
@test
function captureBindingOwnsClosureChosenBesideADivergingArm(): void {
  Test::assert(captureLetOwnsClosureEnv(
    "function pick(flag: i32, a: i32): (i32) -> i32 {\n  let chosen = match (flag) {\n    0 -> (x: i32): i32 -> x + a,\n    _ -> {\n      return (x: i32): i32 -> x - a;\n    },\n  };\n  return chosen;\n}\n",
    "chosen",
  ));
}

/// Scenario: one arm yields an existing closure binding and the other a
/// literal. The existing binding already owns its environment, so the chosen
/// binding must not claim it too, which would free it twice.
@test
function captureBindingDoesNotOwnClosureMixedWithAnExistingBinding(): void {
  Test::assert(!captureLetOwnsClosureEnv(
    "function pick(flag: boolean, a: i32): (i32) -> i32 {\n  let existing = (x: i32): i32 -> x + a;\n  let chosen = match (flag) {\n    true -> existing,\n    false -> (x: i32): i32 -> x - a,\n  };\n  return chosen;\n}\n",
    "chosen",
  ));
}

/// Run `source` through parse, analysis, HIR lowering and capture analysis,
/// and count the closure literals whose environment escapes to the heap.
function captureEscapingClosureCount(source: str): u64 {
  let mut sourceMap: SourceMap = SourceMap::new();
  let file: SourceFile = SourceFile::create(&mut sourceMap, "capture_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(captureCountErrors(&parsed.lexDiagnostics), 0);
  Test::assertEq<u64>(captureCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(captureCountErrors(&output.diagnostics), 0);

  let mut hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let captureBag: DiagnosticBag = Capture::populateClosureCaptures(&mut defStore, &mut typeStore, &mut symbols, &mut hir);
  Test::assertEq<u64>(captureCountErrors(&captureBag), 0);

  let mut count: u64 = 0;
  let mut nodeIndex: u64 = 0;

  while (nodeIndex < hir.nodes.length()) {
    if (let Option::SOME(node) = hir.nodes.get(nodeIndex)) {
      if (let Hir::HirKind::Closure(closure) = &node.kind) {
        if (closure.escapes) {
          count += 1;
        }
      }
    }

    nodeIndex += 1;
  }

  return count;
}

/// Scenario: a closure built in a loop body and assigned to a binding declared
/// before the loop. The next iteration builds the closure again while the
/// binding still holds the previous one, so one stack environment per site
/// would be overwritten under a live closure.
@test
function captureClosureAssignedOutsideItsLoopEscapes(): void {
  Test::assertEq<u64>(
    captureEscapingClosureCount(
      "function main(): i32 {\n  let mut current = (): i32 -> 0;\n  let mut index: i32 = 0;\n  while (index < 3) {\n    let value: i32 = index;\n    current = (): i32 -> value;\n    index = index + 1;\n  }\n  return current();\n}\n",
    ),
    1,
  );
}

/// Scenario: a closure built inside another closure's body and assigned to a
/// binding the outer closure captured. The inner environment would live in
/// the thunk's frame, which ends before the binding is called.
@test
function captureClosureAssignedOutsideItsClosureBodyEscapes(): void {
  Test::assertEq<u64>(
    captureEscapingClosureCount(
      "function main(): i32 {\n  let mut current = (): i32 -> 0;\n  let mut install = (id: i32): void -> {\n    current = (): i32 -> id;\n  };\n  install(5);\n  return current();\n}\n",
    ),
    1,
  );
}

/// Scenario: a closure bound and called inside the loop body. The binding ends
/// with the iteration, so its stack environment is never overwritten while live.
@test
function captureClosureBoundInsideItsLoopStaysOnTheStack(): void {
  Test::assertEq<u64>(
    captureEscapingClosureCount(
      "function main(): i32 {\n  let mut total: i32 = 0;\n  let mut index: i32 = 0;\n  while (index < 3) {\n    let value: i32 = index;\n    let read = (): i32 -> value;\n    total = total + read();\n    index = index + 1;\n  }\n  return total;\n}\n",
    ),
    0,
  );
}

/// Scenario: a closure assigned to a binding outside its loop that mutates a
/// counter declared before the loop. Its environment moves to the heap, but the
/// closure stays inside the frame, and so does the counter it refers to.
@test
function captureAcceptsRefCaptureOfABindingDeclaredBeforeTheLoop(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function main(): i32 {\n  let mut count: i32 = 0;\n  let mut bump = (): void -> {};\n  let mut index: i32 = 0;\n  while (index < 3) {\n    bump = (): void -> {\n      count = count + 1;\n    };\n    bump();\n    index = index + 1;\n  }\n  return count;\n}\n",
  );

  Test::assertEq<u64>(captureCountErrors(&bag), 0);
}

/// Scenario: the same closure referring to a counter declared inside the loop.
/// The counter ends with the iteration while the binding still holds the
/// closure.
@test
function captureRejectsRefCaptureOfABindingDeclaredInTheLoop(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function main(): i32 {\n  let mut bump = (): void -> {};\n  let mut index: i32 = 0;\n  while (index < 3) {\n    let mut hits: i32 = 0;\n    bump = (): void -> {\n      hits = hits + 1;\n    };\n    bump();\n    index = index + 1;\n  }\n  return 0;\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::CLOSURE_ESCAPES_WITH_REF_CAPTURE,
    "closure escapes its scope while capturing `hits` by reference",
  );
}

/// Scenario: a closure built in another closure's body, assigned outside it,
/// that refers to a local of that body. The local ends with the call.
@test
function captureRejectsRefCaptureOfALocalOfTheBuildingClosure(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function main(): i32 {\n  let mut current = (): void -> {};\n  let mut install = (): void -> {\n    let mut local: i32 = 0;\n    current = (): void -> {\n      local = local + 1;\n    };\n  };\n  install();\n  return 0;\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::CLOSURE_ESCAPES_WITH_REF_CAPTURE,
    "closure escapes its scope while capturing `local` by reference",
  );
}

/// Scenario: the same inner closure referring to a counter declared outside
/// the building closure. Inside the thunk that reference can name a copy the
/// outer closure captured, which ends with the call, so it is rejected too.
@test
function captureRejectsRefCaptureFromAClosureBuiltInAClosureBody(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function main(): i32 {\n  let mut count: i32 = 0;\n  let mut bump = (): void -> {};\n  let mut install = (): void -> {\n    bump = (): void -> {\n      count = count + 10;\n    };\n  };\n  install();\n  return count;\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::CLOSURE_ESCAPES_WITH_REF_CAPTURE,
    "closure escapes its scope while capturing `count` by reference",
  );
}

/// Scenario: a closure that escapes an inner loop and mutates a counter of the
/// outer loop, captured by a closure that escapes the outer loop. Its lifetime
/// now follows the capturing closure, past the counter's iteration.
@test
function captureRejectsRefCaptureInAClosureHeldByAnEscapingClosure(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function main(): i32 {\n  let mut g = (): i32 -> 0;\n  let mut i: i32 = 0;\n  while (i < 2) {\n    let mut x: i32 = 0;\n    let mut f = (): i32 -> 0;\n    let mut j: i32 = 0;\n    while (j < 2) {\n      f = (): i32 -> {\n        x = x + 1;\n        return x;\n      };\n      j = j + 1;\n    }\n    g = (): i32 -> f();\n    i = i + 1;\n  }\n  return g();\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::CLOSURE_ESCAPES_WITH_REF_CAPTURE,
    "closure escapes its scope while capturing `x` by reference",
  );
}

/// Scenario: a closure bound in the loop, captured by a closure that escapes
/// the loop, mutating a counter declared before the loop. It lives as long as
/// the capturing closure, inside the frame, and so does the counter.
@test
function captureAcceptsOuterRefCaptureInAClosureHeldByALoopEscapingClosure(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function main(): i32 {\n  let mut x: i32 = 0;\n  let mut g = (): void -> {};\n  let mut i: i32 = 0;\n  while (i < 2) {\n    let f = (): void -> {\n      x = x + 1;\n    };\n    g = (): void -> {\n      f();\n    };\n    i = i + 1;\n  }\n  g();\n  return x;\n}\n",
  );

  Test::assertEq<u64>(captureCountErrors(&bag), 0);
}

/// Scenario: a closure that escapes a loop inside a closure body, captured by
/// a closure that escapes that body. It outlives the call, and the local it
/// refers to with it.
@test
function captureRejectsRefCaptureInAClosureHeldByAClosureBodyEscapingClosure(): void {
  let bag: DiagnosticBag = captureDiagnosticsFor(
    "function main(): i32 {\n  let mut g = (): void -> {};\n  let h = (): void -> {\n    let mut y: i32 = 0;\n    let mut f = (): void -> {};\n    let mut i: i32 = 0;\n    while (i < 2) {\n      f = (): void -> {\n        y = y + 1;\n      };\n      i = i + 1;\n    }\n    g = (): void -> {\n      f();\n    };\n  };\n  h();\n  g();\n  return 0;\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::CLOSURE_ESCAPES_WITH_REF_CAPTURE,
    "closure escapes its scope while capturing `y` by reference",
  );
}

/// Analyze and lower `source` as one more module into the shared stores, then
/// run the per-module capture pass over what it added. Returns the first node
/// id the module lowered.
function captureAddModule(
  defStore: &mut Analyzer::DefinitionStore,
  typeStore: &mut Analyzer::TypeStore,
  symbols: &mut Analyzer::SymbolTable,
  hir: &mut Hir::HirStore,
  fileName: str,
  source: str,
): u64 {
  let mut sourceMap: SourceMap = SourceMap::new();
  let file: SourceFile = SourceFile::create(&mut sourceMap, fileName, source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(captureCountErrors(&parsed.parseDiagnostics), 0);

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(defStore, typeStore, symbols, &parsed.module);
  Test::assertEq<u64>(captureCountErrors(&output.diagnostics), 0);

  let nodeStart: u64 = hir.nodes.length();
  Lowering::lowerModuleInto(defStore, typeStore, symbols, &parsed.module, &output, hir);

  let captureBag: DiagnosticBag = Capture::populateModuleClosureCaptures(defStore, typeStore, symbols, hir, nodeStart);
  Test::assertEq<u64>(captureCountErrors(&captureBag), 0);

  return nodeStart;
}

/// The thunk names of the closure nodes `nodeStart..nodeEnd`, in node order.
function captureThunkNamesIn(
  defStore: &Analyzer::DefinitionStore,
  symbols: &Analyzer::SymbolTable,
  hir: &Hir::HirStore,
  nodeStart: u64,
  nodeEnd: u64,
): Vector<String> {
  let mut names: Vector<String> = Vector::new<String>();
  let mut nodeIndex: u64 = nodeStart;

  while (nodeIndex < nodeEnd) {
    if (let Option::SOME(node) = hir.nodes.get(nodeIndex)) {
      if (let Hir::HirKind::Closure(closureNode) = &node.kind) {
        let mut name: String = String::create("<none>");

        if (let Option::SOME(thunkDef) = closureNode.thunkDef) {
          if (let Option::SOME(definition) = defStore.get(thunkDef)) {
            if (let Option::SOME(resolved) = symbols.resolve(definition.name())) {
              name = String::create(resolved);
            }
          }
        }

        names.push(name);
      }
    }

    nodeIndex += 1;
  }

  return names;
}

@test
function moduleCapturePassNumbersOnlyItsOwnClosures(): void {
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut hir: Hir::HirStore = Hir::HirStore::init();

  let firstStart: u64 = captureAddModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &mut hir,
    "first.ign",
    "function first(): i32 {\n  let f = (): i32 -> 1;\n  return f();\n}\n",
  );
  let secondStart: u64 = captureAddModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &mut hir,
    "second.ign",
    "function second(): i32 {\n  let g = (): i32 -> 2;\n  let h = (): i32 -> 3;\n  return g() + h();\n}\n",
  );

  let firstNames: Vector<String> = captureThunkNamesIn(&defStore, &symbols, &hir, firstStart, secondStart);
  let secondNames: Vector<String> = captureThunkNamesIn(&defStore, &symbols, &hir, secondStart, hir.nodes.length());

  // The first module's closure keeps the thunk its own pass gave it, and the
  // second module's numbering restarts at zero.
  Test::assertEq<u64>(firstNames.length(), 1);
  Test::assertEq<u64>(secondNames.length(), 2);

  if (let Option::SOME(name) = firstNames.get(0)) {
    Test::assertEq<str>(name.toStr(), "__closure_thunk_0");
  }

  if (let Option::SOME(name) = secondNames.get(0)) {
    Test::assertEq<str>(name.toStr(), "__closure_thunk_0");
  }

  if (let Option::SOME(name) = secondNames.get(1)) {
    Test::assertEq<str>(name.toStr(), "__closure_thunk_1");
  }
}

/// Run `source` through parse and analysis and return what analysis reported.
function fnPointerAnalysisDiagnostics(source: str): DiagnosticBag {
  let mut sourceMap: SourceMap = SourceMap::new();
  let file: SourceFile = SourceFile::create(&mut sourceMap, "fn_pointer_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(captureCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  return output.diagnostics;
}

/// Run `source` through parse, analysis, HIR lowering and capture analysis,
/// and return what the function pointer check reported.
function fnPointerCaptureDiagnostics(source: str): DiagnosticBag {
  let mut sourceMap: SourceMap = SourceMap::new();
  let file: SourceFile = SourceFile::create(&mut sourceMap, "fn_pointer_tests.ign", source);
  let parsed: ParseOutput = Parser::parseFile(&file);

  Test::assertEq<u64>(captureCountErrors(&parsed.parseDiagnostics), 0);

  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();

  let output: Analyzer::AnalyzerOutput = Analyzer::analyzeModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
  );

  Test::assertEq<u64>(captureCountErrors(&output.diagnostics), 0);

  let mut hir: Hir::HirStore = Lowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &parsed.module,
    &output,
  );

  let _ = Capture::populateClosureCaptures(&mut defStore, &mut typeStore, &mut symbols, &mut hir);

  return Capture::reportNonCaptureFreeRawFunctions(&mut defStore, &mut typeStore, &mut symbols, &hir);
}

/// Scenario: named functions, a static method and capture-free closure
/// literals become `fn` values, and a `fn` value is called and passed where
/// the closure type of its signature is expected.
@test
function fnPointerAcceptsCaptureFreeSourcesAndConvertsToClosures(): void {
  let source: str = "record Math {\n  static negate(value: i32): i32 {\n    return -value;\n  }\n}\n\nfunction double(value: i32): i32 {\n  return value * 2;\n}\n\nfunction apply(operation: (i32) -> i32, value: i32): i32 {\n  return operation(value);\n}\n\nfunction main(): i32 {\n  let named: fn(i32) -> i32 = double;\n  let method: fn(i32) -> i32 = Math::negate;\n  let literal: fn(i32) -> i32 = (value: i32): i32 -> value + 1;\n  let copied: fn(i32) -> i32 = literal;\n  return named(1) + method(2) + apply(copied, 3);\n}\n";

  let analysis: DiagnosticBag = fnPointerAnalysisDiagnostics(source);
  let capture: DiagnosticBag = fnPointerCaptureDiagnostics(source);

  Test::assertEq<u64>(captureCountErrors(&analysis), 0);
  Test::assertEq<u64>(captureCountErrors(&capture), 0);
}

/// Scenario: a closure-typed variable does not show what it captured, so it
/// does not convert to a `fn` type.
@test
function fnPointerRejectsAClosureTypedValue(): void {
  let bag: DiagnosticBag = fnPointerAnalysisDiagnostics(
    "function main(): i32 {\n  let closure: (i32) -> i32 = (value: i32): i32 -> value;\n  let pointer: fn(i32) -> i32 = closure;\n  return pointer(1);\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::FUNCTION_POINTER_FROM_CLOSURE_VALUE,
    "a closure value cannot be used as 'fn(i32) -> i32': its type does not show what it captured",
  );
}

/// Scenario: a closure literal that captures a local has an environment a
/// function pointer cannot hold, and the diagnostic names the capture.
@test
function fnPointerRejectsACapturingClosureLiteral(): void {
  let bag: DiagnosticBag = fnPointerCaptureDiagnostics(
    "function main(): i32 {\n  let offset: i32 = 3;\n  let shifted: fn(i32) -> i32 = (value: i32): i32 -> value + offset;\n  return shifted(1);\n}\n",
  );

  captureAssertDiagnostic(
    &bag,
    DiagnosticCode::FUNCTION_POINTER_CAPTURES,
    "a closure taken as a function pointer cannot capture 'offset'",
  );
}

/// Scenario: a function pointer type is Send and Sync, and so is a record
/// whose fields are function pointers; the closure type is neither.
@test
function fnPointerTypesAreSendAndSync(): void {
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let i32Type: Analyzer::TypeId = typeStore.intern(Analyzer::Type::I32);
  let mut pointerParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  pointerParams.push(i32Type);
  let mut closureParams: Vector<Analyzer::TypeId> = Vector::new<Analyzer::TypeId>();
  closureParams.push(i32Type);
  let pointerType: Analyzer::TypeId = typeStore.rawFunctionType(pointerParams, i32Type);
  let closureType: Analyzer::TypeId = typeStore.functionType(closureParams, i32Type);
  let scope: Vector<Analyzer::DefinitionId> = Vector::new<Analyzer::DefinitionId>();
  let mut visited: Vector<u32> = Vector::new<u32>();

  Test::assertEq<boolean>(Analyzer::Typecheck::isThreadSafeType(&mut defStore, &mut typeStore, pointerType, false, &scope, &mut visited), true);
  Test::assertEq<boolean>(Analyzer::Typecheck::isThreadSafeType(&mut defStore, &mut typeStore, pointerType, true, &scope, &mut visited), true);
  Test::assertEq<boolean>(Analyzer::Typecheck::isCopyType(&mut defStore, &mut typeStore, pointerType), true);
  Test::assertEq<boolean>(Analyzer::Typecheck::isThreadSafeType(&mut defStore, &mut typeStore, closureType, false, &scope, &mut visited), false);
  Test::assertEq<str>(typeStore.nameOf(pointerType).toStr(), "fn(i32) -> i32");
  Test::assertEq<str>(typeStore.nameOf(closureType).toStr(), "(i32) -> i32");
}

/// Scenario: a record holding `fn` fields satisfies a `Send & Sync` bound
/// structurally, while one holding a closure field does not.
@test
function fnPointerRecordFieldsSatisfySendAndSyncBounds(): void {
  let accepted: DiagnosticBag = fnPointerAnalysisDiagnostics(
    "record Handlers {\n  public run: fn(i32) -> i32;\n}\n\nrecord Shared<T: Send & Sync> {\n  public value: T;\n}\n\nfunction double(value: i32): i32 {\n  return value * 2;\n}\n\nfunction main(): i32 {\n  let shared: Shared<Handlers> = Shared { value: Handlers { run: double } };\n  return (shared.value.run)(1);\n}\n",
  );

  Test::assertEq<u64>(captureCountErrors(&accepted), 0);
}
