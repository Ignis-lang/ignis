import HashMap from "std::collections";
import Vector from "std::vector";

import _ from "./expressions";
import _ from "./items";
import _ from "./patterns";
import _ from "./statements";
import _ from "./types";

export namespace Ast {
  record Module {
    public roots: Vector<Ast::ItemId>;
    public items: Ast::Store<Ast::ItemTag, Ast::Item::Node>;
    public expressions: Ast::Store<Ast::ExpressionTag, Ast::Expression::Node>;
    public statements: Ast::Store<Ast::StatementTag, Ast::Statement::Node>;
    public types: Ast::Store<Ast::TypeTag, Ast::Type::Node>;
    public patterns: Ast::Store<Ast::PatternTag, Ast::Pattern::Node>;
    /// The file's leading `//!` block.
    public doc: Option<String>;
    /// `///` text of each documented declaration item, keyed by raw item id.
    /// Kept beside the nodes so undocumented items cost nothing.
    public itemDocs: HashMap<u32, String>;
    /// `///` text of each documented record field and enum member, keyed by
    /// raw pattern id.
    public patternDocs: HashMap<u32, String>;
    /// `//!` text right after a namespace's opening brace, keyed by the
    /// namespace's raw item id.
    public namespaceInnerDocs: HashMap<u32, String>;

    public static init(): Module {
      return Module {
        roots: Vector::new<Ast::ItemId>(),
        items: Ast::Store::init<Ast::ItemTag, Ast::Item::Node>(),
        expressions: Ast::Store::init<Ast::ExpressionTag, Ast::Expression::Node>(),
        statements: Ast::Store::init<Ast::StatementTag, Ast::Statement::Node>(),
        types: Ast::Store::init<Ast::TypeTag, Ast::Type::Node>(),
        patterns: Ast::Store::init<Ast::PatternTag, Ast::Pattern::Node>(),
        doc: Option::NONE,
        itemDocs: HashMap::new<u32, String>(),
        patternDocs: HashMap::new<u32, String>(),
        namespaceInnerDocs: HashMap::new<u32, String>(),
      };
    }

    public setDoc(&mut self, doc: Option<String>): void {
      self.doc = doc;
    }

    public setItemDoc(&mut self, id: Ast::ItemId, doc: &Option<String>): void {
      if (let Option::SOME(text) = doc) {
        self.itemDocs.insert(id.raw(), text.clone());
      }
    }

    public setPatternDoc(&mut self, id: Ast::PatternId, doc: &Option<String>): void {
      if (let Option::SOME(text) = doc) {
        self.patternDocs.insert(id.raw(), text.clone());
      }
    }

    public setNamespaceInnerDoc(&mut self, id: Ast::ItemId, doc: &Option<String>): void {
      if (let Option::SOME(text) = doc) {
        self.namespaceInnerDocs.insert(id.raw(), text.clone());
      }
    }

    public itemDoc(&self, id: Ast::ItemId): Option<&String> {
      let raw: u32 = id.raw();
      return self.itemDocs.get(&raw);
    }

    public patternDoc(&self, id: Ast::PatternId): Option<&String> {
      let raw: u32 = id.raw();
      return self.patternDocs.get(&raw);
    }

    public namespaceInnerDoc(&self, id: Ast::ItemId): Option<&String> {
      let raw: u32 = id.raw();
      return self.namespaceInnerDocs.get(&raw);
    }

    public addRootItem(&mut self, item: Ast::Item::Node): Ast::ItemId {
      let id = self.items.add(item);
      self.roots.push(id);
      return id;
    }

    public addItem(&mut self, item: Ast::Item::Node): Ast::ItemId {
      return self.items.add(item);
    }

    public addExpression(&mut self, expression: Ast::Expression::Node): Ast::ExpressionId {
      return self.expressions.add(expression);
    }

    public addStatement(&mut self, statement: Ast::Statement::Node): Ast::StatementId {
      return self.statements.add(statement);
    }

    public addType(&mut self, typeSyntax: Ast::Type::Node): Ast::TypeId {
      return self.types.add(typeSyntax);
    }

    public addPattern(&mut self, pattern: Ast::Pattern::Node): Ast::PatternId {
      return self.patterns.add(pattern);
    }
  }
}
