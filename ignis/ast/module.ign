import HashMap from "std::collections";
import DiagnosticBag from "@compiler::diagnostics";

import _ from "./expressions";
import _ from "./items";
import _ from "./metadata";
import _ from "./patterns";
import _ from "./statements";
import _ from "./types";

export namespace Ast {
  /// Where a method materialized from a trait default comes from.
  record InheritedMethod {
    public traitName: String;
    public typeName: String;
    public methodName: String;
    /// The resolved path of the module that declares the trait, when it is
    /// not the module holding the copy.
    public sourceModule: Option<String>;
    /// The namespaces the trait is declared in, outermost first. Names in the
    /// copy are read from inside them, in the trait's module.
    public traitNamespaces: Vector<String>;
  }

  /// Where the names of an inherited method are read from.
  record InheritedScope {
    /// The resolved path of the module that declares the trait, when it is
    /// another module than the one holding the copy.
    public sourceModule: Option<String>;
    /// The namespaces the trait is declared in, outermost first.
    public namespaces: Vector<String>;
  }

  /// The written text of an extension block's target type, which names the
  /// record node the block is parsed into.
  function extensionTypeText(module: &Ast::Module, typeId: Ast::TypeId): String {
    let mut text: String = String::new();

    if (let Option::SOME(Ast::Type::Node::Path(path)) = module.types.get(typeId)) {
      let mut index: u64 = 0;

      while (index < path.segments.length()) {
        if (let Option::SOME(segment) = path.segments.get(index)) {
          if (index > 0) {
            text.pushStr("::");
          }

          text.push(segment);
        }

        index += 1;
      }

      return text;
    }

    if (let Option::SOME(Ast::Type::Node::Generic(generic)) = module.types.get(typeId)) {
      let baseText: String = Ast::extensionTypeText(module, generic.base);
      text.push(&baseText);
      text.pushStr("<");
      let mut index: u64 = 0;

      while (index < generic.arguments.length()) {
        if (let Option::SOME(argument) = generic.arguments.get(index)) {
          if (index > 0) {
            text.pushStr(", ");
          }

          let argumentText: String = Ast::extensionTypeText(module, *argument);
          text.push(&argumentText);
        }

        index += 1;
      }

      text.pushStr(">");
      return text;
    }

    text.pushStr("?");
    return text;
  }

  /// The note that names where an inherited method comes from, attached to
  /// a diagnostic only that type's copy of the default produces.
  function inheritedMethodNote(inherited: &Ast::InheritedMethod): String {
    let mut note: String = String::create("in default method `");
    note.push(&inherited.methodName);
    note.pushStr("` of trait `");
    note.push(&inherited.traitName);
    note.pushStr("`, as inherited by `");
    note.push(&inherited.typeName);
    note.pushStr("`");
    return note;
  }

  record Module {
    public roots: Vector<Ast::ItemId>;
    public items: Ast::Store<Ast::ItemTag, Ast::Item::Node>;
    public expressions: Ast::Store<Ast::ExpressionTag, Ast::Expression::Node>;
    public statements: Ast::Store<Ast::StatementTag, Ast::Statement::Node>;
    public types: Ast::Store<Ast::TypeTag, Ast::Type::Node>;
    public patterns: Ast::Store<Ast::PatternTag, Ast::Pattern::Node>;
    /// The file's leading `//!` block.
    public doc: Option<String>;
    /// `///` text of each documented declaration item, keyed by raw item id.
    /// Kept beside the nodes so undocumented items cost nothing.
    public itemDocs: HashMap<u32, String>;
    /// `///` text of each documented record field and enum member, keyed by
    /// raw pattern id.
    public patternDocs: HashMap<u32, String>;
    /// Attributes written on an enum variant, keyed by raw pattern id. A
    /// variant is a path pattern, which has no metadata of its own; a field
    /// keeps its attributes on its binding.
    public variantAttributeLists: HashMap<u32, Vector<Ast::Attribute>>;
    /// `//!` text right after a namespace's opening brace, keyed by the
    /// namespace's raw item id.
    public namespaceInnerDocs: HashMap<u32, String>;
    /// Methods copied from a trait default onto an implementing type, keyed by
    /// the copy's raw item id.
    public inheritedMethods: HashMap<u32, Ast::InheritedMethod>;
    /// The type each `extension Type { ... }` block extends, keyed by the raw
    /// item id of the record node the block is parsed into. A record with an
    /// entry here is an extension block, not a record declaration.
    public extensionTargets: HashMap<u32, Ast::TypeId>;
    /// The resolved paths of the modules whose trait defaults were copied
    /// into this one, each once, in copy order. Those copies depend on that
    /// module's text, so a parse that holds one cannot be reused once that
    /// module changes.
    public crossModuleSources: Vector<String>;
    /// The note naming the field each unrolled iteration of a `comptime for`
    /// stands for, keyed by the raw statement id of the iteration's block.
    public comptimeIterationNotes: HashMap<u32, String>;
    /// What unrolling the `comptime for` loops of this module reported.
    public comptimeDiagnostics: DiagnosticBag;
    /// Raw ids of the local bindings of trait default bodies whose
    /// `comptime for` loops unrolled over no field: their uses live in the
    /// copies on each implementing type, so the unused lints skip them here.
    public comptimeLintExemptions: HashMap<u32, boolean>;

    public static init(): Module {
      return Module {
        roots: Vector::new<Ast::ItemId>(),
        items: Ast::Store::init<Ast::ItemTag, Ast::Item::Node>(),
        expressions: Ast::Store::init<Ast::ExpressionTag, Ast::Expression::Node>(),
        statements: Ast::Store::init<Ast::StatementTag, Ast::Statement::Node>(),
        types: Ast::Store::init<Ast::TypeTag, Ast::Type::Node>(),
        patterns: Ast::Store::init<Ast::PatternTag, Ast::Pattern::Node>(),
        doc: Option::NONE,
        itemDocs: HashMap::new<u32, String>(),
        patternDocs: HashMap::new<u32, String>(),
        variantAttributeLists: HashMap::new<u32, Vector<Ast::Attribute>>(),
        namespaceInnerDocs: HashMap::new<u32, String>(),
        inheritedMethods: HashMap::new<u32, Ast::InheritedMethod>(),
        extensionTargets: HashMap::new<u32, Ast::TypeId>(),
        crossModuleSources: Vector::new<String>(),
        comptimeIterationNotes: HashMap::new<u32, String>(),
        comptimeDiagnostics: DiagnosticBag::init(),
        comptimeLintExemptions: HashMap::new<u32, boolean>(),
      };
    }

    public setDoc(&mut self, doc: Option<String>): void {
      self.doc = doc;
    }

    public setItemDoc(&mut self, id: Ast::ItemId, doc: &Option<String>): void {
      if (let Option::SOME(text) = doc) {
        self.itemDocs.insert(id.raw(), text.clone());
      }
    }

    public setPatternDoc(&mut self, id: Ast::PatternId, doc: &Option<String>): void {
      if (let Option::SOME(text) = doc) {
        self.patternDocs.insert(id.raw(), text.clone());
      }
    }

    public setVariantAttributes(
      &mut self,
      id: Ast::PatternId,
      attributes: &Vector<Ast::Attribute>
    ): void {
      if (attributes.length() == 0) {
        return;
      }

      let mut copied: Vector<Ast::Attribute> = Vector::new<Ast::Attribute>();
      let mut index: u64 = 0;

      while (index < attributes.length()) {
        if (let Option::SOME(attribute) = attributes.get(index)) {
          copied.push(Ast::copyAttribute(attribute));
        }

        index += 1;
      }

      self.variantAttributeLists.insert(id.raw(), copied);
    }

    public variantAttributes(&self, id: Ast::PatternId): Option<&Vector<Ast::Attribute>> {
      let raw: u32 = id.raw();
      return self.variantAttributeLists.get(&raw);
    }

    public setNamespaceInnerDoc(&mut self, id: Ast::ItemId, doc: &Option<String>): void {
      if (let Option::SOME(text) = doc) {
        self.namespaceInnerDocs.insert(id.raw(), text.clone());
      }
    }

    public setInheritedMethod(&mut self, id: Ast::ItemId, inherited: Ast::InheritedMethod): void {
      if (let Option::SOME(source) = &inherited.sourceModule) {
        let mut known: boolean = false;
        let mut index: u64 = 0;

        while (index < self.crossModuleSources.length()) {
          if (let Option::SOME(existing) = self.crossModuleSources.get(index)) {
            if (existing.equals(source.toStr())) {
              known = true;
            }
          }

          index += 1;
        }

        if (!known) {
          self.crossModuleSources.push(source.clone());
        }
      }

      self.inheritedMethods.insert(id.raw(), inherited);
    }

    /// Where the names of the inherited method `id` are read from, when `id`
    /// is a copy of a trait default.
    public inheritedScopeOf(&self, id: Ast::ItemId): Option<Ast::InheritedScope> {
      let raw: u32 = id.raw();
      let Option::SOME(inherited) = self.inheritedMethods.get(&raw) else {
        return Option::NONE;
      };

      let mut namespaces: Vector<String> = Vector::new<String>();
      let mut index: u64 = 0;

      while (index < inherited.traitNamespaces.length()) {
        if (let Option::SOME(segment) = inherited.traitNamespaces.get(index)) {
          namespaces.push(segment.clone());
        }

        index += 1;
      }

      let mut sourceModule: Option<String> = Option::NONE;

      if (let Option::SOME(source) = &inherited.sourceModule) {
        sourceModule = Option::SOME(source.clone());
      }

      return Option::SOME(Ast::InheritedScope { sourceModule: sourceModule, namespaces: namespaces });
    }

    public setComptimeIterationNote(&mut self, id: Ast::StatementId, note: String): void {
      self.comptimeIterationNotes.insert(id.raw(), note);
    }

    /// The note naming the field the block `id` was unrolled for, when `id`
    /// is one iteration of a `comptime for`.
    public comptimeIterationNote(&self, id: Ast::StatementId): Option<&String> {
      let raw: u32 = id.raw();
      return self.comptimeIterationNotes.get(&raw);
    }

    public exemptFromComptimeLints(&mut self, id: Ast::PatternId): void {
      self.comptimeLintExemptions.insert(id.raw(), true);
    }

    public isComptimeLintExempt(&self, raw: u32): boolean {
      return self.comptimeLintExemptions.get(&raw).isSome();
    }

    public setExtensionTarget(&mut self, id: Ast::ItemId, target: Ast::TypeId): void {
      self.extensionTargets.insert(id.raw(), target);
    }

    /// The type the extension block `id` extends, or `NONE` when `id` is not
    /// an extension block.
    public extensionTarget(&self, id: Ast::ItemId): Option<Ast::TypeId> {
      let raw: u32 = id.raw();

      if (let Option::SOME(target) = self.extensionTargets.get(&raw)) {
        return Option::SOME(*target);
      }

      return Option::NONE;
    }

    public inheritedMethod(&self, id: Ast::ItemId): Option<&Ast::InheritedMethod> {
      let raw: u32 = id.raw();
      return self.inheritedMethods.get(&raw);
    }

    public itemDoc(&self, id: Ast::ItemId): Option<&String> {
      let raw: u32 = id.raw();
      return self.itemDocs.get(&raw);
    }

    public patternDoc(&self, id: Ast::PatternId): Option<&String> {
      let raw: u32 = id.raw();
      return self.patternDocs.get(&raw);
    }

    public namespaceInnerDoc(&self, id: Ast::ItemId): Option<&String> {
      let raw: u32 = id.raw();
      return self.namespaceInnerDocs.get(&raw);
    }

    public addRootItem(&mut self, item: Ast::Item::Node): Ast::ItemId {
      let id = self.items.add(item);
      self.roots.push(id);
      return id;
    }

    public addItem(&mut self, item: Ast::Item::Node): Ast::ItemId {
      return self.items.add(item);
    }

    public addExpression(&mut self, expression: Ast::Expression::Node): Ast::ExpressionId {
      return self.expressions.add(expression);
    }

    public addStatement(&mut self, statement: Ast::Statement::Node): Ast::StatementId {
      return self.statements.add(statement);
    }

    public addType(&mut self, typeSyntax: Ast::Type::Node): Ast::TypeId {
      return self.types.add(typeSyntax);
    }

    public addPattern(&mut self, pattern: Ast::Pattern::Node): Ast::PatternId {
      return self.patterns.add(pattern);
    }
  }
}
