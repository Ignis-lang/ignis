import SourceSpan from "@compiler::diagnostics";

export namespace Ast {
  enum Modifier {
    Public,
    Private,
    Static,
    /// Only ever paired with `Static`: it marks the `static mut` field form,
    /// whose one storage location the program may write to.
    Mutable,
    Inline,
    InlineAlways,
    InlineNever,
    Meta,
    Declare,
  }

  /// One `@name` or `@name(arguments)` attribute.
  ///
  /// A declarable attribute (a capitalized name, which names a record marked
  /// `@attribute`) has its arguments parsed as expressions in the module's
  /// expression arena, held in `expressions`, and `arguments` stays empty. A
  /// built-in lowercase attribute keeps its arguments as written text in
  /// `arguments`: several of them take type names or bare words (`Vector<T>`,
  /// `mut`, lint names) that are not expressions.
  record Attribute {
    public span: SourceSpan;
    public name: String;
    public arguments: Vector<String>;
    public expressions: Vector<Ast::ExpressionId>;
  }

  /// Whether `name` is written the way a declarable attribute is: its last
  /// path segment starts with an uppercase ASCII letter.
  function isDeclarableAttributeName(name: &String): boolean {
    let mut start: u64 = 0;
    let mut index: u64 = 0;

    while (index < name.length()) {
      if (let Option::SOME(byte) = name.byteAt(index)) {
        if (byte == ':' as u8) {
          start = index + 1;
        }
      }

      index += 1;
    }

    let Option::SOME(first) = name.byteAt(start) else {
      return false;
    };

    return first >= 'A' as u8 && first <= 'Z' as u8;
  }

  function copyAttributeExpressions(source: &Vector<Ast::ExpressionId>): Vector<Ast::ExpressionId> {
    let mut copied: Vector<Ast::ExpressionId> = Vector::new<Ast::ExpressionId>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      if (let Option::SOME(value) = source.get(index)) {
        copied.push(*value);
      }

      index += 1;
    }

    return copied;
  }

  record Metadata {
    public attributes: Vector<Ast::Attribute>;
    public modifiers: Vector<Ast::Modifier>;
  }

  function copyAttributeArguments(source: &Vector<String>): Vector<String> {
    let mut copied: Vector<String> = Vector::new<String>();
    let mut index: u64 = 0;

    while (index < source.length()) {
      let Option::SOME(value) = source.get(index) else {
        index += 1;
        continue;
      };

      copied.push(value.clone());
      index += 1;
    }

    return copied;
  }

  function copyAttribute(attribute: &Ast::Attribute): Ast::Attribute {
    return Ast::Attribute {
      span: attribute.span,
      name: attribute.name.clone(),
      arguments: Ast::copyAttributeArguments(&attribute.arguments),
      expressions: Ast::copyAttributeExpressions(&attribute.expressions),
    };
  }

  function emptyMetadata(): Ast::Metadata {
    return Ast::Metadata {
      attributes: Vector::new<Ast::Attribute>(),
      modifiers: Vector::new<Ast::Modifier>(),
    };
  }

  function metadataHasValues(metadata: &Ast::Metadata): boolean {
    return metadata.attributes.length() > 0 || metadata.modifiers.length() > 0;
  }

  function copyMetadata(metadata: &Ast::Metadata): Ast::Metadata {
    let mut attributes: Vector<Ast::Attribute> = Vector::new<Ast::Attribute>();
    let mut modifiers: Vector<Ast::Modifier> = Vector::new<Ast::Modifier>();
    let mut attributeIndex: u64 = 0;
    let mut modifierIndex: u64 = 0;

    while (attributeIndex < metadata.attributes.length()) {
      let Option::SOME(attribute) = metadata.attributes.get(attributeIndex) else {
        attributeIndex += 1;
        continue;
      };

      attributes.push(Ast::copyAttribute(attribute));
      attributeIndex += 1;
    }

    while (modifierIndex < metadata.modifiers.length()) {
      let Option::SOME(modifier) = metadata.modifiers.get(modifierIndex) else {
        modifierIndex += 1;
        continue;
      };

      modifiers.push(*modifier);
      modifierIndex += 1;
    }

    return Ast::Metadata {
      attributes: attributes,
      modifiers: modifiers,
    };
  }

  function mergeMetadata(left: Ast::Metadata, right: Ast::Metadata): Ast::Metadata {
    let mut attributes: Vector<Ast::Attribute> = Vector::new<Ast::Attribute>();
    let mut modifiers: Vector<Ast::Modifier> = Vector::new<Ast::Modifier>();
    let mut attributeIndex: u64 = 0;
    let mut modifierIndex: u64 = 0;

    while (attributeIndex < left.attributes.length()) {
      let Option::SOME(attribute) = left.attributes.get(attributeIndex) else {
        attributeIndex += 1;
        continue;
      };

      attributes.push(Ast::copyAttribute(attribute));
      attributeIndex += 1;
    }

    attributeIndex = 0;
    while (attributeIndex < right.attributes.length()) {
      let Option::SOME(attribute) = right.attributes.get(attributeIndex) else {
        attributeIndex += 1;
        continue;
      };

      attributes.push(Ast::copyAttribute(attribute));
      attributeIndex += 1;
    }

    while (modifierIndex < left.modifiers.length()) {
      let Option::SOME(modifier) = left.modifiers.get(modifierIndex) else {
        modifierIndex += 1;
        continue;
      };

      modifiers.push(*modifier);
      modifierIndex += 1;
    }

    modifierIndex = 0;
    while (modifierIndex < right.modifiers.length()) {
      let Option::SOME(modifier) = right.modifiers.get(modifierIndex) else {
        modifierIndex += 1;
        continue;
      };

      modifiers.push(*modifier);
      modifierIndex += 1;
    }

    return Ast::Metadata {
      attributes: attributes,
      modifiers: modifiers,
    };
  }
}
