import SourceSpan from "@compiler::diagnostics";
import Vector from "std::vector";

export namespace Ast {
  namespace Pattern {
    record Wildcard {
      public span: SourceSpan;
    }

    record Binding {
      public span: SourceSpan;
      public name: String;
      public annotation: Option<Ast::TypeId>;

      /// The value a record field declares with `= <expr>`, which makes it a
      /// static field. `NONE` everywhere else: a `let` keeps its initializer
      /// on the statement, and a parameter has none.
      public initializer: Option<Ast::ExpressionId>;
      public metadata: Ast::Metadata;
    }

    record Literal {
      public span: SourceSpan;
      public expression: Ast::ExpressionId;
    }

    record Path {
      public span: SourceSpan;
      public segments: Vector<String>;
      public arguments: Vector<Ast::PatternId>;
    }

    record Tuple {
      public span: SourceSpan;
      public elements: Vector<Ast::PatternId>;
    }

    record Or {
      public span: SourceSpan;
      public alternatives: Vector<Ast::PatternId>;
    }

    enum Node {
      Wildcard(Wildcard),
      Binding(Binding),
      Literal(Literal),
      Path(Path),
      Tuple(Tuple),
      Or(Or),
    }
  }
}
