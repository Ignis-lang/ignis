import
  Diagnostic,
  DiagnosticBag,
  DiagnosticCode,
  LabelKind,
  Severity,
  SourceFile,
from "@compiler::diagnostics";
import
  Keyword,
  LiteralKind,
  Punctuation,
  SourceCursor,
  SourceMark,
  Token,
  TokenKind,
  TokenStream,
from "@compiler::syntax";

function isIdentifierStart(value: char): boolean {
  return value.isAlphabetic() || value == '_';
}

function isIdentifierContinue(value: char): boolean {
  return value.isAlphanumeric() || value == '_';
}

/// Whether a decimal literal's digits, separators already removed, fit in
/// `u64`, the widest type the reference lexer's `i32`/`i64`/`u64` ladder tries.
function decimalDigitsFitU64(digits: &String): boolean {
  let mut firstSignificant: u64 = 0;

  while (firstSignificant < digits.length()) {
    let Option::SOME(byte) = digits.byteAt(firstSignificant) else {
      break;
    };

    if (byte != '0' as u8) {
      break;
    }

    firstSignificant += 1;
  }

  let significant: String = digits.substringBytes(firstSignificant, digits.length());
  let maxDigits: String = String::create("18446744073709551615");

  if (significant.length() != maxDigits.length()) {
    return significant.length() < maxDigits.length();
  }

  return significant.compare(&maxDigits) <= 0;
}

/// What an open lexer frame is waiting for.
enum LexerFrameKind {
  /// A template interpolation `${ ... }`. Its `}` resumes the template text.
  TEMPLATE,
  /// The header of an `asm` expression, between the keyword and the body.
  /// Its first `{` outside parentheses opens the body.
  EMBED_HEADER,
  /// A hole `{ ... }` inside an embedded body. Its `}` resumes the body text.
  EMBED_HOLE,
}

/// One open frame. `depth` counts the braces opened inside a template
/// interpolation or an embed hole, and the parentheses opened inside an
/// embed header.
record LexerFrame {
  public kind: LexerFrameKind;
  public depth: u64;
}

export record LexResult {
  public tokens: TokenStream;
  public diagnostics: DiagnosticBag;
}

record LexerScanner {
  cursor: SourceCursor;
  public diagnostics: DiagnosticBag;
  public tokens: TokenStream;

  /// The template interpolations, embed headers and embed holes still open,
  /// innermost last.
  ///
  /// A `}` closes an interpolation or a hole only when the innermost frame is
  /// at depth zero; otherwise it closes a block written inside it.
  frames: Vector<LexerFrame>;

  public static create(file: &SourceFile): LexerScanner {
    return LexerScanner {
      cursor: SourceCursor::create(file),
      diagnostics: DiagnosticBag::init(),
      tokens: TokenStream::create(),
      frames: Vector::new<LexerFrame>(),
    };
  }

  private emitToken(&mut self, token: Token): void {
    self.tokens.push(token);
  }

  private emitPunctuation(
    &mut self,
    start: SourceMark,
    punctuation: Punctuation,
    lexeme: str
  ): void {
    self.emitToken(Token::punctuation(punctuation, self.cursor.spanFrom(start), lexeme));
  }

  private emitIdentifierOrKeyword(&mut self, start: SourceMark): void {
    let lexeme: String = self.cursor.lexemeFrom(start);

    let Option::SOME(keyword) = Keyword::fromLexeme(&lexeme) else {
      self.emitToken(Token::identifier(self.cursor.spanFrom(start), lexeme.toStr()));
      return;
    };

    self.emitToken(Token::keyword(keyword, self.cursor.spanFrom(start), lexeme.toStr()));

    if (keyword == Keyword::ASM) {
      self.pushFrame(LexerFrameKind::EMBED_HEADER);
    }
  }

  private emitComment(&mut self, start: SourceMark, kind: TokenKind): void {
    let lexeme: String = self.cursor.lexemeFrom(start);

    if (kind == TokenKind::OUTER_DOC_COMMENT) {
      self.emitToken(Token::outerDocCommentOwned(self.cursor.spanFrom(start), &lexeme));
      return;
    }

    if (kind == TokenKind::INNER_DOC_COMMENT) {
      self.emitToken(Token::innerDocCommentOwned(self.cursor.spanFrom(start), &lexeme));
      return;
    }

    if (kind == TokenKind::BLOCK_COMMENT) {
      self.emitToken(Token::blockCommentOwned(self.cursor.spanFrom(start), &lexeme));
      return;
    }

    self.emitToken(Token::lineCommentOwned(self.cursor.spanFrom(start), &lexeme));
  }

  private emitLiteral(&mut self, start: SourceMark, kind: LiteralKind): void {
    let lexeme: String = self.cursor.lexemeFrom(start);
    self.emitToken(Token::literalOwned(kind, self.cursor.spanFrom(start), &lexeme));
  }

  private emitDecimalIntegerLiteral(&mut self, start: SourceMark): void {
    let lexeme: String = self.cursor.lexemeFrom(start);
    let mut digits: String = String::create("");
    let mut index: u64 = 0;

    while (index < lexeme.length()) {
      let Option::SOME(byte) = lexeme.byteAt(index) else {
        break;
      };

      if (byte != '_' as u8) {
        digits.pushByte(byte);
      }

      index += 1;
    }

    if (decimalDigitsFitU64(&digits)) {
      self.emitLiteral(start, LiteralKind::INTEGER);
      return;
    }

    let message: String = `Integer literal ${digits.toStr()} is too large for any integer type`;
    self.emitBadLiteral(start, DiagnosticCode::INTEGER_LITERAL_OUT_OF_RANGE, message.toStr(), "integer literal does not fit in u64");
  }

  private emitDiagnostic(&mut self, start: SourceMark, code: str, message: str, label: str): void {
    let span = self.cursor.spanFrom(start);
    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, code, message, span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, label);
    self.diagnostics.push(diagnostic);
  }

  private emitBadLiteral(&mut self, start: SourceMark, code: str, message: str, label: str): void {
    let span = self.cursor.spanFrom(start);
    let lexeme: String = self.cursor.lexemeFrom(start);
    self.emitDiagnostic(start, code, message, label);
    self.emitToken(Token::badOwned(span, &lexeme));
  }

  private emitInvalidToken(&mut self, start: SourceMark): void {
    let span = self.cursor.spanFrom(start);
    let lexeme: String = self.cursor.lexemeFrom(start);
    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::INVALID_TOKEN, "Invalid token", span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, "token is not valid here");
    self.diagnostics.push(diagnostic);
    self.emitToken(Token::badOwned(span, &lexeme));
  }

  private emitUnterminatedComment(&mut self, start: SourceMark): void {
    let span = self.cursor.spanFrom(start);
    let lexeme: String = self.cursor.lexemeFrom(start);
    let mut diagnostic: Diagnostic = Diagnostic::new(Severity::ERROR, DiagnosticCode::UNTERMINATED_COMMENT, "Unterminated comment", span);
    diagnostic.addLabel(LabelKind::PRIMARY, span, "comment must end with */");
    self.diagnostics.push(diagnostic);
    self.emitToken(Token::badOwned(span, &lexeme));
  }

  private emitRawNulInSource(&mut self, start: SourceMark): void {
    self.emitDiagnostic(start, DiagnosticCode::RAW_NUL_IN_SOURCE, "Raw NUL byte is not allowed in source text", "source text cannot contain raw NUL bytes");
  }

  private matchAscii(&mut self, expected: char): boolean {
    let Option::SOME(actual) = self.cursor.peekChar() else {
      return false;
    };

    if (actual != expected) {
      return false;
    }

    self.cursor.advanceChar();
    return true;
  }

  private isLineTerminator(&self, value: char): boolean {
    return value == '\n' || value == '\r';
  }

  private scanNumericRecoveryTail(&mut self): void {
    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (!next.isAlphanumeric() && next != '_') {
        return;
      }

      self.cursor.advanceChar();
    }
  }

  private scanDigitsWithSeparators(&mut self): boolean {
    let mut previousWasDigit: boolean = true;

    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next.isAsciiNumeric()) {
        self.cursor.advanceChar();
        previousWasDigit = true;
        continue;
      }

      if (next != '_') {
        return previousWasDigit;
      }

      let Option::SOME(following) = self.cursor.peekNextChar() else {
        return false;
      };

      if (!previousWasDigit || !following.isAsciiNumeric()) {
        return false;
      }

      self.cursor.advanceChar();
      previousWasDigit = false;
    }

    return previousWasDigit;
  }

  private scanDecimalOrFloatLiteral(&mut self, start: SourceMark): void {
    if (!self.scanDigitsWithSeparators()) {
      self.scanNumericRecoveryTail();
      self.emitBadLiteral(start, DiagnosticCode::EXPECTED_INTEGER, "Expected integer literal", "integer separators must stay between digits");
      return;
    }

    let Option::SOME(dot) = self.cursor.peekChar() else {
      self.emitDecimalIntegerLiteral(start);
      return;
    };

    if (dot != '.') {
      self.emitDecimalIntegerLiteral(start);
      return;
    }

    let Option::SOME(second) = self.cursor.peekNextChar() else {
      self.emitDecimalIntegerLiteral(start);
      return;
    };

    if (!second.isAsciiNumeric()) {
      self.emitDecimalIntegerLiteral(start);
      return;
    }

    self.cursor.advanceChar();
    let Option::SOME(_) = self.cursor.peekChar() else {
      self.emitBadLiteral(start, DiagnosticCode::EXPECTED_FLOAT, "Expected float literal", "float literal needs digits after the decimal point");
      return;
    };

    self.cursor.advanceChar();

    if (!self.scanDigitsWithSeparators()) {
      self.scanNumericRecoveryTail();
      self.emitBadLiteral(start, DiagnosticCode::EXPECTED_FLOAT, "Expected float literal", "float separators must stay between digits");
      return;
    }

    self.emitLiteral(start, LiteralKind::FLOAT);
  }

  private scanBinaryLiteral(&mut self, start: SourceMark): void {
    let Option::SOME(first) = self.cursor.peekChar() else {
      self.emitBadLiteral(start, DiagnosticCode::EXPECTED_BINARY, "Expected binary literal", "binary literal needs at least one digit after 0b");
      return;
    };

    if (first != '0' && first != '1') {
      self.scanNumericRecoveryTail();
      self.emitBadLiteral(start, DiagnosticCode::EXPECTED_BINARY, "Expected binary literal", "binary literal only allows 0 or 1 digits");
      return;
    }

    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next == '0' || next == '1') {
        self.cursor.advanceChar();
        continue;
      }

      if (next.isAlphanumeric() || next == '_') {
        self.scanNumericRecoveryTail();
        self.emitBadLiteral(start, DiagnosticCode::EXPECTED_BINARY, "Expected binary literal", "binary literal only allows 0 or 1 digits");
        return;
      }

      self.emitLiteral(start, LiteralKind::BINARY);
      return;
    }

    self.emitLiteral(start, LiteralKind::BINARY);
  }

  private scanHexLiteral(&mut self, start: SourceMark): void {
    let Option::SOME(first) = self.cursor.peekChar() else {
      self.emitBadLiteral(start, DiagnosticCode::EXPECTED_HEX, "Expected hexadecimal literal", "hex literal needs at least one digit after 0x");
      return;
    };

    if (!first.isHexDigit()) {
      self.scanNumericRecoveryTail();
      self.emitBadLiteral(start, DiagnosticCode::EXPECTED_HEX, "Expected hexadecimal literal", "hex literal only allows 0-9, a-f, and A-F digits");
      return;
    }

    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next.isHexDigit()) {
        self.cursor.advanceChar();
        continue;
      }

      if (next.isAlphanumeric() || next == '_') {
        self.scanNumericRecoveryTail();
        self.emitBadLiteral(start, DiagnosticCode::EXPECTED_HEX, "Expected hexadecimal literal", "hex literal only allows 0-9, a-f, and A-F digits");
        return;
      }

      self.emitLiteral(start, LiteralKind::HEX);
      return;
    }

    self.emitLiteral(start, LiteralKind::HEX);
  }

  private scanNumberLiteral(&mut self, start: SourceMark, first: char): void {
    if (first == '0' && (self.matchAscii('x') || self.matchAscii('X'))) {
      self.scanHexLiteral(start);
      return;
    }

    if (first == '0' && (self.matchAscii('b') || self.matchAscii('B'))) {
      self.scanBinaryLiteral(start);
      return;
    }

    self.scanDecimalOrFloatLiteral(start);
  }

  private pushFrame(&mut self, kind: LexerFrameKind): void {
    self.frames.push(LexerFrame { kind: kind, depth: 0 });
  }

  /// The innermost open frame, if any.
  private topFrame(&self): Option<LexerFrame> {
    let count: u64 = self.frames.length();

    if (count == 0) {
      return Option::NONE;
    }

    let Option::SOME(frame) = self.frames.get(count - 1) else {
      return Option::NONE;
    };

    return Option::SOME(LexerFrame { kind: frame.kind, depth: frame.depth });
  }

  /// Replaces the innermost frame's depth.
  private setTopDepth(&mut self, depth: u64): void {
    let count: u64 = self.frames.length();

    if (count == 0) {
      return;
    }

    let Option::SOME(frame) = self.topFrame() else {
      return;
    };

    self.frames.set(count - 1, LexerFrame { kind: frame.kind, depth: depth });
  }

  private scanLeftBrace(&mut self, start: SourceMark): void {
    let Option::SOME(frame) = self.topFrame() else {
      self.emitPunctuation(start, Punctuation::LEFT_BRACE, "{");
      return;
    };

    match (frame.kind) {
      LexerFrameKind::EMBED_HEADER -> {
        if (frame.depth == 0) {
          self.frames.pop();
          self.scanEmbedHead(start);
          return;
        }
      },
      _ -> self.setTopDepth(frame.depth + 1),
    };

    self.emitPunctuation(start, Punctuation::LEFT_BRACE, "{");
  }

  private scanRightBrace(&mut self, start: SourceMark): void {
    let Option::SOME(frame) = self.topFrame() else {
      self.emitPunctuation(start, Punctuation::RIGHT_BRACE, "}");
      return;
    };

    match (frame.kind) {
      LexerFrameKind::EMBED_HEADER -> {
        // Parentheses do not count braces, so a `}` at depth zero closes
        // whatever encloses the `asm`, and the header never got its body.
        if (frame.depth == 0) {
          self.frames.pop();
          self.scanRightBrace(start);
          return;
        }
      },
      LexerFrameKind::TEMPLATE -> {
        if (frame.depth == 0) {
          self.frames.pop();
          self.scanTemplateContinuation(start);
          return;
        }

        self.setTopDepth(frame.depth - 1);
      },
      LexerFrameKind::EMBED_HOLE -> {
        if (frame.depth == 0) {
          self.frames.pop();
          self.scanEmbedContinuation(start);
          return;
        }

        self.setTopDepth(frame.depth - 1);
      },
    };

    self.emitPunctuation(start, Punctuation::RIGHT_BRACE, "}");
  }

  /// Counts a `(` inside an embed header, so a `{` within its parentheses is
  /// not taken for the body.
  private scanLeftParen(&mut self, start: SourceMark): void {
    if (let Option::SOME(frame) = self.topFrame()) {
      if (let LexerFrameKind::EMBED_HEADER = frame.kind) {
        self.setTopDepth(frame.depth + 1);
      }
    }

    self.emitPunctuation(start, Punctuation::LEFT_PAREN, "(");
  }

  /// Uncounts a `)` inside an embed header. One at depth zero closes what
  /// encloses the `asm`, which ends the header.
  private scanRightParen(&mut self, start: SourceMark): void {
    if (let Option::SOME(frame) = self.topFrame()) {
      if (let LexerFrameKind::EMBED_HEADER = frame.kind) {
        if (frame.depth == 0) {
          self.frames.pop();
        } else {
          self.setTopDepth(frame.depth - 1);
        }
      }
    }

    self.emitPunctuation(start, Punctuation::RIGHT_PAREN, ")");
  }

  /// A `;` outside the parentheses of an embed header ends the header: the
  /// `asm` never got a body, and a later `{` is ordinary syntax again.
  private scanSemicolon(&mut self, start: SourceMark): void {
    if (let Option::SOME(frame) = self.topFrame()) {
      if (let LexerFrameKind::EMBED_HEADER = frame.kind) {
        if (frame.depth == 0) {
          self.frames.pop();
        }
      }
    }

    self.emitPunctuation(start, Punctuation::SEMICOLON, ";");
  }

  /// Scans a template literal opened by a backtick.
  private scanTemplateLiteral(&mut self, start: SourceMark): void {
    if (self.scanTemplateChunk(start)) {
      self.pushFrame(LexerFrameKind::TEMPLATE);
      self.emitLiteral(start, LiteralKind::TEMPLATE_HEAD);
      return;
    }

    self.emitLiteral(start, LiteralKind::TEMPLATE_NO_SUBSTITUTION);
  }

  /// Scans the literal text that follows the `}` closing an interpolation.
  private scanTemplateContinuation(&mut self, start: SourceMark): void {
    if (self.scanTemplateChunk(start)) {
      self.pushFrame(LexerFrameKind::TEMPLATE);
      self.emitLiteral(start, LiteralKind::TEMPLATE_MIDDLE);
      return;
    }

    self.emitLiteral(start, LiteralKind::TEMPLATE_TAIL);
  }

  /// Scans an embedded body from the `{` that opens it.
  private scanEmbedHead(&mut self, start: SourceMark): void {
    if (self.scanEmbedChunk(start)) {
      self.pushFrame(LexerFrameKind::EMBED_HOLE);
      self.emitLiteral(start, LiteralKind::EMBED_HEAD);
      return;
    }

    self.emitLiteral(start, LiteralKind::EMBED_NO_HOLE);
  }

  /// Scans the body text that follows the `}` closing a hole.
  private scanEmbedContinuation(&mut self, start: SourceMark): void {
    if (self.scanEmbedChunk(start)) {
      self.pushFrame(LexerFrameKind::EMBED_HOLE);
      self.emitLiteral(start, LiteralKind::EMBED_MIDDLE);
      return;
    }

    self.emitLiteral(start, LiteralKind::EMBED_TAIL);
  }

  /// Consumes embedded body text up to the `{` of the next hole or the `}`
  /// closing the body.
  ///
  /// `{{` and `}}` stand for literal braces and stay in the chunk, and so do
  /// `//` and `/* */` comments, whose braces count for nothing. Returns
  /// whether a hole follows the chunk. On an unterminated body it reports the
  /// diagnostic itself and returns false, which leaves the caller emitting a
  /// closing token over the recovered span.
  private scanEmbedChunk(&mut self, start: SourceMark): boolean {
    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next == '{' || next == '}') {
        self.cursor.advanceChar();

        if (self.matchAscii(next)) {
          continue;
        }

        return next == '{';
      }

      if (next == '/') {
        self.cursor.advanceChar();

        if (self.matchAscii('/')) {
          self.scanLineComment();
          continue;
        }

        if (self.matchAscii('*')) {
          self.scanBlockCommentBody();
        }

        continue;
      }

      if (next == '\0') {
        let nulStart: SourceMark = self.cursor.mark();
        self.cursor.advanceChar();
        self.emitRawNulInSource(nulStart);
        continue;
      }

      self.cursor.advanceChar();
    }

    self.emitDiagnostic(start, DiagnosticCode::UNTERMINATED_ASM_BODY, "Unterminated asm body", "asm body must end with '}'");
    return false;
  }

  /// Consumes template text up to the next `${` or the closing backtick.
  ///
  /// Returns whether an interpolation follows the chunk. On an unterminated
  /// literal it reports the diagnostic itself and returns false, which leaves
  /// the caller emitting a tail token over the recovered span.
  private scanTemplateChunk(&mut self, start: SourceMark): boolean {
    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next == '`') {
        self.cursor.advanceChar();
        return false;
      }

      if (next == '$') {
        let checkpoint: SourceMark = self.cursor.mark();
        self.cursor.advanceChar();

        if (let Option::SOME(afterDollar) = self.cursor.peekChar()) {
          if (afterDollar == '{') {
            self.cursor.advanceChar();
            return true;
          }
        }

        self.cursor.reset(checkpoint);
        self.cursor.advanceChar();
        continue;
      }

      if (next == '\\') {
        let escapeStart: SourceMark = self.cursor.mark();
        self.cursor.advanceChar();

        if (self.cursor.isAtEnd()) {
          self.emitDiagnostic(start, DiagnosticCode::UNTERMINATED_TEMPLATE_STRING, "Unterminated template literal", "template literal must end with a closing backtick");
          return false;
        }

        self.scanStringEscape(escapeStart, true);
        continue;
      }

      if (next == '\0') {
        let nulStart: SourceMark = self.cursor.mark();
        self.cursor.advanceChar();
        self.emitRawNulInSource(nulStart);
        self.skipToTemplateTerminator();

        return false;
      }

      self.cursor.advanceChar();
    }

    self.emitDiagnostic(start, DiagnosticCode::UNTERMINATED_TEMPLATE_STRING, "Unterminated template literal", "template literal must end with a closing backtick");
    return false;
  }

  private skipToTemplateTerminator(&mut self): void {
    while (let Option::SOME(current) = self.cursor.advanceChar()) {
      if (current == '`') {
        break;
      }
    }
  }

  private scanStringLiteral(&mut self, start: SourceMark): void {
    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next == '"') {
        self.cursor.advanceChar();
        self.emitLiteral(start, LiteralKind::STRING);
        return;
      }

      if (self.isLineTerminator(next)) {
        self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_STRING, "Unterminated string literal", "string literal must close before the end of the line");
        return;
      }

      if (next == '\\') {
        let escapeStart: SourceMark = self.cursor.mark();
        self.cursor.advanceChar();

        if (self.cursor.isAtEnd()) {
          self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_STRING, "Unterminated string literal", "string literal must end with a closing quote");
          return;
        }

        let Option::SOME(escaped) = self.cursor.peekChar() else {
          self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_STRING, "Unterminated string literal", "string literal must end with a closing quote");
          return;
        };

        if (self.isLineTerminator(escaped)) {
          self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_STRING, "Unterminated string literal", "string literal must close before the end of the line");
          return;
        }

        if (escaped == '\0') {
          let nulStart: SourceMark = self.cursor.mark();
          self.cursor.advanceChar();
          self.emitRawNulInSource(nulStart);

          while (let Option::SOME(current) = self.cursor.peekChar()) {
            if (self.isLineTerminator(current)) {
              break;
            }

            if (current == '"') {
              self.cursor.advanceChar();
              break;
            }

            self.cursor.advanceChar();
          }

          let lexeme: String = self.cursor.lexemeFrom(start);
          self.emitToken(Token::badOwned(self.cursor.spanFrom(start), &lexeme));
          return;
        }

        self.scanStringEscape(escapeStart, false);
        continue;
      }

      if (next == '\0') {
        let nulStart: SourceMark = self.cursor.mark();
        self.cursor.advanceChar();
        self.emitRawNulInSource(nulStart);

        while (let Option::SOME(current) = self.cursor.peekChar()) {
          if (self.isLineTerminator(current)) {
            break;
          }

          if (current == '"') {
            self.cursor.advanceChar();
            break;
          }

          self.cursor.advanceChar();
        }

        let lexeme: String = self.cursor.lexemeFrom(start);
        self.emitToken(Token::badOwned(self.cursor.spanFrom(start), &lexeme));
        return;
      }

      self.cursor.advanceChar();
    }

    self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_STRING, "Unterminated string literal", "string literal must end with a closing quote");
  }

  private recoverMalformedCharLiteral(&mut self): void {
    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next == '\'' || self.isLineTerminator(next)) {
        break;
      }

      self.cursor.advanceChar();
    }

    if (let Option::SOME(next) = self.cursor.peekChar() && next == '\'') {
      self.cursor.advanceChar();
    }
  }

  private hexDigitValue(&self, value: char): u32 {
    if (value.isAsciiNumeric()) {
      return (value as u32) - ('0' as u32);
    }

    if (value >= 'a' && value <= 'f') {
      return 10 + ((value as u32) - ('a' as u32));
    }

    return 10 + ((value as u32) - ('A' as u32));
  }

  private scanUnicodeEscapeValue(&mut self): Option<u32> {
    const MAX_UNICODE_ESCAPE_HEX_DIGITS: u64 = 6;

    if (!self.matchAscii('{')) {
      return Option::NONE;
    }

    let mut sawDigit: boolean = false;
    let mut digitCount: u64 = 0;
    let mut value: u32 = 0;

    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next == '}') {
        if (!sawDigit) {
          return Option::NONE;
        }

        self.cursor.advanceChar();
        return Option::SOME(value);
      }

      if (!next.isHexDigit()) {
        return Option::NONE;
      }

      if (digitCount >= MAX_UNICODE_ESCAPE_HEX_DIGITS) {
        return Option::NONE;
      }

      sawDigit = true;
      digitCount += 1;
      value = value * 16 + self.hexDigitValue(next);
      self.cursor.advanceChar();
    }

    return Option::NONE;
  }

  /// The escapes that stand for one character in a char, string or template
  /// literal: `\a \b \f \n \r \t \v \0 \\ \' \"`.
  private isSingleCharacterEscape(&self, escaped: char): boolean {
    return escaped == 'a' || escaped == 'b' || escaped == 'f' || escaped == 'n' || escaped == 'r' || escaped == 't' || escaped == 'v' || escaped == '0' || escaped == '\\' || escaped == '\'' || escaped == '"';
  }

  /// Consumes the escape after the backslash at `escapeStart` in a string or
  /// template literal, reporting one the language does not define (I0023)
  /// without ending the literal, so lexing continues past it. Besides the
  /// single-character escapes and `\u{...}`, a template accepts `` \` `` and
  /// `\$`, and a backslash before a line break inside it.
  private scanStringEscape(&mut self, escapeStart: SourceMark, inTemplate: boolean): void {
    let Option::SOME(escaped) = self.cursor.peekChar() else {
      return;
    };

    if (inTemplate && escaped == '\0') {
      let nulStart: SourceMark = self.cursor.mark();
      self.cursor.advanceChar();
      self.emitRawNulInSource(nulStart);
      return;
    }

    self.cursor.advanceChar();

    if (self.isSingleCharacterEscape(escaped)) {
      return;
    }

    if (inTemplate && (escaped == '`' || escaped == '$' || self.isLineTerminator(escaped))) {
      return;
    }

    let literalKind: str = inTemplate ? "template" : "string";

    if (escaped == 'u') {
      let mut valid: boolean = false;

      if (let Option::SOME(codepoint) = self.scanUnicodeEscapeValue()) {
        valid = codepoint <= 1114111 && (codepoint < 55296 || codepoint > 57343);
      }

      if (!valid) {
        let escape: String = self.cursor.lexemeFrom(escapeStart);
        let message: String = `Invalid unicode escape '${escape.toStr()}' in ${literalKind} literal`;
        self.emitDiagnostic(escapeStart, DiagnosticCode::INVALID_CHARACTER_ESCAPE_SEQUENCE, message.toStr(), "unicode escape must be \\u{...} with one to six hex digits naming a Unicode scalar");
      }

      return;
    }

    let escape: String = self.cursor.lexemeFrom(escapeStart);
    let message: String = `Unknown escape sequence '${escape.toStr()}' in ${literalKind} literal`;
    self.emitDiagnostic(escapeStart, DiagnosticCode::INVALID_CHARACTER_ESCAPE_SEQUENCE, message.toStr(), "escape must be one of \\a \\b \\f \\n \\r \\t \\v \\0 \\\\ \\' \\\" or \\u{...}");
  }

  private scanCharEscape(&mut self, start: SourceMark): boolean {
    let Option::SOME(next) = self.cursor.peekChar() else {
      self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_CHARACTER, "Unterminated character literal", "char literal must end with a closing quote");
      return false;
    };

    if (next == '\0') {
      let nulStart: SourceMark = self.cursor.mark();
      self.cursor.advanceChar();
      self.emitRawNulInSource(nulStart);
      self.recoverMalformedCharLiteral();

      let lexeme: String = self.cursor.lexemeFrom(start);
      self.emitToken(Token::badOwned(self.cursor.spanFrom(start), &lexeme));
      return false;
    }

    if (self.isSingleCharacterEscape(next)) {
      self.cursor.advanceChar();
      return true;
    }

    if (next != 'u') {
      self.recoverMalformedCharLiteral();
      self.emitBadLiteral(start, DiagnosticCode::INVALID_CHARACTER_ESCAPE_SEQUENCE, "Invalid char escape: expected a valid Unicode scalar", "char escape must be a known escape or \\u{...}");
      return false;
    }

    self.cursor.advanceChar();
    let Option::SOME(codepoint) = self.scanUnicodeEscapeValue() else {
      self.recoverMalformedCharLiteral();
      self.emitBadLiteral(start, DiagnosticCode::INVALID_CHARACTER_ESCAPE_SEQUENCE, "Invalid char escape: expected a valid Unicode scalar", "unicode escape must contain one valid scalar value");
      return false;
    };

    if (codepoint > 1114111 || (codepoint >= 55296 && codepoint <= 57343)) {
      self.recoverMalformedCharLiteral();
      self.emitBadLiteral(start, DiagnosticCode::INVALID_CHARACTER_ESCAPE_SEQUENCE, "Invalid char escape: expected a valid Unicode scalar", "unicode escape must contain one valid scalar value");
      return false;
    }

    return true;
  }

  private scanCharLiteral(&mut self, start: SourceMark): void {
    let Option::SOME(next) = self.cursor.peekChar() else {
      self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_CHARACTER, "Unterminated character literal", "char literal must end with a closing quote");
      return;
    };

    if (next == '\'') {
      self.cursor.advanceChar();
      self.emitBadLiteral(start, DiagnosticCode::INVALID_CHARACTER, "Invalid char literal: expected exactly one Unicode scalar value", "char literal must contain exactly one UTF-8 scalar");
      return;
    }

    if (self.isLineTerminator(next)) {
      self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_CHARACTER, "Unterminated character literal", "char literal must end with a closing quote");
      return;
    }

    if (next == '\0') {
      let nulStart: SourceMark = self.cursor.mark();
      self.cursor.advanceChar();
      self.emitRawNulInSource(nulStart);
      self.recoverMalformedCharLiteral();

      let lexeme: String = self.cursor.lexemeFrom(start);
      self.emitToken(Token::badOwned(self.cursor.spanFrom(start), &lexeme));
      return;
    }

    if (next == '\\') {
      self.cursor.advanceChar();

      if (!self.scanCharEscape(start)) {
        return;
      }
    } else {
      self.cursor.advanceChar();
    }

    let Option::SOME(closer) = self.cursor.peekChar() else {
      self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_CHARACTER, "Unterminated character literal", "char literal must end with a closing quote");
      return;
    };

    if (closer == '\'') {
      self.cursor.advanceChar();
      self.emitLiteral(start, LiteralKind::CHAR);
      return;
    }

    if (self.isLineTerminator(closer)) {
      self.emitBadLiteral(start, DiagnosticCode::UNTERMINATED_CHARACTER, "Unterminated character literal", "char literal must end with a closing quote");
      return;
    }

    self.recoverMalformedCharLiteral();
    self.emitBadLiteral(start, DiagnosticCode::INVALID_CHARACTER, "Invalid char literal: expected exactly one Unicode scalar value", "char literal must contain exactly one UTF-8 scalar");
  }

  private scanIdentifierTail(&mut self): void {
    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (!isIdentifierContinue(next)) {
        return;
      }

      self.cursor.advanceChar();
    }
  }

  private scanLineComment(&mut self): void {
    while (let Option::SOME(next) = self.cursor.peekChar()) {
      if (next == '\n' || next == '\r') {
        return;
      }

      if (next == '\0') {
        let nulStart: SourceMark = self.cursor.mark();
        self.cursor.advanceChar();
        self.emitRawNulInSource(nulStart);
        continue;
      }

      self.cursor.advanceChar();
    }
  }

  private scanBlockCommentBody(&mut self): boolean {
    while (let Option::SOME(current) = self.cursor.peekChar()) {
      let mut closesComment: boolean = false;

      if (current == '*') {
        closesComment = match (self.cursor.peekNextChar()) {
          Option::SOME(next) -> next == '/',
          Option::NONE -> false,
        };
      }

      if (closesComment) {
        self.cursor.advanceChar();
        self.cursor.advanceChar();
        return true;
      }

      if (current == '\0') {
        let nulStart: SourceMark = self.cursor.mark();
        self.cursor.advanceChar();
        self.emitRawNulInSource(nulStart);
        continue;
      }

      self.cursor.advanceChar();
    }

    return false;
  }

  private scanSlashFamily(&mut self, start: SourceMark): void {
    if (self.matchAscii('=')) {
      self.emitPunctuation(start, Punctuation::DIV_ASSIGN, "/=");
      return;
    }

    if (self.matchAscii('/')) {
      let mut kind: TokenKind = TokenKind::LINE_COMMENT;

      if (self.matchAscii('!')) {
        kind = TokenKind::INNER_DOC_COMMENT;
      } else if (self.matchAscii('/')) {
        if (!self.matchAscii('/')) {
          kind = TokenKind::OUTER_DOC_COMMENT;
        }
      }

      self.scanLineComment();
      self.emitComment(start, kind);
      return;
    }

    if (self.matchAscii('*')) {
      let mut kind: TokenKind = TokenKind::BLOCK_COMMENT;

      if (self.matchAscii('!')) {
        kind = TokenKind::INNER_DOC_COMMENT;
      } else if (self.matchAscii('*')) {
        kind = TokenKind::OUTER_DOC_COMMENT;
      }

      if (!self.scanBlockCommentBody()) {
        self.emitUnterminatedComment(start);
        return;
      }

      self.emitComment(start, kind);
      return;
    }

    self.emitPunctuation(start, Punctuation::SLASH, "/");
  }

  private scanDotFamily(&mut self, start: SourceMark): void {
    if (!self.matchAscii('.')) {
      self.emitPunctuation(start, Punctuation::DOT, ".");
      return;
    }

    if (self.matchAscii('.')) {
      self.emitPunctuation(start, Punctuation::VARIADIC, "...");
      return;
    }

    if (self.matchAscii('=')) {
      self.emitPunctuation(start, Punctuation::RANGE_INCLUSIVE, "..=");
      return;
    }

    self.emitPunctuation(start, Punctuation::RANGE, "..");
  }

  private scanLessFamily(&mut self, start: SourceMark): void {
    if (self.matchAscii('<')) {
      if (self.matchAscii('=')) {
        self.emitPunctuation(start, Punctuation::LEFT_SHIFT_ASSIGN, "<<=");
        return;
      }

      self.emitPunctuation(start, Punctuation::LEFT_SHIFT, "<<");
      return;
    }

    if (self.matchAscii('=')) {
      self.emitPunctuation(start, Punctuation::LESS_EQUAL, "<=");
      return;
    }

    self.emitPunctuation(start, Punctuation::LESS, "<");
  }

  private scanGreaterFamily(&mut self, start: SourceMark): void {
    if (self.matchAscii('>')) {
      if (self.matchAscii('=')) {
        self.emitPunctuation(start, Punctuation::RIGHT_SHIFT_ASSIGN, ">>=");
        return;
      }

      self.emitPunctuation(start, Punctuation::RIGHT_SHIFT, ">>");
      return;
    }

    if (self.matchAscii('=')) {
      self.emitPunctuation(start, Punctuation::GREATER_EQUAL, ">=");
      return;
    }

    self.emitPunctuation(start, Punctuation::GREATER, ">");
  }

  private scanPipeFamily(&mut self, start: SourceMark): void {
    if (self.matchAscii('|')) {
      self.emitPunctuation(start, Punctuation::OR, "||");
      return;
    }

    if (self.matchAscii('>')) {
      self.emitPunctuation(start, Punctuation::PIPE_FORWARD, "|>");
      return;
    }

    if (self.matchAscii('=')) {
      self.emitPunctuation(start, Punctuation::OR_ASSIGN, "|=");
      return;
    }

    self.emitPunctuation(start, Punctuation::PIPE, "|");
  }

  private scanAmpersandFamily(&mut self, start: SourceMark): void {
    if (self.matchAscii('&')) {
      self.emitPunctuation(start, Punctuation::AND, "&&");
      return;
    }

    if (self.matchAscii('=')) {
      self.emitPunctuation(start, Punctuation::AND_ASSIGN, "&=");
      return;
    }

    self.emitPunctuation(start, Punctuation::AMPERSAND, "&");
  }

  private scanGrammarToken(&mut self, start: SourceMark, current: char): void {
    match (current) {
      '(' -> self.scanLeftParen(start),
      ')' -> self.scanRightParen(start),
      '{' -> self.scanLeftBrace(start),
      '}' -> self.scanRightBrace(start),
      '[' -> self.emitPunctuation(start, Punctuation::LEFT_BRACKET, "["),
      ']' -> self.emitPunctuation(start, Punctuation::RIGHT_BRACKET, "]"),
      ',' -> self.emitPunctuation(start, Punctuation::COMMA, ","),
      ';' -> self.scanSemicolon(start),
      '@' -> self.emitPunctuation(start, Punctuation::AT, "@"),
      '#' -> self.emitPunctuation(start, Punctuation::HASH, "#"),
      '?' -> self.emitPunctuation(start, Punctuation::QUESTION_MARK, "?"),
      '.' -> self.scanDotFamily(start),
      '+' -> {
        if (self.matchAscii('+')) {
          self.emitPunctuation(start, Punctuation::INCREMENT, "++");
        } else if (self.matchAscii('=')) {
          self.emitPunctuation(start, Punctuation::ADD_ASSIGN, "+=");
        } else {
          self.emitPunctuation(start, Punctuation::PLUS, "+");
        }
      },
      '-' -> {
        if (self.matchAscii('-')) {
          self.emitPunctuation(start, Punctuation::DECREMENT, "--");
        } else if (self.matchAscii('=')) {
          self.emitPunctuation(start, Punctuation::SUBTRACT_ASSIGN, "-=");
        } else if (self.matchAscii('>')) {
          self.emitPunctuation(start, Punctuation::ARROW, "->");
        } else {
          self.emitPunctuation(start, Punctuation::MINUS, "-");
        }
      },
      '*' -> {
        if (self.matchAscii('=')) {
          self.emitPunctuation(start, Punctuation::MUL_ASSIGN, "*=");
        } else {
          self.emitPunctuation(start, Punctuation::ASTERISK, "*");
        }
      },
      '/' -> self.scanSlashFamily(start),
      '%' -> {
        if (self.matchAscii('=')) {
          self.emitPunctuation(start, Punctuation::MOD_ASSIGN, "%=");
        } else {
          self.emitPunctuation(start, Punctuation::MOD, "%");
        }
      },
      '!' -> {
        if (self.matchAscii('=')) {
          self.emitPunctuation(start, Punctuation::BANG_EQUAL, "!=");
        } else {
          self.emitPunctuation(start, Punctuation::BANG, "!");
        }
      },
      '=' -> {
        if (self.matchAscii('=')) {
          self.emitPunctuation(start, Punctuation::EQUAL_EQUAL, "==");
        } else {
          self.emitPunctuation(start, Punctuation::EQUAL, "=");
        }
      },
      '<' -> self.scanLessFamily(start),
      '>' -> self.scanGreaterFamily(start),
      '|' -> self.scanPipeFamily(start),
      '&' -> self.scanAmpersandFamily(start),
      '^' -> {
        if (self.matchAscii('=')) {
          self.emitPunctuation(start, Punctuation::XOR_ASSIGN, "^=");
        } else {
          self.emitPunctuation(start, Punctuation::CARET, "^");
        }
      },
      '~' -> {
        if (self.matchAscii('=')) {
          self.emitPunctuation(start, Punctuation::NOT_ASSIGN, "~=");
        } else {
          self.emitPunctuation(start, Punctuation::TILDE, "~");
        }
      },
      ':' -> {
        if (self.matchAscii(':')) {
          self.emitPunctuation(start, Punctuation::DOUBLE_COLON, "::");
        } else {
          self.emitPunctuation(start, Punctuation::COLON, ":");
        }
      },
      ' ' | '\t' | '\r' | '\n' -> {},
      _ -> self.emitInvalidToken(start),
    };
  }

  public scanAll(&mut self): void {
    while (!self.cursor.isAtEnd()) {
      let start: SourceMark = self.cursor.mark();
      let Option::SOME(current) = self.cursor.advanceChar() else {
        break;
      };

      if (current == '\0') {
        self.emitRawNulInSource(start);
        continue;
      }

      if (current.isAsciiNumeric()) {
        self.scanNumberLiteral(start, current);
        continue;
      }

      if (current == '"') {
        self.scanStringLiteral(start);
        continue;
      }

      if (current == '`') {
        self.scanTemplateLiteral(start);
        continue;
      }

      if (current == '\'') {
        self.scanCharLiteral(start);
        continue;
      }

      if (isIdentifierStart(current)) {
        self.scanIdentifierTail();
        self.emitIdentifierOrKeyword(start);
        continue;
      }

      self.scanGrammarToken(start, current);
    }

    let end: SourceMark = self.cursor.mark();
    self.emitToken(Token::eof(self.cursor.spanFrom(end)));
  }
}

export namespace Lexer {
  function lex(file: &SourceFile): LexResult {
    let mut scanner: LexerScanner = LexerScanner::create(file);
    scanner.scanAll();

    return LexResult {
      tokens: scanner.tokens.clone(),
      diagnostics: scanner.diagnostics,
    };
  }
}
