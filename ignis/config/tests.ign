@test
function projectLoaderReportsMissingEntryPath(): void {
  let configPath: Path::PathBuf = fixturePath("test_cases/selfhost/resolver/config/missing_entry/ignis.toml");
  expectSingleDiagnosticCode(Config::loadProjectFile(&configPath), ConfigDiagnosticCode::PATH_NOT_FOUND);
}

/// `Config::loadProject` given a source file loads the project that governs
/// it, entry and all. That is the lookup for a project; it is not how the CLI
/// treats a named `.ign` file, which it compiles on its own without reading
/// any ignis.toml (`resolveTarget` and `Resolver::discoverFile`).
///
/// An unmet precondition returns quietly instead of failing a suite that ran
/// somewhere no project file governs the fixture.
@test
function projectLoaderFromASourceFileLoadsTheGoverningProject(): void {
  let namedFile: Path::PathBuf = fixturePath("test_cases/e2e/ok/drop_basic.ign");

  if (!Fs::exists(namedFile.asStr())) {
    return;
  }

  let Option::SOME(configPath) = Config::findProjectFile(&namedFile) else {
    // Nothing governs the file here, so there is no project to load.
    return;
  };

  let configText: String = configPath.toString();
  assertEndsWith(&configText, "/ignis.toml");

  match (Config::loadProject(&namedFile)) {
    Result::OK(project) -> {
      let entryText: String = project.entryText();
      assertEndsWith(&entryText, "/ignis/main.ign");
    },
    Result::ERROR(_) -> Test::fail(),
  };
}

/// IGN-239: a key `ignis.toml` does not recognize warns with a table path and,
/// when a known key is within edit distance 2, a suggestion. Wording is
/// shared byte-for-byte with the host's `ignis_driver::project::unknown_keys`.
@test
function unknownProjectKeyWarnsWithSuggestion(): void {
  let source: String = String::create(
    "[package]\nname = \"t\"\nversion = \"0.1.0\"\n\n[ignis]\nstd_pth = \"../std\"\n"
  );
  let document: TomlDocument = match (Toml::parse(&source)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let configPath: Path::PathBuf = Path::PathBuf::create("ignis.toml");
  let warnings: DiagnosticBag = checkUnknownProjectKeys(&document, &configPath);

  Test::assertEq<u64>(warnings.length(), 1);
  let Option::SOME(diagnostic) = warnings.get(0) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(diagnostic.code, ConfigDiagnosticCode::UNKNOWN_KEY);
  Test::assertEq<str>(
    diagnostic.messageText(),
    "unknown key 'std_pth' in [ignis]; did you mean 'std_path'?"
  );
}

/// A key with no known key within edit distance 2 warns without a suggestion.
@test
function unknownProjectKeyWarnsWithoutSuggestionWhenNothingIsClose(): void {
  let source: String = String::create(
    "[package]\nname = \"t\"\nversion = \"0.1.0\"\n\n[build]\ntotally_unrelated_garbage = 1\n"
  );
  let document: TomlDocument = match (Toml::parse(&source)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let configPath: Path::PathBuf = Path::PathBuf::create("ignis.toml");
  let warnings: DiagnosticBag = checkUnknownProjectKeys(&document, &configPath);

  Test::assertEq<u64>(warnings.length(), 1);
  let Option::SOME(diagnostic) = warnings.get(0) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(diagnostic.messageText(), "unknown key 'totally_unrelated_garbage' in [build]");
}

/// An unrecognized top-level table warns too, labeled "top-level".
@test
function unknownTopLevelTableWarns(): void {
  let source: String = String::create("[package]\nname = \"t\"\nversion = \"0.1.0\"\n\n[buld]\nopt_level = 2\n");
  let document: TomlDocument = match (Toml::parse(&source)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let configPath: Path::PathBuf = Path::PathBuf::create("ignis.toml");
  let warnings: DiagnosticBag = checkUnknownProjectKeys(&document, &configPath);

  Test::assertEq<u64>(warnings.length(), 1);
  let Option::SOME(diagnostic) = warnings.get(0) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(diagnostic.messageText(), "unknown key 'buld' in [top-level]; did you mean 'build'?");
}

/// Every known key across every known table produces no warnings, and
/// `aliases` (a free-form map) is never checked.
@test
function everyKnownProjectKeyStaysSilent(): void {
  let source: String = String::create(
    "[package]\nname = \"t\"\nversion = \"0.1.0\"\nauthors = [\"me\"]\ndescription = \"d\"\nkeywords = [\"k\"]\nlicense = \"MIT\"\nrepository = \"https://example.com\"\n\n[ignis]\nstd = true\nstd_path = \"../std\"\n\n[build]\nbin = true\nsource_dir = \"src\"\nentry = \"main.ign\"\nout_dir = \"build\"\nopt_level = 2\ndebug = true\ntarget = \"c\"\ntarget_triple = \"x86_64-unknown-linux-gnu\"\nknown_features = [\"a\"]\ndefault_features = [\"a\"]\ncc = \"gcc\"\nlinker = \"mold\"\ncflags = [\"-Wall\"]\nemit = [\"c\"]\n\n[test]\nfixtures = [\"fixtures\"]\n\n[aliases]\nmylib = \"libs/mylib\"\n"
  );
  let document: TomlDocument = match (Toml::parse(&source)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let configPath: Path::PathBuf = Path::PathBuf::create("ignis.toml");
  let warnings: DiagnosticBag = checkUnknownProjectKeys(&document, &configPath);

  Test::assertEq<u64>(warnings.length(), 0);
}

/// IGN-239 review round 3 #1: a reopened table (`[package.extra]` does not
/// create a new root-level entry; TOML merges it into the already-declared
/// `package` table as a nested child) means recursing into each root entry's
/// subtree as soon as it is visited does not produce file order: `package`
/// was declared first, but its reopened issue sits later in the file than
/// `build`'s own. Warnings must be sorted by position after the full walk.
@test
function unknownProjectKeyWarningsSortByPositionAcrossAReopenedTable(): void {
  let source: String = String::create(
    "[package]\nname = \"t\"\nversion = \"0.1.0\"\n\n[build]\nsource_dir = \"src\"\nentry = \"main.ign\"\nzebra_unknown = 1\n\n[package.extra]\nx = 1\n"
  );
  let document: TomlDocument = match (Toml::parse(&source)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let configPath: Path::PathBuf = Path::PathBuf::create("ignis.toml");
  let warnings: DiagnosticBag = checkUnknownProjectKeys(&document, &configPath);

  Test::assertEq<u64>(warnings.length(), 2);

  let Option::SOME(first) = warnings.get(0) else {
    Test::fail();
    return;
  };
  let Option::SOME(second) = warnings.get(1) else {
    Test::fail();
    return;
  };

  Test::assertEq<str>(first.messageText(), "unknown key 'zebra_unknown' in [build]");
  Test::assertEq<str>(second.messageText(), "unknown key 'extra' in [package]");
}

/// `std = false` with `std_path` names a user standard library, so the std
/// root and its manifest resolve from that path.
@test
function projectLoaderResolvesAFreestandingUserStdPath(): void {
  let start: Path::PathBuf = fixturePath("test_cases/freestanding/user_std");

  match (Config::loadProject(&start)) {
    Result::OK(project) -> {
      Test::assert(!project.stdEnabled);

      let Option::SOME(stdRootText) = project.stdRootText() else {
        Test::fail();
        return;
      };
      let Option::SOME(manifestPathText) = project.stdManifestPathText() else {
        Test::fail();
        return;
      };

      assertEndsWith(&stdRootText, "/test_cases/freestanding/user_std/kstd");
      assertEndsWith(&manifestPathText, "/test_cases/freestanding/user_std/kstd/manifest.toml");
    },
    Result::ERROR(_) -> Test::fail(),
  };
}

/// `std = false` without `std_path` has no std root at all: the official
/// standard library is never consulted.
@test
function projectLoaderLeavesTheFreestandingStdRootUnsetWithoutAStdPath(): void {
  let start: Path::PathBuf = fixturePath("test_cases/freestanding/no_std");

  match (Config::loadProject(&start)) {
    Result::OK(project) -> {
      Test::assert(!project.stdEnabled);
      Test::assert(project.stdRootText().isNone());
      Test::assert(project.stdManifestPathText().isNone());
    },
    Result::ERROR(_) -> Test::fail(),
  };
}

/// `[build] linker` is read as written; a project that omits it leaves the
/// selection to the default rule.
@test
function projectLoaderReadsBuildLinker(): void {
  let start: Path::PathBuf = fixturePath("test_cases/selfhost/build/linker_project");

  match (Config::loadProject(&start)) {
    Result::OK(project) -> assertSomeString(project.linkerText(), "bfd"),
    Result::ERROR(_) -> Test::fail(),
  };

  let withoutLinker: Path::PathBuf = fixturePath("test_cases/selfhost/build/build_profile");

  match (Config::loadProject(&withoutLinker)) {
    Result::OK(project) -> Test::assert(project.linkerText().isNone()),
    Result::ERROR(_) -> Test::fail(),
  };
}

/// `linker` is a known `[build]` key: it raises no unknown-key warning.
@test
function buildLinkerIsAKnownProjectKey(): void {
  let source: String = String::create(
    "[package]\nname = \"t\"\nversion = \"0.1.0\"\n\n[build]\nsource_dir = \"src\"\nentry = \"main.ign\"\nlinker = \"lld\"\n"
  );
  let document: TomlDocument = match (Toml::parse(&source)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let configPath: Path::PathBuf = Path::PathBuf::create("ignis.toml");
  let warnings: DiagnosticBag = checkUnknownProjectKeys(&document, &configPath);

  Test::assertEq<u64>(warnings.length(), 0);
}

/// `[build] std_archive` is read as written; a project that omits it keeps
/// std in its own unit.
@test
function projectLoaderReadsBuildStdArchive(): void {
  let start: Path::PathBuf = fixturePath("test_cases/selfhost/build/std_archive");

  match (Config::loadProject(&start)) {
    Result::OK(project) -> Test::assert(project.stdArchive),
    Result::ERROR(_) -> Test::fail(),
  };

  let without: Path::PathBuf = fixturePath("test_cases/selfhost/build/build_profile");

  match (Config::loadProject(&without)) {
    Result::OK(project) -> Test::assert(!project.stdArchive),
    Result::ERROR(_) -> Test::fail(),
  };
}

/// `std_archive` is a known `[build]` key: it raises no unknown-key warning.
@test
function buildStdArchiveIsAKnownProjectKey(): void {
  let source: String = String::create(
    "[package]\nname = \"t\"\nversion = \"0.1.0\"\n\n[build]\nsource_dir = \"src\"\nentry = \"main.ign\"\nstd_archive = true\n"
  );
  let document: TomlDocument = match (Toml::parse(&source)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let configPath: Path::PathBuf = Path::PathBuf::create("ignis.toml");
  let warnings: DiagnosticBag = checkUnknownProjectKeys(&document, &configPath);

  Test::assertEq<u64>(warnings.length(), 0);
}
