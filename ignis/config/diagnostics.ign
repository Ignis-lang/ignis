import Path from "std::path";

import
  Diagnostic,
  DiagnosticBag,
  DiagnosticCode,
  LabelKind,
  Severity,
  SourceMap,
  SourceSpan,
from "@compiler::diagnostics";

function configPathSpan(
  sourceMap: &mut SourceMap,
  path: &Path::PathBuf,
  start: u64,
  end: u64
): SourceSpan {
  return SourceSpan::new(sourceMap.register(path.asStr()), start, end);
}

function singleDiagnostic(diagnostic: Diagnostic): DiagnosticBag {
  let mut bag: DiagnosticBag = DiagnosticBag::init();
  bag.push(diagnostic);
  return bag;
}

export namespace ConfigDiagnosticCode {
  const CONFIG_NOT_FOUND: str = DiagnosticCode::CONFIG_NOT_FOUND;
  const MALFORMED_TOML: str = DiagnosticCode::CONFIG_MALFORMED_TOML;
  const INVALID_FIELD_TYPE: str = DiagnosticCode::CONFIG_INVALID_FIELD_TYPE;
  const EMPTY_FIELD: str = DiagnosticCode::CONFIG_EMPTY_FIELD;
  const RESERVED_ALIAS: str = DiagnosticCode::CONFIG_RESERVED_ALIAS;
  const PATH_NOT_FOUND: str = DiagnosticCode::CONFIG_PATH_NOT_FOUND;
  const MISSING_STD_MANIFEST: str = DiagnosticCode::CONFIG_MISSING_STD_MANIFEST;
  const UNKNOWN_KEY: str = DiagnosticCode::CONFIG_UNKNOWN_KEY;
}

export namespace ConfigDiagnostics {
  function configNotFound(sourceMap: &mut SourceMap, startPath: &Path::PathBuf): DiagnosticBag {
    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      ConfigDiagnosticCode::CONFIG_NOT_FOUND,
      "could not find ignis.toml while searching upward from the starting path",
      configPathSpan(sourceMap, startPath, 0, 0),
    );
    diagnostic.setHelp("create an ignis.toml at the project root or start in single-file mode");
    return singleDiagnostic(diagnostic);
  }

  function malformedToml(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    message: str,
    start: u64,
    end: u64
  ): DiagnosticBag {
    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      ConfigDiagnosticCode::MALFORMED_TOML,
      message,
      configPathSpan(sourceMap, path, start, end),
    );
    diagnostic.setHelp("fix the TOML syntax before loading the project configuration");
    return singleDiagnostic(diagnostic);
  }

  function invalidFieldType(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    fieldPath: str,
    expected: str,
    start: u64,
    end: u64
  ): DiagnosticBag {
    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      ConfigDiagnosticCode::INVALID_FIELD_TYPE,
      `config field '${fieldPath}' must be ${expected}`.toStr(),
      configPathSpan(sourceMap, path, start, end),
    );
    diagnostic.addLabel(LabelKind::PRIMARY, configPathSpan(sourceMap, path, start, end), "unexpected TOML value kind");
    return singleDiagnostic(diagnostic);
  }

  function emptyField(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    fieldPath: str,
    start: u64,
    end: u64
  ): DiagnosticBag {
    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      ConfigDiagnosticCode::EMPTY_FIELD,
      `config field '${fieldPath}' cannot be empty`.toStr(),
      configPathSpan(sourceMap, path, start, end),
    );
    diagnostic.addLabel(LabelKind::PRIMARY, configPathSpan(sourceMap, path, start, end), "empty values are not allowed here");
    return singleDiagnostic(diagnostic);
  }

  function reservedAlias(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    aliasName: str,
    start: u64,
    end: u64
  ): DiagnosticBag {
    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      ConfigDiagnosticCode::RESERVED_ALIAS,
      `alias '${aliasName}' is reserved`.toStr(),
      configPathSpan(sourceMap, path, start, end),
    );
    diagnostic.setHelp("rename the alias because 'std' is reserved for the standard library");
    return singleDiagnostic(diagnostic);
  }

  function pathNotFound(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    fieldPath: str,
    targetPath: &Path::PathBuf
  ): DiagnosticBag {
    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      ConfigDiagnosticCode::PATH_NOT_FOUND,
      `config path '${fieldPath}' does not exist`.toStr(),
      configPathSpan(sourceMap, path, 0, 0),
    );
    let targetText: String = targetPath.toString();
    diagnostic.addNote(`resolved path: ${targetText}`.toStr());
    return singleDiagnostic(diagnostic);
  }

  /// A key or table `ignis.toml` does not recognize. This is a warning, not an
  /// error: an unknown key (a leftover `runtime_path`, a typo) is silently
  /// ignored by the loader either way, so this only makes that visible instead
  /// of also failing the build.
  ///
  /// `tableLabel` is the dotted path of the enclosing table, or "top-level"
  /// for a key or table at the document root. `suggestion` names the closest
  /// known key within edit distance 2, if any. Wording is shared byte-for-byte
  /// with the host compiler's equivalent warning (`ignis_driver::project::unknown_keys`).
  function unknownKey(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    tableLabel: str,
    key: str,
    suggestion: Option<String>,
    start: u64,
    end: u64
  ): Diagnostic {
    let message: String = match (suggestion) {
      Option::SOME(name) -> `unknown key '${key}' in [${tableLabel}]; did you mean '${name}'?`,
      Option::NONE -> `unknown key '${key}' in [${tableLabel}]`,
    };

    return Diagnostic::new(
      Severity::WARNING,
      ConfigDiagnosticCode::UNKNOWN_KEY,
      message.toStr(),
      configPathSpan(sourceMap, path, start, end),
    );
  }

  function missingStdManifest(
    sourceMap: &mut SourceMap,
    path: &Path::PathBuf,
    stdRoot: &Path::PathBuf
  ): DiagnosticBag {
    let mut diagnostic: Diagnostic = Diagnostic::new(
      Severity::ERROR,
      ConfigDiagnosticCode::MISSING_STD_MANIFEST,
      "std is enabled but std/manifest.toml could not be resolved",
      configPathSpan(sourceMap, path, 0, 0),
    );
    let rootText: String = stdRoot.toString();
    diagnostic.addNote(`resolved std root: ${rootText}`.toStr());
    diagnostic.setHelp("set 'ignis.std_path' to a std tree that contains manifest.toml");
    return singleDiagnostic(diagnostic);
  }
}
