/// LeakSanitizer reports detected leaks by overwriting the process exit code.
const LEAK_EXIT_CODE: i32 = 23;

/// Count diagnostics in `bag` whose severity equals `target`.
function countBySeverity(bag: &DiagnosticBag, target: Severity): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diag) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diag.severity == target) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

/// Format a per-phase status line like `  lex  : ok (0 errors, 0 warnings)`.
/// Merge every module's evaluated constants into one map for LIR lowering,
/// which runs over the whole monomorphized program at once.
function collectProgramConstValues(
  records: &Vector<Analyzer::ModuleAnalysisRecord>,
): Analyzer::ConstEval::ConstValueMap {
  let mut merged: Analyzer::ConstEval::ConstValueMap = Analyzer::ConstEval::ConstValueMap {
    defIdRaws: Vector::new<u32>(),
    values: Vector::new<Analyzer::ConstEval::ConstValue>(),
  };
  let mut recordIndex: u64 = 0;

  while (recordIndex < records.length()) {
    let Option::SOME(analysisRecord) = records.get(recordIndex) else {
      recordIndex += 1;
      continue;
    };

    let moduleValues: &Analyzer::ConstEval::ConstValueMap = &analysisRecord.output.constValues.values;
    let mut valueIndex: u64 = 0;

    while (valueIndex < moduleValues.defIdRaws.length()) {
      let Option::SOME(defIdRaw) = moduleValues.defIdRaws.get(valueIndex) else {
        valueIndex += 1;
        continue;
      };
      let Option::SOME(value) = moduleValues.values.get(valueIndex) else {
        valueIndex += 1;
        continue;
      };

      merged.defIdRaws.push(*defIdRaw);
      merged.values.push(Analyzer::ConstEval::copyConstValue(value));
      valueIndex += 1;
    }

    recordIndex += 1;
  }

  return merged;
}

function formatPhaseLine(name: str, errors: u64, warnings: u64): String {
  let status: str = errors == 0 ? "ok" : "fail";

  return `  ${name}: ${status} (${errors} errors, ${warnings} warnings)`;
}

/// Render and print a diagnostic bag to stderr if it is non-empty.
function renderBagToStderr(bag: &DiagnosticBag, file: &SourceFile): void {
  if (bag.isEmpty()) {
    return;
  }

  let rendered: String = DiagnosticRenderer::renderBag(bag, file, true);
  Io::eprintln(rendered);
}

function analyzerModuleKind(kind: BuildModuleKind): Analyzer::Imports::ModuleKind {
  return match (kind) {
    BuildModuleKind::PROJECT -> Analyzer::Imports::ModuleKind::PROJECT,
    BuildModuleKind::STD -> Analyzer::Imports::ModuleKind::STD,
  };
}

function mapImportSourcesToDiscoveryTargets(
  module: &mut Ast::Module,
  graph: &BuildGraph,
  nodeIndex: u64,
): boolean {
  let Option::SOME(node) = graph.nodes.get(nodeIndex) else {
    return false;
  };
  let mut rootIndex: u64 = 0;

  while (rootIndex < module.roots.length()) {
    let Option::SOME(rootId) = module.roots.get(rootIndex) else {
      return false;
    };
    let Option::SOME(item) = module.items.getMut(*rootId) else {
      return false;
    };
    if (let Ast::Item::Node::Export(exportItem) = item) {
      // `export Name from "path"` carries a source too; it maps to its
      // discovery target the same way an import does.
      let Option::SOME(exportSource) = Ast::copyOptionalString(&exportItem.source) else {
        rootIndex += 1;
        continue;
      };

      let mut exportEdgeIndex: u64 = 0;
      let mut exportMatched: boolean = false;

      while (exportEdgeIndex < node.edges.length()) {
        let Option::SOME(edge) = node.edges.get(exportEdgeIndex) else {
          return false;
        };

        if (edge.source.equals(exportSource.toStr())) {
          let Option::SOME(target) = graph.nodes.get(edge.targetIndex) else {
            return false;
          };

          *item = Ast::Item::Node::Export(Ast::Item::Export {
            span: exportItem.span,
            declaration: exportItem.declaration,
            items: Ast::copyImportBindings(&exportItem.items),
            source: Option::SOME(target.path.toString()),
            sourceSpan: exportItem.sourceSpan,
            metadata: Ast::emptyMetadata(),
          });
          exportMatched = true;
          break;
        }

        exportEdgeIndex += 1;
      }

      if (!exportMatched) {
        return false;
      }

      rootIndex += 1;
      continue;
    }

    let Ast::Item::Node::Import(importItem) = item else {
      rootIndex += 1;
      continue;
    };
    let mut edgeIndex: u64 = 0;
    let mut matched: boolean = false;

    while (edgeIndex < node.edges.length()) {
      let Option::SOME(edge) = node.edges.get(edgeIndex) else {
        return false;
      };

      if (edge.source.equals(importItem.source.toStr())) {
        let Option::SOME(target) = graph.nodes.get(edge.targetIndex) else {
          return false;
        };

        *item = Ast::Item::Node::Import(Ast::Item::Import {
          span: importItem.span,
          items: Ast::copyImportBindings(&importItem.items),
          source: target.path.toString(),
          sourceSpan: importItem.sourceSpan,
          metadata: Ast::emptyMetadata(),
        });
        matched = true;
        break;
      }

      edgeIndex += 1;
    }

    if (!matched) {
      return false;
    }

    rootIndex += 1;
  }

  return true;
}

/// The C toolchain profile a build runs under.
record BuildProfile {
  public optLevel: u64;
  public debug: boolean;
  /// The project's `[build] cflags`, forwarded verbatim to the C toolchain.
  public cflags: Vector<String>;
  /// The project's `[build] cc`, the driver every toolchain step is invoked with.
  public cc: String;
}

function buildProfileCloneStrings(source: &Vector<String>): Vector<String> {
  let mut result: Vector<String> = Vector::new<String>();
  let mut index: u64 = 0;

  while (index < source.length()) {
    let Option::SOME(value) = source.get(index) else {
      break;
    };

    result.push(value.clone());
    index += 1;
  }

  return result;
}

/// Resolve the profile the C toolchain is invoked with.
///
/// The debug half is whatever discovery already resolved for `@debug()`, so the
/// `-g` the compiler receives and the predicate the source sees can never
/// disagree. `-O` / `--opt-level` overrides the project's `[build] opt_level`.
function resolveBuildProfile(discovery: &DiscoveryResult, optLevel: Option<u64>): BuildProfile {
  let mut profile: BuildProfile = BuildProfile {
    optLevel: discovery.optLevel,
    debug: discovery.flags.debug,
    cflags: buildProfileCloneStrings(&discovery.cflags),
    cc: discovery.cc.clone(),
  };

  if (let Option::SOME(level) = optLevel) {
    profile.optLevel = level;
  }

  return profile;
}

/// Compile and link one fixture's translation unit without reporting anything.
///
/// A fixture's toolchain failure belongs to that fixture's own report block,
/// not to the run's output, so nothing is printed and nothing is rendered.
///
/// Returns 0 when every toolchain step succeeds and 1 when any one fails.
function compileAndLinkQuietly(
  sourcePaths: &Vector<Path::PathBuf>,
  objectPaths: &Vector<Path::PathBuf>,
  outputPath: &Path::PathBuf,
  stdRoot: &Path::PathBuf,
  profile: &BuildProfile,
): u64 {
  let cc: str = profile.cc.toStr();
  let runtimeDir: Path::PathBuf = stdRoot.join("runtime");

  let mut includeDirs: Vector<String> = Vector::new<String>();
  includeDirs.push(runtimeDir.toString());

  let extraFlags: Vector<String> = CCompiler::profileFlags(profile.optLevel, profile.debug, &profile.cflags);

  let mut objects: Vector<String> = Vector::new<String>();
  let mut unitIndex: u64 = 0;

  while (unitIndex < objectPaths.length()) {
    let Option::SOME(objectPath) = objectPaths.get(unitIndex) else {
      break;
    };

    objects.push(objectPath.toString());
    unitIndex += 1;
  }

  if (let Result::ERROR(_) = CCompiler::compileObjects(
    cc,
    sourcePaths,
    objectPaths,
    &includeDirs,
    &extraFlags,
    1,
  )) {
    return 1;
  }

  let mut archives: Vector<String> = Vector::new<String>();
  archives.push(runtimeDir.join("libignis_rt.a").toString());

  let mut libs: Vector<String> = Vector::new<String>();
  libs.push(String::create("m"));

  let linkFlags: Vector<String> = CCompiler::profileFlags(profile.optLevel, profile.debug, &profile.cflags);

  if (let Result::ERROR(_) = Linker::link(cc, outputPath, &objects, &archives, &libs, &linkFlags)) {
    return 1;
  }

  return 0;
}

/// Compile every emitted translation unit and link them into an executable.
///
/// Returns 0 when every toolchain step succeeds and 1 when any one fails.
function compileAndLinkUnits(
  sourcePaths: &Vector<Path::PathBuf>,
  objectPaths: &Vector<Path::PathBuf>,
  outputPath: &Path::PathBuf,
  stdRoot: &Path::PathBuf,
  profile: &BuildProfile,
  file: &SourceFile,
): u64 {
  let cc: str = profile.cc.toStr();
  let runtimeDir: Path::PathBuf = stdRoot.join("runtime");

  let mut includeDirs: Vector<String> = Vector::new<String>();
  includeDirs.push(runtimeDir.toString());

  let extraFlags: Vector<String> = CCompiler::profileFlags(profile.optLevel, profile.debug, &profile.cflags);

  let mut objects: Vector<String> = Vector::new<String>();
  let mut unitIndex: u64 = 0;

  while (unitIndex < objectPaths.length()) {
    let Option::SOME(objectPath) = objectPaths.get(unitIndex) else {
      break;
    };

    objects.push(objectPath.toString());
    unitIndex += 1;
  }

  if (let Result::ERROR(compileBag) = CCompiler::compileObjects(
    cc,
    sourcePaths,
    objectPaths,
    &includeDirs,
    &extraFlags,
    TestRunner::jobLimit(),
  )) {
    renderBagToStderr(&compileBag, file);
    Io::println(String::create("  link: failed"));
    return 1;
  }

  let mut archives: Vector<String> = Vector::new<String>();
  archives.push(runtimeDir.join("libignis_rt.a").toString());

  let mut libs: Vector<String> = Vector::new<String>();
  libs.push(String::create("m"));

  let linkFlags: Vector<String> = CCompiler::profileFlags(profile.optLevel, profile.debug, &profile.cflags);

  if (let Result::ERROR(linkBag) = Linker::link(
    cc,
    outputPath,
    &objects,
    &archives,
    &libs,
    &linkFlags,
  )) {
    renderBagToStderr(&linkBag, file);
    Io::println(String::create("  link: failed"));
    return 1;
  }

  Io::println(`  link: ${outputPath.asStr()}`);
  return 0;
}

/// How one run of the compile pipeline behaves.
record CompileOptions {
  /// Gather the project's `@test` functions and leave the entry wrapper out of
  /// the emitted unit, because the harness owns `main` in that build.
  public collectTests: boolean;
  /// Run codegen and return the emitted translation unit.
  public emitCode: boolean;
  /// Give every function external linkage, which a standard-library build needs.
  public exportAll: boolean;
  /// Print nothing and collect the diagnostics into the result instead, which is
  /// what a fixture compiled inside a test run needs.
  public quiet: boolean;
  /// Stop after the analysis phase, which is as far as a warning fixture looks.
  public stopAfterAnalyze: boolean;

  public static build(emitCode: boolean): CompileOptions {
    return CompileOptions {
      collectTests: false,
      emitCode: emitCode,
      exportAll: false,
      quiet: false,
      stopAfterAnalyze: false,
    };
  }
}

/// A test run compiles the project plus its test modules and hands `main` to
/// the harness translation unit.
function testCompileOptions(): CompileOptions {
  let mut options: CompileOptions = CompileOptions::build(true);
  options.collectTests = true;
  return options;
}

/// A standard-library build exports every function, because the archive it
/// produces is linked by translation units this build never sees.
function stdCompileOptions(): CompileOptions {
  let mut options: CompileOptions = CompileOptions::build(true);
  options.exportAll = true;
  return options;
}

/// A program fixture is compiled on its own and reports nothing of its own.
function fixtureCompileOptions(emitCode: boolean, stopAfterAnalyze: boolean): CompileOptions {
  let mut options: CompileOptions = CompileOptions::build(emitCode);
  options.quiet = true;
  options.stopAfterAnalyze = stopAfterAnalyze;
  return options;
}

/// The emitted translation unit plus what the frontend measured.
record CompiledProgram {
  /// The emitted C, empty when a phase before codegen failed.
  public source: String;
  /// The project's `@test` functions, empty unless the caller asked for them.
  public tests: Vector<TestCase>;
  public errors: u64;
  public warnings: u64;
  /// Error texts, collected only under `quiet`. Front-end entries carry the
  /// bare message; ownership and borrow entries carry their notes too, because
  /// that is what the fixture baselines hold.
  public errorMessages: Vector<String>;
  /// Warning texts, collected only under `quiet`, always bare.
  public warningMessages: Vector<String>;
}

function failedCompilation(errors: u64, warnings: u64): CompiledProgram {
  return CompiledProgram {
    source: String::new(),
    tests: Vector::new<TestCase>(),
    errors: errors,
    warnings: warnings,
    errorMessages: Vector::new<String>(),
    warningMessages: Vector::new<String>(),
  };
}

/// Appends the messages of every diagnostic in `bag` with `target` severity.
///
/// `includeNotes` renders each note as its own `  note: <text>` line under the
/// message, which is how the host records an ownership or borrow failure.
function collectDiagnosticMessages(
  bag: &DiagnosticBag,
  target: Severity,
  includeNotes: boolean,
  out: &mut Vector<String>,
): void {
  let mut outRef: &mut Vector<String> = out;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diagnostic) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diagnostic.severity != target) {
      index += 1;
      continue;
    }

    let mut text: String = diagnostic.message.clone();

    if (includeNotes) {
      let mut noteIndex: u64 = 0;

      while (noteIndex < diagnostic.notes.length()) {
        if (let Option::SOME(note) = diagnostic.notes.get(noteIndex)) {
          text.pushStr("\n  note: ");
          text.push(&note.message);
        }

        noteIndex += 1;
      }
    }

    outRef.push(text);
    index += 1;
  }
}

/// Render a module-discovery failure the way the phase lines do.
function reportDiscoveryFailure(diagnostics: &DiagnosticBag, file: &SourceFile): void {
  let discoveryErrors: u64 = countBySeverity(diagnostics, Severity::ERROR);
  let discoveryWarnings: u64 = countBySeverity(diagnostics, Severity::WARNING);

  Io::println(formatPhaseLine("discover", discoveryErrors, discoveryWarnings));
  renderBagToStderr(diagnostics, file);
  Io::println(
    `  summary: ${discoveryErrors} errors, ${discoveryWarnings} warnings`
  );
}

/// Parse, analyze, lower and emit every module `discovery` reached.
///
/// `collectTests` gathers the project's `@test` functions and leaves the entry
/// wrapper out of the emitted unit, because the test harness owns `main` in
/// that build.
function compileDiscovered(
  discovery: &DiscoveryResult,
  file: &SourceFile,
  options: &CompileOptions,
): CompiledProgram {
  let collectTests: boolean = options.collectTests;
  let exportAll: boolean = options.exportAll;
  let quiet: boolean = options.quiet;
  let emitCode: boolean = options.emitCode && !options.stopAfterAnalyze;

  let mut errorMessages: Vector<String> = Vector::new<String>();
  let mut warningMessages: Vector<String> = Vector::new<String>();

  let mut modules: Vector<Ast::Module> = Vector::new<Ast::Module>();
  let mut files: Vector<SourceFile> = Vector::new<SourceFile>();
  let mut modulePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  let mut moduleIsProject: Vector<boolean> = Vector::new<boolean>();
  let mut infos: Vector<Analyzer::Imports::ModuleInfo> = Vector::new<Analyzer::Imports::ModuleInfo>();
  let mut lexErrors: u64 = 0;
  let mut lexWarnings: u64 = 0;
  let mut parseErrors: u64 = 0;
  let mut parseWarnings: u64 = 0;
  let mut rootCount: u64 = 0;
  let mut orderIndex: u64 = 0;

  while (orderIndex < discovery.order.length()) {
    let Option::SOME(nodeIndex) = discovery.order.get(orderIndex) else {
      Io::eprintln("error: discovery order is incomplete");
      return failedCompilation(1, 0);
    };
    let Option::SOME(node) = discovery.graph.nodes.get(*nodeIndex) else {
      Io::eprintln("error: discovery order references a missing module");
      return failedCompilation(1, 0);
    };
    let Result::OK(moduleText) = Fs::readToString(&node.path) else {
      Io::eprintln(`error: cannot read source file: ${node.path.toString().toStr()}`);
      return failedCompilation(1, 0);
    };

    let modulePath: String = node.path.toString();
    let moduleFile: SourceFile = SourceFile::create(modulePath.toStr(), moduleText.toStr());
    let mut output: ParseOutput = Parser::parseFileWithFlags(&moduleFile, &discovery.flags);

    lexErrors += countBySeverity(&output.lexDiagnostics, Severity::ERROR);
    lexWarnings += countBySeverity(&output.lexDiagnostics, Severity::WARNING);
    parseErrors += countBySeverity(&output.parseDiagnostics, Severity::ERROR);
    parseWarnings += countBySeverity(&output.parseDiagnostics, Severity::WARNING);
    rootCount += output.module.roots.length();

    if (quiet) {
      collectDiagnosticMessages(&output.lexDiagnostics, Severity::ERROR, false, &mut errorMessages);
      collectDiagnosticMessages(&output.parseDiagnostics, Severity::ERROR, false, &mut errorMessages);
      collectDiagnosticMessages(&output.lexDiagnostics, Severity::WARNING, false, &mut warningMessages);
      collectDiagnosticMessages(&output.parseDiagnostics, Severity::WARNING, false, &mut warningMessages);
    } else {
      renderBagToStderr(&output.lexDiagnostics, &moduleFile);
      renderBagToStderr(&output.parseDiagnostics, &moduleFile);
    }

    if (!mapImportSourcesToDiscoveryTargets(&mut output.module, &discovery.graph, *nodeIndex)) {
      Io::eprintln(`error: discovery graph import mapping is incomplete for ${modulePath.toStr()}`);
      return failedCompilation(1, 0);
    }

    let kind: Analyzer::Imports::ModuleKind = analyzerModuleKind(node.kind);
    let mut isProject: boolean = false;

    if (let Analyzer::Imports::ModuleKind::PROJECT = kind) {
      isProject = true;
    }

    modules.push(output.module);
    files.push(moduleFile);
    modulePaths.push(node.path.clone());
    moduleIsProject.push(isProject);
    infos.push(Analyzer::Imports::ModuleInfo {
      index: *nodeIndex,
      pathText: modulePath,
      kind: kind,
    });
    orderIndex += 1;
  }

  if (!quiet) {
    Io::println(formatPhaseLine("lex  ", lexErrors, lexWarnings));
    Io::println(formatPhaseLine("parse", parseErrors, parseWarnings));
    Io::println(`  roots: ${rootCount}`);
  }

  let frontendErrors: u64 = lexErrors + parseErrors;
  let frontendWarnings: u64 = lexWarnings + parseWarnings;

  if (frontendErrors > 0) {
    if (!quiet) {
      Io::println(String::create("  analyze: skipped (frontend errors)"));
    }

    let mut stopped: CompiledProgram = failedCompilation(frontendErrors, frontendWarnings);
    stopped.errorMessages = errorMessages;
    stopped.warningMessages = warningMessages;
    return stopped;
  }

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut preludePaths: Vector<String> = Vector::new<String>();
  let mut preludeIndex: u64 = 0;

  while (preludeIndex < discovery.preludePaths.length()) {
    if (let Option::SOME(preludePath) = discovery.preludePaths.get(preludeIndex)) {
      preludePaths.push(preludePath.toString());
    }

    preludeIndex += 1;
  }

  let records: Vector<Analyzer::ModuleAnalysisRecord> = Analyzer::analyzeProgram(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &modules,
    &infos,
    &preludePaths,
  );

  let mut analyzeErrors: u64 = 0;
  let mut analyzeWarnings: u64 = 0;
  let mut recordIndex: u64 = 0;

  while (recordIndex < records.length()) {
    let Option::SOME(analysisRecord) = records.get(recordIndex) else {
      Io::eprintln("error: analysis records are incomplete");
      return failedCompilation(frontendErrors + 1, frontendWarnings);
    };
    let Option::SOME(moduleFile) = files.get(recordIndex) else {
      Io::eprintln("error: analysis records do not align with parsed modules");
      return failedCompilation(frontendErrors + 1, frontendWarnings);
    };

    analyzeErrors += countBySeverity(&analysisRecord.output.diagnostics, Severity::ERROR);
    analyzeWarnings += countBySeverity(&analysisRecord.output.diagnostics, Severity::WARNING);

    if (quiet) {
      collectDiagnosticMessages(&analysisRecord.output.diagnostics, Severity::ERROR, false, &mut errorMessages);
      collectDiagnosticMessages(&analysisRecord.output.diagnostics, Severity::WARNING, false, &mut warningMessages);
    } else {
      renderBagToStderr(&analysisRecord.output.diagnostics, moduleFile);
    }

    recordIndex += 1;
  }

  if (!quiet) {
    Io::println(formatPhaseLine("analyze", analyzeErrors, analyzeWarnings));
  }

  // Lowering runs only over a clean analysis: its inputs assume every
  // reference resolved and every expression typed. Failures surface as
  // `HirKind::Error` nodes, counted per module.
  if (analyzeErrors > 0) {
    if (!quiet) {
      Io::println(String::create("  lower: skipped (analyze errors)"));
    }

    let mut stopped: CompiledProgram = failedCompilation(
      frontendErrors + analyzeErrors,
      frontendWarnings + analyzeWarnings,
    );
    stopped.errorMessages = errorMessages;
    stopped.warningMessages = warningMessages;
    return stopped;
  }

  // A warning fixture asks whether the front end is clean and what it warned
  // about, so nothing past analysis runs for it.
  if (options.stopAfterAnalyze) {
    return CompiledProgram {
      source: String::new(),
      tests: Vector::new<TestCase>(),
      errors: frontendErrors + analyzeErrors,
      warnings: frontendWarnings + analyzeWarnings,
      errorMessages: errorMessages,
      warningMessages: warningMessages,
    };
  }

  let mut tests: Vector<TestCase> = Vector::new<TestCase>();

  if (collectTests) {
    let sourceRoot: Path::PathBuf = TestRunner::sourceRootOf(&discovery.graph);
    let mut testModuleIndex: u64 = 0;

    while (testModuleIndex < records.length()) {
      let Option::SOME(isProject) = moduleIsProject.get(testModuleIndex) else {
        break;
      };

      if (*isProject) {
        let Option::SOME(analysisRecord) = records.get(testModuleIndex) else {
          break;
        };
        let Option::SOME(module) = modules.get(testModuleIndex) else {
          break;
        };
        let Option::SOME(modulePath) = modulePaths.get(testModuleIndex) else {
          break;
        };

        TestRunner::collectModuleTests(
          &mut defStore,
          &mut symbols,
          module,
          &analysisRecord.output.pass2,
          modulePath,
          &sourceRoot,
          &mut tests,
        );
      }

      testModuleIndex += 1;
    }

    if (!quiet) {
      Io::println(`  tests: ${tests.length()} discovered`);
    }
  }

  let mut loweredModules: u64 = 0;
  let mut hirErrorNodes: u64 = 0;
  let mut hirNodes: u64 = 0;
  let mut lowerIndex: u64 = 0;
  let mut programHir: Hir::HirStore = Hir::HirStore::init();

  while (lowerIndex < records.length()) {
    let Option::SOME(analysisRecord) = records.get(lowerIndex) else {
      lowerIndex += 1;
      continue;
    };
    let Option::SOME(module) = modules.get(lowerIndex) else {
      lowerIndex += 1;
      continue;
    };

    let moduleNodeStart: u64 = programHir.nodes.length();

    Lowering::lowerModuleInto(
      &mut defStore,
      &mut typeStore,
      &mut symbols,
      module,
      &analysisRecord.output,
      &mut programHir,
    );

    let mut nodeIndex: u64 = moduleNodeStart;
    while (nodeIndex < programHir.nodes.length()) {
      if (let Option::SOME(node) = programHir.nodes.get(nodeIndex)) {
        if (let Hir::HirKind::Error = node.kind) {
          hirErrorNodes += 1;
        }
      }
      nodeIndex += 1;
    }

    hirNodes += programHir.nodes.length() - moduleNodeStart;

    loweredModules += 1;
    lowerIndex += 1;
  }

  // Closures reach LIR with an environment layout and a thunk, so capture
  // analysis has to run over the whole program before monomorphization
  // clones any body.
  let captureDiagnostics: DiagnosticBag = Capture::populateClosureCaptures(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &mut programHir,
  );

  let captureErrors: u64 = countBySeverity(&captureDiagnostics, Severity::ERROR);
  let captureWarnings: u64 = countBySeverity(&captureDiagnostics, Severity::WARNING);

  if (quiet) {
    collectDiagnosticMessages(&captureDiagnostics, Severity::ERROR, true, &mut errorMessages);
    collectDiagnosticMessages(&captureDiagnostics, Severity::WARNING, false, &mut warningMessages);
  } else {
    Io::println(formatPhaseLine("capture", captureErrors, captureWarnings));
    renderBagToStderr(&captureDiagnostics, file);
  }

  let monoResult: Mono::MonoOutput = Mono::run(&mut defStore, &mut typeStore, &mut symbols, &programHir);
  let monoGenericNodes: u64 = Mono::countRemainingGenerics(&mut typeStore, &monoResult.hir);

  if (!quiet) {
    Io::println(`  mono: ${monoResult.instantiations} instantiations, ${monoResult.hir.nodes.length()} nodes, ${monoGenericNodes} generic nodes left`);
  }

  // Ownership and borrow checking runs over the monomorphized HIR, the same
  // program LIR lowering is about to walk: its drop schedules are keyed by
  // the nodes that walk visits.
  let checked: Borrowck::BorrowckOutput = Borrowck::checkModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &monoResult.hir,
  );

  let ownershipErrors: u64 = countBySeverity(&checked.diagnostics, Severity::ERROR);
  let ownershipWarnings: u64 = countBySeverity(&checked.diagnostics, Severity::WARNING);

  if (quiet) {
    collectDiagnosticMessages(&checked.diagnostics, Severity::ERROR, true, &mut errorMessages);
    collectDiagnosticMessages(&checked.diagnostics, Severity::WARNING, false, &mut warningMessages);
  } else {
    Io::println(formatPhaseLine("ownership", ownershipErrors, ownershipWarnings));
    renderBagToStderr(&checked.diagnostics, file);
  }

  // A check answers whether the program is well formed, so it stops with the
  // last phase that can say no. Nothing past this point reports a diagnostic.
  if (!emitCode) {
    return CompiledProgram {
      source: String::new(),
      tests: tests,
      errors: frontendErrors + analyzeErrors + captureErrors + ownershipErrors,
      warnings: frontendWarnings + analyzeWarnings + captureWarnings + ownershipWarnings,
      errorMessages: errorMessages,
      warningMessages: warningMessages,
    };
  }

  let programConstValues: Analyzer::ConstEval::ConstValueMap = collectProgramConstValues(&records);

  let mut lirResult: LirLowering::LowerModuleResult = LirLowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &monoResult.hir,
    &checked.dropSchedules,
    &programConstValues,
  );

  let verifyFindings: Vector<String> = LirVerify::verifyProgram(&mut defStore, &mut typeStore, &lirResult.program);

  if (!quiet) {
    Io::println(`  lower: ${hirErrorNodes} error nodes, ${hirNodes} hir nodes, ${loweredModules} modules`);
    Io::println(`  lir: ${lirResult.unsupported} unsupported, ${lirResult.loweredFunctions} functions, ${verifyFindings.length()} verify errors`);
  }

  // The harness translation unit defines `main` and calls the selected tests
  // directly, so the program unit must not carry an entry wrapper too.
  if (collectTests) {
    lirResult.program.entryPoint = Option::NONE;
  }

  // Every definition the program unit holds is private to it, except the test
  // functions the harness unit dispatches to by symbol. A standard-library
  // build exports every function instead, because the archive it produces is
  // linked by translation units this build never sees.
  let mut externalSymbols: Vector<u32> = Vector::new<u32>();

  if (exportAll) {
    let mut functionIndex: u64 = 0;

    while (functionIndex < lirResult.program.functions.length()) {
      let Option::SOME(defId) = lirResult.program.functions.defAt(functionIndex) else {
        break;
      };

      externalSymbols.push(defId.raw());
      functionIndex += 1;
    }
  }

  let mut externalIndex: u64 = 0;

  while (externalIndex < tests.length()) {
    let Option::SOME(testCase) = tests.get(externalIndex) else {
      break;
    };

    externalSymbols.push(testCase.defIdRaw);
    externalIndex += 1;
  }

  let emitResult: CodegenC::EmitOutput = CodegenC::emitProgram(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &lirResult.program,
    &externalSymbols,
  );

  if (!quiet) {
    Io::println(
      `  codegen: ${emitResult.unsupported} unsupported, ${emitResult.functions} functions, ${emitResult.source.length()} bytes`
    );
  }

  return CompiledProgram {
    source: emitResult.source,
    tests: tests,
    errors: frontendErrors + analyzeErrors + captureErrors + ownershipErrors,
    warnings: frontendWarnings + analyzeWarnings + captureWarnings + ownershipWarnings,
    errorMessages: errorMessages,
    warningMessages: warningMessages,
  };
}

/// Command-line values a build applies on top of the project file.
function buildOverridesFrom(options: &CliOptions): BuildOverrides {
  let mut overrides: BuildOverrides = BuildOverrides::none();
  overrides.debug = options.debug;
  overrides.features = buildProfileCloneStrings(&options.features);
  overrides.stdPath = cloneOptionalText(&options.stdPath);
  overrides.targetTriple = cloneOptionalText(&options.targetTriple);
  overrides.cc = cloneOptionalText(&options.cc);
  overrides.outDir = cloneOptionalText(&options.outDir);
  return overrides;
}

function cloneOptionalText(value: &Option<String>): Option<String> {
  return match (value) {
    Option::SOME(text) -> Option::SOME(text.clone()),
    Option::NONE -> Option::NONE,
  };
}

/// The source file diagnostics are rendered against.
///
/// Every module's diagnostics carry their own path, so this is the entry the
/// renderer falls back to when it needs source text.
function entrySourceFile(path: &Path::PathBuf): SourceFile {
  let text: String = match (Fs::readToString(path)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> String::new(),
  };
  let pathText: String = path.toString();

  return SourceFile::create(pathText.toStr(), text.toStr());
}

/// Create the directory a path lives in, so a toolchain step can write into it.
function ensureParentDirectory(path: &Path::PathBuf): boolean {
  let Option::SOME(parent) = path.parent() else {
    return true;
  };

  if (parent.isEmpty() || Fs::exists(parent.asStr())) {
    return true;
  }

  if (let Result::ERROR(_) = Fs::createDirAll(&parent)) {
    Io::eprintln(`error: could not create directory: ${parent.asStr()}`);
    return false;
  }

  return true;
}

/// Discover the module graph a command runs against, reporting what failed.
function discoverFor(
  startPath: &Path::PathBuf,
  options: &CliOptions,
  includeTests: boolean,
): Option<DiscoveryResult> {
  let overrides: BuildOverrides = buildOverridesFrom(options);

  match (Resolver::discover(startPath, &overrides, includeTests)) {
    Result::OK(value) -> {
      return Option::SOME(value);
    },
    Result::ERROR(diagnostics) -> {
      let file: SourceFile = entrySourceFile(startPath);
      reportDiscoveryFailure(&diagnostics, &file);
      return Option::NONE;
    },
  };

  return Option::NONE;
}

/// Compile the project `startPath` belongs to.
///
/// `checkOnly` stops after the last phase that can reject the program, which is
/// what `ignis check` reports on: nothing is emitted and nothing is linked.
/// `projectMode` writes the artifacts under `[build] out_dir` instead of the
/// working directory.
///
/// Returns 0 on success and 1 on any error (I/O, lex, parse, analyze, ownership
/// or linking).
function runCompile(
  startPath: &Path::PathBuf,
  options: &CliOptions,
  checkOnly: boolean,
  projectMode: boolean,
): i32 {
  let banner: str = checkOnly ? "ignis selfhost check" : "ignis selfhost (partial pipeline)";
  Io::println(String::create(banner));
  Io::println(`  source: ${startPath.asStr()}`);

  let Option::SOME(discovery) = discoverFor(startPath, options, false) else {
    return 1;
  };

  let file: SourceFile = entrySourceFile(&discovery.entry);
  let profile: BuildProfile = resolveBuildProfile(&discovery, options.optLevel);
  let compileOptions: CompileOptions = CompileOptions::build(!checkOnly);
  let compiled: CompiledProgram = compileDiscovered(&discovery, &file, &compileOptions);
  let mut linkErrors: u64 = 0;

  // The emitted translation unit is the next thing to feed to a C compiler,
  // and the `// unsupported instruction: <Variant>` comments in it are how the
  // remaining work is counted per variant.
  if (!checkOnly && compiled.source.length() > 0) {
    let artifacts: BuildArtifacts = projectMode ? projectArtifacts(&discovery.name, &discovery.outDir, &options.outputPath) : singleFileArtifacts(&options.outputPath);

    if (!ensureParentDirectory(&artifacts.source) || !ensureParentDirectory(&artifacts.object) || !ensureParentDirectory(&artifacts.executable)) {
      return 1;
    }

    if (let Result::ERROR(_) = Fs::writeString(&artifacts.source, &compiled.source)) {
      Io::println(`  emit: could not write ${artifacts.source.asStr()}`);
    } else {
      Io::println(`  emit: ${artifacts.source.asStr()}`);

      let mut sourcePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
      sourcePaths.push(artifacts.source.clone());

      let mut objectPaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
      objectPaths.push(artifacts.object.clone());

      if (discovery.bin) {
        linkErrors += compileAndLinkUnits(
          &sourcePaths,
          &objectPaths,
          &artifacts.executable,
          &discovery.stdRoot,
          &profile,
          &file,
        );
      }
    }
  }

  let totalErrors: u64 = compiled.errors + linkErrors;

  Io::println(
    `  summary: ${totalErrors} errors, ${compiled.warnings} warnings`
  );

  if (totalErrors > 0) {
    return 1;
  }

  return 0;
}

/// Every byte a fixture work directory name may carry, with anything else
/// replaced by `_`, mirroring the host's dump-name sanitizer.
function sanitizeFixtureName(name: &String): String {
  let mut sanitized: String = String::new();
  let mut index: u64 = 0;

  while (index < name.length()) {
    let Option::SOME(byte) = name.byteAt(index) else {
      break;
    };

    let isDigit: boolean = byte >= 48 && byte <= 57;
    let isUpper: boolean = byte >= 65 && byte <= 90;
    let isLower: boolean = byte >= 97 && byte <= 122;

    if (isDigit || isUpper || isLower || byte == 45 || byte == 95) {
      sanitized.pushByte(byte);
    } else {
      sanitized.pushByte(95);
    }

    index += 1;
  }

  return sanitized;
}

/// The file name without its last extension.
function fixtureStemOf(name: &String): String {
  let mut index: u64 = name.length();

  while (index > 1) {
    let Option::SOME(byte) = name.byteAt(index - 1) else {
      break;
    };

    if (byte == 46) {
      return name.substringBytes(0, index - 1);
    }

    index -= 1;
  }

  return name.clone();
}

/// The fixture directories a run reads, in the order the host resolves them:
/// what the project file declares, then what `--fixtures` added, without
/// repeating a directory both name.
function resolveFixtureDirs(
  discovery: &DiscoveryResult,
  options: &CliOptions
): Vector<Path::PathBuf> {
  let mut dirs: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  let mut declaredIndex: u64 = 0;

  while (declaredIndex < discovery.testFixtures.length()) {
    if (let Option::SOME(dir) = discovery.testFixtures.get(declaredIndex)) {
      dirs.push(dir.clone());
    }

    declaredIndex += 1;
  }

  let mut extraIndex: u64 = 0;

  while (extraIndex < options.fixtureDirs.length()) {
    let Option::SOME(rawDir) = options.fixtureDirs.get(extraIndex) else {
      break;
    };

    extraIndex += 1;

    let candidate: Path::PathBuf = Path::PathBuf::fromString(rawDir);
    let mut resolved: Path::PathBuf = candidate.clone();

    if (!candidate.isAbsolute()) {
      resolved = discovery.root.join(candidate.asStr()).normalize();
    }

    let resolvedText: String = resolved.toString();
    let mut seen: boolean = false;
    let mut seenIndex: u64 = 0;

    while (seenIndex < dirs.length()) {
      let Option::SOME(existing) = dirs.get(seenIndex) else {
        break;
      };

      if (existing.toString().equals(&resolvedText)) {
        seen = true;
        break;
      }

      seenIndex += 1;
    }

    if (!seen) {
      dirs.push(resolved.clone());
    }
  }

  return dirs;
}

/// Joins collected diagnostic texts with newlines, which is the body a
/// diagnostics or warnings fixture compares against its baseline.
function joinDiagnosticMessages(messages: &Vector<String>): String {
  let mut body: String = String::new();
  let mut index: u64 = 0;

  while (index < messages.length()) {
    let Option::SOME(message) = messages.get(index) else {
      break;
    };

    if (index > 0) {
      body.pushStr("\n");
    }

    body.push(message);
    index += 1;
  }

  return body;
}

/// Discovers the module graph a fixture compiles as, reporting nothing.
///
/// The discovery diagnostics reach the caller as ordinary error texts, because
/// a fixture that names a module it cannot reach fails on those.
function discoverFixtureGraph(
  fixture: &FixtureCase,
  projectStart: &Path::PathBuf,
  options: &CliOptions,
  errorsOut: &mut Vector<String>,
): Option<DiscoveryResult> {
  let overrides: BuildOverrides = buildOverridesFrom(options);

  match (Resolver::discoverFixture(&fixture.path, projectStart, &overrides)) {
    Result::OK(value) -> {
      return Option::SOME(value);
    },
    Result::ERROR(diagnostics) -> {
      collectDiagnosticMessages(&diagnostics, Severity::ERROR, false, errorsOut);
      return Option::NONE;
    },
  };

  return Option::NONE;
}

/// Compiles a program fixture, runs it and compares what it produced against
/// its baseline.
///
/// Returns an empty string when the fixture passed and the failure text
/// otherwise.
function runProgramFixture(
  fixture: &FixtureCase,
  projectStart: &Path::PathBuf,
  discovery: &DiscoveryResult,
  options: &CliOptions,
  timeoutSeconds: u64,
): String {
  if (fixture.mode.forceStd && !discovery.stdEnabled) {
    return String::create("fixture requires the standard library but the project has std disabled");
  }

  let sanitized: String = sanitizeFixtureName(&fixture.name);
  let workDir: Path::PathBuf = discovery.outDir.join("fixtures").join(sanitized.toStr());
  let _removed = Fs::removeDirAll(&workDir);

  if (let Result::ERROR(_) = Fs::createDirAll(&workDir)) {
    return `Failed to create fixture directory '${workDir.asStr()}'`;
  }

  let mut discoveryErrors: Vector<String> = Vector::new<String>();
  let Option::SOME(fixtureDiscovery) = discoverFixtureGraph(fixture, projectStart, options, &mut discoveryErrors) else {
    let reported: String = joinDiagnosticMessages(&discoveryErrors);
    return `compilation failed\n${reported.toStr()}`;
  };

  let file: SourceFile = entrySourceFile(&fixtureDiscovery.entry);
  let compileOptions: CompileOptions = fixtureCompileOptions(true, false);
  let compiled: CompiledProgram = compileDiscovered(&fixtureDiscovery, &file, &compileOptions);

  if (compiled.errors > 0 || compiled.source.length() == 0) {
    let body: String = joinDiagnosticMessages(&compiled.errorMessages);

    if (body.length() == 0) {
      return String::create("compilation failed");
    }

    return `compilation failed\n${body.toStr()}`;
  }

  let stem: String = match (fixture.path.fileName()) {
    Option::SOME(name) -> fixtureStemOf(&name),
    Option::NONE -> String::create("fixture"),
  };

  let sourceName: String = stem.concat(".c");
  let objectName: String = stem.concat(".o");
  let sourcePath: Path::PathBuf = workDir.join(sourceName.toStr());
  let objectPath: Path::PathBuf = workDir.join(objectName.toStr());
  let binaryPath: Path::PathBuf = workDir.join(stem.toStr());

  if (let Result::ERROR(_) = Fs::writeString(&sourcePath, &compiled.source)) {
    return `Failed to write fixture source '${sourcePath.asStr()}'`;
  }

  // Every fixture but one that leaks on purpose is linked leak-checkable, so a
  // program that forgets to free reports it instead of passing.
  let mut profile: BuildProfile = resolveBuildProfile(&fixtureDiscovery, options.optLevel);

  if (!fixture.mode.allowLeak) {
    profile.cflags.push(String::create("-fsanitize=leak"));
    profile.cflags.push(String::create("-g"));
    profile.cflags.push(String::create("-fno-omit-frame-pointer"));
  }

  let mut sourcePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  sourcePaths.push(sourcePath.clone());

  let mut objectPaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  objectPaths.push(objectPath.clone());

  if (compileAndLinkQuietly(&sourcePaths, &objectPaths, &binaryPath, &fixtureDiscovery.stdRoot, &profile) > 0) {
    return String::create("compilation failed");
  }

  let leakOptions: str = fixture.mode.allowLeak ? "detect_leaks=0" : "detect_leaks=1:leak_check_at_exit=1:use_stacks=0";

  let mut command: Process::Command = Process::Command::new(binaryPath.asStr());
  command.env("LSAN_OPTIONS", leakOptions);

  let Result::OK(spawned) = command.spawnCapturing() else {
    return `Failed to run fixture '${fixture.name.toStr()}'`;
  };

  let mut child: Process::Child = spawned;
  let outcome: ProcessOutcome = TestRunner::waitWithTimeout(&mut child, timeoutSeconds);

  if (outcome.spawnFailed) {
    return `Failed to run fixture '${fixture.name.toStr()}'`;
  }

  if (outcome.timedOut) {
    return TestRunner::formatTimeoutFailure(timeoutSeconds);
  }

  let split: FixtureLeakSplit = FixtureTests::splitLeakReport(&outcome.stderr);

  if (!fixture.mode.allowLeak && outcome.exitCode == LEAK_EXIT_CODE) {
    return `LeakSanitizer detected a memory leak\n${split.leak.toStr()}`;
  }

  let body: String = FixtureTests::formatProgramSnapshot(outcome.exitCode, &outcome.stdout, &split.program);
  let snapshotPath: Path::PathBuf = fixture.snapshotPath();

  return FixtureTests::compareSnapshot(&snapshotPath, &body, options.updateSnapshots);
}

/// Compiles a fixture that is expected to fail and compares the errors it
/// reported against its baseline.
function runDiagnosticsFixture(
  fixture: &FixtureCase,
  projectStart: &Path::PathBuf,
  options: &CliOptions,
): String {
  let mut discoveryErrors: Vector<String> = Vector::new<String>();
  let Option::SOME(fixtureDiscovery) = discoverFixtureGraph(fixture, projectStart, options, &mut discoveryErrors) else {
    let snapshotPath: Path::PathBuf = fixture.snapshotPath();
    let body: String = joinDiagnosticMessages(&discoveryErrors);

    return FixtureTests::compareSnapshot(&snapshotPath, &body, options.updateSnapshots);
  };

  let file: SourceFile = entrySourceFile(&fixtureDiscovery.entry);
  let compileOptions: CompileOptions = fixtureCompileOptions(false, false);
  let compiled: CompiledProgram = compileDiscovered(&fixtureDiscovery, &file, &compileOptions);

  if (compiled.errorMessages.length() == 0) {
    return String::create("expected the fixture to fail compilation, but it compiled cleanly");
  }

  let snapshotPath: Path::PathBuf = fixture.snapshotPath();
  let body: String = joinDiagnosticMessages(&compiled.errorMessages);

  return FixtureTests::compareSnapshot(&snapshotPath, &body, options.updateSnapshots);
}

/// Compiles a fixture that is expected to build cleanly and compares the
/// warnings it reported against its baseline.
function runWarningsFixture(
  fixture: &FixtureCase,
  projectStart: &Path::PathBuf,
  options: &CliOptions,
): String {
  let mut discoveryErrors: Vector<String> = Vector::new<String>();
  let Option::SOME(fixtureDiscovery) = discoverFixtureGraph(fixture, projectStart, options, &mut discoveryErrors) else {
    let reported: String = joinDiagnosticMessages(&discoveryErrors);
    return `expected the fixture to compile cleanly, but it reported errors:\n${reported.toStr()}`;
  };

  let file: SourceFile = entrySourceFile(&fixtureDiscovery.entry);
  let compileOptions: CompileOptions = fixtureCompileOptions(false, true);
  let compiled: CompiledProgram = compileDiscovered(&fixtureDiscovery, &file, &compileOptions);

  if (compiled.errorMessages.length() > 0) {
    let reported: String = joinDiagnosticMessages(&compiled.errorMessages);
    return `expected the fixture to compile cleanly, but it reported errors:\n${reported.toStr()}`;
  }

  if (compiled.warningMessages.length() == 0) {
    return String::create("expected the fixture to report warnings, but it compiled without any");
  }

  let snapshotPath: Path::PathBuf = fixture.snapshotPath();
  let body: String = joinDiagnosticMessages(&compiled.warningMessages);

  return FixtureTests::compareSnapshot(&snapshotPath, &body, options.updateSnapshots);
}

/// Runs one fixture and reports it as an ordinary plan entry.
function runFixture(
  fixture: &FixtureCase,
  projectStart: &Path::PathBuf,
  discovery: &DiscoveryResult,
  options: &CliOptions,
  timeoutSeconds: u64,
): TestOutcome {
  let mut failure: String = String::new();

  if (fixture.modeError.length() > 0) {
    failure = fixture.modeError.clone();
  } else {
    failure = match (fixture.mode.kind) {
      FixtureKind::DIAGNOSTICS -> runDiagnosticsFixture(fixture, projectStart, options),
      FixtureKind::WARNINGS -> runWarningsFixture(fixture, projectStart, options),
      FixtureKind::PROGRAM -> runProgramFixture(fixture, projectStart, discovery, options, timeoutSeconds),
    };
  }

  if (failure.length() == 0) {
    return TestOutcome {
      fqName: fixture.name.clone(),
      success: true,
      exitCode: 0,
      stdout: String::new(),
      stderr: String::new(),
    };
  }

  return TestOutcome {
    fqName: fixture.name.clone(),
    success: false,
    exitCode: 1,
    stdout: String::new(),
    stderr: failure,
  };
}

/// Build the project's test harness and run every selected test in its own
/// process, reporting the way the host `ignis test` runner does.
///
/// Returns 0 when every selected test exits 0, and 1 on any failure.
function runProjectTests(startPath: &Path::PathBuf, options: &CliOptions): i32 {
  let partition: TestPartition = match (&options.partition) {
    Option::SOME(spec) -> TestPartition::create(spec.index, spec.count),
    Option::NONE -> TestPartition::none(),
  };
  let timeoutSeconds: u64 = TestRunner::resolvedTimeoutSeconds(options.testTimeout);

  Io::eprintln(`Testing ${TestRunner::runHeader(startPath, &partition).toStr()}\n`);

  let Option::SOME(discovery) = discoverFor(startPath, options, true) else {
    return 1;
  };

  let file: SourceFile = entrySourceFile(&discovery.entry);
  let profile: BuildProfile = resolveBuildProfile(&discovery, options.optLevel);
  let compileOptions: CompileOptions = testCompileOptions();
  let compiled: CompiledProgram = compileDiscovered(&discovery, &file, &compileOptions);

  if (compiled.source.length() == 0) {
    Io::eprintln(String::create("error: test setup failed"));
    return 1;
  }

  let fixtureDirs: Vector<Path::PathBuf> = resolveFixtureDirs(&discovery, options);
  let discoveredFixtures: Vector<FixtureCase> = FixtureTests::discover(&fixtureDirs);
  let plan: TestPlan = TestRunner::buildPlan(&compiled.tests, &discoveredFixtures, &options.filter, &partition);
  let selected: Vector<TestCase> = plan.tests;
  let selectedFixtures: Vector<FixtureCase> = plan.fixtures;

  Io::eprintln(TestRunner::sectionHeader("Planning"));

  if (selected.length() == 0 && selectedFixtures.length() == 0) {
    Io::eprintln(String::create("  - No tests selected"));
    return 0;
  }

  let mut plannedIndex: u64 = 0;

  while (plannedIndex < selected.length()) {
    if (let Option::SOME(testCase) = selected.get(plannedIndex)) {
      Io::eprintln(`  - ${testCase.fqName.toStr()}`);
    }

    plannedIndex += 1;
  }

  let mut plannedFixtureIndex: u64 = 0;

  while (plannedFixtureIndex < selectedFixtures.length()) {
    if (let Option::SOME(fixture) = selectedFixtures.get(plannedFixtureIndex)) {
      Io::eprintln(`  - ${fixture.name.toStr()}`);
    }

    plannedFixtureIndex += 1;
  }

  if (options.updateSnapshots) {
    FixtureTests::prepareSnapshotDirectories(&selectedFixtures);
  }

  let outputPath: String = options.outputPathOr("selfhost_tests");
  let programSourceText: String = outputPath.concat("-program.c");
  let harnessSourceText: String = outputPath.concat("-harness.c");
  let programObjectText: String = outputPath.concat("-program.o");
  let harnessObjectText: String = outputPath.concat("-harness.o");
  let programPath: Path::PathBuf = Path::PathBuf::fromString(&programSourceText);
  let harnessPath: Path::PathBuf = Path::PathBuf::fromString(&harnessSourceText);

  if (let Result::ERROR(_) = Fs::writeString(programPath.asStr(), &compiled.source)) {
    Io::eprintln(`error: could not write ${programPath.asStr()}`);
    return 1;
  }

  let harness: String = TestRunner::harnessSource(&selected);

  if (let Result::ERROR(_) = Fs::writeString(harnessPath.asStr(), &harness)) {
    Io::eprintln(`error: could not write ${harnessPath.asStr()}`);
    return 1;
  }

  let mut sourcePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  sourcePaths.push(programPath.clone());
  sourcePaths.push(harnessPath.clone());

  let mut objectPaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  objectPaths.push(Path::PathBuf::fromString(&programObjectText));
  objectPaths.push(Path::PathBuf::fromString(&harnessObjectText));

  let binaryPath: Path::PathBuf = Path::PathBuf::fromString(&outputPath);

  if (compileAndLinkUnits(&sourcePaths, &objectPaths, &binaryPath, &discovery.stdRoot, &profile, &file) > 0) {
    Io::eprintln(String::create("error: test setup failed"));
    return 1;
  }

  Io::eprintln(TestRunner::sectionHeader("Running"));

  let mut outcomes: Vector<TestOutcome> = TestRunner::execute(
    &binaryPath,
    &selected,
    options.updateSnapshots,
    TestRunner::jobLimit(),
    timeoutSeconds,
  );

  // A fixture compiles and runs a program of its own inside this process, so it
  // follows the harness runs rather than sharing their pool, which keeps the
  // report in plan order.
  let mut fixtureIndex: u64 = 0;

  while (fixtureIndex < selectedFixtures.length()) {
    let Option::SOME(fixture) = selectedFixtures.get(fixtureIndex) else {
      break;
    };

    outcomes.push(runFixture(fixture, startPath, &discovery, options, timeoutSeconds));
    fixtureIndex += 1;
  }

  if (TestRunner::report(&outcomes, &binaryPath) > 0) {
    return 1;
  }

  return 0;
}

/// Where a command runs: a project directory, a source file, or the current
/// directory when the command line named neither.
record CommandTarget {
  public path: Path::PathBuf;
  /// True when the target is a directory, which is what selects the project
  /// artifact layout over the single-file one.
  public projectMode: boolean;
}

/// Resolve what a command runs against.
///
/// A named source file keeps the single-file behaviour the bootstrap ladder
/// depends on: the project that contains it still governs the build, and the
/// artifacts stay in the working directory. A directory, or no path at all,
/// selects project mode.
function resolveTarget(options: &CliOptions): Option<CommandTarget> {
  let Option::SOME(pathText) = &options.path else {
    let Result::OK(currentDir) = Env::currentDir() else {
      Io::eprintln(String::create("error: the current directory could not be read"));
      return Option::NONE;
    };

    return Option::SOME(CommandTarget {
      path: currentDir,
      projectMode: true,
    });
  };

  let path: Path::PathBuf = Path::PathBuf::fromString(&pathText);

  let Result::OK(metadata) = Fs::metadata(&path) else {
    Io::eprintln(`error: path not found: ${path.asStr()}`);
    return Option::NONE;
  };

  return Option::SOME(CommandTarget {
    path: path.clone(),
    projectMode: !metadata.isFile(),
  });
}

/// Compile the standard library into the archive a project links against.
///
/// The compiler emits one translation unit for a whole program rather than one
/// per module, so the archive holds a single object with every std function
/// given external linkage. The host driver archives one object per std module
/// and writes an umbrella `ignis_std.h` beside the archive; this build writes
/// no header, because nothing in this pipeline emits one yet.
function buildStandardLibrary(startPath: &Path::PathBuf, options: &CliOptions): i32 {
  Io::println(String::create("ignis selfhost build-std"));

  let overrides: BuildOverrides = buildOverridesFrom(options);
  let discovery: DiscoveryResult = match (Resolver::discoverStd(startPath, &overrides)) {
    Result::OK(value) -> value,
    Result::ERROR(diagnostics) -> {
      let startFile: SourceFile = entrySourceFile(startPath);
      reportDiscoveryFailure(&diagnostics, &startFile);
      return 1;
    },
  };

  Io::println(`  std: ${discovery.stdRoot.asStr()}`);

  let file: SourceFile = entrySourceFile(&discovery.entry);
  let profile: BuildProfile = resolveBuildProfile(&discovery, options.optLevel);
  let compileOptions: CompileOptions = stdCompileOptions();
  let compiled: CompiledProgram = compileDiscovered(&discovery, &file, &compileOptions);

  if (compiled.errors > 0 || compiled.source.length() == 0) {
    Io::println(`  summary: ${compiled.errors} errors, ${compiled.warnings} warnings`);
    return 1;
  }

  let base: Path::PathBuf = stdArtifactBase(&discovery.outDir, &options.outDir, &options.outputPath);
  let layout: BuildLayout = BuildLayout::new("std", &base);
  let sourcePath: Path::PathBuf = layout.stdSrcDir().join("ignis_std.c");
  let objectPath: Path::PathBuf = layout.stdObjDir().join("ignis_std.o");
  let libraryPath: Path::PathBuf = layout.stdLibPath();

  if (!ensureParentDirectory(&sourcePath) || !ensureParentDirectory(&objectPath) || !ensureParentDirectory(&libraryPath)) {
    return 1;
  }

  if (let Result::ERROR(_) = Fs::writeString(&sourcePath, &compiled.source)) {
    Io::eprintln(`error: could not write ${sourcePath.asStr()}`);
    return 1;
  }

  Io::println(`  emit: ${sourcePath.asStr()}`);

  let runtimeDir: Path::PathBuf = discovery.stdRoot.join("runtime");
  let mut includeDirs: Vector<String> = Vector::new<String>();
  includeDirs.push(runtimeDir.toString());

  let extraFlags: Vector<String> = CCompiler::profileFlags(profile.optLevel, profile.debug, &profile.cflags);

  if (let Result::ERROR(compileBag) = CCompiler::compileObject(
    profile.cc.toStr(),
    &sourcePath,
    &objectPath,
    &includeDirs,
    &extraFlags,
  )) {
    renderBagToStderr(&compileBag, &file);
    Io::println(String::create("  archive: failed"));
    return 1;
  }

  let mut objects: Vector<String> = Vector::new<String>();
  objects.push(objectPath.toString());

  if (let Result::ERROR(archiveBag) = ArchiveTool::archive("ar", &libraryPath, &objects)) {
    renderBagToStderr(&archiveBag, &file);
    Io::println(String::create("  archive: failed"));
    return 1;
  }

  Io::println(`  archive: ${libraryPath.asStr()}`);
  Io::println(`  summary: 0 errors, ${compiled.warnings} warnings`);
  return 0;
}

/// Build the standard library into the archive a project links against.
function runBuildStd(options: &CliOptions): i32 {
  let Option::SOME(target) = resolveTarget(options) else {
    return 1;
  };

  return buildStandardLibrary(&target.path, options);
}

/// CLI entry point.
///
/// `ignis build [PATH]`, `ignis check [PATH]`, `ignis build-std` and
/// `ignis test [PATH]` run against the project that contains `PATH`, which
/// defaults to the current directory. The bare form `ignis <entry.ign>` is the
/// build the bootstrap ladder and the parity harness call, and stays a build of
/// the project that contains that file.
///
/// `-o` names the binary a build or a test run links; `--out-dir` overrides
/// `[build] out_dir`. `-O` / `--opt-level`, `--debug` / `--no-debug`, `--cc`,
/// `--std-path`, `--target-triple`, `--feature` and `--features` override what
/// the project file declares. `--debug` / `--no-debug` also decides `@debug()`
/// and `@release()`, so the `-g` the C toolchain receives and the predicate the
/// source sees can never disagree.
///
/// Exits 2 on a command line this compiler does not answer, 1 on a failed
/// command and 0 otherwise.
function main(): i32 {
  let args: Vector<String> = Process::args();

  let options: CliOptions = match (parseArguments(&args)) {
    Result::OK(value) -> value,
    Result::ERROR(message) -> {
      Io::eprintln(message);
      return 2;
    },
  };

  if (let CliCommand::HELP = options.command) {
    Io::println(helpText());
    return 0;
  }

  if (let CliCommand::VERSION = options.command) {
    Io::println(versionText());
    return 0;
  }

  if (let CliCommand::BUILD_STD = options.command) {
    return runBuildStd(&options);
  }

  let Option::SOME(target) = resolveTarget(&options) else {
    return 1;
  };

  if (let CliCommand::TEST = options.command) {
    return runProjectTests(&target.path, &options);
  }

  let checkOnly: boolean = match (options.command) {
    CliCommand::CHECK -> true,
    _ -> false,
  };

  return runCompile(&target.path, &options, checkOnly, target.projectMode);
}
