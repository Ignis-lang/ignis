import Fs from "std::fs";
import Io from "std::io";
import Path from "std::path";
import Process from "std::process";

import DiagnosticBag, DiagnosticRenderer, Severity, SourceFile from "@compiler::diagnostics";
import Analyzer from "@compiler::analyzer";
import Ast from "@compiler::ast";
import ParseOutput, Parser from "@compiler::parser";
import Hir from "@compiler::hir";

// Pulled in so `ignis check` analyzes them: nothing else in this binary's
// import graph reaches HIR lowering or the borrow checker yet, and a module
// outside the graph is never typechecked.
import _ from "./analyzer/lowering";
import Borrowck from "./analyzer/borrowck";
import _ from "./analyzer/escape";
import Capture from "./analyzer/capture";
import CodegenC from "./codegen/mod";
import Mono from "./analyzer/mono";
import LirLowering from "./lir/lowering";
import LirVerify from "./lir/verify";

import BuildGraph, BuildModuleKind from "./build/module_graph";
import CCompiler from "./build/c_compiler";
import Linker from "./build/linker";
import DiscoveryResult, Resolver from "./build/resolver";
import TestCase, TestOutcome, TestRunner from "./build/test_runner";

/// Count diagnostics in `bag` whose severity equals `target`.
function countBySeverity(bag: &DiagnosticBag, target: Severity): u64 {
  let mut count: u64 = 0;
  let mut index: u64 = 0;

  while (index < bag.length()) {
    let Option::SOME(diag) = bag.get(index) else {
      index += 1;
      continue;
    };

    if (diag.severity == target) {
      count += 1;
    }

    index += 1;
  }

  return count;
}

/// Format a per-phase status line like `  lex  : ok (0 errors, 0 warnings)`.
/// Merge every module's evaluated constants into one map for LIR lowering,
/// which runs over the whole monomorphized program at once.
function collectProgramConstValues(
  records: &Vector<Analyzer::ModuleAnalysisRecord>,
): Analyzer::ConstEval::ConstValueMap {
  let mut merged: Analyzer::ConstEval::ConstValueMap = Analyzer::ConstEval::ConstValueMap {
    defIdRaws: Vector::new<u32>(),
    values: Vector::new<Analyzer::ConstEval::ConstValue>(),
  };
  let mut recordIndex: u64 = 0;

  while (recordIndex < records.length()) {
    let Option::SOME(analysisRecord) = records.get(recordIndex) else {
      recordIndex += 1;
      continue;
    };

    let moduleValues: &Analyzer::ConstEval::ConstValueMap = &analysisRecord.output.constValues.values;
    let mut valueIndex: u64 = 0;

    while (valueIndex < moduleValues.defIdRaws.length()) {
      let Option::SOME(defIdRaw) = moduleValues.defIdRaws.get(valueIndex) else {
        valueIndex += 1;
        continue;
      };
      let Option::SOME(value) = moduleValues.values.get(valueIndex) else {
        valueIndex += 1;
        continue;
      };

      merged.defIdRaws.push(*defIdRaw);
      merged.values.push(Analyzer::ConstEval::copyConstValue(value));
      valueIndex += 1;
    }

    recordIndex += 1;
  }

  return merged;
}

function formatPhaseLine(name: str, errors: u64, warnings: u64): String {
  let status: str = errors == 0 ? "ok" : "fail";

  return `  ${name}: ${status} (${errors} errors, ${warnings} warnings)`;
}

/// Render and print a diagnostic bag to stderr if it is non-empty.
function renderBagToStderr(bag: &DiagnosticBag, file: &SourceFile): void {
  if (bag.isEmpty()) {
    return;
  }

  let rendered: String = DiagnosticRenderer::renderBag(bag, file, true);
  Io::eprintln(rendered);
}

function analyzerModuleKind(kind: BuildModuleKind): Analyzer::Imports::ModuleKind {
  return match (kind) {
    BuildModuleKind::PROJECT -> Analyzer::Imports::ModuleKind::PROJECT,
    BuildModuleKind::STD -> Analyzer::Imports::ModuleKind::STD,
  };
}

function mapImportSourcesToDiscoveryTargets(
  module: &mut Ast::Module,
  graph: &BuildGraph,
  nodeIndex: u64,
): boolean {
  let Option::SOME(node) = graph.nodes.get(nodeIndex) else {
    return false;
  };
  let mut rootIndex: u64 = 0;

  while (rootIndex < module.roots.length()) {
    let Option::SOME(rootId) = module.roots.get(rootIndex) else {
      return false;
    };
    let Option::SOME(item) = module.items.getMut(*rootId) else {
      return false;
    };
    if (let Ast::Item::Node::Export(exportItem) = item) {
      // `export Name from "path"` carries a source too; it maps to its
      // discovery target the same way an import does.
      let Option::SOME(exportSource) = Ast::copyOptionalString(&exportItem.source) else {
        rootIndex += 1;
        continue;
      };

      let mut exportEdgeIndex: u64 = 0;
      let mut exportMatched: boolean = false;

      while (exportEdgeIndex < node.edges.length()) {
        let Option::SOME(edge) = node.edges.get(exportEdgeIndex) else {
          return false;
        };

        if (edge.source.equals(exportSource.toStr())) {
          let Option::SOME(target) = graph.nodes.get(edge.targetIndex) else {
            return false;
          };

          *item = Ast::Item::Node::Export(Ast::Item::Export {
            span: exportItem.span,
            declaration: exportItem.declaration,
            items: Ast::copyImportBindings(&exportItem.items),
            source: Option::SOME(target.path.toString()),
            sourceSpan: exportItem.sourceSpan,
            metadata: Ast::emptyMetadata(),
          });
          exportMatched = true;
          break;
        }

        exportEdgeIndex += 1;
      }

      if (!exportMatched) {
        return false;
      }

      rootIndex += 1;
      continue;
    }

    let Ast::Item::Node::Import(importItem) = item else {
      rootIndex += 1;
      continue;
    };
    let mut edgeIndex: u64 = 0;
    let mut matched: boolean = false;

    while (edgeIndex < node.edges.length()) {
      let Option::SOME(edge) = node.edges.get(edgeIndex) else {
        return false;
      };

      if (edge.source.equals(importItem.source.toStr())) {
        let Option::SOME(target) = graph.nodes.get(edge.targetIndex) else {
          return false;
        };

        *item = Ast::Item::Node::Import(Ast::Item::Import {
          span: importItem.span,
          items: Ast::copyImportBindings(&importItem.items),
          source: target.path.toString(),
          sourceSpan: importItem.sourceSpan,
          metadata: Ast::emptyMetadata(),
        });
        matched = true;
        break;
      }

      edgeIndex += 1;
    }

    if (!matched) {
      return false;
    }

    rootIndex += 1;
  }

  return true;
}

/// Compile every emitted translation unit and link them into an executable.
///
/// Returns 0 when every toolchain step succeeds and 1 when any one fails.
function compileAndLinkUnits(
  sourcePaths: &Vector<Path::PathBuf>,
  objectPaths: &Vector<Path::PathBuf>,
  outputPath: &Path::PathBuf,
  stdRoot: &Path::PathBuf,
  file: &SourceFile,
): u64 {
  let runtimeDir: Path::PathBuf = stdRoot.join("runtime");

  let mut includeDirs: Vector<String> = Vector::new<String>();
  includeDirs.push(runtimeDir.toString());

  let mut extraFlags: Vector<String> = Vector::new<String>();
  extraFlags.push(String::create("-O0"));
  extraFlags.push(String::create("-g"));

  let mut objects: Vector<String> = Vector::new<String>();
  let mut unitIndex: u64 = 0;

  while (unitIndex < sourcePaths.length()) {
    let Option::SOME(sourcePath) = sourcePaths.get(unitIndex) else {
      break;
    };
    let Option::SOME(objectPath) = objectPaths.get(unitIndex) else {
      break;
    };

    if (let Result::ERROR(compileBag) = CCompiler::compileObject(
      "gcc",
      sourcePath,
      objectPath,
      &includeDirs,
      &extraFlags,
    )) {
      renderBagToStderr(&compileBag, file);
      Io::println(String::create("  link: failed"));
      return 1;
    }

    objects.push(objectPath.toString());
    unitIndex += 1;
  }

  let mut archives: Vector<String> = Vector::new<String>();
  archives.push(runtimeDir.join("libignis_rt.a").toString());

  let mut libs: Vector<String> = Vector::new<String>();
  libs.push(String::create("m"));

  let linkFlags: Vector<String> = Vector::new<String>();

  if (let Result::ERROR(linkBag) = Linker::link(
    "gcc",
    outputPath,
    &objects,
    &archives,
    &libs,
    &linkFlags,
  )) {
    renderBagToStderr(&linkBag, file);
    Io::println(String::create("  link: failed"));
    return 1;
  }

  Io::println(`  link: ${outputPath.asStr()}`);
  return 0;
}

/// The emitted translation unit plus what the frontend measured.
record CompiledProgram {
  /// The emitted C, empty when a phase before codegen failed.
  public source: String;
  /// The project's `@test` functions, empty unless the caller asked for them.
  public tests: Vector<TestCase>;
  public errors: u64;
  public warnings: u64;
}

function failedCompilation(errors: u64, warnings: u64): CompiledProgram {
  return CompiledProgram {
    source: String::new(),
    tests: Vector::new<TestCase>(),
    errors: errors,
    warnings: warnings,
  };
}

/// Render a module-discovery failure the way the phase lines do.
function reportDiscoveryFailure(diagnostics: &DiagnosticBag, file: &SourceFile): void {
  let discoveryErrors: u64 = countBySeverity(diagnostics, Severity::ERROR);
  let discoveryWarnings: u64 = countBySeverity(diagnostics, Severity::WARNING);

  Io::println(formatPhaseLine("discover", discoveryErrors, discoveryWarnings));
  renderBagToStderr(diagnostics, file);
  Io::println(
    `  summary: ${discoveryErrors} errors, ${discoveryWarnings} warnings`
  );
}

/// Parse, analyze, lower and emit every module `discovery` reached.
///
/// `collectTests` gathers the project's `@test` functions and leaves the entry
/// wrapper out of the emitted unit, because the test harness owns `main` in
/// that build.
function compileDiscovered(
  discovery: &DiscoveryResult,
  file: &SourceFile,
  collectTests: boolean,
): CompiledProgram {
  let mut modules: Vector<Ast::Module> = Vector::new<Ast::Module>();
  let mut files: Vector<SourceFile> = Vector::new<SourceFile>();
  let mut modulePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  let mut moduleIsProject: Vector<boolean> = Vector::new<boolean>();
  let mut infos: Vector<Analyzer::Imports::ModuleInfo> = Vector::new<Analyzer::Imports::ModuleInfo>();
  let mut lexErrors: u64 = 0;
  let mut lexWarnings: u64 = 0;
  let mut parseErrors: u64 = 0;
  let mut parseWarnings: u64 = 0;
  let mut rootCount: u64 = 0;
  let mut orderIndex: u64 = 0;

  while (orderIndex < discovery.order.length()) {
    let Option::SOME(nodeIndex) = discovery.order.get(orderIndex) else {
      Io::eprintln("error: discovery order is incomplete");
      return failedCompilation(1, 0);
    };
    let Option::SOME(node) = discovery.graph.nodes.get(*nodeIndex) else {
      Io::eprintln("error: discovery order references a missing module");
      return failedCompilation(1, 0);
    };
    let Result::OK(moduleText) = Fs::readToString(&node.path) else {
      Io::eprintln(`error: cannot read source file: ${node.path.toString().toStr()}`);
      return failedCompilation(1, 0);
    };

    let modulePath: String = node.path.toString();
    let moduleFile: SourceFile = SourceFile::create(modulePath.toStr(), moduleText.toStr());
    let mut output: ParseOutput = Parser::parseFile(&moduleFile);

    lexErrors += countBySeverity(&output.lexDiagnostics, Severity::ERROR);
    lexWarnings += countBySeverity(&output.lexDiagnostics, Severity::WARNING);
    parseErrors += countBySeverity(&output.parseDiagnostics, Severity::ERROR);
    parseWarnings += countBySeverity(&output.parseDiagnostics, Severity::WARNING);
    rootCount += output.module.roots.length();

    renderBagToStderr(&output.lexDiagnostics, &moduleFile);
    renderBagToStderr(&output.parseDiagnostics, &moduleFile);

    if (!mapImportSourcesToDiscoveryTargets(&mut output.module, &discovery.graph, *nodeIndex)) {
      Io::eprintln(`error: discovery graph import mapping is incomplete for ${modulePath.toStr()}`);
      return failedCompilation(1, 0);
    }

    let kind: Analyzer::Imports::ModuleKind = analyzerModuleKind(node.kind);
    let mut isProject: boolean = false;

    if (let Analyzer::Imports::ModuleKind::PROJECT = kind) {
      isProject = true;
    }

    modules.push(output.module);
    files.push(moduleFile);
    modulePaths.push(node.path.clone());
    moduleIsProject.push(isProject);
    infos.push(Analyzer::Imports::ModuleInfo {
      index: *nodeIndex,
      pathText: modulePath,
      kind: kind,
    });
    orderIndex += 1;
  }

  Io::println(formatPhaseLine("lex  ", lexErrors, lexWarnings));
  Io::println(formatPhaseLine("parse", parseErrors, parseWarnings));
  Io::println(`  roots: ${rootCount}`);

  let frontendErrors: u64 = lexErrors + parseErrors;
  let frontendWarnings: u64 = lexWarnings + parseWarnings;

  if (frontendErrors > 0) {
    Io::println(String::create("  analyze: skipped (frontend errors)"));
    return failedCompilation(frontendErrors, frontendWarnings);
  }

  let mut defStore: Analyzer::DefinitionStore = Analyzer::DefinitionStore::init();
  let mut typeStore: Analyzer::TypeStore = Analyzer::TypeStore::init();
  let mut symbols: Analyzer::SymbolTable = Analyzer::SymbolTable::init();
  let mut preludePaths: Vector<String> = Vector::new<String>();
  let mut preludeIndex: u64 = 0;

  while (preludeIndex < discovery.preludePaths.length()) {
    if (let Option::SOME(preludePath) = discovery.preludePaths.get(preludeIndex)) {
      preludePaths.push(preludePath.toString());
    }

    preludeIndex += 1;
  }

  let records: Vector<Analyzer::ModuleAnalysisRecord> = Analyzer::analyzeProgram(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &modules,
    &infos,
    &preludePaths,
  );

  let mut analyzeErrors: u64 = 0;
  let mut analyzeWarnings: u64 = 0;
  let mut recordIndex: u64 = 0;

  while (recordIndex < records.length()) {
    let Option::SOME(analysisRecord) = records.get(recordIndex) else {
      Io::eprintln("error: analysis records are incomplete");
      return failedCompilation(frontendErrors + 1, frontendWarnings);
    };
    let Option::SOME(moduleFile) = files.get(recordIndex) else {
      Io::eprintln("error: analysis records do not align with parsed modules");
      return failedCompilation(frontendErrors + 1, frontendWarnings);
    };

    analyzeErrors += countBySeverity(&analysisRecord.output.diagnostics, Severity::ERROR);
    analyzeWarnings += countBySeverity(&analysisRecord.output.diagnostics, Severity::WARNING);
    renderBagToStderr(&analysisRecord.output.diagnostics, moduleFile);
    recordIndex += 1;
  }

  Io::println(formatPhaseLine("analyze", analyzeErrors, analyzeWarnings));

  // Lowering runs only over a clean analysis: its inputs assume every
  // reference resolved and every expression typed. Failures surface as
  // `HirKind::Error` nodes, counted per module.
  if (analyzeErrors > 0) {
    Io::println(String::create("  lower: skipped (analyze errors)"));
    return failedCompilation(frontendErrors + analyzeErrors, frontendWarnings + analyzeWarnings);
  }

  let mut tests: Vector<TestCase> = Vector::new<TestCase>();

  if (collectTests) {
    let sourceRoot: Path::PathBuf = TestRunner::sourceRootOf(&discovery.graph);
    let mut testModuleIndex: u64 = 0;

    while (testModuleIndex < records.length()) {
      let Option::SOME(isProject) = moduleIsProject.get(testModuleIndex) else {
        break;
      };

      if (*isProject) {
        let Option::SOME(analysisRecord) = records.get(testModuleIndex) else {
          break;
        };
        let Option::SOME(module) = modules.get(testModuleIndex) else {
          break;
        };
        let Option::SOME(modulePath) = modulePaths.get(testModuleIndex) else {
          break;
        };

        TestRunner::collectModuleTests(
          &mut defStore,
          &mut symbols,
          module,
          &analysisRecord.output.pass2,
          modulePath,
          &sourceRoot,
          &mut tests,
        );
      }

      testModuleIndex += 1;
    }

    Io::println(`  tests: ${tests.length()} discovered`);
  }

  let mut loweredModules: u64 = 0;
  let mut hirErrorNodes: u64 = 0;
  let mut hirNodes: u64 = 0;
  let mut lowerIndex: u64 = 0;
  let mut programHir: Hir::HirStore = Hir::HirStore::init();

  while (lowerIndex < records.length()) {
    let Option::SOME(analysisRecord) = records.get(lowerIndex) else {
      lowerIndex += 1;
      continue;
    };
    let Option::SOME(module) = modules.get(lowerIndex) else {
      lowerIndex += 1;
      continue;
    };

    let moduleNodeStart: u64 = programHir.nodes.length();

    Lowering::lowerModuleInto(
      &mut defStore,
      &mut typeStore,
      &mut symbols,
      module,
      &analysisRecord.output,
      &mut programHir,
    );

    let mut nodeIndex: u64 = moduleNodeStart;
    while (nodeIndex < programHir.nodes.length()) {
      if (let Option::SOME(node) = programHir.nodes.get(nodeIndex)) {
        if (let Hir::HirKind::Error = node.kind) {
          hirErrorNodes += 1;
        }
      }
      nodeIndex += 1;
    }

    hirNodes += programHir.nodes.length() - moduleNodeStart;

    loweredModules += 1;
    lowerIndex += 1;
  }

  // Closures reach LIR with an environment layout and a thunk, so capture
  // analysis has to run over the whole program before monomorphization
  // clones any body.
  let captureDiagnostics: DiagnosticBag = Capture::populateClosureCaptures(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &mut programHir,
  );

  let captureErrors: u64 = countBySeverity(&captureDiagnostics, Severity::ERROR);
  let captureWarnings: u64 = countBySeverity(&captureDiagnostics, Severity::WARNING);

  Io::println(formatPhaseLine("capture", captureErrors, captureWarnings));

  let monoResult: Mono::MonoOutput = Mono::run(&mut defStore, &mut typeStore, &mut symbols, &programHir);
  let monoGenericNodes: u64 = Mono::countRemainingGenerics(&mut typeStore, &monoResult.hir);

  Io::println(`  mono: ${monoResult.instantiations} instantiations, ${monoResult.hir.nodes.length()} nodes, ${monoGenericNodes} generic nodes left`);

  // Ownership and borrow checking runs over the monomorphized HIR, the same
  // program LIR lowering is about to walk: its drop schedules are keyed by
  // the nodes that walk visits.
  let checked: Borrowck::BorrowckOutput = Borrowck::checkModule(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &monoResult.hir,
  );

  let ownershipErrors: u64 = countBySeverity(&checked.diagnostics, Severity::ERROR);
  let ownershipWarnings: u64 = countBySeverity(&checked.diagnostics, Severity::WARNING);

  Io::println(formatPhaseLine("ownership", ownershipErrors, ownershipWarnings));
  renderBagToStderr(&checked.diagnostics, file);

  let programConstValues: Analyzer::ConstEval::ConstValueMap = collectProgramConstValues(&records);

  let mut lirResult: LirLowering::LowerModuleResult = LirLowering::lowerModule(
    &mut defStore,
    &mut typeStore,
    &monoResult.hir,
    &checked.dropSchedules,
    &programConstValues,
  );

  let verifyFindings: Vector<String> = LirVerify::verifyProgram(&mut defStore, &mut typeStore, &lirResult.program);

  Io::println(`  lower: ${hirErrorNodes} error nodes, ${hirNodes} hir nodes, ${loweredModules} modules`);
  Io::println(`  lir: ${lirResult.unsupported} unsupported, ${lirResult.loweredFunctions} functions, ${verifyFindings.length()} verify errors`);

  // The harness translation unit defines `main` and calls the selected tests
  // directly, so the program unit must not carry an entry wrapper too.
  if (collectTests) {
    lirResult.program.entryPoint = Option::NONE;
  }

  let emitResult: CodegenC::EmitOutput = CodegenC::emitProgram(
    &mut defStore,
    &mut typeStore,
    &mut symbols,
    &lirResult.program,
  );

  Io::println(
    `  codegen: ${emitResult.unsupported} unsupported, ${emitResult.functions} functions, ${emitResult.source.length()} bytes`
  );

  return CompiledProgram {
    source: emitResult.source,
    tests: tests,
    errors: frontendErrors + analyzeErrors + ownershipErrors,
    warnings: frontendWarnings + analyzeWarnings + ownershipWarnings,
  };
}

/// Drive the selfhost compiler pipeline against the project containing a source file.
///
/// Returns 0 on success, 1 on any error (I/O, lex, parse, analyze, or linking).
function compileFile(path: &String, outputPath: &String): i32 {
  Io::println(String::create("ignis selfhost (partial pipeline)"));
  Io::println(`  source: ${path.toStr()}`);

  let Result::OK(text) = Fs::readToString(path) else {
    Io::eprintln(`error: cannot read source file: ${path.toStr()}`);
    return 1;
  };

  let file: SourceFile = SourceFile::create(path.toStr(), text.toStr());
  let entryPath: Path::PathBuf = Path::PathBuf::fromString(path);
  let discovery: DiscoveryResult = match (Resolver::discoverProject(&entryPath)) {
    Result::OK(value) -> value,
    Result::ERROR(diagnostics) -> {
      reportDiscoveryFailure(&diagnostics, &file);
      return 1;
    },
  };

  let compiled: CompiledProgram = compileDiscovered(&discovery, &file, false);
  let mut linkErrors: u64 = 0;

  // The emitted translation unit is the next thing to feed to a C compiler,
  // and the `// unsupported instruction: <Variant>` comments in it are how the
  // remaining work is counted per variant.
  if (compiled.source.length() > 0) {
    let emitPath: str = "selfhost_emit.c";

    if (let Result::ERROR(_) = Fs::writeString(emitPath, &compiled.source)) {
      Io::println(String::create("  emit: could not write selfhost_emit.c"));
    } else {
      Io::println(`  emit: ${emitPath}`);

      let mut sourcePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
      sourcePaths.push(Path::PathBuf::create(emitPath));

      let mut objectPaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
      objectPaths.push(Path::PathBuf::create("selfhost_emit.o"));

      let outputPathBuf: Path::PathBuf = Path::PathBuf::fromString(outputPath);

      linkErrors += compileAndLinkUnits(
        &sourcePaths,
        &objectPaths,
        &outputPathBuf,
        &discovery.stdRoot,
        &file,
      );
    }
  }

  let totalErrors: u64 = compiled.errors + linkErrors;

  Io::println(
    `  summary: ${totalErrors} errors, ${compiled.warnings} warnings`
  );

  if (totalErrors > 0) {
    return 1;
  }

  return 0;
}

/// Build the project's test harness and run every selected test in its own
/// process, reporting the way the host `ignis test` runner does.
///
/// Returns 0 when every selected test exits 0, and 1 on any failure.
function runProjectTests(
  path: &String,
  outputPath: &String,
  filter: &String,
  updateSnapshots: boolean,
): i32 {
  Io::eprintln(`Testing ${path.toStr()}\n`);

  let Result::OK(text) = Fs::readToString(path) else {
    Io::eprintln(`error: cannot read source file: ${path.toStr()}`);
    return 1;
  };

  let file: SourceFile = SourceFile::create(path.toStr(), text.toStr());
  let entryPath: Path::PathBuf = Path::PathBuf::fromString(path);
  let discovery: DiscoveryResult = match (Resolver::discoverProjectTests(&entryPath)) {
    Result::OK(value) -> value,
    Result::ERROR(diagnostics) -> {
      reportDiscoveryFailure(&diagnostics, &file);
      return 1;
    },
  };

  let compiled: CompiledProgram = compileDiscovered(&discovery, &file, true);

  if (compiled.source.length() == 0) {
    Io::eprintln(String::create("error: test setup failed"));
    return 1;
  }

  let selected: Vector<TestCase> = TestRunner::plan(&compiled.tests, filter);

  Io::eprintln(String::create("• Planning"));

  if (selected.length() == 0) {
    Io::eprintln(String::create("  - No tests selected"));
    return 0;
  }

  let mut plannedIndex: u64 = 0;

  while (plannedIndex < selected.length()) {
    if (let Option::SOME(testCase) = selected.get(plannedIndex)) {
      Io::eprintln(`  - ${testCase.fqName.toStr()}`);
    }

    plannedIndex += 1;
  }

  let programSourceText: String = outputPath.concat("-program.c");
  let harnessSourceText: String = outputPath.concat("-harness.c");
  let programObjectText: String = outputPath.concat("-program.o");
  let harnessObjectText: String = outputPath.concat("-harness.o");
  let programPath: Path::PathBuf = Path::PathBuf::fromString(&programSourceText);
  let harnessPath: Path::PathBuf = Path::PathBuf::fromString(&harnessSourceText);

  if (let Result::ERROR(_) = Fs::writeString(programPath.asStr(), &compiled.source)) {
    Io::eprintln(`error: could not write ${programPath.asStr()}`);
    return 1;
  }

  let harness: String = TestRunner::harnessSource(&selected);

  if (let Result::ERROR(_) = Fs::writeString(harnessPath.asStr(), &harness)) {
    Io::eprintln(`error: could not write ${harnessPath.asStr()}`);
    return 1;
  }

  let mut sourcePaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  sourcePaths.push(programPath.clone());
  sourcePaths.push(harnessPath.clone());

  let mut objectPaths: Vector<Path::PathBuf> = Vector::new<Path::PathBuf>();
  objectPaths.push(Path::PathBuf::fromString(&programObjectText));
  objectPaths.push(Path::PathBuf::fromString(&harnessObjectText));

  let binaryPath: Path::PathBuf = Path::PathBuf::fromString(outputPath);

  if (compileAndLinkUnits(&sourcePaths, &objectPaths, &binaryPath, &discovery.stdRoot, &file) > 0) {
    Io::eprintln(String::create("error: test setup failed"));
    return 1;
  }

  Io::eprintln(String::create("• Running"));

  let outcomes: Vector<TestOutcome> = TestRunner::execute(&binaryPath, &selected, updateSnapshots);

  if (TestRunner::report(&outcomes, &binaryPath) > 0) {
    return 1;
  }

  return 0;
}

/// CLI entry point: `ignis <source.ign> [-o <output-binary>]` or
/// `ignis test <entry.ign> [--filter <substring>] [--update-snapshots] [-o <binary>]`.
///
/// Without arguments the binary exits cleanly. The positional argument is a
/// path to an Ignis source file and the pipeline runs against the project that
/// contains it. `-o` overrides the output binary, which defaults to
/// `selfhost_out` for a build and `selfhost_tests` for a test run. An unknown
/// flag exits with 2.
function main(): i32 {
  let args: Vector<String> = Process::args();
  let mut sourcePath: Option<String> = Option::NONE;
  let mut outputPath: String = String::create("selfhost_out");
  let mut filter: String = String::new();
  let mut updateSnapshots: boolean = false;
  let mut testMode: boolean = false;
  let mut index: u64 = 1;

  if (let Option::SOME(first) = args.get(1) && first.equals("test")) {
    testMode = true;
    outputPath = String::create("selfhost_tests");
    index = 2;
  }

  while (index < args.length()) {
    let Option::SOME(arg) = args.get(index) else {
      break;
    };

    if (arg.equals("-o")) {
      let Option::SOME(value) = args.get(index + 1) else {
        Io::eprintln(String::create("error: -o requires an output path"));
        return 2;
      };

      outputPath = value.clone();
      index += 2;
      continue;
    }

    if (testMode && arg.equals("--filter")) {
      let Option::SOME(value) = args.get(index + 1) else {
        Io::eprintln(String::create("error: --filter requires a substring"));
        return 2;
      };

      filter = value.clone();
      index += 2;
      continue;
    }

    if (testMode && arg.equals("--update-snapshots")) {
      updateSnapshots = true;
      index += 1;
      continue;
    }

    if (arg.startsWith("-")) {
      Io::eprintln(`error: unknown argument: ${arg.toStr()}`);
      return 2;
    }

    sourcePath = Option::SOME(arg.clone());
    index += 1;
  }

  let Option::SOME(source) = sourcePath else {
    return 0;
  };

  if (testMode) {
    return runProjectTests(&source, &outputPath, &filter, updateSnapshots);
  }

  return compileFile(&source, &outputPath);
}
