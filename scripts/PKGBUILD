# Maintainer: Ignacio Perez <ignacio@feuer.me>

pkgname=ignis
pkgver=0.4.0
pkgrel=1
pkgdesc="The Ignis programming language compiler"
arch=(x86_64)
url="https://github.com/Ignis-lang/ignis"
license=('GPL-3.0-only')
depends=(
  'gcc'
  'binutils'
  'make'
)
makedepends=(
  'xz'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

# Compile the compiler sources with $1 into build/$2/ignis, the way
# scripts/bootstrap.sh builds a stage. The selfhost driver writes its emitted C
# and object file into the working directory, so each stage runs in its own.
_compile_stage() {
  local compiler="$1" stage_dir="$PWD/build/$2"

  mkdir -p "$stage_dir"
  (
    cd "$stage_dir"
    IGNIS_STD_PATH="${srcdir}/${pkgname}-${pkgver}/std" "$compiler" "${srcdir}/${pkgname}-${pkgver}/ignis/main.ign" -o "$stage_dir/ignis"
  )
}

# stage0 comes from the C seed committed under bootstrap/seed, stage1 is the
# sources compiled by stage0, and stage2, the binary a release ships, is the
# sources compiled by stage1.
build() {
  cd "${pkgname}-${pkgver}"

  local stage0
  stage0="$(scripts/build_from_seed.sh -o "$PWD/build/stage0/ignis")"

  _compile_stage "$stage0" stage1
  _compile_stage "$PWD/build/stage1/ignis" stage2
}

check() {
  cd "${pkgname}-${pkgver}"
  build/stage2/ignis test-std --std-path std -o build/test-std
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "build/stage2/ignis" "${pkgdir}/usr/lib/ignis/ignis-bin"
  install -d "${pkgdir}/usr/share/ignis"
  cp -r "std" "${pkgdir}/usr/share/ignis/std"

  install -Dm755 /dev/null "${pkgdir}/usr/bin/ignis"
  cat > "${pkgdir}/usr/bin/ignis" << 'EOF'
#!/usr/bin/env bash
set -euo pipefail

export IGNIS_STD_PATH="${IGNIS_STD_PATH:-/usr/share/ignis/std}"
export IGNIS_HOME="${IGNIS_HOME:-/usr/share/ignis}"

exec /usr/lib/ignis/ignis-bin "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/ignis"
}
