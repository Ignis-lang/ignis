# Maintainer: Ignacio Perez <ignacio@feuer.me>

pkgname=ignis
pkgver=0.4.0
pkgrel=1
pkgdesc="The Ignis programming language compiler"
arch=(x86_64)
url="https://github.com/Ignis-lang/ignis"
license=('GPL-3.0-only')
depends=(
  'gcc'
  'binutils'
  'make'
)
# The release archive .github/workflows/release.yml publishes for the tag: the
# compiler binary at ./ignis and the standard library at ./std. Nothing is
# built here. The archive is checked against the release's own .sha256 in
# prepare(), so the sums below stay SKIP.
source=(
  "ignis-linux-amd64-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/ignis-linux-amd64.tar.gz"
  "ignis-linux-amd64-${pkgver}.tar.gz.sha256::${url}/releases/download/v${pkgver}/ignis-linux-amd64.tar.gz.sha256"
)
sha256sums=('SKIP' 'SKIP')

prepare() {
  local expected
  expected="$(cut -d' ' -f1 "ignis-linux-amd64-${pkgver}.tar.gz.sha256")"

  echo "${expected}  ignis-linux-amd64-${pkgver}.tar.gz" | sha256sum -c -
}

# Archives released by the Rust compiler (v0.4.0 and earlier) ship the C
# runtime as sources and link std/runtime/libignis_rt.a, which they do not
# contain. Selfhost archives have no C runtime and no Makefile there.
build() {
  if [[ -f "${srcdir}/std/runtime/Makefile" ]]; then
    make -C "${srcdir}/std/runtime" libignis_rt.a
  fi
}

check() {
  cat > check_hello.ign << 'EOF'
import Io from "std::io";

function main(): void {
  Io::println("Hello, Ignis!");
  return;
}
EOF

  IGNIS_STD_PATH="${srcdir}/std" "${srcdir}/ignis" check check_hello.ign
}

package() {
  install -Dm755 "${srcdir}/ignis" "${pkgdir}/usr/lib/ignis/ignis-bin"
  install -d "${pkgdir}/usr/share/ignis"
  cp -r "${srcdir}/std" "${pkgdir}/usr/share/ignis/std"

  install -Dm755 /dev/null "${pkgdir}/usr/bin/ignis"
  cat > "${pkgdir}/usr/bin/ignis" << 'EOF'
#!/usr/bin/env bash
set -euo pipefail

export IGNIS_STD_PATH="${IGNIS_STD_PATH:-/usr/share/ignis/std}"
export IGNIS_HOME="${IGNIS_HOME:-/usr/share/ignis}"

exec /usr/lib/ignis/ignis-bin "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/ignis"
}
