// Test: Index assignment on a borrowed array should produce A0047

function main(): void {
    let mut arr: i32[3] = [1, 2, 3];
    let r: &i32[3] = &arr;     // Borrow arr immutably
    arr[0] = 99;               // Error: cannot assign to 'arr' because it is borrowed
    let _read: i32 = (*r)[1];  // A use after the write keeps the borrow live
    return;
}
