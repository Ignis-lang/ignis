// Test: a guarded arm can be skipped, so the match is not a terminator even
// when every arm returns; should produce MissingReturnStatement

function describe(value: i32): i32 {
  match (value) {
    0 -> {
      return 1;
    },
    other if (other > 0) -> {
      return other;
    },
    _ -> {
      return 0;
    },
  };
}
