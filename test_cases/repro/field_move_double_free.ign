import String from "std::string";

enum Kind {
  STR(String),
}

record Holder {
  public kind: Kind;
}

function makeHolder(): Holder {
  return Holder { kind: Kind::STR(String::create("leak")) };
}

/// Extracts `kind` out of an already-bound local `Holder` instead of out of
/// a fresh construction or a whole-value move. `holder` still drops normally
/// at the end of this function, which drops the `String` inside `kind` a
/// second time: once here, once when the caller eventually drops the
/// returned `Kind`.
function extract(): Kind {
  let holder: Holder = makeHolder();
  return holder.kind;
}

function main(): i32 {
  let kind: Kind = extract();
  return match (&kind) {
    Kind::STR(_) -> 0,
  };
}
