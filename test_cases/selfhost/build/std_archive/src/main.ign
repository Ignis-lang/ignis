import Io from "std::io";
import String from "std::string";
import Vector from "std::vector";

record Point {
  public x: i32;
  public y: i32;
}

function main(): i32 {
  let greeting: String = String::create("linked from the std archive");
  Io::println(greeting.toStr());

  let mut points: Vector<Point> = Vector::new<Point>();
  points.push(Point { x: 3, y: 4 });

  let mut values: Vector<i32> = Vector::new<i32>();
  values.push(30);
  values.push(5);

  let mut total: i32 = 0;
  let mut index: u64 = 0;

  while (index < values.length()) {
    if (let Option::SOME(value) = values.get(index)) {
      total += *value;
    }

    index += 1;
  }

  if (let Option::SOME(point) = points.get(0)) {
    total += point.x + point.y;
  }

  return total;
}
