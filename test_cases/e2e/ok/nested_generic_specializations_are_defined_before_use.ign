@implements(Drop)
record Leaf {
    public tag: i32;

    drop(&mut self): void {
        return;
    }
}

@implements(Drop)
record Holder<T> {
    public value: T;

    drop(&mut self): void {
        @dropInPlace<T>(&mut self.value);
    }
}

function main(): i32 {
    let nested: Holder<Holder<Leaf>> = Holder<Holder<Leaf>> {
        value: Holder<Leaf> { value: Leaf { tag: 9 } },
    };

    return nested.value.value.tag;
}
