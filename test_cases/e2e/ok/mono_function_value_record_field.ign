// Regression for #205: a function stored in a record field by name (not
// called) must be reachable in mono and codegen-compatible with the closure
// field ABI.
function helper(n: i32): i32 {
  return n + 7;
}

record Ops {
  public transform: (i32) -> i32;
}

function main(): i32 {
  let ops: Ops = Ops { transform: helper };
  let f: (i32) -> i32 = ops.transform;
  return f(35);
}
