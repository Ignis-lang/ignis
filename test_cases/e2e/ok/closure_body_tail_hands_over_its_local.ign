// e2e: std
// A closure body that declares a value and names it as its tail returns that
// value. The body's scope ends right after, and it must not drop it.
import Io from "std::io";

function main(): i32 {
  let build = (): String -> {
    let local: String = String::create("built");
    local
  };
  let first: String = build();
  let second: String = build();
  Io::println(`${first.toStr()} ${second.toStr()}`.toStr());

  return 0;
}
