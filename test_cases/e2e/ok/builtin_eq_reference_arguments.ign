// `@eq` takes its operands through shared or mutable references.
function main(): i32 {
  let left: u64 = 5;
  let mut right: u64 = 5;

  if (!@eq<u64>(&left, &right)) {
    return 1;
  }

  if (!@eq<u64>(&left, &mut right)) {
    return 2;
  }

  right = 6;

  if (@eq<u64>(&left, &right)) {
    return 3;
  }

  return 0;
}
