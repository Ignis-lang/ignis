// e2e: std
// `@eq` takes its operands through shared or mutable references and compares
// the values behind them, for every kind of equality it supports.
import Eq from "std::hash";

@implements(Eq)
record Point {
  public x: i32;

  public equals(&self, other: &Point): boolean {
    return self.x == other.x;
  }
}

function main(): i32 {
  let left: u64 = 5;
  let mut right: u64 = 5;

  if (!@eq<u64>(&left, &right)) {
    return 1;
  }

  if (!@eq<u64>(&left, &mut right)) {
    return 2;
  }

  right = 6;

  if (@eq<u64>(&left, &right)) {
    return 3;
  }

  let byteA: u8 = 200;
  let byteB: u8 = 200;
  let byteC: u8 = 7;

  if (!@eq<u8>(&byteA, &byteB) || @eq<u8>(&byteA, &byteC)) {
    return 4;
  }

  let shortA: i16 = -3;
  let shortB: i16 = -3;
  let shortC: i16 = 3;

  if (!@eq<i16>(&shortA, &shortB) || @eq<i16>(&shortA, &shortC)) {
    return 5;
  }

  let flagA: boolean = true;
  let flagB: boolean = true;
  let flagC: boolean = false;

  if (!@eq<boolean>(&flagA, &flagB) || @eq<boolean>(&flagA, &flagC)) {
    return 6;
  }

  let letterA: char = 'ñ';
  let letterB: char = 'ñ';
  let letterC: char = 'n';

  if (!@eq<char>(&letterA, &letterB) || @eq<char>(&letterA, &letterC)) {
    return 7;
  }

  let textA: str = "same";
  let textB: str = "same";
  let textC: str = "other";

  if (!@eq<str>(&textA, &textB) || @eq<str>(&textA, &textC)) {
    return 8;
  }

  let pointA: Point = Point { x: 1 };
  let pointB: Point = Point { x: 1 };
  let pointC: Point = Point { x: 2 };

  if (!@eq<Point>(&pointA, &pointB) || @eq<Point>(&pointA, &pointC)) {
    return 9;
  }

  return 0;
}
