// e2e: skip helper module of e2e::trait_extension_cross_module: alone it has no main and cannot link; it runs through the entry fixture
export trait Score {
  score(&self): i64;

  static zero(): Self;

  bonus(&self): i64 {
    return self.score() + 100;
  }
}

@implements(Score)
extension i64 {
  score(&self): i64 {
    return *self * 3;
  }

  static zero(): i64 {
    return 0;
  }
}

@implements(Score)
extension boolean {
  score(&self): i64 {
    return *self ? 1 : 0;
  }

  static zero(): boolean {
    return false;
  }
}
