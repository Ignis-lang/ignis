// e2e: std
// A user record can mark its own type parameter as an owning storage slot with
// `@owns`: owned arguments (`String`, a record without view fields) are
// accepted, and the record may heap-allocate for them.
import Io from "std::io";

record Slot<@owns T> {
  public value: T;
}

record Pet {
  public name: String;
  public legs: i32;
}

function main(): i32 {
  let name: Slot<String> = Slot { value: String::create("rex") };
  let pet: Slot<Pet> = Slot { value: Pet { name: String::create("rex"), legs: 4 } };

  Io::print(`${name.value.toStr()} ${pet.value.legs}\n`);

  return pet.value.legs == 4 ? 0 : 1;
}
