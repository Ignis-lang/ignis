// A closure stored into a record that outlives the closure's own binding moves
// into that record, so the binding's scope ending does not free the
// environment the record still holds.
record Holder {
    public callback: () -> i32;
}

function main(): i32 {
    let base: i32 = 40;
    let mut holder = Holder { callback: (): i32 -> 0 };

    if (base > 0) {
        let add = (): i32 -> base + 2;
        holder = Holder { callback: add };
    }

    let call = holder.callback;

    return call();
}
