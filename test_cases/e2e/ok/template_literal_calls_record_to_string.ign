// e2e: std
import Io from "std::io";
import String from "std::string";

record Point {
  x: i32;
  y: i32;

  public toString(&self): String {
    return `(${self.x}, ${self.y})`;
  }
}

function main(): i32 {
  let point: Point = Point { x: 1, y: 2 };

  Io::println(`point=${point.toString()}`.toStr());

  return 0;
}
