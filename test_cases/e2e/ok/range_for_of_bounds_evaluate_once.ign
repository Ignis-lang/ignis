function trace(log: &mut i32, digit: i32, value: i32): i32 {
  *log = *log * 10 + digit;

  return value;
}

function main(): i32 {
  let mut log: i32 = 0;
  let mut count: i32 = 0;

  for (let value of trace(&mut log, 1, 0)..trace(&mut log, 2, 3)) {
    count += 1;
  }

  if (log != 12) {
    return 1;
  }

  if (count != 3) {
    return 2;
  }

  let mut limit: i32 = 4;
  let mut visited: i32 = 0;

  for (let value of 0..limit) {
    limit = 100;
    visited += 1;
  }

  if (visited != 4) {
    return 3;
  }

  let mut start: i32 = 2;
  let mut total: i32 = 0;

  for (let value of start..6) {
    start = 50;
    total += value;
  }

  if (total != 14) {
    return 4;
  }

  return 0;
}
