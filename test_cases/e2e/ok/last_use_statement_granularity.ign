// e2e: std
// A borrow held by a binding lasts through the whole statement of its last use: a
// use inside a loop keeps it for every iteration, and it ends after that statement.
// A closure capturing by `&mut` holds its borrow until the closure's last use.
import Io from "std::io";
import String from "std::string";

function main(): i32 {
  let mut owned: String = String::create("a");
  let text: str = owned.toStr();
  let mut index: i32 = 0;

  while (index < 2) {
    Io::println(text);
    index += 1;
  }

  owned.pushChar('b');
  Io::println(owned.toStr());

  let mut total: i32 = 0;
  let add = (amount: i32): void -> {
    total += amount;
  };
  add(2);
  add(3);
  total += 1;
  return total - 6;
}
