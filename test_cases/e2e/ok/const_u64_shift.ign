const ACCESS: u64 = 0x89;
const SIGNED_ACCESS: i64 = 0x89;

function main(): i32 {
  let shifted40: u64 = ACCESS << 40;

  if ((shifted40 >> 40) != 0x89) {
    return 1;
  }

  if ((shifted40 >> 32) != 0x8900) {
    return 2;
  }

  let shifted63: u64 = ACCESS << 63;

  if ((shifted63 >> 63) != 1) {
    return 3;
  }

  let inverted: u64 = ~ACCESS;

  if ((inverted >> 32) != 0xFFFFFFFF) {
    return 4;
  }

  if ((inverted & 0xFF) != 0x76) {
    return 5;
  }

  let signedShifted: i64 = SIGNED_ACCESS << 40;

  if ((signedShifted >> 40) != 0x89) {
    return 6;
  }

  let signedInverted: i64 = ~SIGNED_ACCESS;

  if (signedInverted != -138) {
    return 7;
  }

  return 0;
}
