// e2e: std
// A `static str` owns its bytes, so a `static mut` field of that type is
// accepted (S3): only view types are refused. Assigning another static string
// over it is an ordinary store.
record Status {
  static mut CURRENT: static str = "idle";
}

function main(): i32 {
  Status::CURRENT = "running";

  if (Status::CURRENT == "running") {
    Status::CURRENT = "stopped";
  }

  return 0;
}
