// e2e: std
// `Thread::spawn` runs a task on another thread and `join` hands back what the
// task returned, including an owned value moved across threads.
import JoinHandle, Thread from "std::thread";

function main(): i32 {
  let base: i32 = 40;
  let number: JoinHandle<i32> = Thread::spawn<i32>((): i32 -> base + 2);
  let text: JoinHandle<String> = Thread::spawn<String>((): String -> String::create("joined"));
  let message: String = text.join();

  if (message.length() != 6) {
    return 1;
  }

  return number.join();
}
