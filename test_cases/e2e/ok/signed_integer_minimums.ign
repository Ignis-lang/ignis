// Every minimum is checked against its type's maximum instead of another
// literal: a minimum that folds to a wrong value would compare equal to an
// expectation folded the same way and the test would pass.
function main(): i32 {
    let minimum8: i8 = -128;
    let maximum8: i8 = 127;
    let castMinimum8: i8 = -128 as i8;

    if (minimum8 + maximum8 != -1) {
        return 1;
    }

    if (castMinimum8 != minimum8) {
        return 2;
    }

    let minimum16: i16 = -32768;
    let maximum16: i16 = 32767;
    let castMinimum16: i16 = -32768 as i16;

    if (minimum16 + maximum16 != -1) {
        return 3;
    }

    if (castMinimum16 != minimum16) {
        return 4;
    }

    let minimum32: i32 = -2147483648;
    let maximum32: i32 = 2147483647;
    let castMinimum32: i32 = -2147483648 as i32;

    if (minimum32 + maximum32 != -1) {
        return 5;
    }

    if (castMinimum32 != minimum32) {
        return 6;
    }

    if (minimum32 + 1 != -maximum32) {
        return 7;
    }

    let minimum64: i64 = -9223372036854775808;
    let maximum64: i64 = 9223372036854775807;
    let castMinimum64: i64 = -9223372036854775808 as i64;

    if (minimum64 + maximum64 != -1) {
        return 8;
    }

    if (castMinimum64 != minimum64) {
        return 9;
    }

    if (minimum64 + 1 != -maximum64) {
        return 10;
    }

    let widenedMinimum32: i64 = -2147483648 as i64;

    if (widenedMinimum32 != (minimum32 as i64)) {
        return 11;
    }

    if (widenedMinimum32 * 2 != -(maximum32 as i64) * 2 - 2) {
        return 12;
    }

    let belowMinimum32: i64 = -2147483649;

    if (belowMinimum32 + 1 != widenedMinimum32) {
        return 13;
    }

    return 42;
}
