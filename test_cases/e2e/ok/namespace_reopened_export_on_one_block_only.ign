// One block of a reopened namespace carries `export` and the other does not;
// the host merges them regardless of which block (if any) is exported, and
// both blocks' members stay reachable as `Foo::*` in the declaring module
// (IGN-230). Order does not matter: swapping which block is exported
// (`namespace_reopened_export_on_second_block_only.ign`) behaves the same.
export namespace Foo {
  function a(): i32 {
    return 1;
  }
}

namespace Foo {
  function b(): i32 {
    return 2;
  }
}

function main(): i32 {
  return Foo::a() + Foo::b();
}
