// e2e: std
// A trait default declared in another module unrolls its `comptime for` over
// the fields of records declared here, calling that module's helpers.
import Io from "std::io";
import Summary from "./comptime_for_cross_module/summary";

@implements(Summary)
record Point {
  public x: i32;
  public y: i32;
}

@implements(Summary)
record Line {
  public start: i32;
  public end: i32;
  public weight: i32;
}

function main(): i32 {
  let point: Point = Point { x: 3, y: 4 };
  let line: Line = Line { start: 1, end: 9, weight: 2 };
  Io::println(point.summary().toStr());
  Io::println(line.summary().toStr());
  return 0;
}
