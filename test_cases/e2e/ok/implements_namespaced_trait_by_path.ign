// `@implements` names a trait declared in a namespace with its full path, and
// the record satisfies a generic bound written with the same path.
namespace Shapes {
  trait Measured {
    area(&self): i32;
  }

  namespace Nested {
    trait Labeled {
      label(&self): i32;
    }
  }
}

@implements(Shapes::Measured, Shapes::Nested::Labeled)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }

  label(&self): i32 {
    return 4;
  }
}

function measure<T: Shapes::Measured>(value: &T): i32 {
  return value.area();
}

function labelOf<T: Shapes::Nested::Labeled>(value: &T): i32 {
  return value.label();
}

function main(): i32 {
  let square: Square = Square { side: 3 };
  return measure<Square>(&square) + labelOf<Square>(&square);
}
