enum Maybe {
    Some(i32),
    None,
}

function nextValue(value: i32): Maybe {
    if (value > 0) {
        return Maybe::Some(value);
    }

    return Maybe::None;
}

function main(): i32 {
    let mut current: i32 = 4;
    let mut total: i32 = 0;

    while (let Maybe::Some(x) = nextValue(current)) {
        total += x;
        current -= 1;
    }

    return total;
}
