function main(): i32 {
  let mut sum: i32 = 0;

  for (let value of 0..=4) {
    sum += value;
  }

  if (sum != 10) {
    return 1;
  }

  let mut single: i32 = 0;

  for (let value of 7..=7) {
    single += value;
  }

  if (single != 7) {
    return 2;
  }

  let mut reversed: i32 = 0;

  for (let value of 5..=0) {
    reversed += 1;
  }

  if (reversed != 0) {
    return 3;
  }

  let mut negative: i32 = 0;

  for (let value of -2..=2) {
    negative += value * value;
  }

  if (negative != 10) {
    return 4;
  }

  return 0;
}
