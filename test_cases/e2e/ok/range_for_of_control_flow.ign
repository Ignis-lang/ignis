function main(): i32 {
  let mut seen: u32 = 0;

  for (let value: u8 of 0..=255) {
    if (value % 2 == 0) {
      continue;
    }

    seen += 1;
  }

  if (seen != 128) {
    return 1;
  }

  let mut stopped: u32 = 0;

  for (let value of 0..100) {
    if (value == 7) {
      break;
    }

    stopped += 1;
  }

  if (stopped != 7) {
    return 2;
  }

  let mut pairs: u32 = 0;

  for (let row of 0..4) {
    for (let column of row..4) {
      pairs += 1;
    }
  }

  if (pairs != 10) {
    return 3;
  }

  return 0;
}
