// e2e: skip helper module of e2e::fn_pointer_xmod_trait_default: alone it has no main and cannot link; it runs through the entry fixture
//
// The default method takes a `fn` parameter and stores it in a `fn` local: the
// copy made for the importer must keep the parameter a function pointer, since
// a closure-typed parameter would not convert to `fn`.
export trait Transform {
  base(&self): i32;

  applied(&self, operation: fn(i32) -> i32): i32 {
    let pointer: fn(i32) -> i32 = operation;
    return pointer(self.base());
  }
}
