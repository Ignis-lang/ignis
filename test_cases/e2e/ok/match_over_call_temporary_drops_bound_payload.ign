// e2e: std
import Option from "std::option";

record Counter {
    static mut LIVE: i32 = 0;
}

@implements(Drop)
record Resource {
    public tag: i32;

    drop(&mut self): void {
        Counter::LIVE -= 1;
        return;
    }
}

function makeOption(tag: i32): Option<Resource> {
    Counter::LIVE += 1;
    return Option::SOME(Resource { tag: tag });
}

function main(): i32 {
    let observed: i32 = match (makeOption(5)) {
        Option::SOME(resource) -> resource.tag,
        Option::NONE -> 0,
    };

    return Counter::LIVE + observed - 5;
}
