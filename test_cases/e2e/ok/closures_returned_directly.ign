// A capturing closure written directly in return position escapes its frame, so
// its environment is heap-allocated and the binding that receives it frees it.
function makeAdder(base: i32): (i32) -> i32 {
    return (x: i32): i32 -> x + base;
}

function main(): i32 {
    let add = makeAdder(40);

    return add(2);
}
