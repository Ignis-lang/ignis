// A `match` chooses between an existing closure and a closure literal, and the
// choice is returned. The arm naming `existing` moves it into the result, so the
// chosen value owns its environment on either path and the one left behind is
// freed by its own binding.
function pick(flag: boolean, a: i32, b: i32): (i32) -> i32 {
  let existing = (x: i32): i32 -> x + a;
  let chosen = match (flag) {
    true -> existing,
    false -> (x: i32): i32 -> x + b,
  };

  return chosen;
}

function main(): i32 {
  let first = pick(true, 1, 2);
  let second = pick(false, 1, 2);

  return first(20) + second(19);
}
