// A module directory whose name starts with a digit (`1a/`) must not run into
// the length in front of it: `1a/abcdefghijklmnopqr` and
// `a18abcdefghijklmnopqr` would otherwise both spell `21a18abcdefghijklmnopqr`
// and give their private `g` the same symbol.
import callA from "./symbol_digit_leading_module/1a/abcdefghijklmnopqr";
import callB from "./symbol_digit_leading_module/a18abcdefghijklmnopqr";

function main(): i32 {
  return callA() * 10 + callB();
}
