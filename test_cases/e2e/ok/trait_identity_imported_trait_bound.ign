// e2e: std
//
// A bound and an `@implements` that both name a trait imported from another
// module resolve to that trait, although `std::collections` declares another
// trait named `Hash`.
import Hash, Hasher from "std::hash";

@implements(Hash)
record Key {
  id: u64;

  hash(&self, hasher: &mut Hasher): void {
    let mut state: &mut Hasher = hasher;
    state.writeU64(self.id);
  }
}

function digest<T: Hash>(value: &T): u64 {
  let mut hasher: Hasher = Hasher::new();
  value.hash(&mut hasher);
  return hasher.finish();
}

function main(): i32 {
  let first: Key = Key { id: 7 };
  let second: Key = Key { id: 7 };

  if (digest<Key>(&first) == digest<Key>(&second)) {
    return 0;
  }

  return 1;
}
