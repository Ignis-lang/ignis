// A std `Vector<T>` iterates in `for ... of` by value, by `&T` and by
// `&mut T`, directly or through a reference, with `break` and `continue`.
import Io from "std::io";

function sumOf(numbers: &Vector<i32>): i32 {
  let mut total: i32 = 0;
  for (let n of numbers) {
    total += n;
  }
  return total;
}

function main(): i32 {
  let mut numbers: Vector<i32> = Vector::new<i32>();
  numbers.push(1);
  numbers.push(2);
  numbers.push(39);
  let mut total: i32 = 0;
  for (let n of numbers) {
    total += n;
  }
  Io::println(`${total} ${sumOf(&numbers)}`);
  let mut names: Vector<String> = Vector::new<String>();
  names.push(String::create("ada"));
  names.push(String::create("lin"));
  for (let name: &String of names) {
    Io::println(name.toStr());
  }
  for (let name: &mut String of names) {
    name.pushStr("!");
  }
  for (let name: &String of names) {
    if (name.length() == 0) {
      continue;
    }
    Io::println(name.toStr());
    break;
  }
  return 0;
}
