// e2e: std
// A trait declared in another module has a default calling a sibling static
// through `Self::`; the implementer here inherits it.
import Io from "std::io";
import Labeled from "./self_path_trait_default_cross_module/labeled";

@implements(Labeled)
record Tag {
  public unused: i32;

  static code(): i32 {
    return 7;
  }
}

function main(): i32 {
  Io::println(`tag ${Tag::doubledCode()}`.toStr());

  return 0;
}
