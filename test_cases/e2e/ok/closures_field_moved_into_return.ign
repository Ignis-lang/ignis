// Returning a closure read out of a local record's field moves it out of the
// field, so the caller owns the environment and the record does not free it.
record Holder {
    public callback: () -> i32;
}

function makeHolder(base: i32): Holder {
    let add = (): i32 -> base + 2;

    return Holder { callback: add };
}

function takeCallback(base: i32): () -> i32 {
    let holder = makeHolder(base);

    return holder.callback;
}

function main(): i32 {
    let call = takeCallback(40);

    return call();
}
