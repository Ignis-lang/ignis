trait HasValue {
    getValue(&self): i32;

    doubled(&self): i32 {
        return self.getValue() * 2;
    }
}

@implements(HasValue)
record Box {
    public value: i32;

    getValue(&self): i32 {
        return self.value;
    }
}

function main(): i32 {
    let b: Box = Box { value: 21 };
    return b.doubled();
}
