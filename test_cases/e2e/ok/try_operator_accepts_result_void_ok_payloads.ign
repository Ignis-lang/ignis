// e2e: std
import Result from "std::result";

function step(flag: boolean): Result<void, str> {
    if (flag) {
        return Result::OK(());
    }

    return Result::ERROR("boom");
}

function run(): Result<void, str> {
    step(true)!;
    return Result::OK(());
}

function main(): i32 {
    let code: i32 = match (run()) {
        Result::OK(_) -> 42,
        Result::ERROR(_) -> 1,
    };

    return code;
}
