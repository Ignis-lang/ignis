@implements(Drop)
record Managed {
  public value: i32;

  drop(&mut self): void {
      return;
  }
}

record Container {
  public managed: Managed;
  public tag: i32;
}

function main(): i32 {
    let c: Container = Container {
        managed: Managed { value: 99 },
        tag: 42
    };
    return c.tag;
}
