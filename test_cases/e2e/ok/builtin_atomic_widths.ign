function step(log: *mut i32, digit: i32, result: i32): i32 {
  @write<i32>(log, @read<i32>(log) * 10 + digit);
  return result;
}

function checkSmall(): i32 {
  let mut byte: u8 = 255;
  let bytePtr: *mut u8 = (&mut byte) as *mut u8;
  if (@atomicRmw<u8>(bytePtr, :add, 1, :relaxed) != 255) {
    return 1;
  }
  if (@atomicLoad<u8>(bytePtr, :relaxed) != 0) {
    return 2;
  }
  if (@atomicRmw<u8>(bytePtr, :sub, 1, :relaxed) != 0) {
    return 3;
  }
  if (@atomicLoad<u8>(bytePtr, :relaxed) != 255) {
    return 4;
  }

  let mut small: i8 = 127;
  let smallPtr: *mut i8 = (&mut small) as *mut i8;
  if (@atomicRmw<i8>(smallPtr, :add, 1, :seqCst) != 127) {
    return 5;
  }
  if (@atomicLoad<i8>(smallPtr, :seqCst) != -128) {
    return 6;
  }

  let mut half: i16 = -5;
  let halfPtr: *mut i16 = (&mut half) as *mut i16;
  if (@atomicRmw<i16>(halfPtr, :sub, 10, :acquire) != -5) {
    return 7;
  }
  if (@atomicLoad<i16>(halfPtr, :acquire) != -15) {
    return 8;
  }

  let mut bits: u16 = 0xF0F0;
  let bitsPtr: *mut u16 = (&mut bits) as *mut u16;
  if (@atomicRmw<u16>(bitsPtr, :and, 0xFF00, :release) != 0xF0F0) {
    return 9;
  }
  if (@atomicRmw<u16>(bitsPtr, :or, 0x000F, :acqRel) != 0xF000) {
    return 10;
  }
  if (@atomicRmw<u16>(bitsPtr, :xor, 0xFFFF, :seqCst) != 0xF00F) {
    return 11;
  }
  if (@atomicLoad<u16>(bitsPtr, :seqCst) != 0x0FF0) {
    return 12;
  }

  let mut wide: i64 = -9000000000;
  let widePtr: *mut i64 = (&mut wide) as *mut i64;
  if (@atomicRmw<i64>(widePtr, :sub, 1000000000, :relaxed) != -9000000000) {
    return 13;
  }
  if (@atomicRmw<i64>(widePtr, :xor, -1, :relaxed) != -10000000000) {
    return 14;
  }
  if (@atomicLoad<i64>(widePtr, :relaxed) != 9999999999) {
    return 15;
  }

  let mut signed32: i32 = 5;
  let signed32Ptr: *mut i32 = (&mut signed32) as *mut i32;
  if (@atomicRmw<i32>(signed32Ptr, :or, 2, :relaxed) != 5) {
    return 16;
  }
  if (@atomicLoad<i32>(signed32Ptr, :relaxed) != 7) {
    return 17;
  }

  return 0;
}

function checkPointers(): i32 {
  let mut first: i32 = 1;
  let mut second: i32 = 2;
  let firstPtr: *mut i32 = (&mut first) as *mut i32;
  let secondPtr: *mut i32 = (&mut second) as *mut i32;
  let mut slot: *mut i32 = firstPtr;
  let slotPtr: *mut *mut i32 = (&mut slot) as *mut *mut i32;

  if (@atomicCompareExchange<*mut i32>(slotPtr, firstPtr, secondPtr, :seqCst, :seqCst) != firstPtr) {
    return 21;
  }
  if (@atomicLoad<*mut i32>(slotPtr, :acquire) != secondPtr) {
    return 22;
  }
  if (@atomicCompareExchange<*mut i32>(slotPtr, firstPtr, firstPtr, :acquire, :relaxed) != secondPtr) {
    return 23;
  }
  if (@read<i32>(@atomicLoad<*mut i32>(slotPtr, :relaxed)) != 2) {
    return 24;
  }
  if (@atomicRmw<*mut i32>(slotPtr, :swap, firstPtr, :release) != secondPtr) {
    return 25;
  }

  let mut flag: boolean = false;
  let flagPtr: *mut boolean = (&mut flag) as *mut boolean;
  if (@atomicCompareExchange<boolean>(flagPtr, false, true, :relaxed, :relaxed)) {
    return 26;
  }
  if (!@atomicCompareExchange<boolean>(flagPtr, false, true, :release, :relaxed)) {
    return 27;
  }
  @atomicStore<boolean>(flagPtr, false, :relaxed);
  if (@atomicLoad<boolean>(flagPtr, :seqCst)) {
    return 28;
  }

  let readOnly: *i32 = firstPtr as *i32;
  if (@atomicLoad<i32>(readOnly, :seqCst) != 1) {
    return 29;
  }

  return 0;
}

function checkOrder(): i32 {
  let mut cell: i32 = 3;
  let cellPtr: *mut i32 = (&mut cell) as *mut i32;
  let mut log: i32 = 0;
  let logPtr: *mut i32 = (&mut log) as *mut i32;

  let observed: i32 = @atomicCompareExchange<i32>(cellPtr, step(logPtr, 1, 3), step(logPtr, 2, 8), :seqCst, :relaxed);
  if (observed != 3) {
    return 31;
  }
  if (log != 12) {
    return 32;
  }
  if (cell != 8) {
    return 33;
  }

  @atomicStore<i32>(cellPtr, step(logPtr, 3, 4), :seqCst);
  if (log != 123 || cell != 4) {
    return 34;
  }

  let previous: i32 = @atomicRmw<i32>(cellPtr, :add, step(logPtr, 4, 1), :seqCst);
  if (log != 1234 || previous != 4 || cell != 5) {
    return 35;
  }

  @fence(:relaxed);
  @fence(:acquire);
  @fence(:release);
  @fence(:acqRel);
  @fence(:seqCst);
  return 0;
}

function main(): i32 {
  let small: i32 = checkSmall();
  if (small != 0) {
    return small;
  }
  let pointers: i32 = checkPointers();
  if (pointers != 0) {
    return pointers;
  }
  let order: i32 = checkOrder();
  if (order != 0) {
    return order;
  }
  return 42;
}
