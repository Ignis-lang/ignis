// e2e: std
//
// The `while` form of a `&&` chain of `let` conditions. The condition is
// re-evaluated on every iteration, so each iteration binds again and the loop
// body is the scope those bindings fall out of; the iteration that ends the loop
// is the one where a later link fails, and it owes the drops the body would have.
//
// The exit code is the construction/drop imbalance plus the difference between
// what each case read and what it had to read, so 0 means every Tracked was
// dropped exactly once.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

enum Kind {
  ONE(Tracked),
  EMPTY,
}

record Source {
  public remaining: i32;

  public next(&mut self): Kind {
    if (self.remaining <= 0) {
      return Kind::EMPTY;
    }

    self.remaining -= 1;
    Counters::MADE += 1;

    return Kind::ONE(Tracked { id: 1 });
  }
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

function one(id: i32): Kind {
  return Kind::ONE(tracked(id));
}

/// Two `let` conditions: the first drains, the second always binds. The
/// iteration that stops the loop is the one where the first link fails, so
/// nothing is bound on it.
function firstDrains(): i32 {
  let mut rounds: i32 = 0;
  let mut source: Source = Source { remaining: 3 };

  while (let Kind::ONE(item) = source.next() && let Kind::ONE(extra) = one(2)) {
    rounds += item.id + extra.id;
  }

  return rounds;
}

/// The second `let` drains. The iteration that stops the loop has already bound
/// the first `let`, and that binding is dropped on the short-circuit path.
function secondDrains(): i32 {
  let mut rounds: i32 = 0;
  let mut source: Source = Source { remaining: 2 };

  while (let Kind::ONE(item) = one(4) && let Kind::ONE(extra) = source.next()) {
    rounds += item.id + extra.id;
  }

  return rounds;
}

/// A `let` followed by a plain boolean: the boolean ends the loop on an
/// iteration where the `let` has already bound.
function booleanEnds(): i32 {
  let mut rounds: i32 = 0;

  while (let Kind::ONE(item) = one(8) && rounds < 16) {
    rounds += item.id;
  }

  return rounds;
}

/// The loop body leaves through a `break`, which must drop both bindings.
function bodyBreaks(): i32 {
  let mut rounds: i32 = 0;

  while (let Kind::ONE(item) = one(1) && let Kind::ONE(extra) = one(1)) {
    rounds += item.id + extra.id;

    if (rounds >= 4) {
      break;
    }
  }

  return rounds;
}

function main(): i32 {
  let mut observed: i32 = 0;

  observed += firstDrains() - 9;
  observed += secondDrains() - 10;
  observed += booleanEnds() - 16;
  observed += bodyBreaks() - 4;

  return Counters::MADE - Counters::DROPPED + observed;
}
