// e2e: std
import Rc, Weak from "std::rc";

function main(): i32 {
    let a: Rc<i32> = Rc::new<i32>(5);
    let w1: Weak<i32> = a.downgrade();
    let wc1: u32 = a.weakCount();

    let w2: Weak<i32> = w1.clone();
    let wc2: u32 = a.weakCount();

    // wc1 = 1, wc2 = 2, sum = 3
    return (wc1 + wc2) as i32;
}
