// e2e: skip helper module of e2e::import_shadows_unimported_std_name: alone it has no main and cannot link; it runs through the entry fixture
export record ArenaAllocator {
  public start: u64;

  public static init(capacity: u64): ArenaAllocator {
    return ArenaAllocator { start: capacity };
  }
}

export record HashSet<T> {
  public first: T;
}
