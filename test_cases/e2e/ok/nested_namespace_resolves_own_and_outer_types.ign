export namespace Outer {
    record Shared {
        public value: i32;
    }

    namespace Inner {
        record Own {
            public value: i32;
        }

        function make(): Own {
            return Own { value: 4 };
        }

        function fromOuter(): Shared {
            return Shared { value: 3 };
        }
    }
}

function main(): i32 {
    let own: Outer::Inner::Own = Outer::Inner::make();
    let shared: Outer::Shared = Outer::Inner::fromOuter();

    return shared.value * 10 + own.value;
}
