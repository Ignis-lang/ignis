// An operator after an `as` cast's type belongs to the surrounding expression, not to
// the type. A type parser that reaches past the type to claim it reports a compound or
// generic type nobody wrote and swallows the operand behind it. This file is also read
// by the G6 parse-verdict corpus, so the two parsers have to agree on every one of them.

function main(): i32 {
  let value: u64 = 12;

  let less: boolean = value as i32 < 9;
  let greater: boolean = value as i32 > 9;
  let lessEqual: boolean = value as i32 <= 9;
  let greaterEqual: boolean = value as i32 >= 9;
  let shifted: i32 = value as i32 >> 1;
  let ored: i32 = value as i32 | 1;
  let xored: i32 = value as i32 ^ 1;
  let anded: i32 = value as i32 & 1;
  let chained: boolean = value as i32 == 12 && value as i32 != 0;

  if (less || !greater || lessEqual || !greaterEqual) {
    return 1;
  }

  if (shifted != 6 || ored != 13 || xored != 13 || anded != 0 || !chained) {
    return 2;
  }

  return 0;
}
