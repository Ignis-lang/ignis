// e2e: std
// The trait and its extensions live in another module. Their methods, the
// inherited default and the static method are reached here directly and
// through a bound.
import Io from "std::io";
import Score from "./trait_extension_cross_module/scores";

function total<T: Score>(first: &T, second: &T): i64 {
  return first.score() + second.bonus() + T::zero().score();
}

function main(): i32 {
  let seven: i64 = 7;
  let yes: boolean = true;

  Io::println(`direct ${seven.score()} ${seven.bonus()} ${yes.score()}`.toStr());
  Io::println(`static ${i64::zero()}`.toStr());
  Io::println(`bound ${total<i64>(&seven, &seven)} ${total<boolean>(&yes, &yes)}`.toStr());

  return 0;
}
