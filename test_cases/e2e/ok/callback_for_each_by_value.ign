function forEachValue(data: *i32, len: i32, @noescape f: (i32) -> void): void {
    let mut i: i32 = 0;
    while (i < len) {
        f(data[i as u64]);
        i = i + 1;
    }
}

function main(): i32 {
    let data: i32[3] = [10, 20, 12];
    let ptr: *i32 = (&data[0]) as *i32;
    let mut sum: i32 = 0;
    forEachValue(ptr, 3, (x: i32): void -> { sum = sum + x; });
    return sum;
}
