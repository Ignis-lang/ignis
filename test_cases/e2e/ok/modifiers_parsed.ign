record User {
    public name: i32;
    private age: i32;

    public getValue(&self): i32 {
        return self.name + self.age;
    }

    private static secret(): i32 {
        return 42;
    }
}

function main(): i32 {
    let u: User = User { name: 10, age: 5 };
    return u.getValue() + User::secret();
}
