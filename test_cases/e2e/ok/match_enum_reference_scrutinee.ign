enum Option {
    Some(i32),
    None,

    public isSome(&self): boolean {
        return match (self) {
            Option::Some(_) -> true,
            Option::None -> false,
        };
    }
}

function main(): i32 {
    let v: Option = Option::Some(42);

    if (v.isSome()) {
        return 1;
    }

    return 0;
}
