// e2e: std
import Io from "std::io";
import String from "std::string";

// Each literal is written as the operand of `as`, where nothing is expected of
// it, and is checked by shifting instead of against another literal: a value
// that lost its high bits would still equal an expectation that lost them too.
function main(): i32 {
    let u64Maximum: u64 = 18446744073709551615 as u64;
    let i64Maximum: i64 = 9223372036854775807 as i64;
    let u32Maximum: u32 = 4294967295 as u32;
    let i32Maximum: i32 = 2147483647 as i32;
    let u16Maximum: u16 = 65535 as u16;
    let u8Maximum: u8 = 255 as u8;
    let pastU32: u64 = 4294967296 as u64;
    let mixedBits: u64 = 970023320013 as u64;
    let signBit: u64 = 9223372036854775808 as u64;
    let i64FromPastI32: i64 = 2147483648 as i64;
    let narrowed: u32 = 4294967297 as u32;

    Io::println(String::create(u64Maximum).toStr());
    Io::println(String::create(i64Maximum).toStr());
    Io::println(String::create(u32Maximum).toStr());
    Io::println(String::create(i32Maximum).toStr());
    Io::println(String::create(u16Maximum).toStr());
    Io::println(String::create(u8Maximum).toStr());
    Io::println(String::create(pastU32).toStr());
    Io::println(String::create(mixedBits).toStr());
    Io::println(String::create(signBit).toStr());
    Io::println(String::create(i64FromPastI32).toStr());
    Io::println(String::create(narrowed).toStr());

    if ((u64Maximum >> 63) != 1 || (u64Maximum & 1) != 1) {
        return 1;
    }

    if ((i64Maximum >> 62) != 1) {
        return 2;
    }

    if ((pastU32 >> 32) != 1) {
        return 3;
    }

    if ((mixedBits >> 32) != 225) {
        return 4;
    }

    if ((signBit >> 63) != 1) {
        return 5;
    }

    if ((i64FromPastI32 >> 31) != 1) {
        return 6;
    }

    if (narrowed != 1) {
        return 7;
    }

    return 42;
}
