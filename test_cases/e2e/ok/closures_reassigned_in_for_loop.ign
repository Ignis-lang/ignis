// The `for` form reaches the same two-pass walk as `while`.
function make(): (i32) -> i32 {
    let base: i32 = 40;
    let mut f = (x: i32): i32 -> x + base;

    for (let i: i32 = 0; i < 3; i++) {
        f = (x: i32): i32 -> x + base;
    }

    return f;
}

function main(): i32 {
    let g = make();

    return g(2);
}
