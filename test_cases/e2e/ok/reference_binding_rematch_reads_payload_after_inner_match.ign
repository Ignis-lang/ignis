// e2e: std
//
// Re-matching a binding destructured out of a reference with a pattern that binds the
// droppable payload takes nothing out of it: the payload binding borrows the same
// referent, and the outer binding is still readable once the inner match is over.
import String from "std::string";

enum Inner {
  TEXT(String),
  EMPTY(i32),
}

enum Outer {
  WRAP(Inner),
  NONE,
}

function textLength(outer: &Outer): i32 {
  if (let Outer::WRAP(inner) = outer) {
    let mut total: i32 = 0;

    if (let Inner::TEXT(text) = inner) {
      total += text.length() as i32;
    }

    match (inner) {
      Inner::TEXT(again) -> {
        total += again.length() as i32;
      },
      Inner::EMPTY(code) -> {
        total += code;
      },
    };

    return total;
  }

  return -1;
}

function main(): i32 {
  let value: Outer = Outer::WRAP(Inner::TEXT(String::create("hello")));
  let mut sum: i32 = 0;
  let mut index: i32 = 0;

  while (index < 3) {
    sum += textLength(&value);
    index += 1;
  }

  return sum;
}
