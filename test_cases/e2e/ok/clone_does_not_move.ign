@implements(Drop, Clone)
record Resource {
    public tag: i32;

    drop(&mut self): void {
        return;
    }

    clone(&self): Resource {
        return Resource { tag: self.tag };
    }
}

function consume(r: Resource): i32 {
    return r.tag;
}

function main(): i32 {
    let r: Resource = Resource { tag: 42 };
    let r2: Resource = r.clone();
    return consume(r) + consume(r2);
}
