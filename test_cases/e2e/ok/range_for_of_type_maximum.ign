function main(): i32 {
  let mut bytes: u32 = 0;

  for (let value: u8 of 0..=255) {
    bytes += 1;
  }

  if (bytes != 256) {
    return 1;
  }

  let mut signedBytes: u32 = 0;
  let mut signedSum: i32 = 0;

  for (let value: i8 of -128..=127) {
    signedBytes += 1;
    signedSum += value as i32;
  }

  if (signedBytes != 256) {
    return 2;
  }

  if (signedSum != -128) {
    return 3;
  }

  let top: u64 = 18446744073709551615;
  let mut wide: u32 = 0;
  let mut last: u64 = 0;

  for (let value of (top - 2)..=top) {
    wide += 1;
    last = value;
  }

  if (wide != 3) {
    return 4;
  }

  if (last != top) {
    return 5;
  }

  let limit: u16 = 65535;
  let mut halfWords: u32 = 0;

  for (let value of 65533..=limit) {
    halfWords += 1;
  }

  if (halfWords != 3) {
    return 6;
  }

  let mut belowMaximum: u32 = 0;

  for (let value: u8 of 250..=254) {
    belowMaximum += 1;
  }

  if (belowMaximum != 5) {
    return 7;
  }

  return 0;
}
