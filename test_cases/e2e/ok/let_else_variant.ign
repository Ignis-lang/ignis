enum Outcome {
    Ok(i32),
    Err,
}

function toOutcome(value: i32): Outcome {
    if (value > 0) {
        return Outcome::Ok(value);
    }

    return Outcome::Err;
}

function unwrapOutcome(value: i32): i32 {
    let Outcome::Ok(v) = toOutcome(value) else {
        return -1;
    };

    return v;
}

function main(): i32 {
    return unwrapOutcome(9) + unwrapOutcome(0);
}
