// e2e: std
// e2e: allow-leak
import Io from "std::io";
import String from "std::string";

enum Kind {
  STR(String),
}

record Holder {
  public kind: Kind;
  public name: String;
}

function take(k: Kind): void {
  let _k: Kind = k;
}

function show(h: &Holder): void {
  match (&h.kind) {
    Kind::STR(s) -> Io::println(s.toStr()),
  };
}

function main(): i32 {
  let holder: Holder = Holder {
    kind: Kind::STR(String::create("a")),
    name: String::create("b"),
  };

  take(holder.kind);
  show(&holder);

  return 0;
}
