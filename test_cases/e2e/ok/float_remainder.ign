// `%` on floats is the truncated remainder (C `fmod`), the same value
// constant evaluation folds.
const FOLDED: f64 = 7.5 % 2.0;

function remainder(left: f64, right: f64): f64 {
  return left % right;
}

function main(): i32 {
  let mut accumulated: f64 = 10.0;
  let narrow: f32 = 5.5;

  accumulated %= 4.0;

  if (remainder(7.5, 2.0) != 1.5 || remainder(-7.5, 2.0) != -1.5) {
    return 1;
  }

  if (remainder(7.5, 2.0) != FOLDED) {
    return 2;
  }

  if (accumulated != 2.0) {
    return 3;
  }

  if (narrow % 2.0 != 1.5) {
    return 4;
  }

  return 0;
}
