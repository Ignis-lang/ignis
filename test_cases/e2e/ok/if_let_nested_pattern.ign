enum Maybe {
    Some(i32),
    None,
}

enum Nested {
    Wrap(Maybe),
    Empty,
}

function makeNested(value: i32): Nested {
    if (value > 0) {
        return Nested::Wrap(Maybe::Some(value));
    }

    return Nested::Empty;
}

function main(): i32 {
    if (let Nested::Wrap(Maybe::Some(x)) = makeNested(42)) {
        return x;
    }

    return 0;
}
