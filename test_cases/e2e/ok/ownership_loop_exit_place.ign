// e2e: std
//
// A loop whose `let` condition consumes a place. The condition takes that place
// apart on every round, so only a body that assigns to it refills it, and the
// round that ends the loop is the one the condition frees. An early exit never
// reaches that round: a `break` leaves the loop outright, a `return` leaves the
// function, and both owe whatever the last round put back. A `continue` owes
// nothing — it re-enters the condition, which is the drop site itself.
//
// The exit code is the construction/drop imbalance plus the difference between
// what each case read and what it had to read, so 0 means every Tracked was
// dropped exactly once.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

enum Kind {
  ONE(Tracked),
  EMPTY,
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

function one(id: i32): Kind {
  return Kind::ONE(tracked(id));
}

/// The body refills the place and then breaks. The value it put back is live at
/// the `break`, the condition that would have freed it never runs again, and the
/// `break` is the only site left that can drop it.
function breakAfterRefill(): i32 {
  let mut rounds: i32 = 0;
  let mut holder: Kind = one(1);

  while (let Kind::ONE(item) = holder) {
    rounds += item.id;
    holder = one(1);

    if (rounds >= 2) {
      break;
    }
  }

  return rounds;
}

/// The mirror image: the `break` comes before the assignment, so the place is
/// still the moved-out husk the condition left and the `break` owes nothing for
/// it. Dropping it here would free what the binding already owns.
function breakBeforeRefill(): i32 {
  let mut rounds: i32 = 0;
  let mut holder: Kind = one(1);

  while (let Kind::ONE(item) = holder) {
    rounds += item.id;

    if (rounds >= 2) {
      break;
    }

    holder = one(1);
  }

  return rounds;
}

/// A `return` out of the same loop. It unwinds every scope down to the function
/// root, and the place is an ordinary local of one of them.
function returnAfterRefill(): i32 {
  let mut rounds: i32 = 0;
  let mut holder: Kind = one(1);

  while (let Kind::ONE(item) = holder) {
    rounds += item.id;
    holder = one(1);

    if (rounds >= 2) {
      return rounds;
    }
  }

  return rounds;
}

/// A `continue` jumps back to the condition, which consumes the place the body
/// just refilled. Nothing is owed at the `continue` itself, and the round that
/// reads the empty variant is where the loop ends.
function continueThenExhaustion(): i32 {
  let mut rounds: i32 = 0;
  let mut holder: Kind = one(1);

  while (let Kind::ONE(item) = holder) {
    rounds += item.id;

    if (rounds >= 3) {
      holder = Kind::EMPTY;
      continue;
    }

    holder = one(1);
  }

  return rounds;
}

/// A conjunct in front of the `let`. The `break` path still runs the `let`, so
/// it owes the same refilled place; the short-circuit path is a different exit
/// and keeps its own drop.
function breakAfterRefillBehindConjunct(): i32 {
  let mut rounds: i32 = 0;
  let mut holder: Kind = one(1);

  while (rounds < 8 && let Kind::ONE(item) = holder) {
    rounds += item.id;
    holder = one(1);

    if (rounds >= 2) {
      break;
    }
  }

  return rounds;
}

/// The place lives inside a block the loop does not leave, so the `break` frees
/// the refilled value while the enclosing block keeps every drop it still owes.
function breakInsideNestedBlock(): i32 {
  let mut rounds: i32 = 0;
  let mut holder: Kind = one(1);
  let keep: Kind = one(1);

  while (let Kind::ONE(item) = holder) {
    let extra: Kind = one(1);

    rounds += item.id;
    holder = one(1);

    if (let Kind::ONE(spare) = extra) {
      rounds += spare.id;
    }

    if (rounds >= 4) {
      break;
    }
  }

  if (let Kind::ONE(last) = keep) {
    rounds += last.id;
  }

  return rounds;
}

function main(): i32 {
  let mut observed: i32 = 0;

  observed += breakAfterRefill() - 2;
  observed += breakBeforeRefill() - 2;
  observed += returnAfterRefill() - 2;
  observed += continueThenExhaustion() - 3;
  observed += breakAfterRefillBehindConjunct() - 2;
  observed += breakInsideNestedBlock() - 5;

  return Counters::MADE - Counters::DROPPED + observed;
}
