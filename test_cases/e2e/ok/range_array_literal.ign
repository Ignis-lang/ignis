function main(): i32 {
  let small: u8[4] = [0..4];

  if (small[0] != 0 || small[3] != 3) {
    return 1;
  }

  let inclusive: i32[5] = [1..=5];
  let mut sum: i32 = 0;

  for (let value of inclusive) {
    sum += value;
  }

  if (sum != 15) {
    return 2;
  }

  let negative: i32[5] = [-2..3];

  if (negative[0] != -2 || negative[4] != 2) {
    return 3;
  }

  let bytes: u8[256] = [0..=255];
  let mut byteSum: u32 = 0;

  for (let value of bytes) {
    byteSum += value as u32;
  }

  if (byteSum != 32640) {
    return 4;
  }

  let signed: i8[256] = [-128..=127];

  if (signed[0] != -128 || signed[255] != 127) {
    return 5;
  }

  let wide: u64[3] = [18446744073709551613..=18446744073709551615];

  if (wide[0] != 18446744073709551613 || wide[2] != 18446744073709551615) {
    return 6;
  }

  let defaulted = [10..13];
  let typed: i32[3] = defaulted;

  if (typed[1] != 11) {
    return 7;
  }

  return 0;
}
