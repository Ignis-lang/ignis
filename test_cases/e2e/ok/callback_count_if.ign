function countIf(data: *i32, len: i32, @noescape predicate: (i32) -> boolean): i32 {
    let mut n: i32 = 0;
    let mut i: i32 = 0;
    while (i < len) {
        if (predicate(data[i as u64])) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

function main(): i32 {
    let data: i32[5] = [1, 2, 3, 4, 5];
    let ptr: *i32 = (&data[0]) as *i32;
    return countIf(ptr, 5, (x: i32): boolean -> x % 2 == 0);
}
