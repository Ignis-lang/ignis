// e2e: std
// Inside a record, `Self::name` reaches the record's static methods and static
// fields from both static and instance methods, as the record's own name does.
import Io from "std::io";

record Counter {
  public value: i32;

  static BASE: i32 = 10;

  static create(value: i32): Counter {
    return Counter { value: value };
  }

  static fromBase(): Counter {
    return Self::create(Self::BASE + 1);
  }

  bumped(&self): Counter {
    return Self::create(self.value + 1);
  }
}

function main(): i32 {
  let counter: Counter = Counter::fromBase();
  let next: Counter = counter.bumped();
  Io::println(`counter ${counter.value} ${next.value}`.toStr());

  return 0;
}
