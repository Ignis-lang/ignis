// e2e: std
import HashMap from "std::collections";

function main(): i32 {
  let mut byUnsigned: HashMap<u32, u32> = HashMap::new<u32, u32>();
  byUnsigned.insert(7, 40);

  // The keys are literals, so the map stores `static str` keys: a `str` key
  // is a view and cannot fill the map's `@owns K` slot.
  let mut byStr: HashMap<static str, u32> = HashMap::new<static str, u32>();
  byStr.insert("two", 2);

  let mut total: u32 = 0;
  let unsignedKey: u32 = 7;
  let strKey: static str = "two";

  if (let Option::SOME(value) = byUnsigned.get(&unsignedKey)) {
    total += *value;
  }

  if (let Option::SOME(value) = byStr.get(&strKey)) {
    total += *value;
  }

  return total as i32;
}
