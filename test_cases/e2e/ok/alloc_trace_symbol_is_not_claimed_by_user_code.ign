// A user function carrying the allocation tracer's fixed symbol must not make
// the generated main wrapper call it. Without the feature the tracer does not
// exist, and a wrapper that called this instead would link against a symbol
// dead-code elimination removes.

@externName("ignis_alloc_trace_report")
export function decoyReport(): void {
  return;
}
function main(): i32 {
  return 0;
}
