// e2e: std
//
// A view's borrow ends at its holder's last use, so the owner can be moved
// into a container afterwards: pushing an owned value never touches the view.
import Io from "std::io";
import String from "std::string";

function main(): i32 {
  let mut list: Vector<String> = Vector::new<String>();
  let owned: String = String::create("abc");
  let text: str = owned.toStr();
  Io::println(text);
  list.push(String::create("x"));
  list.push(owned);

  return list.length() as i32 - 2;
}
