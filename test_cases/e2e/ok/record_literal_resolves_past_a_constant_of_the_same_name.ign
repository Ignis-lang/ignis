record Point {
    public x: i32;
}

export namespace Holder {
    const Point: i32 = 99;

    function make(): Point {
        return Point { x: 34 };
    }

    function constant(): i32 {
        return Holder::Point;
    }
}

function main(): i32 {
    return Holder::make().x + Holder::constant();
}
