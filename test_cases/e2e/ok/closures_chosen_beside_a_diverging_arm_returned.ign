// A `match` whose arms are a closure literal and an arm that returns early.
// The diverging arm produces no value, so the binding still names only the
// literal: its environment is heap-allocated, owned by the binding, and handed
// to the caller on return.
function pick(mode: i32, a: i32): (i32) -> i32 {
    let chosen = match (mode) {
        0 -> (x: i32): i32 -> x + a,
        _ -> {
            return (x: i32): i32 -> x - a;
        },
    };

    return chosen;
}

function main(): i32 {
    let add = pick(0, 40);
    let addSmall = pick(0, 1);
    let subtract = pick(1, 3);

    return add(0) + addSmall(1) + subtract(3);
}
