// e2e: std
// Array literals initialize their storage element by element: scalars of
// every width and records.
import Io from "std::io";

record Pair {
  public left: u8;
  public right: i64;
}

function sum(values: i32[2]): i32 {
  return values[0] + values[1];
}

function main(): i32 {
  let mut pipe: i32[2] = [0, 0];
  pipe[1] = 41;
  let bytes: u8[3] = [250, 7, 1];
  let wide: i64[2] = [-9000000000, 9000000000];
  let pairs: Pair[2] = [Pair { left: 1, right: -2 }, Pair { left: 3, right: 4 }];
  let shorts: i16[2] = [-1, 2];

  Io::println(`pipe ${sum(pipe)} bytes ${bytes[0]} ${bytes[1]} ${bytes[2]}`);
  Io::println(`wide ${wide[0]} ${wide[1]}`);
  Io::println(`pairs ${pairs[0].left} ${pairs[0].right} ${pairs[1].left} ${pairs[1].right}`);
  Io::println(`shorts ${shorts[0]} ${shorts[1]}`);

  return 0;
}
