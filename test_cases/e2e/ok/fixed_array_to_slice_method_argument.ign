// A fixed array passed where a method or a static method takes a slice
// becomes a slice over the array, as it does for a free function.
import Io from "std::io";

record Sink {
  public total: u64;

  public add(&mut self, bytes: u8[]): void {
    self.total += bytes.length();
  }

  public static count(bytes: u8[]): u64 {
    return bytes.length();
  }
}

function countFree(bytes: u8[]): u64 {
  return bytes.length();
}

function main(): i32 {
  let chunk: u8[4] = [1, 2, 3, 4];
  let mut sink: Sink = Sink { total: 0 };
  sink.add(chunk);
  Io::println(`${sink.total} ${Sink::count(chunk)} ${countFree(chunk)}`);
  return 0;
}
