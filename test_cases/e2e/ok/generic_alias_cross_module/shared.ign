// e2e: skip helper module of e2e::generic_alias_cross_module: alone it has no main and cannot link; it runs through the entry fixture
export record Cell<T> {
  public value: T;

  public get(&self): &T {
    return &self.value;
  }
}

export type Boxed<T> = Cell<T>;

export function boxed<T>(value: T): Boxed<T> {
  return Cell { value: value };
}
