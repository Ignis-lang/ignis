// e2e: std
// A `HashSet` stores the zero-sized `HashSetMarker` record as its map value,
// so inserting, finding and removing go through a record with no fields.
import HashSet from "std::collections";
import Io from "std::io";

record Empty {}

function passThrough(value: Empty, tag: i32): i32 {
  let copy: Empty = value;
  let _: Empty = copy;

  return tag;
}

function main(): i32 {
  let mut set: HashSet<u32> = HashSet::new<u32>();
  let first: boolean = set.insert(7);
  let second: boolean = set.insert(7);
  set.insert(11);

  let seven: u32 = 7;
  let missing: u32 = 9;

  Io::println(`first ${first} second ${second} length ${set.length()}`);
  Io::println(`contains 7 ${set.contains(&seven)} contains 9 ${set.contains(&missing)}`);
  Io::println(`tag ${passThrough(Empty {}, 5)}`);

  return 0;
}
