// e2e: std
// `collect`'s parameter is not `@noescape` and it does store the closure, so the
// argument escapes with a heap environment and moves into the parameter, which
// hands it on to the vector that frees it exactly once.
import Vector from "std::vector";

function collect(f: (i32) -> i32): i32 {
    let result: i32 = f(2);

    let mut callbacks: Vector<(i32) -> i32> = Vector::new<(i32) -> i32>();
    callbacks.push(f);

    return result;
}

function main(): i32 {
    let base: i32 = 40;
    let add = (x: i32): i32 -> x + base;

    return collect(add);
}
