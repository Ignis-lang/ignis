// e2e: std
// Inside an enum, `Self::VARIANT` builds and matches the enum's own variants,
// payload variants included.
import Io from "std::io";

enum Shade {
  RED,
  GRAY(i32),

  static dark(): Shade {
    return Self::GRAY(20);
  }

  static fromLevel(level: i32): Shade {
    if (level == 0) {
      return Self::RED;
    }

    return Self::GRAY(level);
  }

  level(&self): i32 {
    match (*self) {
      Self::RED -> {
        return 0;
      },
      Self::GRAY(value) -> {
        return value;
      },
    };
  }
}

function main(): i32 {
  Io::println(`shade ${Shade::fromLevel(0).level()} ${Shade::fromLevel(7).level()} ${Shade::dark().level()}`.toStr());

  return 0;
}
