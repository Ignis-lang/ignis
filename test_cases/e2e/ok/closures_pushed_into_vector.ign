// e2e: std
// `Vector::push` takes its value without `@noescape`, so the closure escapes
// with a heap environment and moves into the vector, which frees it exactly
// once when the vector is dropped.
import Vector from "std::vector";

function main(): i32 {
    let base: i32 = 40;
    let add = (x: i32): i32 -> x + base;

    let mut callbacks: Vector<(i32) -> i32> = Vector::new<(i32) -> i32>();
    callbacks.push(add);

    return (callbacks.length() as i32) + 41;
}
