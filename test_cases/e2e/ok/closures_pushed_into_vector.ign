// e2e: std
// `Vector::push` takes its value without `@noescape`, so the closure escapes and
// gets a heap environment; the binding frees it exactly once at scope exit.
import Vector from "std::vector";

function main(): i32 {
    let base: i32 = 40;
    let add = (x: i32): i32 -> x + base;

    let mut callbacks: Vector<(i32) -> i32> = Vector::new<(i32) -> i32>();
    callbacks.push(add);

    return add(2) + (callbacks.length() as i32) - 1;
}
