record Counter {
    public value: i32;

    add(&mut self, amount: i32): i32 {
        self.value = self.value + amount;
        return self.value;
    }
}

record Holder {
    public counter: Counter;
}
record Outer {
    public holder: Holder;
}

function bump(holder: &mut Holder): i32 {
    return holder.counter.add(10);
}

function main(): i32 {
    let mut holder: Holder = Holder { counter: Counter { value: 1 } };
    holder.counter.add(2);
    3 |> holder.counter.add();

    let mut outer: Outer = Outer { holder: Holder { counter: Counter { value: 0 } } };
    outer.holder.counter.add(4);

    let total: i32 = bump(&mut holder) + outer.holder.counter.value;
    return total;
}
