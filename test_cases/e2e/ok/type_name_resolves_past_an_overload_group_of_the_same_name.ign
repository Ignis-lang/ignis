record Point {
    public x: i32;
}

export namespace Holder {
    function Point(value: i32): i32 {
        return value;
    }

    function Point(first: i32, second: i32): i32 {
        return first + second;
    }

    function make(): Point {
        return Point { x: 4 };
    }

    function sum(): i32 {
        return Holder::Point(1, 2) + Holder::Point(30);
    }
}

function main(): i32 {
    return Holder::make().x + Holder::sum();
}
