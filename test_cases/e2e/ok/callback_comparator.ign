function minOf3(@noescape compare: (i32, i32) -> i32, a: i32, b: i32, c: i32): i32 {
    let mut result: i32 = a;
    if (compare(b, result) < 0) { result = b; }
    if (compare(c, result) < 0) { result = c; }
    return result;
}

function main(): i32 {
    return minOf3((a: i32, b: i32): i32 -> a - b, 30, 10, 20);
}
