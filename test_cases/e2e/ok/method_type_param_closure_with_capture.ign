record Box<T> {
    value: T;

    transform<U>(&self, f: (T) -> U): U {
        return f(self.value);
    }
}

function main(): i32 {
    let multiplier: i64 = 3;
    let b: Box<i32> = Box { value: 14 };
    let result: i64 = b.transform((x: i32): i64 -> x as i64 * multiplier);
    return result as i32;
}
