// e2e: std
//
// A match in statement position gives its arm's value to nobody. Treating an arm that
// names an owning parameter as a hand-over left the parameter marked moved with no drop
// anywhere, and the fallback leaked on the path that named it.
//
// Only the arm that names the parameter is exercised. The arm that names its own pattern
// binding is not handed over either: the binding keeps its drop at the arm end, which
// match_statement_arm_own_binding_is_dropped exercises at runtime. Both statement-position
// cases are covered by the drop schedule of this fixture.
import String from "std::string";
import Option from "std::option";

function sink(source: Option<String>, fallback: String): i32 {
  match (source) {
    Option::SOME(text) -> text,
    Option::NONE -> fallback,
  };

  return 0;
}

function main(): i32 {
  return sink(Option::NONE, String::create("fallback"));
}
