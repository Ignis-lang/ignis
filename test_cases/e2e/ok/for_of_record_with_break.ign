record IntVec {
    data: *mut i32;
    length: u64;
    capacity: u64;
}

function main(): i32 {
    let mut arr: i32[4] = [1, 2, 100, 4];
    let vec: IntVec = IntVec { data: (&mut arr[0]) as *mut i32, length: 4, capacity: 4 };

    let mut sum: i32 = 0;
    for (let item of vec) {
        if (item == 100) {
            break;
        }
        sum += item;
    }

    return sum;
}
