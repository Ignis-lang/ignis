@implements(Drop)
record Handle {
  public id: i32;

  drop(&mut self): void {
      return;
  }
}

record Person {
  public first: Handle;
  public last: Handle;
  public age: i32;
}

function main(): i32 {
    let p: Person = Person { first: Handle { id: 1 }, last: Handle { id: 2 }, age: 30 };
    return p.age;
}
