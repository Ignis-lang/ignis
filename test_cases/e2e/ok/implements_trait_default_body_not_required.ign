// A method with a default body in the trait is not required: a record and an
// enum that declare only the required method compile and inherit the default.
trait Measured {
  area(&self): i32;

  sides(&self): i32 {
    return 4;
  }
}

@implements(Measured)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

@implements(Measured)
enum Shape {
  POINT,

  area(&self): i32 {
    return 1;
  }
}

function main(): i32 {
  let square: Square = Square { side: 3 };
  let shape: Shape = Shape::POINT;
  return square.area() + square.sides() + shape.area();
}
