// The inner closure sits in the tail expression of the outer closure's body, so
// it leaves the outer closure's frame the same way an explicit return does.
function makeAdder(base: i32): (i32) -> i32 {
    let make = (): (i32) -> i32 -> (x: i32): i32 -> x + base;

    return make();
}

function main(): i32 {
    let add = makeAdder(40);

    return add(2);
}
