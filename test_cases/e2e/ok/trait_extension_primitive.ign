// A trait implemented for i64 and str by extension blocks declared next to the
// trait: instance and static methods, an inherited default, calls on a
// variable and on a cast, and the static path on the primitive type name.
trait Describe {
  describe(&self): i64;

  static read(raw: i64): Self;

  twice(&self): i64 {
    return self.describe() * 2;
  }
}

@implements(Describe)
extension i64 {
  describe(&self): i64 {
    return *self + 1;
  }

  static read(raw: i64): i64 {
    return raw * 10;
  }
}

@implements(Describe)
extension str {
  describe(&self): i64 {
    return 100;
  }

  static read(raw: i64): str {
    return "read";
  }

  twice(&self): i64 {
    return 7;
  }
}

function main(): i32 {
  let value: i64 = 4;
  let text: str = "hello";
  let read: i64 = i64::read(3);
  let label: str = str::read(0);

  if (value.describe() != 5) {
    return 1;
  }

  if ((5 as i64).describe() != 6) {
    return 2;
  }

  if (value.twice() != 10) {
    return 3;
  }

  if (text.describe() != 100 || text.twice() != 7) {
    return 4;
  }

  if (read != 30 || label.describe() != 100) {
    return 5;
  }

  return 0;
}
