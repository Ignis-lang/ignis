export namespace First {
    record Point {
        public x: i32;
    }

    function make(): Point {
        return Point { x: 3 };
    }
}

export namespace Second {
    record Point {
        public x: i32;
    }

    function make(): Point {
        return Point { x: 4 };
    }
}

function main(): i32 {
    let first: First::Point = First::make();
    let second: Second::Point = Second::make();

    return first.x * 10 + second.x;
}
