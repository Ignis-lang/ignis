// e2e: std
import String from "std::string";

function currencyCode(currency: str): i32 {
  if (currency == "USD") {
    return 1;
  } else if (currency == "EUR") {
    return 2;
  }

  return 0;
}

function main(): i32 {
  let empty: str = "";
  let prefix: str = "US";
  let mut built: String = String::create(prefix);
  built.pushStr("D");
  let mut result: i32 = 0;

  if (currencyCode("USD") == 1) {
    result += 1;
  }

  if (currencyCode("EUR") == 2) {
    result += 2;
  }

  if (currencyCode("GBP") == 0) {
    result += 4;
  }

  if ("USD" != prefix) {
    result += 8;
  }

  if (!(prefix == "USD")) {
    result += 16;
  }

  if (empty == "") {
    result += 32;
  }

  if (built.toStr() == "USD" && currencyCode(built.toStr()) == 1) {
    result += 64;
  }

  return result;
}
