record Window {
  public span: Range<u32>;
  public label: i32;
}

function width(span: Range<i32>): i32 {
  return span.end - span.start;
}

function make(first: i32, last: i32): Range<i32> {
  return first..last;
}

function total(span: Range<i32>): i32 {
  let mut sum: i32 = 0;

  for (let value of span) {
    sum += value;
  }

  return sum;
}

function totalBytes(span: RangeInclusive<u8>): u32 {
  let mut sum: u32 = 0;

  for (let value of span) {
    sum += value as u32;
  }

  return sum;
}

function main(): i32 {
  let span = 2..7;

  if (width(span) != 5) {
    return 1;
  }

  let copy = span;

  if (total(span) != 20 || total(copy) != 20) {
    return 2;
  }

  if (total(make(1, 4)) != 6) {
    return 3;
  }

  let window = Window { span: 10..14, label: 1 };
  let mut visited: u32 = 0;

  for (let value of window.span) {
    visited += value;
  }

  if (visited != 46) {
    return 4;
  }

  let everything: RangeInclusive<u8> = 0..=255;

  if (totalBytes(everything) != 32640) {
    return 5;
  }

  let moved = window.span;

  if (moved.start != 10 || moved.end != 14) {
    return 6;
  }

  let mut empty: i32 = 0;

  for (let value of make(5, 5)) {
    if (value >= 0) {
      empty += 1;
    }
  }

  if (empty != 0) {
    return 7;
  }

  return 0;
}
