// `x ~= c` clears in `x` the bits set in `c`: it assigns `x & ~c`.
function clearBits(value: u64, mask: u64): u64 {
  let mut x: u64 = value;

  x ~= mask;

  return x;
}

function main(): i32 {
  let mut flags: u8 = 255;
  let mut signed: i32 = -1;

  flags ~= 15;
  signed ~= 1;

  if (clearBits(23, 6) != 17 || clearBits(0, 6) != 0) {
    return 1;
  }

  if (flags != 240) {
    return 2;
  }

  if (signed != -2) {
    return 3;
  }

  return 0;
}
