// e2e: std
import Rc, Weak from "std::rc";

function main(): i32 {
    let a: Rc<i32> = Rc::new<i32>(42);
    let w: Weak<i32> = a.downgrade();

    let Option::SOME(upgraded) = w.upgrade() else {
        return 1;
    };

    // The upgrade added a strong reference; `upgraded` releases it at scope end.
    return *upgraded.get();
}
