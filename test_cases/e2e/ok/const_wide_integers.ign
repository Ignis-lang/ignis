const SHIFTED: u64 = 0x89 << 40;
const INVERTED: u64 = ~0x89;
const UNSIGNED_MAX: u64 = 0xFFFFFFFFFFFFFFFF;
const SIGNED_MAX: i64 = 9223372036854775807;
const SIGNED_MIN: i64 = -9223372036854775808;
const WIDE_NEGATIVE: i64 = -5000000000;
const NARROW_UNSIGNED: u32 = 0xFFFFFFFF;
const NARROW_SIGNED: i32 = -2147483648;
const BYTE: u8 = 0xFF;
const HALF: u16 = 0xFFFF;
const LOW_WORD: u64 = 0xFFFFFFFF;
const ONE: i64 = 1;

function main(): i32 {
  if ((SHIFTED >> 40) != 0x89) {
    return 1;
  }

  if ((INVERTED >> 32) != 0xFFFFFFFF) {
    return 2;
  }

  if ((UNSIGNED_MAX >> 63) != 1) {
    return 3;
  }

  if ((SIGNED_MAX >> 62) != 1) {
    return 4;
  }

  if ((SIGNED_MIN >> 63) != -1) {
    return 5;
  }

  if ((WIDE_NEGATIVE / 1000000000) != -5) {
    return 6;
  }

  let widened: u64 = NARROW_UNSIGNED as u64;

  if ((widened << 8) != 0xFFFFFFFF00) {
    return 7;
  }

  if (NARROW_SIGNED as i64 != -2147483648) {
    return 8;
  }

  let byteShifted: u64 = (BYTE as u64) << 56;

  if ((byteShifted >> 56) != 0xFF) {
    return 9;
  }

  let wideLiteral: u64 = 0x123456789ABCDEF0;

  if ((wideLiteral >> 60) != 1) {
    return 10;
  }

  let wideDecimal: i64 = 5000000000;

  if ((wideDecimal >> 32) != 1) {
    return 11;
  }

  if ((HALF as u64) << 48 != 0xFFFF000000000000) {
    return 12;
  }

  if ((LOW_WORD << 8) != 0xFFFFFFFF00) {
    return 13;
  }

  if ((ONE << 40) != 1099511627776) {
    return 14;
  }

  return 0;
}
