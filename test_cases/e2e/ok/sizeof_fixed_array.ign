type Words = u64[4];

record Point {
  x: i32;
  y: i32;
}

function main(): i32 {
  let bytes: u64 = @sizeOf<u8[3]>();
  let words: u64 = @sizeOf<Words>();
  let grid: u64 = @sizeOf<u8[2][3]>();
  let points: u64 = @sizeOf<Point[2]>();
  if (bytes != 3 || words != 32 || grid != 6 || points != 16) {
    return 1;
  }
  return 0;
}
