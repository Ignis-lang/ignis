// e2e: std
//
// Two `let` conditions joined by `&&`: both bindings belong to the branch the
// chain guards, so both are dropped when it ends and on every early exit out of
// it.
//
// The exit code is the construction/drop imbalance plus the difference between
// what each branch read and what it had to read, so 0 means every Tracked was
// dropped exactly once.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

enum Kind {
  ONE(Tracked),
  EMPTY,
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

function one(id: i32): Kind {
  return Kind::ONE(tracked(id));
}

/// Both bindings fall out of the branch at its end.
function fallThrough(): i32 {
  let mut seen: i32 = 0;
  let first: Kind = one(1);
  let second: Kind = one(2);

  if (let Kind::ONE(left) = first && let Kind::ONE(right) = second) {
    seen = left.id + right.id;
  }

  return seen;
}

/// Both bindings leave the branch through a `return`.
function earlyReturn(): i32 {
  let first: Kind = one(3);
  let second: Kind = one(4);

  if (let Kind::ONE(left) = first && let Kind::ONE(right) = second) {
    return left.id + right.id;
  }

  return 0;
}

/// Both bindings leave the branch through a `break`.
function earlyBreak(): i32 {
  let mut seen: i32 = 0;

  while (true) {
    if (let Kind::ONE(left) = one(5) && let Kind::ONE(right) = one(6)) {
      seen = left.id + right.id;
      break;
    }

    break;
  }

  return seen;
}

/// Both bindings leave the branch through a `continue`.
function earlyContinue(): i32 {
  let mut seen: i32 = 0;
  let mut rounds: i32 = 0;

  while (rounds < 2) {
    rounds += 1;

    if (let Kind::ONE(left) = one(7) && let Kind::ONE(right) = one(8)) {
      seen += left.id + right.id;
      continue;
    }

    seen = 0;
  }

  return seen;
}

function main(): i32 {
  let mut observed: i32 = 0;

  observed += fallThrough() - 3;
  observed += earlyReturn() - 7;
  observed += earlyBreak() - 11;
  observed += earlyContinue() - 30;

  return Counters::MADE - Counters::DROPPED + observed;
}
