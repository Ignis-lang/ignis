record Point {
  public x: i32;
  public y: i32;
}
@packed
record Packed {
  public x: u8;
  public y: i32;
}
const ORIGIN: Point = Point { x: 7, y: 8 };
const COMPACT: Packed = Packed { x: 1, y: 9 };
function main(): i32 {
  let point: *Point = &ORIGIN as *Point;
  let packed: *Packed = &COMPACT as *Packed;
  return (*point).y + (*packed).y;
}
