// The closure is bound to a local before being returned. Returning it hands the
// environment to the caller, so the local's drop must be cancelled: freeing here
// would leave the caller holding a freed environment.
function makeAdder(base: i32): (i32) -> i32 {
    let add = (x: i32): i32 -> x + base;

    return add;
}

function main(): i32 {
    let f = makeAdder(40);

    return f(2);
}
