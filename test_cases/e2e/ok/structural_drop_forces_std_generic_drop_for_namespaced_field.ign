// e2e: std
import Vector from "std::vector";

namespace Ast {
  namespace Item {
    record Node {
      public value: i32;
    }
  }
}

record Module {
  public items: Vector<Ast::Item::Node>;
}

function main(): i32 {
  let module: Module = Module {
    items: Vector::new<Ast::Item::Node>(),
  };

  return 0;
}
