// Initializing another record with a closure read out of a local record's field
// moves it out of the field, so only the new record frees the environment.
record Holder {
    public callback: () -> i32;
}

function makeHolder(base: i32): Holder {
    let add = (): i32 -> base + 2;

    return Holder { callback: add };
}

record Other {
    public callback: () -> i32;
}

function main(): i32 {
    let holder = makeHolder(40);
    let other = Other { callback: holder.callback };
    let call = other.callback;

    return call();
}
