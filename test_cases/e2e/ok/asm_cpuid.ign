// cpuid leaf 0 returns the vendor string in ebx, edx and ecx; its first four
// bytes are "Genu" on Intel and "Auth" on AMD.
function main(): i32 {
  let mut leaf: u32 = 0;
  let mut subleaf: u32 = 0;

  asm (leaf inout eax, subleaf inout ecx) -> (vendorStart: u32 in ebx, vendorMiddle: u32 in edx) {
    cpuid
  }

  if (vendorStart == 0x756e6547 && vendorMiddle == 0x49656e69) {
    return 0;
  }

  if (vendorStart == 0x68747541 && vendorMiddle == 0x69746e65) {
    return 0;
  }

  return 1;
}
