// An assignment inside a nested loop is walked by both loops' second passes.
function make(): (i32) -> i32 {
    let base: i32 = 40;
    let mut f = (x: i32): i32 -> x + base;
    let mut i: i32 = 0;

    while (i < 2) {
        let mut j: i32 = 0;

        while (j < 2) {
            f = (x: i32): i32 -> x + base;
            j += 1;
        }

        i += 1;
    }

    return f;
}

function main(): i32 {
    let g = make();

    return g(2);
}
