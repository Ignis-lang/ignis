trait Weigh {
    weigh(&self): i32;
}

@implements(Weigh)
record Stone {
    public grams: i32;

    weigh(&self): i32 {
        return self.grams * 2;
    }

    weigh(&self, factor: i32): i32 {
        return self.grams * factor;
    }
}

function total<T: Weigh>(value: &T): i32 {
    return value.weigh();
}

function main(): i32 {
    let stone: Stone = Stone { grams: 20 };

    return total<Stone>(&stone) + stone.weigh(3);
}
