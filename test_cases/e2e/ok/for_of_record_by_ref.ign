record IntVec {
    data: *mut i32;
    length: u64;
    capacity: u64;
}

function main(): i32 {
    let mut arr: i32[3] = [5, 15, 22];
    let vec: IntVec = IntVec { data: (&mut arr[0]) as *mut i32, length: 3, capacity: 3 };

    let mut sum: i32 = 0;
    for (let item: &i32 of vec) {
        sum += *item;
    }

    return sum;
}
