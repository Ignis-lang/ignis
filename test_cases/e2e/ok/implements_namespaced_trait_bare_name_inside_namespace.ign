// Inside the trait's namespace, `@implements` names it bare, and a bound
// written with the full path from outside accepts the record.
namespace Shapes {
  trait Measured {
    area(&self): i32;
  }

  @implements(Measured)
  record Square {
    public side: i32;

    area(&self): i32 {
      return self.side * self.side;
    }
  }
}

function measure<T: Shapes::Measured>(value: &T): i32 {
  return value.area();
}

function main(): i32 {
  let square: Shapes::Square = Shapes::Square { side: 5 };
  return measure<Shapes::Square>(&square);
}
