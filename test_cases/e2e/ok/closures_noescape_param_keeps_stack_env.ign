// `@noescape` is the callee's promise that the closure does not outlive the call,
// so the environment stays in the caller's frame.
function applyTwice(@noescape f: (i32) -> i32, x: i32): i32 {
    return f(f(x));
}

function main(): i32 {
    let base: i32 = 20;
    let add = (x: i32): i32 -> x + base;

    return applyTwice(add, 2);
}
