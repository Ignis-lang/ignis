// e2e: std
import Io from "std::io";
import String from "std::string";

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Io::println(`drop ${self.id}`.toStr());
  }
}

enum Kind {
  TRACKED(Tracked),
}

record Holder {
  public kind: Kind;
  public label: String;
  public tag: i32;
}

function makeHolder(tag: i32): Holder {
  return Holder {
    kind: Kind::TRACKED(Tracked { id: tag }),
    label: String::create("holder"),
    tag: tag,
  };
}

function widthOf(kind: &Kind): i32 {
  return match (kind) {
    Kind::TRACKED(_) -> 0,
  };
}

function classify(tag: i32): i32 {
  let holder: Holder = makeHolder(tag);

  if (holder.tag > 0) {
    let taken: Kind = holder.kind;

    return widthOf(&taken);
  }

  return 0;
}

function main(): i32 {
  let moved: i32 = classify(1);

  Io::println("moved branch done");

  let kept: i32 = classify(-2);

  Io::println("kept branch done");

  return moved + kept;
}
