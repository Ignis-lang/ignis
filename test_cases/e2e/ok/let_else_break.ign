enum Maybe {
    Some(i32),
    None,
}

function maybePositive(value: i32): Maybe {
    if (value > 0) {
        return Maybe::Some(value);
    }

    return Maybe::None;
}

function main(): i32 {
    let mut index: i32 = 4;
    let mut total: i32 = 0;

    while (true) {
        let Maybe::Some(v) = maybePositive(index) else {
            break;
        };

        total += v;
        index -= 1;
    }

    return total;
}
