// A match over an owned local `Option` moves the closure payload into the arm
// binding, which owns the environment and frees it at the end of the arm. The
// scrutinee no longer frees it.
function make(base: i32): Option<(i32) -> i32> {
  return Option::SOME((x: i32): i32 -> x + base);
}

function main(): i32 {
  let maybe = make(1);

  return match (maybe) {
    Option::SOME(f) -> f(41),
    Option::NONE -> 1,
  };
}
