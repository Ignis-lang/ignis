// e2e: std
// A named function returning `void` used as a function value forwards to it
// through a thunk that returns nothing.
import Vector from "std::vector";

function pushInto(target: &mut Vector<i32>, value: i32): void {
    target.push(value);
}

function fill(target: &mut Vector<i32>, callback: (&mut Vector<i32>, i32) -> void, value: i32): void {
    callback(target, value);
    callback(target, value + 1);
}

function main(): i32 {
    let mut values: Vector<i32> = Vector::new<i32>();
    fill(&mut values, pushInto, 40);

    let mut total: i32 = 0;

    if (let Option::SOME(first) = values.get(0)) {
        total += *first;
    }

    if (let Option::SOME(second) = values.get(1)) {
        total += *second;
    }

    return total - 39 + (values.length() as i32) - 2;
}
