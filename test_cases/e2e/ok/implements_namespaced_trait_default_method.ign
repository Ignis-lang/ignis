// A default method of a namespaced trait reaches a record that names the
// trait with its full path, called directly and through a generic bound.
namespace Shapes {
  trait Measured {
    area(&self): i32;

    doubled(&self): i32 {
      return self.area() * 2;
    }
  }
}

@implements(Shapes::Measured)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

function doubledArea<T: Shapes::Measured>(value: &T): i32 {
  return value.doubled();
}

function main(): i32 {
  let square: Square = Square { side: 2 };
  return square.doubled() + doubledArea<Square>(&square);
}
