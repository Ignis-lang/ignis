// An `if let` over a call result binds the closure payload of an owned
// `Option`, so the binding owns the environment and frees it once.
function make(base: i32): Option<(i32) -> i32> {
  return Option::SOME((x: i32): i32 -> x + base);
}

function main(): i32 {
  if (let Option::SOME(f) = make(1)) {
    return f(41);
  }

  return 1;
}
