// A named function returning `never` used as a function value, a `never`
// lambda, and a direct call to the function all emit no value for the call.
function stop(code: i32): never {
    @panic("stop");
}

function run(callback: (i32) -> never, flag: boolean): i32 {
    if (flag) {
        callback(1);
    }

    return 42;
}

function main(): i32 {
    let flag: boolean = false;

    if (flag) {
        stop(2);
    }

    let halt = (code: i32): never -> {
        @panic("halt");
    };

    return run(stop, flag) + run(halt, flag) - 42;
}
