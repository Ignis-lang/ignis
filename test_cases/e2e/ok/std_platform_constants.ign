// e2e: std
// Platform constants come from `std::libc::platform`, so a program that uses
// them needs no C header: every backend sees plain integer values.
import LibC from "std::libc";

function main(): i32 {
  let flags: i32 = LibC::File::O_WRONLY | LibC::File::O_CREAT | LibC::File::O_TRUNC;
  let notFound: i32 = LibC::Errno::ENOENT;
  let mapping: i32 = LibC::Memory::MAP_PRIVATE | LibC::Memory::MAP_ANONYMOUS;

  return flags - 577 + notFound + mapping + 6;
}
