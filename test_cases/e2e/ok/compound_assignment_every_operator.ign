// Every compound assignment operator computes the same value as its binary
// operator. `|=` and `&=` once lowered to the logical `||` and `&&`.
function orAssign(value: u64): u64 {
  let mut x: u64 = value;

  x |= 4;

  return x;
}

function andAssign(value: u64): u64 {
  let mut x: u64 = value;

  x &= 6;

  return x;
}

function main(): i32 {
  let mut add: i32 = 10;
  let mut subtract: i32 = 10;
  let mut multiply: i32 = 10;
  let mut divide: i32 = 10;
  let mut modulo: i32 = 10;
  let mut xor: u64 = 16;
  let mut shift: u64 = 16;

  add += 3;
  subtract -= 3;
  multiply *= 3;
  divide /= 3;
  modulo %= 3;
  xor ^= 6;
  shift <<= 2;
  shift >>= 1;

  if (orAssign(16) != 20) {
    return 1;
  }

  if (andAssign(16) != 0) {
    return 2;
  }

  if (andAssign(7) != 6) {
    return 3;
  }

  if (add != 13 || subtract != 7 || multiply != 30 || divide != 3 || modulo != 1) {
    return 4;
  }

  if (xor != 22 || shift != 32) {
    return 5;
  }

  return 0;
}
