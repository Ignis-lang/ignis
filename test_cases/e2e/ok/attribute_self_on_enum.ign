// e2e: std
// `@attribute<A>(Self)` where `Self` is an enum reads an attribute declared for
// enums: `SOME` when the enum carries it, `NONE` when it does not.
import Io from "std::io";

@attribute(enum)
record Label {
  public text: str;
}

trait Labeled {
  label(&self): str {
    if (let Option::SOME(label) = @attribute<Label>(Self)) {
      return label.text;
    }

    return "(none)";
  }
}

@Label("colour")
@implements(Labeled)
enum Color {
  RED,
}

@implements(Labeled)
enum Shape {
  SQUARE,
}

function main(): i32 {
  let color: Color = Color::RED;
  let shape: Shape = Shape::SQUARE;
  Io::println(color.label());
  Io::println(shape.label());
  return 0;
}
