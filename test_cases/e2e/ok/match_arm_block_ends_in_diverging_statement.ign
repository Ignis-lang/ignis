enum Choice {
  PICK(i32),
  STOP,
  SKIP,
  FAIL,
  GUARD(boolean),
}

function pick(choice: Choice): i32 {
  let value: i32 = match (choice) {
    Choice::PICK(inner) -> inner,
    Choice::STOP -> {
      return 3;
    },
    Choice::SKIP -> {
      @unreachable();
    },
    Choice::FAIL -> {
      @panic("unexpected choice");
    },
    Choice::GUARD(flag) -> {
      if (flag) {
        return 5;
      } else {
        @unreachable();
      }
    },
  };

  return value + 1;
}

function main(): i32 {
  return pick(Choice::PICK(40)) + pick(Choice::STOP) + pick(Choice::GUARD(true));
}
