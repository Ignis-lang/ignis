// e2e: std
// `std::memory` imports `Align` and republishes it with a bare `export Align;`,
// and `std::collections` republishes `HashMap` with `export HashMap from ...`.
// Both spellings have to be followed to the declaring module.
import Align from "std::memory";
import HashMap from "std::collections";

function main(): i32 {
  let aligned: u64 = Align::alignUp(5, 8);
  let table: HashMap<i32, i32> = HashMap::new<i32, i32>();

  return (aligned + table.length()) as i32;
}
