// A value whose type is an alias of a function type is callable: a
// parameter, a local and a chain of aliases.
type Task = () -> i32;
type Step = (i32) -> i32;
type Job = Task;

function run(task: Task): i32 {
  return task();
}

function runJob(job: Job): i32 {
  return job();
}

function main(): i32 {
  let double: Step = (value: i32): i32 -> value * 2;
  let local: Task = (): i32 -> 4;

  return run((): i32 -> 3) + runJob(local) + double(1) + local() - 13;
}
