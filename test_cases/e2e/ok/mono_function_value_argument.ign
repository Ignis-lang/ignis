// Regression for #205: a function passed as an argument by name (not called
// at the call site) must be reachable in mono and codegen-compatible with the
// closure parameter ABI.
function helper(n: i32): i32 {
  return n + 7;
}

function apply(f: (i32) -> i32, x: i32): i32 {
  return f(x);
}

function main(): i32 {
  return apply(helper, 35);
}
