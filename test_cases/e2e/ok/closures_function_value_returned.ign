// A plain function used as a function value lowers to a zero-capture closure.
// Returning it must not allocate an environment.
function inc(x: i32): i32 {
    return x + 1;
}

function makeIncrementer(): (i32) -> i32 {
    return inc;
}

function main(): i32 {
    let f = makeIncrementer();

    return f(41);
}
