enum Outcome {
    Ok(i32),
    Err,
}

function toOutcome(value: i32): Outcome {
    if (value > 0) {
        return Outcome::Ok(value);
    }

    return Outcome::Err;
}

function main(): i32 {
    let mut Outcome::Ok(value) = toOutcome(40) else {
        return -1;
    };

    value += 2;
    return value;
}
