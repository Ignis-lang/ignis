// An inout register operand is read by the instructions and written back to
// the local it names.
function addThenMultiply(value: u64, addend: u64, factor: u64): u64 {
  let mut result: u64 = value;

  asm (result inout rax, addend in reg, factor in reg) clobber(flags) {
    add {result}, {addend}
    imul {result}, {factor}
  }

  return result;
}

function main(): i32 {
  return addThenMultiply(4, 3, 6) as i32;
}
