// An alias does not take the environment over, but returning it still hands the
// environment to the caller, so the owning binding's drop is cancelled too.
function makeAdder(base: i32): (i32) -> i32 {
    let add = (x: i32): i32 -> x + base;
    let alias = add;

    return alias;
}

function main(): i32 {
    let f = makeAdder(40);

    return f(2);
}
