// e2e: std
// `String::concat` taking its argument by value: the moved `String` is
// borrowed again inside the body before it is dropped.
import Io from "std::io";

function main(): i32 {
  let greeting: String = String::create("hello");
  let joined: String = greeting.concat(String::create(", world"));
  let borrowed: String = String::create("!");
  let shout: String = joined.concat(&borrowed);

  Io::println(shout);

  return 0;
}
