// e2e: std
// `String` owns its bytes, so it may be stored in a `Vector`, whose type
// parameter owns its storage.
import Io from "std::io";
import Vector from "std::vector";

function main(): i32 {
  let mut names: Vector<String> = Vector::new<String>();
  names.push(String::create("ada"));
  names.push(String::create("grace"));

  let mut total: u64 = 0;
  let mut index: u64 = 0;

  while (index < names.length()) {
    if (let Option::SOME(name) = names.get(index)) {
      total += name.length();
    }

    index += 1;
  }

  Io::print(`total=${total}\n`);

  return total == 8 ? 0 : 1;
}
