// A named function returning `void` bound to a function-typed local and called
// through it, next to a non-void function bound the same way.
function bump(counter: &mut i32, amount: i32): void {
    *counter += amount;
}

function double(value: i32): i32 {
    return value * 2;
}

function main(): i32 {
    let mut counter: i32 = 0;
    let step: (&mut i32, i32) -> void = bump;
    step(&mut counter, 20);
    step(&mut counter, 1);

    let twice: (i32) -> i32 = double;

    return counter + twice(10) + 1;
}
