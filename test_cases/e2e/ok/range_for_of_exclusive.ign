function visits(first: i32, last: i32): i32 {
  let mut count: i32 = 0;

  for (let value of first..last) {
    count += 1;
  }

  return count;
}

function sum(first: i32, last: i32): i32 {
  let mut total: i32 = 0;

  for (let value of first..last) {
    total += value;
  }

  return total;
}

function main(): i32 {
  if (sum(0, 5) != 10) {
    return 1;
  }

  if (visits(5, 5) != 0) {
    return 2;
  }

  if (visits(5, 0) != 0) {
    return 3;
  }

  if (sum(-3, 3) != -3) {
    return 4;
  }

  if (visits(-3, 3) != 6) {
    return 5;
  }

  let mut literalSum: i32 = 0;

  for (let value of 10..13) {
    literalSum += value;
  }

  if (literalSum != 33) {
    return 6;
  }

  return 0;
}
