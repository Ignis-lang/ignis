// A closure literal handed straight to a parameter that is not `@noescape`
// moves into that parameter, which owns it and frees its environment when the
// call returns.
function apply(f: (i32) -> i32, x: i32): i32 {
  return f(x);
}

function main(): i32 {
  let base: i32 = 1;

  return apply((x: i32): i32 -> x + base, 41);
}
