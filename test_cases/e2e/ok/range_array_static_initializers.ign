const BASE: i32[4] = [1..=4];

record Tables {
  static mut IDS: u64[3] = [1..4];
  static LOOKUP: u16[4] = [10..14];
}

function main(): i32 {
  let base: &i32[4] = &BASE;

  if ((*base)[0] != 1 || (*base)[3] != 4) {
    return 1;
  }

  if (Tables::IDS[0] != 1 || Tables::IDS[2] != 3) {
    return 2;
  }

  Tables::IDS[1] = 20;

  if (Tables::IDS[1] != 20) {
    return 3;
  }

  if (Tables::LOOKUP[0] != 10 || Tables::LOOKUP[3] != 13) {
    return 4;
  }

  let lookup: &u16[4] = &Tables::LOOKUP;

  if ((*lookup)[2] != 12) {
    return 5;
  }

  return 0;
}
