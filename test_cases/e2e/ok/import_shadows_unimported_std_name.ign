// `std::memory` and `std::collections` also declare an `ArenaAllocator` and a
// `HashSet`, but this file imports only `Layout` and `BitSet` from them. A bare
// annotation, record literal or generic base names the imported helper
// declarations, not the std ones that happen to be in the program.
import ArenaAllocator, HashSet from "../support/import_shadows_unimported_std_name";
import Layout from "std::memory";
import BitSet from "std::collections";

function main(): i32 {
  let arena: ArenaAllocator = ArenaAllocator::init(4);
  let literal: ArenaAllocator = ArenaAllocator { start: 3 };
  let set: HashSet<i32> = HashSet { first: 2 };
  let layout: Layout = Layout::init<u64>();
  let bits: BitSet = BitSet::new();

  if (layout.size() != 8 || bits.lengthWords() > 1024) {
    return 1;
  }

  return (arena.start + literal.start) as i32 + set.first;
}
