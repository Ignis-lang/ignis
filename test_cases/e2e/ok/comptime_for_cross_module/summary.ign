// e2e: skip helper module of e2e::comptime_for_cross_module: alone it has no main and cannot link; it runs through the entry fixture
//
// The default names a private helper of this module inside the loop body.
function entry(name: str, value: i32): String {
  return `${name}=${value}`;
}

export trait Summary {
  summary(&self): String {
    let mut text: String = String::new();

    comptime for (field of @fields<Self>()) {
      if (field.index > 0) {
        text.pushStr(" ");
      }

      let part: String = entry(field.name, @field(self, field));
      text.push(&part);
    }

    return text;
  }
}
