// Width-based wrapping: + - * and unary - on 32-bit and narrower integers
// wrap modulo 2^width, in the generated C and in constants alike.
function main(): i32 {
  let maxI32: i32 = 2147483647;
  let wrappedAdd: i32 = maxI32 + 1;
  if (wrappedAdd != -2147483647 - 1) {
    return 1;
  }

  let mut compound: i32 = 2147483647;
  compound += 1;
  if (compound != -2147483647 - 1) {
    return 2;
  }

  let minI32: i32 = -2147483647 - 1;
  let wrappedNeg: i32 = -minI32;
  if (wrappedNeg != minI32) {
    return 3;
  }

  let bigMul: i32 = 65536;
  let wrappedMul: i32 = bigMul * 65536;
  if (wrappedMul != 0) {
    return 4;
  }

  let maxU16: u16 = 65535;
  let wrappedU16: u16 = maxU16 * 3;
  if (wrappedU16 != 65533) {
    return 5;
  }

  let maxU8: u8 = 255;
  let wrappedU8: u8 = maxU8 + 1;
  if (wrappedU8 != 0) {
    return 6;
  }

  let mut bumped: u8 = 255;
  bumped += 1;
  if (bumped != 0) {
    return 7;
  }

  let maxU32: u32 = 4294967295;
  let wrappedU32: u32 = maxU32 + 1;
  if (wrappedU32 != 0) {
    return 8;
  }

  return 0;
}
