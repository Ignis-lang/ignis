namespace Ast {
  namespace Item {
    record Node {
      id: u32;
    }
  }
}

function allocate<T>(address: u64): *mut T {
  let raw: *mut u8 = @pointerFromInteger<*mut u8>(address);
  return raw as *mut T;
}

function main(): i32 {
  let pointer: *mut Ast::Item::Node = allocate<Ast::Item::Node>(0);
  let address: u64 = @integerFromPointer(pointer);

  if (address == 0) {
    return 0;
  }

  return 1;
}
