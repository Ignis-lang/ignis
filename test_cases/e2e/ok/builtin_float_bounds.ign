function main(): i32 {
  let largestDouble: f64 = @maxOf<f64>();
  let smallestDouble: f64 = @minOf<f64>();
  let largestFloat: f32 = @maxOf<f32>();
  let smallestFloat: f32 = @minOf<f32>();

  if (largestFloat as f64 != 340282346638528859811704183484516925440.0) {
    return 1;
  }

  if (smallestFloat != -largestFloat || smallestDouble != -largestDouble) {
    return 2;
  }

  // The largest finite double: halving and doubling it is exact, and doubling
  // it alone overflows to the same infinity as quadrupling it.
  if (largestDouble <= largestFloat as f64 || (largestDouble / 2.0) * 2.0 != largestDouble) {
    return 3;
  }

  if (largestDouble * 2.0 != largestDouble * 4.0 || largestDouble * 2.0 == largestDouble) {
    return 4;
  }

  return 0;
}
