// e2e: std
//
// The same loop exits over a scrutinee that is a call rather than a place. A
// temporary has no storage an exit could refill: the call builds one value per
// round, the match either hands its payload to the body or frees it, and nothing
// survives the round that produced it. A `break`, a `return` or a `continue`
// therefore owes nothing for the condition, and adding a drop there would free a
// value the round already accounted for.
//
// The exit code is the construction/drop imbalance plus the difference between
// what each case read and what it had to read, so 0 means every Tracked was
// dropped exactly once.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

enum Kind {
  ONE(Tracked),
  EMPTY,
}

record Source {
  public remaining: i32;

  public next(&mut self): Kind {
    if (self.remaining <= 0) {
      return Kind::EMPTY;
    }

    self.remaining -= 1;

    return Kind::ONE(tracked(1));
  }
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

function one(id: i32): Kind {
  return Kind::ONE(tracked(id));
}

/// A `break` out of a loop over a call. The round that breaks already owns its
/// payload through the binding, and the binding's drop at the `break` is the
/// whole debt.
function breakOverTemporary(): i32 {
  let mut rounds: i32 = 0;
  let mut source: Source = Source { remaining: 8 };

  while (let Kind::ONE(item) = source.next()) {
    rounds += item.id;

    if (rounds >= 2) {
      break;
    }
  }

  return rounds;
}

/// A `return` out of the same loop.
function returnOverTemporary(): i32 {
  let mut rounds: i32 = 0;
  let mut source: Source = Source { remaining: 8 };

  while (let Kind::ONE(item) = source.next()) {
    rounds += item.id;

    if (rounds >= 2) {
      return rounds;
    }
  }

  return rounds;
}

/// A `continue` and then exhaustion: the source runs out, the call yields the
/// variant the pattern does not match, and the match frees what it produced.
function continueThenExhaustionOverTemporary(): i32 {
  let mut rounds: i32 = 0;
  let mut skipped: i32 = 0;
  let mut source: Source = Source { remaining: 3 };

  while (let Kind::ONE(item) = source.next()) {
    rounds += item.id;

    if (rounds >= 2) {
      continue;
    }

    skipped += 1;
  }

  return rounds + skipped - 1;
}

/// Nested loops over calls. The inner `break` leaves the inner round, and the
/// outer round is still the outer condition's to account for.
function nestedBreakOverTemporary(): i32 {
  let mut rounds: i32 = 0;
  let mut outer: Source = Source { remaining: 2 };

  while (let Kind::ONE(outerItem) = outer.next()) {
    rounds += outerItem.id;

    let mut inner: Source = Source { remaining: 4 };

    while (let Kind::ONE(innerItem) = inner.next()) {
      rounds += innerItem.id;
      break;
    }
  }

  return rounds;
}

/// A conjunct in front of a `let` over a call, left by a `break`. The `break`
/// path ran the call, and the short-circuit path never builds anything.
function breakOverTemporaryBehindConjunct(): i32 {
  let mut rounds: i32 = 0;
  let mut source: Source = Source { remaining: 8 };

  while (rounds < 8 && let Kind::ONE(item) = source.next()) {
    rounds += item.id;

    if (rounds >= 2) {
      break;
    }
  }

  return rounds;
}

/// A place and a call in the same condition. Only the place is refilled by the
/// body, and only the place is owed at the `break`.
function breakOverPlaceAndTemporary(): i32 {
  let mut rounds: i32 = 0;
  let mut source: Source = Source { remaining: 8 };
  let mut holder: Kind = one(1);

  while (let Kind::ONE(first) = source.next() && let Kind::ONE(second) = holder) {
    rounds += first.id + second.id;
    holder = one(1);

    if (rounds >= 4) {
      break;
    }
  }

  return rounds;
}

function main(): i32 {
  let mut observed: i32 = 0;

  observed += breakOverTemporary() - 2;
  observed += returnOverTemporary() - 2;
  observed += continueThenExhaustionOverTemporary() - 3;
  observed += nestedBreakOverTemporary() - 4;
  observed += breakOverTemporaryBehindConjunct() - 2;
  observed += breakOverPlaceAndTemporary() - 4;

  return Counters::MADE - Counters::DROPPED + observed;
}
