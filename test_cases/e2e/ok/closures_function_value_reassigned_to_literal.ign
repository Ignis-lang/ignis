// The binding starts as a plain function value, which owns no environment, and
// is then assigned a capturing literal. Ownership is established at the `let`
// from the assignment, so the environment is freed exactly once.
function inc(x: i32): i32 {
    return x + 1;
}

function make(): (i32) -> i32 {
    let base: i32 = 40;
    let mut f = inc;
    f = (x: i32): i32 -> x + base;

    return f;
}

function main(): i32 {
    let g = make();

    return g(2);
}
