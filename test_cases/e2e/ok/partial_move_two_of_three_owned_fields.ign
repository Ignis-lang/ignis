// e2e: std
import Io from "std::io";
import String from "std::string";

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Io::println(`drop ${self.id}`.toStr());
  }
}

enum Kind {
  TRACKED(Tracked),
}

record Holder {
  public first: Kind;
  public second: Kind;
  public third: Kind;
  public label: String;
}

function makeHolder(): Holder {
  return Holder {
    first: Kind::TRACKED(Tracked { id: 1 }),
    second: Kind::TRACKED(Tracked { id: 2 }),
    third: Kind::TRACKED(Tracked { id: 3 }),
    label: String::create("holder"),
  };
}

function widthOf(kind: &Kind): i32 {
  return match (kind) {
    Kind::TRACKED(_) -> 0,
  };
}

function main(): i32 {
  let holder: Holder = makeHolder();

  let first: Kind = holder.first;
  let second: Kind = holder.second;

  Io::println("moved");

  return widthOf(&first) + widthOf(&second);
}
