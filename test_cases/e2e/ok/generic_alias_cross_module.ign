// A generic alias exported from one module expands to its target in the module
// that imports it: in a signature, a local annotation and a method receiver.
import Boxed, boxed from "./generic_alias_cross_module/shared";

function unwrap(cell: &Boxed<i32>): i32 {
  return *cell.get();
}

function main(): i32 {
  let cell: Boxed<i32> = boxed<i32>(42);
  return unwrap(&cell);
}
