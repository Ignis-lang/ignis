// e2e: std
// A closure bound in the loop and captured by a closure that escapes the loop
// lives as long as that closure, inside the frame: its reference to a counter
// declared before the loop stays valid. Its environment moves to the heap with
// the capturing closure, whose drop function drops it.
import Io from "std::io";

function main(): i32 {
  let mut x: i32 = 0;
  let mut g = (): void -> {};
  let mut i: i32 = 0;

  while (i < 2) {
    let f = (): void -> {
      x = x + 1;
    };
    g = (): void -> {
      f();
    };
    i = i + 1;
  }

  g();
  Io::println(`x ${x}`.toStr());
  return 0;
}
