// A record inherits a trait default declared in another module whose
// signature takes a `fn(i32) -> i32`, and calls it with a function and a
// capture-free closure literal.
import Transform from "./fn_xmod_default/transforms";

function square(value: i32): i32 {
  return value * value;
}

@implements(Transform)
record Seed {
  public value: i32;

  base(&self): i32 {
    return self.value;
  }
}

function main(): i32 {
  let seed: Seed = Seed { value: 3 };
  let squared: i32 = seed.applied(square);
  let incremented: i32 = seed.applied((value: i32): i32 -> value + 1);

  // 9 + 4
  return squared + incremented - 13;
}
