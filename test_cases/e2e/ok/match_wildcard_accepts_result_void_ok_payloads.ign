// e2e: std
import Result from "std::result";

function step(flag: boolean): Result<void, str> {
    if (flag) {
        return Result::OK(());
    }

    return Result::ERROR("boom");
}

function main(): i32 {
    let code: i32 = match (step(true)) {
        Result::OK(_) -> 7,
        Result::ERROR(_) -> 1,
    };

    return code;
}
