// Mirror of `namespace_reopened_export_on_one_block_only.ign` with the
// `export` keyword moved to the second block: the merge behaves identically
// regardless of which block (if any) is exported (IGN-230).
namespace Foo {
  function a(): i32 {
    return 1;
  }
}

export namespace Foo {
  function b(): i32 {
    return 2;
  }
}

function main(): i32 {
  return Foo::a() + Foo::b();
}
