trait Weigh {
    weigh(&self): i32;
}

@implements(Weigh)
record Stone {
    public grams: i32;

    weigh(&self): i32 {
        return self.grams * 2;
    }
}

@implements(Weigh)
record Feather {
    public grams: i32;

    weigh(&self): i32 {
        return self.grams + 1;
    }
}

function total<T: Weigh>(value: &T): i32 {
    return value.weigh();
}

function main(): i32 {
    let stone: Stone = Stone { grams: 20 };
    let feather: Feather = Feather { grams: 5 };

    return total<Stone>(&stone) + total<Feather>(&feather);
}
