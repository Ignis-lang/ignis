export namespace Outer {
    namespace Inner::Deep {
        record Point {
            public x: i32;
            public y: i32;
        }

        function make(): Point {
            return Point { x: 3, y: 4 };
        }
    }
}

function main(): i32 {
    let point: Outer::Inner::Deep::Point = Outer::Inner::Deep::make();

    return point.x * 10 + point.y;
}
