record Acc {
    public total: i32;

    combine(&self, flag: boolean, bonus: i32): i32 {
        if (flag) {
            return bonus;
        }

        return 0;
    }

    combine(&self, x: i32, factor: i32): i32 {
        return self.total + x * factor;
    }
}

function main(): i32 {
    let a: Acc = Acc { total: 100 };
    let fromNumber: i32 = 3 |> a.combine(4);
    let fromFlag: i32 = true |> a.combine(7);
    return fromNumber + fromFlag;
}
