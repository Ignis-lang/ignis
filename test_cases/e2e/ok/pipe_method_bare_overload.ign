record Acc {
    public total: i32;

    add(&self, flag: boolean): i32 {
        if (flag) {
            return 1;
        }

        return 0;
    }

    add(&self, x: i32): i32 {
        return self.total + x;
    }
}

function main(): i32 {
    let a: Acc = Acc { total: 100 };
    let fromNumber: i32 = 5 |> a.add;
    let fromFlag: i32 = true |> a.add;
    return fromNumber + fromFlag;
}
