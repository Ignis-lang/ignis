// An alias of a generic alias, and an alias with two parameters, expand to
// the nominal type they name: in signatures, local annotations and method
// receivers, whichever order they are declared in.
type Swapped<A, B> = Pair<B, A>;

type Twin<T> = Same<T>;

type Same<T> = Pair<T, T>;

record Pair<L, R> {
  public left: L;
  public right: R;

  public sum(&self, weight: i32): i32 {
    return weight;
  }
}

function swap(pair: Pair<i32, boolean>): Swapped<i32, boolean> {
  return Pair { left: pair.right, right: pair.left };
}

function twin(value: i32): Twin<i32> {
  return Pair { left: value, right: value };
}

function main(): i32 {
  let swapped: Swapped<i32, boolean> = swap(Pair { left: 20, right: true });
  let doubled: Twin<i32> = twin(swapped.right);
  let flag: boolean = swapped.left;

  if (!flag) {
    return 1;
  }

  return doubled.left + doubled.right + doubled.sum(2);
}
