// Building an enum variant from a closure read out of a local record's field
// moves it out of the field, so only the enum value frees the environment.
record Holder {
    public callback: () -> i32;
}

function makeHolder(base: i32): Holder {
    let add = (): i32 -> base + 2;

    return Holder { callback: add };
}

enum Slot {
    FULL(() -> i32),
    EMPTY,
}

function main(): i32 {
    let holder = makeHolder(40);
    let slot = Slot::FULL(holder.callback);

    return match (slot) {
        Slot::FULL(call) -> call(),
        Slot::EMPTY -> 0,
    };
}
