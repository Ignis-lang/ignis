// e2e: std
// Generic functions returning `T`, instantiated with `void`: once `T` is
// substituted the return carries no value.
import Option from "std::option";

function nothing(): void {
}

function unwrapBoth<T>(maybe: Option<T>): T {
  return maybe.unwrap();
}

function main(): i32 {
  let first: Option<void> = Option::SOME(nothing());
  first.unwrap();

  let second: Option<void> = Option::SOME(nothing());
  unwrapBoth<void>(second);
  return 0;
}
