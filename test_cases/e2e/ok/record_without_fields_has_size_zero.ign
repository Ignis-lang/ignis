// e2e: std
import Io from "std::io";
import String from "std::string";
import Vector from "std::vector";

record Empty {}

record Holder {
    public before: i32;
    public marker: Empty;
    public after: i32;
}

enum Slot {
    FILLED(Empty),
    VACANT,
}

function takeEmpty(value: Empty): i32 {
    return 7;
}

function slotScore(slot: Slot): i32 {
    return match (slot) {
        Slot::FILLED(_) -> 1,
        Slot::VACANT -> 2,
    };
}

function main(): i32 {
    Io::println(String::create(@sizeOf<Empty>()).toStr());
    Io::println(String::create(@sizeOf<Holder>()).toStr());

    let holder: Holder = Holder {
        before: 3,
        marker: Empty {},
        after: 4,
    };

    if (holder.before + holder.after != 7) {
        return 1;
    }

    if (takeEmpty(holder.marker) != 7) {
        return 2;
    }

    if (slotScore(Slot::FILLED(Empty {})) + slotScore(Slot::VACANT) != 3) {
        return 3;
    }

    let mut markers: Vector<Empty> = Vector::new<Empty>();
    markers.push(Empty {});
    markers.push(Empty {});
    markers.push(Empty {});

    Io::println(String::create(markers.length()).toStr());

    if (markers.length() != 3) {
        return 4;
    }

    return 42;
}
