@cLayout
record Counter {
  public value: i32;
  public step: i32;

  public advance(&mut self): void {
    self.value = self.value + self.step;
    return;
  }

  public total(&self): i32 {
    return self.value;
  }
}

function main(): i32 {
  let mut counter: Counter = Counter { value: 2, step: 5 };
  let pointer: *mut Counter = &mut counter as *mut Counter;

  (*pointer).step = 10;
  counter.advance();

  return counter.total();
}
