enum Maybe {
    Some(i32),
    None,
}

function maybePositive(value: i32): Maybe {
    if (value > 0) {
        return Maybe::Some(value);
    }

    return Maybe::None;
}

function unwrapPositive(value: i32): i32 {
    let Maybe::Some(v) = maybePositive(value) else {
        return -1;
    };

    return v;
}

function main(): i32 {
    return unwrapPositive(4) + unwrapPositive(0);
}
