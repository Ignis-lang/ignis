// `&expr` and `&mut expr` take a reference to a value that is not a place:
// the value lives in a temporary of the statement, which is dropped at its
// end, and a parenthesized place stays the place itself.
import Io from "std::io";

function length(text: &String): u64 {
  return text.length();
}

function twice(value: &i32): i32 {
  return *value * 2;
}

function shout(text: &mut String): u64 {
  text.pushStr("!");
  return text.length();
}

function make(): String {
  return String::create("made");
}

function main(): i32 {
  Io::println(`${length(&String::create("abc"))} ${twice(&21)} ${shout(&mut make())}`);
  let total: u64 = length(&make()) + length(&String::create("xy"));
  Io::println(`${total}`);
  let mut counter: i32 = 1;
  let place: &mut i32 = &mut (counter);
  *place += 1;
  Io::println(`${counter}`);
  return 0;
}
