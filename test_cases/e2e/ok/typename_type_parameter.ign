// e2e: std
// `@typeName` names the concrete type of each instantiation: a type parameter,
// and `Self` in a generic record, print the type they stand for.
import Io from "std::io";

trait Named {
  kind(&self): str {
    return @typeName<Self>();
  }
}

@implements(Named)
record Box<T> {
  public value: T;
}

function nameOf<T>(): str {
  return @typeName<T>();
}

function boxedName<T>(): str {
  return nameOf<Box<T>>();
}

function main(): i32 {
  let small: Box<i32> = Box { value: 1 };
  let text: Box<str> = Box { value: "a" };
  Io::println(nameOf<i32>());
  Io::println(nameOf<str>());
  Io::println(small.kind());
  Io::println(text.kind());
  Io::println(@typeName<Box<i32>>());
  Io::println(boxedName<i32>());
  Io::println(nameOf<&Box<str>>());
  return 0;
}
