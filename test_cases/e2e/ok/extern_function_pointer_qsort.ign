extern LibC {
  function qsort(base: *mut u8, count: u64, size: u64, compare: (*u8, *u8) -> i32): void;
}

function compareAscending(left: *u8, right: *u8): i32 {
  let a: i32 = *(left as *i32);
  let b: i32 = *(right as *i32);

  return a - b;
}

function digits(values: i32[4]): i32 {
  return values[0] * 1000 + values[1] * 100 + values[2] * 10 + values[3];
}

function main(): i32 {
  let mut ascending: i32[4] = [3, 1, 4, 2];
  let mut descending: i32[4] = [3, 1, 4, 2];

  LibC::qsort((&mut ascending[0]) as *mut u8, 4, 4, compareAscending);
  LibC::qsort((&mut descending[0]) as *mut u8, 4, 4, (left: *u8, right: *u8): i32 -> *(right as *i32) - *(left as *i32));

  if (digits(ascending) != 1234) {
    return 1;
  }

  if (digits(descending) != 4321) {
    return 2;
  }

  return 42;
}
