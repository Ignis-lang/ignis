// Calling a named `never` function through a function value runs it: the
// panic exits the program before the caller's return.
function stop(code: i32): never {
    @panic("stop");
}

function run(callback: (i32) -> never, flag: boolean): i32 {
    if (flag) {
        callback(1);
    }

    return 42;
}

function main(): i32 {
    return run(stop, true);
}
