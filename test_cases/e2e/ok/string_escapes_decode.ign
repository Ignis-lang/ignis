// Every escape the language defines decodes in a string literal to its own
// value, `\u{...}` to the UTF-8 bytes of its scalar, and the documented `\a`
// and `\v` escapes also work in char literals.
function byteAt(text: str, index: u64): u8 {
  return *((text as *u8) + index);
}

function main(): i32 {
  let text: str = "\a\v\'\u{e9}\0";

  if (byteAt(text, 0) != 7 || byteAt(text, 1) != 11 || byteAt(text, 2) != 39) {
    return 1;
  }

  if (byteAt(text, 3) != 195 || byteAt(text, 4) != 169 || byteAt(text, 5) != 0) {
    return 2;
  }

  let bell: char = '\a';
  let vertical: char = '\v';

  if (bell as u32 != 7 || vertical as u32 != 11) {
    return 3;
  }

  return 0;
}
