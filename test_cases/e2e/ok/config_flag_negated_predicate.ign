// A `P` / `!P` pair of declarations selects one of two definitions: the
// negated half is dropped exactly when the positive one is kept, so the pair
// is not a redefinition and the surviving half is the one the target matches.

namespace Layout {
  @configFlag(@platform("linux"))
  const SELECTED: u64 = 1;

  @configFlag(!@platform("linux"))
  const SELECTED: u64 = 2;

  @configFlag(!@platform("plan9"))
  const KEPT_BY_NEGATION: u64 = 10;

  @configFlag(@platform("plan9"))
  const KEPT_BY_NEGATION: u64 = 20;
}

function main(): i32 {
  return (Layout::SELECTED + Layout::KEPT_BY_NEGATION) as i32;
}
