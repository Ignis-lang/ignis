// A record may refer to itself through a pointer: the pointer has a fixed size.

record Node {
  value: i32;
  next: Option<*Node>;
}

function main(): i32 {
  let last: Node = Node { value: 2, next: Option::NONE };
  let first: Node = Node { value: 1, next: Option::SOME(&last as *Node) };
  let mut total: i32 = first.value;

  if (let Option::SOME(next) = first.next) {
    total += @read<Node>(next).value;
  }

  return total;
}
