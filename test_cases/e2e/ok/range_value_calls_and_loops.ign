function next(counter: &mut i32): i32 {
  *counter = *counter + 1;

  return *counter;
}

function main(): i32 {
  let mut counter: i32 = 0;
  let span = next(&mut counter)..next(&mut counter);

  if (span.start != 1 || span.end != 2) {
    return 1;
  }

  let mut passes: i32 = 0;

  for (let outer of 0..3) {
    for (let inner of span) {
      passes += outer + inner;
    }
  }

  if (passes != 6) {
    return 2;
  }

  let bounded: RangeInclusive<i8> = -128..=127;
  let mut count: u32 = 0;

  for (let value of bounded) {
    if (value == 0) {
      continue;
    }

    count += 1;
  }

  if (count != 255) {
    return 3;
  }

  return 0;
}
