// Attributes declared in another module, used through a named import and
// through a qualified path into an imported namespace.
import Table, Orm, DEFAULT_WIDTH from "./declarable_attribute_import/orm";

@Table("tasks")
record Task {
  @Orm::PrimaryKey
  public id: i64;

  @Orm::Column("title", DEFAULT_WIDTH)
  public title: str;
}

function main(): i32 {
  let task: Task = Task { id: 7, title: "write" };
  return task.id as i32;
}
