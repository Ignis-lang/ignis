// e2e: std
// The first closure signature the helper module builds is `(i32, Next) -> i32`
// (`add` comes before `run`), and its call pointer takes a `Next` closure by
// value. The `Next` closure struct is only seen later, so the C unit has to
// declare it before the signature that names it.
import Chain from "./closure_signature_order/chain";

function twice(value: i32, next: Chain::Next): i32 {
  return next(value) * 2;
}

function main(): i32 {
  let mut router: Chain::Router = Chain::Router::new();

  router.add(twice);

  return router.run(0, 21);
}
