// A conditional expression whose branch starts with a parenthesized
// expression parses as a conditional, not as a lambda header: the `:` after
// `(value as u64)` belongs to the conditional.
function magnitude(value: i64): u64 {
  let negative: boolean = value < 0;

  return negative ? (0 as u64) - (value as u64) : value as u64;
}

function pick(flag: boolean, value: i32, other: i32): i32 {
  return flag ? (value) : other;
}

function main(): i32 {
  let addOne = (x: i32): i32 -> x + 1;

  if (magnitude(-5) != 5 || magnitude(7) != 7) {
    return 1;
  }

  if (pick(true, 3, 4) != 3 || pick(false, 3, 4) != 4) {
    return 2;
  }

  if (addOne(41) != 42) {
    return 3;
  }

  return 0;
}
