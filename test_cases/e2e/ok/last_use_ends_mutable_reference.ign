// A `let r = &mut x` borrow ends after the last statement that uses `r`.
record Counter {
  public value: i32;

  public read(&self): i32 {
    return self.value;
  }
}

function main(): i32 {
  let mut counter: Counter = Counter { value: 0 };
  let r: &mut Counter = &mut counter;
  r.value = 1;
  return counter.read() - 1;
}
