// e2e: std
// A closure popped out of a vector is bound by a let-else over the owned
// `Option` that `pop` returns, so the binding owns the environment and frees it
// once at the end of its scope.
import Vector from "std::vector";

function make(base: i32): () -> i32 {
  return (): i32 -> base + 2;
}

function main(): i32 {
  let mut callbacks: Vector<() -> i32> = Vector::new<() -> i32>();
  callbacks.push(make(40));

  let Option::SOME(first) = callbacks.pop() else {
    return 1;
  };

  return first();
}
