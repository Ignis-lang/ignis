// Regression for #205: a function referenced by name inside a module-level
// const (not called) must be reachable in mono and codegen-compatible with
// the closure ABI.
function helper(n: i32): i32 {
  return n + 7;
}

const transform: (i32) -> i32 = helper;

function main(): i32 {
  return transform(35);
}
