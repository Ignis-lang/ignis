record Pair<T> {
    a: T;
    b: T;

    fold<U>(&self, initial: U, @noescape f: (U, T) -> U): U {
        let mut acc: U = f(initial, self.a);
        acc = f(acc, self.b);
        return acc;
    }
}

function main(): i32 {
    let p: Pair<i32> = Pair { a: 40, b: 60 };
    let sum: i32 = p.fold<i32>(0, (acc: i32, x: i32): i32 -> acc + x);
    return sum;
}
