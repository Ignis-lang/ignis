// Binding a closure read out of a local record's field moves it out of the
// field: the binding frees the environment, and the record's drop skips it.
record Holder {
    public callback: () -> i32;
}

function makeHolder(base: i32): Holder {
    let add = (): i32 -> base + 2;

    return Holder { callback: add };
}

function main(): i32 {
    let holder = makeHolder(40);
    let call = holder.callback;

    return call();
}
