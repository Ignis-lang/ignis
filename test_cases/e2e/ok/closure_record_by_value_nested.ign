record Point {
  public x: i32;
  public y: i32;
}
record Handlers {
  public onPoint: (Point) -> i32;
}
record Widget {
  public name: str;
  public handlers: Handlers;
}

function main(): i32 {
  let widget: Widget = Widget {
    name: "widget",
    handlers: Handlers { onPoint: (p: Point): i32 -> p.x + p.y },
  };

  let f: (Point) -> i32 = widget.handlers.onPoint;
  return f(Point { x: 20, y: 22 });
}
