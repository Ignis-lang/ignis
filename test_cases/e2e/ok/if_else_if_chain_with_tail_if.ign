function nestedInElseIf(lead: i32): i32 {
  let mut a: i32 = 0;

  if (lead == 1) {
    a = 5;
  } else if (lead == 2) {
    if (lead == 2) {
      a = 1;
    }
  } else {
    a = 9;
  }

  return a;
}

function nestedInFirstBranch(lead: i32): i32 {
  let mut a: i32 = 0;

  if (lead == 1) {
    if (lead == 1) {
      a = 1;
    }
  } else if (lead == 2) {
    a = 5;
  } else {
    a = 9;
  }

  return a;
}

function nestedInFinalElse(lead: i32): i32 {
  let mut a: i32 = 0;

  if (lead == 1) {
    a = 5;
  } else if (lead == 2) {
    a = 6;
  } else {
    if (lead == 3) {
      a = 1;
    }
  }

  return a;
}

function nestedInElseIfWithoutFinalElse(lead: i32): i32 {
  let mut a: i32 = 0;

  if (lead == 1) {
    a = 5;
  } else if (lead == 2) {
    if (lead == 2) {
      a = 1;
    }
  }

  return a;
}

function nestedInThenOfIfElse(lead: i32): i32 {
  let mut a: i32 = 0;

  if (lead == 2) {
    if (lead == 2) {
      a = 1;
    }
  } else {
    a = 9;
  }

  return a;
}

function whileTailInElseIf(lead: i32): i32 {
  let mut a: i32 = 0;

  if (lead == 1) {
    a = 5;
  } else if (lead == 2) {
    while (a < 3) {
      a = a + 1;
    }
  } else {
    a = 9;
  }

  return a;
}

function allBranchesReturn(lead: i32): i32 {
  if (lead == 1) {
    return 1;
  } else if (lead == 2) {
    if (lead == 2) {
      return 2;
    }

    return 3;
  } else {
    return 4;
  }
}

function bothBranchesReturn(lead: i32): i32 {
  if (lead == 1) {
    return 10;
  } else {
    return 20;
  }
}

function main(): i32 {
  let mut total: i32 = 0;

  total = total + nestedInElseIf(1) + nestedInElseIf(2) + nestedInElseIf(3);
  total = total + nestedInFirstBranch(1) + nestedInFirstBranch(2) + nestedInFirstBranch(3);
  total = total + nestedInFinalElse(1) + nestedInFinalElse(2) + nestedInFinalElse(3) + nestedInFinalElse(4);
  total = total + nestedInElseIfWithoutFinalElse(1) + nestedInElseIfWithoutFinalElse(2) + nestedInElseIfWithoutFinalElse(3);
  total = total + nestedInThenOfIfElse(2) + nestedInThenOfIfElse(3);
  total = total + whileTailInElseIf(1) + whileTailInElseIf(2) + whileTailInElseIf(3);

  total = total + allBranchesReturn(1) + allBranchesReturn(2) + allBranchesReturn(3);
  total = total + bothBranchesReturn(1) + bothBranchesReturn(2);

  return total;
}
