// e2e: std
// Each round of a `while let` over `pop` binds a closure the vector gave up, and
// the round frees it.
import Vector from "std::vector";

function main(): i32 {
  let base: i32 = 20;
  let mut callbacks: Vector<() -> i32> = Vector::new<() -> i32>();
  callbacks.push((): i32 -> base + 1);
  callbacks.push((): i32 -> base + 1);
  let mut total: i32 = 0;

  while (let Option::SOME(callback) = callbacks.pop()) {
    total = total + callback();
  }

  return total;
}
