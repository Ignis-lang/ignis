// A by-value `self` method on a record that implements Drop. The receiver's
// drop-state guard reads the struct value itself, not through a pointer.
@implements(Drop)
record Resource {
  public value: i32;

  drop(&mut self): void {
  }

  public consume(self): i32 {
    return self.value;
  }
}

function main(): i32 {
  let resource: Resource = Resource { value: 3 };
  return resource.consume() - 3;
}
