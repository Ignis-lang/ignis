// e2e: std
// A `static str` owns its bytes, so it may be stored in a `Vector`, whose type
// parameter owns its storage.
import Io from "std::io";
import Vector from "std::vector";

function main(): i32 {
  let mut list: Vector<static str> = Vector::new<static str>();
  list.push("alpha");
  list.push("beta");

  let mut index: u64 = 0;

  while (index < list.length()) {
    if (let Option::SOME(word) = list.get(index)) {
      Io::println(*word);
    }

    index += 1;
  }

  Io::print(`count=${list.length()}\n`);

  return list.length() == 2 ? 0 : 1;
}
