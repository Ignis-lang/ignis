// Regression for #205: a function returned by name (not called) must be
// reachable in mono and codegen-compatible with the closure return ABI.
function helper(n: i32): i32 {
  return n + 7;
}

function getHelper(): (i32) -> i32 {
  return helper;
}

function main(): i32 {
  let f: (i32) -> i32 = getHelper();
  return f(35);
}
