// r8 to r15 have no constraint letter, so their operands go through
// register variables.
function main(): i32 {
  let value: u64 = 40;
  let result: u64 = asm (value in r8) -> (result: u64 in r9) { lea {result}, [{value} + 2] };

  let mut counter: u64 = result;

  asm (counter inout r15) clobber(flags) { sub {counter}, 0 }

  return counter as i32;
}
