// A nested namespace split across two outer blocks merges at every level
// (IGN-230): `Outer::Inner` gathers members from both `Outer` blocks.
namespace Outer {
  namespace Inner {
    function a(): i32 {
      return 1;
    }
  }
}

namespace Outer {
  namespace Inner {
    function b(): i32 {
      return 2;
    }
  }
}

function main(): i32 {
  return Outer::Inner::a() + Outer::Inner::b();
}
