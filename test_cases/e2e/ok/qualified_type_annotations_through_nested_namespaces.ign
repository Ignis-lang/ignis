// Qualified type annotations resolve when every segment matches the
// declaration's namespace, both fully qualified and relative to the
// namespace the annotation is written in.

namespace Outer {
    namespace Inner {
        record Point {
            x: i32;
        }
    }

    function make(): Inner::Point {
        return Inner::Point { x: 2 };
    }
}

function main(): i32 {
    let first: Outer::Inner::Point = Outer::Inner::Point { x: 1 };
    let second: Outer::Inner::Point = Outer::make();
    return first.x + second.x;
}
