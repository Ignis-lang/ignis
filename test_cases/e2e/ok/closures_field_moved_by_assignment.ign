// Assigning a closure read out of a local record's field into another record's
// field moves it out of the source field, so only the target frees it.
record Holder {
    public callback: () -> i32;
}

function makeHolder(base: i32): Holder {
    let add = (): i32 -> base + 2;

    return Holder { callback: add };
}

function main(): i32 {
    let holder = makeHolder(40);
    let mut target = Holder { callback: (): i32 -> 0 };
    target.callback = holder.callback;

    let call = target.callback;

    return call();
}
