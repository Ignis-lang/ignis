// A closure satisfies a `Send` bound when everything it captures is Send, and
// a named function always does: it has no environment.
record Point {
  public x: i32;
  public y: i32;
}

function spawn<F: Send>(task: F): i32 {
  return 1;
}

function named(): i32 {
  return 3;
}

function main(): i32 {
  let base: i32 = 2;
  let point: Point = Point { x: 5, y: 6 };

  let mut total: i32 = spawn((): i32 -> base + 1);
  total += spawn((): i32 -> point.x + point.y);
  total += spawn(named);
  total += spawn((): i32 -> 4);

  return total;
}
