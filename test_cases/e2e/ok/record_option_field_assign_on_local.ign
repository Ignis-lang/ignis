enum Option<S> {
    SOME(S),
    NONE,
}

record Store {
    public entryPoint: Option<i32>;
}

function main(): i32 {
    let mut store: Store = Store { entryPoint: Option::NONE };
    store.entryPoint = Option::SOME(7);

    let Option::SOME(value) = store.entryPoint else {
        return 1;
    };

    return value - 7;
}
