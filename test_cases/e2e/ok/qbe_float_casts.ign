// Conversions between floats and integers of every width and signedness,
// between the two float widths, and the bit reinterpretations.

function toF64FromI8(value: i8): f64 {
  return value as f64;
}

function toF64FromU32(value: u32): f64 {
  return value as f64;
}

function toF64FromI64(value: i64): f64 {
  return value as f64;
}

function toF64FromU64(value: u64): f64 {
  return value as f64;
}

function toF32FromU16(value: u16): f32 {
  return value as f32;
}

function toI32(value: f64): i32 {
  return value as i32;
}

function toI8(value: f32): i8 {
  return value as i8;
}

function toU32(value: f64): u32 {
  return value as u32;
}

function toI64(value: f32): i64 {
  return value as i64;
}

function toU64(value: f64): u64 {
  return value as u64;
}

function widen(value: f32): f64 {
  return value as f64;
}

function narrow(value: f64): f32 {
  return value as f32;
}

function main(): i32 {
  if (toF64FromI8(-5) != -5.0 || toF64FromU32(4294967295) != 4294967295.0) {
    return 1;
  }

  if (toF64FromI64(-9007199254740993) != -9007199254740992.0) {
    return 2;
  }

  if (toF64FromU64(18446744073709551615) != 18446744073709551616.0) {
    return 3;
  }

  if (toF32FromU16(65535) != 65535.0) {
    return 4;
  }

  if (toI32(-2.75) != -2 || toI32(2.75) != 2) {
    return 5;
  }

  if (toI8(-100.5) != -100) {
    return 6;
  }

  if (toU32(4000000000.5) != 4000000000) {
    return 7;
  }

  if (toI64(-16777216.0) != -16777216) {
    return 8;
  }

  if (toU64(10000000000000000000.0) != 10000000000000000000) {
    return 9;
  }

  // 0.1 is not representable: narrowing rounds, widening back is exact.
  if (widen(narrow(0.1)) == 0.1 || @bitCast<u64>(widen(narrow(0.1))) != 4591870180174331904) {
    return 10;
  }

  if (@bitCast<f64>(4611686018427387904 as u64) != 2.0 || @bitCast<f32>(1069547520 as u32) != 1.5) {
    return 11;
  }

  return 0;
}
