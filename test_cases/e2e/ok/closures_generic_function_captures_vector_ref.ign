// e2e: std
// A closure inside a generic function captures a parameter whose type names
// the function's type parameter. Every instantiation gets its own thunk, with
// the capture and the closure's parameters at that instantiation's types.
import Vector from "std::vector";

function lengthPlus<T>(items: &Vector<T>, extra: u64): u64 {
    let measure = (more: u64): u64 -> items.length() + more;

    return measure(extra);
}

function main(): i32 {
    let mut numbers: Vector<i32> = Vector::new<i32>();
    numbers.push(1);
    numbers.push(2);

    let mut flags: Vector<boolean> = Vector::new<boolean>();
    flags.push(true);

    return (lengthPlus<i32>(&numbers, 30) + lengthPlus<boolean>(&flags, 9)) as i32;
}
