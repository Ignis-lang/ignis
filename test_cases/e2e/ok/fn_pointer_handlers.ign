// e2e: std
// A Vector of `fn` handlers, built from named functions, a static method and
// a capture-free closure literal, called in a loop.
record Scale {
  static triple(value: i32): i32 {
    return value * 3;
  }
}

function double(value: i32): i32 {
  return value * 2;
}

function increment(value: i32): i32 {
  return value + 1;
}

function main(): i32 {
  let mut handlers: Vector<fn(i32) -> i32> = Vector::new<fn(i32) -> i32>();

  handlers.push(double);
  handlers.push(increment);
  handlers.push(Scale::triple);
  handlers.push((value: i32): i32 -> value - 4);

  let mut total: i32 = 0;
  let mut index: u64 = 0;

  while (index < handlers.length()) {
    if (let Option::SOME(handler) = handlers.get(index)) {
      total += (*handler)(10);
    }

    index += 1;
  }

  // 20 + 11 + 30 + 6
  return total - 67;
}
