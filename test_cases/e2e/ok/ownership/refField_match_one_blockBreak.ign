// scrutinee: a borrowed record field
// construct: match
// pattern:   a variant with one owning payload, bound
// body:      a block arm that breaks out of the enclosing loop
//
// The exit code is the construction/drop imbalance plus the difference between
// what the arm read and what it had to read, so 0 means every Tracked was
// dropped exactly once and the arm saw the payload it bound.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

enum Kind {
  ONE(Tracked),
  PAIR(Tracked, Tracked),
  EMPTY,
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

function take(payload: Tracked): i32 {
  return payload.id;
}

record Holder {
  public kind: Kind;
  public tag: i32;
}

/// Everything the case owns lives here, so `main` can read the counters once
/// every local has been dropped.
function run(): i32 {
  let mut seen: i32 = 0;
  let mut rounds: i32 = 0;

  while (rounds < 1) {
    rounds += 1;

    let holder: Holder = Holder { kind: Kind::ONE(tracked(1)), tag: 0 };

    match (&holder.kind) {
      Kind::ONE(payload) -> {
        seen = payload.id;
        break;
      },
      _ -> {},
    };
  }

  return seen;
}

function main(): i32 {
  let seen: i32 = run();

  return Counters::MADE - Counters::DROPPED + seen - 1;
}
