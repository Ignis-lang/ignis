// e2e: std
// e2e: skip a pattern binding is never dropped: 1 value leaked
// Generated by scripts/gen_ownership_corpus.py. Do not edit by hand.
//
// scrutinee: a call temporary
// construct: match
// pattern:   a catch-all identifier binding the whole scrutinee
// body:      a block arm that returns early
//
// The exit code is the construction/drop imbalance plus the difference between
// what the arm read and what it had to read, so 0 means every Tracked was
// dropped exactly once and the arm saw the payload it bound.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

enum Kind {
  ONE(Tracked),
  PAIR(Tracked, Tracked),
  EMPTY,
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

function take(payload: Tracked): i32 {
  return payload.id;
}

function makeValue(): Kind {
  return Kind::ONE(tracked(1));
}

/// Everything the case owns lives here, so `main` can read the counters once
/// every local has been dropped.
function run(): i32 {
  match (makeValue()) {
    Kind::EMPTY -> {},
    other -> {
      return 0;
    },
  };

  return 0;
}

function main(): i32 {
  let seen: i32 = run();

  return Counters::MADE - Counters::DROPPED + seen - 0;
}
