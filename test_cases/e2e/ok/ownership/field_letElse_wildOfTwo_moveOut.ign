// scrutinee: an owned record's field
// construct: letElse
// pattern:   a variant with two payloads, one discarded by `_`
// body:      an arm that moves the binding into a consuming helper
//
// The exit code is the construction/drop imbalance plus the difference between
// what the arm read and what it had to read, so 0 means every Tracked was
// dropped exactly once and the arm saw the payload it bound.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

enum Kind {
  ONE(Tracked),
  PAIR(Tracked, Tracked),
  EMPTY,
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

function take(payload: Tracked): i32 {
  return payload.id;
}

record Holder {
  public kind: Kind;
  public tag: i32;
}

/// Everything the case owns lives here, so `main` can read the counters once
/// every local has been dropped.
function run(): i32 {
  let mut holder: Holder = Holder { kind: Kind::PAIR(tracked(1), tracked(2)), tag: 0 };

  let Kind::PAIR(left, _) = holder.kind else {
    return -1;
  };

  return take(left);
}

function main(): i32 {
  let seen: i32 = run();

  return Counters::MADE - Counters::DROPPED + seen - 1;
}
