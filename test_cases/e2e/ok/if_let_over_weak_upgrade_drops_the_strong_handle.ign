// e2e: std
import Option from "std::option";
import Rc, Weak from "std::rc";

function main(): i32 {
    let strong: Rc<i32> = Rc::new<i32>(41);
    let weak: Weak<i32> = strong.downgrade();
    let mut total: i32 = 0;

    if (let Option::SOME(upgraded) = weak.upgrade()) {
        total += *upgraded.get();
    }

    total += strong.strongCount() as i32;

    return total - 42;
}
