// Regression for #205: a function referenced only as a bare value (not
// called) must still be reachable in the host monomorphizer so its body is
// emitted, and codegen must be able to coerce it into the closure ABI.
function helper(n: i32): i32 {
  return n + 7;
}

function main(): i32 {
  let f: (i32) -> i32 = helper;
  return f(35);
}
