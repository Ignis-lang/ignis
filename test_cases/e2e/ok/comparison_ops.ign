function main(): i32 {
    let mut result: i32 = 0;
    
    if (5 == 5) { result = result + 1; }
    if (5 != 3) { result = result + 1; }
    if (3 < 5) { result = result + 1; }
    if (5 > 3) { result = result + 1; }
    if (5 <= 5) { result = result + 1; }
    if (5 >= 5) { result = result + 1; }
    
    return result;
}
