// A bare name in a pattern that is not a variant of the scrutinee's enum binds a new variable.
enum Shape {
    CIRCLE(i32),
    EMPTY,
}

function tag(shape: Shape): i32 {
    return match (shape) {
        Shape::CIRCLE(radius) -> radius,
        other -> 7,
    };
}

function main(): i32 {
    return tag(Shape::EMPTY);
}
