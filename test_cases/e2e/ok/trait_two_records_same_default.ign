trait Answerable {
    answer(&self): i32 {
        return 42;
    }
}

@implements(Answerable)
record Alpha {
    public x: i32;
}

@implements(Answerable)
record Beta {
    public y: i32;
}

function main(): i32 {
    let a: Alpha = Alpha { x: 1 };
    let b: Beta = Beta { y: 2 };
    return a.answer() + b.answer() - 42;
}
