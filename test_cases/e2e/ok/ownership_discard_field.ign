// `let _ = holder.field;` on a droppable field is a partial move, not a copy: the read
// takes the field out of the record and the discard statement drops it there, and the
// record's own drop no longer owes that field a second one. The exit code folds the
// construction/drop imbalance together with what the scope observed, so 0 means the
// field was dropped exactly once and dropped at the discard statement.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

record Holder {
  public kind: Tracked;
  public tag: i32;
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

/// Drops counted across the discard statement alone: 1 once the moved-out field dies
/// with its statement.
function run(): i32 {
  let holder: Holder = Holder { kind: tracked(1), tag: 0 };
  let before: i32 = Counters::DROPPED;
  let _ = holder.kind;

  return Counters::DROPPED - before;
}

function main(): i32 {
  let atStatement: i32 = run();

  return Counters::MADE - Counters::DROPPED + atStatement - 1;
}
