// e2e: std
//
// Results of free functions that stay within the lifetime of their arguments are
// accepted: an argument bound to a local first, an argument used inside the statement,
// a parameter passed through, a literal argument, and arguments that are not views.
import Io from "std::io";

function pick(text: str): str {
  return text;
}

function label(code: i32): str {
  return code == 0 ? "zero" : "other";
}

function passThrough(text: str): str {
  return pick(text);
}

function main(): i32 {
  let owned: String = String::create("bound");
  let kept: str = pick(owned.toStr());

  Io::println(kept);
  Io::println(pick(String::create("argument").toStr()));
  Io::println(passThrough("literal"));
  Io::println(label(0));
  return 0;
}
