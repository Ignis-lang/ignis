// Two `namespace Foo { ... }` blocks with the same name in one file merge
// into a single namespace: both blocks' members stay reachable as `Foo::*`
// (IGN-230).
namespace Foo {
  function a(): i32 {
    return 1;
  }
}

namespace Foo {
  function b(): i32 {
    return 2;
  }
}

function main(): i32 {
  return Foo::a() + Foo::b();
}
