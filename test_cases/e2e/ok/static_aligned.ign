// `@aligned(N)` on a static field places its one global at an address that is a
// multiple of `N`: a zero-initialized `static mut`, a seeded `static mut` and an
// immutable static whose address is taken, including an `N` equal to the
// type's own alignment.
record Page {
  public bytes: u8[4096];
}

record Tables {
  @aligned(16)
  static mut SMALL: u8[3];
  @aligned(64)
  static mut LINE: u32[4];
  @aligned(4096)
  static mut PML4: u64[512];
  @aligned(4096)
  static mut PAGE: Page;
  @aligned(4096)
  static mut SEEDED: u64[2] = [1, 2];
  @aligned(64)
  static ROWS: u16[4] = [1, 2, 3, 4];
  @aligned(1)
  static mut BYTE: u8;
  @aligned(8)
  static mut WORD: u64;
}

function addressOf(pointer: *mut u8): u64 {
  return @integerFromPointer(pointer);
}

function main(): i32 {
  if (addressOf(&Tables::SMALL as *mut u8) % 16 != 0) {
    return 1;
  }

  if (addressOf(&Tables::LINE as *mut u8) % 64 != 0) {
    return 2;
  }

  if (addressOf(&Tables::PML4 as *mut u8) % 4096 != 0) {
    return 3;
  }

  if (addressOf(&Tables::PAGE as *mut u8) % 4096 != 0) {
    return 4;
  }

  if (addressOf(&Tables::SEEDED as *mut u8) % 4096 != 0) {
    return 5;
  }

  if (addressOf(&Tables::ROWS as *mut u8) % 64 != 0) {
    return 6;
  }

  if (addressOf(&Tables::WORD as *mut u8) % 8 != 0) {
    return 7;
  }

  Tables::PML4[511] = 9;
  Tables::SEEDED[1] += 1;

  if (Tables::PML4[0] != 0 || Tables::PML4[511] != 9 || Tables::SEEDED[0] != 1 || Tables::SEEDED[1] != 3) {
    return 8;
  }

  if (Tables::ROWS[3] != 4 || Tables::BYTE != 0) {
    return 9;
  }

  return 0;
}
