@implements(Drop, Clone)
record Box<T> {
    public value: T;

    clone(&self): Box<T> {
        return Box<T> { value: self.value };
    }

    drop(&mut self): void {
        return;
    }
}

function consume(b: Box<i32>): i32 {
    return b.value;
}

function main(): i32 {
    let a: Box<i32> = Box<i32> { value: 21 };
    let b: Box<i32> = a.clone();
    return consume(a) + consume(b);
}
