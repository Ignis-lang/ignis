// A closure body whose final expression reads a closure field out of a local
// record returns that closure, so the read moves it out
// of the field just as an explicit return does, and the record does not free it.
record Holder {
    public callback: () -> i32;
}

function makeHolder(base: i32): Holder {
    let add = (): i32 -> base + 2;

    return Holder { callback: add };
}

function main(): i32 {
    let make = (): () -> i32 -> {
        let holder = makeHolder(40);
        holder.callback
    };
    let call = make();

    return call();
}
