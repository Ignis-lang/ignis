// e2e: std
// The first closure signature the helper module builds is `(i32, &Next) -> i32`,
// and `Next` is only seen later. A struct tag first named inside a parameter
// list has prototype scope even behind a reference, so the C unit has to
// declare the `Next` closure struct tag before that signature names it.
import Chain from "./closure_signature_order_by_reference/chain";

function twice(value: i32, next: &Chain::Next): i32 {
  return (*next)(value) * 2;
}

function main(): i32 {
  let mut router: Chain::Router = Chain::Router::new();

  router.add(twice);

  return router.run(0, 21);
}
