// e2e: std
// The trait, an implementer and the generic caller live in three modules. The
// implementer inherits a static default across the module boundary.
import Io from "std::io";
import Gauge from "./trait_static_method_cross_module/gauge";
import readTwice from "./trait_static_method_cross_module/reader";

@implements(Gauge)
record Meter {
  public level: i32;

  static reading(): i32 {
    return 21;
  }
}

function main(): i32 {
  Io::println(`meter ${readTwice<Meter>()}`.toStr());

  return 0;
}
