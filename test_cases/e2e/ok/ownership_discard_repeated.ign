// A discard names no binding, so a scope may hold as many as it likes: `_` is never
// defined and so can never be redefined. Each discard drops its own value at its own
// statement. The exit code folds the construction/drop imbalance together with what the
// scope observed, so 0 means both values were dropped exactly once, each at its
// statement.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

/// Drops counted across the two discard statements: 2, one per statement.
function run(): i32 {
  let before: i32 = Counters::DROPPED;
  let _ = tracked(1);
  let _ = tracked(2);

  return Counters::DROPPED - before;
}

function main(): i32 {
  let atStatements: i32 = run();

  return Counters::MADE - Counters::DROPPED + atStatements - 2;
}
