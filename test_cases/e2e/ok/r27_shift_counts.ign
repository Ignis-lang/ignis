// Shift counts mask to the shifted type's width minus one through the
// count's bit pattern, and left shifts wrap modulo 2^width.
function main(): i32 {
  let one: i32 = 1;
  let byWidth: i32 = one << 32;
  if (byWidth != 1) {
    return 1;
  }

  let byMax: i32 = one << 31;
  if (byMax != -2147483647 - 1) {
    return 2;
  }

  let neg: i32 = 0 - 1;
  let byNegative: i32 = one << neg;
  if (byNegative != -2147483647 - 1) {
    return 3;
  }

  let mut shifted: u32 = 1;
  shifted <<= 31;
  if (shifted != 2147483648) {
    return 4;
  }

  let backDown: u32 = shifted >> 31;
  if (backDown != 1) {
    return 5;
  }

  let u64One: u64 = 1;
  let maskedToZero: u64 = u64One << 64;
  if (maskedToZero != 1) {
    return 6;
  }

  let i64One: i64 = 1;
  let i64ByMax: i64 = i64One << 63;
  if (i64ByMax != -9223372036854775807 - 1) {
    return 7;
  }

  let negative: i32 = 0 - 8;
  let signFill: i32 = negative >> 33;
  if (signFill != -4) {
    return 8;
  }

  let narrow: u8 = 1;
  let byNine: u8 = narrow << 9;
  if (byNine != 2) {
    return 9;
  }

  return 0;
}
