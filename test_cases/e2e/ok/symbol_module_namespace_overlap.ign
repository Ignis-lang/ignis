// `util.ign` declares `text::width` and `util/text.ign` declares `width`: the
// same words, split differently between module and written path. Each one
// needs its own symbol, or the C unit defines the same function twice.
import text from "./symbol_module_namespace_overlap/util";
import other from "./symbol_module_namespace_overlap/util/text";

function main(): i32 {
  return text::width() * 10 + other();
}
