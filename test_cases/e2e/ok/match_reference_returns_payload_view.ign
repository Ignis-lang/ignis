// A payload matched through a reference aliases the referent, so returning
// a reference to it from a `match` expression is accepted.
import Io from "std::io";

enum Kind {
  TEXT(String),
  EMPTY,
}

record Value {
  public kind: Kind;
}

function textOf(value: &Value): &String {
  return match (&value.kind) {
    Kind::TEXT(members) -> &members,
    _ -> @panic("no text"),
  };
}

function main(): i32 {
  let value: Value = Value { kind: Kind::TEXT(String::create("hello")) };
  Io::println(textOf(&value).toStr());
  return 0;
}
