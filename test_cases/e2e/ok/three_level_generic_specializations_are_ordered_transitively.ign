record Leaf {
    public tag: i32;
}

record Holder<T> {
    public value: T;
}

function main(): i32 {
    let deep: Holder<Holder<Holder<Leaf>>> = Holder<Holder<Holder<Leaf>>> {
        value: Holder<Holder<Leaf>> {
            value: Holder<Leaf> { value: Leaf { tag: 21 } },
        },
    };

    return deep.value.value.value.tag;
}
