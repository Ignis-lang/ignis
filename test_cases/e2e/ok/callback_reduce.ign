function reduceValues(data: *i32, len: i32, @noescape f: (i32, i32) -> i32): i32 {
    let mut acc: i32 = data[0];
    let mut i: i32 = 1;
    while (i < len) {
        acc = f(acc, data[i as u64]);
        i = i + 1;
    }
    return acc;
}

function main(): i32 {
    let data: i32[4] = [1, 2, 3, 4];
    let ptr: *i32 = (&data[0]) as *i32;
    return reduceValues(ptr, 4, (acc: i32, x: i32): i32 -> acc + x);
}
