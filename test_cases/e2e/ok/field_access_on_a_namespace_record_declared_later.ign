export namespace Holder {
    function readValue(state: &mut Holder::State): i32 {
        let alias: &mut Holder::State = state;

        return alias.value;
    }

    record State {
        public value: i32;
    }
}

function main(): i32 {
    let mut state: Holder::State = Holder::State { value: 9 };

    return Holder::readValue(&mut state);
}
