function anyMatches(data: *i32, len: i32, @noescape predicate: (i32) -> boolean): boolean {
    let mut i: i32 = 0;
    while (i < len) {
        if (predicate(data[i as u64])) { return true; }
        i = i + 1;
    }
    return false;
}

function allMatch(data: *i32, len: i32, @noescape predicate: (i32) -> boolean): boolean {
    let mut i: i32 = 0;
    while (i < len) {
        if (!predicate(data[i as u64])) { return false; }
        i = i + 1;
    }
    return true;
}

function main(): i32 {
    let data: i32[3] = [2, 4, 6];
    let ptr: *i32 = (&data[0]) as *i32;
    let hasOdd = anyMatches(ptr, 3, (x: i32): boolean -> x % 2 != 0);
    let allEven = allMatch(ptr, 3, (x: i32): boolean -> x % 2 == 0);
    let mut result: i32 = 0;
    if (!hasOdd) { result = result + 10; }
    if (allEven) { result = result + 20; }
    return result;
}
