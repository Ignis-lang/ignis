// e2e: std
// A load cannot release: the runtime ordering is checked at the call and an
// invalid one panics instead of being clamped to a weaker or stronger one.
import AtomicU64, Ordering from "std::sync";

function main(): i32 {
  let counter: AtomicU64 = AtomicU64::new(1);

  return counter.load(Ordering::RELEASE) as i32;
}
