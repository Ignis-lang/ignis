function make(base: i32): () -> i32 {
  let offset: i32 = base;
  return (): i32 -> offset;
}

function apply(@noescape f: () -> i32): i32 {
  return f();
}

function consume(f: () -> i32): i32 {
  return f();
}

function main(): i32 {
  let mut total: i32 = 0;
  let mut index: i32 = 0;

  while (index < 6) {
    total += apply(make(index));
    index += 1;
  }

  index = 0;

  while (apply(make(index)) < 3) {
    index += 1;
  }

  if (apply(make(4)) == 4) {
    total += 100;
  }

  make(1);

  total += consume(make(7));

  return total + index;
}
