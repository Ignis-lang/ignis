// e2e: std
// A concrete candidate the argument only value-satisfies (an `i32` widening
// to `i64`, a `static str` converting to `str`) outranks an unbounded generic
// candidate that would bind the argument exactly. An argument the concrete
// candidate rejects still takes the generic one.
import Io from "std::io";

function wide(value: i64): String {
  return `number ${value}`;
}

function wide<T>(value: T): String {
  return String::create("generic");
}

function label(value: str): String {
  return `str ${value}`;
}

function label<T>(value: T): String {
  return String::create("generic");
}

function main(): i32 {
  let narrow: i32 = 3;
  let literal: static str = "literal";
  let byNarrow: String = wide(narrow);
  let byLiteral: String = label(literal);
  let byFlag: String = wide(true);
  Io::println(byNarrow.toStr());
  Io::println(byLiteral.toStr());
  Io::println(byFlag.toStr());

  return 0;
}
