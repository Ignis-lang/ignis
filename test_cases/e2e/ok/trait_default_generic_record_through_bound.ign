// A generic record inherits a trait default, which a generic function calls
// through a bound: the call reaches the record's instance of the default.
trait Measured {
  area(&self): i32;

  doubled(&self): i32 {
    return self.area() * 2;
  }
}

@implements(Measured)
record Tagged<T> {
  public tag: T;
  public size: i32;

  area(&self): i32 {
    return self.size;
  }
}

function doubledArea<T: Measured>(value: &T): i32 {
  return value.doubled();
}

function main(): i32 {
  let tagged: Tagged<i32> = Tagged { tag: 1, size: 3 };
  return doubledArea<Tagged<i32>>(&tagged);
}
