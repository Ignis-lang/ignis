// e2e: std
//
// The `while` form of a conjunct in front of a `let` condition. The condition is
// re-evaluated on every iteration, and the iteration that ends the loop is the
// one that takes the short-circuit path: the place a skipped `let` would have
// consumed is still live there, so that path owes its drop.
//
// A place whose value the body does not put back is a different program: the
// next round would read what the `let` already took apart, and the compiler
// rejects it (see `test_cases/e2e/err/err_short_circuit_let_loop_repeats.ign`).
// Every case here either rebinds the place or scrutinises a call.
//
// The exit code is the construction/drop imbalance plus the difference between
// what each case read and what it had to read, so 0 means every Tracked was
// dropped exactly once.

record Counters {
  static mut MADE: i32 = 0;
  static mut DROPPED: i32 = 0;
}

@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    Counters::DROPPED += 1;
    return;
  }
}

enum Kind {
  ONE(Tracked),
  EMPTY,
}

record Source {
  public remaining: i32;

  public next(&mut self): Kind {
    if (self.remaining <= 0) {
      return Kind::EMPTY;
    }

    self.remaining -= 1;

    return Kind::ONE(tracked(1));
  }
}

function tracked(id: i32): Tracked {
  Counters::MADE += 1;
  return Tracked { id: id };
}

function one(id: i32): Kind {
  return Kind::ONE(tracked(id));
}

/// The boolean ends the loop. The body puts a value back into the place every
/// round, so the round that reads a false boolean holds one, and the
/// short-circuit path is where it is freed.
function booleanEndsOverPlace(): i32 {
  let mut rounds: i32 = 0;
  let mut holder: Kind = one(1);

  while (rounds < 3 && let Kind::ONE(item) = holder) {
    rounds += item.id;
    holder = one(1);
  }

  return rounds;
}

/// The same loop left through a `break`. The round that breaks has already let
/// the `let` take the place apart, so only the binding is owed there, and the
/// `break` out of the guarded body is what owes it.
function bodyBreaksOverPlace(): i32 {
  let mut rounds: i32 = 0;
  let mut holder: Kind = one(1);

  while (rounds < 3 && let Kind::ONE(item) = holder) {
    rounds += item.id;

    if (rounds >= 2) {
      break;
    }

    holder = one(1);
  }

  return rounds;
}

/// A boolean in front of a `let` over a call: a false boolean skips the call, so
/// the iteration that ends the loop builds nothing and owes nothing.
function booleanEndsOverTemporary(): i32 {
  let mut rounds: i32 = 0;
  let mut source: Source = Source { remaining: 4 };

  while (rounds < 2 && let Kind::ONE(item) = source.next()) {
    rounds += item.id;
  }

  return rounds;
}

/// The `let` ends the loop instead: the call yields the variant the pattern does
/// not match, and the match frees what it produced.
function letEndsOverTemporary(): i32 {
  let mut rounds: i32 = 0;
  let mut source: Source = Source { remaining: 2 };

  while (rounds < 8 && let Kind::ONE(item) = source.next()) {
    rounds += item.id;
  }

  return rounds;
}

function main(): i32 {
  let mut observed: i32 = 0;

  observed += booleanEndsOverPlace() - 3;
  observed += bodyBreaksOverPlace() - 2;
  observed += booleanEndsOverTemporary() - 2;
  observed += letEndsOverTemporary() - 2;

  return Counters::MADE - Counters::DROPPED + observed;
}
