enum Maybe {
    Some(i32),
    None,
}

function maybePositive(value: i32): Maybe {
    if (value > 0) {
        return Maybe::Some(value);
    }
    return Maybe::None;
}

function main(): i32 {
    if (let Maybe::Some(x) = maybePositive(0)) {
        return x;
    } else {
        return 7;
    }
}
