// e2e: std
// A `str` view of a `String` holds a shared borrow only until its last use, so the
// owner can be mutated afterwards.
import Io from "std::io";
import String from "std::string";

function consume(text: str): void {
  Io::println(text);
}

function main(): i32 {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  consume(text);
  owned.pushChar('d');
  Io::println(owned.toStr());
  return 0;
}
