// e2e: std
// Floats rendered through the standard library, which formats them with the
// C library's variadic `snprintf`.
import Io from "std::io";

function main(): i32 {
  let ratio: f64 = 0.5;
  let narrow: f32 = 1.25;
  let large: f64 = 123456789.0;
  let tiny: f64 = 0.000001;
  let zero: f64 = 0.0;
  let negative: f64 = -zero;
  let infinite: f64 = 1.0 / zero;

  Io::println(String::create(ratio).toStr());
  Io::println(String::create(narrow).toStr());
  Io::println(String::create(large).toStr());
  Io::println(String::create(tiny).toStr());
  Io::println(String::create(negative).toStr());
  Io::println(String::create(infinite).toStr());
  Io::println(`ratio=${ratio} narrow=${narrow} sum=${ratio + 2.25}`.toStr());

  return 0;
}
