// A closure bound through a reference scrutinee names the payload in place: it
// can be called, and the `Option` that owns it frees the environment once.
function make(base: i32): Option<(i32) -> i32> {
  return Option::SOME((x: i32): i32 -> x + base);
}

function call(maybe: &Option<(i32) -> i32>): i32 {
  if (let Option::SOME(f) = maybe) {
    return f(20);
  }

  return 0;
}

function main(): i32 {
  let maybe = make(1);
  let first: i32 = call(&maybe);

  return match (&maybe) {
    Option::SOME(f) -> first + f(20),
    Option::NONE -> 1,
  };
}
