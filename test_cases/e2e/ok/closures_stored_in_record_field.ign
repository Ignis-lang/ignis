// Storing the closure in a record initializer moves it into the field, so the
// record owns the environment and frees it exactly once at scope exit.
record Holder {
    public callback: (i32) -> i32;
}

function main(): i32 {
    let base: i32 = 40;
    let add = (x: i32): i32 -> x + base;

    let holder = Holder { callback: add };
    let stored = holder.callback;

    return stored(2);
}
