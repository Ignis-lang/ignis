enum Maybe {
    Some(i32),
    None,
}

function halfIfEven(value: i32): Maybe {
    if (value % 2 == 0) {
        return Maybe::Some(value / 2);
    }
    return Maybe::None;
}

function main(): i32 {
    if (let Maybe::Some(x) = Maybe::Some(8) && let Maybe::Some(y) = halfIfEven(x) && y > 3) {
        return y;
    }

    return 0;
}
