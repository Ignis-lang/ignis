// e2e: skip helper module of e2e::declarable_attribute_import: alone it has no main and cannot link; it runs through the entry fixture
export const DEFAULT_WIDTH: i32 = 12;

@attribute(record)
export record Table {
  public name: str;
}

export namespace Orm {
  @attribute(field)
  export record PrimaryKey {}

  @attribute(field)
  export record Column {
    public name: str;
    public width: i32;
  }
}
