function inc(r: *mut i32): void {
    @write<i32>(r, @read<i32>(r) + 1);
}

function main(): i32 {
    let mut count: i32 = 0;
    let ptr: *mut i32 = (&mut count) as *mut i32;
    let mut i: i32 = 0;
    while (i < 3) {
        defer inc(ptr);
        i = i + 1;
        if (i == 2) { continue; }
    }
    return count;
}
