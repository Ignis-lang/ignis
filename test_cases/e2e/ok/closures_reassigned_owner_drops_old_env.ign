// Overwriting a binding that owns a closure environment drops the old
// environment first. Run under leak checking: the first environment has no other
// holder, so skipping that drop leaks it.
function makeAdder(base: i32): (i32) -> i32 {
    return (x: i32): i32 -> x + base;
}

function main(): i32 {
    let mut f = makeAdder(10);
    f = makeAdder(40);

    return f(2);
}
