// e2e: err
// A pipe with a placeholder passes the closure in its written position, where it is judged.
function spawn2(count: i32, @sendable task: () -> i32): i32 {
  return task() + count;
}
function main(): i32 {
  let mut base: i32 = 7;
  let pointer: *mut i32 = &mut base as *mut i32;
  return 1 |> spawn2(_, (): i32 -> *pointer);
}
