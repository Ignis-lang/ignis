// e2e: err
//
// Returning a view of a local, or of a temporary, hands the caller storage the
// function drops on the way out.

function viewOfLocal(): str {
  let owned: String = String::create("abc");
  return owned.toStr();
}

function viewOfTemporary(): str {
  return String::create("abc").toStr();
}

function main(): i32 {
  let first: str = viewOfLocal();
  let second: str = viewOfTemporary();

  return 0;
}
