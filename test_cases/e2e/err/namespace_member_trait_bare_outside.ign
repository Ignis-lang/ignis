// e2e: err
// A trait declared in a namespace is reached from outside only by its path,
// in `@implements(...)` and in a bound alike.
namespace Shapes {
  trait Sized {
    side(&self): i32;
  }
}

@implements(Sized)
record Square {
  public length: i32;

  side(&self): i32 {
    return self.length;
  }
}

function measure<T: Sized>(value: &T): i32 {
  return value.side();
}

function main(): i32 {
  let square: Square = Square { length: 2 };
  return measure<Square>(&square);
}
