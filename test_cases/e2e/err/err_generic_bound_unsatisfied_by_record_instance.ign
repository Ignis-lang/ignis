// e2e: err
// A generic record's bounds hold wherever it is instantiated, including a
// type annotation that never calls anything generic.
trait Weigh {
  weigh(&self): i32;
}

record Plain {
  public grams: i32;
}

record Scale<T: Weigh> {
  public item: T;
}

function main(): i32 {
  let scale: Scale<Plain> = Scale { item: Plain { grams: 3 } };

  return scale.item.grams;
}
