// e2e: err
// A static method of a generic record judges its `@sendable` arguments like any call.
record Pool<T> {
  public value: T;

  submit(@sendable task: () -> i32): i32 {
    return task();
  }
}
function main(): i32 {
  let mut base: i32 = 7;
  let pointer: *mut i32 = &mut base as *mut i32;
  return Pool::submit<i32>((): i32 -> *pointer);
}
