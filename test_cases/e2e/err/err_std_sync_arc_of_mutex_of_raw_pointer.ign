// e2e: err
// `Mutex<T>` is Sync only when `T` is Send. A raw pointer is not, so neither
// the mutex nor an `Arc` of it can be formed.
import Arc, Mutex from "std::sync";

function main(): i32 {
  let _shared: Arc<Mutex<*mut i32>> = Arc::new<Mutex<*mut i32>>(Mutex::new<*mut i32>(0 as *mut i32));

  return 0;
}
