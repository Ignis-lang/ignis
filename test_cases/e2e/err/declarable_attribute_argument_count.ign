// e2e: err
// Arguments must match the attribute record's fields one for one.
@attribute(record)
record Table {
  public name: str;
  public version: i32;
}

@Table("tasks")
record Task {
  public id: i64;
}

@Table("notes", 1, 2)
record Note {
  public id: i64;
}

function main(): i32 {
  return 0;
}
