// e2e: err
//
// A view and a `&mut` place travelling in the same value reach the callee
// together: the callee can store the view through the place, so the borrow
// lasts to the end of the scope.
record Pair {
  public text: str;
  public slot: &mut str;

  public flush(&self): void {
    *self.slot = self.text;
  }
}

function consume(text: str): void {
  return;
}

function sink(pair: Pair): void {
  *pair.slot = pair.text;
}

function sinkRef(pair: &Pair): void {
  *pair.slot = pair.text;
}

function sinkOpt(maybe: Option<Pair>): void {
  if (let Option::SOME(pair) = maybe) {
    *pair.slot = pair.text;
  }
}

function temporary(): void {
  let mut owned: String = String::create("abc");
  let mut slot: str = "";
  let text: str = owned.toStr();
  sink(Pair { text: text, slot: &mut slot });
  owned.pushChar('d');
  consume(slot);
}

function bound(): void {
  let mut owned: String = String::create("abc");
  let mut slot: str = "";
  let text: str = owned.toStr();
  let pair: Pair = Pair { text: text, slot: &mut slot };
  sink(pair);
  owned.pushChar('d');
  consume(slot);
}

function shared(): void {
  let mut owned: String = String::create("abc");
  let mut slot: str = "";
  let text: str = owned.toStr();
  let pair: Pair = Pair { text: text, slot: &mut slot };
  sinkRef(&pair);
  owned.pushChar('d');
  consume(slot);
}

function wrapped(): void {
  let mut owned: String = String::create("abc");
  let mut slot: str = "";
  let text: str = owned.toStr();
  sinkOpt(Option::SOME(Pair { text: text, slot: &mut slot }));
  owned.pushChar('d');
  consume(slot);
}

function main(): i32 {
  temporary();
  bound();
  shared();
  wrapped();
  return 0;
}
