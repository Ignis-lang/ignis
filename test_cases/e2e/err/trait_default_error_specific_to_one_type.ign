// e2e: err
// A trait default that is valid against the trait and for one implementing
// type, but not for another whose method of the same name returns a different
// type, is reported once, for that type.
trait Shape {
  area(&self): i32;

  doubled(&self): i32 {
    let area: i32 = self.area();
    return area * 2;
  }
}

@implements(Shape)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

@implements(Shape)
record Flag {
  public set: boolean;

  area(&self): boolean {
    return self.set;
  }
}

function main(): i32 {
  let square: Square = Square { side: 2 };
  let flag: Flag = Flag { set: true };
  return square.doubled() + flag.doubled();
}
