// e2e: err
// `@attribute<A>(Self)` where `Self` is an enum reads the attribute only when
// `A` applies to enums; an attribute for records is rejected, not `NONE`.
@attribute(record)
record Table {
  public name: str;
}

trait Tabled {
  table(&self): str {
    if (let Option::SOME(table) = @attribute<Table>(Self)) {
      return table.name;
    }

    return "none";
  }
}

@implements(Tabled)
enum Color {
  RED,
}

function main(): i32 {
  let color: Color = Color::RED;
  let _name: str = color.table();
  return 0;
}
