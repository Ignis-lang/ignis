// e2e: err
record Pair {
  public left: u32;
  public right: u32;
}

function main(): void {
  let mut number: f64 = 0.0;
  let numberPtr: *mut f64 = (&mut number) as *mut f64;
  let _number: f64 = @atomicLoad<f64>(numberPtr, :seqCst);

  let mut pair: Pair = Pair { left: 0, right: 0 };
  let pairPtr: *mut Pair = (&mut pair) as *mut Pair;
  @atomicStore<Pair>(pairPtr, Pair { left: 1, right: 2 }, :seqCst);
}
