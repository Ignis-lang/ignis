// e2e: err
// An enum declared in a namespace is reached from outside only by its path,
// in a type and in a variant path alike.
namespace Geometry {
  enum Shape {
    CIRCLE,
    SQUARE,
  }
}

function main(): i32 {
  let shape: Shape = Shape::CIRCLE;

  return match (shape) {
    Shape::CIRCLE -> 1,
    Shape::SQUARE -> 2,
  };
}
