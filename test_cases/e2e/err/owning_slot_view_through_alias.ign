// e2e: err
// A type alias is transparent: `Text` is `str`, so `Vector<Text>` is a `Vector`
// with a view argument and its `@owns` element slot rejects it.
import Io from "std::io";

type Text = str;

function keepView(): Vector<Text> {
  let owner: String = String::create("aliased owner");
  let mut list: Vector<Text> = Vector::new<Text>();
  list.push(owner.toStr());
  return list;
}

function main(): i32 {
  let list: Vector<Text> = keepView();
  if (let Option::SOME(view) = list.get(0)) {
    Io::println(*view);
  }
  return 0;
}
