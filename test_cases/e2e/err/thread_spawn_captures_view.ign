// e2e: err
// A closure that captures a view is a view (S2): its environment borrows from
// the defining frame. Views are not `Send` (S3), so `Thread::spawn` rejects
// it — the borrow would dangle on the other thread.
import JoinHandle, Thread from "std::thread";

function main(): i32 {
  let owned: String = String::create("hello");
  let text: str = owned.toStr();
  let handle: JoinHandle<boolean> = Thread::spawn<boolean>((): boolean -> {
      return text == "hello";
    });

  handle.join();

  return 0;
}
