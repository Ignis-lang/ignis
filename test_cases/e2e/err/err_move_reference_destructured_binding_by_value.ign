// e2e: err
@implements(Drop)
record Payload {
    public value: i32;

    drop(&mut self): void {
        return;
    }
}

enum Source {
    SOME(Payload),
    NONE,
}

function takeFromBorrow(src: &Source): Payload {
    return match (src) {
        Source::SOME(payload) -> payload,
        Source::NONE -> @panic("none"),
    };
}

function main(): i32 {
    let source: Source = Source::SOME(Payload { value: 42 });
    let taken: Payload = takeFromBorrow(&source);
    return taken.value;
}
