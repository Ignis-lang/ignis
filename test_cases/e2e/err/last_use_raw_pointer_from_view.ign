// e2e: err
//
// A raw pointer to a view carries the view: the owner stays borrowed while the
// pointer, or a record holding it, can still be read.
record RawRec {
  public p: *str;
}

function consume(text: str): void {
  return;
}

function pointer(): void {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let place: *str = (&text) as *str;
  owned.pushChar('d');
  consume(@read<str>(place));
}

function inRecord(): void {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let rec: RawRec = RawRec { p: (&text) as *str };
  owned.pushChar('d');
  consume(@read<str>(rec.p));
}

function mutablePointer(): void {
  let mut owned: String = String::create("abc");
  let mut text: str = owned.toStr();
  let place: *mut str = (&mut text) as *mut str;
  owned.pushChar('d');
  consume(@read<str>(place));
}

function main(): i32 {
  pointer();
  inRecord();
  mutablePointer();
  return 0;
}
