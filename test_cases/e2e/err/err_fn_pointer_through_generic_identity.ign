// e2e: err
// A closure value passed through a generic identity keeps its closure type,
// so the result does not convert to a function pointer.
function identity<T>(value: T): T {
  return value;
}

function main(): i32 {
  let offset: i32 = 3;
  let closure: () -> i32 = (): i32 -> offset;
  let pointer: fn() -> i32 = identity(closure);

  return pointer();
}
