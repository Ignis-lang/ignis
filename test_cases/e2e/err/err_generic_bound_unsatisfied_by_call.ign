// e2e: err
// A type argument has to satisfy every bound of the parameter it binds, both
// when the call writes it and when the call infers it from an argument. A
// record satisfies a trait bound only by declaring `@implements`; having the
// method is not enough.
trait Weigh {
  weigh(&self): i32;
}

record Stone {
  public grams: i32;

  weigh(&self): i32 {
    return self.grams;
  }
}

function total<T: Weigh>(value: &T): i32 {
  return value.weigh();
}

function main(): i32 {
  let stone: Stone = Stone { grams: 20 };
  let written: i32 = total<Stone>(&stone);
  let inferred: i32 = total(&stone);

  return written + inferred;
}
