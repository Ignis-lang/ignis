// e2e: err
// An extension implementing a trait has to be declared in the module that
// declares the trait or the one that declares the type. A primitive has no
// declaring module, so only the trait's module may extend it.
import Shape, Square from "./trait_extension_outside_owning_module/shapes";

@implements(Shape)
extension i64 {
  area(&self): i64 {
    return *self;
  }
}

@implements(Shape)
extension Square {
  area(&self): i64 {
    return self.side * self.side;
  }
}

function main(): i32 {
  return 0;
}
