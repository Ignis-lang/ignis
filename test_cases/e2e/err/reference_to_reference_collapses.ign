// e2e: err
//
// `& &T` is `&T`: a reference to a reference collapses, so dereferencing it
// twice dereferences the record itself.
record Point {
  public p: i32;
}

function main(): i32 {
  let mut point: Point = Point { p: 1 };
  let mut reference: &mut Point = &mut point;
  let outer: &mut &mut Point = &mut reference;
  (**outer).p = 7;
  return point.p;
}
