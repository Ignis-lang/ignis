// e2e: err
//
// A thread-local starts each thread at a value fixed at compile time, the same
// rule as any `static mut`: its initializer is a constant expression, or it is
// absent and the type has a zero value.

function compute(): i32 {
  return 3;
}

record Slots {
  @threadLocal
  static mut COUNT: i32 = compute();

  @threadLocal
  static mut NAME: str;
}

function main(): i32 {
  return Slots::COUNT;
}
