// e2e: err
// The implementing static method must match the trait signature, with `Self`
// replaced by the implementing type: parameter count, parameter types and
// return type are each checked.
trait Make {
  static make(seed: i32): Self;

  static count(): i32;

  static label(code: i32): i32;
}

@implements(Make)
record Box {
  public content: i32;

  static make(seed: i32): i32 {
    return seed;
  }

  static count(extra: i32): i32 {
    return extra;
  }

  static label(code: boolean): i32 {
    return 0;
  }
}

function main(): i32 {
  return 0;
}
