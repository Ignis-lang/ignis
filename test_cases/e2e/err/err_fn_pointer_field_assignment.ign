// e2e: err
// Assigning a capturing closure to a `fn` field is rejected like any other
// conversion of a capturing closure to a function pointer.
record Holder {
  public operation: fn() -> i32;
}

function zero(): i32 {
  return 0;
}

function main(): i32 {
  let offset: i32 = 3;
  let mut holder: Holder = Holder { operation: zero };

  holder.operation = (): i32 -> offset;

  return holder.operation();
}
