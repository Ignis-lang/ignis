// e2e: err
//
// Enum variants in patterns are reached through `::`. A bare payload variant name is an
// unknown variant, and the scrutinee gets no record-destructure error on top of it.
enum Shape {
    CIRCLE(i32),
    EMPTY,
}

function area(shape: Shape): i32 {
    return match (shape) {
        CIRCLE(radius) -> radius,
        Shape::EMPTY -> 0,
    };
}

function main(): i32 {
    return area(Shape::CIRCLE(3));
}
