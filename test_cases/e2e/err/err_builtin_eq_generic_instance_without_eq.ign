// e2e: err
// A generic `@eq<T>` is judged once `T` is known. Instantiating it with a
// record that does not implement `Eq` is rejected at the comparison, naming
// the concrete type.
record Plain {
  x: i32;
}

function same<T>(left: &T, right: &T): boolean {
  return @eq<T>(left, right);
}

function main(): i32 {
  let one: i32 = 1;
  let a: Plain = Plain { x: 1 };
  let b: Plain = Plain { x: 1 };

  if (same<i32>(&one, &one) && same<Plain>(&a, &b)) {
    return 1;
  }

  return 0;
}
