// e2e: err
//
// A view of a local declared in an inner block is stored into a binding of the outer
// block, which outlives the local.

function consume(text: str): void {
  return;
}

function main(): i32 {
  let mut text: str = "";

  {
    let owned: String = String::create("abc");
    text = owned.toStr();
  }

  consume(text);
  return 0;
}
