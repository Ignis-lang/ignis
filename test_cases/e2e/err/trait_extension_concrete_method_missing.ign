// e2e: err
// The methods of a block for the instance Vector<u8> belong to Vector<u8>
// only: Vector<i32> does not have them.
trait Describe {
  describe(&self): i64;
}

@implements(Describe)
extension Vector<u8> {
  describe(&self): i64 {
    return self.length() as i64;
  }
}

function main(): i32 {
  let numbers: Vector<i32> = Vector::new<i32>();
  return numbers.describe() as i32;
}
