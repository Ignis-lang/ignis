// e2e: err
// A capture made by a closure nested inside the converted closure is a
// capture of the converted closure too.
function main(): i32 {
  let offset: i32 = 3;
  let pointer: fn() -> i32 = (): i32 -> {
    let inner: () -> i32 = (): i32 -> offset;
    return inner();
  };

  return pointer();
}
