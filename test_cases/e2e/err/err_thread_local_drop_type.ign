// e2e: err
//
// Nothing runs when a thread exits, so a thread-local whose value runs a drop
// would never be torn down.

@implements(Drop)
record Handle {
  public id: i32;

  public drop(&mut self): void {
    return;
  }
}

record Holder {
  public handle: Handle;
}

record Slots {
  @threadLocal
  static mut HANDLE: Handle = Handle { id: 1 };

  @threadLocal
  static mut HOLDER: Holder = Holder { handle: Handle { id: 2 } };

  @threadLocal
  static mut ZEROED: Handle;
}

function main(): i32 {
  return 0;
}
