// e2e: err
// A type alias declared in a namespace is reached from outside only by its
// path, in a signature and in a body alike.
namespace Geometry {
  type Length = i32;
}

function double(value: Length): i32 {
  let size: Length = value;
  return size * 2;
}

function main(): i32 {
  return double(2);
}
