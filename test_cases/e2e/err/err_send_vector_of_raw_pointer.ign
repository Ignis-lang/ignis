// e2e: err
// `Vector<T>` declares Send and Sync without bounds on `T`, so an instance is
// Send only when its argument is: `Vector<*mut i32>` is not.
function send<T: Send>(value: T): i32 {
  return 1;
}

function main(): i32 {
  let pointers: Vector<*mut i32> = Vector::new<*mut i32>();

  return send<Vector<*mut i32>>(pointers);
}
