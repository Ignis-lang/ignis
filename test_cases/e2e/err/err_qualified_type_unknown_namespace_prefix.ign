// e2e: err
//
// A qualified type annotation whose leading segment names no namespace is an
// undefined type, even when a top-level type with the last segment's name exists.
// Signatures and local annotations are both checked.

record Top {
    y: i32;
}

function read(value: Nope::Top): i32 {
    return value.y;
}

function main(): i32 {
    let value: Nope::Top = Top { y: 2 };
    return value.y;
}
