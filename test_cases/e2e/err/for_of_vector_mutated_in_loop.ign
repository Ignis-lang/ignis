// e2e: err
//
// The iterable of a `for ... of` stays borrowed for the whole loop: the loop
// reads its element pointer once, so growing or clearing it in the body is
// rejected, through a local or a `&mut` parameter.
function grow(numbers: &mut Vector<i32>): void {
  for (let n of numbers) {
    numbers.push(n);
  }
}

function main(): i32 {
  let mut numbers: Vector<i32> = Vector::new<i32>();
  numbers.push(1);
  for (let n of numbers) {
    numbers.push(n);
  }
  grow(&mut numbers);
  for (let n of numbers) {
    numbers.clear();
  }
  return 0;
}
