// e2e: err
@implements(Drop)
record Payload {
    public value: i32;

    drop(&mut self): void {
        return;
    }
}

record Holder {
    public payload: Payload;

    intoPayload(self): Payload {
        return self.payload;
    }
}

function steal(holder: &Holder): Payload {
    return holder.intoPayload();
}

function main(): i32 {
    let holder: Holder = Holder { payload: Payload { value: 1 } };
    return steal(&holder).value;
}
