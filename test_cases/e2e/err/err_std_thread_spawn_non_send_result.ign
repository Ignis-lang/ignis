// e2e: err
// The result of a spawned task moves to the joining thread, so it has to be
// Send; an `Rc` is not.
import JoinHandle, Thread from "std::thread";
import Rc from "std::rc";

function main(): i32 {
  let handle: JoinHandle<Rc<i32>> = Thread::spawn<Rc<i32>>((): Rc<i32> -> Rc::new<i32>(1));
  let result: Rc<i32> = handle.join();

  return *result.get();
}
