// e2e: err
@implements(Drop)
record Owned {
    public id: i32;

    drop(&mut self): void {
        return;
    }
}

record Wrapper {
    public item: Owned;
}

function main(): i32 {
    let value: Owned = Owned { id: 1 };
    let wrapped: Wrapper = Wrapper { item: value };
    let again: Owned = value;
    return 0;
}
