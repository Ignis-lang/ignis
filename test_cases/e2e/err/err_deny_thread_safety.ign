// e2e: err
// `@deny(thread_safety)` turns the warning about an unchecked
// `@implements(Send)` into an error.
@deny(thread_safety)
@implements(Send)
record Handle {
  public raw: *mut i32;
}

function main(): i32 {
  let handle: Handle = Handle { raw: 0 as *mut i32 };

  if (handle.raw == 0 as *mut i32) {
    return 0;
  }

  return 1;
}
