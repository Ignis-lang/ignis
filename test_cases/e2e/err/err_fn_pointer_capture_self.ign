// e2e: err
// A closure that reads `self` captures it and cannot become a function pointer.
record Counter {
  public value: i32;

  get(&self): fn() -> i32 {
    return (): i32 -> self.value;
  }
}

function main(): i32 {
  let counter: Counter = Counter { value: 3 };
  let pointer: fn() -> i32 = counter.get();

  return pointer();
}
