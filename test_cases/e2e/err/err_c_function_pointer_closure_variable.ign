// e2e: err
extern LibC {
  function qsort(base: *mut u8, count: u64, size: u64, compare: (*u8, *u8) -> i32): void;
}

function main(): i32 {
  let mut values: i32[2] = [2, 1];
  let compare: (*u8, *u8) -> i32 = (left: *u8, right: *u8): i32 -> *(left as *i32) - *(right as *i32);

  LibC::qsort((&mut values[0]) as *mut u8, 2, 4, compare);

  return values[0];
}
