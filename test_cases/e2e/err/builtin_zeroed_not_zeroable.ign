// e2e: err
//
// `@zeroed<T>()` builds a value with every byte zero, so `T` must have a zero
// value, and the builtin takes one type argument and no value arguments.
@implements(Drop)
record Handle {
  public id: i32;

  public drop(&mut self): void {
    return;
  }
}

enum Shape {
  CIRCLE(i32),
  EMPTY,
}

function main(): i32 {
  let name: str = @zeroed<str>();
  let handle: Handle = @zeroed<Handle>();
  let shape: Shape = @zeroed<Shape>();
  let link: &i32 = @zeroed<&i32>();
  let extra: i32 = @zeroed<i32>(1);
  let missing: i32 = @zeroed();

  return 0;
}
