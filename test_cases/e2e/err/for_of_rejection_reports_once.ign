// e2e: err
//
// A rejected `for ... of` reports its own error once: the loop body's uses of
// the binding add no internal-sounding A0053, and an argument error inside a
// template literal is not repeated once per overload level.
import Io from "std::io";

function length(text: &String): u64 {
  return text.length();
}

function main(): i32 {
  let count: u64 = 3;
  for (let item of count) {
    Io::println(`${item}`);
  }
  Io::println(`${length(count)}`);
  return 0;
}
