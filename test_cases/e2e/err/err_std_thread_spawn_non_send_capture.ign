// e2e: err
// `Thread::spawn` takes its task as `@sendable`: a closure capturing a raw
// pointer, which is not Send, is rejected at the call.
import JoinHandle, Thread from "std::thread";

function main(): i32 {
  let mut base: i32 = 2;
  let pointer: *mut i32 = &mut base as *mut i32;
  let mut handle: JoinHandle<i32> = Thread::spawn<i32>((): i32 -> *pointer);

  return handle.join();
}
