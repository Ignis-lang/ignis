// e2e: err
// A reference is a view, so `Vector<&i32>` is rejected: the vector keeps its
// elements in heap storage it owns, where the referent's frame is not visible.
function main(): i32 {
  let value: i32 = 7;
  let mut list: Vector<&i32> = Vector::new<&i32>();
  list.push(&value);
  return 0;
}
