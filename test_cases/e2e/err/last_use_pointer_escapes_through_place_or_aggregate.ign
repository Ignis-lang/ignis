// e2e: err
//
// A raw pointer derived from a view and written into a place, or returned
// inside an aggregate, carries the view: the owner stays borrowed while that
// place or aggregate can still be read.
import CType from "std::libc";

extern Native {
  function puts(text: *u8): i32;
}

record CArgs {
  public name: *u8;
}

record Wrap {
  public p: CType::CConstStr;
}

record Holder {
  public text: str;

  public args(&self): CArgs {
    return CArgs { name: self.text as *u8 };
  }
}

enum Slot {
  EMPTY,
  FULL(*u8),
}

function makeArgs(text: str): CArgs {
  return CArgs { name: text as *u8 };
}

function maybe(text: str): Option<*u8> {
  return Option::SOME(text as *u8);
}

function wrap(text: str): Wrap {
  return Wrap { p: text as CType::CConstStr };
}

function fill(text: str): Slot {
  return Slot::FULL(text as *u8);
}

function callRecord(): void {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let args: CArgs = makeArgs(text);
  owned.pushChar('d');
  let _p: i32 = Native::puts(args.name);
}

function callRecordField(): void {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let pointer: *u8 = makeArgs(text).name;
  owned.pushChar('d');
  let _p: i32 = Native::puts(pointer);
}

function callRecordAssigned(): void {
  let mut owned: String = String::create("abc");
  let mut args: CArgs = CArgs { name: null };
  let text: str = owned.toStr();
  args = makeArgs(text);
  owned.pushChar('d');
  let _p: i32 = Native::puts(args.name);
}

function callOption(): void {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let found: Option<*u8> = maybe(text);
  owned.pushChar('d');
  if (let Option::SOME(p) = found) {
    let _p: i32 = Native::puts(p);
  }
}

function closureRecord(): void {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let get = (): CArgs -> {
    return CArgs { name: text as *u8 };
  };
  let args: CArgs = get();
  owned.pushChar('d');
  let _p: i32 = Native::puts(args.name);
}

function callAliasField(): void {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let w: Wrap = wrap(text);
  owned.pushChar('d');
  let _p: i32 = Native::puts(w.p as *u8);
}

function callEnum(): void {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let slot: Slot = fill(text);
  owned.pushChar('d');
  match (slot) {
    Slot::FULL(p) -> {
      let _p: i32 = Native::puts(p);
    },
    _ -> {},
  };
}

function methodRecord(): void {
  let mut owned: String = String::create("abc");
  let holder: Holder = Holder { text: owned.toStr() };
  let args: CArgs = holder.args();
  owned.pushChar('d');
  let _p: i32 = Native::puts(args.name);
}

function assignLocal(): void {
  let mut owned: String = String::create("abc");
  let mut pointer: *u8 = null;
  let text: str = owned.toStr();
  pointer = text as *u8;
  owned.pushChar('d');
  let _p: i32 = Native::puts(pointer);
}

function assignInBlock(): void {
  let mut owned: String = String::create("abc");
  let mut pointer: *u8 = null;
  let text: str = owned.toStr();
  {
    pointer = text as *u8;
  }
  owned.pushChar('d');
  let _p: i32 = Native::puts(pointer);
}

function assignInIf(): void {
  let mut owned: String = String::create("abc");
  let mut pointer: *u8 = null;
  let text: str = owned.toStr();
  if (owned.length() > 0) {
    pointer = text as *u8;
  }
  owned.pushChar('d');
  let _p: i32 = Native::puts(pointer);
}

function assignInLoop(): void {
  let mut owned: String = String::create("abc");
  let mut pointer: *u8 = null;
  let text: str = owned.toStr();
  while (true) {
    pointer = text as *u8;
    break;
  }
  owned.pushChar('d');
  let _p: i32 = Native::puts(pointer);
}

function assignField(): void {
  let mut owned: String = String::create("abc");
  let mut args: CArgs = CArgs { name: null };
  let text: str = owned.toStr();
  args.name = text as *u8;
  owned.pushChar('d');
  let _p: i32 = Native::puts(args.name);
}

function assignFieldThroughReference(): void {
  let mut owned: String = String::create("abc");
  let mut holder: CArgs = CArgs { name: null };
  let text: str = owned.toStr();
  let slot: &mut CArgs = &mut holder;
  slot.name = text as *u8;
  owned.pushChar('d');
  let _p: i32 = Native::puts(holder.name);
}

function assignThroughReference(): void {
  let mut owned: String = String::create("abc");
  let mut pointer: *u8 = null;
  let text: str = owned.toStr();
  let slot: &mut *u8 = &mut pointer;
  *slot = text as *u8;
  owned.pushChar('d');
  let _p: i32 = Native::puts(pointer);
}

function main(): i32 {
  callRecord();
  callRecordField();
  callRecordAssigned();
  callOption();
  closureRecord();
  callAliasField();
  callEnum();
  methodRecord();
  assignLocal();
  assignInBlock();
  assignInIf();
  assignInLoop();
  assignField();
  assignFieldThroughReference();
  assignThroughReference();
  return 0;
}
