// e2e: err
//
// `value.callback()` calls a function-typed field as well as a method, so a
// record cannot declare both under one name.
record Holder {
  public callback: () -> i32;

  public callback(&self): i32 {
    return 0;
  }
}

function main(): i32 {
  let holder: Holder = Holder { callback: (): i32 -> 1 };

  return (holder.callback)();
}
