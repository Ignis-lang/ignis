// e2e: err
record Counter {
    public value: i32;

    add(&mut self, amount: i32): i32 {
        self.value = self.value + amount;
        return self.value;
    }
}

record Holder {
    public counter: Counter;
}
record Outer {
    public holder: Holder;
}

function main(): i32 {
    let outer: Outer = Outer { holder: Holder { counter: Counter { value: 1 } } };
    return outer.holder.counter.add(2);
}
