// e2e: err
// A generic extension block applies only where the type arguments satisfy the
// bounds of its own type parameters: Option<boolean> does not have the block's
// method.
trait Describe {
  describe(&self): i64;
}

@implements(Describe)
extension<T: Describe> Option<T> {
  describe(&self): i64 {
    return match (self) {
      Option::SOME(inner) -> inner.describe(),
      Option::NONE -> 0,
    };
  }
}

function main(): i32 {
  let some: Option<boolean> = Option::SOME(true);
  return some.describe() as i32;
}
