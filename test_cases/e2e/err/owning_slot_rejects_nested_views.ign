// e2e: err
// Nesting a container inside itself does not hide a view: `Vector<Vector<str>>`
// and `Option<Option<&i32>>` repeat the same generic definition with different
// type arguments, and the view at the bottom makes every level a view. Neither
// can fill an `@owns` slot.
record Slot<@owns T> {
  public value: T;
}

function keepRows(slot: Slot<Vector<Vector<str>>>): u64 {
  return slot.value.length();
}

function keepRefs(slot: Slot<Option<Option<&i32>>>): i32 {
  return 0;
}

function main(): i32 {
  return 0;
}
