// e2e: err
// Using a generic record whose self-reference grows its type arguments reports the
// declaration once and does not crash or hang the passes that walk the type.
import Channel from "std::sync";

record Nest<T> {
  public value: T;
  public inner: Vector<Nest<Vector<T>>>;
}

function main(): i32 {
  let nest: Nest<i32> = Nest<i32> { value: 1, inner: Vector::new<Nest<Vector<i32>>>() };
  let channel: Channel<Nest<i32>> = Channel::new<Nest<i32>>();

  return nest.value;
}
