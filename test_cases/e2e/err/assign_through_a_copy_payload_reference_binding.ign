// e2e: err
//
// The same rule for a payload that needs no drop. Whether the write is rejected is the
// scrutinee's business, not the payload type's: accepting it here wrote to a copy and
// the referent never saw it, which is worse than refusing.

enum Box {
  N(i32),
}

function main(): i32 {
  let mut boxed: Box = Box::N(1);

  match (&mut boxed) {
    Box::N(payload) -> {
      payload = 99;
    },
  };

  return match (boxed) {
    Box::N(payload) -> payload,
  };
}
