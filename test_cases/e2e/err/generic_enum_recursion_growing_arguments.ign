// e2e: err
// A generic enum whose payload reaches the enum with a growing type argument is
// rejected at the variant, as is one that grows through another generic type.

enum Tree<T> {
  LEAF(T),
  NODE(Vector<Tree<*T>>),
}

record Holder<U> {
  public items: Vector<Chain<*U>>;
}

enum Chain<T> {
  END,
  LINK(Holder<T>),
}

function main(): i32 {
  return 0;
}
