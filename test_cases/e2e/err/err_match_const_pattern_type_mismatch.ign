// e2e: err
// A constant pattern compares against its value, so the constant has to fit
// the type being matched: a negative `i32` cannot match a `u64`, and a `str`
// cannot match an integer.
const NEGATIVE: i32 = -1;

const NAME: str = "ready";

namespace Limits {
  const NEGATIVE: i32 = -1;
}

function classify(state: u64): u64 {
  return match (state) {
    NEGATIVE -> 1,
    NAME -> 2,
    Limits::NEGATIVE -> 3,
    _ -> 4,
  };
}

function main(): i32 {
  return classify(1) as i32;
}
