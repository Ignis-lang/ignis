// e2e: err
// A namespace nested in another is a member like any other: from outside the
// enclosing namespace, a path has to start at the enclosing one.
namespace Outer {
  namespace Inner {
    function twice(value: i32): i32 {
      return value * 2;
    }
  }
}

function main(): i32 {
  return Inner::twice(2);
}
