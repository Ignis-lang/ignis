// e2e: err
// `join` consumes the handle, so joining it a second time uses a moved value.
import JoinHandle, Thread from "std::thread";

function main(): i32 {
  let handle: JoinHandle<i32> = Thread::spawn<i32>((): i32 -> 6 * 7);
  let first: i32 = handle.join();

  return first + handle.join();
}
