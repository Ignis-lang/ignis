// e2e: err
// A closure bound to `Sync` may run on several threads at once, so it may not
// mutate what it captures, even when the captured value is itself Sync.
function spawnSync<F: Sync>(@noescape task: F): i32 {
  return 1;
}

function main(): i32 {
  let mut count: i32 = 0;

  return spawnSync((): void -> {
    count += 1;
  });
}
