// e2e: err
// A captured parameter is judged like a captured local: a raw pointer
// parameter captured by a Send closure is rejected.
function spawn<F: Send>(task: F): i32 {
  return 1;
}

function run(pointer: *mut i32): i32 {
  return spawn((): i32 -> *pointer);
}

function main(): i32 {
  let mut base: i32 = 2;

  return run(&mut base as *mut i32);
}
