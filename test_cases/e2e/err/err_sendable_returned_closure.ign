// e2e: err
// A closure returned by a call carries no record of its captures at the call.
function spawn(@sendable task: () -> i32): i32 {
  return task();
}
function make(pointer: *mut i32): () -> i32 {
  return (): i32 -> *pointer;
}
function main(): i32 {
  let mut base: i32 = 7;
  let pointer: *mut i32 = &mut base as *mut i32;
  return spawn(make(pointer));
}
