// e2e: err
// A closure bound through a reference scrutinee is borrowed from the `Option`
// that owns it, so returning it by value moves out of a borrowed value.
function make(base: i32): Option<(i32) -> i32> {
  return Option::SOME((x: i32): i32 -> x + base);
}

function take(maybe: &Option<(i32) -> i32>): (i32) -> i32 {
  let Option::SOME(f) = maybe else {
    return (x: i32): i32 -> x;
  };

  return f;
}

function main(): i32 {
  let maybe = make(1);
  let f = take(&maybe);

  return f(41);
}
