// e2e: err
record Counter {
    public value: i32;

    add(&mut self, amount: i32): i32 {
        self.value = self.value + amount;
        return self.value;
    }
}

record Holder {
    public counter: Counter;
}
function main(): i32 {
    let holder: Holder = Holder { counter: Counter { value: 1 } };
    return holder.counter.add(2);
}
