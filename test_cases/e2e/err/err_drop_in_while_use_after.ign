// e2e: err
@implements(Drop)
record Resource {
    public tag: i32;

    drop(&mut self): void {
        return;
    }
}

function main(): i32 {
    let mut r: Resource = Resource { tag: 1 };
    let mut i: i32 = 0;
    while (i < 1) {
        r.drop();
        i = i + 1;
    }
    return r.tag;
}
