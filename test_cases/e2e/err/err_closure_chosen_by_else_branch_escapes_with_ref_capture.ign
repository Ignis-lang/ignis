// e2e: err
function makeCounter(flag: boolean): () -> i32 {
    let mut count: i32 = 0;
    let chosen = flag ? (): i32 -> 0 : (): i32 -> {
        count = count + 1;
        return count;
    };

    return chosen;
}

function main(): i32 {
    let counter = makeCounter(false);
    return counter();
}
