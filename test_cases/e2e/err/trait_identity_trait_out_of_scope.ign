// e2e: err
// `Named` is declared inside `A`. Outside that namespace the bare name is not
// in scope, in `@implements` or in a bound, even though it is the only trait
// of that name; it has to be written `A::Named`.
namespace A {
  trait Named {
    first(&self): i32;
  }
}

@implements(Named)
record OnlyFirst {
  public value: i32;

  first(&self): i32 {
    return self.value;
  }
}

function useFirst<T: Named>(value: &T): i32 {
  return 0;
}

function main(): i32 {
  let onlyFirst: OnlyFirst = OnlyFirst { value: 1 };
  return onlyFirst.first();
}
