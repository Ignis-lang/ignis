// e2e: err
//
// Enum variants in patterns are reached through `::`. A bare name equal to a variant of the
// scrutinee's enum would bind a new variable that matches everything, so it is rejected.
enum Shape {
    CIRCLE(i32),
    EMPTY,
}

function area(shape: Shape): i32 {
    return match (shape) {
        Shape::CIRCLE(radius) -> radius,
        EMPTY -> 0,
    };
}

function main(): i32 {
    return area(Shape::CIRCLE(3));
}
