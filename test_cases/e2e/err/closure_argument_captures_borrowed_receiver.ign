// e2e: err
//
// A closure passed to a call cannot capture a local the call already
// borrows: the receiver of a `&mut self` method, or a `&mut` argument.
function run(values: &mut Vector<i32>, @noescape action: () -> void): void {
  action();
  values.push(1);
}

function main(): i32 {
  let mut values: Vector<String> = Vector::new<String>();
  values.push(String::create("b"));
  values.push(String::create("a"));
  values.sort((a: &String, b: &String): i32 -> {
    let _gone: Option<String> = values.pop();
    return 1;
  });
  let mut numbers: Vector<i32> = Vector::new<i32>();
  run(&mut numbers, (): void -> {
    numbers.push(2);
  });
  return 0;
}
