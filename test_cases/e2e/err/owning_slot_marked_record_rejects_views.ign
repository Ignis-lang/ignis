// e2e: err
// A type parameter marked `@owns` is an owning storage slot: the record keeps
// the argument in storage it allocates, where the type system cannot see whose
// bytes a view borrows. A `str` is a view, and so is a record with a `str`
// field, so neither can fill the slot.
record Slot<@owns T> {
  public value: T;
}

record Label {
  public text: str;
  public weight: i32;
}

function keepText(slot: Slot<str>): u64 {
  return slot.value.length();
}

function keepLabel(slot: Slot<Label>): i32 {
  return slot.value.weight;
}

function main(): i32 {
  return 0;
}
