// e2e: err
// Registers and immediates hold integers and pointers only.
record Pair {
  public first: u64;
  public second: u64;
}

function main(): i32 {
  let ratio: f64 = 1.5;
  let pair: Pair = Pair { first: 1, second: 2 };

  asm (ratio in reg) { nop }
  asm (pair in rax) { nop }
  asm () -> (result: f64 in rax) { nop }

  return 0;
}
