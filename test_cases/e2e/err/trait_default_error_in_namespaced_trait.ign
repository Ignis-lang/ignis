// e2e: err
// A trait default declared in a namespace and named by its path in
// `@implements` is checked once against the trait: an error in it is reported
// once, and one only an implementing type hits names that type.
namespace Shapes {
  trait Measured {
    area(&self): i32;

    flagged(&self): boolean {
      let flag: boolean = self.area();
      return flag;
    }

    doubled(&self): i32 {
      let area: i32 = self.area();
      return area * 2;
    }
  }
}

@implements(Shapes::Measured)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side;
  }
}

@implements(Shapes::Measured)
record Flag {
  public set: boolean;

  area(&self): boolean {
    return self.set;
  }
}

function main(): i32 {
  let square: Square = Square { side: 2 };
  let flag: Flag = Flag { set: true };

  if (square.flagged() && flag.flagged()) {
    return square.doubled() + flag.doubled();
  }

  return 0;
}
