// e2e: err
//
// Tuples are not values, so a tuple literal scrutinee is destructured element by
// element. A name standing for a whole inner tuple has nothing to hold; accepting it made
// the arm silently never match.
function inner(x: i32, y: i32, z: i32): i32 {
  return match ((x, (y, z))) {
    (a, pair) -> a,
  };
}

function main(): i32 {
  return inner(1, 2, 3);
}
