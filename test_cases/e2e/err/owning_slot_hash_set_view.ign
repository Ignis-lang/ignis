// e2e: err
// `HashSet<T>` delegates to `HashMap<T, _>`, so its element slot is `@owns`:
// a `str` member outlives its owner because the set cannot see it.
import HashSet from "std::collections";

function main(): i32 {
  let mut set: HashSet<str> = HashSet::new<str>();
  {
    let owner: String = String::create("member");
    set.insert(owner.toStr());
  }
  return set.length() as i32;
}
