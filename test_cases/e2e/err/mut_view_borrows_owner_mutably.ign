// e2e: err
//
// A live `&mut T` or `Option<&mut T>` view holds a mutable borrow of its
// owner: reading the owner while it is still used is rejected.
import Io from "std::io";

function getMutThenGet(): void {
  let mut list: Vector<String> = Vector::new<String>();
  list.push(String::create("first"));
  let first: Option<&mut String> = list.getMut(0);
  let other: Option<&String> = list.get(0);
  if (let Option::SOME(item) = first) {
    item.pushStr("!");
  }
  if (let Option::SOME(item) = other) {
    Io::println(item.toStr());
  }
}

function main(): i32 {
  getMutThenGet();
  return 0;
}
