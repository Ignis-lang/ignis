// e2e: err
// A generic extension block implements its trait only where the type
// arguments satisfy the bounds of its own type parameters: Option<boolean>
// does not satisfy a bound on the trait.
trait Describe {
  describe(&self): i64;
}

@implements(Describe)
extension<T: Describe> Option<T> {
  describe(&self): i64 {
    return match (self) {
      Option::SOME(inner) -> inner.describe(),
      Option::NONE -> 0,
    };
  }
}

function describe<T: Describe>(value: &T): i64 {
  return value.describe();
}

function main(): i32 {
  let some: Option<boolean> = Option::SOME(true);
  return describe<Option<boolean>>(&some) as i32;
}
