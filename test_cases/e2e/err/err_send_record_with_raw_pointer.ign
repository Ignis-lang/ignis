// e2e: err
// A record is Send only when every field is Send. A raw pointer is neither
// Send nor Sync, so a record holding one cannot bind a `Send` bound.
record Handle {
  public raw: *mut i32;
}

function send<T: Send>(value: T): i32 {
  return 1;
}

function main(): i32 {
  let handle: Handle = Handle { raw: 0 as *mut i32 };

  return send(handle);
}
