// e2e: err
@implements(Drop)
record Resource {
    public tag: i32;

    drop(&mut self): void {
        return;
    }
}

function consume(r: Resource): i32 {
    return r.tag;
}

function main(): i32 {
    let r: Resource = Resource { tag: 42 };
    let x: i32 = consume(r);
    return consume(r);
}
