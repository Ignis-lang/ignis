// e2e: err
// A closure nested in another one is judged at the call it is passed to,
// with the captures it takes from the enclosing closure.
function spawn<F: Send>(task: F): i32 {
  return 1;
}

function main(): i32 {
  let mut base: i32 = 2;
  let pointer: *mut i32 = &mut base as *mut i32;
  let outer: () -> i32 = (): i32 -> spawn((): i32 -> *pointer);

  return outer();
}
