// e2e: warn
// Declaring `@implements(Send)` on a record whose fields are not Send is
// allowed, but warned about: the compiler can no longer check the claim.
@implements(Send)
record Handle {
  public raw: *mut i32;
}

function main(): i32 {
  let handle: Handle = Handle { raw: 0 as *mut i32 };

  if (handle.raw == 0 as *mut i32) {
    return 0;
  }

  return 1;
}
