// e2e: err
//
// Grouping a place does not make its address name a global either. A
// parenthesized reference target is not an lvalue, which the typechecker
// rejects (A0029), and the constant-address rule adds its own diagnostic on
// the same place.

function base(): u64 {
  return 7;
}

const K: u64 = base();

function main(): i32 {
  let p: *u64 = &(K) as *u64;
  return *p as i32;
}
