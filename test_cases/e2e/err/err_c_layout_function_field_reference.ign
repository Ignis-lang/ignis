// e2e: err
// A shared borrow of a function-typed field of a @cLayout record is rejected
// too: it would point at a temporary closure rather than at the field.
@cLayout
record Table {
  public first: (i32) -> i32;
}

function addOne(value: i32): i32 {
  return value + 1;
}

function main(): i32 {
  let table: Table = Table { first: addOne };
  let first = &table.first;

  let copy: (i32) -> i32 = *first;

  return copy(1);
}
