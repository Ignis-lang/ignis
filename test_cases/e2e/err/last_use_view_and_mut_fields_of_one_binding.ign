// e2e: err
//
// Two operands that are both fields of the binding holding the view still hand
// the callee a `&mut` place next to the view.
record Pair {
  public text: str;
  public slot: &mut str;

  public flush(&self): void {
    *self.slot = self.text;
  }
}

function consume(text: str): void {
  return;
}

function store(target: &mut str, text: str): void {
  *target = text;
}

function fields(): void {
  let mut owned: String = String::create("abc");
  let mut slot: str = "";
  let text: str = owned.toStr();
  let pair: Pair = Pair { text: text, slot: &mut slot };
  store(pair.slot, pair.text);
  owned.pushChar('d');
  consume(slot);
}

function main(): i32 {
  fields();
  return 0;
}
