// e2e: err
// Dereferencing a reference by value copies the referent's bytes out of
// storage the reference does not own. For a type that needs a drop, both the
// referent and the copy would free the same buffers, so the move is rejected.
import Vector from "std::vector";

record Shape {
  params: Vector<u32>;
}

function main(): i32 {
  let mut params: Vector<u32> = Vector::new<u32>();
  params.push(7);
  let shape: Shape = Shape { params: params };
  let reference: &Shape = &shape;
  let copy: Shape = *reference;

  return copy.params.length() as i32;
}
