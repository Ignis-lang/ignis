// e2e: err
//
// A reference to a temporary lives only as long as the statement that made
// it: keeping it in a local or returning it is rejected.
function make(): String {
  return String::create("made");
}

function kept(): u64 {
  let view: &String = &make();
  return view.length();
}

function returned(): &String {
  return &make();
}

function main(): i32 {
  kept();
  returned();
  return 0;
}
