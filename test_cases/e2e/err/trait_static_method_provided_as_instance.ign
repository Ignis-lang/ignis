// e2e: err
// The trait requires a static method; an instance method of the same name
// does not satisfy it.
trait Make {
  static make(): Self;
}

@implements(Make)
record Box {
  public content: i32;

  make(&self): Box {
    return Box { content: self.content };
  }
}

function main(): i32 {
  return 0;
}
