// e2e: err
// An error in a default of a trait another module declares, that every
// implementing type hits the same way, is reported once, at the trait's file.
import Shape from "./trait_default_cross_module_error_shared/shapes";

@implements(Shape)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

@implements(Shape)
record Line {
  public length: i32;

  area(&self): i32 {
    return self.length;
  }
}

function main(): i32 {
  let square: Square = Square { side: 2 };
  let line: Line = Line { length: 3 };

  if (square.flagged() && line.flagged()) {
    return 1;
  }

  return 0;
}
