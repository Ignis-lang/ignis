// e2e: err
// Declarable attributes do not apply to extension blocks: neither @attribute nor a record-targeted attribute.
@attribute(record)
record Table {
  public name: str;
}

trait Describe {
  describe(&self): i64;
}

@Table("numbers")
@implements(Describe)
extension i64 {
  describe(&self): i64 {
    return *self;
  }
}

@attribute(record)
@implements(Describe)
extension str {
  describe(&self): i64 {
    return 1;
  }
}

function main(): i32 {
  return 0;
}
