// e2e: err
// Two inputs or two outputs cannot share a register, a clobber cannot name an
// operand's register, and a clobber is named once.
function main(): i32 {
  let first: u64 = 1;
  let second: u64 = 2;

  asm (first in rax, second in rax) { nop }
  asm () -> (low: u32 in eax, other: u64 in rax) { nop }
  asm (first in rcx) clobber(rcx) { nop }
  asm () clobber(memory, memory) { nop }

  return 0;
}
