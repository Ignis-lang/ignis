// e2e: err
@implements(Drop)
record Owned {
    public id: i32;

    drop(&mut self): void {
        return;
    }
}

enum MaybeOwned {
    Some(Owned),
    None,
}

function main(): i32 {
    let value: Owned = Owned { id: 1 };
    let wrapped: MaybeOwned = MaybeOwned::Some(value);
    let again: Owned = value;
    return 0;
}
