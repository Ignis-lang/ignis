// e2e: err
// A closure held in a variable carries no record of what it captured, so it
// cannot be passed to a `@sendable` parameter.
function spawn(@sendable task: () -> i32): i32 {
  return task();
}

function main(): i32 {
  let base: i32 = 2;
  let task: () -> i32 = (): i32 -> base;

  return spawn(task);
}
