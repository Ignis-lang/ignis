// e2e: err
// A bound has to name a trait in scope: `Unknown` names nothing, and `Point`
// names a record.
record Point {
  public x: i32;
}

function unknown<T: Unknown>(value: &T): i32 {
  return 0;
}

function notATrait<T: Point>(value: &T): i32 {
  return 0;
}

function main(): i32 {
  let point: Point = Point { x: 1 };
  return unknown<Point>(&point) + notATrait<Point>(&point);
}
