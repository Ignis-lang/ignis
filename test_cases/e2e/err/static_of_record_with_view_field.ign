// e2e: err
// A record with a `str` field is a view type (S2), so a `static` of that
// record type is rejected (S3): the static would outlive the owner the field
// borrows. A `static str` field would not make the record a view.
record Config {
  static DEFAULT: Label = Label { text: "idle" };
}

record Label {
  public text: str;
}

function same(left: str, right: str): boolean {
  return left == right;
}

function main(): i32 {
  let current: Label = Config::DEFAULT;

  if (same(current.text, "idle")) {
    return 1;
  }

  return 0;
}
