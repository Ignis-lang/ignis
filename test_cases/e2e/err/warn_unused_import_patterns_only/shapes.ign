// e2e: skip helper module of e2e::warn_unused_import_patterns_only: alone it has no main and cannot link; it runs through the entry fixture
export namespace Shapes {
  export enum Kind {
    CIRCLE,
    SQUARE(i32),
  }

  export function square(side: i32): Kind {
    return Kind::SQUARE(side);
  }
}

export function square(side: i32): Shapes::Kind {
  return Shapes::square(side);
}

export function maybeSquare(side: i32): Option<Shapes::Kind> {
  return Option::SOME(Shapes::square(side));
}

export namespace Unused {
  export const ZERO: i32 = 0;
}
