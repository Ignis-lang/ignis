// e2e: err
function makeCounter(flag: boolean): () -> i32 {
    let mut count: i32 = 0;
    let chosen = match (flag) {
        true -> (): i32 -> {
            count = count + 1;
            return count;
        },
        false -> (): i32 -> 0,
    };

    return chosen;
}

function main(): i32 {
    let counter = makeCounter(true);
    return counter();
}
