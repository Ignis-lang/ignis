// e2e: err
// `break` and `continue` cannot leave or skip an unrolled `comptime for`; a
// loop inside its body keeps its own.
record Pair {
  public a: i32;
  public b: i32;

  public first(&self): i32 {
    let mut result: i32 = 0;

    comptime for (field of @fields<Self>()) {
      result = @field(self, field);
      break;
    }

    comptime for (field of @fields<Self>()) {
      if (field.index == 0) {
        continue;
      }

      while (true) {
        break;
      }
    }

    return result;
  }
}

function main(): i32 {
  return 0;
}
