// e2e: err
// A type parameter marked `@owns` on a generic function is an owning storage
// slot too: instantiating it with a view type is rejected, so a generic
// forwarder cannot smuggle a view into storage that owns.
import Vector from "std::vector";

function intoVector<@owns T>(value: T): Vector<T> {
  let mut list: Vector<T> = Vector::new<T>();
  list.push(value);

  return list;
}

function main(): i32 {
  let text: String = String::create("hello");
  let list: Vector<str> = intoVector<str>(text.toStr());

  return list.length() == 1 ? 0 : 1;
}
