// e2e: warn
// An arm that names a constant covers only that value, so a match made of
// constant arms alone still needs a wildcard arm.
const READY: u64 = 1;

const RUNNING: u64 = 2;

function classify(state: u64): u64 {
  return match (state) {
    READY -> 10,
    RUNNING -> 20,
  };
}

function main(): i32 {
  return classify(READY) as i32;
}
