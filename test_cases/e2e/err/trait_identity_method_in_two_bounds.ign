// e2e: err
// Both bounds of `T` declare a method named `name`, so `value.name()` could
// mean either one.
namespace A {
  trait Named {
    name(&self): i32;
  }
}

namespace B {
  trait Named {
    name(&self): i32;
  }
}

@implements(A::Named, B::Named)
record Both {
  public value: i32;

  name(&self): i32 {
    return self.value;
  }
}

function useBoth<T: A::Named & B::Named>(value: &T): i32 {
  return value.name();
}

function main(): i32 {
  let both: Both = Both { value: 3 };
  return useBoth<Both>(&both);
}
