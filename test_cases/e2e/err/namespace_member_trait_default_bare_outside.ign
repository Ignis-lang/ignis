// e2e: err
// A namespaced trait with a default method, named bare from outside: the only
// error is the path to write, not a missing inherited method.
namespace Shapes {
  trait Sized {
    side(&self): i32;

    area(&self): i32 {
      return self.side() * 2;
    }
  }
}

@implements(Sized)
record Square {
  public length: i32;

  side(&self): i32 {
    return self.length;
  }
}

function main(): i32 {
  let square: Square = Square { length: 2 };
  return square.area();
}
