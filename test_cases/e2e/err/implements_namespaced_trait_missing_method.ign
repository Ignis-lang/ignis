// e2e: err
// The record names the namespaced trait by its path but does not declare the
// trait's required method.
namespace Shapes {
  trait Measured {
    area(&self): i32;
  }
}

@implements(Shapes::Measured)
record Square {
  public side: i32;
}

function measure<T: Shapes::Measured>(value: &T): i32 {
  return value.area();
}

function main(): i32 {
  let square: Square = Square { side: 3 };
  return measure<Square>(&square);
}
