// e2e: err
//
// Items are declared at module or namespace level only. A function, record, enum or
// type alias in a function body is rejected by the parser with a diagnostic that names
// the rule, instead of a generic "Expected expression".

function main(): i32 {
    function helper(): i32 {
        return 1;
    }

    record Point {
        x: i32;
    }

    return 0;
}
