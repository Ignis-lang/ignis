// e2e: err
// `@implements` names no trait. The attribute itself is the error, even
// though nothing requires the record to satisfy a bound.
@implements(Unknown)
record Square {
  public side: i32;
}

namespace Shapes {}

@implements(Shapes::Missing)
record Circle {
  public radius: i32;
}

function main(): i32 {
  let square: Square = Square { side: 3 };
  let circle: Circle = Circle { radius: 2 };
  return square.side + circle.radius;
}
