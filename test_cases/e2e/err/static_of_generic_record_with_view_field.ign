// e2e: err
// A `static` of a generic record whose declared field is a `str` is a view
// (S2) even when its type argument is not, so it is rejected (S3).
record Tagged<T> {
  public value: T;
  public text: str;
}

record Config {
  static DEFAULT: Tagged<i32> = Tagged { value: 1, text: "idle" };
}

function main(): i32 {
  return Config::DEFAULT.value;
}
