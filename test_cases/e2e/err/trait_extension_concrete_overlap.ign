// e2e: err
// A block for the instance Option<i64> overlaps a generic block for every
// Option<T> implementing the same trait: Option<i64> would implement it twice.
trait Describe {
  describe(&self): i64;
}

@implements(Describe)
extension<T> Option<T> {
  describe(&self): i64 {
    return 0;
  }
}

@implements(Describe)
extension Option<i64> {
  describe(&self): i64 {
    return 1;
  }
}

function main(): i32 {
  return 0;
}
