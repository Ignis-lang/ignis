// e2e: err
// The language traits and the canonical Eq and Hash are not implemented
// through an extension: the compiler answers them from the type itself.
@implements(Clone)
extension i64 {
  clone(&self): i64 {
    return *self;
  }
}

@implements(Eq)
extension str {
  equals(&self, other: &str): boolean {
    return true;
  }
}

function main(): i32 {
  return 0;
}
