// e2e: err
// `T::make` resolves only through the bounds of `T`. An unrelated record with a
// static method of the same name must not be picked.
trait Other {
  other(&self): i32;
}

record Factory {
  public unused: i32;

  static make(): i32 {
    return 1;
  }
}

function build<T: Other>(): i32 {
  return T::make();
}

function main(): i32 {
  return 0;
}
