// e2e: err
//
// A view written through a raw-pointer sink keeps its borrow to the end of
// the scope: the bytes outlive the statement wherever the pointer points.
import String from "std::string";

function main(): i32 {
  let mut owned: String = String::create("abc");
  let mut text: str = owned.toStr();
  let place: *mut str = (&mut text) as *mut str;
  @write<str>(place, text);
  owned.pushChar('d');

  return 0;
}
