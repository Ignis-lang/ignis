// e2e: err
// `@implements` names a record through a namespace path. A record is not a
// trait, so the attribute names no trait (A0142).
namespace Shapes {
  trait Measured {
    area(&self): i32;
  }

  record Measure {
    public value: i32;
  }
}

@implements(Shapes::Measure)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

function measure<T: Shapes::Measured>(value: &T): i32 {
  return value.area();
}

function main(): i32 {
  let square: Square = Square { side: 3 };
  return measure<Square>(&square);
}
