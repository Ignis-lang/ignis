// e2e: err
//
// A copy of a view carries the borrow: the owner stays borrowed while the copy lives.
function consume(text: str): void {
  return;
}

function main(): i32 {
  let mut owned: String = String::create("abc");
  let text: str = owned.toStr();
  let copy: str = text;
  owned.pushChar('d');
  consume(copy);
  return 0;
}
