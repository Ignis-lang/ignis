// e2e: err
//
// A subobject address of a nonconstant static is the same stack copy: only a
// constant initializer seeds the read-only global the element address would
// name.

function base(): u64 {
  return 7;
}

record Table {
  static ROWS: u64[4] = [base(), base(), base(), base()];
}

function main(): i32 {
  let p: *u64 = &Table::ROWS[1] as *u64;
  return *p as i32;
}
