// e2e: err
@extension(i32, mut)
function increment(value: i32): i32 {
    return value + 1;
}

record Holder {
    public value: i32;
}

function read(holder: &Holder): i32 {
    return holder.value.increment();
}

function main(): i32 {
    let holder: Holder = Holder { value: 5 };
    return read(&holder);
}
