// e2e: err
// A location is a register asm can name or one of the classes reg, mem and
// imm; the stack and frame pointers are not available.
function main(): i32 {
  let value: u64 = 1;

  asm (value in xmm0) { nop }
  asm (value in rsp) { nop }
  asm () -> (result: u64 in stack) { nop }
  asm () clobber(rbp) { nop }
  asm () clobber(everything) { nop }

  return 0;
}
