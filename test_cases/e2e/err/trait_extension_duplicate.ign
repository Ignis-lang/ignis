// e2e: err
// A type implements a trait once: a second extension, or an extension of a
// record that already names the trait in @implements, is rejected.
trait Shape {
  area(&self): i64;
}

@implements(Shape)
record Square {
  public side: i64;

  area(&self): i64 {
    return self.side * self.side;
  }
}

@implements(Shape)
extension i64 {
  area(&self): i64 {
    return *self;
  }
}

@implements(Shape)
extension i64 {
  area(&self): i64 {
    return 0;
  }
}

@implements(Shape)
extension Square {
  area(&self): i64 {
    return 0;
  }
}

function main(): i32 {
  return 0;
}
