// e2e: err
// A closure passed where a Send function is expected is judged by what it
// captures: a raw pointer captured by value is not Send.
function spawn<F: Send>(task: F): i32 {
  return 1;
}

function main(): i32 {
  let mut base: i32 = 2;
  let pointer: *mut i32 = &mut base as *mut i32;

  return spawn((): i32 -> *pointer);
}
