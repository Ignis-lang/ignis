// e2e: err
@implements(Drop)
record Owned {
    public id: i32;

    drop(&mut self): void {
        return;
    }
}

enum MaybeOwned {
    Some(Owned),
    None,
}

function main(): i32 {
    let value: MaybeOwned = MaybeOwned::Some(Owned { id: 1 });

    let extracted: Owned = match (value) {
        MaybeOwned::Some(inner) -> inner,
        MaybeOwned::None -> Owned { id: 0 },
    };

    let again: MaybeOwned = value;
    return 0;
}
