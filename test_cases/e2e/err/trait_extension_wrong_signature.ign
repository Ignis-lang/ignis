// e2e: err
// Methods of an extension are checked against the trait like a record's: the
// same kind, and a static signature with Self read as the extended type.
trait Shape {
  area(&self): i64;

  static unit(): Self;
}

@implements(Shape)
extension i64 {
  static area(): i64 {
    return 0;
  }

  static unit(): i32 {
    return 1;
  }
}

function main(): i32 {
  return 0;
}
