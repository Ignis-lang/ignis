// e2e: err
// A static trait method belongs to the type, so it cannot be called through a
// value, neither of the concrete type nor of a bounded type parameter.
trait Make {
  static make(): Self;
}

@implements(Make)
record Box {
  public content: i32;

  static make(): Box {
    return Box { content: 1 };
  }
}

function remake<T: Make>(value: &T): T {
  return value.make();
}

function main(): i32 {
  let item: Box = Box { content: 2 };
  let again: Box = item.make();
  return again.content;
}
