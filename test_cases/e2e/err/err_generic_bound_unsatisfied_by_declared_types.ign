// e2e: err
// Enum payloads, static fields, generic owners' own parameters and the
// parameter and return types of a function no one calls are checked against
// the bounds of the generic they instantiate.
trait Weigh {
  weigh(&self): i32;
}

record Plain {
  public grams: i32;
}

record Scale<T: Weigh> {
  public item: T;
}

enum Slot {
  FULL(Scale<Plain>),
  EMPTY,
}

record Shelf {
  static mut spare: *Scale<Plain>;
}

record Wrapper<U> {
  public scale: Scale<U>;
}

function inspect(scale: &Scale<Plain>): i32 {
  return 0;
}

function nothing(): *Scale<Plain> {
  return null;
}

function main(): i32 {
  return 0;
}
