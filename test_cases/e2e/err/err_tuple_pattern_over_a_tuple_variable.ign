// e2e: err
//
// A tuple is taken apart element by element only where it is written as a literal. A
// tuple held in a variable has no elements to destructure; accepting the pattern bound
// nothing and failed in the C compiler.
function sum(x: i32, y: i32): i32 {
  let both = (x, y);

  return match (both) {
    (a, b) -> a + b,
  };
}

function main(): i32 {
  return sum(1, 2);
}
