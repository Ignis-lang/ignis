// e2e: err
//
// Every qualifier segment has to match the namespace the type is declared in:
// skipping a level, naming the wrong namespace, or prefixing an extra one is rejected.

namespace Outer {
    namespace Inner {
        record Point {
            x: i32;
        }
    }
}

record Top {
    y: i32;
}

function main(): i32 {
    let skipped: Outer::Point = Outer::Inner::Point { x: 1 };
    let wrong: Outer::Top = Top { y: 2 };
    let extra: Bogus::Outer::Inner::Point = Outer::Inner::Point { x: 3 };
    return skipped.x + wrong.y + extra.x;
}
