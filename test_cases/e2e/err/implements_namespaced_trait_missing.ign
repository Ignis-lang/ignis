// e2e: err
// `@implements` names a path with no trait behind it, which is an error at
// the attribute (A0142).
namespace Shapes {
  trait Measured {
    area(&self): i32;
  }
}

@implements(Shapes::Missing)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

function measure<T: Shapes::Measured>(value: &T): i32 {
  return value.area();
}

function main(): i32 {
  let square: Square = Square { side: 3 };
  return measure<Square>(&square);
}
