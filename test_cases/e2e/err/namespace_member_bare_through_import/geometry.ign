// e2e: skip helper module of e2e::namespace_member_bare_through_import: alone it has no main and cannot link; it runs through the entry fixture
export namespace Geometry {
  export const UNIT: i32 = 10;

  export record Point {
    public x: i32;
  }

  export function area(side: i32): i32 {
    return side * side + UNIT;
  }
}
