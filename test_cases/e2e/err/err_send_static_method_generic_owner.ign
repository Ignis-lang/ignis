// e2e: err
// A static method of a generic record binds the record's type parameters,
// so its `Send` bound is checked like a function's.
record Queue<T: Send> {
  public value: T;

  wrap(value: T): Queue<T> {
    return Queue { value: value };
  }
}

record Handle {
  public raw: *mut i32;
}

function main(): i32 {
  let queue: Queue<Handle> = Queue::wrap<Handle>(Handle { raw: 0 as *mut i32 });

  if (queue.value.raw == 0 as *mut i32) {
    return 0;
  }

  return 1;
}
