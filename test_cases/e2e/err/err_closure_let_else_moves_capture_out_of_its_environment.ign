// e2e: err
// A `let else` over a captured value by value moves its payload out of the
// closure's environment, which the next call would find gone.
@implements(Drop)
record Tracked {
  public id: i32;

  drop(&mut self): void {
    return;
  }
}

enum Slot {
  FULL(Tracked),
  EMPTY,
}

function consume(value: Tracked): i32 {
  return value.id;
}

function makeConsumer(): () -> i32 {
  let slot: Slot = Slot::FULL(Tracked { id: 4 });

  return (): i32 -> {
    let _ = @move slot;

    let Slot::FULL(inner) = slot else {
      return 0;
    };

    return consume(inner);
  };
}

function main(): i32 {
  let consumer = makeConsumer();

  return consumer();
}
