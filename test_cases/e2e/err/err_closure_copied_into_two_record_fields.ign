// e2e: err
// Storing a closure that owns a heap environment into a record field moves it,
// so storing the same binding into a second field uses a moved value.
record Pair {
    public left: (i32) -> i32;
    public right: (i32) -> i32;
}

function makePair(base: i32): Pair {
    let add = (x: i32): i32 -> x + base;

    return Pair { left: add, right: add };
}

function main(): i32 {
    let pair = makePair(20);
    let left = pair.left;

    return left(1);
}
