// e2e: err
// `@fields` walks the fields of the record `Self` names: a type parameter,
// a primitive type and the `Self` of an enum have none.
record Holder<T> {
  public value: T;

  public walk(&self): i32 {
    let mut count: i32 = 0;

    comptime for (field of @fields<T>()) {
      count += 1;
    }

    comptime for (field of @fields<i32>()) {
      count += 1;
    }

    return count;
  }
}

enum Light {
  ON,
  OFF,

  count(&self): i32 {
    let mut count: i32 = 0;

    comptime for (field of @fields<Self>()) {
      count += 1;
    }

    return count;
  }
}

function main(): i32 {
  return 0;
}
