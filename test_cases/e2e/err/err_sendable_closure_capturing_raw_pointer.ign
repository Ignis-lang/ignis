// e2e: err
// A closure passed to a `@sendable` parameter is judged by what it captures:
// a raw pointer captured by value is not Send.
function spawn(@sendable task: () -> i32): i32 {
  return task();
}

function main(): i32 {
  let mut base: i32 = 2;
  let pointer: *mut i32 = &mut base as *mut i32;

  return spawn((): i32 -> *pointer);
}
