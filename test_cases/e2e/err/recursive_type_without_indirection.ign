// e2e: err
//
// A record or enum that holds a value of itself inline has no finite size. Each one is
// reported once, whether the cycle is direct, goes through a generic payload, or runs
// through another type.

record Direct {
  next: Direct;
}

record ThroughOption {
  next: Option<ThroughOption>;
}

record First {
  second: Second;
}

record Second {
  first: First[2];
}

enum Chain {
  LINK(Chain),
  END,
}

record Node<T> {
  value: T;
  next: Option<Node<T>>;
}

function main(): i32 {
  return 0;
}
