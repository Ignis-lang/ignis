// e2e: err
//
// A view stored into a `&mut T` binding holds a mutable borrow of its owner, so even a
// shared use of the owner is rejected while the view is alive.
record Counter {
  public value: i32;

  public valueMut(&mut self): &mut i32 {
    return &mut self.value;
  }

  public read(&self): i32 {
    return self.value;
  }
}

function main(): i32 {
  let mut counter: Counter = Counter { value: 1 };
  let slot: &mut i32 = counter.valueMut();
  let seen: i32 = counter.read();

  *slot = seen + 1;
  return 0;
}
