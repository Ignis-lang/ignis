// e2e: err
// The record implements both `A::Named` and `B::Named`. It declares every
// method `A::Named` requires but not the one `B::Named` requires.
namespace A {
  trait Named {
    first(&self): i32;
  }
}

namespace B {
  trait Named {
    second(&self): i32;
  }
}

@implements(A::Named, B::Named)
record Both {
  public value: i32;

  first(&self): i32 {
    return self.value;
  }
}

function main(): i32 {
  let both: Both = Both { value: 1 };
  return both.first();
}
