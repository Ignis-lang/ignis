// e2e: err
// `@eq` compares through `&T`, `@read` and `@write` access a `*mut T`, and
// `@write` stores a `T`: a value of another shape is rejected instead of being
// read as an address at run time.
function main(): i32 {
  let mut value: u64 = 5;
  let pointer: *mut u64 = (&mut value) as *mut u64;

  if (@eq<u64>(value, 5)) {
    return 1;
  }

  let copy: u64 = @read<u64>(value);
  @write<u64>(pointer, true);
  @write<u64>(&mut value, 1);

  return copy as i32;
}
