// e2e: err
//
// A reference into the result of a call that hands an owned value back is kept past
// the statement that created it.
import Arc from "std::sync";

record Counter {
  public value: i32;
}

function share(counter: Arc<Counter>): Arc<Counter> {
  return counter;
}

function main(): i32 {
  let counter: Arc<Counter> = Arc::new<Counter>(Counter { value: 7 });
  let state: &Counter = share(counter).get();

  return state.value;
}
