// e2e: err
// A block for the instance Vector<u8> implements the trait for Vector<u8>
// only: Vector<i32> does not satisfy the bound.
trait Describe {
  describe(&self): i64;
}

@implements(Describe)
extension Vector<u8> {
  describe(&self): i64 {
    return self.length() as i64;
  }
}

function describe<T: Describe>(value: &T): i64 {
  return value.describe();
}

function main(): i32 {
  let numbers: Vector<i32> = Vector::new<i32>();
  return describe<Vector<i32>>(&numbers) as i32;
}
