// e2e: err
function makeCounter(mode: i32): () -> i32 {
    let mut count: i32 = 0;
    let chosen = match (mode) {
        0 -> (): i32 -> 0,
        1 -> (): i32 -> 1,
        _ -> (): i32 -> {
            count = count + 1;
            return count;
        },
    };

    return chosen;
}

function main(): i32 {
    let counter = makeCounter(2);
    return counter();
}
