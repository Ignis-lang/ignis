// e2e: err
// The copy of the loop body for a field whose type misses the bound of a
// generic helper reports the bound error, with a note naming the field.
trait Describe {
  describe(&self): i32;
}

record Tag {
  public value: i32;
}

@implements(Describe)
extension i32 {
  describe(&self): i32 {
    return *self;
  }
}

function describeType<T: Describe>(): i32 {
  return 1;
}

trait Summary {
  summary(&self): i32 {
    let mut sum: i32 = 0;

    comptime for (field of @fields<Self>()) {
      sum += describeType<@fieldType(field)>();
    }

    return sum;
  }
}

@implements(Summary)
record Item {
  public count: i32;
  public tag: Tag;
}

function main(): i32 {
  let item: Item = Item { count: 1, tag: Tag { value: 2 } };
  return item.summary();
}
