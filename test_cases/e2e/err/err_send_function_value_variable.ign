// e2e: err
// A function value held in a variable carries no record of what it captured,
// so it cannot be judged Send and is rejected.
function spawn<F: Send>(task: F): i32 {
  return 1;
}

function main(): i32 {
  let base: i32 = 2;
  let task: () -> i32 = (): i32 -> base;

  return spawn(task);
}
