// e2e: err
// A view is neither Send nor Sync: a `T: Sync` bound lets callers share the
// argument by reference across threads, which would outlive the owner the view
// borrows from, exactly as sending it would.
function share<T: Sync>(value: &T): i32 {
  return 1;
}

function main(): i32 {
  let owned: String = String::create("hello");
  let text: str = owned.toStr();

  return share(&text);
}
