// e2e: err
// A shared reference `&T` is Send only when `T` is Sync: sending it lets two
// threads read the same value. A record with a raw pointer field is not Sync.
record Cell {
  public value: *mut i32;
}

function send<T: Send>(value: T): i32 {
  return 1;
}

function main(): i32 {
  let cell: Cell = Cell { value: 0 as *mut i32 };

  return send(&cell);
}
