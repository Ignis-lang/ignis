// e2e: err
// An undefined type in a trait default's signature is reported once, not once
// more for every type that inherits the default.
trait Shape {
  area(&self): i32;

  described(&self): Missing {
    return self.area();
  }
}

@implements(Shape)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

@implements(Shape)
record Line {
  public length: i32;

  area(&self): i32 {
    return self.length;
  }
}

function main(): i32 {
  return 0;
}
