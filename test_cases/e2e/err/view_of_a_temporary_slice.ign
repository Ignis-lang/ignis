// e2e: err
//
// A slice a method returns views its receiver, so keeping a slice of a temporary
// vector past its statement is rejected.
import Vector from "std::vector";

function makeVector(): Vector<i32> {
  let mut values: Vector<i32> = Vector::new<i32>();
  values.push(1);
  return values;
}

function main(): i32 {
  let values: i32[] = makeVector().toSlice();

  return values[0];
}
