// e2e: err
// A record and an enum name a trait bare in `@implements` but do not declare
// its required method; the method with a default body is not required.
trait Measured {
  area(&self): i32;

  sides(&self): i32 {
    return 4;
  }
}

@implements(Measured)
record Square {
  public side: i32;
}

@implements(Measured)
enum Shape {
  POINT,
}

function main(): i32 {
  let square: Square = Square { side: 3 };
  return square.side;
}
