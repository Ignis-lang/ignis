// e2e: err
// A pipe call passes its left side as the first argument, and that argument
// is judged like any other.
function spawn<F: Send>(task: F): i32 {
  return 1;
}

function main(): i32 {
  let mut base: i32 = 2;
  let pointer: *mut i32 = &mut base as *mut i32;

  return ((): i32 -> *pointer) |> spawn;
}
