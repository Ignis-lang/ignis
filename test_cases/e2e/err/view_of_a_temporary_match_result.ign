// e2e: err
//
// A `match` that produces a view points wherever the arm that ran points: a view of a
// temporary made in an arm, or of a local declared inside an arm's block, must not be
// kept by a binding outside the match.
import Io from "std::io";

function main(): i32 {
  let value: i32 = 1;
  let first: str = match (value) {
    1 -> String::create("abc").toStr(),
    _ -> "",
  };
  let second: str = match (value) {
    1 -> {
      let owned: String = String::create("abc");
      owned.toStr()
    },
    _ -> "",
  };

  Io::println(first);
  Io::println(second);
  return 0;
}
