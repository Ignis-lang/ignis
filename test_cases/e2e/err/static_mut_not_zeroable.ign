// e2e: err
//
// A `static mut` field without an initializer starts zeroed, so its type must
// have a zero value: a string, a reference, a value that runs a drop and an
// enum with a payload have none, and neither does an array of them.
@implements(Drop)
record Handle {
  public id: i32;

  public drop(&mut self): void {
    return;
  }
}

enum Shape {
  CIRCLE(i32),
  EMPTY,
}

record Zeroed {
  static mut NAME: str;
  static mut LINK: &i32;
  static mut HANDLE: Handle;
  static mut SHAPE: Shape;
  static mut HANDLES: Handle[2];
}

function main(): i32 {
  return 0;
}
