// e2e: err
// An imm input is a constant, a mem input is a place, and an inout input is a
// place the asm may write.
const LIMIT: u64 = 8;

function next(): u64 {
  return 1;
}

function main(): i32 {
  let value: u64 = 1;
  let pointer: *u64 = (&value) as *u64;

  asm (LIMIT in imm) { nop }
  asm (value in imm) { nop }
  asm (next() in mem) { nop }
  asm (value inout rax) { nop }
  asm (*pointer inout mem) { nop }
  asm (next() inout rax) { nop }

  return 0;
}
