// e2e: err
// A generic record instance is judged with its type arguments substituted
// into its fields: `Box<Ptr>` is not Send because `Ptr` is not.
record Ptr {
  public raw: *mut i32;
}

record Box<T> {
  public value: T;
}

function send<T: Send>(value: T): i32 {
  return 1;
}

function main(): i32 {
  let boxed: Box<Ptr> = Box { value: Ptr { raw: 0 as *mut i32 } };

  return send(boxed);
}
