// e2e: err
// A type parameter satisfies a bound only when it declares that bound itself.
trait Weigh {
  weigh(&self): i32;
}

function total<T: Weigh>(value: &T): i32 {
  return value.weigh();
}

function forward<U>(value: &U): i32 {
  return total<U>(value);
}

function main(): i32 {
  return 0;
}
