// e2e: err
//
// A `str` view of a temporary `String` is kept by a `let`: the temporary is gone once
// the statement ends, so the view would point into freed storage.

function consume(text: str): void {
  return;
}

function main(): i32 {
  let text: str = String::create("abc").toStr();

  consume(text);
  return 0;
}
