// e2e: err
extern LibC {
  function qsort(base: *mut u8, count: u64, size: u64, compare: (*u8, *u8) -> i32): void;
}

function main(): i32 {
  let mut values: i32[2] = [2, 1];
  let direction: i32 = -1;

  LibC::qsort((&mut values[0]) as *mut u8, 2, 4, (left: *u8, right: *u8): i32 -> direction * (*(left as *i32) - *(right as *i32)));

  return values[0];
}
