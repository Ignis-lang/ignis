// e2e: err
// A shared reference is a view, and views are not `Send` (S3): a `&T` cannot
// cross a `Send` bound even when `T` itself could be shared.
record Point {
  public x: i32;
  public y: i32;
}

function send<T: Send>(value: T): i32 {
  return 1;
}

function main(): i32 {
  let point: Point = Point { x: 1, y: 2 };

  return send(&point);
}
