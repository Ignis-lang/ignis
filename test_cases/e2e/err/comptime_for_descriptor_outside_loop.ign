// e2e: err
// The reflection builtins that take a field descriptor only make sense
// inside the `comptime for` that declares it.
record Pair {
  public a: i32;

  public read(&self): i32 {
    let _value = @field(self, field);
    let _column: Option<Pair> = @attribute<Pair>(field);
    let _size: u64 = @sizeOf<@fieldType(field)>();
    return 0;
  }
}

function main(): i32 {
  return 0;
}
