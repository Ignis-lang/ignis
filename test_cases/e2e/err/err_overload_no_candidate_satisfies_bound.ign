// e2e: err
// A `boolean` matches neither the concrete `i64` candidate nor the bound of
// the generic one. With no candidate left, the call reports the bound the
// generic candidate's inferred type argument does not satisfy, not a missing
// overload.
trait Describe {
  describe(&self): i32;
}

function bind(value: i64): i32 {
  return 1;
}

function bind<T: Describe>(value: T): i32 {
  return value.describe();
}

function main(): i32 {
  return bind(true);
}
