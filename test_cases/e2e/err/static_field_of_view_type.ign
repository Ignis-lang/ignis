// e2e: err
// A view cannot be stored where the type system cannot see its owner (S3): a
// `static` outlives every owner a `str` could borrow, and a `static mut` of a
// view type would let any write hang a dead borrow off a global. A type alias
// is transparent: a `static` of an alias to a view is still a view.
record Labels {
  static mut CURRENT: str = "idle";
}

type Text = str;

record Aliased {
  static FALLBACK: Text = "none";
}

function main(): i32 {
  return 0;
}
