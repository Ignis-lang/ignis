// e2e: err
//
// A `static mut` field starts at a value fixed at compile time, so its
// initializer, and every element or field of an array or record literal one,
// has to be a constant expression.

record Tag {
  public magic: u64;
  public revision: u64;
}

function compute(): u64 {
  return 3;
}

record Tags {
  static mut COUNT: u64 = compute();
  static mut BASE: Tag = Tag { magic: 1, revision: compute() };
  static mut IDS: u64[2] = [1, compute()];
}

function main(): i32 {
  return (Tags::COUNT + Tags::BASE.revision + Tags::IDS[1]) as i32;
}
