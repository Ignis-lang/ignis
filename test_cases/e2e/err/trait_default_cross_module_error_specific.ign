// e2e: err
// A default of a trait another module declares, valid against the trait and
// for one implementing type but not for another, is reported once, at the
// trait's file, with a note naming that type.
import Shape from "./trait_default_cross_module_error_specific/shapes";

@implements(Shape)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

@implements(Shape)
record Flag {
  public set: boolean;

  area(&self): boolean {
    return self.set;
  }
}

function main(): i32 {
  let square: Square = Square { side: 2 };
  let flag: Flag = Flag { set: true };
  return square.doubled() + flag.doubled();
}
