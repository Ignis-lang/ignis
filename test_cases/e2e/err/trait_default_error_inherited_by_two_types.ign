// e2e: err
// An error in a trait default that does not depend on the implementing type is
// reported once, at the trait, however many types inherit the default.
trait Shape {
  area(&self): i32;

  flagged(&self): boolean {
    let flag: boolean = self.area();
    return flag;
  }
}

@implements(Shape)
record Square {
  public side: i32;

  area(&self): i32 {
    return self.side * self.side;
  }
}

@implements(Shape)
record Line {
  public length: i32;

  area(&self): i32 {
    return self.length;
  }
}

function main(): i32 {
  let square: Square = Square { side: 2 };
  let line: Line = Line { length: 3 };

  if (square.flagged() && line.flagged()) {
    return 1;
  }

  return 0;
}
