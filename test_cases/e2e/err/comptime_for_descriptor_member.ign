// e2e: err
// A field descriptor has `name` and `index`; any other member, or the
// descriptor used as an ordinary value, is rejected.
record Pair {
  public a: i32;

  public read(&self): i32 {
    comptime for (field of @fields<Self>()) {
      let size: i32 = field.size;
      let copy = field;
    }

    return 0;
  }
}

function main(): i32 {
  return 0;
}
