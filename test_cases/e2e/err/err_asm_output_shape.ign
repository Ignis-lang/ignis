// e2e: err
// A pure asm has outputs, an asm expression has at most one, and output names
// are unique.
function main(): i32 {
  asm pure () { nop }

  let both: u64 = asm () -> (first: u64 in rax, second: u64 in rbx) { nop };

  asm () -> (twice: u64 in rax, twice: u64 in rbx) { nop }

  return both as i32;
}
