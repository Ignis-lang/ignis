// e2e: err
// A generic record that declares `@implements(Send)` speaks only for its own
// fields: an instance is Send only when every type argument is Send, so
// `Box<*mut i32>` is not.
@implements(Send)
@allow(thread_safety)
record Box<T> {
  public value: T;
}

function send<T: Send>(value: T): i32 {
  return 1;
}

function main(): i32 {
  let mut base: i32 = 2;
  let boxed: Box<*mut i32> = Box { value: &mut base as *mut i32 };

  return send(boxed);
}
