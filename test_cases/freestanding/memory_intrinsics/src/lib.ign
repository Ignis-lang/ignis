// The generated code copies an array literal into its local and a value into
// a bit cast's target through the C memory functions. A freestanding unit has
// no <string.h> to declare them.
@panicHandler
function onPanic(message: str, file: str, line: u32): void {
  return;
}

@externName("freestanding_digit")
function digit(): u8 {
  let digits: u8[4] = [1, 2, 3, 4];

  return digits[3];
}

@externName("freestanding_bits")
function bits(value: f32): u32 {
  return @bitCast<u32>(value);
}
