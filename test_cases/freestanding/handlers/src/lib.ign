@panicHandler
function onPanic(message: str, file: str, line: u32): void {
  return;
}

@allocHandler
function allocate(size: u64, align: u64): *mut u8 {
  return @pointerFromInteger<*mut u8>(size + align);
}

@freeHandler
function release(pointer: *mut u8): void {
  return;
}

function makeAdder(base: i32): (i32) -> i32 {
  return (value: i32): i32 -> value + base;
}

@externName("kernel_sum")
function sum(base: i32, value: i32): i32 {
  let add = makeAdder(base);

  return add(value);
}

@externName("kernel_fail")
function fail(): void {
  @panic("boom");
}
