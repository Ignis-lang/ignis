// A statement call to a `never` function, and a named `void` function passed
// as a function value, compile in a freestanding unit.
@panicHandler
function onPanic(message: str, file: str, line: u32): void {
  return;
}

function stop(): never {
  while (true) {}
}

function apply(value: u8, sink: (u8) -> void): void {
  sink(value);
}

function ignore(value: u8): void {}

@externName("freestanding_stop")
function halt(): void {
  stop();
}

@externName("freestanding_apply")
function probe(): void {
  apply(1, ignore);
}
