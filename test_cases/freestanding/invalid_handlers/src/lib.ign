@panicHandler
function onPanic(message: str, file: str, line: u32): void {
  return;
}

@panicHandler
function onPanicAgain(message: str, file: str, line: u32): void {
  return;
}

@allocHandler
function allocate(size: u64, align: u64): *mut u8 {
  return @pointerFromInteger<*mut u8>(size + align);
}

@freeHandler
function release(pointer: *mut u8): i32 {
  return 0;
}
