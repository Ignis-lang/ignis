// An imported immutable constant or static field whose initializer does not
// fold has storage in no module: the defining module leaves it without a
// global and the importer cannot name one either. Taking its address across
// the module boundary is the same frame copy as taking it locally, while an
// imported constant that folds keeps its read-only global and stays
// addressable.

export function base(): u64 {
  return 7;
}

export const DYNAMIC: u64 = base();

export record Table {
  static VALUE: u64 = base();
}

export const FOLDED: u64 = 5;
