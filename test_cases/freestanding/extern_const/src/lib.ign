// A freestanding unit has no header to declare an extern constant, so it
// declares the constant itself, with its Ignis type.
extern Linker {
  const kernel_end: u64;
  const kernel_flags: u32;
  const kernel_page_tables: u64[4];
}

@panicHandler
@externName("freestanding_kernel_panic")
function onPanic(message: str, file: str, line: u32): void {
  return;
}

@externName("freestanding_kernel_end")
function kernelEnd(): u64 {
  return Linker::kernel_end + (Linker::kernel_flags as u64);
}

@externName("freestanding_kernel_end_ptr")
function kernelEndPtr(): *u64 {
  return &Linker::kernel_end as *u64;
}

@externName("freestanding_kernel_flags_ptr")
function kernelFlagsPtr(): *u32 {
  return &Linker::kernel_flags as *u32;
}

@externName("freestanding_kernel_page_tables_base_ptr")
function kernelPageTablesBasePtr(): *u64 {
  return &Linker::kernel_page_tables as *u64;
}

@externName("freestanding_kernel_page_table_ptr")
function kernelPageTablePtr(index: u64): *u64 {
  return &Linker::kernel_page_tables[index] as *u64;
}
