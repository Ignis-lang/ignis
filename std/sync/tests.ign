import
  Arc,
  AtomicBool,
  AtomicI64,
  AtomicPtr,
  AtomicU32,
  AtomicU64,
  Channel,
  Condvar,
  Mutex,
  MutexGuard,
  Ordering,
  Receiver,
  Sender,
  Shared,
  ThreadPool,
from "std::sync";
import JoinHandle, Thread from "std::thread";
import HashMap from "std::collections";
import RawAllocator from "std::memory";
import Test from "std::test";

/// The value an exchange that happened replaced.
function exchangedFrom(outcome: Result<u64, u64>): u64 {
  if (let Result::OK(previous) = outcome) {
    return previous;
  }

  Test::assert(false);
  return 0;
}

/// The value an exchange that did not happen observed.
function observedBy(outcome: Result<u64, u64>): u64 {
  if (let Result::ERROR(observed) = outcome) {
    return observed;
  }

  Test::assert(false);
  return 0;
}

@test
function atomicU64LoadsWithEveryLoadOrdering(): void {
  let counter: AtomicU64 = AtomicU64::new(7);

  Test::assertEq<u64>(counter.load(Ordering::RELAXED), 7);
  Test::assertEq<u64>(counter.load(Ordering::ACQUIRE), 7);
  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 7);
}

@test
function atomicU64StoresWithEveryStoreOrdering(): void {
  let counter: AtomicU64 = AtomicU64::new(0);

  counter.store(1, Ordering::RELAXED);
  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 1);

  counter.store(2, Ordering::RELEASE);
  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 2);

  counter.store(3, Ordering::SEQ_CST);
  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 3);
}

@test
function atomicU64SwapsWithEveryOrdering(): void {
  let counter: AtomicU64 = AtomicU64::new(0);

  Test::assertEq<u64>(counter.swap(1, Ordering::RELAXED), 0);
  Test::assertEq<u64>(counter.swap(2, Ordering::ACQUIRE), 1);
  Test::assertEq<u64>(counter.swap(3, Ordering::RELEASE), 2);
  Test::assertEq<u64>(counter.swap(4, Ordering::ACQ_REL), 3);
  Test::assertEq<u64>(counter.swap(5, Ordering::SEQ_CST), 4);
  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 5);
}

@test
function atomicU64FetchAddAndSubReturnThePreviousValue(): void {
  let counter: AtomicU64 = AtomicU64::new(10);

  Test::assertEq<u64>(counter.fetchAdd(1, Ordering::RELAXED), 10);
  Test::assertEq<u64>(counter.fetchAdd(1, Ordering::ACQUIRE), 11);
  Test::assertEq<u64>(counter.fetchAdd(1, Ordering::RELEASE), 12);
  Test::assertEq<u64>(counter.fetchAdd(1, Ordering::ACQ_REL), 13);
  Test::assertEq<u64>(counter.fetchAdd(1, Ordering::SEQ_CST), 14);
  Test::assertEq<u64>(counter.fetchSub(5, Ordering::SEQ_CST), 15);
  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 10);
}

@test
function atomicU64FetchSubWraps(): void {
  let counter: AtomicU64 = AtomicU64::new(0);

  counter.fetchSub(1, Ordering::RELAXED);
  Test::assertEq<u64>(counter.load(Ordering::RELAXED), 18446744073709551615);
}

@test
function atomicU64BitwiseOperationsReturnThePreviousValue(): void {
  let bits: AtomicU64 = AtomicU64::new(12);

  Test::assertEq<u64>(bits.fetchAnd(10, Ordering::ACQ_REL), 12);
  Test::assertEq<u64>(bits.fetchOr(1, Ordering::RELEASE), 8);
  Test::assertEq<u64>(bits.fetchXor(15, Ordering::ACQUIRE), 9);
  Test::assertEq<u64>(bits.load(Ordering::SEQ_CST), 6);
}

@test
function atomicU64CompareExchangeSucceedsOnExpectedValue(): void {
  let counter: AtomicU64 = AtomicU64::new(5);

  let outcome: Result<u64, u64> = counter.compareExchange(5, 6, Ordering::ACQ_REL, Ordering::ACQUIRE);

  Test::assertEq<u64>(exchangedFrom(outcome), 5);
  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 6);
}

@test
function atomicU64CompareExchangeFailsOnOtherValue(): void {
  let counter: AtomicU64 = AtomicU64::new(5);

  let outcome: Result<u64, u64> = counter.compareExchange(4, 9, Ordering::SEQ_CST, Ordering::SEQ_CST);

  Test::assertEq<u64>(observedBy(outcome), 5);
  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 5);
}

@test
function compareExchangeAcceptsEveryValidOrderingPair(): void {
  let counter: AtomicU64 = AtomicU64::new(0);
  let successes: Ordering[5] = [
    Ordering::RELAXED,
    Ordering::ACQUIRE,
    Ordering::RELEASE,
    Ordering::ACQ_REL,
    Ordering::SEQ_CST,
  ];
  let failures: Ordering[3] = [Ordering::RELAXED, Ordering::ACQUIRE, Ordering::SEQ_CST];
  let mut expected: u64 = 0;
  let mut successIndex: u64 = 0;

  while (successIndex < 5) {
    let mut failureIndex: u64 = 0;

    while (failureIndex < 3) {
      let success: Ordering = successes[successIndex];
      let failure: Ordering = failures[failureIndex];

      Test::assertEq<u64>(exchangedFrom(counter.compareExchange(expected, expected + 1, success, failure)), expected);
      Test::assertEq<u64>(observedBy(counter.compareExchange(expected, 99, success, failure)), expected + 1);

      expected += 1;
      failureIndex += 1;
    }

    successIndex += 1;
  }

  Test::assertEq<u64>(counter.load(Ordering::SEQ_CST), 15);
}

@test
function atomicU32WrapsAndExchanges(): void {
  let counter: AtomicU32 = AtomicU32::new(4294967295);

  Test::assertEq<u32>(counter.fetchAdd(1, Ordering::RELAXED), 4294967295);
  Test::assertEq<u32>(counter.load(Ordering::ACQUIRE), 0);

  counter.store(3, Ordering::RELEASE);
  Test::assertEq<u32>(counter.fetchSub(1, Ordering::ACQ_REL), 3);
  Test::assertEq<u32>(counter.fetchAnd(1, Ordering::SEQ_CST), 2);
  Test::assertEq<u32>(counter.fetchOr(4, Ordering::SEQ_CST), 0);
  Test::assertEq<u32>(counter.fetchXor(5, Ordering::SEQ_CST), 4);
  Test::assertEq<u32>(counter.swap(8, Ordering::SEQ_CST), 1);

  let exchanged: Result<u32, u32> = counter.compareExchange(8, 9, Ordering::SEQ_CST, Ordering::RELAXED);
  let rejected: Result<u32, u32> = counter.compareExchange(8, 10, Ordering::SEQ_CST, Ordering::RELAXED);

  Test::assert(exchanged.isOk());
  Test::assert(rejected.isError());
  Test::assertEq<u32>(counter.load(Ordering::SEQ_CST), 9);
}

@test
function atomicI64HandlesNegativeValues(): void {
  let counter: AtomicI64 = AtomicI64::new(-2);

  Test::assertEq<i64>(counter.fetchAdd(5, Ordering::SEQ_CST), -2);
  Test::assertEq<i64>(counter.fetchSub(10, Ordering::SEQ_CST), 3);
  Test::assertEq<i64>(counter.load(Ordering::SEQ_CST), -7);
  Test::assertEq<i64>(counter.fetchAnd(-1, Ordering::RELAXED), -7);
  Test::assertEq<i64>(counter.fetchOr(0, Ordering::RELAXED), -7);
  Test::assertEq<i64>(counter.fetchXor(-1, Ordering::RELAXED), -7);
  Test::assertEq<i64>(counter.load(Ordering::RELAXED), 6);
  Test::assertEq<i64>(counter.swap(-1, Ordering::ACQ_REL), 6);

  counter.store(-4, Ordering::RELEASE);

  let exchanged: Result<i64, i64> = counter.compareExchange(-4, 4, Ordering::ACQUIRE, Ordering::ACQUIRE);

  Test::assert(exchanged.isOk());
  Test::assertEq<i64>(counter.load(Ordering::ACQUIRE), 4);
}

@test
function atomicBoolSwapsStoresAndExchanges(): void {
  let flag: AtomicBool = AtomicBool::new(false);

  Test::assert(!flag.load(Ordering::RELAXED));
  Test::assert(!flag.swap(true, Ordering::ACQ_REL));
  Test::assert(flag.load(Ordering::ACQUIRE));

  flag.store(false, Ordering::RELEASE);
  Test::assert(!flag.load(Ordering::SEQ_CST));

  let taken: Result<boolean, boolean> = flag.compareExchange(false, true, Ordering::ACQUIRE, Ordering::RELAXED);
  let again: Result<boolean, boolean> = flag.compareExchange(false, true, Ordering::ACQUIRE, Ordering::RELAXED);

  Test::assert(taken.isOk());
  Test::assert(again.isError());
  Test::assert(flag.load(Ordering::SEQ_CST));
}

@test
function atomicPtrLoadsStoresSwapsAndExchanges(): void {
  let mut first: i32 = 1;
  let mut second: i32 = 2;
  let firstPointer: *mut i32 = (&mut first) as *mut i32;
  let secondPointer: *mut i32 = (&mut second) as *mut i32;
  let slot: AtomicPtr<i32> = AtomicPtr::new<i32>(null);

  Test::assert(slot.load(Ordering::ACQUIRE) == null);

  slot.store(firstPointer, Ordering::RELEASE);
  Test::assert(slot.load(Ordering::SEQ_CST) == firstPointer);
  Test::assert(slot.swap(secondPointer, Ordering::ACQ_REL) == firstPointer);

  let exchanged: Result<*mut i32, *mut i32> = slot.compareExchange(
    secondPointer,
    firstPointer,
    Ordering::SEQ_CST,
    Ordering::SEQ_CST,
  );
  let rejected: Result<*mut i32, *mut i32> = slot.compareExchange(
    secondPointer,
    null,
    Ordering::SEQ_CST,
    Ordering::SEQ_CST,
  );

  Test::assert(exchanged.isOk());
  Test::assert(rejected.isError());
  Test::assertEq<i32>(@read<i32>(slot.load(Ordering::RELAXED)), 1);
}

function requireSend<T: Send>(): boolean {
  return true;
}

function requireSync<T: Sync>(): boolean {
  return true;
}

@test
function owningCollectionsAreSendAndSync(): void {
  Test::assert(requireSend<String>());
  Test::assert(requireSync<String>());
  Test::assert(requireSend<Vector<String>>());
  Test::assert(requireSync<Vector<u64>>());
  Test::assert(requireSend<HashMap<u64, String>>());
}

@test
function syncPrimitivesAreSendAndSync(): void {
  Test::assert(requireSend<Mutex<Vector<u64>>>());
  Test::assert(requireSync<Mutex<u64>>());
  Test::assert(requireSend<Arc<Mutex<String>>>());
  Test::assert(requireSync<Arc<u64>>());
  Test::assert(requireSync<Condvar>());
}

@test
function mutexGuardWritesThroughToTheValue(): void {
  let mutex: Mutex<u64> = Mutex::new<u64>(1);

  {
    let mut guard: MutexGuard<u64> = mutex.lock();
    let value: &mut u64 = guard.get();

    *value += 41;
  }

  let guard: MutexGuard<u64> = mutex.lock();

  Test::assertEq<u64>(*guard.read(), 42);
}

@test
function mutexTryLockFailsWhileLocked(): void {
  let mutex: Mutex<u64> = Mutex::new<u64>(0);

  {
    let _guard: MutexGuard<u64> = mutex.lock();

    Test::assert(mutex.tryLock().isNone());
  }

  Test::assert(mutex.tryLock().isSome());
}

@test
function mutexDropsAnOwnedValue(): void {
  let mutex: Mutex<String> = Mutex::new<String>(String::create("owned"));
  let guard: MutexGuard<String> = mutex.lock();

  Test::assertEq<u64>(guard.read().length(), 5);
}

@test
function arcCountsClonesAndSharesTheValue(): void {
  let first: Arc<String> = Arc::new<String>(String::create("shared"));

  Test::assertEq<u64>(first.strongCount(), 1);

  {
    let second: Arc<String> = first.clone();

    Test::assertEq<u64>(second.strongCount(), 2);
    Test::assertEq<u64>(second.get().length(), 6);
  }

  Test::assertEq<u64>(first.strongCount(), 1);
}

@test
function arcMutexCounterAcrossThreads(): void {
  let counter: Arc<Mutex<u64>> = Arc::new<Mutex<u64>>(Mutex::new<u64>(0));
  let mut handles: Vector<JoinHandle<boolean>> = Vector::new<JoinHandle<boolean>>();
  let mut index: u64 = 0;

  while (index < 4) {
    let shared: Arc<Mutex<u64>> = counter.clone();

    handles.push(Thread::spawn<boolean>((): boolean -> {
      let mut step: u64 = 0;

      while (step < 1000) {
        let mut guard: MutexGuard<u64> = (@move shared).get().lock();
        let value: &mut u64 = guard.get();

        *value += 1;
        step += 1;
      }

      return true;
    }));
    index += 1;
  }

  while (handles.length() > 0) {
    if (let Option::SOME(handle) = handles.pop()) {
      Test::assert(handle.join());
    }
  }

  let guard: MutexGuard<u64> = counter.get().lock();

  Test::assertEq<u64>(*guard.read(), 4000);
  Test::assertEq<u64>(counter.strongCount(), 1);
}

@test
function sharedCountsClonesAndLocksThroughTheAlias(): void {
  Test::assert(requireSend<Shared<u64>>());
  Test::assert(requireSync<Shared<u64>>());

  let counter: Shared<u64> = Arc::new<Mutex<u64>>(Mutex::new<u64>(41));

  {
    let shared: Shared<u64> = counter.clone();

    Test::assertEq<u64>(shared.strongCount(), 2);

    let mut guard: MutexGuard<u64> = shared.get().lock();
    let value: &mut u64 = guard.get();

    *value += 1;
  }

  let guard: MutexGuard<u64> = counter.get().lock();

  Test::assertEq<u64>(counter.strongCount(), 1);
  Test::assertEq<u64>(*guard.read(), 42);
}

record Signal {
  public ready: Mutex<boolean>;
  public changed: Condvar;
}

@test
function condvarWakesAWaiter(): void {
  let signal: Arc<Signal> = Arc::new<Signal>(Signal { ready: Mutex::new<boolean>(false), changed: Condvar::new() });
  let shared: Arc<Signal> = signal.clone();
  let notifier: JoinHandle<boolean> = Thread::spawn<boolean>((): boolean -> {
    let state: &Signal = (@move shared).get();
    let mut guard: MutexGuard<boolean> = state.ready.lock();
    let ready: &mut boolean = guard.get();

    *ready = true;
    state.changed.notifyOne();
    return true;
  });
  let mut guard: MutexGuard<boolean> = signal.get().ready.lock();

  while (!*guard.read()) {
    signal.get().changed.wait<boolean>(&mut guard);
  }

  Test::assert(notifier.join());
}

@test
function channelReceivesInSendOrder(): void {
  let channel: Channel<u64> = Channel::new<u64>();
  let sender: Sender<u64> = channel.sender;
  let receiver: Receiver<u64> = channel.receiver;

  Test::assert(sender.send(1).isOk());
  Test::assert(sender.send(2).isOk());
  Test::assertEq<u64>(receiver.recv().unwrapOr(0), 1);
  Test::assert(sender.send(3).isOk());
  Test::assertEq<u64>(receiver.recv().unwrapOr(0), 2);
  Test::assertEq<u64>(receiver.recv().unwrapOr(0), 3);
}

@test
function channelRecvEndsAfterEverySenderIsGone(): void {
  let channel: Channel<String> = Channel::new<String>();
  let sender: Sender<String> = channel.sender;
  let receiver: Receiver<String> = channel.receiver;

  {
    let second: Sender<String> = sender.clone();

    Test::assert(second.send(String::create("left")).isOk());
  }

  Test::assert(sender.send(String::create("over")).isOk());

  {
    let _gone: Sender<String> = sender;
  }

  Test::assertEq<u64>(receiver.recv().unwrapOr(String::create("")).length(), 4);
  Test::assertEq<u64>(receiver.recv().unwrapOr(String::create("")).length(), 4);
  Test::assert(receiver.recv().isNone());
  Test::assert(receiver.tryRecv().isNone());
}

@test
function channelSendGivesTheValueBackWithoutReceivers(): void {
  let channel: Channel<String> = Channel::new<String>();
  let sender: Sender<String> = channel.sender;

  {
    let receiver: Receiver<String> = channel.receiver;
    let second: Receiver<String> = receiver.clone();

    Test::assert(sender.send(String::create("taken")).isOk());
    Test::assertEq<u64>(second.recv().unwrapOr(String::create("")).length(), 5);
  }

  let outcome: Result<void, String> = sender.send(String::create("returned"));

  if (let Result::ERROR(value) = outcome) {
    Test::assertEq<u64>(value.length(), 8);
  } else {
    Test::assert(false);
  }
}

@test
function channelTryRecvOnAnEmptyQueue(): void {
  let channel: Channel<u64> = Channel::new<u64>();
  let sender: Sender<u64> = channel.sender;
  let receiver: Receiver<u64> = channel.receiver;

  Test::assert(receiver.tryRecv().isNone());
  Test::assert(sender.send(7).isOk());
  Test::assertEq<u64>(receiver.tryRecv().unwrapOr(0), 7);
  Test::assert(receiver.tryRecv().isNone());
}

const PRODUCERS: u64 = 4;
const VALUES_PER_PRODUCER: u64 = 1000;

@test
function channelCollectsFromManyProducers(): void {
  let channel: Channel<u64> = Channel::new<u64>();
  let sender: Sender<u64> = channel.sender;
  let receiver: Receiver<u64> = channel.receiver;
  let mut handles: Vector<JoinHandle<void>> = Vector::new<JoinHandle<void>>();
  let mut producer: u64 = 0;

  while (producer < PRODUCERS) {
    let own: Sender<u64> = sender.clone();
    let base: u64 = producer * VALUES_PER_PRODUCER;

    handles.push(Thread::spawn<void>((): void -> {
      let mut step: u64 = 1;

      while (step <= VALUES_PER_PRODUCER) {
        (@move own).send(base + step);
        step += 1;
      }
    }));
    producer += 1;
  }

  {
    let _gone: Sender<u64> = sender;
  }

  let mut count: u64 = 0;
  let mut sum: u64 = 0;

  while (let Option::SOME(value) = receiver.recv()) {
    count += 1;
    sum += value;
  }

  while (let Option::SOME(handle) = handles.pop()) {
    handle.join();
  }

  let total: u64 = PRODUCERS * VALUES_PER_PRODUCER;

  Test::assertEq<u64>(count, total);
  Test::assertEq<u64>(sum, total * (total + 1) / 2);
}

@test
function channelSplitsValuesAcrossManyConsumers(): void {
  let channel: Channel<u64> = Channel::new<u64>();
  let sender: Sender<u64> = channel.sender;
  let receiver: Receiver<u64> = channel.receiver;
  let mut handles: Vector<JoinHandle<u64>> = Vector::new<JoinHandle<u64>>();
  let mut consumer: u64 = 0;

  while (consumer < 4) {
    let own: Receiver<u64> = receiver.clone();

    handles.push(Thread::spawn<u64>((): u64 -> {
      let mut sum: u64 = 0;

      while (let Option::SOME(value) = (@move own).recv()) {
        sum += value;
      }

      return sum;
    }));
    consumer += 1;
  }

  let mut value: u64 = 1;

  while (value <= 4000) {
    Test::assert(sender.send(value).isOk());
    value += 1;
  }

  {
    let _gone: Sender<u64> = sender;
  }

  let mut sum: u64 = 0;

  while (let Option::SOME(handle) = handles.pop()) {
    sum += handle.join();
  }

  let count: u64 = 4000;
  let expected: u64 = count * (count + 1) / 2;

  Test::assertEq<u64>(sum, expected);
  Test::assert(receiver.tryRecv().isNone());
}

/// Counts its own drops in an `AtomicU64` at `counter`.
@implements(Drop)
record DropCounter {
  counter: u64;

  drop(&mut self): void {
    (*(self.counter as *mut AtomicU64)).fetchAdd(1, Ordering::SEQ_CST);
  }
}

@test
function channelDropsTheValuesLeftInIt(): void {
  let storage: *mut u8 = RawAllocator::allocateZeroedAligned(1, @sizeOf<AtomicU64>(), @alignOf<AtomicU64>());
  let address: u64 = storage as u64;
  let drops: *mut AtomicU64 = storage as *mut AtomicU64;

  {
    let channel: Channel<DropCounter> = Channel::new<DropCounter>();
    let sender: Sender<DropCounter> = channel.sender;
    let receiver: Receiver<DropCounter> = channel.receiver;

    sender.send(DropCounter { counter: address });
    sender.send(DropCounter { counter: address });
    sender.send(DropCounter { counter: address });

    {
      let _first: Option<DropCounter> = receiver.recv();
    }

    Test::assertEq<u64>((*drops).load(Ordering::SEQ_CST), 1);
  }

  Test::assertEq<u64>((*drops).load(Ordering::SEQ_CST), 3);
  RawAllocator::free(storage);
}

@test
function threadPoolRunsEveryJobOnce(): void {
  let runs: Arc<AtomicU64> = Arc::new<AtomicU64>(AtomicU64::new(0));

  {
    let pool: ThreadPool = ThreadPool::new(4);
    let mut index: u64 = 0;

    while (index < 100) {
      let shared: Arc<AtomicU64> = runs.clone();

      pool.execute((): void -> {
        (@move shared).get().fetchAdd(1, Ordering::SEQ_CST);
      });
      index += 1;
    }
  }

  Test::assertEq<u64>(runs.get().load(Ordering::SEQ_CST), 100);
  Test::assertEq<u64>(runs.strongCount(), 1);
}

@test
function threadPoolDropWaitsForQueuedJobs(): void {
  let runs: Arc<AtomicU64> = Arc::new<AtomicU64>(AtomicU64::new(0));

  {
    let pool: ThreadPool = ThreadPool::new(1);
    let mut index: u64 = 0;

    while (index < 20) {
      let shared: Arc<AtomicU64> = runs.clone();

      pool.execute((): void -> {
        let mut spin: u64 = 0;

        while (spin < 100000) {
          spin += 1;
        }

        (@move shared).get().fetchAdd(1, Ordering::SEQ_CST);
      });
      index += 1;
    }
  }

  Test::assertEq<u64>(runs.get().load(Ordering::SEQ_CST), 20);
}

@test
function threadPoolRunsJobsOnSeveralThreads(): void {
  let channel: Channel<u64> = Channel::new<u64>();
  let sender: Sender<u64> = channel.sender;
  let receiver: Receiver<u64> = channel.receiver;
  let started: Arc<AtomicU64> = Arc::new<AtomicU64>(AtomicU64::new(0));

  {
    let pool: ThreadPool = ThreadPool::new(2);
    let mut index: u64 = 0;

    // Each job waits until both have started, so they cannot share a worker.
    while (index < 2) {
      let own: Sender<u64> = sender.clone();
      let shared: Arc<AtomicU64> = started.clone();

      pool.execute((): void -> {
        let counter: &AtomicU64 = (@move shared).get();

        counter.fetchAdd(1, Ordering::SEQ_CST);

        while (counter.load(Ordering::SEQ_CST) < 2) {
        }

        (@move own).send(Thread::currentId());
      });
      index += 1;
    }
  }

  let first: u64 = receiver.recv().unwrapOr(0);
  let second: u64 = receiver.recv().unwrapOr(0);

  Test::assert(first != 0);
  Test::assert(second != 0);
  Test::assert(first != second);
  Test::assert(first != Thread::currentId());
}

@test
function channelAndPoolAreSend(): void {
  Test::assert(requireSend<Sender<String>>());
  Test::assert(requireSend<Receiver<String>>());
}
