//! The blocking HTTP/1.1 server driver: `Http::Server`, the `Http::Handler`
//! trait it calls, and the `Http::Request` and `Http::Response` a handler
//! sees. It reads a connection, runs `Http::RequestParser` over it and
//! writes what the handler answered with `Http::writeResponse`.

import Io from "std::io";
import LibC from "std::libc";
import Platform from "std::libc::platform";
import SocketAddress, Shutdown, TcpListener, TcpStream from "std::net";
import Arc from "std::sync";
import JoinHandle, Thread from "std::thread";
import Time from "std::time";

import namesEqual from "./headers";

const READ_BYTES: u64 = 8192;

/// How long an accept loop waits after running out of descriptors.
const ACCEPT_BACKOFF_MICROSECONDS: u32 = 10000;

/// How long and how much a closing connection keeps reading what the client
/// still sends, so the close does not reset the connection before the client
/// reads the response.
const LINGER_MILLIS: u64 = 2000;
const LINGER_BYTES: u64 = 1048576;

/// Whether `bytes` is well-formed UTF-8: no truncated or overlong sequence,
/// no surrogate and nothing above U+10FFFF.
export function isUtf8(bytes: &Vector<u8>): boolean {
  let data: *u8 = bytes.asPtr();
  let length: u64 = bytes.length();
  let mut index: u64 = 0;

  while (index < length) {
    let lead: u8 = data[index];
    let mut extra: u64 = 0;
    let mut lowest: u8 = 0x80;
    let mut highest: u8 = 0xBF;

    if (lead < 0x80) {
      index += 1;
      continue;
    } else if (lead >= 0xC2 && lead <= 0xDF) {
      extra = 1;
    } else if (lead >= 0xE0 && lead <= 0xEF) {
      extra = 2;

      if (lead == 0xE0) {
        lowest = 0xA0;
      } else if (lead == 0xED) {
        highest = 0x9F;
      }
    } else if (lead >= 0xF0 && lead <= 0xF4) {
      extra = 3;

      if (lead == 0xF0) {
        lowest = 0x90;
      } else if (lead == 0xF4) {
        highest = 0x8F;
      }
    } else {
      return false;
    }

    if (length - index - 1 < extra) {
      return false;
    }

    let mut offset: u64 = 1;

    while (offset <= extra) {
      let byte: u8 = data[index + offset];
      let low: u8 = offset == 1 ? lowest : 0x80;
      let high: u8 = offset == 1 ? highest : 0xBF;

      if (byte < low || byte > high) {
        return false;
      }

      offset += 1;
    }

    index += extra + 1;
  }

  return true;
}

function appendBytes(out: &mut Vector<u8>, bytes: &Vector<u8>): void {
  let data: *u8 = bytes.asPtr();
  let mut index: u64 = 0;

  while (index < bytes.length()) {
    out.push(data[index]);
    index += 1;
  }
}

function isTimeout(error: &Io::IoError): boolean {
  return error.errorKind() == Io::ErrorKind::WOULD_BLOCK;
}

/// The head the driver writes for `response`: its status and header fields,
/// without any `Content-Length` or `Transfer-Encoding` the handler set, since
/// the driver frames the body itself, and with `Connection: close` when the
/// connection closes after it.
function responseHead(response: &Http::Response, close: boolean): Http::ResponseHead {
  let mut head: Http::ResponseHead = Http::ResponseHead::create(response.status);
  let mut index: u64 = 0;

  while (index < response.headers.length()) {
    let field: &Http::HeaderField = response.headers.fieldAt(index).unwrap();

    if (!namesEqual(&field.name, "Content-Length") && !namesEqual(&field.name, "Transfer-Encoding")) {
      head.headers.add(field.name.clone(), field.value.clone());
    }

    index += 1;
  }

  if (close && !head.headers.hasToken("Connection", "close")) {
    head.headers.add("Connection", "close");
  }

  return head;
}

/// Serializes the answer to one request. A head that cannot be written
/// becomes a 500 without a body.
function serializeResponse(response: &Http::Response, isHead: boolean, close: boolean): Vector<u8> {
  let mut head: Http::ResponseHead = responseHead(response, close);
  let mut out: Vector<u8> = Vector::new<u8>();

  if (isHead) {
    // The head of a HEAD response carries the length the body would have.
    let bodyLength: u64 = response.body.length();
    let length: String = bodyLength.toString();
    head.headers.add("Content-Length", length.toStr());

    if (Http::writeHead(&head, &mut out).isOk()) {
      return out;
    }
  } else if (Http::writeResponse(&head, &response.body, &mut out).isOk()) {
    return out;
  }

  let mut failure: Http::ResponseHead = Http::ResponseHead::create(500);

  if (close) {
    failure.headers.add("Connection", "close");
  }

  let empty: Vector<u8> = Vector::new<u8>();
  let mut fallback: Vector<u8> = Vector::new<u8>();

  // A 500 head with no fields always serializes.
  Http::writeResponse(&failure, &empty, &mut fallback).isOk();
  return fallback;
}

/// Ends a connection the server decided to close: shuts the writing side,
/// then reads and discards what the client still sends for a short while, so
/// unread input does not make the close reset the connection before the
/// client has read the response.
function lingerClose(stream: &mut TcpStream): void {
  if (stream.shutdown(Shutdown::WRITE).isError()) {
    return;
  }

  if (stream.setReadTimeout(Option::SOME(Time::Duration::fromMillis(LINGER_MILLIS))).isError()) {
    return;
  }

  let mut discarded: Vector<u8> = Vector::new<u8>();
  let mut total: u64 = 0;

  while (total < LINGER_BYTES) {
    discarded.clear();

    let Result::OK(read) = stream.readInto(&mut discarded, READ_BYTES) else {
      return;
    };

    if (read == 0) {
      return;
    }

    total += read;
  }
}

/// The HTTP/1.1 server driver.
export namespace Http {
  /// What a server calls for every complete request. The handler fills
  /// `response`; the driver writes it once `handle` returns.
  ///
  /// `Server::run` shares one handler among all its threads, so `handle`
  /// takes `&self` and may run on several threads at once. State a handler
  /// changes has to sit behind a `Mutex` or an atomic.
  trait Handler {
    handle(&self, request: &Http::Request, response: &mut Http::Response): void;
  }

  /// A complete request: its head and its whole body, chunked coding removed.
  record Request {
    public head: Http::RequestHead;
    public body: Vector<u8>;

    /// The request method.

    /// The request target as received, `/search?q=1` for example.
    public target(&self): str {
      return self.head.target.toStr();
    }

    /// The value of the first header field named `name`, ignoring ASCII case.
    public header(&self, name: str): Option<str> {
      return self.head.headers.get(name);
    }

    /// The header fields.

    /// A copy of the body as text, or `NONE` when it is not valid UTF-8.
    public bodyText(&self): Option<String> {
      if (!isUtf8(&self.body)) {
        return Option::NONE;
      }

      let mut text: String = String::withCapacity(self.body.length());
      let data: *u8 = self.body.asPtr();
      let mut index: u64 = 0;

      while (index < self.body.length()) {
        text.pushByte(data[index]);
        index += 1;
      }

      return Option::SOME(text);
    }
  }

  /// The answer a handler builds: status 200, no header fields and an
  /// empty body until the handler changes them.
  ///
  /// The driver adds `Content-Length` and, when it closes the connection,
  /// `Connection: close`. A `Content-Length` or `Transfer-Encoding` the
  /// handler sets is dropped. A status outside 100 to 999, or a header name
  /// or value that could split the response (CR, LF), makes the driver send
  /// a 500 without a body instead.
  record Response {
    public status: u16;
    public headers: Http::Headers;
    public body: Vector<u8>;

    /// An empty 200 response.
    public static new(): Response {
      return Response { status: 200, headers: Http::Headers::new(), body: Vector::new<u8>() };
    }

    /// Sets the status. The reason phrase is the standard one.
    public setStatus(&mut self, status: u16): void {
      self.status = status;
    }

    /// Replaces every header field named `name` with one holding `value`.
    public setHeader(&mut self, name: str, value: str): void {
      self.headers.set(name, value);
    }

    /// Appends a header field, keeping any with the same name.
    public addHeader(&mut self, name: str, value: str): void {
      self.headers.add(name, value);
    }

    /// Appends `bytes` to the body.
    public write(&mut self, bytes: &Vector<u8>): void {
      appendBytes(&mut self.body, bytes);
    }

    /// Appends the bytes of `text` to the body.
    public writeStr(&mut self, text: str): void {
      let owned: String = String::create(text);
      let bytes: Vector<u8> = owned.toBytes();
      appendBytes(&mut self.body, &bytes);
    }
  }

  /// How a server runs and what it accepts from a connection.
  record ServerConfig {
    /// Threads accepting and serving connections. Each serves one
    /// connection at a time. Default 8; 0 counts as 1.
    public threads: u64;

    /// The parser limits for every request.
    public limits: Http::Limits;

    /// How long a read may wait for the client, between requests or within
    /// one. When it expires the connection is closed without a response.
    /// Default 30 seconds.
    public idleTimeout: Time::Duration;

    /// Requests served on one connection before the server closes it; 0
    /// means no limit. Default 0.
    public maxRequestsPerConnection: u64;

    /// The default configuration.
    public static new(): ServerConfig {
      return ServerConfig {
        threads: 8,
        limits: Http::Limits::new(),
        idleTimeout: Time::Duration::fromSeconds(30),
        maxRequestsPerConnection: 0,
      };
    }
  }

  /// A blocking HTTP/1.1 server bound to an address.
  record Server {
    listener: Arc<TcpListener>;
    config: Arc<ServerConfig>;

    /// Binds a listening socket to `address`. Port 0 picks a free port;
    /// `localAddress` reports which.
    public static bind(address: &SocketAddress, config: ServerConfig): Result<Server, Io::IoError> {
      let listener: TcpListener = TcpListener::bind(address)!;

      return Result::OK(
        Server { listener: Arc::new<TcpListener>(listener), config: Arc::new<ServerConfig>(config) },
      );
    }

    /// The address the server is bound to.
    public localAddress(&self): Result<SocketAddress, Io::IoError> {
      return self.listener.get().localAddress();
    }

    /// Serves connections with `handler` on `config.threads` threads.
    ///
    /// Each thread runs `acceptConnections`: it accepts a connection,
    /// serves it with `serveConnection` and accepts the next one. An error on a connection ends only that
    /// connection. A thread stops when `accept` fails, and `run` returns
    /// once every thread stopped, with the first thread's error. There is
    /// no way to stop a running server yet, so in practice `run` blocks for
    /// as long as the process lives.
    ///
    /// The workers carry the failing errno as an `i32` rather than an
    /// `IoError`: the error's message borrows a C-managed buffer, which makes
    /// `IoError` a view, and a view cannot cross a thread boundary. The
    /// errno is mapped back to an `IoError` on the calling thread.
    public run<H: Http::Handler & Send & Sync>(self, handler: H): Result<void, Io::IoError> {
      let shared: Arc<H> = Arc::new<H>(handler);
      let count: u64 = self.config.get().threads == 0 ? 1 : self.config.get().threads;
      let mut workers: Vector<JoinHandle<i32>> = Vector::new<JoinHandle<i32>>();
      let mut index: u64 = 0;

      while (index < count) {
        let listener: Arc<TcpListener> = self.listener.clone();
        let config: Arc<ServerConfig> = self.config.clone();
        let worker: Arc<H> = shared.clone();

        workers.push(Thread::spawn<i32>((): i32 -> {
          return Http::acceptConnections<H>((@move listener).get(), (@move worker).get(), (@move config).get());
        }));
        index += 1;
      }

      let mut first: Option<i32> = Option::NONE;

      while (workers.length() > 0) {
        if (let Option::SOME(handle) = workers.pop()) {
          // `pop` takes the last worker, so the first one's error is kept last.
          first = Option::SOME(handle.join());
        }
      }

      let Option::SOME(errno) = first else {
        return Result::OK(());
      };

      return Result::ERROR(Io::IoError::fromErrno(errno));
    }
  }

  /// Accepts connections on `listener` and serves each in turn with
  /// `handler` on the calling thread, until `accept` reports that the
  /// listener itself is unusable; returns that error's raw errno, and `0`
  /// is never returned on that path.
  ///
  /// Every thread of `Server::run` runs this loop. Calling it directly on
  /// threads of your own gives each thread its own handler, for state that
  /// is not `Send` or `Sync` (`std::web` builds one router per thread this
  /// way); the listener is shared, for example through an `Arc`.
  ///
  /// Any other `accept` failure concerns one connection or a passing
  /// shortage (a client that reset before it was accepted, no descriptors
  /// left), so the loop keeps going; after a shortage it waits briefly
  /// instead of spinning. An error on one connection only ends that
  /// connection.
  ///
  /// The errno is returned instead of an `IoError` so the value can cross a
  /// thread boundary: the error's message borrows a C-managed buffer, which
  /// makes `IoError` a view. Map it back with `Io::IoError::fromErrno`.
  function acceptConnections<H: Http::Handler>(
    listener: &TcpListener,
    handler: &H,
    config: &ServerConfig
  ): i32 {
    while (true) {
      let mut stream: TcpStream = match (listener.accept()) {
        Result::OK(accepted) -> accepted,
        Result::ERROR(error) -> {
          let code: i32 = error.rawCode();

          if (code == Platform::EBADF || code == Platform::EINVAL) {
            return code;
          }

          if (code == Platform::EMFILE || code == Platform::ENFILE) {
            LibC::Process::usleep(ACCEPT_BACKOFF_MICROSECONDS);
          }

          continue;
        },
      };

      Http::serveConnection<H>(&mut stream, handler, config).isOk();
    }

    return Io::IoError::lastError().rawCode();
  }

  /// Serves HTTP/1.1 requests on `stream` until the connection ends.
  ///
  /// Reads with `config.idleTimeout`, feeds the parser and calls `handler`
  /// for every complete request, then writes its response. The connection
  /// stays open for the next request unless the request does not keep it
  /// alive (see `RequestHead.keepAlive`), the response carries
  /// `Connection: close`, or `config.maxRequestsPerConnection` is reached.
  ///
  /// A malformed request gets a response with the parser's status and
  /// `Connection: close`, and ends the connection. A client that closes,
  /// or sends nothing for `config.idleTimeout`, ends it without a response.
  /// The body is passed to the handler only once complete, so
  /// `Expect: 100-continue` is not answered: the client sends the body
  /// after its own wait. A `HEAD` request gets the head the handler's
  /// response would have, without the body.
  ///
  /// Returns `OK` when the connection ended in one of these ways, and the
  /// error when reading or writing the socket failed.
  function serveConnection<H: Http::Handler>(
    stream: &mut TcpStream,
    handler: &H,
    config: &ServerConfig
  ): Result<void, Io::IoError> {
    stream.setReadTimeout(Option::SOME(config.idleTimeout))!;

    let mut parser: Http::RequestParser = Http::RequestParser::new(config.limits);
    let mut input: Vector<u8> = Vector::new<u8>();
    let mut head: Option<Http::RequestHead> = Option::NONE;
    let mut body: Vector<u8> = Vector::new<u8>();
    let mut served: u64 = 0;

    while (true) {
      match (parser.next()) {
        Http::ParseEvent::NEED_MORE -> {
          input.clear();

          match (stream.readInto(&mut input, READ_BYTES)) {
            Result::OK(read) -> {
              if (read == 0) {
                return Result::OK(());
              }

              parser.feed(&input);
            },
            Result::ERROR(error) -> {
              if (isTimeout(&error)) {
                return Result::OK(());
              }

              return Result::ERROR(error);
            },
          };
        },
        Http::ParseEvent::HEAD(received) -> {
          head = Option::SOME(received);
          body = Vector::new<u8>();
        },
        Http::ParseEvent::BODY_CHUNK(bytes) -> {
          appendBytes(&mut body, &bytes);
        },
        Http::ParseEvent::DONE -> {
          let current: Option<Http::RequestHead> = head;
          head = Option::NONE;
          let complete: Vector<u8> = body;
          body = Vector::new<u8>();

          let Option::SOME(requestHead) = current else {
            return Result::OK(());
          };

          let keepAlive: boolean = requestHead.keepAlive();
          let isHead: boolean = match (requestHead.method) {
            Http::Method::HEAD -> true,
            _ -> false,
          };
          let request: Request = Request { head: requestHead, body: complete };
          let mut response: Response = Response::new();
          handler.handle(&request, &mut response);
          served += 1;

          let limitReached: boolean = config.maxRequestsPerConnection != 0 && served >= config.maxRequestsPerConnection;
          let close: boolean = !keepAlive || limitReached || response.headers.hasToken("Connection", "close");
          let out: Vector<u8> = serializeResponse(&response, isHead, close);
          stream.writeAllBytes(&out)!;

          if (close) {
            lingerClose(stream);
            return Result::OK(());
          }
        },
        Http::ParseEvent::MALFORMED(error) -> {
          let mut failure: Http::ResponseHead = Http::ResponseHead::create(error.status);
          failure.headers.add("Connection", "close");
          let empty: Vector<u8> = Vector::new<u8>();
          let mut out: Vector<u8> = Vector::new<u8>();
          Http::writeResponse(&failure, &empty, &mut out).isOk();
          stream.writeAllBytes(&out)!;
          lingerClose(stream);
          return Result::OK(());
        },
      };
    }

    return Result::OK(());
  }
}
