import Test from "std::test";
import Ascii from "./mod";

@test
function charClassifiesAsciiCharsWithExplicitAsciiNames(): void {
  let upper: char = 'A';
  let lower: char = 'z';
  let digit: char = '7';
  let zero: char = '0';
  let nine: char = '9';
  let q: char = 'Q';
  let three: char = '3';
  let underscore: char = '_';

  Test::assert(upper.isAsciiAlpha());
  Test::assert(lower.isAsciiAlpha());
  Test::assert(!digit.isAsciiAlpha());

  Test::assert(zero.isAsciiNumeric());
  Test::assert(nine.isAsciiNumeric());
  Test::assert(!lower.isAsciiNumeric());

  Test::assertEq<u64>(match (zero.asciiDigitValue()) { Option::SOME(value) -> value, Option::NONE -> 99 }, 0);
  Test::assertEq<u64>(match (nine.asciiDigitValue()) { Option::SOME(value) -> value, Option::NONE -> 99 }, 9);
  Test::assert(match (lower.asciiDigitValue()) { Option::SOME(_) -> false, Option::NONE -> true });

  Test::assert(q.isAsciiAlphanumeric());
  Test::assert(three.isAsciiAlphanumeric());
  Test::assert(!underscore.isAsciiAlphanumeric());
}

@test
function charClassifiesUtf8Scalars(): void {
  let latin: char = 'é';
  let cjk: char = '中';
  let fullWidthDigit: char = '５';
  let asciiHex: char = 'A';
  let fullWidthHex: char = 'Ｇ';

  Test::assert(latin.isAlpha());
  Test::assert(cjk.isAlpha());
  Test::assert(latin.isAlphabetic());
  Test::assert(fullWidthDigit.isNumeric());
  Test::assert(fullWidthDigit.isDigit());
  Test::assert(fullWidthDigit.isAlphanumeric());
  Test::assert(asciiHex.isHexDigit());
  Test::assert(!fullWidthHex.isHexDigit());
}

@test
function charClassifiesHexDigitsWhitespaceAndCase(): void {
  let zero: char = '0';
  let lowerA: char = 'a';
  let upperF: char = 'F';
  let lowerG: char = 'g';
  let space: char = ' ';
  let newline: char = '\n';
  let tab: char = '\t';
  let upperA: char = 'A';
  let lowerZ: char = 'z';
  let upperZ: char = 'Z';
  let nonBreakingSpace: char = 160 as char;

  Test::assert(zero.isAsciiHexDigit());
  Test::assert(lowerA.isAsciiHexDigit());
  Test::assert(upperF.isAsciiHexDigit());
  Test::assert(!lowerG.isAsciiHexDigit());

  Test::assert(space.isAsciiWhitespace());
  Test::assert(newline.isAsciiWhitespace());
  Test::assert(tab.isAsciiWhitespace());
  Test::assert(!upperA.isAsciiWhitespace());
  Test::assert(nonBreakingSpace.isWhitespace());

  Test::assert(upperA.isAsciiUppercase());
  Test::assert(!lowerA.isAsciiUppercase());
  Test::assert(lowerA.isAsciiLowercase());
  Test::assert(!upperA.isAsciiLowercase());

  Test::assertEq<char>(upperA.toAsciiLowercase(), lowerA);
  Test::assertEq<char>(lowerZ.toAsciiLowercase(), lowerZ);
  Test::assertEq<char>(lowerA.toAsciiUppercase(), upperA);
  Test::assertEq<char>(upperZ.toAsciiUppercase(), upperZ);
}

@test
function asciiClassifiesBytes(): void {
  Test::assert(Ascii::isDigit('0' as u8) && Ascii::isDigit('9' as u8));
  Test::assert(!Ascii::isDigit('/' as u8) && !Ascii::isDigit(':' as u8));
  Test::assert(Ascii::isHexDigit('f' as u8) && Ascii::isHexDigit('F' as u8) && Ascii::isHexDigit('7' as u8));
  Test::assert(!Ascii::isHexDigit('g' as u8) && !Ascii::isHexDigit('G' as u8));
  Test::assert(Ascii::isUpper('A' as u8) && Ascii::isUpper('Z' as u8) && !Ascii::isUpper('a' as u8));
  Test::assert(Ascii::isLower('a' as u8) && Ascii::isLower('z' as u8) && !Ascii::isLower('Z' as u8));
  Test::assert(Ascii::isAlpha('q' as u8) && !Ascii::isAlpha('1' as u8) && !Ascii::isAlpha('@' as u8));
  Test::assert(Ascii::isAlphanumeric('1' as u8) && Ascii::isAlphanumeric('Q' as u8) && !Ascii::isAlphanumeric('_' as u8));
  Test::assert(Ascii::isWhitespace(' ' as u8) && Ascii::isWhitespace(9) && Ascii::isWhitespace(10) && Ascii::isWhitespace(12) && Ascii::isWhitespace(13));
  Test::assert(!Ascii::isWhitespace(11) && !Ascii::isWhitespace('x' as u8));
}

@test
function asciiLeavesNonAsciiBytesUnclassified(): void {
  let byte: u8 = 195;
  Test::assert(!Ascii::isDigit(byte) && !Ascii::isHexDigit(byte) && !Ascii::isAlpha(byte) && !Ascii::isWhitespace(byte));
  Test::assertEq<u8>(Ascii::toLower(byte), byte);
  Test::assertEq<u8>(Ascii::toUpper(byte), byte);
}

@test
function asciiMapsCase(): void {
  Test::assertEq<u8>(Ascii::toLower('A' as u8), 'a' as u8);
  Test::assertEq<u8>(Ascii::toLower('z' as u8), 'z' as u8);
  Test::assertEq<u8>(Ascii::toLower('[' as u8), '[' as u8);
  Test::assertEq<u8>(Ascii::toUpper('a' as u8), 'A' as u8);
  Test::assertEq<u8>(Ascii::toUpper('Z' as u8), 'Z' as u8);
  Test::assertEq<u8>(Ascii::toUpper('`' as u8), '`' as u8);
}
