import Http from "std::http";
import JsonObjectEntry, JsonValue from "std::json";
import IpAddress, Shutdown, SocketAddress, TcpListener, TcpStream from "std::net";
import Channel, Receiver, Sender from "std::sync";
import Test from "std::test";
import JoinHandle, Thread from "std::thread";
import Time from "std::time";
import Web from "std::web";

function webTestRequest(method: Http::Method, target: str, body: str): Http::Request {
  let text: String = String::create(body);

  return Http::Request {
    head: Http::RequestHead {
      method: method,
      target: String::create(target),
      version: Http::Version::HTTP_1_1,
      headers: Http::Headers::new(),
    },
    body: text.toBytes(),
  };
}

function webTestBytesText(bytes: &Vector<u8>): String {
  let mut text: String = String::new();
  let mut index: u64 = 0;

  while (index < bytes.length()) {
    text.pushByte(*bytes.get(index).unwrap());
    index += 1;
  }

  return text;
}

/// Runs `router` on one request and describes the response as
/// `<status> <body>`.
function webTestCall(router: &Web::Router, method: Http::Method, target: str): String {
  let request: Http::Request = webTestRequest(method, target, "");
  let mut response: Http::Response = Http::Response::new();
  router.handle(&request, &mut response);

  let mut text: String = response.status.toString();
  text.pushStr(" ");
  let body: String = webTestBytesText(&response.body);
  text.push(&body);
  return text;
}

function webTestShowUser(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  let Option::SOME(id) = request.param("id") else {
    return Result::ERROR(Web::Error::new("no id"));
  };

  response.text(`user ${id}`);
  return Result::OK(());
}

function webTestCreateUser(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  response.setStatus(201);
  let body: String = request.bodyText().unwrap();
  response.text(`created ${body}`);
  return Result::OK(());
}

function webTestRoot(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  response.text("root");
  return Result::OK(());
}

function webTestFail(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  response.text("partial");
  return Result::ERROR(Web::Error::new("database down"));
}

function webTestForbidden(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  return Result::ERROR(Web::Error::withStatus(403, "no entry"));
}

function webTestUsers(): Web::Router {
  let mut router: Web::Router = Web::Router::new();
  router.get("/", webTestRoot);
  router.get("/users/:id", webTestShowUser);
  router.post("/users", webTestCreateUser);
  router.delete("/users/:id", webTestRoot);
  router.get("/fail", webTestFail);
  router.get("/forbidden", webTestForbidden);
  return router;
}

@test
function routesByMethodAndPath(): void {
  let router: Web::Router = webTestUsers();
  let root: String = webTestCall(&router, Http::Method::GET, "/");
  Test::assertEq<str>(root.toStr(), "200 root");

  let user: String = webTestCall(&router, Http::Method::GET, "/users/42");
  Test::assertEq<str>(user.toStr(), "200 user 42");

  let request: Http::Request = webTestRequest(Http::Method::POST, "/users", "ana");
  let mut response: Http::Response = Http::Response::new();
  router.handle(&request, &mut response);
  Test::assertEq<u16>(response.status, 201);
  let body: String = webTestBytesText(&response.body);
  Test::assertEq<str>(body.toStr(), "created ana");
  Test::assertEq<str>(response.headers.get("Content-Type").unwrap(), "text/plain; charset=utf-8");
}

@test
function matchesEverySegmentExactly(): void {
  let router: Web::Router = webTestUsers();
  let extra: String = webTestCall(&router, Http::Method::GET, "/users/42/posts");
  Test::assertEq<str>(extra.toStr(), "404 Not Found");

  let trailing: String = webTestCall(&router, Http::Method::GET, "/users/42/");
  Test::assertEq<str>(trailing.toStr(), "404 Not Found");

  let empty: String = webTestCall(&router, Http::Method::GET, "/users/");
  Test::assertEq<str>(empty.toStr(), "404 Not Found");

  let prefix: String = webTestCall(&router, Http::Method::GET, "/user/42");
  Test::assertEq<str>(prefix.toStr(), "404 Not Found");
}

@test
function decodesParametersAndIgnoresTheQuery(): void {
  let router: Web::Router = webTestUsers();
  let encoded: String = webTestCall(&router, Http::Method::GET, "/users/ana%20b%C3%A9?x=1");
  Test::assertEq<str>(encoded.toStr(), "200 user ana bé");

  let invalid: String = webTestCall(&router, Http::Method::GET, "/users/%zz");
  Test::assertEq<str>(invalid.toStr(), "400 Bad Request");

  let notUtf8: String = webTestCall(&router, Http::Method::GET, "/users/%FF");
  Test::assertEq<str>(notUtf8.toStr(), "400 Bad Request");
}

function webTestQuery(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  let page: String = request.query("page").unwrapOr(String::create("none"));
  let name: String = request.query("name").unwrapOr(String::create("none"));
  let flag: String = request.query("flag").unwrapOr(String::create("none"));
  let missing: String = request.query("missing").unwrapOr(String::create("none"));
  response.text(`${request.path()} page=${page} name=${name} flag=${flag} missing=${missing}`);
  return Result::OK(());
}

@test
function readsTheQueryString(): void {
  let mut router: Web::Router = Web::Router::new();
  router.get("/search", webTestQuery);

  let full: String = webTestCall(&router, Http::Method::GET, "/search?page=2&name=a+b%21&flag&page=3");
  Test::assertEq<str>(full.toStr(), "200 /search page=2 name=a b! flag= missing=none");

  let none: String = webTestCall(&router, Http::Method::GET, "/search");
  Test::assertEq<str>(none.toStr(), "200 /search page=none name=none flag=none missing=none");
}

@test
function answersUnknownPathsWith404(): void {
  let router: Web::Router = webTestUsers();
  let request: Http::Request = webTestRequest(Http::Method::GET, "/nowhere", "");
  let mut response: Http::Response = Http::Response::new();
  router.handle(&request, &mut response);
  Test::assertEq<u16>(response.status, 404);
  let body: String = webTestBytesText(&response.body);
  Test::assertEq<str>(body.toStr(), "Not Found");
  Test::assertEq<str>(response.headers.get("Content-Type").unwrap(), "text/plain; charset=utf-8");
}

@test
function answersAnotherMethodWith405AndAllow(): void {
  let router: Web::Router = webTestUsers();
  let request: Http::Request = webTestRequest(Http::Method::PUT, "/users/7", "");
  let mut response: Http::Response = Http::Response::new();
  router.handle(&request, &mut response);
  Test::assertEq<u16>(response.status, 405);
  Test::assertEq<str>(response.headers.get("Allow").unwrap(), "GET, HEAD, DELETE");
  let body: String = webTestBytesText(&response.body);
  Test::assertEq<str>(body.toStr(), "Method Not Allowed");

  let other: Http::Request = webTestRequest(Http::Method::OTHER(String::create("PURGE")), "/users", "");
  let mut otherResponse: Http::Response = Http::Response::new();
  router.handle(&other, &mut otherResponse);
  Test::assertEq<u16>(otherResponse.status, 405);
  Test::assertEq<str>(otherResponse.headers.get("Allow").unwrap(), "POST");
}

@test
function headUsesGetRoutes(): void {
  let router: Web::Router = webTestUsers();
  let head: String = webTestCall(&router, Http::Method::HEAD, "/users/3");
  Test::assertEq<str>(head.toStr(), "200 user 3");
}

@test
function anyMatchesEveryMethod(): void {
  let mut router: Web::Router = Web::Router::new();
  router.any("/ping", webTestRoot);
  let put: String = webTestCall(&router, Http::Method::PUT, "/ping");
  Test::assertEq<str>(put.toStr(), "200 root");
  let other: String = webTestCall(&router, Http::Method::OTHER(String::create("PURGE")), "/ping");
  Test::assertEq<str>(other.toStr(), "200 root");
}

@test
function turnsAnErrorIntoItsStatus(): void {
  let router: Web::Router = webTestUsers();
  let failure: String = webTestCall(&router, Http::Method::GET, "/fail");
  Test::assertEq<str>(failure.toStr(), "500 database down");

  let forbidden: String = webTestCall(&router, Http::Method::GET, "/forbidden");
  Test::assertEq<str>(forbidden.toStr(), "403 no entry");
}

@test
function errorDefaultsTo500(): void {
  let error: Web::Error = Web::Error::new("broken");
  Test::assertEq<u16>(error.status, 500);
  Test::assertEq<str>(error.message.toStr(), "broken");

  let notFound: Web::Error = Web::Error::withStatus(404, "gone");
  Test::assertEq<u16>(notFound.status, 404);
}

function webTestFirst(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  response.writeStr("1(");
  next(request, response)!;
  response.writeStr(")1");
  return Result::OK(());
}

function webTestSecond(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  response.writeStr("2(");
  next(request, response)!;
  response.writeStr(")2");
  return Result::OK(());
}

function webTestHandled(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  response.writeStr("route");
  return Result::OK(());
}

@test
function runsMiddlewareInOrderAroundTheRoute(): void {
  let mut router: Web::Router = Web::Router::new();
  router.use(webTestFirst);
  router.use(webTestSecond);
  router.get("/", webTestHandled);

  let result: String = webTestCall(&router, Http::Method::GET, "/");
  Test::assertEq<str>(result.toStr(), "200 1(2(route)2)1");
}

function webTestStop(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  if (request.header("Authorization").isNone()) {
    return Result::ERROR(Web::Error::withStatus(401, "Unauthorized"));
  }

  return next(request, response);
}

/// Records whether the error from `next` passed through it, then lets it go
/// on up the chain.
function webTestObserve(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  let result: Result<void, Web::Error> = next(request, response);
  response.setHeader("X-Observed", result.isError() ? "error" : "ok");
  return result;
}

@test
function middlewareCanStopTheChainWithAnError(): void {
  let mut router: Web::Router = Web::Router::new();
  router.use(webTestObserve);
  router.use(webTestStop);
  router.get("/", webTestHandled);

  let request: Http::Request = webTestRequest(Http::Method::GET, "/", "");
  let mut response: Http::Response = Http::Response::new();
  router.handle(&request, &mut response);
  Test::assertEq<u16>(response.status, 401);
  Test::assertEq<str>(response.headers.get("X-Observed").unwrap(), "error");
  let body: String = webTestBytesText(&response.body);
  Test::assertEq<str>(body.toStr(), "Unauthorized");

  let mut authorized: Http::Request = webTestRequest(Http::Method::GET, "/", "");
  authorized.head.headers.add("Authorization", "yes");
  let mut authorizedResponse: Http::Response = Http::Response::new();
  router.handle(&authorized, &mut authorizedResponse);
  Test::assertEq<u16>(authorizedResponse.status, 200);
  Test::assertEq<str>(authorizedResponse.headers.get("X-Observed").unwrap(), "ok");
}

@test
function middlewareRunsForUnmatchedPaths(): void {
  let mut router: Web::Router = Web::Router::new();
  router.use(webTestObserve);
  router.get("/", webTestHandled);

  let request: Http::Request = webTestRequest(Http::Method::GET, "/missing", "");
  let mut response: Http::Response = Http::Response::new();
  router.handle(&request, &mut response);
  Test::assertEq<u16>(response.status, 404);
  Test::assertEq<str>(response.headers.get("X-Observed").unwrap(), "error");
}

function webTestPass(
  request: &mut Web::Request,
  response: &mut Web::Response,
  next: Web::Next
): Result<void, Web::Error> {
  response.writeStr("pass,");
  return next(request, response);
}

@test
function nextInARouteFallsThroughToTheNextMatchingRoute(): void {
  let mut router: Web::Router = Web::Router::new();
  router.get("/users/:id", webTestPass);
  router.any("/users/:id", webTestHandled);
  router.get("/alone", webTestPass);

  let both: String = webTestCall(&router, Http::Method::GET, "/users/1");
  Test::assertEq<str>(both.toStr(), "200 pass,route");

  let alone: String = webTestCall(&router, Http::Method::GET, "/alone");
  Test::assertEq<str>(alone.toStr(), "404 Not Found");
}

@test
function routesAcceptClosures(): void {
  let suffix: str = "!";
  let mut router: Web::Router = Web::Router::new();
  router.put(
    "/items/:name",
    (
      request: &mut Web::Request,
      response: &mut Web::Response,
      next: Web::Next,
    ): Result<void, Web::Error> -> {
      response.text(`${request.param("name").unwrap()}${suffix}`);
      return Result::OK(());
    },
  );
  router.patch(
    "/items/:name",
    (
      request: &mut Web::Request,
      response: &mut Web::Response,
      next: Web::Next,
    ): Result<void, Web::Error> -> {
      response.text("patched");
      return Result::OK(());
    },
  );

  let put: String = webTestCall(&router, Http::Method::PUT, "/items/box");
  Test::assertEq<str>(put.toStr(), "200 box!");
  let patch: String = webTestCall(&router, Http::Method::PATCH, "/items/box");
  Test::assertEq<str>(patch.toStr(), "200 patched");
}

@test
function responseHelpers(): void {
  let mut response: Web::Response = Web::Response::new();
  Test::assertEq<u16>(response.status, 200);
  response.writeStr("old");
  response.text("new");
  let text: String = webTestBytesText(&response.body);
  Test::assertEq<str>(text.toStr(), "new");

  response.setHeader("X-One", "a");
  response.addHeader("X-One", "b");
  Test::assertEq<u64>(response.headers.getAll("X-One").length(), 2);
  Test::assertEq<str>(response.header("x-one").unwrap(), "a");

  let mut entries: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  entries.push(JsonObjectEntry::create("ok", JsonValue::boolValue(true)));
  let object: JsonValue = JsonValue::object(entries);
  response.json(&object);
  let json: String = webTestBytesText(&response.body);
  Test::assertEq<str>(json.toStr(), "{\"ok\":true}");
  Test::assertEq<str>(response.header("Content-Type").unwrap(), "application/json");

  let mut target: Http::Response = Http::Response::new();
  response.setStatus(202);
  response.finish(&mut target);
  Test::assertEq<u16>(target.status, 202);
  Test::assertEq<u64>(target.headers.getAll("X-One").length(), 2);
}

@test
function requestAccessors(): void {
  let mut http: Http::Request = webTestRequest(Http::Method::POST, "/a%20b?q=1", "body");
  http.head.headers.add("X-Name", "value");
  let request: Web::Request = Web::Request::create(&http);
  Test::assertEq<str>(request.path(), "/a%20b");
  Test::assertEq<str>(request.target(), "/a%20b?q=1");
  Test::assertEq<str>(request.header("x-name").unwrap(), "value");
  Test::assert(request.param("id").isNone());
  Test::assertEq<u64>(request.body().length(), 4);
  let method: String = request.method().toString();
  Test::assertEq<str>(method.toStr(), "POST");
}

/// An app whose router counts nothing across threads: every thread builds
/// its own.
@implements(Web::App)
record WebTestApp {
  // A `static str`: the app crosses a thread boundary, and a `str` field
  // would make the record a view.
  public greeting: static str;

  build(&self): Web::Router {
    let greeting: str = self.greeting;
    let mut router: Web::Router = Web::Router::new();
    router.use(webTestObserve);
    router.get(
      "/hello/:name",
      (
        request: &mut Web::Request,
        response: &mut Web::Response,
        next: Web::Next,
      ): Result<void, Web::Error> -> {
        response.text(`${greeting} ${request.param("name").unwrap()}`);
        return Result::OK(());
      },
    );
    return router;
  }
}

/// Serves one loopback connection with the app's router while a client
/// thread writes `request`, shuts its writing side and reads until the
/// server closes. Returns what the client received.
function webTestExchange(request: str): String {
  let address: SocketAddress = SocketAddress::create(IpAddress::v4(127, 0, 0, 1), 0);
  let listener: TcpListener = TcpListener::bind(&address).unwrap();
  let port: u16 = listener.localAddress().unwrap().port();
  let message: String = String::create(request);

  let client: JoinHandle<String> = Thread::spawn<String>((): String -> {
    let target: SocketAddress = SocketAddress::create(IpAddress::v4(127, 0, 0, 1), port);
    let mut received: Vector<u8> = Vector::new<u8>();
    let mut stream: TcpStream = TcpStream::connect(&target).unwrap();
    let bytes: Vector<u8> = (@move message).toBytes();

    if (stream.setReadTimeout(Option::SOME(Time::Duration::fromSeconds(10))).isError()) {
      return String::create("<timeout setup failed>");
    }

    if (stream.writeAllBytes(&bytes).isError()) {
      return String::create("<write failed>");
    }

    if (stream.shutdown(Shutdown::WRITE).isError()) {
      return String::create("<shutdown failed>");
    }

    while (true) {
      let Result::OK(read) = stream.readInto(&mut received, 65536) else {
        break;
      };

      if (read == 0) {
        break;
      }
    }

    return webTestBytesText(&received);
  });

  {
    let app: WebTestApp = WebTestApp { greeting: "hi" };
    let router: Web::Router = app.build();
    let mut config: Http::ServerConfig = Http::ServerConfig::new();
    config.idleTimeout = Time::Duration::fromSeconds(5);
    let mut stream: TcpStream = listener.accept().unwrap();
    Test::assert(Http::serveConnection<Web::Router>(&mut stream, &router, &config).isOk());
  }

  return client.join();
}

@test
function servesARouterOverLoopback(): void {
  let received: String = webTestExchange(
    "GET /hello/ana HTTP/1.1\r\nHost: a\r\n\r\nPOST /hello/ana HTTP/1.1\r\nHost: a\r\nContent-Length: 0\r\n\r\nGET /none HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n",
  );
  Test::assertEq<str>(
    received.toStr(),
    "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nX-Observed: ok\r\nContent-Length: 6\r\n\r\nhi anaHTTP/1.1 405 Method Not Allowed\r\nAllow: GET, HEAD\r\nX-Observed: error\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 18\r\n\r\nMethod Not AllowedHTTP/1.1 404 Not Found\r\nX-Observed: error\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\nContent-Length: 9\r\n\r\nNot Found",
  );
}

@test
function serveListenerRunsTheApp(): void {
  let channel: Channel<u16> = Channel::new<u16>();
  let sender: Sender<u16> = channel.sender;
  let receiver: Receiver<u16> = channel.receiver;

  // The server never returns; the test process ends with its thread still
  // running. It binds its own listener, since a spawned task cannot move a
  // captured value out, and reports the port.
  Thread::spawn<boolean>((): boolean -> {
    let address: SocketAddress = SocketAddress::create(IpAddress::v4(127, 0, 0, 1), 0);
    let listener: TcpListener = TcpListener::bind(&address).unwrap();
    let port: u16 = listener.localAddress().unwrap().port();
    let mut config: Http::ServerConfig = Http::ServerConfig::new();
    config.threads = 2;
    config.idleTimeout = Time::Duration::fromSeconds(5);

    if ((@move sender).send(port).isError()) {
      return false;
    }

    return Web::serveListener<WebTestApp>(listener, config, WebTestApp { greeting: "hey" }).isOk();
  });

  let port: u16 = receiver.recv().unwrap();
  let target: SocketAddress = SocketAddress::create(IpAddress::v4(127, 0, 0, 1), port);
  let mut stream: TcpStream = TcpStream::connect(&target).unwrap();
  let request: String = String::create("GET /hello/bo HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n");
  let bytes: Vector<u8> = request.toBytes();
  Test::assert(stream.setReadTimeout(Option::SOME(Time::Duration::fromSeconds(10))).isOk());
  Test::assert(stream.writeAllBytes(&bytes).isOk());
  let mut received: Vector<u8> = Vector::new<u8>();

  while (true) {
    let Result::OK(read) = stream.readInto(&mut received, 65536) else {
      break;
    };

    if (read == 0) {
      break;
    }
  }

  let text: String = webTestBytesText(&received);
  Test::assert(text.endsWith("\r\n\r\nhey bo"));
}

/// The message of the error `Web::parseAddress` reports for `text`, or
/// `"<accepted>"` when it accepted the address.
function webTestAddressError(text: str): String {
  let result: Result<SocketAddress, Web::ListenError> = Web::parseAddress(text);
  let Result::ERROR(error) = result else {
    return String::create("<accepted>");
  };

  return error.message();
}

@test
function parseAddressAcceptsTheDocumentedForms(): void {
  let loopback: SocketAddress = Web::parseAddress("127.0.0.1:8080").unwrap();
  Test::assertEq<str>(loopback.toString().toStr(), "127.0.0.1:8080");

  // An empty host and `*` mean every interface, `0.0.0.0`.
  Test::assertEq<str>(Web::parseAddress(":8080").unwrap().toString().toStr(), "0.0.0.0:8080");
  Test::assertEq<str>(Web::parseAddress("*:8080").unwrap().toString().toStr(), "0.0.0.0:8080");
  Test::assertEq<str>(Web::parseAddress("0.0.0.0:8080").unwrap().toString().toStr(), "0.0.0.0:8080");

  Test::assertEq<str>(Web::parseAddress(":0").unwrap().toString().toStr(), "0.0.0.0:0");
  Test::assertEq<str>(
    Web::parseAddress("255.255.255.255:65535").unwrap().toString().toStr(),
    "255.255.255.255:65535",
  );
}

@test
function parseAddressRejectsAMissingColon(): void {
  Test::assertEq<str>(
    webTestAddressError("127.0.0.1").toStr(),
    "invalid address \"127.0.0.1\": expected \"<host>:<port>\" like \"127.0.0.1:8080\"",
  );
  Test::assertEq<str>(
    webTestAddressError("").toStr(),
    "invalid address \"\": expected \"<host>:<port>\" like \"127.0.0.1:8080\"",
  );
}

@test
function parseAddressRejectsTooFewOctets(): void {
  Test::assertEq<str>(
    webTestAddressError("1.2.3:8080").toStr(),
    "invalid address \"1.2.3:8080\": expected four octets 0-255 like \"127.0.0.1\", or no host (\"*\" or empty) for all interfaces",
  );
}

@test
function parseAddressRejectsTooManyOctets(): void {
  Test::assertEq<str>(
    webTestAddressError("1.2.3.4.5:8080").toStr(),
    "invalid address \"1.2.3.4.5:8080\": expected four octets 0-255 like \"127.0.0.1\", or no host (\"*\" or empty) for all interfaces",
  );
}

@test
function parseAddressRejectsAHostName(): void {
  // Only numeric addresses: no name is resolved.
  Test::assertEq<str>(
    webTestAddressError("localhost:8080").toStr(),
    "invalid address \"localhost:8080\": expected four octets 0-255 like \"127.0.0.1\", or no host (\"*\" or empty) for all interfaces",
  );
}

@test
function parseAddressRejectsANonDigitHost(): void {
  Test::assertEq<str>(
    webTestAddressError("+1.2.3.4:8080").toStr(),
    "invalid address \"+1.2.3.4:8080\": expected four octets 0-255 like \"127.0.0.1\", or no host (\"*\" or empty) for all interfaces",
  );
  Test::assertEq<str>(
    webTestAddressError(" 127.0.0.1:8080").toStr(),
    "invalid address \" 127.0.0.1:8080\": expected four octets 0-255 like \"127.0.0.1\", or no host (\"*\" or empty) for all interfaces",
  );
}

@test
function parseAddressRejectsAnEmptyOctet(): void {
  Test::assertEq<str>(
    webTestAddressError("1..2.3:8080").toStr(),
    "invalid address \"1..2.3:8080\": expected four octets 0-255 like \"127.0.0.1\", or no host (\"*\" or empty) for all interfaces",
  );
}

@test
function parseAddressRejectsAnOutOfRangeOctet(): void {
  Test::assertEq<str>(
    webTestAddressError("256.0.0.1:8080").toStr(),
    "invalid address \"256.0.0.1:8080\": expected an octet 0-255",
  );
}

@test
function parseAddressRejectsALeadingZeroOctet(): void {
  Test::assertEq<str>(
    webTestAddressError("01.2.3.4:8080").toStr(),
    "invalid address \"01.2.3.4:8080\": expected an octet 0-255 without leading zeros",
  );
}

@test
function parseAddressRejectsAPortWithoutDigits(): void {
  Test::assertEq<str>(
    webTestAddressError("127.0.0.1:").toStr(),
    "invalid address \"127.0.0.1:\": expected a port 0-65535",
  );
}

@test
function parseAddressRejectsAnOutOfRangePort(): void {
  Test::assertEq<str>(
    webTestAddressError("127.0.0.1:65536").toStr(),
    "invalid address \"127.0.0.1:65536\": expected a port 0-65535",
  );
  Test::assertEq<str>(
    webTestAddressError("127.0.0.1:999999").toStr(),
    "invalid address \"127.0.0.1:999999\": expected a port 0-65535",
  );
}

@test
function parseAddressRejectsTrailingRubbish(): void {
  Test::assertEq<str>(
    webTestAddressError("127.0.0.1:8080x").toStr(),
    "invalid address \"127.0.0.1:8080x\": expected the address to end after the port",
  );
  Test::assertEq<str>(
    webTestAddressError("127.0.0.1:80x").toStr(),
    "invalid address \"127.0.0.1:80x\": expected the address to end after the port",
  );
}

@test
function configMapsOntoTheServerConfigBelow(): void {
  let config: Web::Config = Web::Config::new();
  Test::assertEq<u64>(config.threads, 8);

  let mut tuned: Web::Config = Web::Config::new();
  tuned.threads = 3;
  let server: Http::ServerConfig = tuned.toServerConfig();
  Test::assertEq<u64>(server.threads, 3);
}

@test
function listenRejectsAnInvalidAddressWithoutBinding(): void {
  let app: WebTestApp = WebTestApp { greeting: "hi" };
  let result: Result<void, Web::ListenError> = Web::listen<WebTestApp>("localhost:8080", app);
  let Result::ERROR(error) = result else {
    Test::assert(false);
    return;
  };

  Test::assertEq<str>(
    error.message().toStr(),
    "invalid address \"localhost:8080\": expected four octets 0-255 like \"127.0.0.1\", or no host (\"*\" or empty) for all interfaces",
  );
}

@test
function listenOnRejectsABadHostWithoutBinding(): void {
  let app: WebTestApp = WebTestApp { greeting: "hi" };
  let result: Result<void, Web::ListenError> = Web::listenOn<WebTestApp>("local host", 8080, app);
  Test::assert(result.isError());
}
