import Hasher from "std::hash";
import Memory, Stats from "std::memory";
import String from "std::string";
import Test from "std::test";

function hashString(value: &String): u64 {
  let mut hasher: Hasher = Hasher::new();
  value.hash(&mut hasher);
  return hasher.finish();
}

function buildInteriorNulString(last: char): String {
  let mut value: String = String::new();
  value.pushChar('a');
  value.pushChar('\0');
  value.pushChar(last);
  return value;
}

function utf8SampleString(): String {
  let raw: *mut u8 = Memory::allocateVector<u8>(6);

  @write<u8>(raw, 'a' as u8);
  @write<u8>(raw + 1, 195 as u8);
  @write<u8>(raw + 2, 169 as u8);
  @write<u8>(raw + 3, 228 as u8);
  @write<u8>(raw + 4, 184 as u8);
  @write<u8>(raw + 5, 173 as u8);

  return String::create(raw, 6 as u64);
}

@test
function hashEqualStringsMatchAndDifferentStringsDiverge(): void {
  let first: String = String::create("alpha");
  let second: String = String::create("alpha");
  let third: String = String::create("beta");

  let firstHash: u64 = hashString(&first);
  let secondHash: u64 = hashString(&second);
  let thirdHash: u64 = hashString(&third);

  Test::assertEq<u64>(firstHash, secondHash);
  Test::assertNe<u64>(firstHash, thirdHash);
}

@test
function hashPreservesInteriorNulBytes(): void {
  let first: String = buildInteriorNulString('b');
  let second: String = buildInteriorNulString('b');
  let third: String = buildInteriorNulString('c');

  let firstHash: u64 = hashString(&first);
  let secondHash: u64 = hashString(&second);
  let thirdHash: u64 = hashString(&third);

  Test::assertEq<u64>(firstHash, secondHash);
  Test::assertNe<u64>(firstHash, thirdHash);
}

@test
function toStrIsZeroCopyBorrowedView(): void {
  let owned: String = String::create("hello");
  let view: str = owned.toStr();

  let viewPtr: u64 = @integerFromPointer(view as *u8);
  let selfPtr: u64 = @integerFromPointer(owned.toStr() as *u8);

  Test::assertEq<u64>(viewPtr, selfPtr);

  let trailing: u8 = @integerFromPointer(view as *u8) + owned.length()
    |> @pointerFromInteger<*mut u8>(_)
    |> @read<u8>(_);

  Test::assertEq<u8>(trailing, 0);
}

@test
function createFromStrCopiesAndPreservesTrailingNul(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(6);

  @write<u8>(raw, 'h' as u8);
  @write<u8>(raw + 1, 'e' as u8);
  @write<u8>(raw + 2, 'l' as u8);
  @write<u8>(raw + 3, 'l' as u8);
  @write<u8>(raw + 4, 'o' as u8);
  @write<u8>(raw + 5, 0);

  let owned: String = String::create(raw as str);
  @write<u8>(raw, 'j' as u8);

  let firstByte: char = match (owned.charAt(0)) {
    Option::SOME(value) -> value,
    _ -> '?',
  };

  Test::assertEq<char>(firstByte, 'h');

  let trailing: u8 = @integerFromPointer(owned.toStr() as *u8) + owned.length()
    |> @pointerFromInteger<*mut u8>(_)
    |> @read<u8>(_);

  Test::assertEq<u8>(trailing, 0);

  Memory::free(raw);
}

@test
function strToStringCopiesIntoOwnedString(): void {
  let text: str = "alpha";
  let owned: String = text.toString();

  Test::assertEq<str>(owned.toStr(), "alpha");
}

@test
function asBytesBorrowsOwnedBytesAndPreservesInteriorNul(): void {
  let owned: String = buildInteriorNulString('b');
  let bytes: u8[] = owned.asBytes();

  Test::assertEq<u8>(bytes[0], 'a' as u8);
  Test::assertEq<u8>(bytes[1], 0);
  Test::assertEq<u8>(bytes[2], 'b' as u8);
}

@test
function strAsBytesBorrowsUntilTerminatingNul(): void {
  let text: str = "az";
  let bytes: u8[] = text.asBytes();

  Test::assertEq<u8>(bytes[0], 'a' as u8);
  Test::assertEq<u8>(bytes[1], 'z' as u8);
}

@test
function strToCharsCopiesAsciiBytesIntoOwnedVector(): void {
  let text: str = "az";
  let chars: Vector<char> = text.toChars();
  let data: *mut char = chars.asPtr() as *mut char;

  Test::assertEq<u64>(chars.length(), 2);
  Test::assertEq<char>(@read<char>(data), 'a');
  Test::assertEq<char>(@read<char>(data + 1), 'z');
}

@test
function strToCharsStopsAtFirstTerminatingNul(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(4);

  @write<u8>(raw, 'a' as u8);
  @write<u8>(raw + 1, 'z' as u8);
  @write<u8>(raw + 2, 0);
  @write<u8>(raw + 3, 'q' as u8);

  let text: str = raw as str;
  let chars: Vector<char> = text.toChars();
  let data: *mut char = chars.asPtr() as *mut char;

  Test::assertEq<u64>(chars.length(), 2);
  Test::assertEq<char>(@read<char>(data), 'a');
  Test::assertEq<char>(@read<char>(data + 1), 'z');

  Memory::free(raw);
}

@test
function charAtDecodesUtf8ScalarAtByteBoundary(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(6);
  @write<u8>(raw, 'a' as u8);
  @write<u8>(raw + 1, 195 as u8);
  @write<u8>(raw + 2, 169 as u8);
  @write<u8>(raw + 3, 228 as u8);
  @write<u8>(raw + 4, 184 as u8);
  @write<u8>(raw + 5, 173 as u8);

  let text: String = String::create(raw, 6 as u64);

  let first: char = match (text.charAt(0)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let accented: char = match (text.charAt(1)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let ideograph: char = match (text.charAt(3)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };

  Test::assertEq<i32>(first as i32, 'a' as i32);
  Test::assertEq<i32>(accented as i32, 233);
  Test::assertEq<i32>(ideograph as i32, 20013);

  Memory::free(raw);
}

@test
function pushCharEncodesScalarUtf8BytesAndPushByteStaysByteOriented(): void {
  let mut text: String = String::new();
  text.pushChar('é');
  text.pushByte('!' as u8);

  let first: u8 = match (text.byteAt(0)) {
    Option::SOME(value) -> value,
    Option::NONE -> 0,
  };
  let second: u8 = match (text.byteAt(1)) {
    Option::SOME(value) -> value,
    Option::NONE -> 0,
  };
  let third: u8 = match (text.byteAt(2)) {
    Option::SOME(value) -> value,
    Option::NONE -> 0,
  };

  Test::assertEq<u64>(text.length(), 3);
  Test::assertEq<u8>(first, 195 as u8);
  Test::assertEq<u8>(second, 169 as u8);
  Test::assertEq<u8>(third, '!' as u8);
}

@test
function byteAtReadsRawUtf8BytesWithoutScalarDecoding(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(2);
  @write<u8>(raw, 195 as u8);
  @write<u8>(raw + 1, 169 as u8);

  let text: String = String::create(raw, 2 as u64);

  let first: u8 = match (text.byteAt(0)) {
    Option::SOME(value) -> value,
    Option::NONE -> 0,
  };
  let second: u8 = match (text.byteAt(1)) {
    Option::SOME(value) -> value,
    Option::NONE -> 0,
  };

  Test::assertEq<u8>(first, 195 as u8);
  Test::assertEq<u8>(second, 169 as u8);

  Memory::free(raw);
}

@test
function stringHelpersCoverPrefixesSlicesTrimmingAndLines(): void {
  let text: String = String::create("  alpha\nbeta\n  ");
  let trimmed: String = text.trimAsciiWhitespace();
  let expectedFirstLine: str = "alpha";
  let lines: Vector<String> = trimmed.lines();
  let firstLine: &String = match (lines.get(0)) {
    Option::SOME(value) -> value,
    Option::NONE -> {
      Test::fail();
      @unreachable();
    },
  };
  let secondLine: &String = match (lines.get(1)) {
    Option::SOME(value) -> value,
    Option::NONE -> {
      Test::fail();
      @unreachable();
    },
  };

  Test::assert(text.startsWith("  al"));
  Test::assert(!text.startsWith("alpha"));
  Test::assert(trimmed.equals("alpha\nbeta"));
  Test::assert(expectedFirstLine.equals(firstLine.toStr()));
  Test::assertEq<u64>(match (text.indexOfCharFrom('a', 0)) { Option::SOME(value) -> value, Option::NONE -> 99 }, 2);
  Test::assertEq<str>(trimmed.toStr(), "alpha\nbeta");
  Test::assertEq<u64>(lines.length(), 2);
  Test::assertEq<str>(firstLine.toStr(), "alpha");
  Test::assertEq<str>(secondLine.toStr(), "beta");
}

@test
function indexOfCharFromSkipsUtf8ContinuationBytesWhenLookingForReplacementChar(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(1);
  @write<u8>(raw, 255 as u8);

  let malformed: String = String::create(raw, 1 as u64);
  let replacement: char = match (malformed.charAt(0)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let validUtf8: *mut u8 = Memory::allocateVector<u8>(2);
  @write<u8>(validUtf8, 195 as u8);
  @write<u8>(validUtf8 + 1, 169 as u8);

  let source: String = String::create(validUtf8, 2 as u64);

  Test::assert(match (source.indexOfCharFrom(replacement, 0)) {
    Option::SOME(_) -> false,
    Option::NONE -> true,
  });
  Test::assert(match (source.indexOfCharFrom(replacement, 1)) {
    Option::SOME(_) -> false,
    Option::NONE -> true,
  });

  Memory::free(raw);
  Memory::free(validUtf8);
}

@test
function indexOfCharFromStillFindsActualReplacementChars(): void {
  let mut source: String = String::new();
  source.pushChar('a');
  source.pushChar(65533 as char);
  source.pushChar('é');

  let index: u64 = match (source.indexOfCharFrom(65533 as char, 0)) {
    Option::SOME(value) -> value,
    Option::NONE -> 99,
  };

  Test::assertEq<u64>(index, 1);
}

@test
function charAtReportsUtf8ScalarEndBytes(): void {
  let source: String = utf8SampleString();
  let mut firstEnd: u64 = 0;
  let mut secondEnd: u64 = 0;
  let mut thirdEnd: u64 = 0;

  let first: char = match (source.charAt(0, &mut firstEnd)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let second: char = match (source.charAt(firstEnd, &mut secondEnd)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let third: char = match (source.charAt(secondEnd, &mut thirdEnd)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };

  Test::assertEq<i32>(first as i32, 'a' as i32);
  Test::assertEq<u64>(firstEnd, 1);
  Test::assertEq<i32>(second as i32, 233);
  Test::assertEq<u64>(secondEnd, 3);
  Test::assertEq<i32>(third as i32, 20013);
  Test::assertEq<u64>(thirdEnd, 6);
}

@test
function charAtEndBytesCanDriveUtf8ByteSlices(): void {
  let source: String = utf8SampleString();
  let mut endByte: u64 = 0;
  let Option::SOME(_) = source.charAt(1, &mut endByte) else {
    Test::fail();
    @unreachable();
  };

  let value: String = source.substringBytes(1, endByte);
  let first: char = match (value.charAt(0)) {
    Option::SOME(current) -> current,
    Option::NONE -> '?',
  };

  Test::assertEq<i32>(first as i32, 233);
  Test::assertEq<u64>(value.length(), 2);
  Test::assertEq<u64>(endByte, 3);
}

@test
function charAtReturnsNoneAtOrPastTheEnd(): void {
  let source: String = utf8SampleString();
  let mut endByte: u64 = 99;

  Test::assert(match (source.charAt(source.length(), &mut endByte)) {
    Option::SOME(_) -> false,
    Option::NONE -> true,
  });
  Test::assertEq<u64>(endByte, source.length());
}

@test
function forEachDecodesUtf8Scalars(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(6);
  @write<u8>(raw, 'a' as u8);
  @write<u8>(raw + 1, 195 as u8);
  @write<u8>(raw + 2, 169 as u8);
  @write<u8>(raw + 3, 228 as u8);
  @write<u8>(raw + 4, 184 as u8);
  @write<u8>(raw + 5, 173 as u8);

  let text: String = String::create(raw, 6 as u64);
  let visited: *mut char = Memory::allocateVector<char>(3);
  let index: *mut u64 = Memory::allocateVector<u64>(1);
  @write<u64>(index, 0);

  text.forEach((value: char): void -> {
    let current: u64 = @read<u64>(index);
    @write<char>(visited + current, value);
    @write<u64>(index, current + 1);
  });

  let count: u64 = @read<u64>(index);
  let first: char = @read<char>(visited);
  let accented: char = @read<char>(visited + 1);
  let ideograph: char = @read<char>(visited + 2);

  Test::assertEq<u64>(count, 3);
  Test::assertEq<i32>(first as i32, 'a' as i32);
  Test::assertEq<i32>(accented as i32, 233);
  Test::assertEq<i32>(ideograph as i32, 20013);

  Memory::free(visited);
  Memory::free(index as *mut u8);
  Memory::free(raw);
}

@test
function mapDecodesUtf8Scalars(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(5);
  @write<u8>(raw, 195 as u8);
  @write<u8>(raw + 1, 169 as u8);
  @write<u8>(raw + 2, 228 as u8);
  @write<u8>(raw + 3, 184 as u8);
  @write<u8>(raw + 4, 173 as u8);

  let text: String = String::create(raw, 5 as u64);
  let mapped: String = text.map((value: char): char -> {
    if (value == 'é') {
      return 'x';
    }

    if (value == 20013 as char) {
      return 'y';
    }

    return '?';
  });

  let first: char = match (mapped.charAt(0)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let second: char = match (mapped.charAt(1)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };

  Test::assertEq<u64>(mapped.length(), 2);
  Test::assertEq<char>(first, 'x');
  Test::assertEq<char>(second, 'y');

  Memory::free(raw);
}

@test
function charAtReplacesMalformedUtf8AndAdvancesOneByte(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(4);
  @write<u8>(raw, 255 as u8);
  @write<u8>(raw + 1, 'a' as u8);
  @write<u8>(raw + 2, 195 as u8);
  @write<u8>(raw + 3, 169 as u8);

  let source: String = String::create(raw, 4 as u64);
  let mut firstEnd: u64 = 0;
  let mut secondEnd: u64 = 0;
  let mut thirdEnd: u64 = 0;

  let first: char = match (source.charAt(0, &mut firstEnd)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let second: char = match (source.charAt(firstEnd, &mut secondEnd)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let third: char = match (source.charAt(secondEnd, &mut thirdEnd)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };

  Test::assertEq<i32>(first as i32, 65533);
  Test::assertEq<u64>(firstEnd, 1);
  Test::assertEq<i32>(second as i32, 'a' as i32);
  Test::assertEq<u64>(secondEnd, 2);
  Test::assertEq<i32>(third as i32, 233);
  Test::assertEq<u64>(thirdEnd, 4);

  Memory::free(raw);
}

@test
function charAtReturnsReplacementForMalformedContinuationBytes(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(2);
  @write<u8>(raw, 128 as u8);
  @write<u8>(raw + 1, 'b' as u8);

  let source: String = String::create(raw, 2 as u64);
  let mut malformedEnd: u64 = 0;
  let mut trailingEnd: u64 = 0;

  let malformed: char = match (source.charAt(0, &mut malformedEnd)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };
  let trailing: char = match (source.charAt(malformedEnd, &mut trailingEnd)) {
    Option::SOME(value) -> value,
    Option::NONE -> '?',
  };

  Test::assertEq<i32>(malformed as i32, 65533);
  Test::assertEq<u64>(malformedEnd, 1);
  Test::assertEq<char>(trailing, 'b');
  Test::assertEq<u64>(trailingEnd, 2);

  Memory::free(raw);
}

@test
function snapshotStdRunnerSmoke(): void {
  Test::assertSnapshot("smoke", "std-string-smoke\n");
}

@test
function charToStringRendersAsciiScalar(): void {
  let value: char = 'a';
  let rendered: String = value.toString();

  Test::assertEq<str>(rendered.toStr(), "a");
}

@test
function charToStringRendersMultiByteScalar(): void {
  let value: char = 'é';
  let rendered: String = value.toString();

  Test::assertEq<u64>(rendered.length(), 2 as u64);
}

@test
function concatCharAppendsScalar(): void {
  let base: String = String::create("ab");
  let value: char = 'c';
  let joined: String = base.concat(value);

  Test::assertEq<str>(joined.toStr(), "abc");
}

@test
function concatBooleanAppendsLiteralWord(): void {
  let base: String = String::create("ok: ");

  Test::assertEq<str>(base.concat(true).toStr(), "ok: true");
  Test::assertEq<str>(base.concat(false).toStr(), "ok: false");
}

@test
function concatBorrowedValuesMatchesByValueOverloads(): void {
  let base: String = String::create("v=");
  let number: i32 = 42;
  let flag: boolean = false;
  let letter: char = 'z';
  let slice: str = "tail";

  Test::assertEq<str>(base.concat(&number).toStr(), "v=42");
  Test::assertEq<str>(base.concat(&flag).toStr(), "v=false");
  Test::assertEq<str>(base.concat(&letter).toStr(), "v=z");
  Test::assertEq<str>(base.concat(&slice).toStr(), "v=tail");
}

@test
function concatBorrowedStringDoesNotConsumeIt(): void {
  let base: String = String::create("a");
  let tail: String = String::create("b");

  Test::assertEq<str>(base.concat(&tail).toStr(), "ab");
  Test::assertEq<str>(base.concat(&tail).toStr(), "ab");
  Test::assertEq<str>(tail.toStr(), "b");
}

@test
function newAllocatesTheDefaultCapacityFloor(): void {
  let before: Stats = Memory::stats();

  {
    let value: String = String::new();
    let during: Stats = Memory::stats();

    Test::assertEq<u64>(value.length(), 0);
    Test::assertEq<u64>(during.bytesLive, before.bytesLive + 16);
    Test::assertEq<u64>(during.allocTotal, before.allocTotal + 1);
  }

  let after: Stats = Memory::stats();

  Test::assertEq<u64>(after.bytesLive, before.bytesLive);
  Test::assertEq<u64>(after.allocsLive, before.allocsLive);
}

@test
function withCapacityAlwaysReservesRoomForTheTerminator(): void {
  let before: Stats = Memory::stats();
  let empty: String = String::withCapacity(0);
  let after: Stats = Memory::stats();

  Test::assertEq<u64>(empty.length(), 0);
  Test::assertEq<u64>(after.bytesLive, before.bytesLive + 1);
}

@test
function capacityDoublesOnlyWhenTheTerminatorNoLongerFits(): void {
  let before: Stats = Memory::stats();
  let mut value: String = String::new();

  let mut index: u64 = 0;
  while (index < 15) {
    value.pushByte('x' as u8);
    index += 1;
  }

  Test::assertEq<u64>(value.length(), 15);
  Test::assertEq<u64>(Memory::stats().bytesLive, before.bytesLive + 16);

  value.pushByte('y' as u8);

  Test::assertEq<u64>(value.length(), 16);
  Test::assertEq<u64>(Memory::stats().bytesLive, before.bytesLive + 32);
}

@test
function reserveGrowsOnlyWhenTheRequestExceedsTheCapacity(): void {
  let before: Stats = Memory::stats();
  let mut value: String = String::withCapacity(8);

  value.reserve(7);
  Test::assertEq<u64>(Memory::stats().bytesLive, before.bytesLive + 8);

  value.reserve(8);
  Test::assertEq<u64>(Memory::stats().bytesLive, before.bytesLive + 16);
}

@test
function clearEmptiesTheStringWithoutReleasingCapacity(): void {
  let before: Stats = Memory::stats();
  let mut value: String = String::create("hello");
  let allocated: Stats = Memory::stats();

  value.clear();

  Test::assertEq<u64>(value.length(), 0);
  Test::assertEq<str>(value.toStr(), "");
  Test::assertEq<u64>(Memory::stats().bytesLive, allocated.bytesLive);

  value.pushStr("again");
  Test::assertEq<str>(value.toStr(), "again");
  Test::assertEq<u64>(Memory::stats().bytesLive, before.bytesLive + 6);
}

@test
function cloneCopiesBytesIntoAnIndependentAllocation(): void {
  let mut original: String = String::create("source");
  let copy: String = original.clone();

  let copyPtr: u64 = @integerFromPointer(copy.toStr() as *u8);
  let originalPtr: u64 = @integerFromPointer(original.toStr() as *u8);

  Test::assertNe<u64>(copyPtr, originalPtr);

  original.pushStr("-changed");

  Test::assertEq<str>(copy.toStr(), "source");
  Test::assertEq<str>(original.toStr(), "source-changed");
}

@test
function pushCharReplacesSurrogatesWithTheReplacementCharacter(): void {
  let mut value: String = String::new();
  value.pushChar(55296 as char);

  Test::assertEq<u64>(value.length(), 3);
  Test::assertEq<u8>(value.byteAt(0 as u64).unwrap(), 239 as u8);
  Test::assertEq<u8>(value.byteAt(1 as u64).unwrap(), 191 as u8);
  Test::assertEq<u8>(value.byteAt(2 as u64).unwrap(), 189 as u8);
}

@test
function pushCharEncodesEveryUtf8Width(): void {
  let mut value: String = String::new();

  value.pushChar('a');
  Test::assertEq<u64>(value.length(), 1);

  value.pushChar(233 as char);
  Test::assertEq<u64>(value.length(), 3);

  value.pushChar(20013 as char);
  Test::assertEq<u64>(value.length(), 6);

  value.pushChar(128512 as char);
  Test::assertEq<u64>(value.length(), 10);
}

@test
function createFromLenPreservesInteriorNulBytesAndTerminates(): void {
  let raw: *mut u8 = Memory::allocateVector<u8>(3);

  @write<u8>(raw, 'a' as u8);
  @write<u8>(raw + 1, 0 as u8);
  @write<u8>(raw + 2, 'b' as u8);

  let value: String = String::create(raw, 3 as u64);
  Memory::free(raw);

  Test::assertEq<u64>(value.length(), 3);
  Test::assertEq<u8>(value.byteAt(1 as u64).unwrap(), 0 as u8);
  Test::assertEq<u8>(value.byteAt(2 as u64).unwrap(), 'b' as u8);

  let trailing: u8 = @integerFromPointer(value.toStr() as *u8) + value.length()
    |> @pointerFromInteger<*mut u8>(_)
    |> @read<u8>(_);

  Test::assertEq<u8>(trailing, 0);
}

@test
function compareOrdersByBytesAndThenByLength(): void {
  let shorter: String = String::create("abc");
  let longer: String = String::create("abcd");
  let higher: String = String::create("abd");
  let same: String = String::create("abc");

  Test::assertEq<i32>(shorter.compare(&same), 0);
  Test::assertEq<i32>(shorter.compare(&longer), -1);
  Test::assertEq<i32>(longer.compare(&shorter), 1);
  Test::assertEq<i32>(shorter.compare(&higher), -1);
  Test::assertEq<i32>(higher.compare(&shorter), 1);
}

@test
function compareIsByteOrderedAcrossTheSignedCharBoundary(): void {
  let mut low: String = String::new();
  low.pushByte(127 as u8);

  let mut high: String = String::new();
  high.pushByte(200 as u8);

  Test::assertEq<i32>(low.compare(&high), -1);
  Test::assertEq<i32>(high.compare(&low), 1);
}

@test
function compareLooksPastInteriorNulBytes(): void {
  let first: String = buildInteriorNulString('b');
  let second: String = buildInteriorNulString('c');

  Test::assertEq<i32>(first.compare(&second), -1);
  Test::assertEq<boolean>(first.equals(&second), false);
}

@test
function indexOfIsLengthAwareAndFindsTheFirstMatch(): void {
  let haystack: String = String::create("abcabc");
  let needle: String = String::create("bc");
  let missing: String = String::create("bd");
  let empty: String = String::create("");
  let tooLong: String = String::create("abcabcd");

  Test::assertEq<u64>(haystack.indexOf(&needle).unwrap(), 1);
  Test::assertEq<boolean>(haystack.indexOf(&missing).isSome(), false);
  Test::assertEq<u64>(haystack.indexOf(&empty).unwrap(), 0);
  Test::assertEq<boolean>(haystack.indexOf(&tooLong).isSome(), false);
  Test::assertEq<boolean>(haystack.contains(&needle), true);
  Test::assertEq<boolean>(haystack.contains(&missing), false);
}

@test
function indexOfSearchesPastInteriorNulBytes(): void {
  let haystack: String = buildInteriorNulString('b');
  let needle: String = String::create("b");

  Test::assertEq<u64>(haystack.indexOf(&needle).unwrap(), 2);
  Test::assertEq<boolean>(haystack.contains(&needle), true);
}

@test
function forEachDecodesEveryScalarAndAdvancesPastMalformedBytes(): void {
  let sample: String = utf8SampleString();
  let mut visited: u64 = 0;
  let mut codePoints: u64 = 0;

  sample.forEach((value: char): void -> {
    visited += 1;
    codePoints = codePoints * 100000 + (value as u32) as u64;
  });

  Test::assertEq<u64>(visited, 3);
  Test::assertEq<u64>(codePoints, 970023320013 as u64);

  let mut malformed: String = String::new();
  malformed.pushByte(195 as u8);
  malformed.pushByte('z' as u8);

  let mut replacements: u64 = 0;
  malformed.forEach((value: char): void -> {
    if (value as u32 == 65533) {
      replacements += 1;
    }
  });

  Test::assertEq<u64>(replacements, 1);
}

@test
function substringClampsItsStartAndLengthToTheOwnedBytes(): void {
  let value: String = String::create("hello world");

  Test::assertEq<str>(value.substring(6, 5).toStr(), "world");
  Test::assertEq<str>(value.substring(6, 99).toStr(), "world");
  Test::assertEq<str>(value.substring(-3, 5).toStr(), "hello");
  Test::assertEq<str>(value.substring(11, 1).toStr(), "");
  Test::assertEq<str>(value.substring(2, 0).toStr(), "");
  Test::assertEq<str>(value.substring(2, -1).toStr(), "");
}

@test
function substringOfAnEmptyStringIsEmpty(): void {
  let empty: String = String::create("");

  Test::assertEq<u64>(empty.substring(0, 4).length(), 0);
}

@test
function substringCopiesInteriorNulBytes(): void {
  let value: String = buildInteriorNulString('b');
  let slice: String = value.substring(1, 2);

  Test::assertEq<u64>(slice.length(), 2);
  Test::assertEq<u8>(slice.byteAt(0 as u64).unwrap(), 0 as u8);
  Test::assertEq<u8>(slice.byteAt(1 as u64).unwrap(), 'b' as u8);
}

@test
function concatKeepsAllOwnedBytesOfBothOperands(): void {
  let left: String = buildInteriorNulString('b');
  let right: String = String::create("cd");
  let joined: String = left.concat(&right);

  Test::assertEq<u64>(joined.length(), 5);
  Test::assertEq<u8>(joined.byteAt(1 as u64).unwrap(), 0 as u8);
  Test::assertEq<u8>(joined.byteAt(4 as u64).unwrap(), 'd' as u8);
}

@test
function caseConversionMapsAsciiAndReplacesEveryNonAsciiByte(): void {
  let ascii: String = String::create("Hello, World 42!");

  Test::assertEq<str>(ascii.toUpperCase().toStr(), "HELLO, WORLD 42!");
  Test::assertEq<str>(ascii.toLowerCase().toStr(), "hello, world 42!");

  // Byte-oriented conversion: each byte of the two-byte scalar becomes U+FFFD.
  let mut accented: String = String::new();
  accented.pushByte('h' as u8);
  accented.pushChar(233 as char);

  let upper: String = accented.toUpperCase();

  Test::assertEq<u64>(accented.length(), 3);
  Test::assertEq<u64>(upper.length(), 7);
  Test::assertEq<u8>(upper.byteAt(0 as u64).unwrap(), 'H' as u8);
  Test::assertEq<u8>(upper.byteAt(1 as u64).unwrap(), 239 as u8);
  Test::assertEq<u8>(upper.byteAt(2 as u64).unwrap(), 191 as u8);
  Test::assertEq<u8>(upper.byteAt(3 as u64).unwrap(), 189 as u8);
  Test::assertEq<u8>(upper.byteAt(4 as u64).unwrap(), 239 as u8);
}

@test
function numericCreateRendersEveryIntegerWidthAsDecimal(): void {
  Test::assertEq<str>(String::create(0 as u64).toStr(), "0");
  Test::assertEq<str>(String::create(7 as u8).toStr(), "7");
  Test::assertEq<str>(String::create(255 as u8).toStr(), "255");
  Test::assertEq<str>(String::create(65535 as u16).toStr(), "65535");
  Test::assertEq<str>(String::create(4294967295 as u32).toStr(), "4294967295");
  Test::assertEq<str>(String::create(18446744073709551615 as u64).toStr(), "18446744073709551615");
}

@test
function numericCreateRendersSignedValuesIncludingTheMinimums(): void {
  Test::assertEq<str>(String::create(-1 as i8).toStr(), "-1");
  Test::assertEq<str>(String::create(-128 as i8).toStr(), "-128");
  Test::assertEq<str>(String::create(127 as i8).toStr(), "127");
  Test::assertEq<str>(String::create(-32768 as i16).toStr(), "-32768");
  Test::assertEq<str>(String::create(-2147483648 as i32).toStr(), "-2147483648");
  Test::assertEq<str>(String::create(-9223372036854775808 as i64).toStr(), "-9223372036854775808");
  Test::assertEq<str>(String::create(9223372036854775807 as i64).toStr(), "9223372036854775807");
}

@test
function numericCreateReservesExactlyTheDigitsPlusTheTerminator(): void {
  let before: Stats = Memory::stats();
  let rendered: String = String::create(4096 as u64);
  let after: Stats = Memory::stats();

  Test::assertEq<u64>(rendered.length(), 4);
  Test::assertEq<u64>(after.bytesLive, before.bytesLive + 5);
  Test::assertEq<u64>(after.allocTotal, before.allocTotal + 1);
}

@test
function toStringExtensionsMatchTheCreateOverloads(): void {
  let negative: i32 = -42;
  let positive: u32 = 42;
  let zero: i64 = 0;

  Test::assertEq<str>(negative.toString().toStr(), "-42");
  Test::assertEq<str>(positive.toString().toStr(), "42");
  Test::assertEq<str>(zero.toString().toStr(), "0");
}

@test
function floatCreateMatchesTheRuntimeGFormat(): void {
  let pi: f64 = 3.14;
  let small: f64 = 0.0001;
  let large: f64 = 1000000000000000000000.0;
  let sevenDigits: f64 = 1234567.0;
  let zero: f64 = 0.0;
  let whole: f64 = 42.0;

  Test::assertEq<str>(String::create(pi).toStr(), "3.14");
  Test::assertEq<str>(String::create(small).toStr(), "0.0001");
  Test::assertEq<str>(String::create(large).toStr(), "1e+21");
  Test::assertEq<str>(String::create(sevenDigits).toStr(), "1.23457e+06");
  Test::assertEq<str>(String::create(zero).toStr(), "0");
  Test::assertEq<str>(String::create(whole).toStr(), "42");
}

@test
function floatCreateRoundsToSixSignificantDigitsAtTheTie(): void {
  let tie: f64 = 123456.5;
  let negative: f64 = -2.5;
  let repeating: f64 = 0.1;

  Test::assertEq<str>(String::create(tie).toStr(), "123456");
  Test::assertEq<str>(String::create(negative).toStr(), "-2.5");
  Test::assertEq<str>(String::create(repeating).toStr(), "0.1");
}

@test
function floatCreateNarrowsF32ThroughTheSameFormat(): void {
  let tenth: f32 = 0.1;
  let half: f32 = 0.5;

  Test::assertEq<str>(String::create(tenth).toStr(), "0.1");
  Test::assertEq<str>(String::create(half).toStr(), "0.5");
}

@test
function floatToStringExtensionsMatchTheCreateOverloads(): void {
  let wide: f64 = -0.5;
  let narrow: f32 = 2.25;

  Test::assertEq<str>(wide.toString().toStr(), "-0.5");
  Test::assertEq<str>(narrow.toString().toStr(), "2.25");
}
