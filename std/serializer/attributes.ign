//!
//! # Serializer Attributes
//!
//! The declarable attributes the reflective `Serialize` default reads.
//!
//! ## Exports
//!
//! | Export               | Description                                         |
//! |----------------------|-----------------------------------------------------|
//! | `Serializer::Rename` | `@Serializer::Rename("key")` on a field: the key written instead of the field name |

/// The attributes of the reflective `Serialize` default.
export namespace Serializer {
  /// The key a field is written under, when it differs from the field name.
  /// The selected writer still validates it: TOML accepts only bare keys.
  @attribute(field)
  export record Rename {
    /// The key to write.
    public name: str;
  }
}
