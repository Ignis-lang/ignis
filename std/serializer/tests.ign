import Eq, Hash, HashMap from "std::collections";
import Hasher from "std::hash";
import Json from "std::json";
import Serialize, Serializer from "std::serializer";
import Test from "std::test";
import Toml, TomlDocument from "std::toml";

@implements(Hash, Eq)
record Key {
  public id: i32;
  public bucket: u64;

  hash(&self, hasher: &mut Hasher): void {
    let mut state: &mut Hasher = hasher;
    state.writeU64(self.bucket);
  }

  public equals(&self, other: &Key): boolean {
    return self.id == other.id;
  }
}

@implements(Serialize)
record Payload {
  public value: i32;
  public name: str;

  serialize(
    &self,
    output: &mut String,
    writer: &Serializer::Writer
  ): Result<boolean, Serializer::Error> {
    Serializer::beginRecord(output, writer)!;
    Serializer::writeField(output, "value", writer, true)!;
    Serializer::write(output, self.value, writer)!;
    Serializer::writeField(output, "name", writer, false)!;
    Serializer::write(output, self.name, writer)!;
    Serializer::endRecord(output, writer)!;

    return Result::OK(true);
  }
}

function assertOkString(value: Result<String, Serializer::Error>, expected: str): void {
  match (value) {
    Result::OK(text) -> Test::assertEq<str>(text.toStr(), expected),
    Result::ERROR(_) -> Test::fail(),
  };
}

@test
function jsonScalarEntrypointsRoundTrip(): void {
  assertOkString(Json::stringify(true), "true");
  assertOkString(Json::stringify(42), "42");
  assertOkString(Json::stringify("line\n\"quoted\""), "\"line\\n\\\"quoted\\\"\"");
}

@test
function recordHelpersSupportJsonAndToml(): void {
  let payload: Payload = Payload { value: 7, name: "ignis" };
  let mut json: String = String::new();
  let mut toml: String = String::new();
  let jsonWriter: Serializer::Writer = Json::writer();
  let tomlWriter: Serializer::Writer = Toml::writer();

  match (payload.serialize(&mut json, &jsonWriter)) {
    Result::OK(_) -> Test::assertEq<str>(json.toStr(), "{\"value\":7,\"name\":\"ignis\"}"),
    Result::ERROR(_) -> Test::fail(),
  };

  match (payload.serialize(&mut toml, &tomlWriter)) {
    Result::OK(_) -> Test::assertEq<str>(toml.toStr(), "value = 7\nname = \"ignis\""),
    Result::ERROR(_) -> Test::fail(),
  };
}

@test
function tomlRejectsScalarRoots(): void {
  match (Toml::stringify(42)) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> Test::assert(error.kind == Serializer::ErrorKind::UNSUPPORTED_ROOT_SHAPE),
  };
}

@test
function coreSupportsCustomWriterLayouts(): void {
  let payload: Payload = Payload { value: 7, name: "ignis" };
  let mut output: String = String::new();
  let writer: Serializer::Writer = Serializer::Writer {
    recordPrefix: "<",
    recordSuffix: ">",
    entrySeparator: " | ",
    fieldSeparator: " => ",
    supportsScalarRoot: true,
    quoteFieldKeys: false,
    nestedRecordPrefix: "<",
    nestedRecordSuffix: ">",
    nestedEntrySeparator: " | ",
    depth: 0,
  };

  match (payload.serialize(&mut output, &writer)) {
    Result::OK(_) -> Test::assertEq<str>(output.toStr(), "<value => 7 | name => \"ignis\">"),
    Result::ERROR(_) -> Test::fail(),
  };
}

@test
function serializerSurfaceAndHashMapTraversalStayStable(): void {
  let mut map: HashMap<Key, i32> = HashMap::new<Key, i32>();
  let payload: Payload = Payload { value: 7, name: "ignis" };
  let jsonResult: Result<String, Serializer::Error> = Json::stringify<Payload>(&payload);
  let tomlResult: Result<String, Serializer::Error> = Toml::stringify<Payload>(&payload);
  let _jsonSurface: Result<String, Serializer::Error> = jsonResult;
  let _tomlSurface: Result<String, Serializer::Error> = tomlResult;

  map.insert(Key { id: 2, bucket: 1 }, 2);
  map.insert(Key { id: 1, bucket: 1 }, 1);

  let mut firstOrder: i32 = 0;
  let mut cursor: Option<u64> = map.firstEntryCursor();
  while (true) {
    match (cursor) {
      Option::SOME(entryCursor) -> {
        firstOrder = (firstOrder * 100) + (map.entryKey(entryCursor).id * 10) + *map.entryValue(entryCursor);
        cursor = map.nextEntryCursor(entryCursor);
      },
      Option::NONE -> {
        break;
      },
    };
  }

  let mut secondOrder: i32 = 0;
  cursor = map.firstEntryCursor();
  while (true) {
    match (cursor) {
      Option::SOME(entryCursor) -> {
        secondOrder = (secondOrder * 100) + (map.entryKey(entryCursor).id * 10) + *map.entryValue(entryCursor);
        cursor = map.nextEntryCursor(entryCursor);
      },
      Option::NONE -> {
        break;
      },
    };
  }

  Test::assert(firstOrder != 0);
  Test::assertEq<i32>(firstOrder, secondOrder);
}

@implements(Serialize)
record Owner {
  @Serializer::Rename("display-name")
  public name: String;
  public age: u8;
}

@implements(Serialize)
record Account {
  public id: i64;
  public active: boolean;
  public score: f64;
  public grade: char;
  public tag: str;
  public owner: Owner;
}

function sampleAccount(): Account {
  return Account {
    id: 42,
    active: true,
    score: 2.5,
    grade: 'A',
    tag: "line\n",
    owner: Owner { name: String::create("Ada"), age: 36 },
  };
}

@test
function reflectiveSerializeWritesJsonInDeclarationOrder(): void {
  let account: Account = sampleAccount();

  assertOkString(
    Json::stringify<Account>(&account),
    "{\"id\":42,\"active\":true,\"score\":2.5,\"grade\":\"A\",\"tag\":\"line\\n\",\"owner\":{\"display-name\":\"Ada\",\"age\":36}}",
  );
}

@test
function reflectiveSerializeWritesTomlWithRenamedFields(): void {
  let owner: Owner = Owner { name: String::create("Ada"), age: 36 };

  assertOkString(Toml::stringify<Owner>(&owner), "display-name = \"Ada\"\nage = 36");
}

@test
function handWrittenSerializeReplacesTheDefault(): void {
  let payload: Payload = Payload { value: 7, name: "ignis" };

  assertOkString(Json::stringify<Payload>(&payload), "{\"value\":7,\"name\":\"ignis\"}");
}

@implements(Serialize)
record Point {
  public x: i32;
  public label: str;
}

@implements(Serialize)
record Shape {
  public name: str;
  public origin: Point;
}

@implements(Serialize)
record Inner {
  public a: i32;
  public b: str;
}

@implements(Serialize)
record Middle {
  public level: i32;
  public inner: Inner;
}

@implements(Serialize)
record Outer {
  public id: i32;
  public middle: Middle;
}

@implements(Serialize)
record Wrapper {
  public payload: Payload;
}

@implements(Serialize)
record Envelope {
  public tag: str;
  public payload: Payload;

  serialize(
    &self,
    output: &mut String,
    writer: &Serializer::Writer
  ): Result<boolean, Serializer::Error> {
    let nested: Serializer::Writer = Serializer::nested(writer);

    Serializer::beginRecord(output, writer)!;
    Serializer::writeField(output, "tag", writer, true)!;
    Serializer::write(output, self.tag, writer)!;
    Serializer::writeField(output, "payload", writer, false)!;
    self.payload.serialize(output, &nested)!;

    return Serializer::endRecord(output, writer);
  }
}

function sampleOuter(): Outer {
  return Outer { id: 1, middle: Middle { level: 2, inner: Inner { a: 3, b: "x" } } };
}

function parseOk(text: &String): TomlDocument {
  let Result::OK(document) = Toml::parse(text) else {
    Test::fail();
    @unreachable();
  };

  return document;
}

function stringifyOk(value: Result<String, Serializer::Error>): String {
  let Result::OK(text) = value else {
    Test::fail();
    @unreachable();
  };

  return text;
}

function assertTomlInteger(document: &TomlDocument, path: str, expected: i64): void {
  let Option::SOME(value) = document.get(path) else {
    Test::fail();
    @unreachable();
  };

  Test::assertEq<i64>(value.asInteger(), expected);
}

function assertTomlString(document: &TomlDocument, path: str, expected: str): void {
  let Result::OK(value) = document.getString(path) else {
    Test::fail();
    @unreachable();
  };

  Test::assertEq<str>(value, expected);
}

@test
function reflectiveSerializeWritesNestedTomlRecordAsInlineTable(): void {
  let shape: Shape = Shape { name: "unit", origin: Point { x: 1, label: "p" } };
  let text: String = stringifyOk(Toml::stringify<Shape>(&shape));

  Test::assertEq<str>(text.toStr(), "name = \"unit\"\norigin = { x = 1, label = \"p\" }");

  let document: TomlDocument = parseOk(&text);
  assertTomlString(&document, "name", "unit");
  assertTomlInteger(&document, "origin.x", 1);
  assertTomlString(&document, "origin.label", "p");
}

@test
function reflectiveSerializeWritesTwoLevelsOfNestedTomlRecords(): void {
  let outer: Outer = sampleOuter();
  let text: String = stringifyOk(Toml::stringify<Outer>(&outer));

  Test::assertEq<str>(text.toStr(), "id = 1\nmiddle = { level = 2, inner = { a = 3, b = \"x\" } }");

  let document: TomlDocument = parseOk(&text);
  assertTomlInteger(&document, "id", 1);
  assertTomlInteger(&document, "middle.level", 2);
  assertTomlInteger(&document, "middle.inner.a", 3);
  assertTomlString(&document, "middle.inner.b", "x");
}

@test
function reflectiveSerializeWritesNestedTomlRecordWithRenamedField(): void {
  let account: Account = sampleAccount();
  let text: String = stringifyOk(Toml::stringify<Account>(&account));

  Test::assertEq<str>(
    text.toStr(),
    "id = 42\nactive = true\nscore = 2.5\ngrade = \"A\"\ntag = \"line\\n\"\nowner = { display-name = \"Ada\", age = 36 }",
  );

  let document: TomlDocument = parseOk(&text);
  assertTomlInteger(&document, "id", 42);
  assertTomlString(&document, "tag", "line\n");
  assertTomlString(&document, "owner.display-name", "Ada");
  assertTomlInteger(&document, "owner.age", 36);
}

@test
function handWrittenSerializeNestedInTomlRecordIsAnInlineTable(): void {
  let wrapper: Wrapper = Wrapper { payload: Payload { value: 7, name: "ignis" } };
  let wrapped: String = stringifyOk(Toml::stringify<Wrapper>(&wrapper));

  Test::assertEq<str>(wrapped.toStr(), "payload = { value = 7, name = \"ignis\" }");

  let wrappedDocument: TomlDocument = parseOk(&wrapped);
  assertTomlInteger(&wrappedDocument, "payload.value", 7);
  assertTomlString(&wrappedDocument, "payload.name", "ignis");

  let envelope: Envelope = Envelope { tag: "box", payload: Payload { value: 8, name: "fire" } };
  let enveloped: String = stringifyOk(Toml::stringify<Envelope>(&envelope));

  Test::assertEq<str>(enveloped.toStr(), "tag = \"box\"\npayload = { value = 8, name = \"fire\" }");

  let envelopedDocument: TomlDocument = parseOk(&enveloped);
  assertTomlString(&envelopedDocument, "tag", "box");
  assertTomlInteger(&envelopedDocument, "payload.value", 8);
  assertTomlString(&envelopedDocument, "payload.name", "fire");
}

@test
function nestedRecordsKeepJsonPunctuation(): void {
  let outer: Outer = sampleOuter();
  let envelope: Envelope = Envelope { tag: "box", payload: Payload { value: 8, name: "fire" } };

  assertOkString(
    Json::stringify<Outer>(&outer),
    "{\"id\":1,\"middle\":{\"level\":2,\"inner\":{\"a\":3,\"b\":\"x\"}}}",
  );
  assertOkString(
    Json::stringify<Envelope>(&envelope),
    "{\"tag\":\"box\",\"payload\":{\"value\":8,\"name\":\"fire\"}}",
  );
}
