//!
//! # Rc Module
//!
//! Reference-counted shared ownership for heap-allocated values.
//!
//! `Rc<T>` provides shared ownership of a value of type `T` allocated on the
//! heap. Cloning an `Rc` increments the reference count; dropping one
//! decrements it. When the last strong reference is released, the payload's
//! destructor runs. The allocation is freed when both strong and weak counts
//! reach zero.
//!
//! `Weak<T>` is a non-owning observer. It keeps the allocation header alive
//! so `upgrade()` can check whether the value still exists, but does not
//! prevent the payload from being destroyed.
//!
//! Both types are **move-by-default**. Use `.clone()` to share.
//!
//! ## Where the payload destructor comes from
//!
//! The control block stores counts and nothing else. `Rc<T>` and `Weak<T>` are
//! generic, so every operation already knows `T`, and the payload is destroyed
//! with `@dropInPlace<T>` at the point the strong count reaches zero. Storing a
//! destructor pointer in the block would need a raw C function pointer, which
//! Ignis has no way to call.
//!
//! ## Example
//!
//! ```ignis
//! import Rc, Weak from "std::rc";
//! import Option from "std::option";
//!
//! function main(): i32 {
//!   let a: Rc<i32> = Rc::new<i32>(42);
//!   let b: Rc<i32> = a.clone();
//!   let w: Weak<i32> = a.downgrade();
//!   let upgraded: Option<Rc<i32>> = w.upgrade(); // SOME while a or b is alive
//!   return 0;
//! }
//! ```

import Align from "../memory/align";
import RawAllocator from "../memory/allocator";

/// Alignment floor for a control block, matching the process allocator.
const RC_MIN_ALIGNMENT: u64 = 16;

/// Header shared by every `Rc<T>` and `Weak<T>` over one allocation.
///
/// The block lives at the front of the allocation and the payload follows it,
/// aligned for `T`:
///
/// ```text
///   ┌──────────────────┬─────────────┬──────────────────────────┐
///   │ strong, weak     │ padding     │ T payload                │
///   └──────────────────┴─────────────┴──────────────────────────┘
///   ^ handle                         ^ handle + headerSize(alignOf<T>)
/// ```
record RcBox {
  /// Live strong references. The payload is destroyed when this reaches zero.
  public strong: u32;

  /// Live weak references. The allocation is released when both counts are zero.
  public weak: u32;
}

/// Operations on the shared control block.
///
/// The namespace is exported because a monomorphized `Rc<T>` method is emitted
/// into whichever translation unit instantiates it, and that unit reaches these
/// by name. Nothing outside `Rc<T>` and `Weak<T>` should call them.
export namespace RcBlock {
  /// Rounds a requested payload alignment to one the allocator can satisfy.
  ///
  /// Zero and non-power-of-two requests fall back to the floor rather than
  /// producing an unusable layout.
  function normalizedAlign(payloadAlign: u64): u64 {
    if (payloadAlign == 0 || !Align::isPowerOfTwo(payloadAlign)) {
      return RC_MIN_ALIGNMENT;
    }

    return payloadAlign < RC_MIN_ALIGNMENT ? RC_MIN_ALIGNMENT : payloadAlign;
  }

  /// Byte offset from the allocation base to a payload aligned for `payloadAlign`.
  function headerSize(payloadAlign: u64): u64 {
    return Align::alignUp(@sizeOf<RcBox>(), RcBlock::normalizedAlign(payloadAlign));
  }

  /// Allocates a zeroed control block plus payload storage, with strong count 1.
  function allocate(payloadSize: u64, payloadAlign: u64): *mut void {
    let alignment: u64 = RcBlock::normalizedAlign(payloadAlign);
    let total: u64 = RcBlock::headerSize(payloadAlign) + payloadSize;
    let block: *mut u8 = RawAllocator::allocateZeroedAligned(1, total, alignment);

    @write<RcBox>(block as *mut RcBox, RcBox {
        strong: 1,
        weak: 0,
      });

    return block as *mut void;
  }

  function strongCount(handle: *mut void): u32 {
    return @read<RcBox>(handle as *mut RcBox).strong;
  }

  function weakCount(handle: *mut void): u32 {
    return @read<RcBox>(handle as *mut RcBox).weak;
  }

  function retain(handle: *mut void): void {
    let mut header: RcBox = @read<RcBox>(handle as *mut RcBox);

    header.strong += 1;

    @write<RcBox>(handle as *mut RcBox, header);
  }

  function retainWeak(handle: *mut void): void {
    let mut header: RcBox = @read<RcBox>(handle as *mut RcBox);

    header.weak += 1;

    @write<RcBox>(handle as *mut RcBox, header);
  }

  /// Decrements the strong count.
  ///
  /// Returns true exactly on the transition to zero, which is the one moment the
  /// caller must destroy the payload.
  function releaseStrong(handle: *mut void): boolean {
    let mut header: RcBox = @read<RcBox>(handle as *mut RcBox);

    if (header.strong == 0) {
      return false;
    }

    header.strong -= 1;

    @write<RcBox>(handle as *mut RcBox, header);

    return header.strong == 0;
  }

  /// Decrements the weak count and releases the allocation when nothing is left.
  function releaseWeak(handle: *mut void): void {
    let mut header: RcBox = @read<RcBox>(handle as *mut RcBox);

    if (header.weak == 0) {
      return;
    }

    header.weak -= 1;

    @write<RcBox>(handle as *mut RcBox, header);

    if (header.weak == 0 && header.strong == 0) {
      RawAllocator::free(handle as *mut u8);
    }
  }

  /// Releases the allocation once no strong or weak reference is left.
  function releaseIfUnreferenced(handle: *mut void): void {
    let header: RcBox = @read<RcBox>(handle as *mut RcBox);

    if (header.strong == 0 && header.weak == 0) {
      RawAllocator::free(handle as *mut u8);
    }
  }

  /// Adds a strong reference when the payload is still alive.
  function tryRetain(handle: *mut void): boolean {
    let mut header: RcBox = @read<RcBox>(handle as *mut RcBox);

    if (header.strong == 0) {
      return false;
    }

    header.strong += 1;

    @write<RcBox>(handle as *mut RcBox, header);

    return true;
  }
}

/// Reference-counted shared pointer.
///
/// ## Memory Layout
///
/// ```text
///   Rc { handle } ──────┐
///   Rc { handle } ──┐   │
///                    │   │
///                    v   v
///                ┌───────────────────────┐
///                │  strong: u32          │  reference counts
///                │  weak:   u32          │
///                ├───────────────────────┤
///                │  T payload            │  user data
///                └───────────────────────┘
/// ```
///
/// When `strong` reaches 0 the payload is destroyed. The allocation is freed
/// when both `strong` and `weak` reach 0.
///
/// ## Method Reference
///
/// | Method        | Signature                         | Description                    |
/// |---------------|-----------------------------------|--------------------------------|
/// | `new`         | `(T) -> Rc<T>`                    | Allocate with strong count 1   |
/// | `strongCount` | `(&self) -> u32`                  | Current strong references      |
/// | `weakCount`   | `(&self) -> u32`                  | Current weak references        |
/// | `downgrade`   | `(&self) -> Weak<T>`              | Create a weak observer         |
/// | `get`         | `(&self) -> &T`                   | Immutable ref to payload       |
/// | `getMut`      | `(&mut self) -> Option<*mut T>`   | Mutable access if unique       |
/// | `clone`       | `(&self) -> Rc<T>`                | Increment strong, share        |
/// | `drop`        | `(&mut self) -> void`             | Decrement strong                |
@implements(Drop, Clone)
export record Rc<T> {
  handle: *mut void;

  /// Allocates a new `Rc` with strong count 1.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc from "std::rc";
  ///
  /// let r: Rc<i32> = Rc::new<i32>(100);
  /// ```
  public static new(value: T): Rc<T> {
    let handle: *mut void = RcBlock::allocate(@sizeOf<T>(), @alignOf<T>());
    let mut slot: *mut T = (handle as u64 + RcBlock::headerSize(@alignOf<T>())) as *mut T;

    // An indexed store moves `value` into the payload. `@write` copies it and
    // leaves the parameter owned, which then drops at the end of this function
    // and destroys the payload the caller just handed over.
    slot[0] = value;

    return Rc {
      handle: handle,
    };
  }

  /// Returns the payload address for this allocation.
  payloadPointer(&self): *mut T {
    return (self.handle as u64 + RcBlock::headerSize(@alignOf<T>())) as *mut T;
  }

  /// Returns the number of live strong references.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc from "std::rc";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(1);
  /// let b: Rc<i32> = a.clone();
  /// let n: u32 = a.strongCount(); // 2
  /// ```
  public strongCount(&self): u32 {
    return RcBlock::strongCount(self.handle);
  }

  /// Returns the number of live weak references.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc, Weak from "std::rc";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(1);
  /// let w: Weak<i32> = a.downgrade();
  /// let n: u32 = a.weakCount(); // 1
  /// ```
  public weakCount(&self): u32 {
    return RcBlock::weakCount(self.handle);
  }

  /// Creates a `Weak<T>` that does not keep the value alive.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc, Weak from "std::rc";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(42);
  /// let w: Weak<i32> = a.downgrade();
  /// ```
  public downgrade(&self): Weak<T> {
    RcBlock::retainWeak(self.handle);

    return Weak {
      handle: self.handle,
    };
  }

  /// Returns an immutable reference to the inner value.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc from "std::rc";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(42);
  /// let val: &i32 = a.get();
  /// ```
  public get(&self): &T {
    return self.payloadPointer() as &T;
  }

  /// Returns a mutable pointer to the inner value if this `Rc` is the
  /// sole owner (`strongCount == 1`), or `NONE` otherwise.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc from "std::rc";
  /// import Option from "std::option";
  ///
  /// let mut a: Rc<i32> = Rc::new<i32>(10);
  /// let ptr: Option<*mut i32> = a.getMut(); // SOME (unique owner)
  /// ```
  public getMut(&mut self): Option<*mut T> {
    if (RcBlock::strongCount(self.handle) == 1) {
      return Option::SOME(self.payloadPointer());
    }

    return Option::NONE;
  }

  /// Increments the strong count and returns a new `Rc` sharing the allocation.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc from "std::rc";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(1);
  /// let b: Rc<i32> = a.clone();
  /// ```
  clone(&self): Rc<T> {
    RcBlock::retain(self.handle);

    return Rc {
      handle: self.handle,
    };
  }

  /// Decrements the strong count. Runs the payload destructor when it
  /// reaches zero. Frees the allocation when both counts reach zero.
  drop(&mut self): void {
    if (RcBlock::releaseStrong(self.handle)) {
      @dropInPlace<T>(self.payloadPointer());
    }

    RcBlock::releaseIfUnreferenced(self.handle);
  }
}

/// Non-owning observer of an `Rc<T>` allocation.
///
/// Keeps the allocation header alive so `upgrade()` can check whether the
/// value still exists. Use `Rc::downgrade()` to create one.
///
/// ## Lifecycle
///
/// ```text
///   Rc::new(42)        strong=1  weak=0     payload alive
///       │
///   a.downgrade()      strong=1  weak=1     Weak created
///       │
///   drop(a)            strong=0  weak=1     payload destroyed
///       │
///   w.upgrade()        returns NONE         value gone
///       │
///   drop(w)            strong=0  weak=0     allocation freed
/// ```
///
/// ## Method Reference
///
/// | Method        | Signature                       | Description                    |
/// |---------------|---------------------------------|--------------------------------|
/// | `upgrade`     | `(&self) -> Option<Rc<T>>`      | Promote to strong if alive     |
/// | `weakCount`   | `(&self) -> u32`                | Current weak references        |
/// | `strongCount` | `(&self) -> u32`                | Current strong references      |
/// | `clone`       | `(&self) -> Weak<T>`            | Increment weak, share          |
/// | `drop`        | `(&mut self) -> void`           | Decrement weak                 |
@implements(Drop, Clone)
export record Weak<T> {
  handle: *mut void;

  /// Attempts to promote this weak reference to a strong `Rc<T>`.
  ///
  /// Returns `SOME(Rc<T>)` if the value is still alive (strong count > 0),
  /// or `NONE` if all strong references have been dropped.
  ///
  /// When successful, the strong count is incremented.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc, Weak from "std::rc";
  /// import Option from "std::option";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(42);
  /// let w: Weak<i32> = a.downgrade();
  /// let upgraded: Option<Rc<i32>> = w.upgrade(); // SOME while a is alive
  /// ```
  public upgrade(&self): Option<Rc<T>> {
    if (!RcBlock::tryRetain(self.handle)) {
      return Option::NONE;
    }

    return Option::SOME(Rc {
      handle: self.handle,
    });
  }

  /// Returns the number of live weak references.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc, Weak from "std::rc";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(1);
  /// let w: Weak<i32> = a.downgrade();
  /// let n: u32 = w.weakCount(); // 1
  /// ```
  public weakCount(&self): u32 {
    return RcBlock::weakCount(self.handle);
  }

  /// Returns the number of live strong references.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc, Weak from "std::rc";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(1);
  /// let w: Weak<i32> = a.downgrade();
  /// let n: u32 = w.strongCount(); // 1
  /// ```
  public strongCount(&self): u32 {
    return RcBlock::strongCount(self.handle);
  }

  /// Increments the weak count and returns a new `Weak` sharing the header.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import Rc, Weak from "std::rc";
  ///
  /// let a: Rc<i32> = Rc::new<i32>(1);
  /// let w1: Weak<i32> = a.downgrade();
  /// let w2: Weak<i32> = w1.clone();
  /// ```
  clone(&self): Weak<T> {
    RcBlock::retainWeak(self.handle);

    return Weak {
      handle: self.handle,
    };
  }

  /// Decrements the weak count. Frees the allocation when both counts
  /// reach zero.
  drop(&mut self): void {
    RcBlock::releaseWeak(self.handle);
  }
}
