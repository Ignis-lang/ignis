//! The C platform constants the standard library uses, in one place.
//!
//! On `x86_64` Linux every value is written here, so no backend needs a C
//! header to know it. `scripts/check_platform_constants.py` compiles each
//! name against the real headers and fails when a value here disagrees.
//! Every other target still reads the header macro of the same name, which
//! only the C backend can do.

import CType from "./primitives";

@configFlag(!(@platform("linux") && @arch("x86_64")))
extern __platform_headers {
  const SEEK_SET: CType::CInt;
  const SEEK_CUR: CType::CInt;
  const SEEK_END: CType::CInt;
  const STDIN_FILENO: CType::CInt;
  const STDOUT_FILENO: CType::CInt;
  const STDERR_FILENO: CType::CInt;
  const EOF: CType::CInt;
  const O_RDONLY: CType::CInt;
  const O_WRONLY: CType::CInt;
  const O_RDWR: CType::CInt;
  const O_CREAT: CType::CInt;
  const O_TRUNC: CType::CInt;
  const O_APPEND: CType::CInt;
  const O_EXCL: CType::CInt;
  const F_GETFD: CType::CInt;
  const F_SETFD: CType::CInt;
  const FD_CLOEXEC: CType::CInt;
  const S_IFMT: u32;
  const S_IFREG: u32;
  const S_IFDIR: u32;
  const S_IFLNK: u32;
  const S_IRWXU: u32;
  const S_IRUSR: u32;
  const S_IWUSR: u32;
  const S_IXUSR: u32;
  const S_IRWXG: u32;
  const S_IRGRP: u32;
  const S_IWGRP: u32;
  const S_IXGRP: u32;
  const S_IRWXO: u32;
  const S_IROTH: u32;
  const S_IWOTH: u32;
  const S_IXOTH: u32;
  const EPERM: CType::CInt;
  const ENOENT: CType::CInt;
  const ESRCH: CType::CInt;
  const EINTR: CType::CInt;
  const EIO: CType::CInt;
  const ENXIO: CType::CInt;
  const E2BIG: CType::CInt;
  const EACCES: CType::CInt;
  const EBADF: CType::CInt;
  const EAGAIN: CType::CInt;
  const ENOMEM: CType::CInt;
  const EBUSY: CType::CInt;
  const EEXIST: CType::CInt;
  const ENOTDIR: CType::CInt;
  const EISDIR: CType::CInt;
  const EINVAL: CType::CInt;
  const ENFILE: CType::CInt;
  const EMFILE: CType::CInt;
  const ENOSPC: CType::CInt;
  const EROFS: CType::CInt;
  const EPIPE: CType::CInt;
  const ERANGE: CType::CInt;
  const ENOTEMPTY: CType::CInt;
  const ECONNREFUSED: CType::CInt;
  const ECONNRESET: CType::CInt;
  const ETIMEDOUT: CType::CInt;
  const EXIT_SUCCESS: CType::CInt;
  const EXIT_FAILURE: CType::CInt;
  const _SC_NPROCESSORS_ONLN: CType::CInt;
  const SIGINT: CType::CInt;
  const SIGKILL: CType::CInt;
  const SIGSEGV: CType::CInt;
  const SIGTERM: CType::CInt;
  const WNOHANG: CType::CInt;
  const PROT_NONE: CType::CInt;
  const PROT_READ: CType::CInt;
  const PROT_WRITE: CType::CInt;
  const PROT_EXEC: CType::CInt;
  const MAP_SHARED: CType::CInt;
  const MAP_PRIVATE: CType::CInt;
  const MAP_ANONYMOUS: CType::CInt;
  const TIOCGWINSZ: CType::CULong;
  const CLOCKS_PER_SEC: CType::ClockT;
  const CLOCK_REALTIME: CType::ClockIdT;
  const CLOCK_MONOTONIC: CType::ClockIdT;
}

/// The platform constants, with the values `x86_64` Linux (glibc) defines.
@configFlag(@platform("linux") && @arch("x86_64"))
export namespace Platform {
  // File positioning and standard descriptors (`unistd.h`, `stdio.h`)
  const SEEK_SET: CType::CInt = 0;
  const SEEK_CUR: CType::CInt = 1;
  const SEEK_END: CType::CInt = 2;
  const STDIN_FILENO: CType::CInt = 0;
  const STDOUT_FILENO: CType::CInt = 1;
  const STDERR_FILENO: CType::CInt = 2;
  const EOF: CType::CInt = -1;

  // Open flags and descriptor flags (`fcntl.h`)
  const O_RDONLY: CType::CInt = 0;
  const O_WRONLY: CType::CInt = 1;
  const O_RDWR: CType::CInt = 2;
  const O_CREAT: CType::CInt = 64;
  const O_TRUNC: CType::CInt = 512;
  const O_APPEND: CType::CInt = 1024;
  const O_EXCL: CType::CInt = 128;
  const F_GETFD: CType::CInt = 1;
  const F_SETFD: CType::CInt = 2;
  const FD_CLOEXEC: CType::CInt = 1;

  // File modes (`sys/stat.h`)
  const S_IFMT: u32 = 61440;
  const S_IFREG: u32 = 32768;
  const S_IFDIR: u32 = 16384;
  const S_IFLNK: u32 = 40960;
  const S_IRWXU: u32 = 448;
  const S_IRUSR: u32 = 256;
  const S_IWUSR: u32 = 128;
  const S_IXUSR: u32 = 64;
  const S_IRWXG: u32 = 56;
  const S_IRGRP: u32 = 32;
  const S_IWGRP: u32 = 16;
  const S_IXGRP: u32 = 8;
  const S_IRWXO: u32 = 7;
  const S_IROTH: u32 = 4;
  const S_IWOTH: u32 = 2;
  const S_IXOTH: u32 = 1;

  // Error numbers (`errno.h`)
  const EPERM: CType::CInt = 1;
  const ENOENT: CType::CInt = 2;
  const ESRCH: CType::CInt = 3;
  const EINTR: CType::CInt = 4;
  const EIO: CType::CInt = 5;
  const ENXIO: CType::CInt = 6;
  const E2BIG: CType::CInt = 7;
  const EACCES: CType::CInt = 13;
  const EBADF: CType::CInt = 9;
  const EAGAIN: CType::CInt = 11;
  const ENOMEM: CType::CInt = 12;
  const EBUSY: CType::CInt = 16;
  const EEXIST: CType::CInt = 17;
  const ENOTDIR: CType::CInt = 20;
  const EISDIR: CType::CInt = 21;
  const EINVAL: CType::CInt = 22;
  const ENFILE: CType::CInt = 23;
  const EMFILE: CType::CInt = 24;
  const ENOSPC: CType::CInt = 28;
  const EROFS: CType::CInt = 30;
  const EPIPE: CType::CInt = 32;
  const ERANGE: CType::CInt = 34;
  const ENOTEMPTY: CType::CInt = 39;
  const ECONNREFUSED: CType::CInt = 111;
  const ECONNRESET: CType::CInt = 104;
  const ETIMEDOUT: CType::CInt = 110;

  // Processes, signals and memory mappings (`stdlib.h`, `unistd.h`, `signal.h`, `sys/wait.h`, `sys/mman.h`)
  const EXIT_SUCCESS: CType::CInt = 0;
  const EXIT_FAILURE: CType::CInt = 1;
  const _SC_NPROCESSORS_ONLN: CType::CInt = 84;
  const SIGINT: CType::CInt = 2;
  const SIGKILL: CType::CInt = 9;
  const SIGSEGV: CType::CInt = 11;
  const SIGTERM: CType::CInt = 15;
  const WNOHANG: CType::CInt = 1;
  const PROT_NONE: CType::CInt = 0;
  const PROT_READ: CType::CInt = 1;
  const PROT_WRITE: CType::CInt = 2;
  const PROT_EXEC: CType::CInt = 4;
  const MAP_SHARED: CType::CInt = 1;
  const MAP_PRIVATE: CType::CInt = 2;
  const MAP_ANONYMOUS: CType::CInt = 32;

  // Terminals and clocks (`sys/ioctl.h`, `time.h`)
  const TIOCGWINSZ: CType::CULong = 21523;
  const CLOCKS_PER_SEC: CType::ClockT = 1000000;
  const CLOCK_REALTIME: CType::ClockIdT = 0;
  const CLOCK_MONOTONIC: CType::ClockIdT = 1;
}

/// The platform constants, read from the C header macros of the target.
@configFlag(!(@platform("linux") && @arch("x86_64")))
export namespace Platform {
  // File positioning and standard descriptors (`unistd.h`, `stdio.h`)
  const SEEK_SET: CType::CInt = __platform_headers::SEEK_SET;
  const SEEK_CUR: CType::CInt = __platform_headers::SEEK_CUR;
  const SEEK_END: CType::CInt = __platform_headers::SEEK_END;
  const STDIN_FILENO: CType::CInt = __platform_headers::STDIN_FILENO;
  const STDOUT_FILENO: CType::CInt = __platform_headers::STDOUT_FILENO;
  const STDERR_FILENO: CType::CInt = __platform_headers::STDERR_FILENO;
  const EOF: CType::CInt = __platform_headers::EOF;

  // Open flags and descriptor flags (`fcntl.h`)
  const O_RDONLY: CType::CInt = __platform_headers::O_RDONLY;
  const O_WRONLY: CType::CInt = __platform_headers::O_WRONLY;
  const O_RDWR: CType::CInt = __platform_headers::O_RDWR;
  const O_CREAT: CType::CInt = __platform_headers::O_CREAT;
  const O_TRUNC: CType::CInt = __platform_headers::O_TRUNC;
  const O_APPEND: CType::CInt = __platform_headers::O_APPEND;
  const O_EXCL: CType::CInt = __platform_headers::O_EXCL;
  const F_GETFD: CType::CInt = __platform_headers::F_GETFD;
  const F_SETFD: CType::CInt = __platform_headers::F_SETFD;
  const FD_CLOEXEC: CType::CInt = __platform_headers::FD_CLOEXEC;

  // File modes (`sys/stat.h`)
  const S_IFMT: u32 = __platform_headers::S_IFMT;
  const S_IFREG: u32 = __platform_headers::S_IFREG;
  const S_IFDIR: u32 = __platform_headers::S_IFDIR;
  const S_IFLNK: u32 = __platform_headers::S_IFLNK;
  const S_IRWXU: u32 = __platform_headers::S_IRWXU;
  const S_IRUSR: u32 = __platform_headers::S_IRUSR;
  const S_IWUSR: u32 = __platform_headers::S_IWUSR;
  const S_IXUSR: u32 = __platform_headers::S_IXUSR;
  const S_IRWXG: u32 = __platform_headers::S_IRWXG;
  const S_IRGRP: u32 = __platform_headers::S_IRGRP;
  const S_IWGRP: u32 = __platform_headers::S_IWGRP;
  const S_IXGRP: u32 = __platform_headers::S_IXGRP;
  const S_IRWXO: u32 = __platform_headers::S_IRWXO;
  const S_IROTH: u32 = __platform_headers::S_IROTH;
  const S_IWOTH: u32 = __platform_headers::S_IWOTH;
  const S_IXOTH: u32 = __platform_headers::S_IXOTH;

  // Error numbers (`errno.h`)
  const EPERM: CType::CInt = __platform_headers::EPERM;
  const ENOENT: CType::CInt = __platform_headers::ENOENT;
  const ESRCH: CType::CInt = __platform_headers::ESRCH;
  const EINTR: CType::CInt = __platform_headers::EINTR;
  const EIO: CType::CInt = __platform_headers::EIO;
  const ENXIO: CType::CInt = __platform_headers::ENXIO;
  const E2BIG: CType::CInt = __platform_headers::E2BIG;
  const EACCES: CType::CInt = __platform_headers::EACCES;
  const EBADF: CType::CInt = __platform_headers::EBADF;
  const EAGAIN: CType::CInt = __platform_headers::EAGAIN;
  const ENOMEM: CType::CInt = __platform_headers::ENOMEM;
  const EBUSY: CType::CInt = __platform_headers::EBUSY;
  const EEXIST: CType::CInt = __platform_headers::EEXIST;
  const ENOTDIR: CType::CInt = __platform_headers::ENOTDIR;
  const EISDIR: CType::CInt = __platform_headers::EISDIR;
  const EINVAL: CType::CInt = __platform_headers::EINVAL;
  const ENFILE: CType::CInt = __platform_headers::ENFILE;
  const EMFILE: CType::CInt = __platform_headers::EMFILE;
  const ENOSPC: CType::CInt = __platform_headers::ENOSPC;
  const EROFS: CType::CInt = __platform_headers::EROFS;
  const EPIPE: CType::CInt = __platform_headers::EPIPE;
  const ERANGE: CType::CInt = __platform_headers::ERANGE;
  const ENOTEMPTY: CType::CInt = __platform_headers::ENOTEMPTY;
  const ECONNREFUSED: CType::CInt = __platform_headers::ECONNREFUSED;
  const ECONNRESET: CType::CInt = __platform_headers::ECONNRESET;
  const ETIMEDOUT: CType::CInt = __platform_headers::ETIMEDOUT;

  // Processes, signals and memory mappings (`stdlib.h`, `unistd.h`, `signal.h`, `sys/wait.h`, `sys/mman.h`)
  const EXIT_SUCCESS: CType::CInt = __platform_headers::EXIT_SUCCESS;
  const EXIT_FAILURE: CType::CInt = __platform_headers::EXIT_FAILURE;
  const _SC_NPROCESSORS_ONLN: CType::CInt = __platform_headers::_SC_NPROCESSORS_ONLN;
  const SIGINT: CType::CInt = __platform_headers::SIGINT;
  const SIGKILL: CType::CInt = __platform_headers::SIGKILL;
  const SIGSEGV: CType::CInt = __platform_headers::SIGSEGV;
  const SIGTERM: CType::CInt = __platform_headers::SIGTERM;
  const WNOHANG: CType::CInt = __platform_headers::WNOHANG;
  const PROT_NONE: CType::CInt = __platform_headers::PROT_NONE;
  const PROT_READ: CType::CInt = __platform_headers::PROT_READ;
  const PROT_WRITE: CType::CInt = __platform_headers::PROT_WRITE;
  const PROT_EXEC: CType::CInt = __platform_headers::PROT_EXEC;
  const MAP_SHARED: CType::CInt = __platform_headers::MAP_SHARED;
  const MAP_PRIVATE: CType::CInt = __platform_headers::MAP_PRIVATE;
  const MAP_ANONYMOUS: CType::CInt = __platform_headers::MAP_ANONYMOUS;

  // Terminals and clocks (`sys/ioctl.h`, `time.h`)
  const TIOCGWINSZ: CType::CULong = __platform_headers::TIOCGWINSZ;
  const CLOCKS_PER_SEC: CType::ClockT = __platform_headers::CLOCKS_PER_SEC;
  const CLOCK_REALTIME: CType::ClockIdT = __platform_headers::CLOCK_REALTIME;
  const CLOCK_MONOTONIC: CType::ClockIdT = __platform_headers::CLOCK_MONOTONIC;
}
