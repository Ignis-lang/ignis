//!
//! # LibC Errno
//!
//! Thread-local `errno` access and POSIX error constants, exposed as
//! `LibC::Errno`.
//!
//! ## Functions
//!
//! | Function | Description                                         |
//! |----------|-----------------------------------------------------|
//! | `get`    | Read the current thread-local `errno` value         |
//! | `set`    | Write a new value into thread-local `errno`         |
//!
//! ## Error Constants
//!
//! Every error constant comes from `std::libc::platform`: written out on
//! `x86_64` Linux, read from `<errno.h>` on other targets.
//!
//! | Constant       | Description                        |
//! |----------------|------------------------------------|
//! | `EPERM`        | Operation not permitted            |
//! | `ENOENT`       | No such file or directory          |
//! | `ESRCH`        | No such process                    |
//! | `EINTR`        | Interrupted system call            |
//! | `EIO`          | I/O error                          |
//! | `ENXIO`        | No such device or address          |
//! | `E2BIG`        | Argument list too long             |
//! | `EACCES`       | Permission denied                  |
//! | `EBADF`        | Bad file descriptor                |
//! | `EAGAIN`       | Resource temporarily unavailable   |
//! | `ENOMEM`       | Cannot allocate memory             |
//! | `EBUSY`        | Resource busy                      |
//! | `EEXIST`       | File exists                        |
//! | `ENOTDIR`      | Not a directory                    |
//! | `EISDIR`       | Is a directory                     |
//! | `EINVAL`       | Invalid argument                   |
//! | `ENFILE`       | Too many open files in system      |
//! | `EMFILE`       | Too many open files (per process)  |
//! | `ENOSPC`       | No space left on device            |
//! | `EROFS`        | Read-only file system              |
//! | `EPIPE`        | Broken pipe                        |
//! | `ERANGE`       | Result too large (math)            |
//! | `ENOTEMPTY`    | Directory not empty                |
//! | `ECONNREFUSED` | Connection refused                 |
//! | `ECONNRESET`   | Connection reset by peer           |
//! | `ETIMEDOUT`    | Connection timed out               |
//! | `EWOULDBLOCK`  | Alias for `EAGAIN`                 |
//!
//! ## Platform Notes
//!
//! On Linux/glibc, `errno` is a macro expanding to `(*__errno_location())`.
//! The `get` and `set` functions call `__errno_location` to read/write the
//! thread-local value.
//!
//! ## Example
//!
//! ```ignis
//! import LibC, CType from "std::libc";
//!
//! function main(): i32 {
//!   let fd: CType::CInt = LibC::File::open("/nonexistent", LibC::File::O_RDONLY);
//!   if fd == -1 {
//!     let err: CType::CInt = LibC::Errno::get();
//!     if err == LibC::Errno::ENOENT {
//!       // file not found -- expected
//!       return 0;
//!     }
//!   }
//!   return 1;
//! }
//! ```

import CType from "./primitives";
import Platform from "./platform";

@configFlag(@platform("linux"))
extern __errno {
  @externName("__errno_location")
  /// Returns the thread-local `errno` pointer on Linux.
  function errno_location(): *mut CType::CInt;
}

@configFlag(@platform("macos"))
extern __errno {
  @externName("__error")
  /// Returns the thread-local `errno` pointer on macOS.
  function errno_location(): *mut CType::CInt;
}

/// Thread-local error number and POSIX error constants.
namespace LibC::Errno {
  /// Reads the current `errno` value.
  function get(): CType::CInt {
    return @read<CType::CInt>(__errno::errno_location());
  }

  /// Sets `errno` to `value`.
  function set(value: CType::CInt): void {
    @write<CType::CInt>(__errno::errno_location(), value);
  }

  // =========================================================================
  // POSIX error constants
  // =========================================================================

  /// Operation not permitted.
  const EPERM: CType::CInt = Platform::EPERM;

  /// No such file or directory.
  const ENOENT: CType::CInt = Platform::ENOENT;

  /// No such process.
  const ESRCH: CType::CInt = Platform::ESRCH;

  /// Interrupted system call.
  const EINTR: CType::CInt = Platform::EINTR;

  /// I/O error.
  const EIO: CType::CInt = Platform::EIO;

  /// No such device or address.
  const ENXIO: CType::CInt = Platform::ENXIO;

  /// Argument list too long.
  const E2BIG: CType::CInt = Platform::E2BIG;

  /// Permission denied.
  const EACCES: CType::CInt = Platform::EACCES;

  /// Bad file descriptor.
  const EBADF: CType::CInt = Platform::EBADF;

  /// Resource busy.
  const EBUSY: CType::CInt = Platform::EBUSY;

  /// File exists.
  const EEXIST: CType::CInt = Platform::EEXIST;

  /// Invalid argument.
  const EINVAL: CType::CInt = Platform::EINVAL;

  /// Too many open files in system.
  const ENFILE: CType::CInt = Platform::ENFILE;

  /// Too many open files (per process).
  const EMFILE: CType::CInt = Platform::EMFILE;

  /// Not a directory.
  const ENOTDIR: CType::CInt = Platform::ENOTDIR;

  /// Is a directory.
  const EISDIR: CType::CInt = Platform::EISDIR;

  /// No space left on device.
  const ENOSPC: CType::CInt = Platform::ENOSPC;

  /// Read-only file system.
  const EROFS: CType::CInt = Platform::EROFS;

  /// Broken pipe.
  const EPIPE: CType::CInt = Platform::EPIPE;

  /// Result too large (math).
  const ERANGE: CType::CInt = Platform::ERANGE;

  /// Cannot allocate memory.
  const ENOMEM: CType::CInt = Platform::ENOMEM;

  /// Resource temporarily unavailable.
  const EAGAIN: CType::CInt = Platform::EAGAIN;

  /// Same as EAGAIN on Linux.
  const EWOULDBLOCK: CType::CInt = Platform::EAGAIN;

  /// Directory not empty.
  const ENOTEMPTY: CType::CInt = Platform::ENOTEMPTY;

  /// Connection refused.
  const ECONNREFUSED: CType::CInt = Platform::ECONNREFUSED;

  /// Connection reset by peer.
  const ECONNRESET: CType::CInt = Platform::ECONNRESET;

  /// Connection timed out.
  const ETIMEDOUT: CType::CInt = Platform::ETIMEDOUT;
}
