import Fs from "std::fs";
import Io from "std::io";
import LibC from "std::libc";
import Path from "std::path";
import Process from "std::process";
import String from "std::string";
import Test from "std::test";

function shellRemoveTree(command: str): void {
  let exitCode: i32 = LibC::Process::system(command as *u8);
  if (exitCode != 0) {
    Test::fail();
  }
}

function assertInvalidInput(error: Io::IoError): void {
  Test::assert(error.errorKind() == Io::ErrorKind::INVALID_INPUT);
  Test::assertEq<i32>(error.rawCode(), LibC::Errno::EINVAL);
}

@test
function writeStringAndReadToStringPreserveInteriorNulBytes(): void {
  let pathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_interior_nul.bin`;
  let path: str = pathOwned.toStr();

  if (Fs::exists(path)) {
    match (Fs::removeFile(path)) {
      Result::OK(_) -> {},
      Result::ERROR(_) -> Test::fail(),
    };
  }

  let mut payload: String = String::new();
  payload.pushChar('A');
  payload.pushChar('\0');
  payload.pushChar('B');

  let Result::OK(_) = Fs::writeString(path, &payload) else {
    Test::fail();
    return;
  };

  let mut readBack: String = String::new();
  match (Fs::readToString(path)) {
    Result::OK(value) -> {
      readBack = value;
    },
    Result::ERROR(_) -> Test::fail(),
  };

  match (Fs::removeFile(path)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  Test::assertEq<u64>(readBack.length(), 3);

  let firstByte: char = match (readBack.charAt(0)) {
    Option::SOME(value) -> value,
    _ -> '?',
  };
  let middleByte: char = match (readBack.charAt(1)) {
    Option::SOME(value) -> value,
    _ -> '?',
  };
  let lastByte: char = match (readBack.charAt(2)) {
    Option::SOME(value) -> value,
    _ -> '?',
  };

  Test::assertEq<char>(firstByte, 'A');
  Test::assertEq<char>(middleByte, '\0');
  Test::assertEq<char>(lastByte, 'B');
}

@test
function readDirNextReturnsOkSomeAndThenOkNone(): void {
  let dirPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_read_dir_entries`;
  let dirPath: str = dirPathOwned.toStr();
  let filePathOwned: String = `${dirPath}/alpha.txt`;
  let filePath: str = filePathOwned.toStr();

  if (Fs::exists(filePath)) {
    match (Fs::removeFile(filePath)) {
      Result::OK(_) -> {},
      Result::ERROR(_) -> Test::fail(),
    };
  }

  if (Fs::exists(dirPath)) {
    match (Fs::removeDir(dirPath)) {
      Result::OK(_) -> {},
      Result::ERROR(_) -> Test::fail(),
    };
  }

  match (Fs::createDir(dirPath, 493)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  let payload: String = String::create("alpha");
  let Result::OK(_) = Fs::writeString(filePath, &payload) else {
    Test::fail();
    return;
  };

  let mut readDir: Fs::ReadDir = match (Fs::ReadDir::open(dirPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let mut reachedEnd: boolean = false;
  let mut steps: i32 = 0;
  let mut entryCount: i32 = 0;

  while (steps < 16) {
    let nextResult: Result<Option<Fs::DirEntry>, Io::IoError> = readDir.next();

    match (nextResult) {
      Result::OK(Option::SOME(_)) -> {
        entryCount += 1;
      },
      Result::OK(Option::NONE) -> {
        reachedEnd = true;
        break;
      },
      Result::ERROR(_) -> Test::fail(),
    };

    steps += 1;
  }

  readDir.drop();

  match (Fs::removeFile(filePath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  match (Fs::removeDir(dirPath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  Test::assert(entryCount > 2);
  Test::assert(reachedEnd);
}

@test
function readDirNextReturnsOkNoneForExhaustedEmptyDirectory(): void {
  let dirPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_read_dir_empty`;
  let dirPath: str = dirPathOwned.toStr();

  if (Fs::exists(dirPath)) {
    match (Fs::removeDir(dirPath)) {
      Result::OK(_) -> {},
      Result::ERROR(_) -> Test::fail(),
    };
  }

  match (Fs::createDir(dirPath, 493)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  let mut readDir: Fs::ReadDir = match (Fs::ReadDir::open(dirPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let mut reachedEnd: boolean = false;
  let mut steps: i32 = 0;

  while (steps < 16) {
    let nextResult: Result<Option<Fs::DirEntry>, Io::IoError> = readDir.next();

    match (nextResult) {
      Result::OK(Option::SOME(_)) -> {},
      Result::OK(Option::NONE) -> {
        reachedEnd = true;
        break;
      },
      Result::ERROR(_) -> Test::fail(),
    };

    steps += 1;
  }

  readDir.drop();

  match (Fs::removeDir(dirPath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  Test::assert(reachedEnd);
}

@test
function readDirNextReturnsErrorAfterDirectoryStreamIsInvalidated(): void {
  let dirPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_read_dir_invalidated`;
  let dirPath: str = dirPathOwned.toStr();

  if (Fs::exists(dirPath)) {
    match (Fs::removeDir(dirPath)) {
      Result::OK(_) -> {},
      Result::ERROR(_) -> Test::fail(),
    };
  }

  match (Fs::createDir(dirPath, 493)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  let mut readDir: Fs::ReadDir = match (Fs::ReadDir::open(dirPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  readDir.close();

  let nextResult: Result<Option<Fs::DirEntry>, Io::IoError> = readDir.next();
  let mut sawError: boolean = false;

  match (nextResult) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(_) -> {
      sawError = true;
    },
  };

  match (Fs::removeDir(dirPath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  Test::assert(sawError);
}

@test
function writeBytesAndReadToBytesPreserveEmptyAndBinaryPayloads(): void {
  let emptyPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_bytes_empty.bin`;
  let emptyPath: str = emptyPathOwned.toStr();
  let binaryPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_bytes_binary.bin`;
  let binaryPath: str = binaryPathOwned.toStr();

  shellRemoveTree(`rm -rf ${emptyPath} ${binaryPath}`.toStr());

  let emptyPayload: Vector<u8> = Vector::new<u8>();
  let Result::OK(_) = Fs::writeBytes(emptyPath, emptyPayload.asPtr() as *void, emptyPayload.length()) else {
    Test::fail();
    return;
  };

  let emptyReadBack: Vector<u8> = match (Fs::readToBytes(emptyPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let mut binaryPayload: Vector<u8> = Vector::new<u8>();
  binaryPayload.push(0 as u8);
  binaryPayload.push(255 as u8);
  binaryPayload.push(65 as u8);

  let Result::OK(_) = Fs::writeBytes(binaryPath, binaryPayload.asPtr() as *void, binaryPayload.length()) else {
    Test::fail();
    return;
  };

  let binaryReadBack: Vector<u8> = match (Fs::readToBytes(binaryPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  shellRemoveTree(`rm -rf ${emptyPath} ${binaryPath}`.toStr());

  Test::assertEq<u64>(emptyReadBack.length(), 0);
  Test::assertEq<u64>(binaryReadBack.length(), 3);
  Test::assertEq<u8>(match (binaryReadBack.get(0)) { Option::SOME(value) -> *value, Option::NONE -> 1 as u8 }, 0 as u8);
  Test::assertEq<u8>(match (binaryReadBack.get(1)) { Option::SOME(value) -> *value, Option::NONE -> 1 as u8 }, 255 as u8);
  Test::assertEq<u8>(match (binaryReadBack.get(2)) { Option::SOME(value) -> *value, Option::NONE -> 1 as u8 }, 65 as u8);
}

@test
function fsOwnedPathsRejectInteriorNulBytes(): void {
  let mut invalidPath: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_invalid_path`;
  let suffix: String = String::create("suffix");
  invalidPath.pushChar('\0');
  invalidPath.push(&suffix);

  let invalidPathBuf: Path::PathBuf = Path::PathBuf::fromString(&invalidPath);
  let payload: String = String::create("payload");
  let bytes: Vector<u8> = Vector::new<u8>();

  match (Fs::writeBytes(&invalidPath, bytes.asPtr() as *void, bytes.length())) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> assertInvalidInput(error),
  };

  match (Fs::readToBytes(&invalidPath)) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> assertInvalidInput(error),
  };

  match (Fs::writeString(&invalidPathBuf, &payload)) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> assertInvalidInput(error),
  };

  match (Fs::canonicalize(&invalidPathBuf)) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> assertInvalidInput(error),
  };

  match (Fs::createDirAll(&invalidPath)) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> assertInvalidInput(error),
  };

  match (Fs::walk(&invalidPathBuf)) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> assertInvalidInput(error),
  };

  match (Fs::removeDirAll(&invalidPath)) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> assertInvalidInput(error),
  };
}

@test
function canonicalizeRequiresExistingPathAndResolvesRealLocation(): void {
  let canonicalizeRootOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_canonicalize`;
  let canonicalizeRoot: str = canonicalizeRootOwned.toStr();
  let nestedPathOwned: String = `${canonicalizeRoot}/real/child.txt`;
  let nestedPath: str = nestedPathOwned.toStr();
  let missingPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_canonicalize_missing`;
  let missingPath: str = missingPathOwned.toStr();

  shellRemoveTree(`rm -rf ${canonicalizeRoot} ${missingPath}`.toStr());

  match (Fs::createDirAll(`${canonicalizeRoot}/real`.toStr())) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  let payload: String = String::create("child");
  let Result::OK(_) = Fs::writeString(nestedPath, &payload) else {
    Test::fail();
    return;
  };

  let resolved: Path::PathBuf = match (Fs::canonicalize(`${canonicalizeRoot}/real/../real/./child.txt`.toStr())) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let missingResult: Result<Path::PathBuf, Io::IoError> = Fs::canonicalize(missingPath);

  shellRemoveTree(`rm -rf ${canonicalizeRoot} ${missingPath}`.toStr());

  Test::assertEq<str>(resolved.asStr(), nestedPath);
  match (missingResult) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(_) -> {},
  };
}

@test
function tempDirReturnsExistingDirectoryRoot(): void {
  let tempRoot: Path::PathBuf = match (Fs::tempDir()) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let Result::OK(_) = Fs::canonicalize(tempRoot.asStr()) else {
    Test::fail();
    return;
  };
}

@test
function walkTreatsSymlinkDirectoryAsLeaf(): void {
  let rootPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_walk`;
  let rootPath: str = rootPathOwned.toStr();
  let targetDirOwned: String = `${rootPath}/real`;
  let targetDir: str = targetDirOwned.toStr();
  let nestedFileOwned: String = `${rootPath}/real/nested.txt`;
  let nestedFile: str = nestedFileOwned.toStr();
  let symlinkPathOwned: String = `${rootPath}/link_to_real`;
  let symlinkPath: str = symlinkPathOwned.toStr();
  let symlinkDescendantPathOwned: String = `${rootPath}/link_to_real/nested.txt`;
  let symlinkDescendantPath: str = symlinkDescendantPathOwned.toStr();
  let targetDirString: String = String::create(targetDir);
  let nestedFileString: String = String::create(nestedFile);
  let symlinkPathString: String = String::create(symlinkPath);
  let symlinkDescendantString: String = String::create(symlinkDescendantPath);

  shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  match (Fs::createDirAll(targetDir)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  let payload: String = String::create("nested");
  let Result::OK(_) = Fs::writeString(nestedFile, &payload) else {
    Test::fail();
    return;
  };

  Test::assertEq<i32>(LibC::Process::system(`ln -s ${targetDir} ${symlinkPath}`.toStr() as *u8), 0);

  let walkedEntries: Vector<String> = match (Fs::walk(rootPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let sawRealDir: boolean = Fs::walkContains(&walkedEntries, targetDirString.toStr());
  let sawNestedFile: boolean = Fs::walkContains(&walkedEntries, nestedFileString.toStr());
  let sawSymlink: boolean = Fs::walkContains(&walkedEntries, symlinkPathString.toStr());
  let sawSymlinkDescendant: boolean = Fs::walkContains(&walkedEntries, symlinkDescendantString.toStr());

  shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  Test::assert(sawRealDir);
  Test::assert(sawNestedFile);
  Test::assert(sawSymlink);
  Test::assert(!sawSymlinkDescendant);
}

@test
function removeDirAllFailsWhenMissingAndRemovesNestedTreesWithoutFollowingSymlinks(): void {
  let rootPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_remove_dir_all`;
  let rootPath: str = rootPathOwned.toStr();
  let externalPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_remove_dir_all_external`;
  let externalPath: str = externalPathOwned.toStr();
  let missingPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_remove_dir_all_missing`;
  let missingPath: str = missingPathOwned.toStr();
  let nestedFileOwned: String = `${rootPath}/root/child.txt`;
  let nestedFile: str = nestedFileOwned.toStr();
  let linkPathOwned: String = `${rootPath}/link_to_external`;
  let linkPath: str = linkPathOwned.toStr();
  let externalFileOwned: String = `${externalPath}/keep.txt`;
  let externalFile: str = externalFileOwned.toStr();

  shellRemoveTree(`rm -rf ${rootPath} ${externalPath} ${missingPath}`.toStr());

  match (Fs::createDirAll(`${rootPath}/root`.toStr())) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  match (Fs::createDirAll(externalPath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  let nestedPayload: String = String::create("child");
  let externalPayload: String = String::create("keep");

  let Result::OK(_) = Fs::writeString(nestedFile, &nestedPayload) else {
    Test::fail();
    return;
  };

  let Result::OK(_) = Fs::writeString(externalFile, &externalPayload) else {
    Test::fail();
    return;
  };

  Test::assertEq<i32>(LibC::Process::system(`ln -s ${externalPath} ${linkPath}`.toStr() as *u8), 0);

  let missingResult: Result<void, Io::IoError> = Fs::removeDirAll(missingPath);

  let removeResult: Result<void, Io::IoError> = Fs::removeDirAll(rootPath);

  let externalStillExists: boolean = Fs::exists(externalPath);
  let externalFileStillExists: boolean = Fs::exists(externalFile);
  let linkGone: boolean = !Fs::exists(linkPath);

  shellRemoveTree(`rm -rf ${rootPath} ${externalPath} ${missingPath}`.toStr());

  if (let Result::OK(_) = missingResult) {
    Test::fail();
  }

  if (let Result::ERROR(_) = removeResult) {
    Test::fail();
  }

  Test::assert(!Fs::exists(rootPath));
  Test::assert(externalStillExists);
  Test::assert(externalFileStillExists);
  Test::assert(linkGone);
}

@test
function metadataDistinguishesFilesFromDirectoriesAndReportsSize(): void {
  let rootPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_metadata`;
  let rootPath: str = rootPathOwned.toStr();
  let filePathOwned: String = `${rootPath}/payload.txt`;
  let filePath: str = filePathOwned.toStr();

  shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  // Deferred so the tree is removed on the early-failure paths too, not only on success.
  defer shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  match (Fs::createDirAll(rootPath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let payload: String = String::create("twelve bytes");
  let Result::OK(_) = Fs::writeString(filePath, &payload) else {
    Test::fail();
    return;
  };

  let fileMetadata: Fs::Metadata = match (Fs::metadata(filePath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let dirMetadata: Fs::Metadata = match (Fs::metadata(rootPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assert(fileMetadata.isFile());
  Test::assert(!fileMetadata.isDir());
  Test::assertEq<i64>(fileMetadata.len(), 12);

  Test::assert(dirMetadata.isDir());
  Test::assert(!dirMetadata.isFile());
}

@test
function metadataFailsForAMissingPath(): void {
  let missingPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_metadata_missing`;
  let missingPath: str = missingPathOwned.toStr();

  shellRemoveTree(`rm -rf ${missingPath}`.toStr());

  match (Fs::metadata(missingPath)) {
    Result::OK(_) -> Test::fail(),
    Result::ERROR(error) -> Test::assert(error.errorKind() == Io::ErrorKind::NOT_FOUND),
  };
}

@test
function createDirAllSucceedsAgainOnAnExistingTree(): void {
  let rootOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_create_dir_all`;
  let root: str = rootOwned.toStr();
  let nestedPathOwned: String = `${root}/one/two`;
  let nestedPath: str = nestedPathOwned.toStr();

  shellRemoveTree(`rm -rf ${root}`.toStr());

  defer shellRemoveTree(`rm -rf ${root}`.toStr());

  match (Fs::createDirAll(nestedPath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  // The second call is the point of the test: creating a tree that already exists is a
  // no-op, not an error, so callers do not have to probe first.
  let secondResult: Result<void, Io::IoError> = Fs::createDirAll(nestedPath);

  let nestedMetadata: Result<Fs::Metadata, Io::IoError> = Fs::metadata(nestedPath);

  match (secondResult) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> Test::fail(),
  };

  match (nestedMetadata) {
    Result::OK(value) -> Test::assert(value.isDir()),
    Result::ERROR(_) -> Test::fail(),
  };
}

@test
function walkYieldsDescendantsAndExcludesTheDirectoryItself(): void {
  let rootPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_walk_empty`;
  let rootPath: str = rootPathOwned.toStr();
  let emptyChildPathOwned: String = `${rootPath}/child`;
  let emptyChildPath: str = emptyChildPathOwned.toStr();

  shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  defer shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  match (Fs::createDirAll(rootPath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let emptyWalk: Vector<String> = match (Fs::walk(rootPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  match (Fs::createDirAll(emptyChildPath)) {
    Result::OK(_) -> {},
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let populatedWalk: Vector<String> = match (Fs::walk(rootPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  // Walking a directory yields what is under it, never the directory itself, so an empty
  // one yields nothing at all rather than a single self entry.
  Test::assertEq<u64>(emptyWalk.length(), 0 as u64);

  Test::assertEq<u64>(populatedWalk.length(), 1 as u64);
  Test::assert(Fs::walkContains(&populatedWalk, emptyChildPath));
  Test::assert(!Fs::walkContains(&populatedWalk, rootPath));
}

@test
function statReadsEveryFieldTheHostStructLayoutPlacesAtItsOwnOffset(): void {
  let rootPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_stat_layout`;
  let rootPath: str = rootPathOwned.toStr();
  let filePathOwned: String = `${rootPath}/payload.bin`;
  let filePath: str = filePathOwned.toStr();

  shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  defer shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  let Result::OK(_) = Fs::createDirAll(rootPath) else {
    Test::fail();
    return;
  };

  let payload: String = String::create("nineteen bytes long");
  let Result::OK(_) = Fs::writeString(filePath, &payload) else {
    Test::fail();
    return;
  };

  // `RawStat` mirrors the host `struct stat` field for field. A field added,
  // dropped or reordered shifts every offset after it, so each assertion below
  // reads one offset this module depends on.
  Test::assert(Fs::Sys::rawStatMatchesHostLayout());

  let fileStat: Fs::Sys::Stat = match (Fs::Sys::stat(filePath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<i64>(fileStat.size, 19);
  Test::assertEq<u32>(fileStat.mode & Fs::Sys::S_IFMT, Fs::Sys::S_IFREG);
  Test::assertEq<u64>(fileStat.nlink, 1);
  Test::assert(fileStat.ino != 0);
  Test::assert(fileStat.dev != 0);
  Test::assert(fileStat.blksize > 0);
  Test::assert(fileStat.mtime > 0);
  Test::assert(fileStat.ctime > 0);

  let dirStat: Fs::Sys::Stat = match (Fs::Sys::lstat(rootPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  Test::assertEq<u32>(dirStat.mode & Fs::Sys::S_IFMT, Fs::Sys::S_IFDIR);
  Test::assert(dirStat.ino != fileStat.ino);
}

@test
function readdirReadsTheNameAndTypeTheHostDirentLayoutPlacesAtTheirOwnOffsets(): void {
  let rootPathOwned: String = `/tmp/ignis_std_test_runner_fs_${Process::id()}_dirent_layout`;
  let rootPath: str = rootPathOwned.toStr();

  shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  defer shellRemoveTree(`rm -rf ${rootPath}`.toStr());

  let Result::OK(_) = Fs::createDirAll(`${rootPath}/child`.toStr()) else {
    Test::fail();
    return;
  };

  let payload: String = String::create("x");
  let Result::OK(_) = Fs::writeString(`${rootPath}/leaf.txt`.toStr(), &payload) else {
    Test::fail();
    return;
  };

  let mut readDir: Fs::ReadDir = match (Fs::ReadDir::open(rootPath)) {
    Result::OK(value) -> value,
    Result::ERROR(_) -> {
      Test::fail();
      return;
    },
  };

  let mut sawChildDirectory: boolean = false;
  let mut sawLeafFile: boolean = false;
  let mut sawDotEntry: boolean = false;

  let mut steps: i32 = 0;

  while (steps < 16) {
    match (readDir.next()) {
      Result::OK(Option::SOME(entry)) -> {
        let childName: String = String::create("child");
        let leafName: String = String::create("leaf.txt");
        let dotName: String = String::create(".");

        // `d_type` and `d_ino` each sit at their own offset in the entry.
        if (entry.name.equals(&childName)) {
          sawChildDirectory = entry.isDir() && entry.ino != 0;
        }

        if (entry.name.equals(&leafName)) {
          sawLeafFile = entry.isFile() && entry.ino != 0;
        }

        if (entry.name.equals(&dotName)) {
          sawDotEntry = true;
        }
      },
      Result::OK(Option::NONE) -> {
        break;
      },
      Result::ERROR(_) -> Test::fail(),
    };

    steps += 1;
  }

  readDir.close();

  // `d_name` is an inline array, so a wrong offset yields garbage rather than
  // the names the directory was built with.
  Test::assert(sawChildDirectory);
  Test::assert(sawLeafFile);
  Test::assert(sawDotEntry);
}
