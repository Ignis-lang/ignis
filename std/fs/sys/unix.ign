//!
//! # Unix Filesystem Syscall Layer
//!
//! Thin 1:1 wrappers around POSIX filesystem syscalls, returning
//! `Result<T, Io::IoError>` instead of raw errno-based error codes.
//!
//! All public API lives under the `Fs::Sys` namespace.
//!
//! ## Functions
//!
//! | Function   | Wraps              | Returns                           |
//! |------------|--------------------|-----------------------------------|
//! | `open`     | `open(2)` 3-arg    | `Result<i32, IoError>`            |
//! | `close`    | `close(2)`         | `Result<void, IoError>`           |
//! | `read`     | `read(2)`          | `Result<i64, IoError>`            |
//! | `write`    | `write(2)`         | `Result<i64, IoError>`            |
//! | `lseek`    | `lseek(2)`         | `Result<i64, IoError>`            |
//! | `stat`     | `stat(2)`          | `Result<Stat, IoError>`           |
//! | `fstat`    | `fstat(2)`         | `Result<Stat, IoError>`           |
//! | `lstat`    | `lstat(2)`         | `Result<Stat, IoError>`           |
//! | `realpath` | `realpath(3)`      | `Result<String, IoError>`         |
//! | `tempDirPath` | env/stat fallback | `Result<String, IoError>`       |
//! | `mkdir`    | `mkdir(2)`         | `Result<void, IoError>`           |
//! | `unlink`   | `unlink(2)`        | `Result<void, IoError>`           |
//! | `rmdir`    | `rmdir(2)`         | `Result<void, IoError>`           |
//! | `removeDirAll` | recursive removal | `Result<void, IoError>`         |
//! | `rename`   | `rename(2)`        | `Result<void, IoError>`           |
//! | `opendir`  | `opendir(3)`       | `Result<DirPtr, IoError>`         |
//! | `readdir`  | `readdir(3)`       | `Result<Option<SysDirEntry>, IoError>` |
//! | `readdirEntry` | `readdir(3)`      | `Result<boolean, IoError>`      |
//! | `closedir` | `closedir(3)`      | `void`                            |
//!
//! ## Types
//!
//! | Type       | Description                                                   |
//! |------------|---------------------------------------------------------------|
//! | `Stat`         | File metadata: dev, ino, mode, nlink, uid, gid, size, times   |
//! | `SysDirEntry`  | Directory entry: name (borrowed `str`), ino, fileType         |
//!
//! ## Constants
//!
//! | Group          | Constants                                                    |
//! |----------------|--------------------------------------------------------------|
//! | Open flags     | `O_RDONLY`, `O_WRONLY`, `O_RDWR`, `O_CREAT`, `O_TRUNC`, ... |
//! | Seek modes     | `SEEK_SET`, `SEEK_CUR`, `SEEK_END`                           |
//! | File type mask | `S_IFMT`, `S_IFREG`, `S_IFDIR`, `S_IFLNK`                   |
//! | Permission bits| `S_IRWXU`, `S_IRUSR`, `S_IWUSR`, ... (user/group/other)      |
//! | Dirent types   | `DT_UNKNOWN`, `DT_REG`, `DT_DIR`, `DT_LNK`                  |
//!
//! ## Design Notes
//!
//! Functions that succeed without a meaningful value (close, mkdir, etc.)
//! return `Result<void, Io::IoError>` with `Result::OK(())`.
//!
//! ## Host Layout Dependency
//!
//! Every function here calls libc directly through an Ignis `extern` block.
//! Two of those calls read a struct whose layout is fixed by the target's
//! kernel ABI rather than by POSIX:
//!
//! | Struct          | Read as                                              |
//! |-----------------|------------------------------------------------------|
//! | `struct stat`   | the `RawStat` record, laid out field for field       |
//! | `struct dirent` | the `DIRENT_*` byte offsets, read through the pointer |
//!
//! Both are the x86_64 Linux layout and are gated on
//! `@platform("linux") && @arch("x86_64")`. They exist only for that target,
//! so a target whose layout has not been checked fails to compile instead of
//! reading the wrong bytes; adding one means adding its layout under its own
//! `@configFlag`.
//!
//! `open(2)` is variadic and Ignis has no variadic call syntax. No prototype is
//! emitted for an `extern` declaration, so the fixed three-argument binding in
//! `__fs_io` is compiled against the real declaration from `<fcntl.h>`.
//!
//! ## Example
//!
//! ```ignis
//! import Fs from "std::fs";
//! import Io from "std::io";
//!
//! function main(): i32 {
//!   let fd: Result<i32, Io::IoError> = Fs::Sys::open(
//!     "/tmp/test.txt",
//!     Fs::Sys::O_WRONLY | Fs::Sys::O_CREAT | Fs::Sys::O_TRUNC,
//!     438,  // 0o666
//!   );
//!   if fd.isError() { return 1; }
//!
//!   let rawFd: i32 = fd.unwrap();
//!   let msg: *u8 = "hello from Ignis\n";
//!   let n: Result<i64, Io::IoError> = Fs::Sys::write(rawFd, msg as *mut void, 17);
//!   Fs::Sys::close(rawFd);
//!   return 0;
//! }
//! ```

import Io from "std::io";
import LibC from "std::libc";
import CType from "std::libc::primitives";
import String from "std::string";

// Extern blocks — direct C symbols.
// Local declarations are used as a workaround for cross-module symbol mangling
// in codegen (`LibC_File_read` instead of `read`).

// POSIX file I/O primitives and related constants (fcntl.h, unistd.h, sys/stat.h).
extern __fs_io {
  /// POSIX `open`; bound at the three-argument shape so `mode` is always passed.
  ///
  /// `open(2)` is variadic. Ignis has no variadic call syntax, and no prototype
  /// is emitted for an `extern` declaration, so this fixed-arity binding is
  /// compiled against the real variadic declaration from `<fcntl.h>` and GCC
  /// generates the host's variadic call sequence.
  function open(pathname: *u8, flags: i32, mode: u32): i32;
  /// POSIX `read`; returns bytes read, 0 on EOF, or -1.
  function read(fd: i32, buf: *mut void, count: u64): i64;
  /// POSIX `write`; returns bytes written or -1.
  function write(fd: i32, buf: *mut void, count: u64): i64;
  /// POSIX `close`; closes a file descriptor.
  function close(fd: i32): i32;
  /// POSIX `lseek`; repositions a file descriptor offset.
  function lseek(fd: i32, offset: i64, whence: i32): i64;
  /// POSIX `unlink`; removes a file path.
  function unlink(pathname: *u8): i32;
  /// POSIX `rmdir`; removes an empty directory path.
  function rmdir(pathname: *u8): i32;
  /// POSIX `rename`; renames a filesystem path.
  function rename(oldpath: *u8, newpath: *u8): i32;
  /// POSIX `mkdir`; creates one directory with `mode`.
  function mkdir(pathname: *u8, mode: u32): i32;

  const SEEK_SET: i32;
  const SEEK_CUR: i32;
  const SEEK_END: i32;

  const O_RDONLY: i32;
  const O_WRONLY: i32;
  const O_RDWR: i32;
  const O_CREAT: i32;
  const O_TRUNC: i32;
  const O_APPEND: i32;
  const O_EXCL: i32;

  // S_IS* mode test macros are not available as extern consts.
  // We expose the raw bit masks instead.
  const S_IFMT: u32;
  const S_IFREG: u32;
  const S_IFDIR: u32;
  const S_IFLNK: u32;

  const S_IRWXU: u32;
  const S_IRUSR: u32;
  const S_IWUSR: u32;
  const S_IXUSR: u32;
  const S_IRWXG: u32;
  const S_IRGRP: u32;
  const S_IWGRP: u32;
  const S_IXGRP: u32;
  const S_IRWXO: u32;
  const S_IROTH: u32;
  const S_IWOTH: u32;
  const S_IXOTH: u32;
}

/// Host `struct stat`, laid out field for field.
///
/// `stat(2)` fills a caller-provided struct whose layout is fixed by the
/// target's kernel ABI, not by POSIX. On x86_64 Linux that layout is the
/// kernel's `stat` for the architecture, including the padding word after
/// `st_gid`, the three `timespec` pairs, and three reserved words at the end.
/// Every member is listed, including the ones this module never reads, so the
/// record's size and every offset match the struct the kernel writes.
///
/// The record exists only for the target its layout was checked against, so a
/// target without one fails to compile rather than reading the wrong bytes.
/// Adding a target means adding its layout under its own `@configFlag`.
@configFlag(@platform("linux") && @arch("x86_64"))
record RawStat {
  public dev: u64;
  public ino: u64;
  public nlink: u64;
  public mode: u32;
  public uid: u32;
  public gid: u32;
  public pad0: u32;
  public rdev: u64;
  public size: i64;
  public blksize: i64;
  public blocks: i64;
  public atimeSec: i64;
  public atimeNsec: i64;
  public mtimeSec: i64;
  public mtimeNsec: i64;
  public ctimeSec: i64;
  public ctimeNsec: i64;
  public reserved0: i64;
  public reserved1: i64;
  public reserved2: i64;
}

// POSIX stat family (sys/stat.h). Each fills a caller-owned `RawStat`.
extern __fs_stat {
  /// POSIX `stat`; follows symlinks.
  function stat(pathname: *u8, statbuf: &mut RawStat): i32;
  /// POSIX `fstat`; describes an open file descriptor.
  function fstat(fd: i32, statbuf: &mut RawStat): i32;
  /// POSIX `lstat`; describes the link itself.
  function lstat(pathname: *u8, statbuf: &mut RawStat): i32;
}

// POSIX directory stream operations (dirent.h).
extern __fs_dir {
  /// POSIX `opendir`; opens a directory stream.
  function opendir(name: *u8): CType::DirPtr;
  /// POSIX `closedir`; closes a directory stream.
  function closedir(dirp: CType::DirPtr): i32;

  // readdir returns a pointer into a stream-owned dirent. It is typed as
  // *mut void here and read through the DIRENT_* offsets below.
  /// POSIX `readdir`; returns a host-owned `dirent` pointer or null.
  function readdir(dirp: CType::DirPtr): *mut void;
}

extern __fs_path {
  /// POSIX `realpath`; resolves an absolute canonical path.
  function realpath(pathname: *u8, resolvedPath: *u8): *mut u8;
}

// errno access — platform-specific function name.
@configFlag(@platform("linux"))
extern __fs_errno_fn {
  @externName("__errno_location")
  /// Returns the thread-local `errno` pointer on Linux.
  function errno_location(): *mut i32;
}

@configFlag(@platform("macos"))
extern __fs_errno_fn {
  @externName("__error")
  /// Returns the thread-local `errno` pointer on macOS.
  function errno_location(): *mut i32;
}

// strerror and errno constants (POSIX-standard).
extern __fs_errno {
  /// Returns a host-owned message for an errno value.
  function strerror(errnum: i32): *u8;

  const ENOENT: i32;
  const EACCES: i32;
  const EEXIST: i32;
  const EINVAL: i32;
  const EINTR: i32;
  const EAGAIN: i32;
  const ETIMEDOUT: i32;
}

// =============================================================================
// Public types and namespace
// =============================================================================

/// POSIX filesystem backend used by supported Unix-like targets.
export namespace Fs::Sys {
  // ---- Stat record ----

  /// File metadata returned by `stat` and `fstat`.
  ///
  /// Fields correspond to POSIX `struct stat` members. Times are
  /// seconds since the Unix epoch (tv_sec only; sub-second precision
  /// is not exposed).
  record Stat {
    public dev: u64;
    public ino: u64;
    public mode: u32;
    public nlink: u64;
    public uid: u32;
    public gid: u32;
    public size: i64;
    public atime: i64;
    public mtime: i64;

    /// Nanosecond remainder of `mtime`, i.e. `mtime * 1_000_000_000 + mtimeNsec`
    /// is the full-precision modification time. Exposed because a compiler
    /// rebuild can land inside the same second as the previous build, where
    /// second-granularity `mtime` alone cannot tell the two apart.
    public mtimeNsec: i64;
    public ctime: i64;
    public blksize: i64;
    public blocks: i64;
  }

  // ---- SysDirEntry record ----

  /// Single entry read from a directory stream via `readdir`.
  ///
  /// The `name` field is borrowed from the internal C dirent buffer —
  /// valid only until the next `readdir` call or `closedir`.
  record SysDirEntry {
    /// File name (borrowed — valid until next readdir/closedir).
    public name: str;

    /// Inode number.
    public ino: u64;

    /// File type hint (DT_REG, DT_DIR, etc.). 0 if unknown.
    public fileType: u8;
  }

  // ---- Open flags (re-exported from extern consts) ----

  const SEEK_SET: i32 = __fs_io::SEEK_SET;
  const SEEK_CUR: i32 = __fs_io::SEEK_CUR;
  const SEEK_END: i32 = __fs_io::SEEK_END;

  const O_RDONLY: i32 = __fs_io::O_RDONLY;
  const O_WRONLY: i32 = __fs_io::O_WRONLY;
  const O_RDWR: i32 = __fs_io::O_RDWR;
  const O_CREAT: i32 = __fs_io::O_CREAT;
  const O_TRUNC: i32 = __fs_io::O_TRUNC;
  const O_APPEND: i32 = __fs_io::O_APPEND;
  const O_EXCL: i32 = __fs_io::O_EXCL;

  // ---- Mode bits ----

  const S_IFMT: u32 = __fs_io::S_IFMT;
  const S_IFREG: u32 = __fs_io::S_IFREG;
  const S_IFDIR: u32 = __fs_io::S_IFDIR;
  const S_IFLNK: u32 = __fs_io::S_IFLNK;

  const S_IRWXU: u32 = __fs_io::S_IRWXU;
  const S_IRUSR: u32 = __fs_io::S_IRUSR;
  const S_IWUSR: u32 = __fs_io::S_IWUSR;
  const S_IXUSR: u32 = __fs_io::S_IXUSR;
  const S_IRWXG: u32 = __fs_io::S_IRWXG;
  const S_IRGRP: u32 = __fs_io::S_IRGRP;
  const S_IWGRP: u32 = __fs_io::S_IWGRP;
  const S_IXGRP: u32 = __fs_io::S_IXGRP;
  const S_IRWXO: u32 = __fs_io::S_IRWXO;
  const S_IROTH: u32 = __fs_io::S_IROTH;
  const S_IWOTH: u32 = __fs_io::S_IWOTH;
  const S_IXOTH: u32 = __fs_io::S_IXOTH;

  // ---- dirent type constants ----

  /// Unknown file type.
  const DT_UNKNOWN: u8 = 0;
  /// Regular file.
  const DT_REG: u8 = 8;
  /// Directory.
  const DT_DIR: u8 = 4;
  /// Symbolic link.
  const DT_LNK: u8 = 10;

  // =========================================================================
  // Host `struct dirent` layout
  // =========================================================================

  // `readdir(3)` hands back a pointer into a stream-owned `struct dirent`. The
  // offsets below are the only part of that struct this module reads, so the
  // struct is never mirrored as a whole. On x86_64 Linux the layout is the
  // kernel's UAPI `dirent64`: `d_ino` (u64) at 0, `d_off` (i64) at 8,
  // `d_reclen` (u16) at 16, `d_type` (u8) at 18, and the inline `d_name`
  // character array at 19.
  //
  // Any target whose layout has not been checked has to fail at compile time
  // rather than read the wrong bytes. These constants exist only for the
  // target they were checked against, so on any other one the module fails to
  // compile with the offsets reported undeclared.
  //
  // A second definition under the negated condition would say so in a
  // sentence instead, but `@configFlag` with a negated predicate is not
  // honored by the selfhost compiler: it keeps the declaration and reports the
  // pair as a redefinition. See
  // `test_cases/repro/configflag_negated_predicate.ign`.

  /// Byte offset of `d_ino` inside the host `struct dirent`.
  @configFlag(@platform("linux") && @arch("x86_64"))
  const DIRENT_INO_OFFSET: u64 = 0;

  /// Byte offset of `d_type` inside the host `struct dirent`.
  @configFlag(@platform("linux") && @arch("x86_64"))
  const DIRENT_TYPE_OFFSET: u64 = 18;

  /// Byte offset of the inline `d_name` array inside the host `struct dirent`.
  @configFlag(@platform("linux") && @arch("x86_64"))
  const DIRENT_NAME_OFFSET: u64 = 19;

  /// Returns the `d_name` array address inside a host `dirent`.
  ///
  /// The array is inline in the entry, so this borrows from the directory
  /// stream and stays valid only until the next `readdir` or `closedir`.
  function direntName(entry: *mut void): str {
    let base: *mut u8 = @pointerCast<*mut u8>(entry);
    return (base + Fs::Sys::DIRENT_NAME_OFFSET) as str;
  }

  /// Returns `d_ino` from a host `dirent`.
  function direntIno(entry: *mut void): u64 {
    let base: *mut u8 = @pointerCast<*mut u8>(entry);
    return @read<u64>(@pointerCast<*mut u64>(base + Fs::Sys::DIRENT_INO_OFFSET));
  }

  /// Returns `d_type` from a host `dirent`.
  function direntType(entry: *mut void): u8 {
    let base: *mut u8 = @pointerCast<*mut u8>(entry);
    return @read<u8>(base + Fs::Sys::DIRENT_TYPE_OFFSET);
  }

  // =========================================================================
  // errno helper (private)
  // =========================================================================

  /// Converts current `errno` into the portable `Io::IoError` representation.
  function lastError(): Io::IoError {
    let rawErrno: i32 = @read<i32>(__fs_errno_fn::errno_location());
    let msg: str = __fs_errno::strerror(rawErrno) as str;

    let kind: Io::ErrorKind = match (rawErrno) {
      __fs_errno::ENOENT -> Io::ErrorKind::NOT_FOUND,
      __fs_errno::EACCES -> Io::ErrorKind::PERMISSION_DENIED,
      __fs_errno::EEXIST -> Io::ErrorKind::ALREADY_EXISTS,
      __fs_errno::EINVAL -> Io::ErrorKind::INVALID_INPUT,
      __fs_errno::EINTR -> Io::ErrorKind::INTERRUPTED,
      __fs_errno::EAGAIN -> Io::ErrorKind::WOULD_BLOCK,
      __fs_errno::ETIMEDOUT -> Io::ErrorKind::TIMED_OUT,
      _ -> Io::ErrorKind::OTHER,
    };

    return Io::IoError {
      kind: kind,
      raw: rawErrno,
      message: msg,
    };
  }

  // =========================================================================
  // Syscall wrappers
  // =========================================================================

  /// Opens `path` with `flags` and `mode`. Returns the fd on success.
  ///
  /// Uses the 3-argument `open(2)` so `mode` is always available for
  /// `O_CREAT`. Pass 0 for `mode` when not creating.
  function open(path: str, flags: i32, mode: u32): Result<i32, Io::IoError> {
    let fd: i32 = __fs_io::open(path as *u8, flags, mode);
    if (fd == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(fd);
  }

  /// Closes file descriptor `fd`.
  function close(fd: i32): Result<void, Io::IoError> {
    let rc: i32 = __fs_io::close(fd);
    if (rc == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(());
  }

  /// Reads up to `count` bytes from `fd` into `buf`.
  ///
  /// Returns the number of bytes actually read (0 means EOF).
  function read(fd: i32, buf: *mut void, count: u64): Result<i64, Io::IoError> {
    let n: i64 = __fs_io::read(fd, buf, count);
    if (n == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(n);
  }

  /// Writes up to `count` bytes from `buf` to `fd`.
  ///
  /// Returns the number of bytes actually written.
  function write(fd: i32, buf: *mut void, count: u64): Result<i64, Io::IoError> {
    let n: i64 = __fs_io::write(fd, buf, count);
    if (n == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(n);
  }

  /// Repositions the file offset of `fd`.
  ///
  /// `whence` is `SEEK_SET`, `SEEK_CUR`, or `SEEK_END`.
  function lseek(fd: i32, offset: i64, whence: i32): Result<i64, Io::IoError> {
    let pos: i64 = __fs_io::lseek(fd, offset, whence);
    if (pos == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(pos);
  }

  /// Returns a temp-dir candidate only when the raw path is non-empty and a directory.
  function tempDirCandidate(value: *mut u8): Option<String> {
    if (value == null || LibC::String::strlen(value as *u8) == 0) {
      return Option::NONE;
    }

    let candidate: String = String::create(value as str);
    let statResult: Result<Stat, Io::IoError> = Fs::Sys::lstat(candidate.toStr());

    if (let Result::OK(stat) = statResult) {
      if ((stat.mode & Fs::Sys::S_IFMT) == Fs::Sys::S_IFDIR) {
        return Option::SOME(candidate.clone());
      }
    }

    return Option::NONE;
  }

  /// Size of the host `struct stat`, in bytes.
  ///
  /// Nothing allocates against this value; it exists so `RawStat` can be
  /// pinned to the size the kernel writes. Like the `DIRENT_*` offsets it is
  /// defined only for the target it was checked against.
  @configFlag(@platform("linux") && @arch("x86_64"))
  const STAT_STRUCT_SIZE: u64 = 144;

  /// True when the compiled `RawStat` is the size of the host `struct stat`.
  ///
  /// `std/fs/tests.ign` pins this, so a field added to or dropped from
  /// `RawStat` fails a test instead of silently shifting every offset after it.
  function rawStatMatchesHostLayout(): boolean {
    return @sizeOf<RawStat>() == Fs::Sys::STAT_STRUCT_SIZE;
  }

  /// Returns a zeroed `RawStat` for a `stat` family call to fill.
  function emptyRawStat(): RawStat {
    return RawStat {
      dev: 0, ino: 0, nlink: 0, mode: 0, uid: 0, gid: 0, pad0: 0, rdev: 0,
      size: 0, blksize: 0, blocks: 0,
      atimeSec: 0, atimeNsec: 0,
      mtimeSec: 0, mtimeNsec: 0,
      ctimeSec: 0, ctimeNsec: 0,
      reserved0: 0, reserved1: 0, reserved2: 0,
    };
  }

  /// Projects a filled `RawStat` onto the portable `Stat` this module returns.
  ///
  /// `atime` and `ctime` are truncated to whole seconds; `mtime` keeps its
  /// nanosecond remainder in `mtimeNsec` since full-precision modification
  /// time distinguishes a same-second rebuild from an unchanged file.
  function statFromRaw(raw: &RawStat): Stat {
    return Stat {
      dev: raw.dev,
      ino: raw.ino,
      mode: raw.mode,
      nlink: raw.nlink,
      uid: raw.uid,
      gid: raw.gid,
      size: raw.size,
      atime: raw.atimeSec,
      mtime: raw.mtimeSec,
      mtimeNsec: raw.mtimeNsec,
      ctime: raw.ctimeSec,
      blksize: raw.blksize,
      blocks: raw.blocks,
    };
  }

  /// Returns file metadata for `path`.
  function stat(path: str): Result<Stat, Io::IoError> {
    let mut raw: RawStat = Fs::Sys::emptyRawStat();
    let rc: i32 = __fs_stat::stat(path as *u8, &mut raw);

    if (rc == -1) {
      return Result::ERROR(lastError());
    }

    return Result::OK(Fs::Sys::statFromRaw(&raw));
  }

  /// Returns file metadata for open file descriptor `fd`.
  function fstat(fd: i32): Result<Stat, Io::IoError> {
    let mut raw: RawStat = Fs::Sys::emptyRawStat();
    let rc: i32 = __fs_stat::fstat(fd, &mut raw);

    if (rc == -1) {
      return Result::ERROR(lastError());
    }

    return Result::OK(Fs::Sys::statFromRaw(&raw));
  }

  /// Returns file metadata for `path` without following symlinks.
  function lstat(path: str): Result<Stat, Io::IoError> {
    let mut raw: RawStat = Fs::Sys::emptyRawStat();
    let rc: i32 = __fs_stat::lstat(path as *u8, &mut raw);

    if (rc == -1) {
      return Result::ERROR(lastError());
    }

    return Result::OK(Fs::Sys::statFromRaw(&raw));
  }

  /// Resolves `path` to an existing canonical absolute path.
  function realpath(path: str): Result<String, Io::IoError> {
    let resolvedPath: *mut u8 = __fs_path::realpath(path as *u8, null);

    if (resolvedPath == null) {
      return Result::ERROR(lastError());
    }

    let ownedPath: String = String::create(resolvedPath as str);
    LibC::Allocator::free(resolvedPath as *mut void);

    return Result::OK(ownedPath);
  }

  /// Returns the host temporary-directory root.
  function tempDirPath(): Result<String, Io::IoError> {
    if (let Option::SOME(value) = Fs::Sys::tempDirCandidate(LibC::Process::getenv("TMPDIR" as *u8))) {
      return Result::OK(value);
    }

    if (let Option::SOME(value) = Fs::Sys::tempDirCandidate(LibC::Process::getenv("TEMP" as *u8))) {
      return Result::OK(value);
    }

    if (let Option::SOME(value) = Fs::Sys::tempDirCandidate(LibC::Process::getenv("TMP" as *u8))) {
      return Result::OK(value);
    }

    return Result::OK(String::create("/tmp"));
  }

  /// Creates a directory at `path` with the given permission `mode`.
  function mkdir(path: str, mode: u32): Result<void, Io::IoError> {
    let rc: i32 = __fs_io::mkdir(path as *u8, mode);
    if (rc == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(());
  }

  /// Removes the file at `path`.
  function unlink(path: str): Result<void, Io::IoError> {
    let rc: i32 = __fs_io::unlink(path as *u8);
    if (rc == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(());
  }

  /// Removes the empty directory at `path`.
  function rmdir(path: str): Result<void, Io::IoError> {
    let rc: i32 = __fs_io::rmdir(path as *u8);
    if (rc == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(());
  }

  /// Recursively removes a directory tree without following symlink directories.
  function removeDirAll(path: str): Result<void, Io::IoError> {
    let entry: Stat = Fs::Sys::lstat(path)!;

    if ((entry.mode & Fs::Sys::S_IFMT) != Fs::Sys::S_IFDIR) {
      return Fs::Sys::unlink(path);
    }

    Fs::Sys::removeDirChildren(path)!;

    return Fs::Sys::rmdir(path);
  }

  /// True for the `.` and `..` entries every directory stream yields.
  function isDotEntryName(name: *mut u8): boolean {
    if (@read<u8>(name) != ('.' as u8)) {
      return false;
    }

    let second: u8 = @read<u8>(name + 1);

    if (second == 0) {
      return true;
    }

    if (second != ('.' as u8)) {
      return false;
    }

    return @read<u8>(name + 2) == 0;
  }

  /// Removes every entry under `path`, leaving the directory itself in place.
  ///
  /// The stream stays open across the recursive calls, matching the traversal
  /// the C helper this replaced performed.
  function removeDirChildren(path: str): Result<void, Io::IoError> {
    let dirp: CType::DirPtr = Fs::Sys::opendir(path)!;
    let outcome: Result<void, Io::IoError> = Fs::Sys::removeOpenDirChildren(path, dirp);

    if (outcome.isError()) {
      Fs::Sys::closedir(dirp);
      return outcome;
    }

    if (__fs_dir::closedir(dirp) == -1) {
      return Result::ERROR(lastError());
    }

    return Result::OK(());
  }

  /// Drains an open directory stream, removing each entry it yields.
  function removeOpenDirChildren(path: str, dirp: CType::DirPtr): Result<void, Io::IoError> {
    while (true) {
      let mut rawName: u64 = 0;
      let mut rawIno: u64 = 0;
      let mut rawFileType: u8 = 0;
      let hasEntry: boolean = Fs::Sys::readdirEntry(dirp, &mut rawName, &mut rawIno, &mut rawFileType)!;

      if (!hasEntry) {
        break;
      }

      let namePointer: *mut u8 = @pointerFromInteger<*mut u8>(rawName);

      if (Fs::Sys::isDotEntryName(namePointer)) {
        continue;
      }

      let mut childPath: String = String::create(path);
      childPath.pushStr("/");
      childPath.pushStr(namePointer as str);

      let removed: Result<void, Io::IoError> = Fs::Sys::removeDirAll(childPath.toStr());

      childPath.drop();
      removed!;
    }

    return Result::OK(());
  }

  /// Renames `oldPath` to `newPath`.
  function rename(oldPath: str, newPath: str): Result<void, Io::IoError> {
    let rc: i32 = __fs_io::rename(oldPath as *u8, newPath as *u8);
    if (rc == -1) {
      return Result::ERROR(lastError());
    }
    return Result::OK(());
  }

  /// Opens a directory stream for reading entries.
  ///
  /// The returned `DirPtr` must be closed with `closedir` when done.
  function opendir(path: str): Result<CType::DirPtr, Io::IoError> {
    let dirp: CType::DirPtr = __fs_dir::opendir(path as *u8);
    if (dirp == null) {
      return Result::ERROR(lastError());
    }
    return Result::OK(dirp);
  }

  /// Reads the next entry from a directory stream.
  function readdirEntry(
    dirp: CType::DirPtr,
    outName: &mut u64,
    outIno: &mut u64,
    outType: &mut u8
  ): Result<boolean, Io::IoError> {
    if (dirp == null) {
      return Result::ERROR(Io::IoError::fromErrno(__fs_errno::EINVAL));
    }

    @write<i32>(__fs_errno_fn::errno_location(), 0);

    let entry: *mut void = __fs_dir::readdir(dirp);

    if (entry == null) {
      if (@read<i32>(__fs_errno_fn::errno_location()) == 0) {
        return Result::OK(false);
      }

      return Result::ERROR(lastError());
    }

    outName = @integerFromPointer(Fs::Sys::direntName(entry) as *u8);
    outIno = Fs::Sys::direntIno(entry);
    outType = Fs::Sys::direntType(entry);

    return Result::OK(true);
  }

  /// Reads the next entry from a directory stream.
  ///
  /// Returns `Result::OK(Option::NONE)` when the end of the directory is reached.
  /// The returned `SysDirEntry` borrows its `name` from the internal
  /// dirent buffer — valid only until the next `readdir` or `closedir`.
  function readdir(dirp: CType::DirPtr): Result<Option<SysDirEntry>, Io::IoError> {
    if (dirp == null) {
      return Result::ERROR(Io::IoError::fromErrno(__fs_errno::EINVAL));
    }

    @write<i32>(__fs_errno_fn::errno_location(), 0);

    let entry: *mut void = __fs_dir::readdir(dirp);
    if (entry == null) {
      let rawErrno: i32 = @read<i32>(__fs_errno_fn::errno_location());

      if (rawErrno == 0) {
        return Result::OK(Option::NONE);
      }

      return Result::ERROR(lastError());
    }

    let name: str = Fs::Sys::direntName(entry);
    let ino: u64 = Fs::Sys::direntIno(entry);
    let fileType: u8 = Fs::Sys::direntType(entry);

    return Result::OK(Option::SOME(SysDirEntry { name: name, ino: ino, fileType: fileType }));
  }

  /// Closes a directory stream opened with `opendir`.
  function closedir(dirp: CType::DirPtr): void {
    __fs_dir::closedir(dirp);
  }
}
