import Test from "std::test";
import Captures, Match, parseRegex, Regex from "std::regex";
import regexAstDebug from "./ast";
import regexLiteralPrefix from "./regex";

function regexTestShape(pattern: str, expected: str): void {
  match (parseRegex(pattern)) {
    Result::OK(ast) -> {
      let shape: String = regexAstDebug(&ast);
      Test::assertEq<str>(shape.toStr(), expected);
    },
    Result::ERROR(error) -> {
      let text: String = error.toString();
      Test::assertEq<str>(text.toStr(), "no error");
    },
  };
}

function regexTestError(pattern: str, message: str, column: u64): void {
  match (parseRegex(pattern)) {
    Result::OK(_) -> {
      Test::assertEq<str>("parsed", message);
    },
    Result::ERROR(error) -> {
      Test::assertEq<str>(error.message(), message);
      Test::assertEq<u64>(error.column(), column);
    },
  };
}

function regexTestGroupCount(pattern: str): u64 {
  let Result::OK(ast) = parseRegex(pattern) else {
    return 0xFFFF;
  };

  return ast.groupCount;
}

@test
function parsesLiteralsAndConcatenation(): void {
  regexTestShape("", "empty");
  regexTestShape("a", "lit(a)");
  regexTestShape("abc", "cat(lit(a),lit(b),lit(c))");
  regexTestShape("é+", "rep{1,inf}(lit(U+00E9))");
  regexTestShape("a]}", "cat(lit(a),lit(]),lit(}))");
}

@test
function parsesEscapes(): void {
  regexTestShape("\\.\\*\\\\\\n", "cat(lit(.),lit(*),lit(\\),lit(U+000A))");
  regexTestShape("\\t\\r\\f\\v", "cat(lit(U+0009),lit(U+000D),lit(U+000C),lit(U+000B))");
  regexTestShape("\\{\\}\\[\\]\\(\\)\\|\\^\\$\\?\\+", "cat(lit({),lit(}),lit([),lit(]),lit(U+0028),lit(U+0029),lit(|),lit(^),lit($),lit(?),lit(+))");
}

@test
function parsesShorthandClasses(): void {
  regexTestShape("\\d", "class(0-9)");
  regexTestShape("\\w", "class(0-9,A-Z,_,a-z)");
  regexTestShape("\\s", "class(U+0009-U+000D,U+0020)");
  regexTestShape("\\D", "class(U+0000-/,:-U+10FFFF)");
  regexTestShape("\\S", "class(U+0000-U+0008,U+000E-U+001F,!-U+10FFFF)");
  regexTestShape("\\W", "class(U+0000-/,:-@,[-^,`,{-U+10FFFF)");
}

@test
function parsesClasses(): void {
  regexTestShape("[a-cx]", "class(a-c,x)");
  regexTestShape("[^a-z0-9_]", "nclass(0-9,_,a-z)");
  regexTestShape("[c-ea-d]", "class(a-e)");
  regexTestShape("[a-]", "class(U+002D,a)");
  regexTestShape("[-a]", "class(U+002D,a)");
  regexTestShape("[\\d.]", "class(.,0-9)");
  regexTestShape("[\\]\\-]", "class(U+002D,])");
  regexTestShape("[\\n-\\r]", "class(U+000A-U+000D)");
  regexTestShape("[.*(]", "class(U+0028,*,.)");
}

@test
function parsesAnyAndAssertions(): void {
  regexTestShape("^a.$", "cat(start,lit(a),any,end)");
  regexTestShape("\\bx\\B", "cat(wordb,lit(x),nwordb)");
}

@test
function parsesAlternation(): void {
  regexTestShape("a|bc", "alt(lit(a),cat(lit(b),lit(c)))");
  regexTestShape("a|b|", "alt(lit(a),lit(b),empty)");
  regexTestShape("|a", "alt(empty,lit(a))");
}

@test
function parsesGreedyQuantifiers(): void {
  regexTestShape("ab*", "cat(lit(a),rep{0,inf}(lit(b)))");
  regexTestShape("a+", "rep{1,inf}(lit(a))");
  regexTestShape("a?", "rep{0,1}(lit(a))");
  regexTestShape("a{3}", "rep{3,3}(lit(a))");
  regexTestShape("a{2,}", "rep{2,inf}(lit(a))");
  regexTestShape("a{2,5}", "rep{2,5}(lit(a))");
  regexTestShape("a{0,1000}", "rep{0,1000}(lit(a))");
  regexTestShape("(ab)*", "rep{0,inf}(group(1,cat(lit(a),lit(b))))");
  regexTestShape("[ab]+", "rep{1,inf}(class(a-b))");
}

@test
function parsesLazyQuantifiers(): void {
  regexTestShape("a*?", "rep{0,inf}?(lit(a))");
  regexTestShape("a+?b??", "cat(rep{1,inf}?(lit(a)),rep{0,1}?(lit(b)))");
  regexTestShape("a{2,5}?", "rep{2,5}?(lit(a))");
  regexTestShape("a{2,}?", "rep{2,inf}?(lit(a))");
}

@test
function parsesGroups(): void {
  regexTestShape("(a)(?:b)(?<word>c)", "cat(group(1,lit(a)),ncgroup(lit(b)),group(2:word,lit(c)))");
  regexTestShape("((a)b)", "group(1,cat(group(2,lit(a)),lit(b)))");
  regexTestShape("()", "group(1,empty)");
  regexTestShape("(?<_x9>a)", "group(1:_x9,lit(a))");
  Test::assertEq<u64>(regexTestGroupCount("(a)(?:b)(?<c>c)((d))"), 4);
  Test::assertEq<u64>(regexTestGroupCount("abc"), 0);
}

@test
function caseInsensitiveFlagFoldsAsciiLetters(): void {
  regexTestShape("(?i)ab", "cat(class(A,a),class(B,b))");
  regexTestShape("(?i)1", "lit(1)");
  regexTestShape("a(?i)b|c", "alt(cat(lit(a),class(B,b)),class(C,c))");
  regexTestShape("(?i:a)b", "cat(ncgroup(class(A,a)),lit(b))");
  regexTestShape("((?i)a)b", "cat(group(1,class(A,a)),lit(b))");
  regexTestShape("(?i)[a-cX]", "class(A-C,X,a-c,x)");
  regexTestShape("(?i)[^k]", "nclass(K,k)");
  regexTestShape("(?i)[Y-b]", "class(A-B,Y-b,y-z)");
}

@test
function errorFormatsMessageAndColumn(): void {
  let Result::ERROR(error) = parseRegex("abcdef(") else {
    Test::fail();
    return;
  };

  let text: String = error.toString();
  Test::assertEq<str>(text.toStr(), "unclosed group at column 7");
}

@test
function rejectsUnbalancedGroups(): void {
  regexTestError("(ab", "unclosed group", 1);
  regexTestError("abcdef(", "unclosed group", 7);
  regexTestError("a(b(c)", "unclosed group", 2);
  regexTestError("é(", "unclosed group", 2);
  regexTestError("a)", "unmatched )", 2);
  regexTestError("(a))", "unmatched )", 4);
}

@test
function rejectsNothingToRepeat(): void {
  regexTestError("*a", "nothing to repeat", 1);
  regexTestError("a|*", "nothing to repeat", 3);
  regexTestError("(+)", "nothing to repeat", 2);
  regexTestError("a**", "nothing to repeat", 3);
  regexTestError("a*??", "nothing to repeat", 4);
  regexTestError("a{2}{3}", "nothing to repeat", 5);
  regexTestError("^*", "nothing to repeat", 2);
  regexTestError("\\b+", "nothing to repeat", 3);
  regexTestError("(?i)*", "nothing to repeat", 5);
  regexTestError("{2}", "nothing to repeat", 1);
}

@test
function rejectsBadClasses(): void {
  regexTestError("[z-a]", "invalid range z-a", 3);
  regexTestError("[\\d-z]", "invalid range", 4);
  regexTestError("[a", "unclosed class", 1);
  regexTestError("x[a-", "unclosed class", 2);
  regexTestError("[]", "empty class", 1);
  regexTestError("[^]", "empty class", 1);
  regexTestError("[\\b]", "unknown escape \\b", 2);
}

@test
function rejectsBadEscapes(): void {
  regexTestError("a\\", "trailing backslash", 2);
  regexTestError("\\q", "unknown escape \\q", 1);
  regexTestError("\\0", "unknown escape \\0", 1);
  regexTestError("(a)b\\1", "unsupported: backreference", 5);
  regexTestError("[\\2]", "unsupported: backreference", 2);
}

@test
function rejectsBadRepetitions(): void {
  regexTestError("a{", "invalid repetition", 2);
  regexTestError("a{}", "invalid repetition", 2);
  regexTestError("a{,3}", "invalid repetition", 2);
  regexTestError("a{2", "invalid repetition", 2);
  regexTestError("a{2,x}", "invalid repetition", 2);
  regexTestError("a{3,2}", "invalid repetition range", 2);
  regexTestError("a{1001}", "repetition count above 1000", 2);
  regexTestError("a{1,1001}", "repetition count above 1000", 2);
  regexTestError("a{99999999999}", "repetition count above 1000", 2);
}

@test
function rejectsLookaround(): void {
  regexTestError("(?=a)", "unsupported: lookaround", 1);
  regexTestError("x(?!a)", "unsupported: lookaround", 2);
  regexTestError("(?<=a)", "unsupported: lookaround", 1);
  regexTestError("(?<!a)", "unsupported: lookaround", 1);
}

@test
function rejectsBadGroupSyntax(): void {
  regexTestError("(?x)", "unknown group flag", 3);
  regexTestError("(?ix)", "unknown group flag", 4);
  regexTestError("(?", "unclosed group", 1);
  regexTestError("(?<1a>x)", "invalid group name", 4);
  regexTestError("(?<a-b>x)", "invalid group name", 5);
  regexTestError("(?<>x)", "invalid group name", 4);
  regexTestError("(?<ab", "unclosed group", 1);
  regexTestError("(?<a>x)(?<a>y)", "duplicate group name a", 11);
}

function regexTestCompile(pattern: str): Regex {
  match (Regex::new(pattern)) {
    Result::OK(regex) -> {
      return regex;
    },
    Result::ERROR(error) -> {
      let text: String = error.toString();
      Test::assertEq<str>(text.toStr(), "no error");
      return Regex::new("").unwrap();
    },
  };
}

function regexTestPushMatch(text: &mut String, found: &Match): void {
  let startOffset: u64 = found.start();
  let endOffset: u64 = found.end();
  let start: String = startOffset.toString();
  let end: String = endOffset.toString();
  text.push(&start);
  text.pushStr("..");
  text.push(&end);
}

/// The first match of `pattern` in `text` as `start..end`, or `none`.
function regexTestFind(pattern: str, text: str, expected: str): void {
  let regex: Regex = regexTestCompile(pattern);
  let mut shown: String = String::new();

  match (regex.find(text)) {
    Option::SOME(found) -> {
      regexTestPushMatch(&mut shown, &found);
    },
    Option::NONE -> {
      shown.pushStr("none");
    },
  };

  Test::assertEq<str>(shown.toStr(), expected);
  Test::assertEq<boolean>(regex.isMatch(text), !shown.equals("none"));
}

/// Every match of `pattern` in `text` as `start..end`, comma-separated.
function regexTestFindAll(pattern: str, text: str, expected: str): void {
  let regex: Regex = regexTestCompile(pattern);
  let matches: Vector<Match> = regex.findAll(text);
  let mut shown: String = String::new();
  let mut index: u64 = 0;

  while (index < matches.length()) {
    if (index > 0) {
      shown.pushStr(",");
    }

    regexTestPushMatch(&mut shown, matches.get(index).unwrap());
    index += 1;
  }

  Test::assertEq<str>(shown.toStr(), expected);
}

@test
function matchesLiterals(): void {
  regexTestFind("abc", "xxabcabc", "2..5");
  regexTestFind("abc", "ab", "none");
  regexTestFind("", "abc", "0..0");
  regexTestFind("b", "", "none");
}

@test
function matchesClasses(): void {
  regexTestFind("[a-c]+", "xxbcaz", "2..5");
  regexTestFind("[^a-c]+", "abxyc", "2..4");
  regexTestFind("\\d+", "ab123c", "2..5");
  regexTestFind("\\W", "ab_9 x", "4..5");
  regexTestFind("[^a]", "aaa", "none");
}

@test
function matchesAnyExceptNewline(): void {
  regexTestFind("a.c", "a\nc abc", "4..7");
  regexTestFind(".", "\n", "none");
  regexTestFind("[^x]", "\n", "0..1");
}

@test
function matchesAnchors(): void {
  regexTestFind("^ab", "abab", "0..2");
  regexTestFind("^b", "ab", "none");
  regexTestFind("ab$", "abab", "2..4");
  regexTestFind("a$", "a\n", "none");
  regexTestFind("^$", "", "0..0");
  regexTestFindAll("^a", "aaa", "0..1");
}

@test
function matchesWordBoundaries(): void {
  regexTestFind("\\bcat\\b", "concat cat", "7..10");
  regexTestFind("\\Bcat", "cat concat", "7..10");
  regexTestFindAll("\\b", "ab cd", "0..0,2..2,3..3,5..5");
}

@test
function prefersTheFirstAlternative(): void {
  regexTestFind("a|ab", "ab", "0..1");
  regexTestFind("ab|a", "ab", "0..2");
  regexTestFind("x|ab|a", "zab", "1..3");
}

@test
function matchesGreedyAndLazyRepetition(): void {
  regexTestFind("a+", "aaa", "0..3");
  regexTestFind("a+?", "aaa", "0..1");
  regexTestFind("a*?b", "aab", "0..3");
  regexTestFind("a??", "a", "0..0");
  regexTestFind("a?", "a", "0..1");
}

@test
function matchesCountedRepetition(): void {
  regexTestFind("a{3}", "aaaaa", "0..3");
  regexTestFind("a{2,}", "aaaaa", "0..5");
  regexTestFind("a{2,3}", "aaaaa", "0..3");
  regexTestFind("a{2,3}?", "aaaaa", "0..2");
  regexTestFind("a{3}", "aa", "none");
  regexTestFind("(?:ab){2}", "abaabab", "3..7");
}

@test
function matchesUtf8Scalars(): void {
  regexTestFind("é+", "ééx", "0..4");
  regexTestFind(".", "😀x", "0..4");
  regexTestFind("[à-ü]", "aé", "1..3");
  regexTestFindAll("", "é", "0..0,2..2");
}

@test
function matchesCaseInsensitively(): void {
  regexTestFind("(?i)abc", "xABc", "1..4");
  regexTestFind("a(?i:b)c", "aBc aBC", "0..3");
  regexTestFind("(?i)[a-c]+", "xBaC", "1..4");
}

@test
function findsEveryMatch(): void {
  regexTestFindAll("a*", "baa", "0..0,1..3,3..3");
  regexTestFindAll("\\d+", "a1b22c333", "1..2,3..5,6..9");
  regexTestFindAll("x", "abc", "");
  regexTestFindAll("aa", "aaaaa", "0..2,2..4");
}

@test
function exposesMatchOffsetsAndText(): void {
  let regex: Regex = regexTestCompile("b+");
  let found: Match = regex.find("abbc").unwrap();
  Test::assertEq<u64>(found.start(), 1);
  Test::assertEq<u64>(found.end(), 3);
  Test::assertEq<u64>(found.length(), 2);
  Test::assertEq<boolean>(found.isEmpty(), false);
  let text: String = found.textIn("abbc");
  Test::assertEq<str>(text.toStr(), "bb");
  let empty: Match = regexTestCompile("x*").find("abc").unwrap();
  Test::assertEq<boolean>(empty.isEmpty(), true);
}

@test
function rejectsPatternsThatCompileTooLarge(): void {
  match (Regex::new("(?:a{1000}){1000}")) {
    Result::OK(_) -> {
      Test::assertEq<str>("compiled", "pattern too large");
    },
    Result::ERROR(error) -> {
      Test::assertEq<str>(error.message(), "pattern too large");
    },
  };

  match (Regex::new("x{3}(")) {
    Result::OK(_) -> {
      Test::assertEq<str>("compiled", "unclosed group");
    },
    Result::ERROR(error) -> {
      Test::assertEq<str>(error.message(), "unclosed group");
    },
  };
}

@test
function matchesNestedStarsInLinearTime(): void {
  let mut text: String = String::new();
  let mut count: u64 = 0;

  while (count < 10000) {
    text.pushStr("a");
    count += 1;
  }

  let nested: Regex = regexTestCompile("(a*)*b");
  Test::assertEq<boolean>(nested.isMatch(text.toStr()), false);
  let alternatives: Regex = regexTestCompile("(a|aa)*c");
  Test::assertEq<boolean>(alternatives.isMatch(text.toStr()), false);
}

/// Every group of the first match of `pattern` in `text` as `start..end` or
/// `none`, comma-separated; `no match` without a match.
function regexTestCaptures(pattern: str, text: str, expected: str): void {
  let regex: Regex = regexTestCompile(pattern);
  let mut shown: String = String::new();

  match (regex.captures(text)) {
    Option::SOME(captures) -> {
      let mut index: u64 = 0;

      while (index < captures.length()) {
        if (index > 0) {
          shown.pushStr(",");
        }

        match (captures.group(index)) {
          Option::SOME(found) -> {
            regexTestPushMatch(&mut shown, &found);
          },
          Option::NONE -> {
            shown.pushStr("none");
          },
        };

        index += 1;
      }
    },
    Option::NONE -> {
      shown.pushStr("no match");
    },
  };

  Test::assertEq<str>(shown.toStr(), expected);
}

function regexTestReplaceAll(pattern: str, text: str, replacement: str, expected: str): void {
  let result: String = regexTestCompile(pattern).replaceAll(text, replacement);
  Test::assertEq<str>(result.toStr(), expected);
}

/// The pieces `split` gives, joined with `|`.
function regexTestSplit(pattern: str, text: str, expected: str): void {
  let pieces: Vector<String> = regexTestCompile(pattern).split(text);
  let mut shown: String = String::new();
  let mut index: u64 = 0;

  while (index < pieces.length()) {
    if (index > 0) {
      shown.pushStr("|");
    }

    shown.push(pieces.get(index).unwrap());
    index += 1;
  }

  Test::assertEq<str>(shown.toStr(), expected);
}

@test
function capturesNumberedAndNestedGroups(): void {
  regexTestCaptures("(\\d+)-(\\d+)", "x 12-345", "2..8,2..4,5..8");
  regexTestCaptures("((a)(b))c", "abc", "0..3,0..2,0..1,1..2");
  regexTestCaptures("(?:a)(b)", "ab", "0..2,1..2");
  regexTestCaptures("(a)", "xyz", "no match");
}

@test
function capturesNonParticipatingGroupsAsNone(): void {
  regexTestCaptures("(a)|(b)", "b", "0..1,none,0..1");
  regexTestCaptures("(a)?b", "b", "0..1,none");
  regexTestCaptures("(a)*", "", "0..0,none");
}

@test
function capturesTheLastIterationOfARepetition(): void {
  regexTestCaptures("(a|b)+", "ab", "0..2,1..2");
  regexTestCaptures("(?:(a)|b)+", "ab", "0..2,0..1");
  regexTestCaptures("(\\w)*!", "xyz!", "0..4,2..3");
}

@test
function capturesUtf8Offsets(): void {
  regexTestCaptures("(é+)(.)", "aééü", "1..7,1..5,5..7");
}

@test
function looksUpNamedGroups(): void {
  let regex: Regex = regexTestCompile("(?<year>\\d{4})-(\\d\\d)-(?<day>\\d\\d)");
  Test::assertEq<u64>(regex.groupCount(), 3);
  Test::assertEq<u64>(regex.groupIndex("day").unwrap(), 3);
  Test::assertEq<boolean>(regex.groupIndex("month").isNone(), true);
  Test::assertEq<boolean>(regex.groupName(2).isNone(), true);
  let name: String = regex.groupName(1).unwrap();
  Test::assertEq<str>(name.toStr(), "year");
  let captures: Captures = regex.captures("on 2024-05-17").unwrap();
  Test::assertEq<u64>(captures.groupCount(), 3);
  Test::assertEq<u64>(captures.length(), 4);
  let year: Match = captures.name("year").unwrap();
  Test::assertEq<u64>(year.start(), 3);
  Test::assertEq<u64>(year.end(), 7);
  let day: String = captures.name("day").unwrap().textIn("on 2024-05-17");
  Test::assertEq<str>(day.toStr(), "17");
  Test::assertEq<boolean>(captures.name("month").isNone(), true);
  Test::assertEq<boolean>(captures.name("").isNone(), true);
  Test::assertEq<boolean>(captures.group(4).isNone(), true);
  Test::assertEq<u64>(captures.whole().start(), 3);
  Test::assertEq<u64>(regexTestCompile("abc").groupCount(), 0);
}

@test
function capturesEveryMatch(): void {
  let regex: Regex = regexTestCompile("(\\w)(\\d)?");
  let all: Vector<Captures> = regex.capturesAll("a1 b c3");
  Test::assertEq<u64>(all.length(), 3);
  Test::assertEq<u64>(all.get(1).unwrap().group(1).unwrap().start(), 3);
  Test::assertEq<boolean>(all.get(1).unwrap().group(2).isNone(), true);
  Test::assertEq<u64>(all.get(2).unwrap().group(2).unwrap().start(), 6);
}

@test
function replacesWithGroupReferences(): void {
  regexTestReplaceAll("(\\w+)@(\\w+)", "a@b, cd@ef", "$2 at $1", "b at a, ef at cd");
  regexTestReplaceAll("(?<key>\\w+)=(?<value>\\w+)", "x=1 y=2", "${value}:${key}", "1:x 2:y");
  regexTestReplaceAll("\\d+", "a1b22", "$$", "a$b$");
  regexTestReplaceAll("\\d+", "a1", "$x ${ ${} $", "a$x ${ ${} $");
  regexTestReplaceAll("(a)|(b)", "ab", "[$1$2$3${missing}]", "[a][b]");
  regexTestReplaceAll("(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)", "abcdefghijkl", "$12${1}0$10", "la0j");
  regexTestReplaceAll("\\d", "a1", "$99999999999999999999", "a");
  regexTestReplaceAll("x", "abc", "-", "abc");
}

@test
function replacesEmptyMatches(): void {
  regexTestReplaceAll("x*", "abc", "-", "-a-b-c-");
  regexTestReplaceAll("", "é", "-", "-é-");
}

@test
function replacesOnlyTheFirstMatch(): void {
  let regex: Regex = regexTestCompile("(\\d)");
  let first: String = regex.replace("a1b2", "<$1>");
  Test::assertEq<str>(first.toStr(), "a<1>b2");
  let none: String = regex.replace("ab", "<$1>");
  Test::assertEq<str>(none.toStr(), "ab");
}

@test
function splitsBetweenMatches(): void {
  regexTestSplit(",", "a,b,,c", "a|b||c");
  regexTestSplit("\\s*,\\s*", "a , b,c", "a|b|c");
  regexTestSplit(",", ",a,", "|a|");
  regexTestSplit(",", "abc", "abc");
  regexTestSplit(",", "", "");
  regexTestSplit("", "abc", "|a|b|c|");
  regexTestSplit("x*", "aé", "|a|é|");
}

function regexTestPrefix(pattern: str, expected: str): void {
  let regex: Regex = regexTestCompile(pattern);
  let prefix: String = regexLiteralPrefix(&regex);
  Test::assertEq<str>(prefix.toStr(), expected);
}

@test
function extractsTheLiteralPrefix(): void {
  regexTestPrefix("abc", "abc");
  regexTestPrefix("foo(bar|baz)", "foo");
  regexTestPrefix("(?:ab)(c)d+e", "abcd");
  regexTestPrefix("ab*c", "a");
  regexTestPrefix("é\\d", "é");
  regexTestPrefix("(?i)1ab", "1");
  regexTestPrefix("", "");
  regexTestPrefix("^abc", "");
  regexTestPrefix("[a]bc", "");
  regexTestPrefix("a*bc", "");
  regexTestPrefix("ab|ac", "");
  regexTestPrefix("(?i)abc", "");
  regexTestPrefix("\\bab", "");
}

@test
function skipsToTheLiteralPrefix(): void {
  regexTestFind("needle", "hay hay needle hay", "8..14");
  regexTestFind("needle", "hay hay needl", "none");
  regexTestFind("aab", "aaab", "1..4");
  regexTestFindAll("aab", "aaabaab", "1..4,4..7");
  regexTestFind("é+x", "aééx", "1..6");
  regexTestFind("foo(bar|baz)", "foobaq foobaz", "7..13");
  regexTestFindAll("ab", "abxab", "0..2,3..5");
  regexTestCaptures("a(b+)c", "xxabbc", "2..6,3..5");
}

@test
function searchesWithoutAPrefix(): void {
  regexTestFind("[ab]c", "xxbc", "2..4");
  regexTestFind("a*b", "cccb", "3..4");
  regexTestFind("x|yz", "ayz", "1..3");
  regexTestFind("(?i)abc", "xABC", "1..4");
  regexTestFindAll("", "ab", "0..0,1..1,2..2");
}

@test
function matchesLazyAndCaseInsensitiveForms(): void {
  regexTestFind("a{2,3}?", "aaaa", "0..2");
  regexTestFind("a{2,}?", "aaaa", "0..2");
  regexTestFind("a+?", "aaa", "0..1");
  regexTestFind("a??b", "ab", "0..2");
  regexTestFind("(?i)straße", "STRAßE", "0..7");
  regexTestFind("(?i)straße", "STRASSE", "none");
  regexTestFind("(?i)ß", "ẞ", "none");
  regexTestFind("(?i:a)b", "Ab", "0..2");
  regexTestFind("(?i:a)b", "AB", "none");
}
