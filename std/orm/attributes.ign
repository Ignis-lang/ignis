//!
//! # Attributes
//!
//! The declarable attributes that describe a record to the `Orm::Entity`
//! and `Orm::FromRow` defaults. A record written with them needs no
//! hand-written `table()`, `id()`, `bindValues` or `fromRow`.
//!
//! ## Exports
//!
//! | Export               | Description                                   |
//! |----------------------|-----------------------------------------------|
//! | `Orm::Table`         | `@Orm::Table("name")` on a record: its table name |
//! | `Orm::PrimaryKey`    | `@Orm::PrimaryKey` on a field: the key column |
//! | `Orm::AutoIncrement` | `@Orm::AutoIncrement` on the key: SQLite assigns it |
//! | `Orm::Column`        | `@Orm::Column("name")` on a field: a column name other than the field's |

/// The attributes the reflective `Entity` defaults read.
export namespace Orm {
  /// The table a record is stored in. A record that relies on the default
  /// `table()` and lacks it gets a descriptor without a name, which every
  /// emitter and `Repository::create` report as `SCHEMA`.
  @attribute(record)
  export record Table {
    /// The table name, a plain identifier.
    public name: str;
  }

  /// Marks the field that is the table's primary key.
  @attribute(field)
  export record PrimaryKey {}

  /// Marks the primary key `AUTOINCREMENT`: inserts leave it out and SQLite
  /// assigns it. Only an `INTEGER` key accepts it.
  @attribute(field)
  export record AutoIncrement {}

  /// The column a field is stored in, when it differs from the field name.
  @attribute(field)
  export record Column {
    /// The column name, a plain identifier.
    public name: str;
  }
}
