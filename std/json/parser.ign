//! A JSON value parser, `serde_json`-shaped on the errors it reports:
//! `Json::parse` exists so a consumer that has to match a `serde` host's
//! exact wording (`ignis/format`'s `--stdin-json` protocol is the one that
//! does) can build one on top of a real parse tree instead of a hand-rolled
//! scanner that only sees quotes.
//!
//! This is not a general-purpose JSON library: it has no writer (`Json`'s
//! `stringify`/`writeRoot` cover that) and no streaming API. It implements
//! the full JSON grammar (RFC 8259) for values, strings (including `\uXXXX`
//! surrogate pairs), and numbers, and reports the same messages `serde_json`
//! does for the malformed shapes this module's tests, and
//! `ignis/format/api_tests.ign`, pin against the host binary.
//!
//! `Format::parseStdinRequest` does not build a `JsonValue` tree through
//! `Json::parse` for its own top-level object scan: a `serde`-derived struct
//! deserializer inspects a field's value shallowly (peeking whether it is a
//! string without descending into it when it is not) and skips an unknown
//! field's value iteratively (no recursion, so no depth limit) rather than
//! building a tree first and type-checking after. Reproducing that ordering
//! needs the lower-level pieces this module exports (`readString`,
//! `scanNumber`, `skipValue`, `classifyContainerStart`) directly, which is
//! also why those are exported rather than kept private to `Json::parse`.

import JsonObjectEntry, JsonValue, JsonValueKind from "./value";
import Vector from "std::vector";

/// `serde_json`'s default recursion limit (`serde_json::de::Deserializer`'s
/// `RECURSION_LIMIT`), applied to `Json::parse`'s own tree-building descent.
const MAX_DEPTH: u64 = 128;

function isJsonWhitespace(byte: u8): boolean {
  return byte == ' ' as u8 || byte == '\t' as u8 || byte == '\n' as u8 || byte == '\r' as u8;
}

export namespace Json {
  function skipWhitespace(source: &String, index: u64): u64 {
    let mut cursor: u64 = index;

    while (cursor < source.length()) {
      let Option::SOME(byte) = source.byteAt(cursor) else {
        break;
      };

      if (!isJsonWhitespace(byte)) {
        break;
      }

      cursor += 1;
    }

    return cursor;
  }

  /// Parses exactly one JSON value starting at the first non-whitespace byte
  /// of `source`, building a full tree bounded by `MAX_DEPTH` (128, matching
  /// `serde_json`'s default recursion limit). Leading and trailing
  /// whitespace around that value is allowed; trailing *non-whitespace*
  /// content is not this function's problem to reject, because `serde_json`
  /// only checks for it once a caller's target type has already accepted
  /// the value.
  ///
  /// `Format::parseStdinRequest` does not call this for its own top-level
  /// scan; see this module's doc comment for why.
  function parse(source: &String): Result<JsonValue, String> {
    return parseJsonValue(source, 0, 0);
  }
}

/// The `EOF while parsing <kind> at line 1 column N` message `serde_json`
/// reports whenever a value runs off the end of the source before it closes.
/// `N` is always the source's full byte length: there is nothing left to
/// read, so that is where `serde_json`'s reader sits.
export function jsonEofMessage(source: &String, kind: str): String {
  let sourceLength: u64 = source.length();
  let column: String = sourceLength.toString();

  let mut message: String = String::create("EOF while parsing ");
  message.pushStr(kind);
  message.pushStr(" at line 1 column ");
  message.push(&column);
  return message;
}

/// `serde_json` reports most tokenizer-level violations at the 1-based
/// position of the exact byte that broke the grammar, whether that byte was
/// just consumed (e.g. the second digit of a leading-zero number) or only
/// peeked (e.g. finding `}` where a digit was expected after `-`).
function columnAtByte(index: u64): String {
  let column: u64 = index + 1;
  return column.toString();
}

/// A value's own token was fully consumed (a scalar, a key string, a whole
/// array/object): `serde_json` reports the position right after it, which is
/// exactly the 0-based exclusive end offset used as a 1-based column.
function columnAfterToken(endOffset: u64): String {
  return endOffset.toString();
}

export function jsonExpectedValueMessage(index: u64): String {
  let mut message: String = String::create("expected value at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}
function jsonInvalidNumberMessage(index: u64): String {
  let mut message: String = String::create("invalid number at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}

function jsonInvalidEscapeMessage(index: u64): String {
  let mut message: String = String::create("invalid escape at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}

/// `serde_json` reports the same fixed range text for every raw control byte
/// (0x00-0x1F) found unescaped inside a JSON string, regardless of which one.
function jsonControlCharacterMessage(index: u64): String {
  let mut message: String = String::create("control character (\\u0000-\\u001F) found while parsing a string at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}

/// The same message as `jsonControlCharacterMessage`, but at the byte's raw
/// 0-based index rather than `index + 1`: `serde`'s `IgnoredAny` string skip
/// (used for an unknown field's value) reports this convention instead,
/// verified against the host.
function jsonControlCharacterAtRawIndexMessage(index: u64): String {
  let mut message: String = String::create("control character (\\u0000-\\u001F) found while parsing a string at line 1 column ");
  let column: String = index.toString();
  message.push(&column);
  return message;
}

function jsonUnexpectedEndOfHexEscapeMessage(index: u64): String {
  let mut message: String = String::create("unexpected end of hex escape at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}

/// Reported both for a high surrogate whose `\u` pair is not a valid low
/// surrogate, and for a low surrogate encountered on its own: `serde_json`
/// uses the same wording either way. `endOffset` is the position right after
/// the escape that revealed it (the only escape, for a lone low surrogate;
/// the second one, for an unpaired high surrogate).
function jsonLoneSurrogateMessage(endOffset: u64): String {
  let mut message: String = String::create("lone leading surrogate in hex escape at line 1 column ");
  let column: String = columnAfterToken(endOffset);
  message.push(&column);
  return message;
}

export function jsonTrailingCommaMessage(index: u64): String {
  let mut message: String = String::create("trailing comma at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}
export function jsonExpectedCommaOrBraceMessage(index: u64): String {
  let mut message: String = String::create("expected `,` or `}` at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}
function jsonExpectedCommaOrBracketMessage(index: u64): String {
  let mut message: String = String::create("expected `,` or `]` at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}

export function jsonExpectedColonMessage(index: u64): String {
  let mut message: String = String::create("expected `:` at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}

/// `serde_json` reports this once it has committed to one of `true`/`false`/
/// `null` (by matching its first byte) and then finds a present byte that
/// does not continue that keyword, distinct from the generic `expected
/// value` used when the first byte does not start any known value at all.
function jsonExpectedIdentMessage(index: u64): String {
  let mut message: String = String::create("expected ident at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}

export function jsonRecursionLimitMessage(index: u64): String {
  let mut message: String = String::create("recursion limit exceeded at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}

/// `serde_json` uses this instead of the generic `expected value` when an
/// object key position holds a byte that is not a `"`.
export function jsonKeyMustBeStringMessage(index: u64): String {
  let mut message: String = String::create("key must be a string at line 1 column ");
  let column: String = columnAtByte(index);
  message.push(&column);
  return message;
}
export record JsonStringRead {
  public value: String;
  public nextIndex: u64;
}

function hexDigitValue(byte: u8): Option<u32> {
  if (byte >= '0' as u8 && byte <= '9' as u8) {
    return Option::SOME((byte - ('0' as u8)) as u32);
  }

  if (byte >= 'a' as u8 && byte <= 'f' as u8) {
    return Option::SOME((byte - ('a' as u8)) as u32 + 10);
  }

  if (byte >= 'A' as u8 && byte <= 'F' as u8) {
    return Option::SOME((byte - ('A' as u8)) as u32 + 10);
  }

  return Option::NONE;
}

record HexEscapeRead {
  public value: u32;
  public nextIndex: u64;
}

/// Decodes the four hex digits of a `\uXXXX` escape, `source[startIndex]`
/// being the first hex digit (the caller has already consumed `\u`).
///
/// `serde_json` reads all 4 byte positions before reporting an invalid
/// digit (so an invalid first digit still needs the 4th byte to be present),
/// but reports a missing byte position (running off the end of the source)
/// immediately as EOF rather than continuing to check the rest. `ERROR(true)`
/// distinguishes that EOF case from `ERROR(false)` (4 bytes were present,
/// at least one was not a hex digit).
function readHexEscape(source: &String, startIndex: u64): Result<HexEscapeRead, boolean> {
  let mut value: u32 = 0;
  let mut index: u64 = 0;
  let mut sawInvalidDigit: boolean = false;

  while (index < 4) {
    let Option::SOME(byte) = source.byteAt(startIndex + index) else {
      return Result::ERROR(true);
    };

    let Option::SOME(digit) = hexDigitValue(byte) else {
      sawInvalidDigit = true;
      index += 1;
      continue;
    };

    value = value * 16 + digit;
    index += 1;
  }

  if (sawInvalidDigit) {
    return Result::ERROR(false);
  }

  return Result::OK(HexEscapeRead { value: value, nextIndex: startIndex + index });
}

function isHighSurrogate(value: u32): boolean {
  return value >= 0xD800 && value <= 0xDBFF;
}

function isLowSurrogate(value: u32): boolean {
  return value >= 0xDC00 && value <= 0xDFFF;
}

/// Decodes the JSON string starting at the `"` on `startIndex`, matching
/// `serde_json`'s exact escape and surrogate-pair handling.
/// The byte one of the short (non-`\u`) JSON string escapes (`\n`, `\t`,
/// `\r`, `\b`, `\f`, `\"`, `\\`, `\/`) decodes to, or `Option::NONE` if
/// `escaped` is not one of them.
function shortEscapeByte(escaped: u8): Option<u8> {
  if (escaped == 'n' as u8) {
    return Option::SOME('\n' as u8);
  }

  if (escaped == 't' as u8) {
    return Option::SOME('\t' as u8);
  }

  if (escaped == 'r' as u8) {
    return Option::SOME('\r' as u8);
  }

  if (escaped == 'b' as u8) {
    return Option::SOME(8);
  }

  if (escaped == 'f' as u8) {
    return Option::SOME(12);
  }

  if (escaped == '"' as u8) {
    return Option::SOME('"' as u8);
  }

  if (escaped == '\\' as u8) {
    return Option::SOME('\\' as u8);
  }

  if (escaped == '/' as u8) {
    return Option::SOME('/' as u8);
  }

  return Option::NONE;
}

export record UnicodeEscapeRead {
  public character: char;
  public nextIndex: u64;
}

/// Decodes one `\u` escape, `cursor` being the index of its backslash
/// (`source[cursor + 1]` is `u`): combines a high/low surrogate pair into
/// one scalar when present, matching `serde_json`'s exact surrogate
/// handling and error wording (see `readString`'s doc comment for the
/// specific EOF/mismatch cases this covers).
function readUnicodeEscape(source: &String, cursor: u64): Result<UnicodeEscapeRead, String> {
  let firstEscape: HexEscapeRead = match (readHexEscape(source, cursor + 2)) {
    Result::OK(value) -> value,
    Result::ERROR(isEof) -> {
      if (isEof) {
        return Result::ERROR(jsonEofMessage(source, "a string"));
      }

      return Result::ERROR(jsonInvalidEscapeMessage(cursor + 2 + 3));
    },
  };

  if (isHighSurrogate(firstEscape.value)) {
    let Option::SOME(nextByte) = source.byteAt(firstEscape.nextIndex) else {
      return Result::ERROR(jsonEofMessage(source, "a string"));
    };

    if (nextByte != '\\' as u8) {
      return Result::ERROR(jsonUnexpectedEndOfHexEscapeMessage(firstEscape.nextIndex));
    }

    let Option::SOME(afterBackslash) = source.byteAt(firstEscape.nextIndex + 1) else {
      return Result::ERROR(jsonEofMessage(source, "a string"));
    };

    if (afterBackslash != 'u' as u8) {
      return Result::ERROR(jsonUnexpectedEndOfHexEscapeMessage(firstEscape.nextIndex + 1));
    }

    let secondEscape: HexEscapeRead = match (readHexEscape(source, firstEscape.nextIndex + 2)) {
      Result::OK(value) -> value,
      Result::ERROR(isEof) -> {
        if (isEof) {
          return Result::ERROR(jsonEofMessage(source, "a string"));
        }

        return Result::ERROR(jsonInvalidEscapeMessage(firstEscape.nextIndex + 2 + 3));
      },
    };

    if (!isLowSurrogate(secondEscape.value)) {
      return Result::ERROR(jsonLoneSurrogateMessage(secondEscape.nextIndex));
    }

    let combined: u32 = 0x10000 + (firstEscape.value - 0xD800) * 0x400 + (secondEscape.value - 0xDC00);
    return Result::OK(UnicodeEscapeRead { character: combined as char, nextIndex: secondEscape.nextIndex });
  }

  if (isLowSurrogate(firstEscape.value)) {
    return Result::ERROR(jsonLoneSurrogateMessage(firstEscape.nextIndex));
  }

  return Result::OK(UnicodeEscapeRead { character: firstEscape.value as char, nextIndex: firstEscape.nextIndex });
}

/// Decodes the JSON string starting at the `"` on `startIndex`, matching
/// `serde_json`'s exact escape and surrogate-pair handling: short escapes
/// via `shortEscapeByte`, `\u` (including surrogate pairs) via
/// `readUnicodeEscape`.
export function readString(source: &String, startIndex: u64): Result<JsonStringRead, String> {
  let mut value: String = String::new();
  let mut cursor: u64 = startIndex + 1;

  while (true) {
    let Option::SOME(byte) = source.byteAt(cursor) else {
      return Result::ERROR(jsonEofMessage(source, "a string"));
    };

    if (byte == '"' as u8) {
      return Result::OK(JsonStringRead { value: value, nextIndex: cursor + 1 });
    }

    if (byte < 32) {
      return Result::ERROR(jsonControlCharacterMessage(cursor));
    }

    if (byte != '\\' as u8) {
      value.pushByte(byte);
      cursor += 1;
      continue;
    }

    let Option::SOME(escaped) = source.byteAt(cursor + 1) else {
      return Result::ERROR(jsonEofMessage(source, "a string"));
    };

    if (let Option::SOME(decoded) = shortEscapeByte(escaped)) {
      value.pushByte(decoded);
      cursor += 2;
      continue;
    }

    if (escaped != 'u' as u8) {
      return Result::ERROR(jsonInvalidEscapeMessage(cursor + 1));
    }

    let unicodeEscape: UnicodeEscapeRead = readUnicodeEscape(source, cursor)!;
    value.pushChar(unicodeEscape.character);
    cursor = unicodeEscape.nextIndex;
  }

  return Result::ERROR(jsonEofMessage(source, "a string"));
}
export record JsonNumberRead {
  public text: String;
  public endOffset: u64;
}

function isAsciiDigit(byte: u8): boolean {
  return byte >= '0' as u8 && byte <= '9' as u8;
}

/// Scans one JSON number, enforcing RFC 8259's grammar exactly:
/// `-`? int frac? exp?, `int` is `0` or a non-zero digit followed by digits,
/// `frac` is `.` followed by at least one digit, `exp` is `e`/`E` with an
/// optional sign followed by at least one digit.
///
/// `serde_json` has not committed to "this is a number" until it sees a
/// digit: running off the end of the source while still expecting a
/// mandatory digit (right after a sign, a `.`, or an exponent marker) is
/// `EOF while parsing a value`, not `invalid number`. Only a *present* byte
/// that fails the grammar is `invalid number`.
export function scanNumber(source: &String, startIndex: u64): Result<JsonNumberRead, String> {
  let mut cursor: u64 = startIndex;

  let Option::SOME(first) = source.byteAt(cursor) else {
    return Result::ERROR(jsonEofMessage(source, "a value"));
  };

  if (first == '-' as u8) {
    cursor += 1;
  }

  let Option::SOME(leadingDigit) = source.byteAt(cursor) else {
    return Result::ERROR(jsonEofMessage(source, "a value"));
  };

  if (!isAsciiDigit(leadingDigit)) {
    return Result::ERROR(jsonInvalidNumberMessage(cursor));
  }

  if (leadingDigit == '0' as u8) {
    cursor += 1;

    if (let Option::SOME(next) = source.byteAt(cursor) && isAsciiDigit(next)) {
      return Result::ERROR(jsonInvalidNumberMessage(cursor));
    }
  } else {
    while (let Option::SOME(next) = source.byteAt(cursor) && isAsciiDigit(next)) {
      cursor += 1;
    }
  }

  if (let Option::SOME(dot) = source.byteAt(cursor) && dot == '.' as u8) {
    cursor += 1;

    let Option::SOME(fractionDigit) = source.byteAt(cursor) else {
      return Result::ERROR(jsonEofMessage(source, "a value"));
    };

    if (!isAsciiDigit(fractionDigit)) {
      return Result::ERROR(jsonInvalidNumberMessage(cursor));
    }

    while (let Option::SOME(next) = source.byteAt(cursor) && isAsciiDigit(next)) {
      cursor += 1;
    }
  }

  if (let Option::SOME(exponent) = source.byteAt(cursor) && (exponent == 'e' as u8 || exponent == 'E' as u8)) {
    cursor += 1;

    if (let Option::SOME(sign) = source.byteAt(cursor) && (sign == '+' as u8 || sign == '-' as u8)) {
      cursor += 1;
    }

    let Option::SOME(exponentDigit) = source.byteAt(cursor) else {
      return Result::ERROR(jsonEofMessage(source, "a value"));
    };

    if (!isAsciiDigit(exponentDigit)) {
      return Result::ERROR(jsonInvalidNumberMessage(cursor));
    }

    while (let Option::SOME(next) = source.byteAt(cursor) && isAsciiDigit(next)) {
      cursor += 1;
    }
  }

  let text: String = source.substringBytes(startIndex, cursor);
  return Result::OK(JsonNumberRead { text: text, endOffset: cursor });
}

/// Matches `literal` (one of `true`/`false`/`null`) starting at `startIndex`,
/// where the caller has already confirmed the byte at `startIndex` is that
/// keyword's first byte. `serde_json`, having committed to that keyword,
/// distinguishes running off the end of the source mid-match (`EOF while
/// parsing a value`) from a present byte that breaks the match (`expected
/// ident`) rather than falling back to the generic `expected value` either
/// caller uses when the first byte does not start any known value at all.
export function matchKeywordOrIdentError(
  source: &String,
  startIndex: u64,
  literal: str
): Result<u64, String> {
  let literalText: String = String::create(literal);
  let literalLength: u64 = literalText.length();
  let mut index: u64 = 1;

  while (index < literalLength) {
    let Option::SOME(expectedByte) = literalText.byteAt(index) else {
      break;
    };

    let Option::SOME(actualByte) = source.byteAt(startIndex + index) else {
      return Result::ERROR(jsonEofMessage(source, "a value"));
    };

    if (actualByte != expectedByte) {
      return Result::ERROR(jsonExpectedIdentMessage(startIndex + index));
    }

    index += 1;
  }

  return Result::OK(startIndex + literalLength);
}

/// The kind name `serde_json` uses in `invalid type: <kind>, ...` for a
/// value it detected only by peeking its opening bracket (`{` or `[`),
/// without descending into it.
export enum JsonContainerKind {
  OBJECT,
  ARRAY,
}

/// Classifies the byte at `index` (after skipping whitespace) as the start
/// of a container, without consuming anything: used by a caller that must
/// not build the container's tree before deciding a field's value is the
/// wrong shape (see this module's doc comment on why `parseStdinRequest`
/// needs this instead of `Json::parse`).
export function classifyContainerStart(source: &String, index: u64): Option<JsonContainerKind> {
  let Option::SOME(byte) = source.byteAt(index) else {
    return Option::NONE;
  };

  if (byte == '{' as u8) {
    return Option::SOME(JsonContainerKind::OBJECT);
  }

  if (byte == '[' as u8) {
    return Option::SOME(JsonContainerKind::ARRAY);
  }

  return Option::NONE;
}

/// Advances past a JSON string without decoding it, matching `serde_json`'s
/// `IgnoredAny` string skip rather than a real `String` deserialize: escape
/// characters are validated against the known set and a `\u` escape needs 4
/// present hex digits, but a surrogate pair is never combined or checked for
/// validity (an unpaired or out-of-order surrogate here is not an error, the
/// same way the host accepts it in a field it never reads).
function skipStringValue(source: &String, startIndex: u64): Result<u64, String> {
  let mut cursor: u64 = startIndex + 1;

  while (true) {
    let Option::SOME(byte) = source.byteAt(cursor) else {
      return Result::ERROR(jsonEofMessage(source, "a string"));
    };

    if (byte == '"' as u8) {
      return Result::OK(cursor + 1);
    }

    if (byte < 32) {
      return Result::ERROR(jsonControlCharacterAtRawIndexMessage(cursor));
    }

    if (byte != '\\' as u8) {
      cursor += 1;
      continue;
    }

    let Option::SOME(escaped) = source.byteAt(cursor + 1) else {
      return Result::ERROR(jsonEofMessage(source, "a string"));
    };

    let isKnownShortEscape: boolean = escaped == 'n' as u8 || escaped == 't' as u8 || escaped == 'r' as u8 || escaped == 'b' as u8 || escaped == 'f' as u8 || escaped == '"' as u8 || escaped == '\\' as u8 || escaped == '/' as u8;

    if (isKnownShortEscape) {
      cursor += 2;
      continue;
    }

    if (escaped != 'u' as u8) {
      return Result::ERROR(jsonInvalidEscapeMessage(cursor + 1));
    }

    cursor = match (readHexEscape(source, cursor + 2)) {
      Result::OK(escapeRead) -> escapeRead.nextIndex,
      Result::ERROR(isEof) -> {
        if (isEof) {
          return Result::ERROR(jsonEofMessage(source, "a string"));
        }

        return Result::ERROR(jsonInvalidEscapeMessage(cursor + 2 + 3));
      },
    };
  }

  @unreachable();
}

/// Skips one JSON scalar (string, `true`/`false`/`null`, or number) at
/// `index`, which must not be `{` or `[`.
function skipScalarValue(source: &String, index: u64): Result<u64, String> {
  let Option::SOME(byte) = source.byteAt(index) else {
    return Result::ERROR(jsonEofMessage(source, "a value"));
  };

  if (byte == '"' as u8) {
    return skipStringValue(source, index);
  }

  if (byte == 't' as u8) {
    return matchKeywordOrIdentError(source, index, "true");
  }

  if (byte == 'f' as u8) {
    return matchKeywordOrIdentError(source, index, "false");
  }

  if (byte == 'n' as u8) {
    return matchKeywordOrIdentError(source, index, "null");
  }

  let isNumberStart: boolean = byte == '-' as u8 || isAsciiDigit(byte);

  if (isNumberStart) {
    let numberRead: JsonNumberRead = scanNumber(source, index)!;
    return Result::OK(numberRead.endOffset);
  }

  return Result::ERROR(jsonExpectedValueMessage(index));
}

/// Advances past exactly one JSON value at `startIndex`, matching
/// `serde_json`'s `IgnoredAny` grammar exactly (unknown keys/commas/colons
/// are validated, not just bracket-counted) without recursing into nested
/// containers: an explicit `Vector<boolean>` stack of ancestor container
/// kinds (`true` for an object) tracks nesting instead of the call stack, so
/// this has no depth limit, the same way `IgnoredAny` does not.
/// `skipValue`'s working state for one open container, plus the stack of
/// ancestor containers' own `currentIsObject` flags (`true` for an object)
/// it restores from when the current one closes.
record SkipValueState {
  public cursor: u64;
  public currentIsObject: boolean;
  public needEntry: boolean;
  public ancestors: Vector<boolean>;
}

/// One step of `skipValue`'s state machine while the current container is
/// expecting its next entry (an object key or an array element). Returns
/// `Option::SOME(finalCursor)` once the whole outermost value is fully
/// skipped (this container's close popped the last ancestor), or
/// `Option::NONE` to keep looping (having mutated `state` for the next
/// iteration).
function skipValueHandleEntry(
  source: &String,
  state: &mut SkipValueState
): Result<Option<u64>, String> {
  let mut stateRef: &mut SkipValueState = state;
  let containerKind: str = stateRef.currentIsObject ? "an object" : "a list";
  let closeByte: u8 = stateRef.currentIsObject ? '}' as u8 : ']' as u8;

  let Option::SOME(peekByte) = source.byteAt(stateRef.cursor) else {
    return Result::ERROR(jsonEofMessage(source, containerKind));
  };

  if (peekByte == closeByte) {
    stateRef.cursor += 1;

    let Option::SOME(parentIsObject) = stateRef.ancestors.pop() else {
      return Result::OK(Option::SOME(stateRef.cursor));
    };

    stateRef.currentIsObject = parentIsObject;
    stateRef.needEntry = false;
    return Result::OK(Option::NONE);
  }

  if (stateRef.currentIsObject) {
    if (peekByte != '"' as u8) {
      return Result::ERROR(jsonKeyMustBeStringMessage(stateRef.cursor));
    }

    let keyEndOffset: u64 = skipStringValue(source, stateRef.cursor)!;
    stateRef.cursor = Json::skipWhitespace(source, keyEndOffset);

    let Option::SOME(colon) = source.byteAt(stateRef.cursor) else {
      return Result::ERROR(jsonEofMessage(source, "an object"));
    };

    if (colon != ':' as u8) {
      return Result::ERROR(jsonExpectedColonMessage(stateRef.cursor));
    }

    stateRef.cursor = Json::skipWhitespace(source, stateRef.cursor + 1);
  }

  let Option::SOME(valueByte) = source.byteAt(stateRef.cursor) else {
    return Result::ERROR(jsonEofMessage(source, "a value"));
  };

  if (valueByte == '{' as u8 || valueByte == '[' as u8) {
    stateRef.ancestors.push(stateRef.currentIsObject);
    stateRef.currentIsObject = valueByte == '{' as u8;
    stateRef.cursor += 1;
    stateRef.needEntry = true;
    return Result::OK(Option::NONE);
  }

  stateRef.cursor = skipScalarValue(source, stateRef.cursor)!;
  stateRef.needEntry = false;
  return Result::OK(Option::NONE);
}

/// The other half of `skipValue`'s state machine: the current container
/// just finished one entry and is expecting `,` or its own close byte.
/// Same return convention as `skipValueHandleEntry`.
function skipValueHandleAfterEntry(
  source: &String,
  state: &mut SkipValueState
): Result<Option<u64>, String> {
  let mut stateRef: &mut SkipValueState = state;
  let containerKind: str = stateRef.currentIsObject ? "an object" : "a list";
  let closeByte: u8 = stateRef.currentIsObject ? '}' as u8 : ']' as u8;

  let Option::SOME(afterValue) = source.byteAt(stateRef.cursor) else {
    return Result::ERROR(jsonEofMessage(source, containerKind));
  };

  if (afterValue == closeByte) {
    stateRef.cursor += 1;

    let Option::SOME(parentIsObject) = stateRef.ancestors.pop() else {
      return Result::OK(Option::SOME(stateRef.cursor));
    };

    stateRef.currentIsObject = parentIsObject;
    stateRef.needEntry = false;
    return Result::OK(Option::NONE);
  }

  if (afterValue != ',' as u8) {
    if (stateRef.currentIsObject) {
      return Result::ERROR(jsonExpectedCommaOrBraceMessage(stateRef.cursor));
    }

    return Result::ERROR(jsonExpectedCommaOrBracketMessage(stateRef.cursor));
  }

  stateRef.cursor = Json::skipWhitespace(source, stateRef.cursor + 1);

  // Past the comma, an array reads its next element through the same
  // generic value dispatch used everywhere, so EOF here is `EOF while
  // parsing a value`; an object still reports `an object` at this
  // checkpoint (unlike the struct-mapped object scanners in this file and
  // `api.ign`, which both use `a value` here instead — `IgnoredAny`'s
  // internal map/seq access apparently do not share one convention).
  let Option::SOME(afterComma) = source.byteAt(stateRef.cursor) else {
    if (stateRef.currentIsObject) {
      return Result::ERROR(jsonEofMessage(source, "an object"));
    }

    return Result::ERROR(jsonEofMessage(source, "a value"));
  };

  if (afterComma == closeByte) {
    return Result::ERROR(jsonTrailingCommaMessage(stateRef.cursor));
  }

  stateRef.needEntry = true;
  return Result::OK(Option::NONE);
}

export function skipValue(source: &String, startIndex: u64): Result<u64, String> {
  let index: u64 = Json::skipWhitespace(source, startIndex);

  let Option::SOME(byte) = source.byteAt(index) else {
    return Result::ERROR(jsonEofMessage(source, "a value"));
  };

  if (byte != '{' as u8 && byte != '[' as u8) {
    return skipScalarValue(source, index);
  }

  let mut state: SkipValueState = SkipValueState {
    cursor: index + 1,
    currentIsObject: byte == '{' as u8,
    needEntry: true,
    ancestors: Vector::new<boolean>(),
  };

  while (true) {
    state.cursor = Json::skipWhitespace(source, state.cursor);

    if (state.needEntry) {
      let Option::SOME(finalCursor) = skipValueHandleEntry(source, &mut state)! else {
        continue;
      };

      return Result::OK(finalCursor);
    }

    let Option::SOME(finalCursor) = skipValueHandleAfterEntry(source, &mut state)! else {
      continue;
    };

    return Result::OK(finalCursor);
  }

  @unreachable();
}
function parseJsonValue(source: &String, startIndex: u64, depth: u64): Result<JsonValue, String> {
  let index: u64 = Json::skipWhitespace(source, startIndex);

  let Option::SOME(byte) = source.byteAt(index) else {
    return Result::ERROR(jsonEofMessage(source, "a value"));
  };

  if (byte == '"' as u8) {
    let read: JsonStringRead = readString(source, index)!;

    // `.clone()`, not a move: moving `value` out of the bound local `read`
    // while `read` itself still drops normally at scope exit double-frees
    // the string's backing storage on this compiler (repro
    // "field-move-double-free").
    return Result::OK(JsonValue { kind: JsonValueKind::STRING(read.value.clone()), endOffset: read.nextIndex });
  }

  if (byte == '{' as u8) {
    // `depth` counts how many containers already enclose this one (0 at the
    // top level), so the container about to open here is the `depth + 1`th:
    // the 128th container (`depth == 127`) is the one that exceeds
    // `serde_json`'s limit, not the 129th.
    if (depth + 1 >= MAX_DEPTH) {
      return Result::ERROR(jsonRecursionLimitMessage(index));
    }

    return parseJsonObject(source, index, depth);
  }

  if (byte == '[' as u8) {
    // `depth` counts how many containers already enclose this one (0 at the
    // top level), so the container about to open here is the `depth + 1`th:
    // the 128th container (`depth == 127`) is the one that exceeds
    // `serde_json`'s limit, not the 129th.
    if (depth + 1 >= MAX_DEPTH) {
      return Result::ERROR(jsonRecursionLimitMessage(index));
    }

    return parseJsonArray(source, index, depth);
  }

  if (byte == 't' as u8) {
    let endOffset: u64 = matchKeywordOrIdentError(source, index, "true")!;
    return Result::OK(JsonValue { kind: JsonValueKind::BOOL(true), endOffset: endOffset });
  }

  if (byte == 'f' as u8) {
    let endOffset: u64 = matchKeywordOrIdentError(source, index, "false")!;
    return Result::OK(JsonValue { kind: JsonValueKind::BOOL(false), endOffset: endOffset });
  }

  if (byte == 'n' as u8) {
    let endOffset: u64 = matchKeywordOrIdentError(source, index, "null")!;
    return Result::OK(JsonValue { kind: JsonValueKind::NULL, endOffset: endOffset });
  }

  let isNumberStart: boolean = byte == '-' as u8 || isAsciiDigit(byte);

  if (isNumberStart) {
    let numberRead: JsonNumberRead = scanNumber(source, index)!;
    return Result::OK(JsonValue { kind: JsonValueKind::NUMBER(numberRead.text), endOffset: numberRead.endOffset });
  }

  return Result::ERROR(jsonExpectedValueMessage(index));
}

function parseJsonObject(
  source: &String,
  openBraceIndex: u64,
  depth: u64
): Result<JsonValue, String> {
  let mut entries: Vector<JsonObjectEntry> = Vector::new<JsonObjectEntry>();
  let mut cursor: u64 = Json::skipWhitespace(source, openBraceIndex + 1);

  let Option::SOME(firstByte) = source.byteAt(cursor) else {
    return Result::ERROR(jsonEofMessage(source, "an object"));
  };

  if (firstByte == '}' as u8) {
    return Result::OK(JsonValue { kind: JsonValueKind::OBJECT(entries), endOffset: cursor + 1 });
  }

  while (true) {
    cursor = Json::skipWhitespace(source, cursor);

    let Option::SOME(keyByte) = source.byteAt(cursor) else {
      return Result::ERROR(jsonEofMessage(source, "an object"));
    };

    if (keyByte != '"' as u8) {
      return Result::ERROR(jsonKeyMustBeStringMessage(cursor));
    }

    let key: JsonStringRead = readString(source, cursor)!;

    // `.clone()` for the same reason as the `STRING` case above: `key` is a
    // bound local that still drops at scope exit (repro
    // "field-move-double-free").
    let keyText: String = key.value.clone();
    cursor = Json::skipWhitespace(source, key.nextIndex);

    let Option::SOME(colon) = source.byteAt(cursor) else {
      return Result::ERROR(jsonEofMessage(source, "an object"));
    };

    if (colon != ':' as u8) {
      return Result::ERROR(jsonExpectedColonMessage(cursor));
    }

    cursor = Json::skipWhitespace(source, cursor + 1);

    let parsedValue: JsonValue = parseJsonValue(source, cursor, depth + 1)!;
    let parsedValueEnd: u64 = parsedValue.endOffset;
    entries.push(JsonObjectEntry { key: keyText, value: parsedValue });
    cursor = Json::skipWhitespace(source, parsedValueEnd);

    let Option::SOME(next) = source.byteAt(cursor) else {
      return Result::ERROR(jsonEofMessage(source, "an object"));
    };

    if (next == ',' as u8) {
      cursor = Json::skipWhitespace(source, cursor + 1);

      // Past the comma, the next key is read through the same generic value
      // dispatch a colon's value uses, so EOF here is `EOF while parsing a
      // value`, not `an object`, unlike every other EOF check in this loop.
      let Option::SOME(afterComma) = source.byteAt(cursor) else {
        return Result::ERROR(jsonEofMessage(source, "a value"));
      };

      if (afterComma == '}' as u8) {
        return Result::ERROR(jsonTrailingCommaMessage(cursor));
      }

      continue;
    }

    if (next == '}' as u8) {
      return Result::OK(JsonValue { kind: JsonValueKind::OBJECT(entries), endOffset: cursor + 1 });
    }

    return Result::ERROR(jsonExpectedCommaOrBraceMessage(cursor));
  }

  return Result::ERROR(jsonEofMessage(source, "an object"));
}

function parseJsonArray(
  source: &String,
  openBracketIndex: u64,
  depth: u64
): Result<JsonValue, String> {
  let mut items: Vector<JsonValue> = Vector::new<JsonValue>();
  let mut cursor: u64 = Json::skipWhitespace(source, openBracketIndex + 1);

  let Option::SOME(firstByte) = source.byteAt(cursor) else {
    return Result::ERROR(jsonEofMessage(source, "a list"));
  };

  if (firstByte == ']' as u8) {
    return Result::OK(JsonValue { kind: JsonValueKind::ARRAY(items), endOffset: cursor + 1 });
  }

  while (true) {
    cursor = Json::skipWhitespace(source, cursor);

    let parsedValue: JsonValue = parseJsonValue(source, cursor, depth + 1)!;
    let parsedValueEnd: u64 = parsedValue.endOffset;
    items.push(parsedValue);
    cursor = Json::skipWhitespace(source, parsedValueEnd);

    let Option::SOME(next) = source.byteAt(cursor) else {
      return Result::ERROR(jsonEofMessage(source, "a list"));
    };

    if (next == ',' as u8) {
      cursor = Json::skipWhitespace(source, cursor + 1);

      // Past the comma, the next element is read through the same generic
      // value dispatch every array element uses, so EOF here is `EOF while
      // parsing a value`, not `a list` (matches `skipValue`'s array case).
      let Option::SOME(afterComma) = source.byteAt(cursor) else {
        return Result::ERROR(jsonEofMessage(source, "a value"));
      };

      if (afterComma == ']' as u8) {
        return Result::ERROR(jsonTrailingCommaMessage(cursor));
      }

      continue;
    }

    if (next == ']' as u8) {
      return Result::OK(JsonValue { kind: JsonValueKind::ARRAY(items), endOffset: cursor + 1 });
    }

    return Result::ERROR(jsonExpectedCommaOrBracketMessage(cursor));
  }

  return Result::ERROR(jsonEofMessage(source, "a list"));
}
