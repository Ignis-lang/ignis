//!
//! # Arena Allocator
//!
//! Growable block-based arena allocator written in Ignis.
//!
//! ## Overview
//!
//! `ArenaAllocator` is designed for workloads where many allocations share the
//! same lifetime. Instead of tracking every allocation separately, the arena
//! allocates from larger backing blocks and invalidates everything together on
//! `reset()` or `destroy()`.
//!
//! This makes it a good fit for:
//!
//! - parser and compiler temporary objects
//! - short-lived request or frame allocations
//! - scratch buffers built and discarded in batches
//! - phase-local data where all values die together
//!
//! ## Core Behavior
//!
//! The arena has three important properties:
//!
//! 1. **Fast allocation**
//!    - allocate from the current backing block
//!    - if the block has no room, switch to or append another block
//!
//! 2. **No individual deallocation**
//!    - there is no per-allocation `free`
//!    - memory stays owned by the arena until reset or destroy
//!
//! 3. **Bulk lifetime management**
//!    - `reset()` keeps the arena but rewinds allocation state
//!    - `destroy()` releases all arena-owned backing blocks
//!
//! ## Mental Model
//!
//! ```text
//!   ArenaAllocator
//!   ┌─────────────────────────────────────────────────────────────────┐
//!   │ head    -> first block                                          │
//!   │ current -> block the next allocation is tried against first     │
//!   │ blockSize -> preferred block size for future growth             │
//!   └─────────────────────────────────────────────────────────────────┘
//!
//!   Arena-owned backing blocks
//!   ┌────────────────────────┐  ┌────────────────────────┐
//!   │ [used][used][free...]  │─▶│ [used][free.........] │
//!   └────────────────────────┘  └────────────────────────┘
//! ```
//!
//! Block metadata lives in `ArenaBlock` records the arena allocates through the
//! process allocator, so a returned pointer keeps pointing at stable storage
//! until the arena is reset or destroyed.
//!
//! ## Allocation Semantics
//!
//! - `allocate(layout)` returns a properly aligned pointer for `layout`
//! - `allocate<T>()` allocates space for exactly one `T`
//! - `allocate<T>(count)` allocates space for `count` contiguous `T` values
//! - zero-sized requests return `null`
//! - once the arena has been destroyed, allocation returns `null`
//!
//! ## Reset vs Destroy
//!
//! ```text
//!   reset()
//!     - keeps backing blocks
//!     - invalidates all previously returned pointers
//!     - makes arena space reusable
//!
//!   destroy()
//!     - releases all backing blocks
//!     - marks the arena dead
//!     - allocator becomes unusable until reinitialized
//! ```
//!
//! ## Safety Notes
//!
//! `ArenaAllocator` deliberately trades precision for speed.
//!
//! Callers must treat all pointers returned from the arena as invalid after:
//!
//! - `reset()`
//! - `destroy()`
//! - `drop()`
//!
//! Values allocated in the arena are not individually dropped by the allocator.
//! If a stored type owns resources, the caller is responsible for ensuring the
//! lifetime strategy is valid for arena allocation.
//!
//! ## Example
//!
//! ```ignis
//! import ArenaAllocator from "std::memory";
//! import Layout from "std::memory";
//!
//! function main(): i32 {
//!   let mut arena: ArenaAllocator = ArenaAllocator::new(4096);
//!
//!   let numbers: *mut i32 = arena.allocate<i32>(16);
//!   if (numbers == null) {
//!     return 1;
//!   }
//!
//!   numbers[0] = 42;
//!   arena.reset();
//!   // `numbers` is now invalid and must not be used.
//!
//!   let raw: *mut u8 = arena.allocate(Layout::new<u64>());
//!   if (raw == null) {
//!     return 2;
//!   }
//!
//!   arena.destroy();
//!   return 0;
//! }
//! ```

import Align from "./align";
import RawAllocator from "./allocator";
import Layout from "./layout";

/// Alignment floor for a backing block, matching the process allocator.
const ARENA_MIN_ALIGNMENT: u64 = 16;

/// Default backing block size when the caller asks for zero.
const ARENA_DEFAULT_BLOCK_SIZE: u64 = 1024;

/// One backing block in an arena's singly linked block list.
///
/// Blocks are raw allocations rather than owned records: an arena hands out
/// interior pointers into `data`, so the list cannot move while it is alive.
record ArenaBlock {
  /// Backing storage for this block.
  public data: *mut u8;

  /// Usable bytes in `data`.
  public capacity: u64;

  /// Bytes already handed out from the front of `data`.
  public used: u64;

  /// Strongest alignment this block can satisfy.
  public alignment: u64;

  /// Next block in the list, or null at the tail.
  public next: *mut ArenaBlock;
}

/// Allocates one backing block with `capacity` bytes at `alignment`.
function arenaBlockCreate(capacity: u64, alignment: u64): *mut ArenaBlock {
  let effective: u64 = alignment < ARENA_MIN_ALIGNMENT ? ARENA_MIN_ALIGNMENT : alignment;
  let block: *mut ArenaBlock = RawAllocator::allocateAligned(
    @sizeOf<ArenaBlock>(),
    @alignOf<ArenaBlock>(),
  ) as *mut ArenaBlock;

  @write<ArenaBlock>(block, ArenaBlock {
      data: RawAllocator::allocateAligned(capacity, alignment),
      capacity: capacity,
      used: 0,
      alignment: effective,
      next: null,
    });

  return block;
}

/// Bumps `block` by `size` bytes at `alignment`, or returns null when it cannot.
function arenaBlockAllocate(block: *mut ArenaBlock, size: u64, alignment: u64): *mut u8 {
  if (block == null || size == 0) {
    return null;
  }

  let mut state: ArenaBlock = @read<ArenaBlock>(block);

  if (alignment > state.alignment) {
    return null;
  }

  let aligned: u64 = Align::alignUp(state.data as u64 + state.used, alignment);
  let nextUsed: u64 = (aligned - (state.data as u64)) + size;

  if (nextUsed > state.capacity) {
    return null;
  }

  state.used = nextUsed;
  @write<ArenaBlock>(block, state);

  return aligned as *mut u8;
}

/// Rewinds every block in the list starting at `block`.
function arenaBlockListReset(block: *mut ArenaBlock): void {
  let mut cursor: *mut ArenaBlock = block;

  while (cursor != null) {
    let mut state: ArenaBlock = @read<ArenaBlock>(cursor);
    let next: *mut ArenaBlock = state.next;

    state.used = 0;
    @write<ArenaBlock>(cursor, state);

    cursor = next;
  }
}

/// Releases every block in the list starting at `block`.
function arenaBlockListDestroy(block: *mut ArenaBlock): void {
  let mut cursor: *mut ArenaBlock = block;

  while (cursor != null) {
    let state: ArenaBlock = @read<ArenaBlock>(cursor);

    RawAllocator::free(state.data);
    RawAllocator::free(cursor as *mut u8);

    cursor = state.next;
  }
}

/// Appends `block` to the list, keeping `head` and `current` consistent.
function arenaBlockListAppend(
  head: *mut ArenaBlock,
  current: *mut ArenaBlock,
  block: *mut ArenaBlock
): void {
  if (current != null) {
    let mut state: ArenaBlock = @read<ArenaBlock>(current);
    state.next = block;
    @write<ArenaBlock>(current, state);

    return;
  }

  let mut tail: *mut ArenaBlock = head;

  while (true) {
    let mut state: ArenaBlock = @read<ArenaBlock>(tail);

    if (state.next == null) {
      state.next = block;
      @write<ArenaBlock>(tail, state);

      return;
    }

    tail = state.next;
  }
}

@implements(Drop)
/// Arena-style allocator backed by a linked list of bump-allocated blocks.
///
/// The arena owns every block it allocates and hands out interior pointers into
/// them. Those pointers stay valid until `reset()` or `destroy()`.
export record ArenaAllocator {
  /// First block in the list, or null before the first allocation.
  head: *mut ArenaBlock;

  /// Block the next allocation is tried against first.
  current: *mut ArenaBlock;

  /// Preferred backing block size used when the arena grows.
  blockSize: u64;

  /// False once `destroy()` has released the blocks.
  alive: boolean;

  /// Creates a new arena allocator with the given preferred block size.
  ///
  /// # Arguments
  ///
  /// * `blockSize` - preferred growth size for backing blocks.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import ArenaAllocator from "std::memory";
  ///
  /// let arena: ArenaAllocator = ArenaAllocator::new(4096);
  /// ```
  public static new(blockSize: u64): ArenaAllocator {
    return ArenaAllocator {
      head: null,
      current: null,
      blockSize: blockSize == 0 ? ARENA_DEFAULT_BLOCK_SIZE : blockSize,
      alive: true,
    };
  }

  /// Compatibility alias for `ArenaAllocator::new(blockSize)`.
  public static init(blockSize: u64): ArenaAllocator {
    return ArenaAllocator::new(blockSize);
  }

  /// Allocates raw memory for `layout` from the arena.
  ///
  /// Returns `null` when the arena has been destroyed or when `layout`
  /// represents a zero-sized allocation.
  public allocate(&mut self, layout: Layout): *mut u8 {
    if (!self.alive) {
      return null;
    }

    let size: u64 = layout.size();
    let alignment: u64 = layout.align();

    if (size == 0) {
      return null;
    }

    if (!Align::isPowerOfTwo(alignment)) {
      @panic("ignis: invalid alignment");
    }

    let mut block: *mut ArenaBlock = self.current;

    while (block != null) {
      let pointer: *mut u8 = arenaBlockAllocate(block, size, alignment);

      if (pointer != null) {
        self.current = block;
        return pointer;
      }

      block = @read<ArenaBlock>(block).next;
    }

    let minCapacity: u64 = size + alignment - 1;
    let growthBase: u64 = self.current != null ? @read<ArenaBlock>(self.current).capacity * 2 : self.blockSize;
    let mut capacity: u64 = growthBase > self.blockSize ? growthBase : self.blockSize;

    if (capacity < minCapacity) {
      capacity = minCapacity;
    }

    let fresh: *mut ArenaBlock = arenaBlockCreate(capacity, alignment);

    if (self.head == null) {
      self.head = fresh;
    } else {
      arenaBlockListAppend(self.head, self.current, fresh);
    }

    self.current = fresh;

    return arenaBlockAllocate(fresh, size, alignment);
  }

  /// Allocates enough arena memory for a single value of type `T`.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import ArenaAllocator from "std::memory";
  ///
  /// let mut arena: ArenaAllocator = ArenaAllocator::new(1024);
  /// let point: *mut i32 = arena.allocate<i32>();
  /// ```
  public allocate<T>(&mut self): *mut T {
    return self.allocate(Layout::new<T>()) as *mut T;
  }

  /// Allocates enough arena memory for `count` contiguous values of type `T`.
  ///
  /// # Example
  ///
  /// ```ignis
  /// import ArenaAllocator from "std::memory";
  ///
  /// let mut arena: ArenaAllocator = ArenaAllocator::new(4096);
  /// let buffer: *mut u8 = arena.allocate<u8>(256);
  /// ```
  public allocate<T>(&mut self, count: u64): *mut T {
    return self.allocate(Layout::new<T>(count)) as *mut T;
  }

  /// Rewinds allocation state so all arena space becomes reusable again.
  ///
  /// All previously returned pointers become invalid after this call.
  public reset(&mut self): void {
    if (!self.alive) {
      return;
    }

    arenaBlockListReset(self.head);
    self.current = self.head;
  }

  /// Releases all arena-owned backing blocks and invalidates the arena.
  ///
  /// After `destroy()`, further allocations return `null` until the allocator
  /// is recreated with `init`.
  public destroy(&mut self): void {
    if (!self.alive) {
      return;
    }

    arenaBlockListDestroy(self.head);

    self.head = null;
    self.current = null;
    self.alive = false;
  }

  /// Automatically destroys the arena when it goes out of scope.
  public drop(&mut self): void {
    self.destroy();
  }
}
