record Pair {
  public x: i64;
  public y: i64;
}

function step(value: Pair): Pair {
  return Pair { x: value.y, y: value.x + value.y };
}

function main(): i32 {
  let mut accumulator: i64 = 0;
  let mut index: i32 = 0;
  while (index < 10000) {
    accumulator += (index as i64) * 3;
    index += 1;
  }
  let mut value: i64 = accumulator;
  let pointer: *mut i64 = &mut value as *mut i64;
  @write<i64>(pointer, @read<i64>(pointer) + 1);
  let result: Pair = step(Pair { x: @read<i64>(pointer), y: 2 });
  return ((result.x + result.y) % 251) as i32;
}
