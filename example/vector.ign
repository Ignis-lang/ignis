import Vector from "std::vector";
import String from "std::string";
import Io from "std::io";

function main(): i32 {
  let mut numbers: Vector<i32> = Vector::init<i32>();

  numbers.push(10);
  numbers.push(20);
  numbers.push(30);
  numbers.push(40);

  let initiallyEmpty: boolean = numbers.isEmpty();
  Io::println(`Length: ${numbers.length()}`);
  Io::println(`Capacity: ${numbers.capacity()}`);
  Io::println(`Is empty: ${initiallyEmpty.toString()}`);

  Io::println("Popping elements...");
  numbers.pop();
  numbers.pop();

  Io::println(`Length after 2 pops: ${numbers.length()}`);

  numbers.clear();
  let emptyAfterClear: boolean = numbers.isEmpty();
  Io::println(`Length after clear: ${numbers.length()}`);
  Io::println(`Is empty: ${emptyAfterClear.toString()}`);

  return 0;
}
